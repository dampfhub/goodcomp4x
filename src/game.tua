//! Hex combat sandbox: game state and the queries shared across its parts. Player input lives
//! in `orders`, turn resolution in `turn`, the AI in `ai`, world geometry in `draw`, and the
//! screen-space UI in `ui`.

use std.collections.Deque;
use std.collections.Map;
use std.collections.Set;
use std.fmt.Out;
use std.fmt.show_i64;
use std.math.Float;
use std.linalg.vec2;
use std.str.Str;
use std.str.to_owned;
use std.str.push;
use std.str.push_char;
use log.Log;
use log.info;
use game.camera.Camera;
use game.city.City;
use game.city.Site;
use game.effects.Playing;
use game.scenario.Scenario;
use game.hex.HEX_SIZE;
use game.hex.Hex;
use game.hex.HexGrid;
use game.terrain.HILLS;
use game.terrain.MOUNTAINS;
use game.orders.ClickMode;
use game.turn.Phase;
use game.unit.IdSet;
use game.unit.Team;
use game.unit.Unit;
use game.unit.UnitType;

pub const GRID_RADIUS: i32 = 3;
pub const PLAYER_TEAM: Team = Team.Blue;
pub const AI_TEAM: Team = Team.Red;

pub const CONTROLS_HELP: str = "Controls:
  Click a unit to select it.
  Click a green hex to queue a move; click it again to cancel.
  Click an enemy in range to queue an attack on it.
  Shift-click any hex in range to attack that square instead: whoever stands there when the attack resolves gets hit.
  A unit can queue a move and an attack; it attacks from its new hex.
  Ctrl-click an adjacent ally to swap places with it.
  Alt-drag a box (or Alt-click units) to select a group: clicking a hex sends each member as
  close to it as it can get, and clicking an enemy has every member in range attack it.
  Queued attacks are drawn as arrows from the attacker (or its ghost) to the target.
  Units can't move through occupied hexes, and two allies can't head for the same hex.
  Space holds the selected unit: it keeps any orders already queued and skips the rest.
  G guards it instead: it stays put and is skipped every turn until given an order.
  Ctrl-right-click clears the selected unit's orders (and a hold or guard).
  Once a unit has queued a move and an attack (or can't do one of them), the next unit is
  selected automatically and the camera glides to it. Tab looks at the next unit without
  holding this one.
  Once every unit has acted, held or is guarding and every city has a build queued, Space
  ends the turn. Assigning citizens never holds the turn up.
  C selects your city. Click tiles to assign or release citizens. A auto-assigns. Y shows yields.
  Rest the cursor on any hex for a moment to see what it is and yields.
  1-4 queue city units: melee, ranged, cavalry, siege. F founds with a settler.
  F1 combat, F2 cities, F3 settler frontier (again to restart). F6 saves a snapshot, F7 loads it, F8 plays turns all at once.
  The faded DEBUG panel at the top-left has buttons for these.
  Scroll to zoom, left-drag or middle-drag to pan. Clicks act on release; dragging does not issue orders.
  F5 toggles fullscreen.
Turn order:
  Each unit's blue number is when it moves and its red number when it attacks (1 = first).
  Units of the same type act simultaneously; simultaneous attacks all land before anyone is removed.
  A swap happens when whichever of the two allies moves first acts.
Abilities (button at the bottom of the screen, or Q, for the selected unit):
  Melee - Shield Wall: +50% defense this turn, but no moving.
  Ranged - Volley: the attack also hits enemies next to the target, all at 60% damage.
  Cavalry - Charge: +1 move and +50% attack this turn.
  Siege - Deploy: spend a turn setting up, then +1 range but no moving until packed up.
  A gold ring marks a queued ability; a steel ring marks deployed siege.
Contested hexes:
  Two enemies moving onto the same hex both take it, turning it orange. Every turn they
  fight there instead of attacking anything else, until one dies or moves out.
Terrain:
  Hills (small peaks): +25% defense for the unit standing there.
  Mountains (large snowy peak): impassable.";

pub struct GameState {
    cities: Vec[City],
    sites: Map[Hex, Site],
    roads: Set[Hex],
    selected_city: Option[i32],
    hovered_city: Option[i32],
    /// Whether the open city shows each tile's yields (Y toggles it).
    show_yields: bool,
    /// The action a command-tray button (or M, X) armed for the next map click.
    ui_click_mode: Option[ClickMode],
    inspected_tile: Option[Hex],
    /// The map hex under the cursor (not over the UI), and how long the cursor has rested on
    /// it, for the tile tooltip.
    hovered_tile: Option[Hex],
    hover_seconds: f32,
    notice: Str,
    grid: HexGrid,
    /// Living units only: a unit is removed the moment it dies.
    units: Vec[Unit],
    /// Index into `units` of the player's selected unit.
    selected: Option[i32],
    /// Several units selected together, in place of `selected`; empty unless at least two are.
    group: Vec[i32],
    /// Which test scenario this is, for restarting it.
    scenario: Scenario,
    /// A snapshot of the game saved for testing (F6), restored by F7.
    savestate: Option[Box[GameState]],
    /// Debug setting (F8): play a turn's steps all at once instead of one every
    /// `STEP_INTERVAL`. Kept across scenario switches and loads.
    instant_playback: bool,
    turn: u32,
    camera: Camera,
    /// Steps of the turn currently playing out, drained one at a time by `update`.
    pending_steps: Deque[(UnitType, Phase)],
    step_timer: f32,
    /// Units that acted in the latest step, highlighted until `highlight_timer` runs out.
    recent_actors: Vec[u32],
    highlight_timer: f32,
    /// Unit ids that may found a city. They use the melee placeholder body for now.
    settlers: IdSet,
    workers: IdSet,
    /// Frontier sandbox units that the player may command despite being Red.
    player_controlled_units: IdSet,
    next_unit_id: u32,
    /// Attack animations playing out.
    effects: Vec[Playing],
}

impl GameState {
    pub fn new() -> GameState can {Log} {
        let layout = [
            (Hex.new(-2, 0), Team.Blue, UnitType.Melee),
            (Hex.new(-2, 1), Team.Blue, UnitType.Ranged),
            (Hex.new(-2, -1), Team.Blue, UnitType.Cavalry),
            (Hex.new(-1, -2), Team.Blue, UnitType.Siege),
            (Hex.new(2, 0), Team.Red, UnitType.Melee),
            (Hex.new(2, -1), Team.Red, UnitType.Ranged),
            (Hex.new(2, 1), Team.Red, UnitType.Cavalry),
            (Hex.new(1, 2), Team.Red, UnitType.Siege),
        ];
        let mut units: Vec[Unit] = Vec.new();
        for i in 0..8 {
            let (pos, team, unit_type) = layout[i];
            units.push(Unit.new(i as u32, pos, team, unit_type));
        }

        // Mountain ridges along the center column leave a three-hex pass (with a hill in the
        // middle) as the only way between the two sides.
        let terrain = [
            (Hex.new(0, -3), MOUNTAINS),
            (Hex.new(0, -2), MOUNTAINS),
            (Hex.new(0, 2), MOUNTAINS),
            (Hex.new(0, 3), MOUNTAINS),
            (Hex.new(0, 0), HILLS),
            (Hex.new(-2, 2), HILLS),
            (Hex.new(2, -2), HILLS),
        ];

        info(fn() can {Out} {
            Out.put("You control ");
            PLAYER_TEAM.show();
            Out.put("; ");
            AI_TEAM.show();
            Out.put(" is AI-controlled.\n");
            Out.put(CONTROLS_HELP);
        });

        let mut game = GameState {
            cities: Vec.new(),
            sites: Map.new(),
            roads: Set.new(),
            selected_city: Option.None,
            hovered_city: Option.None,
            show_yields: true,
            ui_click_mode: Option.None,
            inspected_tile: Option.None,
            hovered_tile: Option.None,
            hover_seconds: 0.0,
            notice: to_owned(""),
            grid: HexGrid.new(GRID_RADIUS, &terrain),
            units,
            selected: Option.None,
            group: Vec.new(),
            scenario: Scenario.Combat,
            savestate: Option.None,
            instant_playback: false,
            turn: 0,
            camera: Camera.new(vec2(0.0, 0.0), (GRID_RADIUS as f32 + 1.5) * HEX_SIZE),
            pending_steps: Deque.new(),
            step_timer: 0.0,
            recent_actors: Vec.new(),
            highlight_timer: 0.0,
            settlers: IdSet.new(),
            workers: IdSet.new(),
            player_controlled_units: IdSet.new(),
            next_unit_id: 8,
            effects: Vec.new(),
        };
        game.select_next_or_end_turn(Option.None);
        game
    }

    /// Two cities with their economies, farms, mines and roads, beside the two armies.
    pub fn city_scenario() -> GameState can {Log} {
        let mut game = GameState.new();
        game.scenario = Scenario.Cities;
        game.setup_cities();
        game.start_on_whole_map();
        game
    }

    /// Fresh economy match: each side begins with one settler and no city.
    pub fn frontier_scenario() -> GameState can {Log} {
        let mut game = GameState.new();
        game.scenario = Scenario.Frontier;
        game.units.clear();
        game.setup_frontier();
        game.start_on_whole_map();
        game
    }

    /// After a scenario replaces the combat setup: centers the camera on the map (dropping any
    /// glide toward a unit that's gone) and selects the first unit without moving the camera
    /// to it.
    fn start_on_whole_map(&mut self) {
        self.camera = Camera.new(vec2(0.0, 0.0), self.camera.half_height);
        self.selected = self.next_unit_needing_orders(Option.None);
    }

    /// Whether the player gives this unit its orders: their own team's, or a sandbox unit
    /// handed to them.
    pub fn is_player_controlled(&self, idx: i32) -> bool {
        self.units[idx].team == PLAYER_TEAM || self.player_controlled_units.contains(self.units[idx].id)
    }

    /// The first unit on `hex` the player controls.
    pub fn controlled_unit_at(&self, hex: Hex) -> Option[i32] {
        for i in 0..self.units.len() {
            if self.units[i].pos == hex && self.is_player_controlled(i) { return Option.Some(i); }
        }
        Option.None
    }

    /// What the unit is, for display: settlers and workers are marked on top of an ordinary
    /// unit type.
    pub fn unit_role(&self, unit: &Unit) -> (str, char) {
        if self.settlers.contains(unit.id) {
            ("SETTLER", 'T')
        } else if self.workers.contains(unit.id) {
            ("WORKER", 'W')
        } else {
            let name = match unit.unit_type {
                UnitType.Melee => "MELEE",
                UnitType.Ranged => "RANGED",
                UnitType.Cavalry => "CAVALRY",
                UnitType.Siege => "SIEGE",
            };
            (name, unit.unit_type.letter())
        }
    }

    pub fn unit_letter(&self, unit: &Unit) -> char { self.unit_role(unit).1 }

    fn is_occupied(&self, hex: Hex) -> bool { self.count_at(hex) > 0 }

    fn count_at(&self, hex: Hex) -> i32 {
        let mut n = 0;
        for i in 0..self.units.len() {
            if self.units[i].pos == hex { n = n + 1; }
        }
        n
    }

    fn unit_of_team_at(&self, hex: Hex, team: Team) -> Option[i32] {
        let mut i = 0;
        while i < self.units.len() {
            if self.units[i].pos == hex && self.units[i].team == team { return Option.Some(i); }
            i = i + 1;
        }
        Option.None
    }

    fn enemy_of_team_at(&self, hex: Hex, team: Team) -> Option[i32] {
        let mut i = 0;
        while i < self.units.len() {
            if self.units[i].pos == hex && self.units[i].team != team { return Option.Some(i); }
            i = i + 1;
        }
        Option.None
    }

    /// Whether two enemies are fighting over this hex.
    fn is_contested(&self, hex: Hex) -> bool { self.count_at(hex) > 1 }

    /// The enemy sharing this unit's hex, if it's contested. Units locked in a contested hex
    /// fight each other every turn and can't attack elsewhere.
    fn rival_of(&self, idx: i32) -> Option[i32] {
        self.enemy_of_team_at(self.units[idx].pos, self.units[idx].team)
    }

    /// The ally this unit is swapping places with: the two are queued to move into each
    /// other's hexes.
    fn swap_partner(&self, idx: i32) -> Option[i32] {
        let unit = self.units[idx];
        let dest = unit.planned_move?;
        let mut i = 0;
        while i < self.units.len() {
            let other = self.units[i];
            if other.pos == dest && other.team == unit.team && other.planned_move == Option.Some(unit.pos) {
                return Option.Some(i);
            }
            i = i + 1;
        }
        Option.None
    }

    /// Hexes reachable from `start` in at most `move_range` steps without passing through
    /// mountains or an occupied hex, so a line of units blocks the way. Includes `start`.
    fn reachable_hexes(&self, start: Hex, move_range: i32) -> Set[Hex] {
        let mut visited: Set[Hex] = Set.new();
        visited.insert(start);
        let mut frontier: Vec[Hex] = Vec.new();
        frontier.push(start);
        for _ in 0..move_range {
            let mut next: Vec[Hex] = Vec.new();
            for f in 0..frontier.len() {
                let around = frontier[f].neighbors();
                for k in 0..6 {
                    let neighbor = around[k];
                    let open = self.grid.is_passable(neighbor) && !self.is_occupied(neighbor);
                    if open && visited.insert(neighbor) {
                        next.push(neighbor);
                    }
                }
            }
            frontier = next;
        }
        visited
    }
}

/// `x` with no decimals, a half rounding to the even neighbour as Rust's `{:.0}` does.
pub fn show_rounded(x: f32) can {Out} {
    let floor = x.floor();
    let mut r = x.round();
    if x - floor == 0.5 && (r as i64) % 2 != 0 { r = r - 1.0 * (if x > 0.0 { 1.0 } else { -1.0 }); }
    show_i64(r as i64);
}

/// Renders `body`'s output into a new string: the game's `format!`.
pub fn text[E](body: affine fn() can {Out, ..E}) -> Str can {..E} {
    let mut s = to_owned("");
    handle { body(); } with Out {
        put(t) => { push(&mut s, t); resume }
        put_char(c) => { push_char(&mut s, c); resume }
    }
    s
}
