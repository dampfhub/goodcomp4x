pub const GRID_RADIUS: i32 = 3;
/// The side a single-player game gives the player, and the local side until a multiplayer game
/// says otherwise (`GameState.local_team`).
pub const PLAYER_TEAM: Team = Team.Blue;
pub const AI_TEAM: Team = Team.Red;

pub const CONTROLS_HELP: str = "Controls:
  Click a unit to select it.
  Click a green hex to queue a move; click it again to cancel.
  Right-click any hex in range to attack it: whoever stands there when the attack resolves gets hit.
  A unit can queue a move and an attack; it attacks from its new hex.
  Shift-click queues moves over several turns, Shift-right-click an attack in a later turn;
  any other order replaces the queue (a click on the map needs repeating to do it).
  Ctrl-click an adjacent ally to swap places with it.
  Drag a box on the map to select a group (Shift-drag adds to it), Shift-click to add a unit
  and Ctrl-click to take one out: clicking a hex sends each member as close to it as it can get,
  and right-clicking has every member in range attack it.
  Delete twice disbands the selected unit.
  Queued attacks are drawn as arrows from the attacker (or its ghost) to the target.
  Units can't move through occupied hexes, and two allies can't head for the same hex.
  Space holds the selected unit: it keeps any orders already queued and skips the rest.
  Space again on a held unit puts it back in the turn order.
  G guards it instead: it stays put and is skipped every turn until given an order.
  Ctrl-right-click clears the selected unit's orders (and a hold or guard).
  Once a unit has queued a move and an attack (or can't do one of them), the next unit is
  selected automatically and the camera glides to it. Tab looks at the next unit without
  holding this one.
  Once every unit has acted, held or is guarding and every city has a build queued, Space
  ends the turn; ending it early holds every unit still waiting for orders. Assigning citizens never holds the turn up.
  C selects your city. Click tiles to assign or release citizens. A auto-assigns. Y shows yields.
  Rest the cursor on any hex for a moment to see what it is and yields.
  1-4 queue city units: melee, ranged, cavalry, siege. F founds with a settler.
  F1 combat, F2 cities, F3 settler frontier, F4 world (again to restart). F6 saves a snapshot, F7 loads it,
  F8 plays turns all at once, F10 lifts the fog of war.
  The faded DEBUG panel at the top-left has buttons for these, and the naval scenario.
  Scroll to zoom, middle-drag to pan. Clicks act on release; dragging does not issue orders.
  Hold Alt for extra map info: turn order and every tile's yields.
  Escape closes the settings menu, a city view or the selection; with nothing open it opens
  the settings menu, which has Quit.
  F5 toggles fullscreen.
Turn order:
  Holding Alt, each unit's blue number is when it moves and its red number when it attacks (1 = first).
  Units of the same type act simultaneously; simultaneous attacks all land before anyone is removed.
  A swap happens when whichever of the two allies moves first acts.
Abilities (button at the bottom of the screen, or Q, for the selected unit):
  Melee - Shield Wall: +50% defense this turn, but no moving.
  Ranged - Volley: the attack also hits enemies next to the target, all at 60% damage.
  Cavalry - Charge: +1 move and +50% attack this turn.
  Siege - Deploy: spend a turn setting up, then +1 range but no moving until packed up.
  A gold ring marks a queued ability; a steel ring marks deployed siege.
Contested hexes:
  Two enemies moving onto the same hex both take it, turning it orange. Every turn they
  fight there instead of attacking anything else, until one dies or moves out.
Terrain:
  Hills (small peaks): +25% defense for the unit standing there.
  Mountains (large snowy peak): impassable.";

/// Every side's starting stockpile.
fn starting_stockpiles() -> Vec[Stock] {
    let mut out: Vec[Stock] = Vec.new();
    for _ in 0..7 { out.push(STARTING_STOCK); }
    out
}

/// `n` zeros.
fn zeros(n: i32) -> Vec[i32] {
    let mut out: Vec[i32] = Vec.new();
    for _ in 0..n { out.push(0); }
    out
}

/// The one side in `humans`.
fn humans_of(team: Team) -> Vec[Team] {
    let mut out: Vec[Team] = Vec.new();
    out.push(team);
    out
}

pub struct GameState {
    cities: Vec[City],
    /// Each side's food, wood and metal, indexed by `Team.index` (`city/economy.tua`).
    stockpiles: Vec[Stock],
    /// Debug setting: a city's production speeds its builds on top of the fixed time
    /// (`work_rate`). Kept across scenario switches and loads.
    production_speedup: bool,
    /// Cavalry and Armored each side's Barracks have trained, at `team * 2 + Resource.index`: what
    /// the cap counts under `lifetime_special_cap` (`city/barracks.tua`).
    special_trained: Vec[i32],
    /// Debug setting: a deposit's cap counts every Cavalry or Armored ever trained from it, not
    /// those alive. Kept across scenario switches and loads.
    lifetime_special_cap: bool,
    /// Tests: each time training started past its side's supply (`city/supply.tua`), which the
    /// simulation checks never happens.
    supply_overruns: Vec[Str],
    /// Tests: supply each side has on top of its cities' (`fund`), by `Team.index`.
    extra_supply: Vec[i32],
    sites: Map[Hex, Site],
    roads: Set[Hex],
    selected_city: Option[i32],
    /// Barracks have their own production screen, separate from city labor.
    selected_barracks: Option[i32],
    /// City interior currently being inspected and ordered, and its selected fighter (by its
    /// source unit's id).
    interior_view: Option[i32],
    interior_selected: Option[u32],
    /// The exterior camera, kept while the tactical city map is open.
    exterior_camera: Option[Camera],
    /// The city and cluster whose manager has been picked up and awaits a destination click.
    moving_manager: Option[(i32, i32)],
    city_queue_scroll: i32,
    /// The unit group whose members the turn strip shows in a second row.
    roster_open: Option[RosterKey],
    /// A queue row picked up with the mouse in the classic panels, and the row it is over.
    queue_drag: Option[QueueDrag],
    barracks_queue_scroll: i32,
    hovered_city: Option[i32],
    /// Whether the open city shows each tile's yields (Y toggles it).
    show_yields: bool,
    /// Whether Alt is held, showing extra map info: units' turn order and every tile's yields.
    show_details: bool,
    /// The action a command-tray button (or M, X) armed for the next map click.
    ui_click_mode: Option[ClickMode],
    /// The map hex under the cursor (not over the UI), and how long the cursor has rested on
    /// it, for the tile tooltip.
    hovered_tile: Option[Hex],
    hover_seconds: f32,
    notice: Str,
    grid: HexGrid,
    /// Living units only: a unit is removed the moment it dies.
    units: Vec[Unit],
    /// Index into `units` of the player's selected unit.
    selected: Option[i32],
    /// Several units selected together, in place of `selected`; empty unless at least two are.
    group: Vec[i32],
    /// Which test scenario this is, for restarting it.
    scenario: Scenario,
    /// A snapshot of the game saved for testing (F6), restored by F7.
    savestate: Option[Box[GameState]],
    /// Debug setting (F8): play a turn's steps all at once instead of one every
    /// `STEP_INTERVAL`. Kept across scenario switches and loads.
    /// The player's options (`settings.tua`). Kept across scenario switches and loads.
    settings: Settings,
    /// Whether the settings menu (Escape) is open. Kept across scenario switches and loads,
    /// like the rest of the UI.
    settings_open: bool,
    /// The settings menu's Quit button was clicked; the app closes the window.
    quit_requested: bool,
    turn: u32,
    camera: Camera,
    /// Steps of the turn currently playing out, drained one at a time by `update`.
    pending_steps: Deque[TurnStep],
    step_timer: f32,
    /// Units that acted in the latest step, highlighted until `highlight_timer` runs out.
    recent_actors: Vec[u32],
    highlight_timer: f32,
    /// What the open city is placing for its workers to build (`workers.tua`): map clicks and drags
    /// place it, on tiles or (a wall or gate) on hex edges, until Escape, another pick or leaving
    /// the city.
    placing_job: Option[JobKind],
    /// The tile (and, for a wall or gate, the neighbour across the edge) under the cursor while
    /// placing a job, highlighted.
    hovered_job: Option[(Hex, Option[Hex])],
    /// Workers out on the map; the ones at home are counted by their city (`workers.tua`).
    field_workers: Vec[FieldWorker],
    /// Outposts and forts built by workers, by tile.
    structures: Map[Hex, Structure],
    /// Walls and gates built by workers, by the edge they stand on (`hex.edge`).
    barriers: Map[Edge, Structure],
    /// Unit ids that may found a city. They use the melee placeholder body for now.
    settlers: IdSet,
    /// Frontier sandbox units that the player may command despite being Red.
    player_controlled_units: IdSet,
    /// The side played at this machine: whose orders the input gives, whose fog, stockpile and
    /// notices show. Blue, unless a multiplayer game seats this player elsewhere.
    local_team: Team,
    /// The sides people play, here or across the network; the AI plays the rest (`ai_teams`).
    humans: Vec[Team],
    /// Sites where an AI side's settler was refused a city by the rules, so its settlers look
    /// elsewhere (`plan_ai_settlers`).
    refused_sites: Vec[(Team, Hex)],
    next_unit_id: u32,
    /// The seed of a generated map (the F4 world), shown in the debug panel.
    map_seed: Option[u32],
    /// Ruins not yet claimed (`ruins.tua`), in the order the map made them.
    ruins: Vec[Ruin],
    /// Animal dens not yet cleared (`animals.tua`), in the order the map made them.
    dens: Vec[Den],
    /// Debug setting (F10): hide what the player's side can't see (`fog.tua`). Kept across
    /// scenario switches and loads.
    fog_of_war: bool,
    /// Whether the library UI (`imgui.tua`) is the presentation rather than the classic panels,
    /// and whether it took the cursor last frame: the classic layout is then not hit-tested.
    imgui_ui: bool,
    ui_captured: bool,
    /// Every hex the player's side has seen, as it last saw it.
    memory: Map[Hex, Sighting],
    /// Seconds the fog's clouds have drifted (`animate_clouds`, `draw.tua`).
    cloud_time: f32,
    /// A click that would replace the selection's queue, waiting to be repeated
    /// (`confirm_queue_replace`).
    queue_replace_armed: Option[QueueReplace],
    /// The unit a first press of Disband armed, by id; a second press removes it.
    disband_armed: Option[u32],
    /// Attack animations playing out.
    effects: Vec[Playing],
}

impl GameState {
    pub fn new() -> GameState can {Log} {
        let layout = [
            (Hex.new(-2, 0), Team.Blue, UnitType.Melee),
            (Hex.new(-2, 1), Team.Blue, UnitType.Ranged),
            (Hex.new(-2, -1), Team.Blue, UnitType.Cavalry),
            (Hex.new(-1, -2), Team.Blue, UnitType.Siege),
            (Hex.new(2, 0), Team.Red, UnitType.Melee),
            (Hex.new(2, -1), Team.Red, UnitType.Ranged),
            (Hex.new(2, 1), Team.Red, UnitType.Cavalry),
            (Hex.new(1, 2), Team.Red, UnitType.Siege),
        ];
        let mut units: Vec[Unit] = Vec.new();
        for i in 0..8 {
            let (pos, team, unit_type) = layout[i];
            units.push(Unit.new(i as u32, pos, team, unit_type));
        }

        // Mountain ridges along the center column leave a three-hex pass (with a hill in the
        // middle) as the only way between the two sides.
        let terrain = [
            (Hex.new(0, -3), MOUNTAINS),
            (Hex.new(0, -2), MOUNTAINS),
            (Hex.new(0, 2), MOUNTAINS),
            (Hex.new(0, 3), MOUNTAINS),
            (Hex.new(0, 0), HILLS),
            (Hex.new(-2, 2), HILLS),
            (Hex.new(2, -2), HILLS),
        ];

        info(fn() can {Out} {
            Out.put("You control ");
            PLAYER_TEAM.show();
            Out.put("; ");
            AI_TEAM.show();
            Out.put(" is AI-controlled.\n");
            Out.put(CONTROLS_HELP);
        });

        let mut game = GameState {
            cities: Vec.new(),
            stockpiles: starting_stockpiles(),
            production_speedup: false,
            special_trained: zeros(14),
            lifetime_special_cap: false,
            supply_overruns: Vec.new(),
            extra_supply: zeros(7),
            sites: Map.new(),
            roads: Set.new(),
            selected_city: Option.None,
            hovered_city: Option.None,
            show_yields: true,
            show_details: false,
            ui_click_mode: Option.None,
            selected_barracks: Option.None,
            interior_view: Option.None,
            interior_selected: Option.None,
            exterior_camera: Option.None,
            moving_manager: Option.None,
            city_queue_scroll: 0,
            roster_open: Option.None,
            queue_drag: Option.None,
            barracks_queue_scroll: 0,
            structures: Map.new(),
            barriers: Map.new(),
            hovered_tile: Option.None,
            hover_seconds: 0.0,
            notice: to_owned(""),
            grid: HexGrid.new(GRID_RADIUS, &terrain),
            units,
            selected: Option.None,
            group: Vec.new(),
            scenario: Scenario.Combat,
            savestate: Option.None,
            settings: default_settings(),
            settings_open: false,
            quit_requested: false,
            turn: 0,
            camera: Camera.new(vec2(0.0, 0.0), (GRID_RADIUS as f32 + 1.5) * HEX_SIZE),
            pending_steps: Deque.new(),
            step_timer: 0.0,
            recent_actors: Vec.new(),
            highlight_timer: 0.0,
            settlers: IdSet.new(),
            placing_job: Option.None,
            hovered_job: Option.None,
            field_workers: Vec.new(),
            player_controlled_units: IdSet.new(),
            local_team: PLAYER_TEAM,
            humans: humans_of(PLAYER_TEAM),
            refused_sites: Vec.new(),
            next_unit_id: 8,
            map_seed: Option.None,
            ruins: Vec.new(),
            dens: Vec.new(),
            fog_of_war: true,
            imgui_ui: false,
            ui_captured: false,
            memory: Map.new(),
            cloud_time: 0.0,
            queue_replace_armed: Option.None,
            disband_armed: Option.None,
            effects: Vec.new(),
        };
        game.select_next_needing_attention(Option.None);
        game
    }

    /// Two cities with their economies, farms, mines and roads, beside the two armies.
    pub fn city_scenario() -> GameState can {Log} {
        let mut game = GameState.new();
        game.scenario = Scenario.Cities;
        game.setup_cities();
        game.start_on_whole_map();
        game
    }

    /// A playable siege: Blue surrounds four gates with enough force to breach the defended
    /// command post.
    pub fn siege_scenario() -> GameState can {Log} {
        let mut game = GameState.city_scenario();
        game.scenario = Scenario.Siege;
        let posts = [(0, Hex.new(3, 0)), (1, Hex.new(3, 1)), (4, Hex.new(5, 0)), (5, Hex.new(4, -1))];
        for k in 0..4 {
            let (id, pos) = posts[k];
            for i in 0..game.units.len() { if game.units[i].id == id { game.units[i].pos = pos; } }
        }
        // Keep the practice battle at the gates. The Cities scenario's other troops would
        // require unrelated orders and Red's roamers would arrive mid-siege, changing the
        // intended four-on-two test.
        handle { game.units.retain(); } with Keep[Unit] { keep(u) => { resume u.id != 2 && u.id != 3 && u.id != 6 && u.id != 7 } }
        let extra = [(Hex.new(5, -1), UnitType.Siege), (Hex.new(4, 1), UnitType.Melee)];
        for k in 0..2 {
            let (pos, kind) = extra[k];
            let id = game.take_unit_id();
            game.units.push(Unit.new(id, pos, Team.Blue, kind));
        }
        // Paid for already, as scenario setup: the queue skips the price.
        for c in 0..game.cities.len() { game.cities[c].queue.push(Queued.prepaid(Build.Unit(BuildUnit.Melee))); }
        game.open_city_interior(1);
        game.set_notice("SIEGE: FIGHT ON BOTH MAPS (V) - BREACH POST, THEN OCCUPY IT");
        game
    }

    /// A narrow strait between two coastal cities, with ships and shore defenses already
    /// deployed for naval playtesting: each city has a Harbor and a Coastal Battery, and each
    /// side a troop ashore, a landing craft, a patrol galley and a bombard ship.
    pub fn naval_scenario() -> GameState can {Log} {
        let mut game = GameState.city_scenario();
        game.scenario = Scenario.Naval;
        let mut tiles: Map[Hex, Tile] = Map.new();
        for q in -1..=1 {
            for r in -7..=7 {
                let _old = tiles.insert(Hex.new(q, r), Tile.of(Terrain.Coast));
            }
        }
        game.grid = HexGrid.from_tiles(GridShape.Hexagon(6), tiles);
        let mut roads: Set[Hex] = Set.new();
        for k in 0..game.roads.len() {
            let Option.Some(h) = game.roads.key_at(k) else { continue; };
            if game.grid.is_passable(h) { let _new = roads.insert(h); }
        }
        game.roads = roads;
        let mut dry: Map[Hex, Site] = Map.new();
        for k in 0..game.sites.len() {
            let Option.Some(h) = game.sites.key_at(k) else { continue; };
            let Option.Some(site) = game.sites.val_at(k) else { continue; };
            if game.grid.is_passable(h) { let _old = dry.insert(h, site); }
        }
        game.sites = dry;
        // Both city centers on the shoreline, not two tiles inland.
        game.cities[0].pos = Hex.new(-2, 0);
        game.cities[1].pos = Hex.new(2, 0);
        for c in 0..2 {
            game.cities[c].clusters.clear();
            game.cities[c].remembered.clear();
        }
        game.units.clear();
        game.next_unit_id = 0;
        let sides = [(Team.Blue, -1), (Team.Red, 1)];
        for t in 0..2 {
            let (team, sign) = sides[t];
            let layout = [
                (Hex.new(sign * 3, 0), UnitType.Melee),
                (Hex.new(sign, -sign), UnitType.LandingCraft),
                (Hex.new(sign, sign), UnitType.PatrolGalley),
                (Hex.new(0, sign * 2), UnitType.BombardShip),
            ];
            let city = &mut game.cities[t];
            city.set_placed_site(Building.Harbor, Hex.new(sign * 2, 1));
            city.set_placed_site(Building.CoastalBattery, Hex.new(sign * 2, -1));
            city.built.push(Building.Harbor);
            city.built.push(Building.CoastalBattery);
            for k in 0..4 {
                let (pos, kind) = layout[k];
                let id = game.next_unit_id;
                game.next_unit_id = id + 1;
                game.units.push(Unit.new(id, pos, team, kind));
            }
        }
        for c in 0..game.cities.len() { game.auto_assign_city(c); }
        game.cities[0].queue.push(Queued.prepaid(Build.Unit(BuildUnit.PatrolGalley)));
        game.start_on_whole_map();
        game.set_notice("NAVAL TEST: SELECT TROOP THEN CLICK CRAFT TO BOARD; CRAFT THEN SHORE TO LAND");
        game
    }

    /// Fresh economy match: each side begins with one settler and no city.
    /// A generated map (`mapgen.tua`) from `seed` with the player and as many AI sides as
    /// `settings` ask for (`setup_world`).
    pub fn world_scenario_with(seed: u32, settings: &Settings) -> GameState can {Log} {
        let mut game = GameState.new();
        game.scenario = Scenario.World;
        game.units.clear();
        game.setup_world(seed, settings);
        game.start_on_whole_map();
        // The map is too big to take in at once: start on the player's city or settler.
        let mut home: Option[Hex] = Option.None;
        for i in 0..game.cities.len() { if home.is_none() && game.cities[i].team == game.local_team { home = Option.Some(game.cities[i].pos); } }
        for i in 0..game.units.len() {
            if home.is_none() && game.units[i].team == game.local_team && game.settlers.contains(game.units[i].id) { home = Option.Some(game.units[i].pos); }
        }
        let at = home.unwrap_or(Hex.new(0, 0));
        game.camera = Camera.new(at.to_world(), game.camera.half_height);
        // What needs seeing to first, as every turn starts: the city's production, or else the
        // settler.
        game.select_next_needing_attention(Option.None);
        game
    }

    /// A generated map from `seed`, with the default settings.
    pub fn world_scenario(seed: u32) -> GameState can {Log} { GameState.world_scenario_with(seed, &fresh_settings()) }

    pub fn frontier_scenario() -> GameState can {Log} {
        let mut game = GameState.new();
        game.scenario = Scenario.Frontier;
        game.units.clear();
        game.setup_frontier();
        game.start_on_whole_map();
        game
    }

    /// After a scenario replaces the combat setup: centers the camera on the map (dropping any
    /// glide toward a unit that's gone) and selects the first unit without moving the camera
    /// to it.
    fn start_on_whole_map(&mut self) {
        self.camera = Camera.new(vec2(0.0, 0.0), self.camera.half_height);
        self.selected = self.next_unit_needing_orders(Option.None);
    }

    /// Whether the player gives this unit its orders: their own team's, or a sandbox unit
    /// handed to them.
    pub fn is_player_controlled(&self, idx: i32) -> bool {
        self.units[idx].team == self.local_team || self.player_controlled_units.contains(self.units[idx].id)
    }

    /// Whether people play `team` (here or across the network) rather than the AI.
    pub fn is_human(&self, team: Team) -> bool { self.humans.contains(team) }

    /// Debug actions are refused in a networked game, where every machine must stay in step.
    pub fn refuses_debug(&self) -> bool { false }

    /// The first unit on `hex` the player controls.
    pub fn controlled_unit_at(&self, hex: Hex) -> Option[i32] {
        for i in 0..self.units.len() {
            if self.units[i].pos == hex && self.is_player_controlled(i) { return Option.Some(i); }
        }
        Option.None
    }

    /// What the unit is, for display: settlers and workers are marked on top of an ordinary
    /// unit type.
    pub fn unit_role(&self, unit: &Unit) -> Role {
        if self.settlers.contains(unit.id) { Role.Settler } else { Role.Troop(unit.unit_type) }
    }

    fn is_occupied(&self, hex: Hex) -> bool { self.count_at(hex) > 0 }

    pub fn count_at(&self, hex: Hex) -> i32 {
        let mut n = 0;
        for i in 0..self.units.len() {
            if self.units[i].pos == hex { n = n + 1; }
        }
        n
    }

    fn unit_of_team_at(&self, hex: Hex, team: Team) -> Option[i32] {
        let mut i = 0;
        while i < self.units.len() {
            if self.units[i].pos == hex && self.units[i].team == team { return Option.Some(i); }
            i = i + 1;
        }
        Option.None
    }

    fn enemy_of_team_at(&self, hex: Hex, team: Team) -> Option[i32] {
        let mut i = 0;
        while i < self.units.len() {
            if self.units[i].pos == hex && self.units[i].team != team { return Option.Some(i); }
            i = i + 1;
        }
        Option.None
    }

    /// The city whose standing Barracks of a side other than `team`'s is on `hex`.
    pub fn enemy_barracks_at(&self, hex: Hex, team: Team) -> Option[i32] {
        for i in 0..self.cities.len() {
            let city = &self.cities[i];
            if city.team != team && city.barracks == Option.Some(hex) && city.barracks_hp > 0.0 { return Option.Some(i); }
        }
        Option.None
    }

    /// The city whose standing Coastal Battery of a side other than `team`'s is on `hex`.
    pub fn enemy_coastal_battery_at(&self, hex: Hex, team: Team) -> Option[i32] {
        for i in 0..self.cities.len() {
            let city = &self.cities[i];
            if city.team != team && city.placed_site(Building.CoastalBattery) == Option.Some(hex) && city.coastal_battery_hp > 0.0 { return Option.Some(i); }
        }
        Option.None
    }

    /// Whether `team` has something to attack on `hex`: an enemy unit, Barracks or Coastal
    /// Battery.
    pub fn has_enemy_target_at(&self, hex: Hex, team: Team) -> bool {
        self.enemy_of_team_at(hex, team).is_some() || self.enemy_barracks_at(hex, team).is_some() || self.enemy_coastal_battery_at(hex, team).is_some()
    }

    /// An empty city center is not an exterior attack target. Units and workers standing there
    /// can still be attacked normally.
    pub fn empty_city_target(&self, hex: Hex, team: Team) -> bool {
        self.city_at(hex).is_some() && self.enemy_of_team_at(hex, team).is_none() && self.enemy_workers_at(hex, team).is_empty()
    }

    /// Whether two enemies are fighting over this hex.
    fn is_contested(&self, hex: Hex) -> bool { self.count_at(hex) > 1 }

    /// The enemy sharing this unit's hex, if it's contested. Units locked in a contested hex
    /// fight each other every turn and can't attack elsewhere.
    fn rival_of(&self, idx: i32) -> Option[i32] {
        self.enemy_of_team_at(self.units[idx].pos, self.units[idx].team)
    }

    /// The ally this unit is swapping places with: the two are queued to move into each
    /// other's hexes.
    fn swap_partner(&self, idx: i32) -> Option[i32] {
        let unit = &self.units[idx];
        let dest = unit.planned_move?;
        let mut i = 0;
        while i < self.units.len() {
            let other = &self.units[i];
            if other.pos == dest && other.team == unit.team && other.planned_move == Option.Some(unit.pos) {
                return Option.Some(i);
            }
            i = i + 1;
        }
        Option.None
    }

    /// Hexes a unit of `team` can reach from `start` in at most `move_range` steps without
    /// passing through mountains, walls, others' gates or an occupied hex, so a line of units
    /// blocks the way. Includes `start` itself. This is the real board, as the AI sees it; the
    /// player plans with `known_reachable_hexes` (`fog.tua`).
    pub fn reachable_hexes(&self, start: Hex, move_range: i32, team: Team) -> Set[Hex] {
        handle { reachable_by(start, move_range) } with Step {
            open(from, to) => { resume self.can_step(from, to, team) && !self.is_occupied(to) }
        }
    }
}

/// Whether a unit may step from a hex onto its neighbour, asked by `reachable_by`.
pub effect Step { fn open(from: Hex, to: Hex) -> bool; }

/// Hexes reachable from `start` in at most `move_range` steps, each step one `Step.open`
/// allows. Includes `start`.
pub fn reachable_by(start: Hex, move_range: i32) -> Set[Hex] can {Step} {
    let mut visited: Set[Hex] = Set.new();
    let _new = visited.insert(start);
    let mut frontier: Vec[Hex] = Vec.new();
    frontier.push(start);
    for _ in 0..move_range {
        let mut next: Vec[Hex] = Vec.new();
        for f in 0..frontier.len() {
            let from = frontier[f];
            let around = from.neighbors();
            for k in 0..6 {
                let to = around[k];
                if Step.open(from, to) && visited.insert(to) { next.push(to); }
            }
        }
        frontier = next;
    }
    visited
}

/// `x` with no decimals, a half rounding to the even neighbour as Rust's `{:.0}` does.
/// What a unit is, for display (`GameState.unit_role`).
pub enum Role { Settler, Troop(UnitType) }

impl Role {
    pub fn name(self) -> str {
        match self {
            Role.Settler => "SETTLER",
            Role.Troop(t) => match t {
                UnitType.Melee => "MELEE",
                UnitType.Ranged => "RANGED",
                UnitType.Cavalry => "CAVALRY",
                UnitType.Siege => "SIEGE",
                UnitType.Scout => "SCOUT",
                UnitType.Armored => "ARMORED",
                UnitType.PatrolGalley => "PATROL GALLEY",
                UnitType.LandingCraft => "LANDING CRAFT",
                UnitType.BombardShip => "BOMBARD SHIP",
                UnitType.Wolf => "WOLF PACK",
                UnitType.Bear => "BEAR",
            },
        }
    }
}

pub fn show_rounded(x: f32) can {Out} {
    let floor = x.floor();
    let mut r = x.round();
    if x - floor == 0.5 && (r as i64) % 2 != 0 { r = r - 1.0 * (if x > 0.0 { 1.0 } else { -1.0 }); }
    show_i64(r as i64);
}

/// Renders `body`'s output into a new string: the game's `format!`.
pub fn text[E](body: affine fn() can {Out, ..E}) -> Str can {..E} {
    let mut s = to_owned("");
    handle { body(); } with Out {
        put(t) => { push(&mut s, t); resume }
        put_char(c) => { push_char(&mut s, c); resume }
    }
    s
}
