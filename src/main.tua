const TITLE: str = "Hex Combat Sandbox";
/// How long a guest waits for the host's game before giving up.
const JOIN_WAIT_NS: i64 = 15000000000;
const DEFAULT_PORT: i32 = 7777;
/// The game's application id on Windows (`claim_app_id`).
const APP_USER_MODEL_ID: str = "dampfhub.riskofcivlike";
/// The window opens at this fraction of the primary monitor's size, centered on it.
const WINDOW_SCREEN_FRACTION: f32 = 0.8;
/// Window size when the monitor's size can't be found.
const DEFAULT_WIDTH: i32 = 1600;
const DEFAULT_HEIGHT: i32 = 900;
/// Window icon sizes, in pixels; Windows scales them to fit.
const WINDOW_ICON_SIZE: i32 = 64;
const TASKBAR_ICON_SIZE: i32 = 256;


/// Dragging the left button at least this many pixels draws a selection box instead of clicking.
const DRAG_THRESHOLD: f32 = 6.0;

/// A left-button press waiting for its release: where it went down, the click mode the
/// modifiers picked then, and whether a click was allowed then (not while a turn played out).
pub struct Press { origin: Vec2, mode: ClickMode, may_click: bool }

/// The input state the frame loop keeps between events.
pub struct Controls {
    cursor: Option[Vec2],
    size: Vec2,
    panning: bool,
    left_press: Option[Press],
    left_dragging: bool,
    /// Where a drag selection box started, while the button is down.
    box_start: Option[Vec2],
    /// The left button went down placing a worker job: moves while it's held place it too.
    painting_jobs: bool,
    /// In the classic panels: a queue scrollbar, a building catalog scrollbar or a queue row is
    /// held, and moves go to it.
    queue_scroll_dragging: bool,
    building_scroll_dragging: bool,
    queue_item_dragging: bool,
    mods: Modifiers,
    closed: bool,
}

/// Losing focus or the cursor: a release may never arrive, so every gesture in progress ends.
fn forget_gestures(input: &mut Controls) {
    input.left_press = Option.None;
    input.left_dragging = false;
    input.panning = false;
    input.cursor = Option.None;
    input.box_start = Option.None;
    input.painting_jobs = false;
    input.queue_scroll_dragging = false;
    input.building_scroll_dragging = false;
    input.queue_item_dragging = false;
}

/// Applies one window event to the game, answering what the window should do about it.
pub fn on_event(game: &mut GameState, input: &mut Controls, ui: &mut UiState, scale: f32, e: Event) -> WindowRequest can {Log, Clock, Rand} {
    // The library reads the mouse and the modifiers; the keys are the game's alone (the UI has
    // no text to type, and its Tab and Space focus would fight the game's hotkeys).
    let is_key = match e { Event.KeyDown(_, _) | Event.KeyUp(_) | Event.Char(_) => true, _ => false };
    if !is_key { ui.input = feed(ui.input, e, scale); }
    // The library UI gets the events first; what it took (a panel under the cursor, a widget
    // with the focus) the game leaves alone.
    let over_ui = game.imgui_ui && ui.wants_mouse;
    let keys_taken = game.imgui_ui && ui.wants_keyboard;
    match e {
        Event.CloseRequested => { input.closed = true; }
        Event.Resized(w, h) => { input.size = vec2(w as f32, h as f32); }
        Event.CursorMoved(x, y) => {
            let pos = vec2(x, y);
            // A held classic scrollbar or queue row follows the mouse and nothing else does.
            if !game.imgui_ui && input.queue_scroll_dragging {
                let _moved = game.drag_queue_scrollbar_at(pos, input.size, true);
                input.cursor = Option.Some(pos);
                return WindowRequest.Nothing;
            }
            if !game.imgui_ui && input.building_scroll_dragging {
                let _moved = game.drag_building_scrollbar_at(pos, input.size, true);
                input.cursor = Option.Some(pos);
                return WindowRequest.Nothing;
            }
            if !game.imgui_ui && input.queue_item_dragging {
                game.update_queue_drag_at(pos, input.size);
                input.cursor = Option.Some(pos);
                return WindowRequest.Nothing;
            }
            // A left press that moves far enough is a selection box (drawn from `box_start`),
            // not a click; only the middle button pans.
            if let Option.Some(press) = input.left_press {
                if !input.left_dragging && pos.distance(press.origin) >= DRAG_THRESHOLD { input.left_dragging = true; }
            }
            if input.painting_jobs {
                let _placing = game.paint_job_at(pos, input.size, false);
                input.cursor = Option.Some(pos);
                return WindowRequest.Nothing;
            }
            if input.panning && input.size.y > 0.0 {
                if let Option.Some(last) = input.cursor { game.camera.pan(pos.sub(last), input.size); }
            }
            input.cursor = Option.Some(pos);
        }
        Event.Focused(focused) => { if !focused { forget_gestures(input); } }
        Event.CursorLeft => forget_gestures(input),
        Event.ModifiersChanged(m) => {
            input.mods = m;
            game.set_details(m.alt);
        }
        Event.MouseDown(b) => match b {
            Button.Left => {
                if over_ui { return WindowRequest.Nothing; }
                if let Option.Some(cursor) = input.cursor {
                    if !game.imgui_ui {
                        if game.drag_queue_scrollbar_at(cursor, input.size, false) { input.queue_scroll_dragging = true; return WindowRequest.Nothing; }
                        if game.drag_building_scrollbar_at(cursor, input.size, false) { input.building_scroll_dragging = true; return WindowRequest.Nothing; }
                        if !input.mods.shift && !input.mods.control && game.start_queue_drag_at(cursor, input.size) { input.queue_item_dragging = true; return WindowRequest.Nothing; }
                    }
                    // With a job armed, the press (and any drag) places it on tiles or hex
                    // edges instead of clicking or panning.
                    if game.paint_job_at(cursor, input.size, true) {
                        input.painting_jobs = true;
                        return WindowRequest.Nothing;
                    }
                    // Left-click moves; Shift adds the move to the queue.
                    let mode = if input.mods.shift { ClickMode.QueueMove } else if input.mods.control { ClickMode.Swap } else { ClickMode.Normal };
                    input.left_press = Option.Some(Press { origin: cursor, mode, may_click: !game.is_resolving() });
                    input.left_dragging = input.panning;
                    // A drag from the map (not from a panel) selects the units inside its box.
                    let on_panel = over_ui || game.ui_covers(cursor, input.size);
                    input.box_start = if !on_panel && !input.panning { Option.Some(cursor) } else { Option.None };
                }
            }
            Button.Right => {
                if over_ui { return WindowRequest.Nothing; }
                if let Option.Some(cursor) = input.cursor { game.handle_context_click(cursor, input.size, input.mods.control, input.mods.shift); }
            }
            Button.Middle => {
                if over_ui { return WindowRequest.Nothing; }
                input.panning = true;
                if input.left_press.is_some() { input.left_dragging = true; }
            }
        },
        Event.MouseUp(b) => match b {
            Button.Left => {
                if input.queue_scroll_dragging || input.building_scroll_dragging {
                    input.queue_scroll_dragging = false;
                    input.building_scroll_dragging = false;
                    return WindowRequest.Nothing;
                }
                if input.queue_item_dragging {
                    input.queue_item_dragging = false;
                    if let Option.Some(at) = input.cursor { game.finish_queue_drag_at(at, input.size); } else { game.cancel_queue_drag(); }
                    return WindowRequest.Nothing;
                }
                if input.painting_jobs {
                    input.painting_jobs = false;
                    return WindowRequest.Nothing;
                }
                let boxed = input.box_start;
                input.box_start = Option.None;
                if let (Option.Some(start), Option.Some(end)) = (boxed, input.cursor) {
                    if input.left_dragging && start.distance(end) >= DRAG_THRESHOLD {
                        // Shift adds the boxed units to the selection.
                        game.select_in_box(start, end, input.size, input.mods.shift);
                        input.left_press = Option.None;
                        input.left_dragging = false;
                        return WindowRequest.Nothing;
                    }
                }
                if let Option.Some(press) = input.left_press {
                    if !input.left_dragging && press.may_click { game.handle_click(press.origin, input.size, press.mode); }
                }
                input.left_press = Option.None;
                input.left_dragging = false;
            }
            Button.Middle => { input.panning = false; }
            Button.Right => {}
        },
        Event.Wheel(steps) => {
            let over_queue = match input.cursor { Option.Some(c) => game.scroll_queue_at(c, input.size, steps), Option.None => false };
            let over_catalog = match input.cursor { Option.Some(c) => game.scroll_buildings_at(c, input.size, steps), Option.None => false };
            if !over_queue && !over_catalog && !over_ui { game.camera.zoom(steps); }
        }
        Event.KeyDown(key, repeat) => {
            if !repeat && !keys_taken {
                // Ctrl+Shift+R gives the active view's Debug placement back to Default's.
                let reset = match key { Key.Letter(c) => c as char == 'R', _ => false };
                if game.imgui_ui && reset && input.mods.control && input.mods.shift {
                    if ui.layout.request_reset_active_view() { game.set_notice("VIEW DEBUG LAYOUT RESET TO DEFAULT"); }
                    return WindowRequest.Nothing;
                }
                match key {
                    // Escape closes the settings menu, a view or the selection first; with
                    // nothing to close it opens the settings menu, which has Quit.
                    Key.Escape => game.press_escape(),
                    // F5: borderless fullscreen on the window's monitor, or back.
                    Key.Function(5) => { return WindowRequest.ToggleFullscreen; }
                    // F11: the classic panels, or back to the library UI.
                    Key.Function(11) => {
                        game.imgui_ui = !game.imgui_ui;
                        input.left_press = Option.None;
                        game.cancel_queue_drag();
                        input.queue_scroll_dragging = false;
                        input.building_scroll_dragging = false;
                        input.queue_item_dragging = false;
                        game.set_notice(if game.imgui_ui { "IMGUI UI (F11 TO COMPARE)" } else { "CLASSIC UI (F11 TO COMPARE)" });
                    }
                    _ => on_key(game, key),
                }
            }
        }
        _ => {}
    }
    WindowRequest.Nothing
}

/// A key going down, not repeating.
fn on_key(game: &mut GameState, key: Key) can {Log, Rand} {
    match key {
        Key.Space => game.hold_or_end_turn(),
        Key.Tab => game.select_next_unit(),
        Key.Delete => game.disband_selected(),
        Key.Letter(c) => match c as char {
            'Q' => game.toggle_selected_ability(),
            'C' => game.select_city(),
            'A' => game.auto_assign_selected_city(),
            'M' => game.choose_move_action(),
            'X' => game.choose_attack_action(),
            'R' => game.arm_worker_job(JobKind.Road),
            'I' => game.arm_worker_job(JobKind.Improve),
            'S' => game.queue_selected_city_settler(),
            'V' => game.toggle_city_interior(),
            'F' => game.found_city_selected(),
            'Y' => game.toggle_yields(),
            'G' => game.toggle_guard(),
            'E' => game.toggle_alert(),
            _ => {}
        },
        Key.Function(f) => match f {
            1 => game.switch_scenario(Scenario.Combat),
            2 => game.switch_scenario(Scenario.Cities),
            3 => game.switch_scenario(Scenario.Frontier),
            4 => game.switch_scenario(Scenario.World),
            12 => game.switch_scenario(Scenario.Siege),
            6 => game.save_state(),
            7 => game.load_state(),
            8 => game.toggle_instant_playback(),
            9 => game.debug_complete_current_production(),
            10 => game.toggle_fog(),
            _ => {}
        },
        Key.Digit(d) => match d {
            1 => game.queue_selected_city_unit(BuildUnit.Melee),
            2 => game.queue_selected_city_unit(BuildUnit.Ranged),
            3 => game.queue_selected_city_unit(BuildUnit.Siege),
            4 => game.queue_selected_city_scout(),
            5 => game.queue_selected_city_building(Building.Barracks),
            6 => game.queue_selected_city_building(Building.Mill),
            7 => game.queue_selected_city_building(Building.Workshop),
            8 => game.queue_selected_city_worker(),
            9 => game.queue_selected_city_growth(),
            0 => game.queue_selected_city_gather(),
            _ => {}
        },
        Key.Backspace => if game.is_in_city_interior() { game.clear_selected_interior_orders(); } else { game.remove_selected_city_queue_head(); },
        // Page Down.
        Key.Other(0x22) => game.move_selected_city_queue_head(false),
        _ => {}
    }
}

/// Plays one frame: advances the game by `dt` seconds and lays out the world and the UI as
/// two batches. Answers whether to keep running: not once the window was closed, the
/// screenshot written, or its time run out.
fn on_frame(game: &mut GameState, net: &mut NetLink, input: &Controls, ctx: &mut Context, ui: &mut UiState, shot: &mut Option[Screenshot], script: &mut Driver, mb: &Mailbox, interact: bool, w: u32, h: u32, dt: f32, scale: f32, vertices: &mut Vec[MeshVertex], batches: &mut Vec[DrawBatch]) -> FrameOut can {Log, Rand, Clock, Net, Entropy} {
    // The interaction script looks at the game and posts its next input before the frame plays.
    if interact && !drive(script, mb, &*game, &*ui, &*ctx, vec2(w as f32, h as f32), scale, Clock.now_nanos(), input.closed) { return FrameOut { keep: false, ui: draw_data() }; }
    if input.closed || game.quit_requested() { return FrameOut { keep: false, ui: draw_data() }; }
    let shooting = shot.is_some();
    if let &mut Option.Some(s) = shot {
        let now = Clock.now_nanos();
        if s.is_written() { return FrameOut { keep: false, ui: draw_data() }; }
        if s.timed_out(now) {
            let drawn = s.frames_drawn();
            error(fn() can {Out} { Out.put("no screenshot after 20 s ("); show_i64(drawn as i64); Out.put(" frames drawn)"); });
            return FrameOut { keep: false, ui: draw_data() };
        }
        s.after_frame(now);
    }
    net.pump(Clock.now_nanos(), game);
    game.update(dt);
    // A screenshot keeps the clouds where they start, so two shots of one scene match.
    if !shooting { game.animate_clouds(dt); }
    let size = vec2(w as f32, h as f32);
    game.update_hover(input.cursor, size, dt);
    let world = game.build_vertices();
    for i in 0..world.len() { vertices.push(world[i]); }
    batches.push(DrawBatch { view_proj: game.camera.view_proj(size).to_cols(), first: 0, count: world.len() as u32 });
    let mut overlay = if game.imgui_ui { Vec.new() } else { game.build_ui(size, input.cursor) };
    if let Option.Some(start) = input.box_start {
        if let Option.Some(end) = input.cursor {
            if start.distance(end) >= DRAG_THRESHOLD { selection_box(start, end, size, &mut overlay); }
        }
    }
    for i in 0..overlay.len() { vertices.push(overlay[i]); }
    batches.push(DrawBatch { view_proj: ui_projection(size).to_cols(), first: world.len() as u32, count: overlay.len() as u32 });
    // The library UI lays out over the same frame, in logical pixels, and is drawn last.
    if game.imgui_ui {
        run_ui(game, ctx, ui, size, scale, dt, input.cursor);
        game.ui_captured = ui.wants_mouse;
    } else {
        ui.wants_mouse = false;
        ui.wants_keyboard = false;
    }
    ui.input = next_frame(ui.input);
    FrameOut { keep: true, ui: take_ui_data(ui) }
}

/// A game hosted or joined from the command line replaces the local one: the exit code to give
/// when it could not be (0 when there is nothing to do or it is done). A guest gets its game from
/// the host's welcome before its window opens.
fn start_network(options: &Options, game: &mut GameState, net: &mut NetLink) -> i32 can {Log, Clock, Net, Entropy, Rand} {
    if options.host {
        let addr = if options.interact_mp { ipv4(127, 0, 0, 1, options.port) } else { ipv4(0, 0, 0, 0, options.port) };
        let (hosted, started) = host_started(options.players, &default_settings(), &addr, Clock.now_nanos());
        *game = hosted;
        if let Option.Some(why) = net.adopt(started) {
            error(fn() can {Out} { Out.put(&why); });
            return 3;
        }
        let port = net.port().unwrap_or(options.port);
        let code = game.join_code().unwrap_or(to_owned(""));
        info(fn() can {Out} { Out.put("hosting on port "); show_i64(port as i64); Out.put(" for more players; they join with code "); Out.put(&code); });
    }
    if let &Option.Some(target) = &options.join {
        let code_text = match &options.code { &Option.Some(c) => copy_text(&c), &Option.None => to_owned("") };
        let Option.Some(addr) = address_of(&target, DEFAULT_PORT) else {
            error(fn() can {Out} { Out.put("the host address is not HOST or HOST:PORT (an IPv4 address or localhost)"); });
            return 4;
        };
        if let Option.Some(why) = net.adopt(guest_started(&addr, &code_text)) {
            error(fn() can {Out} { Out.put(&why); });
            return 4;
        }
        let started_at = Clock.now_nanos();
        while !game.is_networked() && net.is_active() && Clock.now_nanos() - started_at < JOIN_WAIT_NS {
            net.pump(Clock.now_nanos(), game);
            yield_now();
        }
        if !game.is_networked() {
            let why = copy_text(&game.notice);
            error(fn() can {Out} { Out.put("couldn't join: "); Out.put(&why); });
            return 4;
        }
        let side = game.local_team.name();
        info(fn() can {Out} { Out.put("joined the game as "); Out.put(side); });
    }
    0
}

fn copy_text(s: &Str) -> Str { to_owned(s) }

/// The game in a window for `frames` frames (0 for until it is closed).
/// Most of the primary monitor, centered, so there's room for the map and the UI.
fn window_spec() -> WindowPlace {
    let screen = primary_monitor();
    if screen.width <= 0 || screen.height <= 0 {
        return WindowPlace { x: 100, y: 100, width: DEFAULT_WIDTH, height: DEFAULT_HEIGHT, hidden: false };
    }
    let width = (screen.width as f32 * WINDOW_SCREEN_FRACTION) as i32;
    let height = (screen.height as f32 * WINDOW_SCREEN_FRACTION) as i32;
    WindowPlace { x: screen.x + (screen.width - width) / 2, y: screen.y + (screen.height - height) / 2, width, height, hidden: false }
}

/// The file the player's settings are kept in between sessions (`persist.tua`).
const SETTINGS_FILE: str = "settings.txt";
/// Where the panels were put (`imgui_layout.tua`) and the library window and dock state.
const LAYOUT_FILE: str = "layout.txt";
const IMGUI_FILE: str = "imgui.txt";

fn play(options: &Options, mb: &Mailbox) -> i32 can {Log, Clock, Fs, Env, Net, Entropy} {
    let mut rng = seed(Clock.now_nanos() as u64);
    let hidden = options.screenshot.is_some();
    let mut spec = window_spec();
    // Screenshots are the same size on any monitor.
    let size = match options.size { Option.Some(s) => Option.Some(s), Option.None => if hidden { Option.Some(DEFAULT_SIZE) } else { Option.None } };
    if let Option.Some((w, h)) = size {
        spec.width = w as i32;
        spec.height = h as i32;
    }
    spec.hidden = hidden;
    let frames = options.frames;
    let validate = options.validate;
    let mut shot: Option[Screenshot] = Option.None;
    if let &Option.Some(path) = &options.screenshot { shot = Option.Some(screenshot(to_owned(&path), Clock.now_nanos())); }
    let mut built: Option[Atlas] = Option.None;
    let failed = handle { built = Option.Some(atlas()); 0 } with FontError { fail(code) => { abort code } };
    let mut built_ui: Option[FontAtlas] = Option.None;
    let failed_ui = handle { built_ui = Option.Some(ui_atlas()); 0 } with FontError { fail(code) => { abort code } };
    let ui_font = match built_ui {
        Option.Some(a) => a,
        Option.None => { error(fn() can {Out} { Out.put("the UI font could not be rasterized"); }); return failed_ui; }
    };
    let atlas = match built {
        Option.Some(a) => a,
        Option.None => { error(fn() can {Out} { Out.put("the built-in font could not be rasterized"); }); return failed; }
    };
    let mut built_ctx: Option[FontAtlas] = Option.None;
    let failed_ctx = handle { built_ctx = Option.Some(ui_atlas()); 0 } with FontError { fail(code) => { abort code } };
    let ctx_font = match built_ctx {
        Option.Some(a) => a,
        Option.None => { error(fn() can {Out} { Out.put("the UI font could not be rasterized"); }); return failed_ctx; }
    };
    if !claim_app_id(APP_USER_MODEL_ID) { warn(fn() can {Out} { Out.put("couldn't set the taskbar application id"); }); }
    let icons = Icons { small: icon(WINDOW_ICON_SIZE), small_size: WINDOW_ICON_SIZE, big: icon(TASKBAR_ICON_SIZE), big_size: TASKBAR_ICON_SIZE };
    handle {
        let mut game = match options.seed {
            Option.Some(s) => GameState.world_scenario_with(s, &default_settings()),
            Option.None => options.scenario.start(&default_settings()),
        };
        let mut net = no_link();
        let started = start_network(options, &mut game, &mut net);
        if started != 0 { net.stop(); close_link(net); return started; }
        // Everywhere but a screenshot keeps the player's settings between sessions.
        let remember = !hidden && !options.interact && !options.interact_mp;
        let saved = if remember { read(SETTINGS_FILE) } else { Option.None };
        if let &Option.Some(t) = &saved { let view = &t; game.set_settings(settings_from_text(view)); }
        game.imgui_ui = !options.classic;
        if let &Option.Some(name) = &options.open { let _opened = game.open_panel(&name); }
        let mut ctx = ui_context(ctx_font, if remember { read(IMGUI_FILE) } else { Option.None });
        let saved_layout = if remember { read(LAYOUT_FILE) } else { Option.None };
        let mut ui = match &saved_layout {
            &Option.Some(t) => { let view = &t; ui_state(layout_from_text(view), vec2(spec.width as f32, spec.height as f32)) }
            &Option.None => ui_state(layout_state(), vec2(spec.width as f32, spec.height as f32)),
        };
        let mut input = Controls {
            cursor: Option.None,
            size: vec2(spec.width as f32, spec.height as f32),
            panning: false,
            left_press: Option.None,
            left_dragging: false,
            box_start: Option.None,
            painting_jobs: false,
            queue_scroll_dragging: false,
            building_scroll_dragging: false,
            queue_item_dragging: false,
            mods: Modifiers { shift: false, control: false, alt: false },
            closed: false,
        };
        let mut script = driver(options.interact_mp);
        let rc = handle { run(TITLE, spec, &icons, &atlas, &ui_font, frames, validate) } with Scene {
            // A screenshot shows the scenario as it starts, whatever the mouse and keyboard do.
            input(e, scale) => { resume if hidden { WindowRequest.Nothing } else { on_event(&mut game, &mut input, &mut ui, scale, e) } }
            frame(w, h, dt, scale, vertices, batches) => {
                resume on_frame(&mut game, &mut net, &input, &mut ctx, &mut ui, &mut shot, &mut script, mb, options.interact || options.interact_mp, w, h, dt, scale, vertices, batches)
            }
            opened(hwnd) => { mb.hwnd.store(hwnd as i64); resume options.interact || options.interact_mp }
            capture() => { resume match &shot { &Option.Some(s) => s.capture_this_frame(), &Option.None => false } }
            captured(w, h, rgba) => {
                if let &mut Option.Some(s) = &mut shot { let _ok = s.captured(w, h, rgba); }
                resume
            }
        };
        if remember {
            let now = game.settings_text();
            let unchanged = match &saved { &Option.Some(t) => str_eq(&t, &now), &Option.None => false };
            if !unchanged { write(SETTINGS_FILE, &now); }
            // Where the player put the panels, and the library's dock trees.
            write(LAYOUT_FILE, &ui.layout.to_text());
            write(IMGUI_FILE, &ctx.save_settings());
        }
        let written = match &shot { &Option.Some(s) => s.is_written(), &Option.None => true };
        close_link(net);
        if (options.interact || options.interact_mp) && rc == 0 { return verdict(&script); }
        if rc == 0 && !written {
            error(fn() can {Out} { Out.put("the window closed before the screenshot was written"); });
            1
        } else {
            rc
        }
    } with Rand { rand() => { resume rng.next() } }
}

fn main() -> i32 can {Env} {
    let args = arguments_of();
    let options = match parse(&args) {
        Result.Ok(o) => o,
        Result.Err(message) => { println(&message); return 2; }
    };
    if options.help {
        println(USAGE);
        return 0;
    }
    let mb = mailbox();
    with_env_level("HEX_LOG", Level.Info, fn() -> i32 can {Log, Env} {
        with_system_clock(fn() -> i32 can {Log, Clock, Env} {
            default_fs(fn() -> i32 can {Log, Clock, Fs, Env} {
                default_net(fn() -> i32 can {Log, Clock, Fs, Env, Net} {
                    os_entropy(fn() -> i32 can {Log, Clock, Fs, Env, Net, Entropy} {
                        // The interaction script's poster runs beside the game and ends with the script.
                        scope(fn(s: &Scope) -> i32 can {Log, Clock, Fs, Env, Net, Entropy} {
                            if options.interact || options.interact_mp { spawn(s, fn() -> i32 { poster(&mb) }); }
                            play(&options, &mb)
                        })
                    })
                })
            })
        })
    })
}
