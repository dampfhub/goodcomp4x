//! The entry point: a window, its input, and the frame loop. The game hears the window's
//! events and draws itself each frame through the renderer's `Scene`.
//!
//! Arguments: a trailing number draws that many frames and exits (0, the default, runs until
//! the window is closed); `--validate` runs under the Khronos validation layer and exits 83
//! when it reported anything. The combat log prints at `info`, or at the level the
//! environment variable `HEX_LOG` names.

use std.linalg.Vec2;
use std.linalg.vec2;
use std.rand.Rand;
use std.rand.seed;
use std.time.Clock;
use std.time.with_system_clock;
use std.env.Env;
use log.Level;
use log.Log;
use log.with_env_level;
use win32.events.Event;
use win32.events.Button;
use win32.events.Key;
use win32.events.Modifiers;
use win32.cmdline.command_line;
use win32.cmdline.has_flag;
use win32.cmdline.trailing_number;
use renderer.DrawBatch;
use renderer.Scene;
use renderer.run;
use renderer.pipelines.MeshVertex;
use game.GameState;
use game.city.BUILDS;
use game.orders.ClickMode;
use game.ui.ui_projection;

const TITLE: str = "Hex Combat Sandbox";
const WIDTH: i32 = 1280;
const HEIGHT: i32 = 720;

/// Dragging the left button at least this many pixels pans the map instead of clicking.
const DRAG_THRESHOLD: f32 = 6.0;

/// A left-button press waiting for its release: where it went down, the click mode the
/// modifiers picked then, and whether a click was allowed then (not while a turn played out).
struct Press { origin: Vec2, mode: ClickMode, may_click: bool }

/// The input state the frame loop keeps between events.
struct Input {
    cursor: Option[Vec2],
    size: Vec2,
    panning: bool,
    left_press: Option[Press],
    left_dragging: bool,
    /// Where an Alt-drag selection box started, while the button is down.
    box_start: Option[Vec2],
    mods: Modifiers,
    closed: bool,
}

/// Applies one window event to the game.
fn on_event(game: &mut GameState, input: &mut Input, e: Event) can {Log} {
    match e {
        Event.CloseRequested => { input.closed = true; }
        Event.Resized(w, h) => { input.size = vec2(w as f32, h as f32); }
        Event.CursorMoved(x, y) => {
            let pos = vec2(x, y);
            let mut pan_from = input.cursor;
            if let Option.Some(press) = input.left_press {
                if !input.left_dragging && pos.distance(press.origin) >= DRAG_THRESHOLD {
                    input.left_dragging = true;
                    // Include motion below the threshold when the drag begins.
                    if !input.panning { pan_from = Option.Some(press.origin); }
                }
            }
            if (input.panning || input.left_dragging) && input.size.y > 0.0 {
                if let Option.Some(last) = pan_from { game.camera.pan(pos.sub(last), input.size); }
            }
            input.cursor = Option.Some(pos);
        }
        Event.Focused(focused) => {
            if !focused {
                // The release may never arrive once focus is gone.
                input.left_press = Option.None;
                input.left_dragging = false;
                input.panning = false;
                input.cursor = Option.None;
                input.box_start = Option.None;
            }
        }
        Event.ModifiersChanged(m) => { input.mods = m; }
        Event.MouseDown(b) => match b {
            Button.Left => {
                if let Option.Some(cursor) = input.cursor {
                    // Alt starts a selection box instead of a click or pan.
                    if input.mods.alt {
                        input.box_start = Option.Some(cursor);
                        return;
                    }
                    let mode = if input.mods.shift { ClickMode.Attack } else if input.mods.control { ClickMode.Swap } else { ClickMode.Normal };
                    input.left_press = Option.Some(Press { origin: cursor, mode, may_click: !game.is_resolving() });
                    input.left_dragging = input.panning;
                }
            }
            Button.Right => {
                if let Option.Some(cursor) = input.cursor { game.handle_context_click(cursor, input.size, input.mods.control); }
            }
            Button.Middle => {
                input.panning = true;
                if input.left_press.is_some() { input.left_dragging = true; }
            }
        },
        Event.MouseUp(b) => match b {
            Button.Left => {
                if let Option.Some(start) = input.box_start {
                    input.box_start = Option.None;
                    if let Option.Some(end) = input.cursor {
                        // Barely moving makes it an Alt-click on one unit.
                        if start.distance(end) < DRAG_THRESHOLD {
                            game.toggle_in_selection(end, input.size);
                        } else {
                            game.select_in_box(start, end, input.size);
                        }
                        return;
                    }
                }
                if let Option.Some(press) = input.left_press {
                    if !input.left_dragging && press.may_click { game.handle_click(press.origin, input.size, press.mode); }
                }
                input.left_press = Option.None;
                input.left_dragging = false;
            }
            Button.Middle => { input.panning = false; }
            Button.Right => {}
        },
        Event.Wheel(steps) => game.camera.zoom(steps),
        Event.KeyDown(key, repeat) => { if !repeat { on_key(game, key); } }
        _ => {}
    }
}

/// A key going down, not repeating.
fn on_key(game: &mut GameState, key: Key) can {Log} {
    match key {
        Key.Space => game.hold_or_end_turn(),
        Key.Tab => game.select_next_unit(),
        Key.Letter(c) => match c as char {
            'Q' => game.toggle_selected_ability(),
            'C' => game.select_city(),
            'A' => game.auto_assign_selected_city(),
            'M' => game.choose_move_action(),
            'X' => game.choose_attack_action(),
            'R' => game.build_worker_road_selected(),
            'I' => game.improve_worker_tile_selected(),
            'F' => game.found_city_selected(),
            'Y' => game.toggle_yields(),
            'G' => game.toggle_guard(),
            _ => {}
        },
        Key.Digit(d) => {
            if d >= 1 && d <= 4 { game.queue_selected_city_unit(BUILDS[(d - 1) as i32]); }
        }
        _ => {}
    }
}

/// Plays one frame: advances the game by `dt` seconds and lays out the world and the UI as
/// two batches. Answers whether to keep running.
fn on_frame(game: &mut GameState, input: &Input, w: u32, h: u32, dt: f32, vertices: &mut Vec[MeshVertex], batches: &mut Vec[DrawBatch]) -> bool can {Log, Rand} {
    if input.closed { return false; }
    game.update(dt);
    let size = vec2(w as f32, h as f32);
    let world = game.build_vertices();
    for i in 0..world.len() { vertices.push(world[i]); }
    batches.push(DrawBatch { view_proj: game.camera.view_proj(size).to_cols(), first: 0, count: world.len() as u32 });
    let ui = game.build_ui(size);
    for i in 0..ui.len() { vertices.push(ui[i]); }
    batches.push(DrawBatch { view_proj: ui_projection(size).to_cols(), first: world.len() as u32, count: ui.len() as u32 });
    true
}

/// The game in a window for `frames` frames (0 for until it is closed).
fn play(frames: i32, validate: bool) -> i32 can {Log, Clock} {
    let mut rng = seed(Clock.now_nanos() as u64);
    handle {
        let mut game = GameState.new();
        let mut input = Input {
            cursor: Option.None,
            size: vec2(WIDTH as f32, HEIGHT as f32),
            panning: false,
            left_press: Option.None,
            left_dragging: false,
            box_start: Option.None,
            mods: Modifiers { shift: false, control: false, alt: false },
            closed: false,
        };
        handle { run(TITLE, WIDTH, HEIGHT, frames, validate) } with Scene {
            input(e) => { on_event(&mut game, &mut input, e); resume }
            frame(w, h, dt, vertices, batches) => { resume on_frame(&mut game, &input, w, h, dt, vertices, batches) }
        }
    } with Rand { rand() => { resume rng.next() } }
}

fn main() -> i32 can {Env} {
    let mut buf: [u8; 512] = [0; 512];
    let mut len: i32 = 0;
    command_line(&mut buf, &mut len);
    let validate_flag: [u8; 8] = [118, 97, 108, 105, 100, 97, 116, 101];
    let frames = trailing_number(&buf, len, 0);
    let validate = has_flag(&buf, len, &validate_flag, 8);
    with_env_level("HEX_LOG", Level.Info, fn() -> i32 can {Log} {
        with_system_clock(fn() -> i32 can {Log, Clock} { play(frames, validate) })
    })
}
