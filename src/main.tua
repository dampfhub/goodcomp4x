//! The entry point: a window, its input, and the frame loop. The game hears the window's
//! events and draws itself each frame through the renderer's `Scene`.
//!
//! Arguments: `cli.tua` (`--help` lists them). The combat log prints at `info`, or at the level
//! the environment variable `HEX_LOG` names.

use std.linalg.Vec2;
use std.linalg.vec2;
use std.rand.Rand;
use std.rand.seed;
use std.time.Clock;
use std.time.with_system_clock;
use std.env.Env;
use log.Level;
use log.Log;
use log.error;
use font.ttf.FontError;
use std.fmt.Out;
use log.with_env_level;
use win32.events.Event;
use win32.events.Button;
use win32.events.Key;
use win32.events.Modifiers;
use win32.primary_monitor;
use win32.claim_app_id;
use log.warn;
use win32.cmdline.arguments_of;
use std.io.Fs;
use std.io.default_fs;
use std.io.println;
use std.str.Str;
use std.str.to_owned;
use std.fmt.show_i64;
use cli.Options;
use cli.USAGE;
use cli.parse;
use screenshot.DEFAULT_SIZE;
use screenshot.Screenshot;
use screenshot.screenshot;
use renderer.DrawBatch;
use renderer.Icons;
use renderer.WindowRequest;
use renderer.WindowSpec;
use renderer.Scene;
use renderer.run;
use renderer.pipelines.MeshVertex;
use icon.icon;
use game.GameState;
use renderer.Atlas;
use game.font.atlas;
use game.city.BUILDS;
use game.orders.ClickMode;
use game.scenario.Scenario;
use game.ui.quit_prompt;
use game.ui.selection_box;
use game.ui.ui_projection;

const TITLE: str = "Hex Combat Sandbox";
/// The game's application id on Windows (`claim_app_id`).
const APP_USER_MODEL_ID: str = "dampfhub.riskofcivlike";
/// The window opens at this fraction of the primary monitor's size, centered on it.
const WINDOW_SCREEN_FRACTION: f32 = 0.8;
/// Window size when the monitor's size can't be found.
const DEFAULT_WIDTH: i32 = 1600;
const DEFAULT_HEIGHT: i32 = 900;
/// Window icon sizes, in pixels; Windows scales them to fit.
const WINDOW_ICON_SIZE: i32 = 64;
const TASKBAR_ICON_SIZE: i32 = 256;

/// How long Escape must be held to quit, in nanoseconds.
const QUIT_HOLD: i64 = 1000000000;

/// Dragging the left button at least this many pixels pans the map instead of clicking.
const DRAG_THRESHOLD: f32 = 6.0;

/// A left-button press waiting for its release: where it went down, the click mode the
/// modifiers picked then, and whether a click was allowed then (not while a turn played out).
struct Press { origin: Vec2, mode: ClickMode, may_click: bool }

/// The input state the frame loop keeps between events.
struct Input {
    cursor: Option[Vec2],
    size: Vec2,
    panning: bool,
    left_press: Option[Press],
    left_dragging: bool,
    /// Where an Alt-drag selection box started, while the button is down.
    box_start: Option[Vec2],
    mods: Modifiers,
    /// When Escape was pressed (`Clock.now_nanos`), while it's held; the game quits once it's
    /// been held for `QUIT_HOLD`.
    quit_held_since: Option[i64],
    closed: bool,
}

/// Losing focus or the cursor: a release may never arrive, so every gesture in progress ends.
fn forget_gestures(input: &mut Input) {
    input.left_press = Option.None;
    input.left_dragging = false;
    input.panning = false;
    input.cursor = Option.None;
    input.quit_held_since = Option.None;
    input.box_start = Option.None;
}

/// Applies one window event to the game, answering what the window should do about it.
fn on_event(game: &mut GameState, input: &mut Input, e: Event) -> WindowRequest can {Log, Clock} {
    match e {
        Event.CloseRequested => { input.closed = true; }
        Event.Resized(w, h) => { input.size = vec2(w as f32, h as f32); }
        Event.CursorMoved(x, y) => {
            let pos = vec2(x, y);
            let mut pan_from = input.cursor;
            if let Option.Some(press) = input.left_press {
                if !input.left_dragging && pos.distance(press.origin) >= DRAG_THRESHOLD {
                    input.left_dragging = true;
                    // Include motion below the threshold when the drag begins.
                    if !input.panning { pan_from = Option.Some(press.origin); }
                }
            }
            if (input.panning || input.left_dragging) && input.size.y > 0.0 {
                if let Option.Some(last) = pan_from { game.camera.pan(pos.sub(last), input.size); }
            }
            input.cursor = Option.Some(pos);
        }
        Event.Focused(focused) => { if !focused { forget_gestures(input); } }
        Event.CursorLeft => forget_gestures(input),
        Event.ModifiersChanged(m) => { input.mods = m; }
        Event.MouseDown(b) => match b {
            Button.Left => {
                if let Option.Some(cursor) = input.cursor {
                    // Alt starts a selection box instead of a click or pan.
                    if input.mods.alt {
                        input.box_start = Option.Some(cursor);
                        return WindowRequest.Nothing;
                    }
                    let mode = if input.mods.shift { ClickMode.Attack } else if input.mods.control { ClickMode.Swap } else { ClickMode.Normal };
                    input.left_press = Option.Some(Press { origin: cursor, mode, may_click: !game.is_resolving() });
                    input.left_dragging = input.panning;
                }
            }
            Button.Right => {
                if let Option.Some(cursor) = input.cursor { game.handle_context_click(cursor, input.size, input.mods.control); }
            }
            Button.Middle => {
                input.panning = true;
                if input.left_press.is_some() { input.left_dragging = true; }
            }
        },
        Event.MouseUp(b) => match b {
            Button.Left => {
                if let Option.Some(start) = input.box_start {
                    input.box_start = Option.None;
                    if let Option.Some(end) = input.cursor {
                        // Barely moving makes it an Alt-click on one unit.
                        if start.distance(end) < DRAG_THRESHOLD {
                            game.toggle_in_selection(end, input.size);
                        } else {
                            game.select_in_box(start, end, input.size);
                        }
                        return WindowRequest.Nothing;
                    }
                }
                if let Option.Some(press) = input.left_press {
                    if !input.left_dragging && press.may_click { game.handle_click(press.origin, input.size, press.mode); }
                }
                input.left_press = Option.None;
                input.left_dragging = false;
            }
            Button.Middle => { input.panning = false; }
            Button.Right => {}
        },
        Event.Wheel(steps) => game.camera.zoom(steps),
        Event.KeyDown(key, repeat) => {
            if !repeat {
                match key {
                    // Holding Escape quits; see `on_frame`.
                    Key.Escape => { input.quit_held_since = Option.Some(Clock.now_nanos()); }
                    // F5: borderless fullscreen on the window's monitor, or back.
                    Key.Function(5) => { return WindowRequest.ToggleFullscreen; }
                    _ => on_key(game, key),
                }
            }
        }
        Event.KeyUp(key) => match key { Key.Escape => { input.quit_held_since = Option.None; } _ => {} },
        _ => {}
    }
    WindowRequest.Nothing
}

/// A key going down, not repeating.
fn on_key(game: &mut GameState, key: Key) can {Log} {
    match key {
        Key.Space => game.hold_or_end_turn(),
        Key.Tab => game.select_next_unit(),
        Key.Letter(c) => match c as char {
            'Q' => game.toggle_selected_ability(),
            'C' => game.select_city(),
            'A' => game.auto_assign_selected_city(),
            'M' => game.choose_move_action(),
            'X' => game.choose_attack_action(),
            'R' => game.build_worker_road_selected(),
            'I' => game.improve_worker_tile_selected(),
            'F' => game.found_city_selected(),
            'Y' => game.toggle_yields(),
            'G' => game.toggle_guard(),
            _ => {}
        },
        Key.Function(f) => match f {
            1 => game.switch_scenario(Scenario.Combat),
            2 => game.switch_scenario(Scenario.Cities),
            3 => game.switch_scenario(Scenario.Frontier),
            6 => game.save_state(),
            7 => game.load_state(),
            8 => game.toggle_instant_playback(),
            _ => {}
        },
        Key.Digit(d) => {
            if d >= 1 && d <= 4 { game.queue_selected_city_unit(BUILDS[(d - 1) as i32]); }
        }
        _ => {}
    }
}

/// Plays one frame: advances the game by `dt` seconds and lays out the world and the UI as
/// two batches. Answers whether to keep running: not once the window was closed, the
/// screenshot written, or its time run out.
fn on_frame(game: &mut GameState, input: &Input, shot: &mut Option[Screenshot], w: u32, h: u32, dt: f32, vertices: &mut Vec[MeshVertex], batches: &mut Vec[DrawBatch]) -> bool can {Log, Rand, Clock} {
    if input.closed { return false; }
    if let &mut Option.Some(s) = shot {
        let now = Clock.now_nanos();
        if s.is_written() { return false; }
        if s.timed_out(now) {
            let drawn = s.frames_drawn();
            error(fn() can {Out} { Out.put("no screenshot after 20 s ("); show_i64(drawn as i64); Out.put(" frames drawn)"); });
            return false;
        }
        s.after_frame(now);
    }
    game.update(dt);
    let size = vec2(w as f32, h as f32);
    game.update_hover(input.cursor, size, dt);
    let world = game.build_vertices();
    for i in 0..world.len() { vertices.push(world[i]); }
    batches.push(DrawBatch { view_proj: game.camera.view_proj(size).to_cols(), first: 0, count: world.len() as u32 });
    let mut ui = game.build_ui(size, input.cursor);
    if let Option.Some(since) = input.quit_held_since {
        let progress = (Clock.now_nanos() - since) as f32 / QUIT_HOLD as f32;
        if progress >= 1.0 { return false; }
        quit_prompt(progress, size, &mut ui);
    }
    if let Option.Some(start) = input.box_start {
        if let Option.Some(end) = input.cursor {
            if start.distance(end) >= DRAG_THRESHOLD { selection_box(start, end, size, &mut ui); }
        }
    }
    for i in 0..ui.len() { vertices.push(ui[i]); }
    batches.push(DrawBatch { view_proj: ui_projection(size).to_cols(), first: world.len() as u32, count: ui.len() as u32 });
    true
}

/// The game in a window for `frames` frames (0 for until it is closed).
/// Most of the primary monitor, centered, so there's room for the map and the UI.
fn window_spec() -> WindowSpec {
    let screen = primary_monitor();
    if screen.width <= 0 || screen.height <= 0 {
        return WindowSpec { x: 100, y: 100, width: DEFAULT_WIDTH, height: DEFAULT_HEIGHT, hidden: false };
    }
    let width = (screen.width as f32 * WINDOW_SCREEN_FRACTION) as i32;
    let height = (screen.height as f32 * WINDOW_SCREEN_FRACTION) as i32;
    WindowSpec { x: screen.x + (screen.width - width) / 2, y: screen.y + (screen.height - height) / 2, width, height, hidden: false }
}

fn play(options: &Options) -> i32 can {Log, Clock, Fs} {
    let mut rng = seed(Clock.now_nanos() as u64);
    let hidden = options.screenshot.is_some();
    let mut spec = window_spec();
    // Screenshots are the same size on any monitor.
    let size = match options.size { Option.Some(s) => Option.Some(s), Option.None => if hidden { Option.Some(DEFAULT_SIZE) } else { Option.None } };
    if let Option.Some((w, h)) = size {
        spec.width = w as i32;
        spec.height = h as i32;
    }
    spec.hidden = hidden;
    let frames = options.frames;
    let validate = options.validate;
    let mut shot: Option[Screenshot] = Option.None;
    if let &Option.Some(path) = &options.screenshot { shot = Option.Some(screenshot(to_owned(&path), Clock.now_nanos())); }
    let mut built: Option[Atlas] = Option.None;
    let failed = handle { built = Option.Some(atlas()); 0 } with FontError { fail(code) => { abort code } };
    let atlas = match built {
        Option.Some(a) => a,
        Option.None => { error(fn() can {Out} { Out.put("the built-in font could not be rasterized"); }); return failed; }
    };
    if !claim_app_id(APP_USER_MODEL_ID) { warn(fn() can {Out} { Out.put("couldn't set the taskbar application id"); }); }
    let icons = Icons { small: icon(WINDOW_ICON_SIZE), small_size: WINDOW_ICON_SIZE, big: icon(TASKBAR_ICON_SIZE), big_size: TASKBAR_ICON_SIZE };
    handle {
        let mut game = options.scenario.start();
        let mut input = Input {
            cursor: Option.None,
            size: vec2(spec.width as f32, spec.height as f32),
            panning: false,
            left_press: Option.None,
            left_dragging: false,
            box_start: Option.None,
            mods: Modifiers { shift: false, control: false, alt: false },
            quit_held_since: Option.None,
            closed: false,
        };
        let rc = handle { run(TITLE, spec, &icons, &atlas, frames, validate) } with Scene {
            // A screenshot shows the scenario as it starts, whatever the mouse and keyboard do.
            input(e) => { resume if hidden { WindowRequest.Nothing } else { on_event(&mut game, &mut input, e) } }
            frame(w, h, dt, vertices, batches) => { resume on_frame(&mut game, &input, &mut shot, w, h, dt, vertices, batches) }
            capture() => { resume match &shot { &Option.Some(s) => s.capture_this_frame(), &Option.None => false } }
            captured(w, h, rgba) => {
                if let &mut Option.Some(s) = &mut shot { let _ok = s.captured(w, h, rgba); }
                resume
            }
        };
        let written = match &shot { &Option.Some(s) => s.is_written(), &Option.None => true };
        if rc == 0 && !written {
            error(fn() can {Out} { Out.put("the window closed before the screenshot was written"); });
            1
        } else {
            rc
        }
    } with Rand { rand() => { resume rng.next() } }
}

fn main() -> i32 can {Env} {
    let args = arguments_of();
    let options = match parse(&args) {
        Result.Ok(o) => o,
        Result.Err(message) => { println(&message); return 2; }
    };
    if options.help {
        println(USAGE);
        return 0;
    }
    with_env_level("HEX_LOG", Level.Info, fn() -> i32 can {Log} {
        with_system_clock(fn() -> i32 can {Log, Clock} {
            default_fs(fn() -> i32 can {Log, Clock, Fs} { play(&options) })
        })
    })
}
