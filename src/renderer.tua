const FRAMES_IN_FLIGHT: u32 = 2;
/// The most vertices one frame draws; a frame's vertices past this are not drawn.
const MAX_VERTICES: u32 = 131072;
/// The cap on the frame rate, so the loop does not load the GPU with frames the display
/// cannot show.
const TARGET_FPS: i64 = 165;
/// A `stop` reason besides a `VkResult`: the program's `Scene` asked to stop.
const STOP_DONE: i32 = 1;

/// A range of the frame's vertices drawn under one view-projection matrix.
pub struct DrawBatch { view_proj: [[f32; 4]; 4], first: u32, count: u32 }

/// What the program draws, and what it hears. `input` is one of the window's events, in the
/// order they arrived. `frame` fills `vertices` and `batches` for a frame whose target is
/// `width` by `height` pixels, `dt` seconds after the previous one; both arrive empty. It
/// answers whether to keep running.
pub effect Scene {
    fn input(e: Event);
    fn frame(width: u32, height: u32, dt: f32, vertices: &mut Vec[MeshVertex], batches: &mut Vec[DrawBatch]) -> bool;
}

/// Waits for the next frame's turn, handing the window's input to the program as it arrives;
/// the seconds since the previous frame.
fn pace(run: &mut Run, win: &mut Window) -> f32 can {Scene, Clock} {
    handle { next_frame(&mut run.pace, win) } with Events { event(e) => { Scene.input(e); resume } }
}

/// Releases a ring whose frame cannot go on and reports `rc`.
fn give_up_ring(pool: &mut CommandPool, t: &mut Timeline, ring: FramesInFlight[RingIdle], rc: i32) -> Never can {VkError, Gpu} {
    destroy_frames(pool, t, ring);
    VkError.fail(rc)
}

fn give_up_acquired(pool: &mut CommandPool, t: &mut Timeline, ring: FramesInFlight[RingAcquired], rc: i32) -> Never can {VkError, Gpu} {
    destroy_frames(pool, t, abandon(ring));
    VkError.fail(rc)
}

/// The per-run state the frame loop reads and reports: the frame budget (0 for none), the
/// frames drawn, why the loop stopped (0 while running), and the pacer.
struct Run { budget: i32, drawn: i32, stop: i32, pace: Pacer, vertices: Vec[MeshVertex], batches: Vec[DrawBatch] }

/// Draws one frame through the ring and hands the idle ring back.
fn draw_one(q: &mut Queue, pq: &mut PresentQueue, win: &mut Window, sc: &Swapchain, pass: &RenderPass[Bgra8Unorm, NoFormat], fbs: &Framebuffers, mesh: &Mesh[Bgra8Unorm, NoFormat], sb: &mut StreamVertexBuffer[MeshVertex], a: &mut Allocator, pool: &mut CommandPool, t: &mut Timeline, ring: FramesInFlight[RingIdle], run: &mut Run) -> FramesInFlight[RingIdle] can {VkError, Gpu, Scene, Clock} {
    let dt = pace(run, win);
    let w = swapchain_width(sc);
    let h = swapchain_height(sc);
    let size = client_size(&*win);
    if size[0] != w || size[1] != h { run.stop = VK_ERROR_OUT_OF_DATE_KHR; return ring; }
    run.vertices.clear();
    run.batches.clear();
    if !Scene.frame(w, h, dt, &mut run.vertices, &mut run.batches) { run.stop = STOP_DONE; return ring; }
    let n = if (run.vertices.len() as u32) > MAX_VERTICES { MAX_VERTICES } else { run.vertices.len() as u32 };
    let acquired = acquire(pool, t, sc, ring);
    let code = frame_code(&acquired);
    if code < 0 { run.stop = code; return abandon(acquired); }
    let index = frame_image_index(&acquired);
    let mut cw: CmdWords[Executable] = no_cmd_words();
    let rc = handle {
        stream_vertices(a, sb, &acquired, &run.vertices, n);
        let initial = allocate_primary(pool);
        let rec = begin(pool, initial);
        let mut draw = cmd_begin_render_pass_ring(rec, pass, bgra8_unorm(), no_format(), sc, &acquired, framebuffer(fbs, index), [0.05, 0.05, 0.08, 1.0]);
        cmd_set_viewport_scissor(&mut draw, w, h);
        mesh.bind(&mut draw);
        mesh.bind_stream(&mut draw, &*sb, &acquired);
        for b in 0..run.batches.len() {
            let batch = run.batches[b];
            let end_at = batch.first + batch.count;
            let count = if end_at > n { if batch.first > n { 0 } else { n - batch.first } } else { batch.count };
            if count > 0 {
                mesh.push(&mut draw, MeshPush { view_proj: batch.view_proj });
                cmd_draw(&mut draw, count, 1, batch.first, 0);
            }
        }
        let rec2 = cmd_end_render_pass(draw);
        let exec = end(pool, rec2);
        cw = consume_executable(exec);
        0
    } with VkError { fail(e) => { abort e } };
    if rc != 0 { give_up_acquired(pool, t, acquired, rc) }
    let wait = point_of(t, 0);
    let rendering = submit_frame(q, t, acquired, executable_from_words(cw), wait);
    let idle = present(pq, sc, rendering);
    let pc = frame_code(&idle);
    if pc < 0 { run.stop = pc; return idle; }
    run.drawn = run.drawn + 1;
    if run.budget > 0 && run.drawn >= run.budget { run.stop = STOP_DONE; }
    idle
}

/// Draws frames through the ring until one reports a reason to stop.
fn draw_frames(q: &mut Queue, pq: &mut PresentQueue, win: &mut Window, sc: &Swapchain, pass: &RenderPass[Bgra8Unorm, NoFormat], fbs: &Framebuffers, mesh: &Mesh[Bgra8Unorm, NoFormat], sb: &mut StreamVertexBuffer[MeshVertex], a: &mut Allocator, pool: &mut CommandPool, t: &mut Timeline, ring: FramesInFlight[RingIdle], run: &mut Run) -> FramesInFlight[RingIdle] can {VkError, Gpu, Scene, Clock} {
    let mut r = ring;
    while run.stop == 0 {
        r = draw_one(q, pq, win, sc, pass, fbs, mesh, sb, a, pool, t, r, run);
    }
    r
}

/// Waits, handing input to the program, until the window's client area is not empty: a
/// minimized window has no swapchain to draw to.
fn wait_while_minimized(win: &mut Window, run: &mut Run) can {Scene, Clock} {
    let mut size = client_size(&*win);
    while size[0] == 0 || size[1] == 0 {
        let _dt = pace(run, win);
        size = client_size(&*win);
    }
}

/// One swapchain generation at the window's current client size. Frames are drawn until the
/// program stops or the generation goes out of date; then the device is idled, the generation
/// torn down, and the next one begun over the same ring.
fn generation(pd: PhysicalDevice, q: &mut Queue, win: &mut Window, surface: &Surface, pass: &RenderPass[Bgra8Unorm, NoFormat], mesh: &Mesh[Bgra8Unorm, NoFormat], sb: &mut StreamVertexBuffer[MeshVertex], a: &mut Allocator, pool: &mut CommandPool, t: &mut Timeline, ring: FramesInFlight[RingIdle], run: &mut Run) -> FramesInFlight[RingIdle] can {VkError, Gpu, Vk, Scene, Clock} {
    wait_while_minimized(win, run);
    let mut raw: RingWords = consume_frames(ring);
    run.stop = 0;
    let mut ring_live = true;
    let rc = handle {
        let size = client_size(&*win);
        let sc = create_swapchain(pd, surface, size[0], size[1], 0);
        defer { destroy_swapchain(sc); }
        let mut pq = present_queue(pd, surface, *q);
        let fbs = create_framebuffers(&sc, pass);
        defer { destroy_framebuffers(fbs); }
        ring_live = false;
        let r2 = draw_frames(q, &mut pq, win, &sc, pass, &fbs, mesh, sb, a, pool, t, frames_from_words(raw), run);
        raw = consume_frames(r2);
        ring_live = true;
        device_wait_idle();
        0
    } with VkError { fail(c) => { abort c } };
    if rc != 0 && ring_live { give_up_ring(pool, t, frames_from_words(raw), rc) }
    if rc != 0 { VkError.fail(rc) }
    if run.stop < 0 && run.stop != VK_ERROR_OUT_OF_DATE_KHR { give_up_ring(pool, t, frames_from_words(raw), run.stop) }
    if run.stop == VK_ERROR_OUT_OF_DATE_KHR {
        generation(pd, q, win, surface, pass, mesh, sb, a, pool, t, frames_from_words(raw), run)
    } else {
        frames_from_words(raw)
    }
}

fn run_on_device(family: u32, title: &str, width: i32, height: i32, frames: i32) -> i32 can {VkError, Gpu, Vk, Scene, Clock} {
    let mut run = Run { budget: frames, drawn: 0, stop: 0, pace: pacer(TARGET_FPS), vertices: Vec.new(), batches: Vec.new() };
    let rc = handle { handle {
        let mut q = get_queue(family, 0);
        let pd = first_physical_device();
        let mut win = open_window(title, width, height);
        defer { destroy_window(win); }
        let surface = create_surface(&win);
        defer { destroy_surface(surface); }
        let mut alloc = create_allocator(pd);
        defer { destroy_allocator(alloc); }
        let mut pool = create_command_pool(family);
        defer { destroy_command_pool(pool); }
        let mut t = create_timeline();
        defer { destroy_timeline(t); }
        // The colour format is the surface's first; the pass's is a type, so the two are
        // checked here.
        let probe = create_swapchain(pd, &surface, width as u32, height as u32, 0);
        let format = swapchain_format(&probe);
        destroy_swapchain(probe);
        if !format_is(bgra8_unorm(), format) { VkError.fail(HL_ERROR_NOT_FOUND) }
        let pass = create_render_pass(bgra8_unorm());
        defer { destroy_render_pass(pass); }
        let mesh = create_mesh(&pass);
        defer { destroy_mesh(mesh); }
        let mut sb = mesh.create_stream_buffer(&mut alloc, FRAMES_IN_FLIGHT, MAX_VERTICES);
        defer { destroy_stream_vertex_buffer(&mut alloc, sb); }
        let ring = create_frames(FRAMES_IN_FLIGHT);
        let ring2 = generation(pd, &mut q, &mut win, &surface, &pass, &mesh, &mut sb, &mut alloc, &mut pool, &mut t, ring, &mut run);
        destroy_frames(&mut pool, &mut t, ring2);
        0
    } with VkError { fail(c) => { abort c } }
    } with Win32Error { fail(c) => { abort HL_ERROR_NOT_FOUND } };
    if rc != 0 { VkError.fail(rc) }
    0
}

/// Opens a `width` by `height` window titled `title` and draws the program's `Scene` into it
/// until the program stops, or for `frames` frames when that is positive; `validate` runs
/// under the Khronos validation layer and fails when it reported anything. The exit code:
/// 0, or `100 - code` for a negative `VkResult` or library code.
pub fn run(title: &str, width: i32, height: i32, frames: i32, validate: bool) -> i32 can {Scene, Clock} {
    handle {
        with_instance(true, validate, fn() -> i32 can {VkError, Vk, Scene, Clock} {
            if validate && !validation_layer_present() { VkError.fail(HL_ERROR_NO_LAYER) }
            let mut ring = message_ring();
            let mut out: i32 = 0;
            let rc = handle {
                let m = create_messenger(&mut ring, validate);
                defer { destroy_messenger(m); }
                let pd = first_physical_device();
                let family = graphics_queue_family(pd);
                if !win32_presentation_supported(pd, family) { VkError.fail(HL_ERROR_NOT_FOUND) }
                out = with_device(pd, family, NO_QUEUE_FAMILY, true,
                    fn(dev: &Device, f: u32) -> i32 can {VkError, Gpu, Vk, Scene, Clock} { run_on_device(f, title, width, height, frames) });
                0
            } with VkError { fail(c) => { abort c } };
            if rc != 0 { VkError.fail(rc) }
            if message_count(&ring) != 0 { VkError.fail(HL_ERROR_VALIDATION) }
            out
        })
    } with VkError { fail(c) => { abort 100 - c } }
}
