//! The command line's flags.

use std.str.Str;
use std.str.to_owned;
use std.str.eq as str_eq;
use std.test.assert;
use cli.Options;
use cli.default_options;
use cli.parse;
use game.scenario.Scenario;

fn args(list: &[str]) -> Vec[Str] {
    let mut out: Vec[Str] = Vec.new();
    for i in 0..list.len() { out.push(to_owned(list[i])); }
    out
}

fn refused(list: &[str]) -> bool {
    let a = args(list);
    match parse(&a) { Result.Ok(_) => false, Result.Err(_) => true }
}

@test
fn no_arguments_start_the_city_scenario() {
    let none = args(&[]);
    let Result.Ok(options) = parse(&none) else { assert(false); return; };
    let d = default_options();
    assert(options.scenario == d.scenario && options.seed.is_none() && options.screenshot.is_none() && options.size.is_none() && !options.help);
    assert(d.scenario == Scenario.Cities);
}

@test
fn the_screenshot_command_parses() {
    let a = args(&["--screenshot", "out.png", "--scenario", "frontier", "--size", "1280x720"]);
    let Result.Ok(options) = parse(&a) else { assert(false); return; };
    let shot = match options.screenshot { Option.Some(p) => str_eq(&p, "out.png"), Option.None => false };
    assert(shot);
    assert(options.scenario == Scenario.Frontier);
    let sized = match options.size { Option.Some((w, h)) => w == 1280 && h == 720, Option.None => false };
    assert(sized);
    assert(!options.help);
    let c = args(&["--classic"]);
    let Result.Ok(classic) = parse(&c) else { assert(false); return; };
    assert(classic.classic && !options.classic);
    let o = args(&["--open", "city"]);
    let Result.Ok(opened) = parse(&o) else { assert(false); return; };
    let open_city = match opened.open { Option.Some(p) => str_eq(&p, "city"), Option.None => false };
    assert(open_city);
    let w = args(&["--seed", "42", "--scenario", "world"]);
    let Result.Ok(world) = parse(&w) else { assert(false); return; };
    assert(world.scenario == Scenario.World && world.seed == Option.Some(42));
}

@test
fn bad_arguments_are_errors() {
    assert(refused(&["--scenario", "moon"]));
    assert(refused(&["--screenshot"]));
    assert(refused(&["--size", "1280"]));
    assert(refused(&["--size", "0x720"]));
    assert(refused(&["--frobnicate"]));
    assert(refused(&["--open", "basement"]));
    assert(refused(&["--open"]));
    assert(refused(&["--scenario", "world", "--seed", "-1"]));
    // The default scenario has no seed.
    assert(refused(&["--seed", "42"]));
    let help = args(&["--help"]);
    let Result.Ok(options) = parse(&help) else { assert(false); return; };
    assert(options.help);
}

@test
fn the_interaction_flag_parses_and_refuses_a_hidden_window() {
    let a = args(&["--interact"]);
    let Result.Ok(options) = parse(&a) else { assert(false); return; };
    assert(options.interact);
    assert(!default_options().interact);
    // The script needs the visible window its messages are posted to.
    assert(refused(&["--interact", "--screenshot", "out.png"]));
}

@test
fn host_and_join_take_a_port_and_a_code() {
    let a = args(&["--host"]);
    let Result.Ok(options) = parse(&a) else { assert(false); return; };
    assert(options.host && options.port == 7777 && options.players == 2 && options.join.is_none());
    let b = args(&["--host", "--port", "9000", "--players", "3"]);
    let Result.Ok(options) = parse(&b) else { assert(false); return; };
    assert(options.host && options.port == 9000 && options.players == 3);
    let c = args(&["--join", "10.0.0.2", "--code", "ABC123"]);
    let Result.Ok(options) = parse(&c) else { assert(false); return; };
    assert(!options.host && options.join.is_some() && options.code.is_some());
    // A join needs its code, and each flag belongs to its own mode.
    assert(refused(&["--join", "10.0.0.2"]));
    assert(refused(&["--host", "--join", "x", "--code", "y"]));
    assert(refused(&["--port", "9000"]));
    assert(refused(&["--host", "--code", "y"]));
    assert(refused(&["--host", "--port", "lots"]));
    assert(refused(&["--host", "--players", "1"]));
    assert(refused(&["--host", "--players", "8"]));
    assert(refused(&["--players", "3"]));
    assert(refused(&["--host", "--screenshot", "x.png"]));
    // The two-process script needs a game to host or join, and replaces the single-player one.
    assert(refused(&["--interact-mp"]));
    assert(refused(&["--interact-mp", "--interact", "--host"]));
    let d = args(&["--interact-mp", "--host"]);
    let Result.Ok(options) = parse(&d) else { assert(false); return; };
    assert(options.interact_mp && options.host);
}
