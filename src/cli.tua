//! Command-line flags (`hex.exe --help` lists them).

use std.str.Str;
use std.str.eq as str_eq;
use std.str.eq_ignore_ascii_case;
use std.str.parse_u64;
use std.str.split_once;
use std.str.sub;
use std.str.substring;
use std.str.to_owned;
use std.str.push;
use std.str.len;
use game.scenario.Scenario;
use game.scenario.SCENARIOS;
use game.scenario.SCENARIO_COUNT;

pub const USAGE: str = "Usage: hex [OPTIONS] [FRAMES]

Options:
  --scenario <NAME>    start in this scenario: combat, cities (the default),
                       frontier, world (a new random map), siege, or naval
  --seed <N>           generate the world scenario's map from seed N (the
                       debug panel shows a map's seed), so it's the same
                       map every run
  --screenshot <FILE>  render the scenario in a hidden window, write one frame
                       to FILE as a PNG, and exit
  --classic            start in the classic panels (F11 switches)
  --open <PANEL>       open a panel first, for a screenshot of it: city, barracks,
                       unit, group, workers, queue or settings
  --size <WxH>         window size in pixels, e.g. 1280x720 (screenshots
                       default to 1600x900)
  --interact           play a fixed script of clicks and keys through the window's
                       own message queue (nothing takes the focus), and exit 0 if
                       the game answered each; see src/interact.tua
  --host               host a network game on a new world and wait for the
                       other players to join; you play Blue
  --players <N>        with --host: how many people play, you included (2-7,
                       2 unless given)
  --port <N>           the port --host listens on (default 7777)
  --join <ADDRESS>     join a hosted game at HOST or HOST:PORT; you get the
                       next open side
  --code <CODE>        the join code the host shows (needed with --join)
  --interact-mp        with --host or --join: play a few turns of clicks and keys
                       through the window's own message queue, log each turn's
                       state checksum, and exit 0 if the game agreed; see
                       tools/interact-mp.ps1
  --validate           run under the Khronos validation layer; exit 83 if it
                       reports anything
  -h, --help           print this and exit
  FRAMES               draw this many frames and exit (0, the default, runs
                       until the window is closed)";

/// What the command line asked for.
pub struct Options {
    scenario: Scenario,
    /// The world scenario's map seed, if given.
    seed: Option[u32],
    /// Screenshot mode: where to write the PNG.
    screenshot: Option[Str],
    /// Window size in physical pixels, if given.
    size: Option[(u32, u32)],
    help: bool,
    /// Frames to draw before exiting, 0 for no limit.
    frames: i32,
    validate: bool,
    /// Run the interaction script (`interact.tua`) in the real window.
    interact: bool,
    /// Start in the classic panels rather than the library UI.
    classic: bool,
    /// A panel to open before the first frame (`GameState.open_panel`).
    open: Option[Str],
    /// `--host`: host a network game for `players` people on `port`.
    host: bool,
    players: i32,
    port: i32,
    /// `--join`: the host's address, and its join code.
    join: Option[Str],
    code: Option[Str],
    /// Play the multiplayer interaction script (`interact.tua`).
    interact_mp: bool,
}

/// The port a host listens on unless told another.
pub const DEFAULT_PORT: i32 = 7777;

pub fn default_options() -> Options {
    Options { scenario: Scenario.Cities, seed: Option.None, screenshot: Option.None, size: Option.None, help: false, frames: 0, validate: false, interact: false, classic: false, open: Option.None, host: false, players: 2, port: DEFAULT_PORT, join: Option.None, code: Option.None, interact_mp: false }
}

/// A refusal's text: `message`, then the usage.
fn with_usage(message: Str) -> Str {
    let mut out = message;
    push(&mut out, "\n\n");
    push(&mut out, USAGE);
    out
}

fn text2(a: &str, b: &str) -> Str {
    let mut out = to_owned(a);
    push(&mut out, b);
    out
}

fn text3(a: &str, b: &str, c: &str) -> Str {
    let mut out = to_owned(a);
    push(&mut out, b);
    push(&mut out, c);
    out
}

/// The scenario called `name` (its `name()` in any case, e.g. `cities`), as `--scenario`
/// spells it.
pub fn scenario_named(name: &str) -> Option[Scenario] {
    for i in 0..SCENARIO_COUNT {
        if eq_ignore_ascii_case(SCENARIOS[i].name(), name) { return Option.Some(SCENARIOS[i]); }
    }
    Option.None
}

/// Whether `--open` knows the panel `name`.
fn is_panel(name: &str) -> bool {
    str_eq(name, "city") || str_eq(name, "barracks") || str_eq(name, "unit") || str_eq(name, "group") || str_eq(name, "workers") || str_eq(name, "queue") || str_eq(name, "settings")
}

/// A whole number of at most `max`, all digits.
fn number(text: &str, max: i64) -> Option[i64] {
    if len(text) == 0 || len(text) > 10 { return Option.None; }
    match parse_u64(text) {
        Option.Some(n) => if n >= 0 && n <= max { Option.Some(n) } else { Option.None },
        Option.None => Option.None,
    }
}

/// `1280x720` as (1280, 720).
fn parse_size(text: &str) -> Option[(u32, u32)] {
    let split = match split_once(text, "x") {
        Option.Some(sp) => Option.Some(sp),
        Option.None => split_once(text, "X"),
    };
    // The separator's span: the width before it, the height after it.
    let Option.Some(sp) = split else { return Option.None; };
    let Option.Some(before) = substring(text, 0, sp.lo) else { return Option.None; };
    let Option.Some(after) = substring(text, sp.hi, len(text)) else { return Option.None; };
    let w_text = sub(text, before);
    let h_text = sub(text, after);
    match (number(w_text, 4294967295), number(h_text, 4294967295)) {
        (Option.Some(w), Option.Some(h)) => if w > 0 && h > 0 { Option.Some((w as u32, h as u32)) } else { Option.None },
        _ => Option.None,
    }
}

/// Parses the arguments after the program name.
pub fn parse(args: &Vec[Str]) -> Result[Options, Str] {
    let mut options = default_options();
    let mut players_given = false;
    let mut port_given = false;
    let mut i = 0;
    while i < args.len() {
        let arg = &args[i];
        let needs_value = str_eq(arg, "--scenario") || str_eq(arg, "--seed") || str_eq(arg, "--screenshot") || str_eq(arg, "--size") || str_eq(arg, "--open") || str_eq(arg, "--players") || str_eq(arg, "--port") || str_eq(arg, "--join") || str_eq(arg, "--code");
        if needs_value && i + 1 >= args.len() {
            return Result.Err(with_usage(text2(arg, " needs a value")));
        }
        if str_eq(arg, "--scenario") {
            let name = &args[i + 1];
            match scenario_named(name) {
                Option.Some(s) => { options.scenario = s; }
                Option.None => {
                    return Result.Err(text3("no scenario called \"", name, "\": try combat, cities, frontier, world, siege or naval"));
                }
            }
            i = i + 2;
        } else if str_eq(arg, "--seed") {
            let seed = &args[i + 1];
            match number(seed, 4294967295) {
                Option.Some(n) => { options.seed = Option.Some(n as u32); }
                Option.None => { return Result.Err(text3("--seed wants a whole number up to 4294967295, not \"", seed, "\"")); }
            }
            i = i + 2;
        } else if str_eq(arg, "--screenshot") {
            let path = &args[i + 1];
            options.screenshot = Option.Some(to_owned(path));
            i = i + 2;
        } else if str_eq(arg, "--size") {
            let size = &args[i + 1];
            match parse_size(size) {
                Option.Some(s) => { options.size = Option.Some(s); }
                Option.None => { return Result.Err(text3("--size wants WIDTHxHEIGHT, like 1280x720, not \"", size, "\"")); }
            }
            i = i + 2;
        } else if str_eq(arg, "--open") {
            let panel = &args[i + 1];
            if !is_panel(panel) { return Result.Err(text3("no panel called \"", panel, "\": try city, barracks, unit, group, workers, queue or settings")); }
            options.open = Option.Some(to_owned(panel));
            i = i + 2;
        } else if str_eq(arg, "-h") || str_eq(arg, "--help") {
            options.help = true;
            i = i + 1;
        } else if str_eq(arg, "--classic") {
            options.classic = true;
            i = i + 1;
        } else if str_eq(arg, "--interact") {
            options.interact = true;
            i = i + 1;
        } else if str_eq(arg, "--host") {
            options.host = true;
            i = i + 1;
        } else if str_eq(arg, "--interact-mp") {
            options.interact_mp = true;
            i = i + 1;
        } else if str_eq(arg, "--players") {
            let text = &args[i + 1];
            match number(text, 7) {
                Option.Some(n) => { if n < 2 { return Result.Err(text3("--players wants 2 to 7, not \"", text, "\"")); } options.players = n as i32; players_given = true; }
                Option.None => { return Result.Err(text3("--players wants 2 to 7, not \"", text, "\"")); }
            }
            i = i + 2;
        } else if str_eq(arg, "--port") {
            let text = &args[i + 1];
            match number(text, 65535) {
                Option.Some(n) => { options.port = n as i32; port_given = true; }
                Option.None => { return Result.Err(text3("--port wants a port number, not \"", text, "\"")); }
            }
            i = i + 2;
        } else if str_eq(arg, "--join") {
            let target = &args[i + 1];
            options.join = Option.Some(to_owned(target));
            i = i + 2;
        } else if str_eq(arg, "--code") {
            let entered = &args[i + 1];
            options.code = Option.Some(to_owned(entered));
            i = i + 2;
        } else if str_eq(arg, "--validate") {
            options.validate = true;
            i = i + 1;
        } else {
            match number(arg, 999999) {
                Option.Some(n) => { options.frames = n as i32; }
                Option.None => { return Result.Err(with_usage(text3("unknown argument \"", arg, "\""))); }
            }
            i = i + 1;
        }
    }
    if options.seed.is_some() && options.scenario != Scenario.World {
        return Result.Err(to_owned("--seed only applies to --scenario world"));
    }
    if options.host && options.join.is_some() { return Result.Err(to_owned("--host and --join can't go together")); }
    if options.host && options.code.is_some() { return Result.Err(to_owned("--code only applies to --join")); }
    if !options.host && options.join.is_none() {
        if options.code.is_some() { return Result.Err(to_owned("--code only applies to --join")); }
        if port_given { return Result.Err(to_owned("--port only applies to --host")); }
        if options.interact_mp { return Result.Err(to_owned("--interact-mp needs --host or --join")); }
    }
    if options.join.is_some() && options.code.is_none() { return Result.Err(to_owned("--join needs --code: the join code the host shows")); }
    if players_given && !options.host { return Result.Err(to_owned("--players only applies to --host")); }
    if (options.host || options.join.is_some()) && options.screenshot.is_some() { return Result.Err(to_owned("--host and --join need the visible window, not --screenshot")); }
    if options.interact_mp && options.interact { return Result.Err(to_owned("--interact-mp replaces --interact")); }
    if options.interact && options.screenshot.is_some() {
        return Result.Err(to_owned("--interact needs the visible window, not --screenshot"));
    }
    Result.Ok(options)
}
