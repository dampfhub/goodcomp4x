//! The library UI as pressed: each test builds a game and a context over the game's real fonts,
//! runs frames of scripted input (the mouse the way the window adapter reports it) and checks
//! what the game did and where the panels went. The buttons are found where `UiState.seen`
//! says they were laid out, so a change of layout moves what a test presses with it.

use std.linalg.Rect;
use std.linalg.Vec2;
use std.linalg.vec2;
use std.rand.Rand;
use std.str.Str;
use std.str.eq as str_eq;
use std.str.find;
use std.str.push;
use std.str.to_owned;
use std.test.assert;
use std.test.assert_eq;
use std.test.Assert;
use log.Log;
use font.ttf.FontError;
use ui.atlas.FontAtlas;
use ui.boxfont.box_atlas;
use ui.context.Context;
use ui.context.NO_MOVE;
use ui.context.NO_SCROLLBAR;
use ui.context.NO_SCROLL_WITH_MOUSE;
use ui.context.NO_TITLE_BAR;
use ui.input.MouseButton;
use ui.input.Mods;
use ui_win32.next_frame;
use game.GameState;
use game.dock.overlaps;
use game.city.Build;
use game.city.Building;
use game.city.LaborFocus;
use game.hex.Hex;
use game.settings.SETTINGS;
use game.settings.Setting;
use game.ui.PanelBuilder;
use game.ui.RosterKey;
use game.ui.RowKind;
use game.ui.TILE_TOOLTIP_DELAY;
use game.ui.panel_builder;
use game.unit.UnitType;
use game.city.BuildUnit;
use game.font.ui_atlas;
use game.imgui.UiState;
use game.imgui.build_panels;
use game.imgui.run_ui;
use game.imgui.status_flags;
use game.imgui.ui_context;
use game.imgui.ui_state;
use game.imgui_layout.DEBUG;
use game.imgui_layout.PinnedKind;
use game.imgui_layout.PinnedPanel;
use game.imgui_layout.layout_from_text;
use game.imgui_layout.layout_state;
use game.imgui_layout.box_space_name;
use game.tests.sandbox;
use game.ui.QueueKind;
use game.ui.Target;
use game.ui.UnitAction;
use game.unit.Team;

const SCREEN_W: f32 = 1600.0;
const SCREEN_H: f32 = 900.0;

fn screen() -> Vec2 { vec2(SCREEN_W, SCREEN_H) }

/// A game, the library's context over the game's fonts and the UI's state, kept together so a
/// helper is handed one thing.
struct Rig { game: GameState, ctx: Context, st: UiState }

/// The library's context over the game's fonts, with `saved` windows restored; whether the fonts
/// rasterized (else a box font stands in).
fn context(saved: Option[Str]) -> (Context, bool) {
    let mut built: Option[FontAtlas] = Option.None;
    let rc = handle { built = Option.Some(ui_atlas()); 0 } with FontError { fail(c) => { abort c } };
    let real = rc == 0 && built.is_some();
    let atlas = match built { Option.Some(a) => a, Option.None => box_atlas(&[15.0], 128) };
    (ui_context(atlas, saved), real)
}

/// A rig over `game` in the library UI, its panels laid out for three frames so hover has
/// windows to judge against.
fn rig(game: GameState) -> Rig can {Log, Rand} {
    let mut game = game;
    game.imgui_ui = true;
    let (ctx, _real) = context(Option.None);
    let mut r = Rig { game, ctx, st: ui_state(layout_state(), screen()) };
    frames(&mut r, 3);
    r
}

/// One frame at the current input; the wheel and keys spent afterwards, as the game's frame
/// does.
fn frame(r: &mut Rig) can {Log, Rand} {
    let cursor = r.st.input.mouse;
    run_ui(&mut r.game, &mut r.ctx, &mut r.st, screen(), 1.0, 0.016, cursor);
    r.st.input = next_frame(r.st.input);
}

fn frames(r: &mut Rig, n: i32) can {Log, Rand} {
    for _ in 0..n { frame(r); }
}

fn move_to(r: &mut Rig, p: Vec2) { r.st.input.mouse = Option.Some(p); }

fn set_left(r: &mut Rig, down: bool) { r.st.input.down[MouseButton.Left.slot()] = down; }

/// A full left click at `p`: hover, press, release.
fn click_at(r: &mut Rig, p: Vec2) can {Log, Rand} {
    move_to(r, p);
    frames(r, 2);
    set_left(r, true);
    frame(r);
    set_left(r, false);
    frame(r);
}

/// Drags from `a` to `b` in three steps with the left button.
fn drag(r: &mut Rig, a: Vec2, b: Vec2) can {Log, Rand} {
    move_to(r, a);
    frames(r, 2);
    set_left(r, true);
    frame(r);
    move_to(r, vec2((a.x + b.x) / 2.0, (a.y + b.y) / 2.0));
    frame(r);
    move_to(r, b);
    frame(r);
    set_left(r, false);
    frames(r, 3);
}

fn center(rc: Rect) -> Vec2 { vec2((rc.min.x + rc.max.x) / 2.0, (rc.min.y + rc.max.y) / 2.0) }

/// Where the widget pressing `target` was laid out in the last frame.
fn seen_rect(r: &Rig, target: Target) -> Option[Rect] {
    for k in 0..r.st.seen.len() {
        if r.st.seen[k].target == target { return Option.Some(r.st.seen[k].rect); }
    }
    Option.None
}

fn click_target(r: &mut Rig, target: Target) can {Log, Rand, Assert} {
    let Option.Some(rc) = seen_rect(&*r, target) else { assert(false); return; };
    click_at(r, center(rc));
}

@test
fn the_ui_fonts_rasterize() {
    let (_ctx, real) = context(Option.None);
    assert(real);
}

@test
fn the_status_bar_never_scrolls() {
    let flags = status_flags();
    assert(flags.has(NO_SCROLLBAR.plus(NO_SCROLL_WITH_MOUSE)));
    assert(flags.has(NO_TITLE_BAR.plus(NO_MOVE)));
}

@test
fn a_click_on_a_panel_button_does_what_the_classic_button_does() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.city_scenario();
        game.select_city();
        let Option.Some(city) = game.selected_city else { assert(false); return; };
        let mut r = rig(game);
        assert(r.game.cities[city].queue.is_empty());
        click_target(&mut r, Target.Build(BuildUnit.Melee));
        assert(r.game.cities[city].queue.contains(Build.Unit(BuildUnit.Melee)));
    });
}

@test
fn a_disabled_button_takes_the_click_and_does_nothing() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut r = rig(GameState.city_scenario());
        // Nothing saved yet, so Load is off.
        assert(r.game.savestate.is_none());
        click_target(&mut r, Target.LoadState);
        assert(r.game.savestate.is_none());
        assert(r.st.wants_mouse);
        // Save is on: the same click on it saves.
        click_target(&mut r, Target.SaveState);
        assert(r.game.savestate.is_some());
    });
}

@test
fn the_ui_takes_the_mouse_over_a_panel_and_leaves_the_map_alone() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut r = rig(GameState.city_scenario());
        // Over the status bar.
        move_to(&mut r, vec2(300.0, 20.0));
        frames(&mut r, 2);
        assert(r.st.wants_mouse);
        // Over the middle of the map, where nothing is: the game keeps the mouse.
        move_to(&mut r, vec2(800.0, 450.0));
        frames(&mut r, 2);
        assert(!r.st.wants_mouse);
        // And with no cursor at all.
        r.st.input.mouse = Option.None;
        frames(&mut r, 2);
        assert(!r.st.wants_mouse);
    });
}

@test
fn end_turn_in_the_status_bar_selects_what_the_turn_waits_on() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut r = rig(GameState.city_scenario());
        assert(r.game.selected_city.is_none());
        click_target(&mut r, Target.EndTurn);
        assert(r.game.selected_city.is_some());
    });
}

@test
fn the_settings_menu_changes_settings_with_its_controls() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.city_scenario();
        game.settings_open = true;
        let mut r = rig(game);
        // Pressing the first control that would change its setting changes it.
        let mut pressed = 0;
        for k in 0..r.st.seen.len() {
            if pressed > 0 { break; }
            match r.st.seen[k].target {
                Target.SetSetting(setting, to) => {
                    if r.game.settings.get(setting) == to { continue; }
                    let at = center(r.st.seen[k].rect);
                    click_at(&mut r, at);
                    assert(r.game.settings.get(setting) == to);
                    pressed = pressed + 1;
                }
                _ => {}
            }
        }
        assert(pressed == 1);
        // Close is a button of the menu too.
        click_target(&mut r, Target.CloseSettings);
        assert(!r.game.settings_open);
    });
}

@test
fn the_turn_strip_chip_of_a_group_selects_its_units() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut r = rig(GameState.new());
        r.game.selected = Option.None;
        r.game.group.clear();
        frames(&mut r, 2);
        let mut chip: Option[Target] = Option.None;
        for k in 0..r.st.seen.len() {
            match r.st.seen[k].target { Target.RosterSelect(_) => { chip = Option.Some(r.st.seen[k].target); } _ => {} }
        }
        let Option.Some(target) = chip else { assert(false); return; };
        click_target(&mut r, target);
        assert(!r.game.selection().is_empty());
    });
}

@test
fn a_panel_is_moved_only_while_ctrl_is_held_and_the_layout_remembers_it() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut r = rig(GameState.city_scenario());
        let Option.Some(start) = r.ctx.window_rect("Debug") else { assert(false); return; };
        assert(!r.st.layout.windows[DEBUG].manual);
        // Without Ctrl, a drag inside the panel moves nothing.
        let grab = vec2(start.min.x + 40.0, start.min.y + 12.0);
        drag(&mut r, grab, vec2(grab.x - 300.0, grab.y + 40.0));
        let Option.Some(same) = r.ctx.window_rect("Debug") else { assert(false); return; };
        assert(same.min.x == start.min.x && same.min.y == start.min.y);
        // With Ctrl held the title bar shows and the panel follows the mouse.
        r.st.input.mods = Mods { ctrl: true, shift: false, alt: false };
        frames(&mut r, 2);
        let Option.Some(titled) = r.ctx.window_rect("Debug") else { assert(false); return; };
        let title = vec2(titled.min.x + 40.0, titled.min.y + 10.0);
        drag(&mut r, title, vec2(title.x - 300.0, title.y + 40.0));
        let Option.Some(moved) = r.ctx.window_rect("Debug") else { assert(false); return; };
        assert(moved.min.x < start.min.x - 200.0);
        assert(r.st.layout.windows[DEBUG].manual);
        // The layout saved as text, and the windows the context saved, bring it back in a new
        // session.
        let layout_text = r.st.layout.to_text();
        let windows = r.ctx.save_settings();
        let mut game2 = GameState.city_scenario();
        game2.imgui_ui = true;
        let (ctx2, _real2) = context(Option.Some(windows));
        let mut again = Rig { game: game2, ctx: ctx2, st: ui_state(layout_from_text(&layout_text), screen()) };
        frames(&mut again, 3);
        let Option.Some(back) = again.ctx.window_rect("Debug") else { assert(false); return; };
        assert_eq(back.min.x as i32, moved.min.x as i32);
        assert_eq(back.min.y as i32, moved.min.y as i32);
        assert(again.st.layout.windows[DEBUG].manual);
    });
}

@test
fn captured_unit_action_targets_its_stable_unit_id() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let mut mine: i32 = 0 - 1;
        for i in 0..game.units.len() { if mine < 0 && game.units[i].team == Team.Blue { mine = i; } }
        assert(mine >= 0);
        let pin = PinnedPanel { kind: PinnedKind.Unit, city_id: game.units[mine].id };
        game.selected = Option.None;
        game.activate_pinned(pin, Target.Unit(UnitAction.Hold));
        assert(game.units[mine].holding);
    });
}

@test
fn pinned_city_action_uses_its_own_city_after_selection_closes() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.city_scenario();
        game.select_city();
        let Option.Some(pin) = game.selected_pin() else { assert(false); return; };
        game.leave_city_view();
        assert(game.selected_city.is_none());
        game.activate_pinned(pin, Target.Build(BuildUnit.Melee));
        let Option.Some(city) = game.pinned_city_index(pin) else { assert(false); return; };
        assert(game.selected_city == Option.Some(city));
        assert(!game.cities[city].queue.is_empty());
    });
}

// ---- the turn strip -------------------------------------------------------------------------

/// What the turn strip shows now: each chip's key, whether it is framed and its count.
struct Chip { key: RosterKey, selected: bool, count: i32 }

fn strip(game: &GameState) -> Vec[Chip] {
    let mut out: Vec[Chip] = Vec.new();
    if let Option.Some(panel) = game.roster_panel() {
        for k in 0..panel.chips.len() {
            let c = panel.chips[k];
            out.push(Chip { key: c.key, selected: c.selected, count: c.count });
        }
    }
    out
}

fn keys_of(game: &GameState) -> Vec[RosterKey] {
    let mut out: Vec[RosterKey] = Vec.new();
    let chips = strip(game);
    for k in 0..chips.len() { out.push(chips[k].key); }
    out
}

fn blue_units(game: &GameState) -> Vec[i32] {
    let mut out: Vec[i32] = Vec.new();
    for i in 0..game.units.len() { if game.is_player_controlled(i) { out.push(i); } }
    out
}

/// A click on the chip standing for `key`, with the modifiers held.
fn click_chip(r: &mut Rig, key: RosterKey, shift: bool, ctrl: bool) can {Log, Rand, Assert} {
    r.st.input.mods = Mods { ctrl, shift, alt: false };
    frames(r, 2);
    click_target(r, Target.RosterSelect(key));
    r.st.input.mods = Mods { ctrl: false, shift: false, alt: false };
    frames(r, 2);
}

@test
fn the_turn_strip_lists_civilian_tasks_first_then_unit_groups() {
    sandbox(fn() can {Log, Rand, Assert} {
        // The Cities scenario: Blue's city has nothing queued and a worker idle at home, and
        // one unit of each military kind.
        let mut game = GameState.city_scenario();
        let mut city_id: u32 = 0;
        let mut city_at: i32 = 0 - 1;
        for i in 0..game.cities.len() { if city_at < 0 && game.cities[i].team == Team.Blue { city_at = i; city_id = game.cities[i].id; } }
        assert(city_at >= 0);
        let keys = keys_of(&game);
        assert(keys[0] == RosterKey.Production(city_id));
        assert(keys[1] == RosterKey.Workers(city_id));
        let blue = blue_units(&game);
        assert(keys.len() == 2 + blue.len());
        for k in 0..blue.len() {
            assert(keys[2 + k] == RosterKey.Group(game.units[blue[k]].unit_type, false));
        }
        // A settler comes ahead of the military, wherever it is in unit order.
        let last = blue[blue.len() - 1];
        let settler = game.units[last].id;
        let unit_type = game.units[last].unit_type;
        game.settlers.insert(settler);
        assert(keys_of(&game)[2] == RosterKey.Group(unit_type, true));
        // The production chip opens the city, and is framed while it is open.
        let mut r = rig(game);
        click_chip(&mut r, RosterKey.Production(city_id), false, false);
        let Option.Some(open) = r.game.selected_city else { assert(false); return; };
        assert(r.game.cities[open].id == city_id);
        let chips = strip(&r.game);
        assert(chips[0].selected && !chips[1].selected && !chips[2].selected);
        // Once it has a build, it leaves the strip.
        r.game.cities[open].queue.push(Build.Unit(BuildUnit.Melee));
        let after = keys_of(&r.game);
        for k in 0..after.len() {
            let production = match after[k] { RosterKey.Production(_) => true, _ => false };
            assert(!production);
        }
    });
}

@test
fn a_group_chip_counts_its_units_and_opens_a_row_of_them() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let blue = blue_units(&game);
        // Three melee and one siege.
        for k in 0..3 { game.units[blue[k]].unit_type = UnitType.Melee; }
        game.units[blue[3]].unit_type = UnitType.Siege;
        game.set_selection(Vec.new());
        let melee = RosterKey.Group(UnitType.Melee, false);
        let siege = RosterKey.Group(UnitType.Siege, false);
        let chips = strip(&game);
        assert(chips.len() == 2);
        assert(chips[0].key == melee && !chips[0].selected && chips[0].count == 3);
        assert(chips[1].key == siege && !chips[1].selected && chips[1].count == 1);
        let mut r = rig(game);
        // Clicking a group selects all of it and lists its units one by one.
        click_chip(&mut r, melee, false, false);
        let picked = r.game.selection();
        assert(picked.len() == 3 && picked[0] == blue[0] && picked[1] == blue[1] && picked[2] == blue[2]);
        let row = strip(&r.game);
        assert(row.len() == 5);
        for k in 0..3 {
            assert(row[2 + k].key == RosterKey.Unit(r.game.units[blue[k]].id));
            assert(row[2 + k].selected);
        }
        let first = RosterKey.Unit(r.game.units[blue[0]].id);
        let third = RosterKey.Unit(r.game.units[blue[2]].id);
        // From the row: Ctrl-click takes one out, a plain click picks one.
        click_chip(&mut r, first, false, true);
        let two = r.game.selection();
        assert(two.len() == 2 && two[0] == blue[1] && two[1] == blue[2]);
        assert(!strip(&r.game)[2].selected);
        click_chip(&mut r, third, false, false);
        let one = r.game.selection();
        assert(one.len() == 1 && one[0] == blue[2]);
        // The row stays while one of its units is selected.
        assert(strip(&r.game).len() == 5);
        // Ctrl-clicking the only selected unit leaves it selected.
        click_chip(&mut r, third, false, true);
        assert(r.game.selection().len() == 1);
        // Shift-clicking another group adds all of it; Ctrl-clicking takes it out.
        click_chip(&mut r, siege, true, false);
        let added = r.game.selection();
        assert(added.len() == 2 && added[0] == blue[2] && added[1] == blue[3]);
        click_chip(&mut r, siege, false, true);
        let removed = r.game.selection();
        assert(removed.len() == 1 && removed[0] == blue[2]);
        // Selecting something else closes the row.
        click_chip(&mut r, siege, false, false);
        let only = r.game.selection();
        assert(only.len() == 1 && only[0] == blue[3]);
        let keys = keys_of(&r.game);
        assert(keys.len() == 2 && keys[0] == melee && keys[1] == siege);
        // Nothing got orders.
        for i in 0..r.game.units.len() { assert(!r.game.units[i].has_queue()); }
    });
}

@test
fn a_unit_with_orders_leaves_its_group() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let blue = blue_units(&game);
        for k in 0..blue.len() { game.units[blue[k]].unit_type = UnitType.Melee; }
        let melee = RosterKey.Group(UnitType.Melee, false);
        assert(strip(&game)[0].count == blue.len());
        let mut one: Vec[i32] = Vec.new();
        one.push(blue[0]);
        game.set_selection(one);
        game.hold_selected_unit();
        let chips = strip(&game);
        assert(chips[0].key == melee);
        assert(chips[0].count == blue.len() - 1);
    });
}

// ---- queues, hover and the settings menu -------------------------------------------------------

fn row(r: &Rig, kind: QueueKind, index: i32) -> Option[Rect] { seen_rect(r, Target.QueueItem(kind, index)) }

@test
fn queue_rows_drag_to_reorder_and_x_removes_without_dragging() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.city_scenario();
        game.select_city();
        let Option.Some(city) = game.selected_city else { assert(false); return; };
        game.cities[city].queue.push(Build.Unit(BuildUnit.Melee));
        game.cities[city].queue.push(Build.Unit(BuildUnit.Ranged));
        game.cities[city].queue.push(Build.Unit(BuildUnit.Siege));
        let mut r = rig(game);
        let Option.Some(from) = row(&r, QueueKind.City, 2) else { assert(false); return; };
        let Option.Some(to) = row(&r, QueueKind.City, 0) else { assert(false); return; };
        drag(&mut r, center(from), center(to));
        // Siege leaps to the front, and the others keep their order behind it.
        assert(r.game.cities[city].queue[0] == Build.Unit(BuildUnit.Siege));
        assert(r.game.cities[city].queue[1] == Build.Unit(BuildUnit.Melee));
        assert(r.game.cities[city].queue[2] == Build.Unit(BuildUnit.Ranged));
        // The X on a row removes it: pressing it drags nothing.
        click_target(&mut r, Target.QueueRemove(1));
        assert(r.game.cities[city].queue.len() == 2);
        assert(r.game.cities[city].queue[1] == Build.Unit(BuildUnit.Ranged));
    });
}

@test
fn ready_city_building_cannot_be_dragged_out_of_first_place() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.city_scenario();
        game.select_city();
        let Option.Some(city) = game.selected_city else { assert(false); return; };
        game.cities[city].queue.push(Build.Building(Building.Workshop));
        game.cities[city].queue.push(Build.Unit(BuildUnit.Melee));
        game.cities[city].pending_building = Option.Some(Building.Workshop);
        let mut r = rig(game);
        let Option.Some(first) = row(&r, QueueKind.City, 0) else { assert(false); return; };
        let Option.Some(second) = row(&r, QueueKind.City, 1) else { assert(false); return; };
        // The second row goes onto the first, which is the ready building: nothing moves.
        drag(&mut r, center(second), center(first));
        assert(r.game.cities[city].queue[0] == Build.Building(Building.Workshop));
        // And the ready building itself cannot be picked up.
        drag(&mut r, center(first), center(second));
        assert(r.game.cities[city].queue[0] == Build.Building(Building.Workshop));
    });
}

@test
fn barracks_queue_rows_use_the_same_drag_and_remove_targets() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.city_scenario();
        game.select_city();
        let Option.Some(city) = game.selected_city else { assert(false); return; };
        game.cities[city].barracks = Option.Some(Hex.new(-2, 0));
        game.open_barracks(city);
        game.cities[city].barracks_queue.push(BuildUnit.Melee);
        game.cities[city].barracks_queue.push(BuildUnit.Ranged);
        let mut r = rig(game);
        let Option.Some(second) = row(&r, QueueKind.Barracks, 1) else { assert(false); return; };
        let Option.Some(first) = row(&r, QueueKind.Barracks, 0) else { assert(false); return; };
        drag(&mut r, center(second), center(first));
        assert(r.game.cities[city].barracks_queue[0] == BuildUnit.Ranged);
        click_target(&mut r, Target.BarracksQueueRemove(1));
        assert(r.game.cities[city].barracks_queue.len() == 1);
        assert(r.game.cities[city].barracks_queue[0] == BuildUnit.Ranged);
    });
}

@test
fn resting_on_a_tile_shows_its_tooltip_after_a_delay() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut r = rig(GameState.new());
        let cursor = hex_cursor(&r.game, Hex.new(0, 1));
        move_to(&mut r, cursor);
        r.game.update_hover(Option.Some(cursor), screen(), 0.0);
        frames(&mut r, 2);
        let before = r.st.out.vtx.len();
        r.game.update_hover(Option.Some(cursor), screen(), TILE_TOOLTIP_DELAY);
        assert(r.game.hovered_tile == Option.Some(Hex.new(0, 1)));
        frames(&mut r, 2);
        assert(r.st.out.vtx.len() > before);
        // Moving to another hex starts the wait over.
        let elsewhere = hex_cursor(&r.game, Hex.new(1, 1));
        r.game.update_hover(Option.Some(elsewhere), screen(), 0.1);
        assert(r.game.hover_seconds == 0.0);
    });
}

fn hex_cursor(game: &GameState, hex: Hex) -> Vec2 {
    let camera = &game.camera;
    let offset = hex.to_world().sub(camera.center).scale(1.0 / camera.half_height);
    let ndc = vec2(offset.x * SCREEN_H / SCREEN_W, 0.0 - offset.y);
    vec2((ndc.x + 1.0) / 2.0 * SCREEN_W, (ndc.y + 1.0) / 2.0 * SCREEN_H)
}

/// Whether the Inspect panel has been shown in `r`.
fn inspecting(r: &mut Rig) -> bool {
    let panels = build_panels(&r.game, &mut r.st.layout, r.st.input.mouse, screen(), false);
    !panels.hover.rows.is_empty()
}

@test
fn hovering_an_enemy_out_of_sight_shows_nothing() {
    sandbox(fn() can {Log, Rand, Assert} {
        let game = GameState.new();
        let mut enemy_at = Hex.new(0, 0);
        let mut found = false;
        for i in 0..game.units.len() { if !found && game.units[i].team == Team.Red { enemy_at = game.units[i].pos; found = true; } }
        assert(found);
        // The combat map starts with Red unseen.
        assert(!game.fog().sees(enemy_at));
        let mut r = rig(game);
        let cursor = hex_cursor(&r.game, enemy_at);
        move_to(&mut r, cursor);
        r.game.update_hover(Option.Some(cursor), screen(), 0.0);
        frames(&mut r, 3);
        assert(!inspecting(&mut r));
        // In sight, the same hover describes it.
        r.game.fog_of_war = false;
        frames(&mut r, 3);
        assert(inspecting(&mut r));
    });
}

@test
fn the_settings_menu_shows_every_setting_under_its_heading() {
  sandbox(fn() can {Log, Rand, Assert} {
    let game = GameState.new();
    let panel = game.settings_panel_content();
    // Each heading once, then its settings at their current values, in `SETTINGS`'s order.
    let mut listed: Vec[Setting] = Vec.new();
    for r in 0..panel.rows.len() {
        let row = panel.rows[r];
        match row.kind {
            RowKind.Setting => {
                let s = &panel.settings[row.from];
                assert(s.value == game.settings.get(s.setting));
                listed.push(s.setting);
            }
            _ => {}
        }
    }
    assert(listed.len() == 5);
    for k in 0..5 { assert(listed[k] == SETTINGS[k]); }
    // A setting button's tooltip names what it sets, and says when it already is.
    let mut p = panel_builder(false);
    assert(game.tooltip(Target.SetSetting(Setting.TurnPlayback, 1), &mut p));
    assert(rows_show(&p, "INSTANT PLAYBACK"));
    assert(rows_show(&p, "ALREADY ON"));
    let mut other = panel_builder(false);
    assert(game.tooltip(Target.SetSetting(Setting.TurnPlayback, 0), &mut other));
    assert(rows_show(&other, "OFF"));
    assert(!rows_show(&other, "ALREADY"));
    let mut past = panel_builder(false);
    assert(game.tooltip(Target.SetSetting(Setting.MaxQueuedTurns, 0), &mut past));
    assert(rows_show(&past, "ALREADY 6 TURNS"));
  });
}

/// Whether any line of `panel` contains `needle`.
fn rows_show(panel: &PanelBuilder, needle: &str) -> bool {
    for r in 0..panel.rows.len() {
        let row = panel.rows[r];
        match row.kind {
            RowKind.Text => {
                let mut line = to_owned("");
                for i in row.from..row.to { let t = &panel.spans[i].text; push(&mut line, t); }
                if find(&line, needle).is_some() { return true; }
            }
            _ => {}
        }
    }
    false
}

@test
fn hovering_an_enemy_city_or_barracks_out_of_sight_shows_no_live_panel() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.city_scenario();
        game.units.clear();
        game.selected = Option.None;
        let mut red: i32 = 0 - 1;
        let mut blue: i32 = 0 - 1;
        for i in 0..game.cities.len() {
            if red < 0 && game.cities[i].team == Team.Red { red = i; }
            if blue < 0 && game.cities[i].team == Team.Blue { blue = i; }
        }
        assert(red >= 0 && blue >= 0);
        let barracks = game.cities[red].pos.neighbors()[0];
        game.cities[red].barracks = Option.Some(barracks);
        let red_pos = game.cities[red].pos;
        let mut r = rig(game);
        for k in 0..2 {
            let hex = if k == 0 { red_pos } else { barracks };
            // Only Blue's city sees, and not this far.
            assert(!r.game.fog().sees(hex));
            r.game.hovered_tile = Option.Some(hex);
            frames(&mut r, 3);
            assert(!inspecting(&mut r));
            // In sight, it has its panel.
            r.game.fog_of_war = false;
            frames(&mut r, 3);
            assert(inspecting(&mut r));
            r.game.fog_of_war = true;
        }
        // The player's own city always has its panel.
        let own = r.game.cities[blue].pos;
        r.game.hovered_tile = Option.Some(own);
        frames(&mut r, 3);
        assert(inspecting(&mut r));
    });
}

@test
fn a_panel_dragged_onto_the_maps_drop_target_docks_and_stays_docked() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut r = rig(GameState.city_scenario());
        r.st.input.mods = Mods { ctrl: true, shift: false, alt: false };
        frames(&mut r, 2);
        let Option.Some(start) = r.ctx.window_rect("Debug") else { assert(false); return; };
        assert(!r.ctx.is_docked("Debug"));
        // The dock space is everything under the status bar; its central node offers a target on
        // each side of its centre, the left one a square and a gap away.
        let space_center = vec2(SCREEN_W / 2.0, (52.0 + SCREEN_H) / 2.0);
        let left_target = vec2(space_center.x - 26.0, space_center.y);
        let title = vec2(start.min.x + 40.0, start.min.y + 10.0);
        drag(&mut r, title, left_target);
        frames(&mut r, 3);
        assert(r.ctx.is_docked("Debug"));
        assert(r.st.layout.windows[DEBUG].docked);
        // Docked, it fills its node: a quarter of the space, from the left edge.
        let Option.Some(docked) = r.ctx.window_rect("Debug") else { assert(false); return; };
        assert(docked.min.x < 20.0);
        assert(docked.max.x - docked.min.x > SCREEN_W * 0.2 && docked.max.x - docked.min.x < SCREEN_W * 0.3);
        // A new session brings it back docked.
        r.st.layout.settle();
        let layout_text = r.st.layout.to_text();
        let windows = r.ctx.save_settings();
        let (ctx2, _real) = context(Option.Some(windows));
        let mut again = Rig { game: GameState.city_scenario(), ctx: ctx2, st: ui_state(layout_from_text(&layout_text), screen()) };
        again.game.imgui_ui = true;
        frames(&mut again, 4);
        assert(again.ctx.is_docked("Debug"));
        let Option.Some(back) = again.ctx.window_rect("Debug") else { assert(false); return; };
        assert(back.min.x == docked.min.x && back.min.y == docked.min.y && back.max.x == docked.max.x);
    });
}

@test
fn a_panel_dragged_into_a_box_is_pinned_and_acts_on_its_own_city() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.city_scenario();
        game.select_city();
        let Option.Some(city) = game.selected_city else { assert(false); return; };
        let mut r = rig(game);
        // A box of the shared layer, and Ctrl held so the panels have title bars.
        r.st.layout.editing_outer = true;
        r.st.layout.create_box(screen().scale(1.0));
        r.st.input.mods = Mods { ctrl: true, shift: false, alt: false };
        frames(&mut r, 3);
        assert(r.st.layout.outer_boxes.len() == 1);
        let box_id = r.st.layout.outer_boxes[0].id;
        let space = box_space_name(box_id);
        let Option.Some(root) = r.ctx.dock_root(&space) else { assert(false); return; };
        let node = r.ctx.dock_node(root);
        let c = vec2((node.rect.min.x + node.rect.max.x) / 2.0, (node.rect.min.y + node.rect.max.y) / 2.0);
        let Option.Some(sel) = r.ctx.window_rect("Selection") else { assert(false); return; };
        drag(&mut r, vec2(sel.min.x + 40.0, sel.min.y + 10.0), vec2(c.x - 26.0, c.y));
        frames(&mut r, 5);
        // The selection's panel is now the city's own pinned panel, docked in the box.
        assert(r.st.layout.pinned.len() == 1);
        let pin = r.st.layout.pinned[0];
        assert(r.game.pinned_city_index(pin) == Option.Some(city));
        let pin_title = pin.title();
        assert(r.ctx.is_docked(&pin_title));
        assert(r.st.layout.outer_box_for_window(&r.ctx, &pin_title) == Option.Some(box_id));
        // Closing the city leaves the pinned panel in its box, its buttons still on that city.
        r.game.leave_city_view();
        r.st.input.mods = Mods { ctrl: false, shift: false, alt: false };
        frames(&mut r, 4);
        assert(r.game.selected_city.is_none());
        assert(r.st.layout.pinned.len() == 1);
        assert(r.st.layout.pin_visible(pin));
        // (A button near the top: the box is smaller than the city's whole panel.)
        click_target(&mut r, Target.Focus(LaborFocus.Production));
        assert(r.game.cities[city].focus == LaborFocus.Production);
        assert(r.game.selected_city == Option.Some(city));
        // Removing the box floats what was in it and drops the pin.
        r.st.layout.remove_outer_box(box_id, &mut r.ctx);
        frames(&mut r, 3);
        assert(r.st.layout.outer_boxes.is_empty());
        assert(r.st.layout.pinned.is_empty());
        assert(!r.ctx.is_docked(&pin_title));
    });
}

@test
fn the_queue_keeps_its_room_on_a_narrow_screen() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.city_scenario();
        game.select_city();
        for _ in 0..5 { game.queue_selected_city_unit(BuildUnit.Melee); }
        game.imgui_ui = true;
        let (ctx, _real) = context(Option.None);
        let mut r = Rig { game, ctx, st: ui_state(layout_state(), vec2(1067.0, 600.0)) };
        // 1600 by 900 pixels at 150%: a 1067 by 600 screen, too narrow for a second column.
        let cursor = r.st.input.mouse;
        for _ in 0..6 { run_ui(&mut r.game, &mut r.ctx, &mut r.st, screen(), 1.5, 0.016, cursor); }
        let Option.Some(queue) = r.ctx.window_rect("Production Queue") else { assert(false); return; };
        let Option.Some(selection) = r.ctx.window_rect("Selection") else { assert(false); return; };
        assert(!overlaps(queue, selection, 0.0));
        // Both are inside the screen, under the status bar.
        assert(queue.min.y >= 52.0 && selection.max.y <= 600.0 && selection.max.x <= 1067.0);
    });
}
