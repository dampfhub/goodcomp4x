//! Text drawn with an embedded TrueType font (Hack). Every glyph is rasterized once, into a
//! coverage atlas the renderer samples. UI text uses glyphs rasterized at its exact pixel size
//! so it stays crisp; world text scales one large set, with mipmaps for when it's drawn small.
//!
//! The font file is read at build time (`game.glyphs`), which keeps the outlines of the
//! characters drawn here and lays the atlas out as constants, so the game carries neither the
//! file nor a parser. `atlas` rasterizes those outlines into the laid-out places once, at
//! startup.

use std.linalg.Vec2;
use std.linalg.vec2;
use std.math.Float;
use std.str.chars;
use font.ttf.FontError;
use font.subset_font;
use font.atlas.mip_chain;
use renderer.Atlas;
use renderer.pipelines.MeshVertex;
use game.glyphs.ATLAS_HEIGHT;
use game.glyphs.ATLAS_WIDTH;
use game.glyphs.CAP_HEIGHTS;
use game.glyphs.EXTRA;
use game.glyphs.FACE_SIZES;
use game.glyphs.GLYPH_COUNT;
use game.glyphs.HACK_FACE;
use game.glyphs.HACK_GLYPHS;
use game.glyphs.MIP_LEVELS;
use game.glyphs.PLACED;
use game.glyphs.characters;
use game.glyphs.hack_ops;
use game.mesh.Color;
use ui.atlas.FontAtlas;
use ui.atlas.atlas_builder;

/// The pixel sizes UI text is drawn at.
pub enum TextSize { Small, Body, Title }

impl TextSize {
    /// The size's glyph set in the atlas.
    fn face_index(self) -> i32 {
        match self { TextSize.Small => 0, TextSize.Body => 1, TextSize.Title => 2 }
    }
}

/// Which of the atlas's glyph sets world text scales.
const WORLD_FACE: i32 = 3;

/// A character's place among `characters()`; one the font lacks draws as '?'.
fn slot(ch: char) -> i32 {
    let code = ch as i32;
    if code >= 32 && code <= 126 { return code - 32; }
    for i in 0..4 {
        if ch == EXTRA[i] { return 95 + i; }
    }
    ('?' as i32) - 32
}

/// One glyph of one size: its rectangle in the atlas (`uv_min` is the bitmap's top-left), its
/// bitmap's bottom-left relative to the pen on the baseline (Y up) and size in pixels, and how
/// far the pen advances.
struct AtlasGlyph { uv_min: Vec2, uv_max: Vec2, offset: Vec2, size: Vec2, advance: f32 }

/// The font rasterized at one pixel size.
pub struct TextFace {
    index: i32,
    /// Height of capital letters above the baseline, in pixels.
    cap_height: f32,
    /// Distance between the baselines of consecutive lines, in pixels.
    line_height: f32,
}

fn face_at(index: i32) -> TextFace {
    let px = FACE_SIZES[index] as f32;
    let scale = px / HACK_FACE.units_per_em as f32;
    let line = (HACK_FACE.ascender - HACK_FACE.descender + HACK_FACE.line_gap) as f32;
    TextFace { index, cap_height: CAP_HEIGHTS[index] as f32, line_height: line * scale }
}

/// The face for UI text of `size`.
pub fn ui(size: TextSize) -> TextFace { face_at(size.face_index()) }

impl TextFace {
    fn glyph(&self, ch: char) -> AtlasGlyph {
        let k = slot(ch);
        let p = PLACED[self.index * GLYPH_COUNT + k];
        let atlas = vec2(ATLAS_WIDTH as f32, ATLAS_HEIGHT as f32);
        let min = vec2(p.x as f32, p.y as f32);
        let size = vec2(p.w as f32, p.h as f32);
        let scale = FACE_SIZES[self.index] as f32 / HACK_FACE.units_per_em as f32;
        AtlasGlyph {
            uv_min: min.div(atlas),
            uv_max: min.add(size).div(atlas),
            offset: vec2(p.xmin as f32, p.ymin as f32),
            size,
            // Entry 0 is the missing-character glyph, so a character's entry is one past its slot.
            advance: scale * HACK_GLYPHS[k + 1].advance as f32,
        }
    }

    /// Horizontal space `text` takes up.
    pub fn width(&self, text: &str) -> f32 {
        let mut w: f32 = 0.0;
        for ch in chars(text) { w = w + self.glyph(*ch).advance; }
        w
    }

    /// Draws `text` at this face's own size in screen space, with its baseline's left end at
    /// `origin`. Glyphs snap to whole pixels.
    pub fn push(&self, origin: Vec2, text: &str, color: Color, out: &mut Vec[MeshVertex]) {
        let at = origin.round();
        let mut pen: f32 = 0.0;
        for ch in chars(text) {
            let g = self.glyph(*ch);
            let min = vec2((at.x + pen).round(), at.y).add(g.offset);
            push_glyph_quad(min, min.add(g.size), g, color, out);
            pen = pen + g.advance;
        }
    }
}

/// Draws `ch` in world space with capital letters `cap_height` tall, its ink centered
/// horizontally on `center` and its capital-letter box vertically.
pub fn push_glyph(center: Vec2, cap_height: f32, ch: char, color: Color, out: &mut Vec[MeshVertex]) {
    let face = face_at(WORLD_FACE);
    let g = face.glyph(ch);
    let scale = cap_height / face.cap_height;
    let min = vec2(center.x - g.size.x * scale / 2.0, center.y - cap_height / 2.0 + g.offset.y * scale);
    push_glyph_quad(min, min.add(g.size.scale(scale)), g, color, out);
}

/// Width of world-space `text` with capital letters `cap_height` tall.
pub fn world_text_width(text: &str, cap_height: f32) -> f32 {
    let face = face_at(WORLD_FACE);
    face.width(text) * cap_height / face.cap_height
}

/// Draws a line of world-space text with capital letters `cap_height` tall and its baseline's
/// left end at `origin`.
pub fn push_text(origin: Vec2, cap_height: f32, text: &str, color: Color, out: &mut Vec[MeshVertex]) {
    let face = face_at(WORLD_FACE);
    let scale = cap_height / face.cap_height;
    let mut pen: f32 = 0.0;
    for ch in chars(text) {
        let g = face.glyph(*ch);
        let min = origin.add(vec2(pen, 0.0).add(g.offset).scale(scale));
        push_glyph_quad(min, min.add(g.size.scale(scale)), g, color, out);
        pen = pen + g.advance;
    }
}

fn push_glyph_quad(min: Vec2, max: Vec2, g: AtlasGlyph, color: Color, out: &mut Vec[MeshVertex]) {
    if g.size.x == 0.0 { return; }
    // Bitmap rows run top to bottom, so the quad's bottom edge samples the bitmap's last row.
    let bottom_left = MeshVertex { pos: [min.x, min.y, 0.0], color, uv: [g.uv_min.x, g.uv_max.y] };
    let bottom_right = MeshVertex { pos: [max.x, min.y, 0.0], color, uv: [g.uv_max.x, g.uv_max.y] };
    let top_right = MeshVertex { pos: [max.x, max.y, 0.0], color, uv: [g.uv_max.x, g.uv_min.y] };
    let top_left = MeshVertex { pos: [min.x, max.y, 0.0], color, uv: [g.uv_min.x, g.uv_min.y] };
    out.push(bottom_left);
    out.push(bottom_right);
    out.push(top_right);
    out.push(bottom_left);
    out.push(top_right);
    out.push(top_left);
}

/// Every glyph rasterized into the atlas, with its mip chain: what the renderer uploads. The
/// font's bytes were read and checked by `glyphs`' `#run`, so a `FontError` here is a defect.
pub fn atlas() -> Atlas can {FontError} {
    let ops = hack_ops();
    let font = subset_font(HACK_FACE, &HACK_GLYPHS, &ops);
    let cs = characters();
    let width = ATLAS_WIDTH;
    let mut pixels: Vec[u8] = Vec.with_capacity(width * ATLAS_HEIGHT);
    for _ in 0..width * ATLAS_HEIGHT { pixels.push(0); }
    for s in 0..4 {
        for i in 0..cs.len() {
            let (m, bitmap) = font.rasterize(cs[i], FACE_SIZES[s] as f32);
            let p = PLACED[s * GLYPH_COUNT + i];
            for row in 0..m.height {
                for x in 0..m.width { pixels[(p.y + row) * width + p.x + x] = bitmap[row * m.width + x]; }
            }
        }
    }
    Atlas { width, height: ATLAS_HEIGHT, levels: mip_chain(&pixels, width, ATLAS_HEIGHT, MIP_LEVELS) }
}

/// The pixel sizes of the UI library's fonts, by `FontId` index: `TextSize.Small`, `Body` and
/// `Title`.
pub const UI_FONT_PX: [f32; 3] = [15.0, 18.0, 22.0];

/// The glyphs of the UI library's fonts: the same outlines as `atlas`, rasterized at the
/// three UI sizes into the library's own atlas (`ui.atlas`).
pub fn ui_atlas() -> FontAtlas can {FontError} {
    let ops = hack_ops();
    let font = subset_font(HACK_FACE, &HACK_GLYPHS, &ops);
    let cs = characters();
    let mut builder = atlas_builder(ATLAS_WIDTH);
    for k in 0..3 { let _id = builder.add(&font, &cs, UI_FONT_PX[k]); }
    builder.finish()
}
