//! A 5x7 bitmap font. There is no text pipeline, so each lit cell of a glyph is drawn as a
//! quad like any other geometry.

use std.linalg.Vec2;
use std.linalg.vec2;
use std.str.byte_at;
use std.str.char_count;
use std.str.chars;
use renderer.pipelines.MeshVertex;
use game.mesh.Color;
use game.mesh.quad;

const COLS: i32 = 5;
const ROWS: i32 = 7;
/// Horizontal advance per character, in cells: the glyph plus one of spacing.
const ADVANCE: i32 = COLS + 1;

/// A glyph's rows, top first; `X` is a lit cell.
type Glyph = [str; 7];

/// Draws `ch` centered on `center`, `height` world units tall.
pub fn push_glyph(center: Vec2, height: f32, ch: char, color: Color, out: &mut Vec[MeshVertex]) {
    let cell = height / ROWS as f32;
    let top_left = center.add(vec2(-cell * COLS as f32, height).scale(0.5));
    push_glyph_cells(top_left, cell, ch, color, out);
}

/// Width of `text` drawn at `height`.
pub fn text_width(text: &str, height: f32) -> f32 {
    let cell = height / ROWS as f32;
    let advances = char_count(text) as i32 * ADVANCE;
    (if advances > 0 { advances - 1 } else { 0 }) as f32 * cell
}

/// Width of `text` drawn with glyphs `height` tall; world text sizes by its glyph height.
pub fn world_text_width(text: &str, height: f32) -> f32 { text_width(text, height) }

/// Draws a line of text with its bottom-left corner at `origin`.
pub fn push_text(origin: Vec2, height: f32, text: &str, color: Color, out: &mut Vec[MeshVertex]) {
    let cell = height / ROWS as f32;
    let mut i = 0;
    for ch in chars(text) {
        let top_left = origin.add(vec2((i * ADVANCE) as f32 * cell, height));
        push_glyph_cells(top_left, cell, *ch, color, out);
        i = i + 1;
    }
}

/// Characters without a glyph (including space) are left blank.
fn push_glyph_cells(top_left: Vec2, cell: f32, ch: char, color: Color, out: &mut Vec[MeshVertex]) {
    let Option.Some(rows) = glyph(ch) else { return; };
    for row in 0..ROWS {
        for col in 0..COLS {
            if byte_at(rows[row], col as i64) == Option.Some('X' as i64) {
                // Y points up, so each successive row sits lower.
                let min = top_left.add(vec2(col as f32, -(row as f32 + 1.0)).scale(cell));
                quad(min, min.add(vec2(cell, cell)), color, out);
            }
        }
    }
}

fn glyph(ch: char) -> Option[Glyph] {
    match ch {
        'A' => Option.Some([".XXX.",
                            "X...X",
                            "X...X",
                            "XXXXX",
                            "X...X",
                            "X...X",
                            "X...X"]),
        'B' => Option.Some(["XXXX.",
                            "X...X",
                            "X...X",
                            "XXXX.",
                            "X...X",
                            "X...X",
                            "XXXX."]),
        'C' => Option.Some([".XXX.",
                            "X...X",
                            "X....",
                            "X....",
                            "X....",
                            "X...X",
                            ".XXX."]),
        'D' => Option.Some(["XXX..",
                            "X..X.",
                            "X...X",
                            "X...X",
                            "X...X",
                            "X..X.",
                            "XXX.."]),
        'E' => Option.Some(["XXXXX",
                            "X....",
                            "X....",
                            "XXXX.",
                            "X....",
                            "X....",
                            "XXXXX"]),
        'F' => Option.Some(["XXXXX",
                            "X....",
                            "X....",
                            "XXXX.",
                            "X....",
                            "X....",
                            "X...."]),
        'G' => Option.Some([".XXX.",
                            "X...X",
                            "X....",
                            "X.XXX",
                            "X...X",
                            "X...X",
                            ".XXXX"]),
        'H' => Option.Some(["X...X",
                            "X...X",
                            "X...X",
                            "XXXXX",
                            "X...X",
                            "X...X",
                            "X...X"]),
        'I' => Option.Some([".XXX.",
                            "..X..",
                            "..X..",
                            "..X..",
                            "..X..",
                            "..X..",
                            ".XXX."]),
        'J' => Option.Some(["..XXX",
                            "...X.",
                            "...X.",
                            "...X.",
                            "...X.",
                            "X..X.",
                            ".XX.."]),
        'K' => Option.Some(["X...X",
                            "X..X.",
                            "X.X..",
                            "XX...",
                            "X.X..",
                            "X..X.",
                            "X...X"]),
        'L' => Option.Some(["X....",
                            "X....",
                            "X....",
                            "X....",
                            "X....",
                            "X....",
                            "XXXXX"]),
        'M' => Option.Some(["X...X",
                            "XX.XX",
                            "X.X.X",
                            "X...X",
                            "X...X",
                            "X...X",
                            "X...X"]),
        'N' => Option.Some(["X...X",
                            "X...X",
                            "XX..X",
                            "X.X.X",
                            "X..XX",
                            "X...X",
                            "X...X"]),
        'O' => Option.Some([".XXX.",
                            "X...X",
                            "X...X",
                            "X...X",
                            "X...X",
                            "X...X",
                            ".XXX."]),
        'P' => Option.Some(["XXXX.",
                            "X...X",
                            "X...X",
                            "XXXX.",
                            "X....",
                            "X....",
                            "X...."]),
        'Q' => Option.Some([".XXX.",
                            "X...X",
                            "X...X",
                            "X...X",
                            "X.X.X",
                            "X..X.",
                            ".XX.X"]),
        'R' => Option.Some(["XXXX.",
                            "X...X",
                            "X...X",
                            "XXXX.",
                            "X.X..",
                            "X..X.",
                            "X...X"]),
        'S' => Option.Some([".XXX.",
                            "X...X",
                            "X....",
                            ".XXX.",
                            "....X",
                            "X...X",
                            ".XXX."]),
        'T' => Option.Some(["XXXXX",
                            "..X..",
                            "..X..",
                            "..X..",
                            "..X..",
                            "..X..",
                            "..X.."]),
        'U' => Option.Some(["X...X",
                            "X...X",
                            "X...X",
                            "X...X",
                            "X...X",
                            "X...X",
                            ".XXX."]),
        'V' => Option.Some(["X...X",
                            "X...X",
                            "X...X",
                            "X...X",
                            "X...X",
                            ".X.X.",
                            "..X.."]),
        'W' => Option.Some(["X...X",
                            "X...X",
                            "X...X",
                            "X.X.X",
                            "X.X.X",
                            "X.X.X",
                            ".X.X."]),
        'X' => Option.Some(["X...X",
                            "X...X",
                            ".X.X.",
                            "..X..",
                            ".X.X.",
                            "X...X",
                            "X...X"]),
        'Y' => Option.Some(["X...X",
                            "X...X",
                            ".X.X.",
                            "..X..",
                            "..X..",
                            "..X..",
                            "..X.."]),
        'Z' => Option.Some(["XXXXX",
                            "....X",
                            "...X.",
                            "..X..",
                            ".X...",
                            "X....",
                            "XXXXX"]),
        '0' => Option.Some([".XXX.",
                            "X...X",
                            "X..XX",
                            "X.X.X",
                            "XX..X",
                            "X...X",
                            ".XXX."]),
        '1' => Option.Some(["..X..",
                            ".XX..",
                            "..X..",
                            "..X..",
                            "..X..",
                            "..X..",
                            ".XXX."]),
        '2' => Option.Some([".XXX.",
                            "X...X",
                            "....X",
                            "...X.",
                            "..X..",
                            ".X...",
                            "XXXXX"]),
        '3' => Option.Some(["XXXXX",
                            "...X.",
                            "..X..",
                            "...X.",
                            "....X",
                            "X...X",
                            ".XXX."]),
        '4' => Option.Some(["...X.",
                            "..XX.",
                            ".X.X.",
                            "X..X.",
                            "XXXXX",
                            "...X.",
                            "...X."]),
        '5' => Option.Some(["XXXXX",
                            "X....",
                            "XXXX.",
                            "....X",
                            "....X",
                            "X...X",
                            ".XXX."]),
        '6' => Option.Some(["..XX.",
                            ".X...",
                            "X....",
                            "XXXX.",
                            "X...X",
                            "X...X",
                            ".XXX."]),
        '7' => Option.Some(["XXXXX",
                            "....X",
                            "...X.",
                            "..X..",
                            ".X...",
                            ".X...",
                            ".X..."]),
        '8' => Option.Some([".XXX.",
                            "X...X",
                            "X...X",
                            ".XXX.",
                            "X...X",
                            "X...X",
                            ".XXX."]),
        '9' => Option.Some([".XXX.",
                            "X...X",
                            "X...X",
                            ".XXXX",
                            "....X",
                            "...X.",
                            ".XX.."]),
        '+' => Option.Some([".....",
                            "..X..",
                            "..X..",
                            "XXXXX",
                            "..X..",
                            "..X..",
                            "....."]),
        '-' => Option.Some([".....",
                            ".....",
                            ".....",
                            "XXXXX",
                            ".....",
                            ".....",
                            "....."]),
        '%' => Option.Some(["XX...",
                            "XX..X",
                            "...X.",
                            "..X..",
                            ".X...",
                            "X..XX",
                            "...XX"]),
        _ => Option.None,
    }
}
