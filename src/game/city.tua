use std.core.Eq;
use std.core.Keep;
use std.fmt.Out;
use std.fmt.show_i64;
use std.fmt.show_u64;
use log.Log;
use game.GameState;
use game.PLAYER_TEAM;
use game.text;
use game.hex.Hex;
use game.hex.HexGrid;
use game.terrain.HILLS;
use game.terrain.MOUNTAINS;
use game.terrain.Resource;
use game.unit.Team;
use game.unit.Unit;
use game.unit.UnitType;
use game.unit.TEAMS;
use game.mapgen.generate;
use game.mapgen.start_units;
use game.ruins.ruin;
use game.ruins.RUIN_REWARDS;
use game.settings.Settings;
use game.workers.WorkerJob;
use game.scenario.copy_vec;
use game.scenario.copy_map;
use std.math.min;
pub use game.city.builds.Building;
pub use game.city.builds.Build;
pub use game.city.builds.BuildUnit;
pub use game.city.builds.BUILDINGS;
pub use game.city.builds.PLACEABLE;
pub use game.city.builds.CITY_UNITS;
pub use game.city.builds.BARRACKS_UNITS;
pub use game.city.builds.WORKER_COST;
pub use game.city.builds.WORKER_SHORTCUT;
pub use game.city.logistics.Routes;
pub use game.city.logistics.RouteBoard;
pub use game.city.logistics.delivered_share;

/// Camera zoom the city scenarios start at: most of the radius-six map in view.
const SCENARIO_VIEW_HALF_HEIGHT: f32 = 12.0;
/// One manager and up to six nearby workers.
pub const MAX_CITY_POPULATION: i32 = 7;
pub const BARRACKS_MAX_HP: f32 = 220.0;
pub const BARRACKS_DEFENSE: f32 = 25.0;
pub const COASTAL_BATTERY_MAX_HP: f32 = 150.0;

/// What a city's auto-assignment favours: food, production, or food while the city is short
/// of it and production after.
pub enum LaborFocus { Food, Production, Balanced }

impl Eq for LaborFocus {
    fn eq(self, other: LaborFocus) -> bool {
        match (self, other) {
            (LaborFocus.Food, LaborFocus.Food) | (LaborFocus.Production, LaborFocus.Production) | (LaborFocus.Balanced, LaborFocus.Balanced) => true,
            _ => false,
        }
    }
}

impl LaborFocus {
    pub fn name(self) -> str {
        match self { LaborFocus.Food => "FOOD", LaborFocus.Production => "PRODUCTION", LaborFocus.Balanced => "BALANCED" }
    }
}

/// Every focus, in the order the city tray shows them.
pub const FOCUSES: [LaborFocus; 3] = [LaborFocus.Food, LaborFocus.Production, LaborFocus.Balanced];

pub struct City {
    id: u32,
    team: Team,
    pos: Hex,
    population: i32,
    food: i32,
    production: i32,
    barracks_hp: f32,
    coastal_battery_hp: f32,
    /// The tiles its citizens work. The first is the manager; the rest stand next to it.
    worked: Vec[Hex],
    /// Manual tiles displaced by a blocked logistics route. They return when available unless
    /// the player changes the assignment.
    remembered_worked: Vec[Hex],
    focus: LaborFocus,
    /// The city works the first item, then immediately continues with the following items.
    /// Buildings and units deliberately share this queue.
    queue: Vec[Build],
    built: Vec[Building],
    barracks: Option[Hex],
    mill: Option[Hex],
    workshop: Option[Hex],
    /// Placed buildings other than those three share one site map instead of adding a city
    /// field each.
    extra_buildings: Map[Building, Hex],
    /// Scroll position in the city tray's building list.
    building_scroll: i32,
    pending_building: Option[Building],
    planned_sites: Map[Building, Hex],
    /// Barracks production is independent of the city's main queue.
    barracks_queue: Vec[BuildUnit],
    barracks_production: i32,
    /// Workers at home, safe and off the map (`workers.tua`).
    workers: u32,
    /// Jobs waiting for a worker, first to go first.
    worker_jobs: Vec[WorkerJob],
    /// The player let the workers at home rest this turn (Sleep in the worker menu), so they
    /// don't wait for orders until the next.
    workers_resting: bool,
}

impl City {
    /// A newly founded city: one citizen and one worker.
    pub fn new(id: u32, team: Team, pos: Hex) -> City {
        City {
            id,
            team,
            pos,
            population: 1,
            food: 0,
            production: 0,
            barracks_hp: BARRACKS_MAX_HP,
            coastal_battery_hp: COASTAL_BATTERY_MAX_HP,
            worked: Vec.new(),
            remembered_worked: Vec.new(),
            focus: LaborFocus.Balanced,
            queue: Vec.new(),
            built: Vec.new(),
            barracks: Option.None,
            mill: Option.None,
            workshop: Option.None,
            extra_buildings: Map.new(),
            building_scroll: 0,
            pending_building: Option.None,
            planned_sites: Map.new(),
            barracks_queue: Vec.new(),
            barracks_production: 0,
            workers: 1,
            worker_jobs: Vec.new(),
            workers_resting: false,
        }
    }

    /// Where `building` stands, once finished and confirmed. A Granary has no site.
    pub fn placed_site(&self, building: Building) -> Option[Hex] {
        match building {
            Building.Granary => Option.None,
            Building.Barracks => self.barracks,
            Building.Mill => self.mill,
            Building.Workshop => self.workshop,
            _ => self.extra_buildings.get(building),
        }
    }

    /// Puts `building` on `site`. Never called for a Granary, which has no site.
    pub fn set_placed_site(&mut self, building: Building, site: Hex) {
        match building {
            Building.Granary => {}
            Building.Barracks => {
                self.barracks = Option.Some(site);
                self.barracks_hp = BARRACKS_MAX_HP;
            }
            Building.Mill => { self.mill = Option.Some(site); }
            Building.Workshop => { self.workshop = Option.Some(site); }
            _ => { let _old = self.extra_buildings.insert(building, site); }
        }
    }

    /// A copy of the city, for a savestate.
    pub fn snapshot(&self) -> City {
        City {
            id: self.id,
            team: self.team,
            pos: self.pos,
            population: self.population,
            food: self.food,
            production: self.production,
            barracks_hp: self.barracks_hp,
            coastal_battery_hp: self.coastal_battery_hp,
            worked: copy_vec(&self.worked),
            remembered_worked: copy_vec(&self.remembered_worked),
            focus: self.focus,
            queue: copy_vec(&self.queue),
            built: copy_vec(&self.built),
            barracks: self.barracks,
            mill: self.mill,
            workshop: self.workshop,
            extra_buildings: copy_map(&self.extra_buildings),
            building_scroll: self.building_scroll,
            pending_building: self.pending_building,
            planned_sites: copy_map(&self.planned_sites),
            barracks_queue: copy_vec(&self.barracks_queue),
            barracks_production: self.barracks_production,
            workers: self.workers,
            worker_jobs: copy_vec(&self.worker_jobs),
            workers_resting: self.workers_resting,
        }
    }
}

/// What a worked improvement on a tile is.
pub enum SiteKind { Farm, Mine, Pasture, LumberMill }

impl Eq for SiteKind {
    fn eq(self, other: SiteKind) -> bool {
        match (self, other) {
            (SiteKind.Farm, SiteKind.Farm) | (SiteKind.Mine, SiteKind.Mine) | (SiteKind.Pasture, SiteKind.Pasture) | (SiteKind.LumberMill, SiteKind.LumberMill) => true,
            _ => false,
        }
    }
}

impl SiteKind {
    pub fn name(self) -> str {
        match self {
            SiteKind.Farm => "FARM",
            SiteKind.Mine => "MINE",
            SiteKind.Pasture => "PASTURE",
            SiteKind.LumberMill => "LUMBER MILL",
        }
    }

    /// The letter marking it on the map.
    pub fn letter(self) -> char {
        match self {
            SiteKind.Farm => 'F',
            SiteKind.Mine => 'M',
            SiteKind.Pasture => 'P',
            SiteKind.LumberMill => 'L',
        }
    }
}

/// An improvement owned by a team; only that team's cities may work it.
pub struct Site { team: Team, food: i32, production: i32, kind: SiteKind }

/// A quarter amount with two decimals, like `-1.25`.
pub fn show_amount(quarters: i32) can {Out} {
    if quarters < 0 { Out.put("-"); }
    let q = if quarters < 0 { -quarters } else { quarters };
    show_i64((q / 4) as i64);
    Out.put(match q % 4 { 0 => ".00", 1 => ".25", 2 => ".50", _ => ".75" });
}

impl GameState {
    /// The city standing on `hex`, if any.
    pub fn city_at(&self, hex: Hex) -> Option[i32] {
        for i in 0..self.cities.len() {
            if self.cities[i].pos == hex { return Option.Some(i); }
        }
        Option.None
    }

    pub fn setup_cities(&mut self) {
        let terrain = [
            (Hex.new(-2, 2), HILLS),
            (Hex.new(2, -2), HILLS),
            (Hex.new(0, 0), HILLS),
            (Hex.new(0, -4), MOUNTAINS),
            (Hex.new(0, -3), MOUNTAINS),
            (Hex.new(0, -2), MOUNTAINS),
            (Hex.new(0, 2), MOUNTAINS),
            (Hex.new(0, 3), MOUNTAINS),
            (Hex.new(0, 4), MOUNTAINS),
        ];
        let resources = [
            (Hex.new(-2, 0), Resource.Horses),
            (Hex.new(-2, 1), Resource.Iron),
            (Hex.new(2, 0), Resource.Horses),
            (Hex.new(2, -1), Resource.Iron),
        ];
        self.grid = HexGrid.with_resources(6, &terrain, &resources);
        self.camera.half_height = SCENARIO_VIEW_HALF_HEIGHT;
        let sides: [(u32, Team, i32); 2] = [(0, Team.Blue, -1), (1, Team.Red, 1)];
        let sites = [
            (4, -1, 4, 0, SiteKind.Farm),
            (3, 0, 4, 0, SiteKind.Farm),
            (2, -2, 0, 4, SiteKind.Mine),
            (4, 1, 3, 1, SiteKind.Pasture),
        ];
        let roads = [(4, 0), (3, 0), (3, -1), (3, -2), (2, -2)];
        for s in 0..2 {
            let (id, team, sign) = sides[s];
            let mut city = City.new(id, team, Hex.new(sign * 4, 0));
            city.population = 2;
            city.food = 32;
            self.cities.push(city);
            for k in 0..4 {
                let (q, r, food, production, kind) = sites[k];
                self.sites.insert(Hex.new(sign * q, sign * r), Site { team, food, production, kind });
            }
            for k in 0..5 {
                let (q, r) = roads[k];
                self.roads.insert(Hex.new(sign * q, sign * r));
            }
        }
        for i in 0..self.cities.len() { self.auto_assign_city(i); }
        self.notice = text(fn() can {Out} { Out.put("C CITY - SPACE HOLD OR END TURN - F1 COMBAT - F2 CITIES"); });
    }

    /// A generated world (`mapgen.tua`) from `seed`: a start for the player and each AI side,
    /// each with its city (or a settler, as `settings` say) and a scout on the hills beside it,
    /// and ruins between them.
    pub fn setup_world(&mut self, seed: u32, settings: &Settings) {
        let ai = min(settings.world_ai_for(seed), 6);
        let map = generate(seed, 1 + ai);
        self.grid = map.grid;
        self.map_seed = Option.Some(seed);
        self.camera.half_height = SCENARIO_VIEW_HALF_HEIGHT;
        for i in 0..map.ruins.len() {
            self.ruins.push(ruin(map.ruins[i], RUIN_REWARDS[((seed as i64 + i as i64) % 3) as i32]));
        }
        for k in 0..map.starts.len() {
            if k >= 7 { break; }
            let team = TEAMS[k];
            let start = map.starts[k];
            // The start comes with hills for the scout. Only the blank fallback map lacks them.
            let around = start.neighbors();
            let mut open: Vec[Hex] = Vec.new();
            for n in 0..6 { if self.grid.is_passable(around[n]) { open.push(around[n]); } }
            let scout = match start_units(&self.grid, start) {
                Option.Some((_, s)) => s,
                Option.None => if open.len() > 1 { open[1] } else { start },
            };
            if settings.world_start_city {
                let id = self.cities.len() as u32;
                // The AI keeps training melee (`complete_builds`); the player's queue starts
                // empty.
                let mut city = City.new(id, team, start);
                if team != PLAYER_TEAM { city.queue.push(Build.Unit(BuildUnit.Melee)); }
                self.cities.push(city);
                self.auto_assign_city(self.cities.len() - 1);
            } else {
                let id = self.take_unit_id();
                self.units.push(Unit.new(id, start, team, UnitType.Melee));
                let _new = self.settlers.insert(id);
            }
            let id = self.take_unit_id();
            self.units.push(Unit.new(id, scout, team, UnitType.Scout));
        }
        let founding = if settings.world_start_city { "C OPENS YOUR CITY" } else { "F FOUNDS A CITY" };
        self.notice = text(fn() can {Out} {
            Out.put("WORLD SEED "); show_u64(seed as u64); Out.put(" - "); show_u64(ai as u64); Out.put(" AI - "); Out.put(founding); Out.put(" - F4 FOR A NEW MAP");
        });
    }

    pub fn setup_frontier(&mut self) {
        let terrain = [
            (Hex.new(-1, 2), HILLS),
            (Hex.new(1, -2), HILLS),
            (Hex.new(0, 3), MOUNTAINS),
            (Hex.new(0, -3), MOUNTAINS),
        ];
        self.grid = HexGrid.new(6, &terrain);
        self.camera.half_height = SCENARIO_VIEW_HALF_HEIGHT;
        let settlers = [(Team.Blue, Hex.new(-4, 0)), (Team.Red, Hex.new(4, 0))];
        for s in 0..2 {
            let (team, pos) = settlers[s];
            let id = self.take_unit_id();
            self.units.push(Unit.new(id, pos, team, UnitType.Melee));
            self.settlers.insert(id);
        }
        let scouts = [(Team.Blue, Hex.new(-3, -1)), (Team.Red, Hex.new(3, 1))];
        for s in 0..2 {
            let (team, pos) = scouts[s];
            let id = self.take_unit_id();
            self.units.push(Unit.new(id, pos, team, UnitType.Scout));
            if team == Team.Red { self.player_controlled_units.insert(id); }
        }
        self.notice = text(fn() can {Out} { Out.put("F FOUND CITY - BOTH STARTING SCOUTS ARE YOURS TO TEST"); });
        self.selected = self.unit_of_team_at(Hex.new(-4, 0), PLAYER_TEAM);
    }

    /// The next unused unit id.
    pub fn take_unit_id(&mut self) -> u32 {
        let id = self.next_unit_id;
        self.next_unit_id = self.next_unit_id + 1;
        id
    }

    pub fn set_notice(&mut self, message: str) {
        self.notice = text(fn() can {Out} { Out.put(message); });
    }

    /// Takes the unit with `id` off the map.
    pub fn remove_unit(&mut self, id: u32) {
        handle { self.units.retain(); } with Keep[Unit] { keep(u) => { resume u.id != id } }
    }
}
