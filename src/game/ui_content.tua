//! The panels the library UI shows beyond the command tray: the production queues (with
//! drag-to-reorder), the turn strip of what still needs orders, the settings menu and the
//! hover panel for a city or Barracks. Each is a `PanelBuilder`, like the tray, so the actions
//! they name go through `activate_target`.

use std.math.Float;
use std.fmt.Out;
use std.fmt.show_i64;
use std.fmt.show_u64;
use std.fmt.show_f64_fixed;
use std.linalg.Vec2;
use std.linalg.vec2;
use std.str.Str;
use std.str.eq as str_eq;
use std.str.to_owned;
use game.GameState;
use game.city.BARRACKS_MAX_HP;
use game.city.Lane;
use game.city.Stock;
use game.city.SETTLER_MIN_POPULATION;
use game.city.stock_icons;
use game.city.turns_icon;
use game.draw.UnitLook;
use game.settings.Setting;
use game.settings.SETTINGS;
use game.text;
use game.ui.ButtonState;
use game.ui.ChipIcon;
use game.ui.PanelBuilder;
use game.ui.QueueItemSpec;
use game.ui.QueueDrag;
use game.ui.QueueKind;
use game.ui.QueueScroll;
use game.ui.contains;
use game.ui.to_ui;
use game.ui.RosterChip;
use game.ui.RosterKey;
use game.ui.Target;
use game.ui.button_state;
use game.city.resource_icon;
use game.city.RESOURCE_NAMES;
use game.ui.panel_builder;
use game.unit_icons.UnitIcon;
use game.unit.UnitType;
use game.font.TextSize;
use game.mesh.Color;

const GAP: f32 = 10.0;
const LABEL_TEXT: Color = [0.30, 0.32, 0.38, 1.0];
const DIM_TEXT: Color = [0.55, 0.55, 0.60, 1.0];
const GOLD_TEXT: Color = [0.95, 0.80, 0.35, 1.0];
const TEXT: Color = [0.95, 0.95, 0.95, 1.0];
/// Chips in one row of the turn strip.
pub const ROSTER_PER_ROW: i32 = 12;

/// A city amount in quarter units, without decimals when it's whole.
fn show_quantity(quarters: i32) can {Out} {
    if quarters % 4 == 0 { show_i64((quarters / 4) as i64); } else { show_f64_fixed(quarters as f64 / 4.0, 2); }
}

fn show_signed_quantity(quarters: i32) can {Out} {
    if quarters >= 0 { Out.put("+"); }
    show_quantity(quarters);
}

/// Turns needed to finish a queue item at the delivery-adjusted rate shown in its structure
/// panel; a dash when nothing is delivered. Completion is resolved on the next economy tick.
fn show_turns_at_rate(remaining: i32, per_turn: i32) can {Out} {
    if per_turn <= 0 { Out.put("\u{2014}"); return; }
    let left = if remaining < 1 { 1 } else { remaining };
    show_i64(((left + per_turn - 1) / per_turn) as i64);
    Out.put("T");
}

impl GameState {
    // ---- production queues --------------------------------------------------------------

    pub fn barracks_queue_panel(&self, i: i32, visible: i32, panel: &mut PanelBuilder) {
        let city = &self.cities[i];
        if city.barracks_queue.is_empty() { return; }
        let status = self.queue_status(i, Lane.Barracks);
        let total = city.barracks_queue.len();
        let most = if total > visible { total - visible } else { 0 };
        let offset = if self.barracks_queue_scroll < most { self.barracks_queue_scroll } else { most };
        if total > visible { panel.scrollbar = Option.Some(QueueScroll { kind: QueueKind.Barracks, offset, total, visible }); }
        self.queue_title("BARRACKS QUEUE - DRAG TO REORDER", Target.ClearBarracksQueue, panel);
        let drag = match self.queue_drag { Option.Some(d) => d.kind == QueueKind.Barracks, Option.None => false };
        let last = if total < offset + visible { total } else { offset + visible };
        for index in offset..last {
            let name = city.barracks_queue[index].build.name();
            let row = self.queue_row(i, Lane.Barracks, index, name, &status, drag, QueueKind.Barracks);
            panel.queue_item(row);
        }
    }
    pub fn city_queue_panel(&self, i: i32, visible: i32, panel: &mut PanelBuilder) {
        let city = &self.cities[i];
        if city.queue.is_empty() { return; }
        let status = self.queue_status(i, Lane.City);
        let total = city.queue.len();
        let most = if total > visible { total - visible } else { 0 };
        let offset = if self.city_queue_scroll < most { self.city_queue_scroll } else { most };
        if total > visible { panel.scrollbar = Option.Some(QueueScroll { kind: QueueKind.City, offset, total, visible }); }
        self.queue_title("CITY QUEUE - DRAG TO REORDER", Target.ClearCityQueue, panel);
        let drag = match self.queue_drag { Option.Some(d) => d.kind == QueueKind.City, Option.None => false };
        let last = if total < offset + visible { total } else { offset + visible };
        for index in offset..last {
            let name = city.queue[index].build.name();
            let row = self.queue_row(i, Lane.City, index, name, &status, drag, QueueKind.City);
            panel.queue_item(row);
        }
    }

    /// A queue panel's title, with its Clear button: every item off, refunded. Dimmed while a
    /// turn plays out, when the queue can't change.
    fn queue_title(&self, title: &str, clear: Target, panel: &mut PanelBuilder) {
        panel.begin_buttons();
        panel.button(clear, "CLEAR", "", button_state(false, self.is_resolving()), false);
        panel.end_buttons(true);
        panel.text(TextSize.Small, title, LABEL_TEXT);
    }

    /// What one of `city`'s queues does this turn, for the panels. For the player's own cities
    /// it's `forecast`'s view: the item worked, and which items wait for the stockpile or for
    /// supply. Other sides' stockpiles aren't the player's to see, so their queues show only
    /// their first item.
    pub fn queue_status(&self, city: i32, lane: Lane) -> QueueStatus {
        let len = self.lane_len(city, lane);
        if self.cities[city].team == self.local_team {
            if let Option.Some(forecast) = self.forecast(self.local_team).lane(city, lane) {
                return QueueStatus { worked: forecast.worked, waiting: self.waiting_items(forecast), supply: self.supply_waiting_items(forecast) };
            }
        }
        QueueStatus { worked: if len > 0 { Option.Some(0) } else { Option.None }, waiting: Vec.new(), supply: Vec.new() }
    }

    /// Whether item `index` of one of `city`'s queues is a Settler waiting for citizens
    /// (`waits_for_citizens`).
    fn waits_for_citizens_at(&self, city: i32, lane: Lane, index: i32) -> bool {
        lane == Lane.City && index < self.lane_len(city, lane) && self.waits_for_citizens(city, index)
    }

    /// The name of item `index` of one of `city`'s queues.
    pub fn item_name(&self, city: i32, lane: Lane, index: i32) -> str {
        match lane {
            Lane.City => self.cities[city].queue[index].build.name(),
            Lane.Barracks => self.cities[city].barracks_queue[index].build.name(),
        }
    }

    /// The item one of `city`'s queues works (`status`): its name, the turns it has left and how
    /// far along it is (0 to 1).
    pub fn worked_item(&self, city: i32, lane: Lane, status: &QueueStatus) -> Option[(str, i32, f32)] {
        let Option.Some(index) = status.worked else { return Option.None; };
        let (_, progress, work) = self.lane_item(city, lane, index);
        Option.Some((self.item_name(city, lane, index), self.item_turns_left(city, lane, index), clamp01(progress as f32 / work as f32)))
    }

    /// "MELEE WAITS FOR [wood]3" when the first item of one of `city`'s queues waits for the
    /// stockpile (`status`).
    pub fn head_waiting_text(&self, city: i32, lane: Lane, status: &QueueStatus) -> Option[Str] {
        if self.waits_for_citizens_at(city, lane, 0) {
            let name = self.item_name(city, lane, 0);
            return Option.Some(text(fn() can {Out} { Out.put(name); Out.put(" WAITS FOR POPULATION "); show_i64(SETTLER_MIN_POPULATION as i64); }));
        }
        // Its side's units and started items leave no room for it: the supply has fallen since it
        // was queued (`supply_waiting_items`).
        if status.supply.contains(0) {
            let name = self.item_name(city, lane, 0);
            return Option.Some(text(fn() can {Out} { Out.put(name); Out.put(" WAITS FOR SUPPLY: NO ROOM TO START IT"); }));
        }
        let Option.Some(short) = status.waits(0) else { return Option.None; };
        let name = self.item_name(city, lane, 0);
        let icons = stock_icons(short);
        Option.Some(text(fn() can {Out} { Out.put(name); Out.put(" WAITS FOR "); Out.put(&icons); }))
    }

    /// Row `index` of one of `city`'s queues: the item's `name` and the turns it has left, or what
    /// it waits for. The item the city works is marked.
    fn queue_row(&self, city: i32, lane: Lane, index: i32, name: str, status: &QueueStatus, drag: bool, kind: QueueKind) -> QueueItemSpec {
        let active = status.worked == Option.Some(index);
        let waits = status.waits(index);
        let citizens = self.waits_for_citizens_at(city, lane, index);
        let supply = status.supply.contains(index);
        let saved_note = !active && self.lane_item(city, lane, index).1 > 0;
        let state: Str = if citizens {
            text(fn() can {Out} { Out.put("WAITS FOR POP "); show_i64(SETTLER_MIN_POPULATION as i64); })
        } else if supply {
            to_owned("WAITS FOR SUPPLY")
        } else if let Option.Some(short) = waits {
            let icons = stock_icons(short);
            text(fn() can {Out} { Out.put("WAITS "); Out.put(&icons); })
        } else {
            let turns = self.item_turns_left(city, lane, index);
            if turns == 0 { to_owned("READY") } else { let clock = turns_icon(turns); text(fn() can {Out} { Out.put(&clock); Out.put(" LEFT"); }) }
        };
        let (dragging, drop_target) = self.drag_flags(drag, index);
        let label = text(fn() can {Out} { Out.put(if active { "> " } else { "  " }); Out.put(name); Out.put(" | "); Out.put(&state); if saved_note { Out.put(" \u{b7} SAVED"); } });
        QueueItemSpec { kind, index, label, active, locked: false, dragging, drop_target }
    }
    /// Whether row `index` is the one being dragged and whether a drop on it would land (`drag`:
    /// the drag is in this row's list).
    pub fn drag_flags(&self, drag: bool, index: i32) -> (bool, bool) {
        if !drag { return (false, false); }
        match self.queue_drag {
            Option.Some(d) => (d.source == index, d.target == Option.Some(index) && d.source != index),
            Option.None => (false, false),
        }
    }

    fn set_queue_scroll(&mut self, kind: QueueKind, offset: i32) {
        match kind {
            QueueKind.City => { self.city_queue_scroll = offset; }
            QueueKind.Barracks => { self.barracks_queue_scroll = offset; }
            // Worker jobs are listed in full; they do not scroll.
            QueueKind.Workers => {}
        }
    }

    /// Moves a queue scrollbar under the pointer; also used while dragging it (`captured`).
    /// Whether one was under it.
    pub fn drag_queue_scrollbar_at(&mut self, cursor: Vec2, screen_size: Vec2, captured: bool) -> bool {
        if self.imgui_ui { return false; }
        let point = to_ui(cursor, screen_size);
        let layout = self.layout(screen_size);
        for k in 0..layout.queue_scrollbars.len() {
            let s = &layout.queue_scrollbars[k];
            if !(captured || contains(s.track_min, s.track_max, point)) { continue; }
            let travel = s.track_max.y - s.track_min.y - s.thumb_height;
            let fraction = if travel > 0.0 { clamp01((s.track_max.y - s.thumb_height / 2.0 - point.y) / travel) } else { 0.0 };
            self.set_queue_scroll(s.kind, (fraction * s.max_offset as f32).round() as i32);
            return true;
        }
        false
    }

    /// Moves a city's building catalog scrollbar under the pointer; also used while dragging it.
    pub fn drag_building_scrollbar_at(&mut self, cursor: Vec2, screen_size: Vec2, captured: bool) -> bool {
        if self.imgui_ui { return false; }
        let point = to_ui(cursor, screen_size);
        let layout = self.layout(screen_size);
        for k in 0..layout.catalogs.len() {
            let c = &layout.catalogs[k];
            if c.max_offset <= 0 || !(captured || contains(c.track_min, c.track_max, point)) { continue; }
            let travel = c.track_max.y - c.track_min.y - c.thumb_height;
            let fraction = if travel > 0.0 { clamp01((c.track_max.y - c.thumb_height / 2.0 - point.y) / travel) } else { 0.0 };
            self.cities[c.city].building_scroll = (fraction * c.max_offset as f32).round() as i32;
            return true;
        }
        false
    }

    /// The wheel over an overflowing queue panel scrolls it: whether it was the panel's.
    pub fn scroll_queue_at(&mut self, cursor: Vec2, screen_size: Vec2, steps: f32) -> bool {
        if self.imgui_ui { return false; }
        let point = to_ui(cursor, screen_size);
        let layout = self.layout(screen_size);
        for k in 0..layout.queue_scrollbars.len() {
            let s = &layout.queue_scrollbars[k];
            if !contains(s.panel_min, s.panel_max, point) { continue; }
            let current = match s.kind { QueueKind.City => self.city_queue_scroll, QueueKind.Barracks => self.barracks_queue_scroll, QueueKind.Workers => 0 };
            let delta = steps.abs().ceil() as i32;
            let moved = if steps > 0.0 { current - delta } else { current + delta };
            let next = if moved < 0 { 0 } else if moved > s.max_offset { s.max_offset } else { moved };
            self.set_queue_scroll(s.kind, next);
            return true;
        }
        false
    }

    /// Captures a queue row's body under the mouse; its X button stays an ordinary click.
    pub fn start_queue_drag_at(&mut self, cursor: Vec2, screen_size: Vec2) -> bool {
        if self.imgui_ui || self.is_resolving() { return false; }
        let point = to_ui(cursor, screen_size);
        let layout = self.layout(screen_size);
        for k in 0..layout.queue_items.len() {
            let row = &layout.queue_items[k];
            if !row.locked && point.x < row.body_max_x && contains(row.min, row.max, point) {
                self.queue_drag = Option.Some(QueueDrag { kind: row.kind, source: row.index, target: Option.Some(row.index) });
                return true;
            }
        }
        false
    }

    /// The row the dragged one is over, if any of its own list.
    pub fn update_queue_drag_at(&mut self, cursor: Vec2, screen_size: Vec2) {
        let Option.Some(drag) = self.queue_drag else { return; };
        let point = to_ui(cursor, screen_size);
        let layout = self.layout(screen_size);
        let mut target: Option[i32] = Option.None;
        for k in 0..layout.queue_items.len() {
            let row = &layout.queue_items[k];
            if row.kind == drag.kind && contains(row.min, row.max, point) { target = Option.Some(row.index); }
        }
        if let Option.Some(d) = self.queue_drag { self.queue_drag = Option.Some(QueueDrag { kind: d.kind, source: d.source, target }); }
    }

    /// Drops the dragged row where it is: onto another it moves there, back onto itself it is a
    /// click.
    pub fn finish_queue_drag_at(&mut self, cursor: Vec2, screen_size: Vec2) {
        self.update_queue_drag_at(cursor, screen_size);
        let Option.Some(drag) = self.queue_drag else { return; };
        self.queue_drag = Option.None;
        let Option.Some(target) = drag.target else { return; };
        if drag.source == target { self.queue_item_clicked(drag.kind, drag.source); } else { self.reorder_queue(drag.kind, drag.source, target); }
    }

    pub fn cancel_queue_drag(&mut self) { self.queue_drag = Option.None; }

    /// A click on queue row `index`, rather than a drag: the camera goes to a worker job's tile
    /// (or edge). City and Barracks rows do nothing.
    pub fn queue_item_clicked(&mut self, kind: QueueKind, index: i32) {
        match kind {
            QueueKind.Workers => {
                let Option.Some(city) = self.worker_list_city() else { return; };
                if index < 0 || index >= self.cities[city].worker_jobs.len() { return; }
                let job = self.cities[city].worker_jobs[index];
                let spot = match job.across { Option.Some(across) => job.hex.to_world().add(across.to_world()).scale(0.5), Option.None => job.hex.to_world() };
                self.camera.focus_on(spot);
                let title = self.job_title(job);
                self.notice = text(fn() can {Out} { Out.put(&title); Out.put(" - WAITING FOR A WORKER"); });
            }
            _ => {}
        }
    }

    /// Moves queue row `source` of `kind` to place `target`.
    pub fn reorder_queue(&mut self, kind: QueueKind, source: i32, target: i32) {
        if source == target { return; }
        let city = match kind {
            QueueKind.Workers => self.worker_list_city(),
            _ => match self.selected_city { Option.Some(c) => Option.Some(c), Option.None => self.selected_barracks },
        };
        let Option.Some(city) = city else { return; };
        match kind {
            QueueKind.City => {
                let n = self.cities[city].queue.len();
                if source >= 0 && source < n && target >= 0 && target < n {
                    let item = self.cities[city].queue.remove(source);
                    self.cities[city].queue.insert(target, item);
                    self.set_notice("CITY QUEUE REORDERED");
                }
            }
            QueueKind.Barracks => {
                let n = self.cities[city].barracks_queue.len();
                if source >= 0 && source < n && target >= 0 && target < n {
                    let item = self.cities[city].barracks_queue.remove(source);
                    self.cities[city].barracks_queue.insert(target, item);
                    self.set_notice("BARRACKS QUEUE REORDERED");
                }
            }
            QueueKind.Workers => {
                let n = self.cities[city].worker_jobs.len();
                if source >= 0 && source < n && target >= 0 && target < n {
                    let job = self.cities[city].worker_jobs.remove(source);
                    self.cities[city].worker_jobs.insert(target, job);
                    self.set_notice("WORKER JOBS REORDERED");
                }
            }
        }
    }

    // ---- the turn strip -----------------------------------------------------------------

    /// The player's units (settlers too) that still need orders, in unit order. None while a
    /// turn plays out or a city interior is open.
    pub fn roster_units(&self) -> Vec[i32] {
        let mut out: Vec[i32] = Vec.new();
        if self.is_resolving() || self.interior_view.is_some() { return out; }
        for i in 0..self.units.len() {
            if self.is_player_controlled(i) && self.needs_orders(i) { out.push(i); }
        }
        out
    }

    fn city_index(&self, id: u32) -> Option[i32] {
        for i in 0..self.cities.len() { if self.cities[i].id == id { return Option.Some(i); } }
        Option.None
    }

    /// Everything the turn strip lists, in its order: cities with nothing to build, then the unit
    /// groups, settlers first, each group where its first unit
    /// comes in unit order. Nothing while a turn plays out or a city interior is open. Each
    /// task's units (a group's; none for a city) come with it.
    pub fn roster_tasks(&self) -> (Vec[RosterKey], Vec[Vec[i32]]) {
        let mut keys: Vec[RosterKey] = Vec.new();
        let mut members: Vec[Vec[i32]] = Vec.new();
        if self.is_resolving() || self.interior_view.is_some() { return (keys, members); }
        for i in 0..self.cities.len() {
            if self.city_needs_build(i) { keys.push(RosterKey.Production(self.cities[i].id)); members.push(Vec.new()); }
        }
        let mut group_keys: Vec[RosterKey] = Vec.new();
        let mut group_units: Vec[Vec[i32]] = Vec.new();
        let units = self.roster_units();
        for k in 0..units.len() {
            let i = units[k];
            let unit = &self.units[i];
            let key = RosterKey.Group(unit.unit_type, self.settlers.contains(unit.id));
            let mut found: i32 = 0 - 1;
            for g in 0..group_keys.len() { if group_keys[g] == key { found = g; } }
            if found >= 0 { group_units[found].push(i); } else { group_keys.push(key); let mut v: Vec[i32] = Vec.new(); v.push(i); group_units.push(v); }
        }
        // Settlers are civilian: they go ahead of the military groups.
        for pass in 0..2 {
            for g in 0..group_keys.len() {
                let settlers = match group_keys[g] { RosterKey.Group(_, s) => s, _ => false };
                if settlers == (pass == 0) { keys.push(group_keys[g]); members.push(copy_ints(&group_units[g])); }
            }
        }
        (keys, members)
    }

    fn chip_for(&self, key: RosterKey, units: &Vec[i32], selection: &Vec[i32]) -> RosterChip {
        let team_color = self.local_team.color();
        match key {
            RosterKey.Production(id) => {
                let open = match self.selected_city { Option.Some(i) => self.cities[i].id == id, Option.None => false };
                RosterChip { key, icon: ChipIcon.City, color: team_color, selected: open, count: 1 }
            }
            RosterKey.Group(_, _) | RosterKey.Unit(_) => {
                let mut selected = false;
                for k in 0..units.len() { if selection.contains(units[k]) { selected = true; } }
                let look = self.unit_look(&self.units[units[0]]);
                RosterChip { key, icon: ChipIcon.Unit(look), color: team_color, selected, count: units.len() }
            }
        }
    }

    /// The units of an open group, when it has several and one of them is selected: the strip's
    /// second row.
    fn open_roster_group(&self, keys: &Vec[RosterKey], members: &Vec[Vec[i32]]) -> Option[(RosterKey, Vec[i32])] {
        let Option.Some(open) = self.roster_open else { return Option.None; };
        let selection = self.selection();
        for t in 0..keys.len() {
            if keys[t] != open { continue; }
            let units = &members[t];
            let mut any = false;
            for k in 0..units.len() { if selection.contains(units[k]) { any = true; } }
            if units.len() > 1 && any { return Option.Some((open, copy_ints(units))); }
        }
        Option.None
    }

    /// The turn strip's content, or `None` when nothing needs seeing to.
    pub fn roster_panel(&self) -> Option[PanelBuilder] {
        let (keys, members) = self.roster_tasks();
        if keys.is_empty() { return Option.None; }
        let selection = self.selection();
        let mut waiting: i32 = 0;
        for t in 0..keys.len() { waiting = waiting + if members[t].len() > 1 { members[t].len() } else { 1 }; }
        let mut panel = panel_builder(false);
        panel.text_owned(TextSize.Small, text(fn() can {Out} { Out.put("NEED ORDERS: "); show_i64(waiting as i64); }), LABEL_TEXT);
        let mut chips: Vec[RosterChip] = Vec.new();
        for t in 0..keys.len() { chips.push(self.chip_for(keys[t], &members[t], &selection)); }
        push_chip_rows(&mut panel, chips);
        if let Option.Some((key, units)) = self.open_roster_group(&keys, &members) {
            let role = match key { RosterKey.Group(_, _) => self.unit_role(&self.units[units[0]]).name(), _ => "" };
            panel.gap(6.0);
            panel.text_owned(TextSize.Small, text(fn() can {Out} { Out.put(role); Out.put(" x"); show_i64(units.len() as i64); }), LABEL_TEXT);
            let mut singles: Vec[RosterChip] = Vec.new();
            for k in 0..units.len() {
                let i = units[k];
                let mut one: Vec[i32] = Vec.new();
                one.push(i);
                singles.push(self.chip_for(RosterKey.Unit(self.units[i].id), &one, &selection));
            }
            push_chip_rows(&mut panel, singles);
        }
        Option.Some(panel)
    }

    /// The indices of the player's units a chip stands for, as they are now.
    fn roster_key_units(&self, key: RosterKey) -> Vec[i32] {
        let mut out: Vec[i32] = Vec.new();
        match key {
            RosterKey.Unit(id) => {
                for i in 0..self.units.len() {
                    if self.units[i].id == id && self.is_player_controlled(i) { out.push(i); }
                }
            }
            RosterKey.Group(_, _) => {
                let (keys, members) = self.roster_tasks();
                for t in 0..keys.len() { if keys[t] == key { out = copy_ints(&members[t]); } }
            }
            _ => {}
        }
        out
    }

    /// A click on a chip: opens its city, or selects its units (a group's all at once, opening
    /// its row) and moves the camera to the first.
    pub fn roster_select(&mut self, key: RosterKey) {
        if self.is_resolving() { return; }
        match key {
            RosterKey.Production(id) => {
                if let Option.Some(city) = self.city_index(id) { self.open_city(city); }
                return;
            }
            _ => {}
        }
        let units = self.roster_key_units(key);
        if units.is_empty() { return; }
        let first = units[0];
        self.leave_city_view();
        if let RosterKey.Group(_, _) = key { self.roster_open = Option.Some(key); }
        self.set_selection(units);
        let at = self.units[first].pos.to_world();
        self.camera.focus_on(at);
    }

    /// Shift-click on a chip: adds its units to the selection.
    pub fn roster_add(&mut self, key: RosterKey) {
        if self.is_resolving() { return; }
        let units = self.roster_key_units(key);
        for k in 0..units.len() { self.add_to_selection(units[k]); }
    }

    /// Ctrl-click on a chip: takes its units out of a selection of several, leaving at least
    /// one selected.
    pub fn roster_remove(&mut self, key: RosterKey) {
        if self.is_resolving() { return; }
        let units = self.roster_key_units(key);
        for k in 0..units.len() {
            if self.selection().len() > 1 { let _removed = self.remove_from_selection(units[k]); }
        }
    }

    /// What hovering a chip says.
    pub fn roster_hint(&self, key: RosterKey) -> Str {
        match key {
            RosterKey.Production(id) => text(fn() can {Out} { Out.put("CITY "); show_u64((id + 1) as u64); Out.put(" HAS NOTHING TO BUILD - CLICK: OPEN IT"); }),
            RosterKey.Group(_, _) => {
                let units = self.roster_key_units(key);
                let role = if units.is_empty() { "" } else { self.unit_role(&self.units[units[0]]).name() };
                text(fn() can {Out} { Out.put(role); Out.put(" x"); show_i64(units.len() as i64); Out.put(" - CLICK: SELECT ALL \u{b7} SHIFT: ADD \u{b7} CTRL: REMOVE"); })
            }
            RosterKey.Unit(id) => {
                let mut role = "";
                for i in 0..self.units.len() { if self.units[i].id == id { role = self.unit_role(&self.units[i]).name(); } }
                text(fn() can {Out} { Out.put(role); Out.put(" - CLICK: SELECT \u{b7} SHIFT: ADD \u{b7} CTRL: REMOVE"); })
            }
        }
    }

    // ---- the settings menu --------------------------------------------------------------

    /// The settings menu's content: the settings under a heading per group, then Close and Quit.
    pub fn settings_panel_content(&self) -> PanelBuilder {
        let mut panel = panel_builder(false);
        panel.text(TextSize.Title, "SETTINGS", TEXT);
        let mut group = "";
        for k in 0..5 {
            let setting = SETTINGS[k];
            let heading = setting.group();
            if !str_eq(heading, group) {
                group = heading;
                panel.gap(GAP);
                panel.heading(group);
            }
            panel.setting(setting, self.settings.get(setting));
        }
        panel.gap(GAP);
        panel.begin_buttons();
        panel.button(Target.CloseSettings, "CLOSE", "ESC", ButtonState.Ready, false);
        panel.button(Target.Quit, "QUIT", "", ButtonState.Ready, false);
        panel.end_buttons(true);
        panel
    }

    // ---- the hover panel ----------------------------------------------------------------

    pub fn structure_hover_panel(&self, i: i32, barracks: bool, panel: &mut PanelBuilder) {
        let city = &self.cities[i];
        let (id, team) = (city.id, city.team);
        let own = team == self.local_team;
        if barracks {
            let Option.Some(_) = city.barracks else { return; };
            let hp = city.barracks_hp;
            panel.text_owned(TextSize.Title, text(fn() can {Out} { Out.put("CITY "); show_u64((id + 1) as u64); Out.put(" BARRACKS"); }), team.color());
            panel.text_owned(TextSize.Small, text(fn() can {Out} { Out.put("HP "); show_f64_fixed(hp as f64, 0); Out.put("/"); show_f64_fixed(BARRACKS_MAX_HP as f64, 0); }), GOLD_TEXT);
            if own {
                let status = self.queue_status(i, Lane.Barracks);
                let line = self.hover_queue_text(self.worked_item(i, Lane.Barracks, &status), city.barracks_queue.is_empty());
                panel.text_owned(TextSize.Small, text(fn() can {Out} { Out.put("QUEUE: "); Out.put(&line); }), DIM_TEXT);
                if let Option.Some((_, _, done)) = self.worked_item(i, Lane.Barracks, &status) { panel.bar(done); }
            }
        } else {
            let population = city.population;
            panel.text_owned(TextSize.Title, text(fn() can {Out} { Out.put("CITY "); show_u64((id + 1) as u64); }), team.color());
            panel.text_owned(TextSize.Small, text(fn() can {Out} { Out.put("POPULATION "); show_i64(population as i64); }), GOLD_TEXT);
            if own {
                let net = self.net_delivery(i);
                panel.begin_line();
                panel.span("DELIVERS ", LABEL_TEXT);
                for k in 0..3 {
                    let icon = text(fn() can {Out} { Out.put_char(resource_icon(RESOURCE_NAMES[k])); show_signed_quantity(net.part(k)); Out.put("  "); });
                    panel.span_owned(icon, TEXT);
                }
                panel.end_line(TextSize.Small);
                let status = self.queue_status(i, Lane.City);
                let line = self.hover_queue_text(self.worked_item(i, Lane.City, &status), city.queue.is_empty());
                panel.text_owned(TextSize.Small, text(fn() can {Out} { Out.put("QUEUE: "); Out.put(&line); }), DIM_TEXT);
                if let Option.Some((_, _, done)) = self.worked_item(i, Lane.City, &status) { panel.bar(done); }
            }
        }
    }

    /// A queue's line in the hover panel: the item worked (`worked_item`) and its turns left, or
    /// why there's none.
    fn hover_queue_text(&self, worked: Option[(str, i32, f32)], empty: bool) -> Str {
        match worked {
            Option.Some((name, turns, _)) => { let clock = turns_icon(turns); text(fn() can {Out} { Out.put(name); Out.put(" \u{b7} "); Out.put(&clock); Out.put(" LEFT"); }) }
            Option.None => if empty { to_owned("EMPTY") } else { to_owned("NOTHING IT CAN PAY FOR") },
        }
    }
}

/// What a queue does this turn (`GameState.queue_status`).
pub struct QueueStatus {
    /// The item its city works, if it can pay for any.
    worked: Option[i32],
    /// The items that wait for the stockpile, with what it's short of for each
    /// (`GameState.waiting_items`).
    waiting: Vec[(i32, Stock)],
    /// The items that wait for supply (`GameState.supply_waiting_items`).
    supply: Vec[i32],
}

impl QueueStatus {
    /// What item `index` waits for, if it waits.
    pub fn waits(&self, index: i32) -> Option[Stock] {
        for k in 0..self.waiting.len() {
            let (waiting, short) = self.waiting[k];
            if waiting == index { return Option.Some(short); }
        }
        Option.None
    }
}

fn clamp01(x: f32) -> f32 { if x < 0.0 { 0.0 } else if x > 1.0 { 1.0 } else { x } }

fn copy_ints(v: &Vec[i32]) -> Vec[i32] {
    let mut out: Vec[i32] = Vec.new();
    for k in 0..v.len() { out.push(v[k]); }
    out
}

fn chip_row(chips: &Vec[RosterChip], from: i32, to: i32) -> Vec[RosterChip] {
    let mut row: Vec[RosterChip] = Vec.new();
    for k in from..to { row.push(chips[k]); }
    row
}

/// Adds `chips` to `panel`, `ROSTER_PER_ROW` to a row.
fn push_chip_rows(panel: &mut PanelBuilder, chips: Vec[RosterChip]) {
    let n = chips.len();
    let mut start = 0;
    while start < n {
        let end = if start + ROSTER_PER_ROW < n { start + ROSTER_PER_ROW } else { n };
        if start > 0 { panel.gap(6.0); }
        panel.roster(chip_row(&chips, start, end));
        start = end;
    }
}
