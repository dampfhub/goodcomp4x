//! The stockpile economy (`docs/rts-economy.md`): each side's one store of food, wood and metal,
//! which every city's delivered goods fill and every build is paid from when its city starts
//! work on it (and refunded to, if it was paid, when it is taken out); which item each queue
//! works, paying for it (`work_queues`), and what it will work as things stand (`forecast`,
//! `waiting_items`); how a tile's production splits into wood and metal; feeding the citizens;
//! and how much work a queue does in a turn. Amounts are in quarters, like the rest of the city
//! code.

use std.core.Eq;
use std.fmt.Out;
use std.fmt.show_i64;
use std.str.Str;
use std.str.eq as str_eq;
use log.Log;
use log.info;
use game.GameState;
use game.text;
use game.city.Build;
use game.city.BuildUnit;
use game.city.amount;
use game.hex.Hex;
use game.map_icons.FOOD_ICON;
use game.map_icons.WOOD_ICON;
use game.map_icons.METAL_ICON;
use game.map_icons.TIME_ICON;
use game.city.SiteKind;
use game.terrain.Special;
use game.unit.Team;
use game.unit.TEAMS;
use game.unit.Unit;

/// Work a queue does in a turn: a build of `turns` turns needs `turns * WORK_PER_TURN`. With
/// production speeding builds (the Debug panel's variant), a city's production adds to it
/// (`work_rate`).
pub const WORK_PER_TURN: i32 = 4;
/// What every side starts with.
pub const STARTING_STOCK: Stock = Stock { food: 40, wood: 40, metal: 16 };
/// Food each citizen eats a turn.
pub const FOOD_PER_CITIZEN: i32 = 8;
/// Growth costs `GROW_BASE + GROW_PER_CITIZEN * population` whole food: 1 to 7 citizens costs
/// 270 food in all. Tempo tuning (#239): option B doubled both from 5 (`docs/rts-economy.md`,
/// Round 7).
const GROW_BASE: i32 = 10;
/// The part of a Grow's price per citizen the city has (`GROW_BASE`).
const GROW_PER_CITIZEN: i32 = 10;

/// An item in a city's or a Barracks' queue: the build, whether its side has paid for it, and the
/// work done on it, in quarter turns. An item is queued unpaid, whatever the stockpile holds, and
/// paid the first economy its city works on it (`GameState.work_queues`); until then it has no
/// work. Its work stays with it when the queue is reordered.
pub struct Queued[B] { build: B, paid: bool, progress: i32 }

impl[B] Queued[B] {
    /// Newly queued: unpaid, with no work done.
    pub fn new(build: B) -> Queued[B] { Queued { build, paid: false, progress: 0 } }

    /// Paid for, with `progress` work done: for tests.
    pub fn worked(build: B, progress: i32) -> Queued[B] { Queued { build, paid: true, progress } }

    /// Already paid for, with no work done: for scenario setup and tests, which skip the price.
    pub fn prepaid(build: B) -> Queued[B] { Queued { build, paid: true, progress: 0 } }

    /// Marks it paid and adds `work`, up to the `needed` it takes.
    pub fn work_on(&mut self, work: i32, needed: i32) {
        self.paid = true;
        let total = self.progress + work;
        self.progress = if total < needed { total } else { needed };
    }
}

impl[B: Eq] Eq for Queued[B] {
    fn eq(self, other: Queued[B]) -> bool { self.build == other.build && self.paid == other.paid && self.progress == other.progress }
}

/// One of a city's two queues.
pub enum Lane { City, Barracks }

impl Eq for Lane {
    fn eq(self, other: Lane) -> bool {
        match (self, other) {
            (Lane.City, Lane.City) | (Lane.Barracks, Lane.Barracks) => true,
            _ => false,
        }
    }
}

/// What one queue will work this turn, as things stand (`GameState.forecast`).
pub struct LaneForecast {
    city: i32,
    lane: Lane,
    /// The item it works: the first paid for, or the first the stockpile can pay for when this
    /// queue's turn comes. None if it can pay for none.
    worked: Option[i32],
    /// What the stockpile holds when this queue's turn to pay comes.
    stock: Stock,
    /// The supply its side may still start items with then (`supply_room`).
    supply: i64,
}

/// Every queue of a side, as `GameState.forecast` sees this turn going.
pub struct QueueForecast {
    lanes: Vec[LaneForecast],
    /// What the stockpile keeps once every queue has paid for what it starts: what the side can
    /// still spend this turn.
    spare: Stock,
}

impl QueueForecast {
    pub fn lane(&self, city: i32, lane: Lane) -> Option[LaneForecast] {
        for k in 0..self.lanes.len() {
            if self.lanes[k].city == city && self.lanes[k].lane == lane { return Option.Some(self.lanes[k]); }
        }
        Option.None
    }
}

/// Food, wood and metal, in quarters: a side's stockpile, a price or an income.
pub struct Stock { food: i32, wood: i32, metal: i32 }

impl Eq for Stock {
    fn eq(self, other: Stock) -> bool { self.food == other.food && self.wood == other.wood && self.metal == other.metal }
}

/// Nothing: the empty stock.
pub fn no_stock() -> Stock { Stock { food: 0, wood: 0, metal: 0 } }

impl Stock {
    /// From whole units.
    pub fn whole(food: i32, wood: i32, metal: i32) -> Stock { Stock { food: food * 4, wood: wood * 4, metal: metal * 4 } }

    pub fn covers(self, price: Stock) -> bool { self.food >= price.food && self.wood >= price.wood && self.metal >= price.metal }

    /// How much more of each it takes to pay `price`.
    pub fn shortfall(self, price: Stock) -> Stock {
        Stock {
            food: if price.food > self.food { price.food - self.food } else { 0 },
            wood: if price.wood > self.wood { price.wood - self.wood } else { 0 },
            metal: if price.metal > self.metal { price.metal - self.metal } else { 0 },
        }
    }

    /// Wood and metal together: a city's production, for the variant where production speeds
    /// builds.
    pub fn production(self) -> i32 { self.wood + self.metal }

    pub fn plus(self, other: Stock) -> Stock { Stock { food: self.food + other.food, wood: self.wood + other.wood, metal: self.metal + other.metal } }

    pub fn minus(self, other: Stock) -> Stock { Stock { food: self.food - other.food, wood: self.wood - other.wood, metal: self.metal - other.metal } }

    /// The amount of the resource named `name` (FOOD, WOOD or METAL).
    pub fn part(self, index: i32) -> i32 { if index == 0 { self.food } else if index == 1 { self.wood } else { self.metal } }

    pub fn is_empty(self) -> bool { self.food == 0 && self.wood == 0 && self.metal == 0 }
}

/// The names of `Stock.part`'s resources, in display order.
pub const RESOURCE_NAMES: [str; 3] = ["FOOD", "WOOD", "METAL"];

/// Growing a city of `population` by one citizen.
pub fn grow_price(population: i32) -> Stock { Stock.whole(GROW_BASE + GROW_PER_CITIZEN * population, 0, 0) }

/// "3 WOOD AND 1 METAL": the nonzero parts of `stock`, in whole units.
pub fn stock_words(stock: Stock) -> Str {
    let mut names: Vec[i32] = Vec.new();
    for k in 0..3 { if stock.part(k) > 0 { names.push(k); } }
    text(fn() can {Out} {
        if names.is_empty() { Out.put("NOTHING"); return; }
        for k in 0..names.len() {
            if k > 0 {
                Out.put(if k + 1 == names.len() { " AND " } else { ", " });
            }
            let at = names[k];
            let shown = amount(stock.part(at));
            Out.put(&shown); Out.put(" "); Out.put(RESOURCE_NAMES[at]);
        }
    })
}

/// The icon character (`map_icons`) that stands in UI text for each of `Stock.part`'s names.
pub fn resource_icon(name: str) -> char {
    if str_eq(name, "FOOD") { FOOD_ICON } else if str_eq(name, "WOOD") { WOOD_ICON } else { METAL_ICON }
}

/// The nonzero parts of `stock` for UI text, each its icon and whole amount: "2 6" with the icon
/// characters. Empty for nothing.
pub fn stock_icons(stock: Stock) -> Str {
    text(fn() can {Out} {
        let mut first = true;
        for k in 0..3 {
            if stock.part(k) <= 0 { continue; }
            if !first { Out.put(" "); }
            first = false;
            let shown = amount(stock.part(k));
            Out.put_char(resource_icon(RESOURCE_NAMES[k])); Out.put(&shown);
        }
    })
}

/// A number of turns for UI text: the clock icon and the number.
pub fn turns_icon(turns: i32) -> Str { text(fn() can {Out} { Out.put_char(TIME_ICON); show_i64(turns as i64); }) }

impl GameState {
    /// `team`'s stockpile.
    pub fn stock(&self, team: Team) -> Stock { self.stockpiles[team.index()] }

    pub fn set_stock(&mut self, team: Team, stock: Stock) { self.stockpiles[team.index()] = stock; }

    /// Adds `more` to `team`'s stockpile.
    pub fn add_stock(&mut self, team: Team, more: Stock) { self.stockpiles[team.index()] = self.stockpiles[team.index()].plus(more); }

    /// Takes `less` from `team`'s stockpile.
    pub fn take_stock(&mut self, team: Team, less: Stock) { self.stockpiles[team.index()] = self.stockpiles[team.index()].minus(less); }

    /// How much of a worked tile's `production` is metal: what hills (1), a mine (2) and a Quarry
    /// (3) dig out of the ground. The rest is wood.
    pub fn metal_yield(&self, hex: Hex, production: i32) -> i32 {
        let hills = if self.grid.tile(hex).hills { 1 } else { 0 };
        let mine = match self.sites.get(hex) { Option.Some(s) => if s.kind == SiteKind.Mine { 2 } else { 0 }, Option.None => 0 };
        let quarry = if self.grid.special(hex) == Option.Some(Special.Quarry) { 3 } else { 0 };
        let metal = hills + mine + quarry;
        if metal < production { metal } else { production }
    }

    /// How many of `city`'s queued Grows are paid for.
    pub fn paid_grows(&self, city: i32) -> i32 {
        let mut n = 0;
        for k in 0..self.cities[city].queue.len() {
            let q = self.cities[city].queue[k];
            if q.paid && q.build == Build.Grow { n = n + 1; }
        }
        n
    }

    /// What `build` queued at the end of `city`'s queue will cost when its turn comes: a Grow is
    /// priced when it's paid, at the population then, so each Grow queued ahead of it (done by
    /// then) adds a citizen.
    pub fn queue_price(&self, city: i32, build: Build) -> Stock {
        let c = &self.cities[city];
        match build {
            Build.Grow => {
                let mut queued = 0;
                for k in 0..c.queue.len() { if c.queue[k].build == Build.Grow { queued = queued + 1; } }
                grow_price(c.population + queued)
            }
            _ => build.price(),
        }
    }

    /// What paying for unpaid item `index` of one of `city`'s queues costs now: its price, and
    /// for a Grow the population's price plus a citizen for each Grow already paid for
    /// (`paid_grows`), whose citizens are coming.
    pub fn item_price(&self, city: i32, lane: Lane, index: i32) -> Stock {
        let c = &self.cities[city];
        match lane {
            Lane.City => match c.queue[index].build {
                Build.Grow => grow_price(c.population + self.paid_grows(city)),
                build => build.price(),
            },
            Lane.Barracks => c.barracks_queue[index].build.price(),
        }
    }

    /// How many items one of `city`'s queues holds.
    pub fn lane_len(&self, city: i32, lane: Lane) -> i32 {
        match lane { Lane.City => self.cities[city].queue.len(), Lane.Barracks => self.cities[city].barracks_queue.len() }
    }

    /// Item `index` of one of `city`'s queues: whether it's paid, the work done on it and the work
    /// it needs there.
    pub fn lane_item(&self, city: i32, lane: Lane, index: i32) -> (bool, i32, i32) {
        let c = &self.cities[city];
        match lane {
            Lane.City => {
                let q = c.queue[index];
                (q.paid, q.progress, self.city_build_work(city, q.build))
            }
            Lane.Barracks => {
                let q = c.barracks_queue[index];
                (q.paid, q.progress, q.build.work())
            }
        }
    }

    /// What taking item `index` out of `city`'s queue refunds: nothing if it's unpaid; else its
    /// price, or for a Grow the dearest paid Grow's, since each paid Grow was priced a citizen
    /// above the one paid before.
    fn refund(&self, city: i32, index: i32) -> Stock {
        let c = &self.cities[city];
        let item = c.queue[index];
        if !item.paid { return no_stock(); }
        match item.build {
            Build.Grow => grow_price(c.population + self.paid_grows(city) - 1),
            build => build.price(),
        }
    }

    /// Tests: a stockpile and supply (`supply.tua`) big enough for anything a test queues. A test
    /// of the supply limit sets `extra_supply` back to 0.
    pub fn fund(&mut self, team: Team) {
        self.set_stock(team, Stock.whole(999, 999, 999));
        self.extra_supply[team.index()] = 999;
    }

    /// Adds `build` to the end of `city`'s queue, unpaid, whatever the stockpile holds: it's paid
    /// when the city starts work on it (`work_queues`).
    pub fn queue_build(&mut self, city: i32, build: Build) { self.cities[city].queue.push(Queued.new(build)); }

    /// Takes the item at `index` out of `city`'s queue, refunding its price if it was paid
    /// (`refund`); its work goes with it.
    pub fn take_queue_item(&mut self, city: i32, index: i32) -> Build {
        let price = self.refund(city, index);
        let team = self.cities[city].team;
        self.add_stock(team, price);
        self.cities[city].queue.remove(index).build
    }

    /// Like `queue_build`, for the Barracks' queue.
    pub fn queue_barracks(&mut self, city: i32, build: BuildUnit) { self.cities[city].barracks_queue.push(Queued.new(build)); }

    /// Like `take_queue_item`, for the Barracks' queue.
    pub fn take_barracks_item(&mut self, city: i32, index: i32) -> BuildUnit {
        let team = self.cities[city].team;
        let removed = self.cities[city].barracks_queue.remove(index);
        if removed.paid { self.add_stock(team, removed.build.price()); }
        removed.build
    }

    /// Which item of one of `city`'s queues it works with `stock` in the stockpile and `supply`
    /// left to start items with (`supply_room`): the first that's paid for, or that `stock` can
    /// pay for and `supply` has room for, with its price if it's still to be paid. Items before
    /// it wait, and so does a Settler in a city short of citizens (`waits_for_citizens`), paid or
    /// not.
    pub fn pick_item(&self, city: i32, lane: Lane, stock: Stock, supply: i64) -> Option[(i32, Option[Stock])] {
        for index in 0..self.lane_len(city, lane) {
            if lane == Lane.City && self.waits_for_citizens(city, index) { continue; }
            let (paid, _, _) = self.lane_item(city, lane, index);
            if paid { return Option.Some((index, Option.None)); }
            let price = self.item_price(city, lane, index);
            if stock.covers(price) && self.supply_fits(city, lane, index, supply) { return Option.Some((index, Option.Some(price))); }
        }
        Option.None
    }

    /// Whether `supply` left to start items with has room for item `index` of one of `city`'s
    /// queues: always, for one that uses none.
    pub fn supply_fits(&self, city: i32, lane: Lane, index: i32, supply: i64) -> bool {
        let needs = self.item_supply(city, lane, index);
        needs == 0 || (needs as i64) <= supply
    }

    /// The turn's work on every queue, after income and upkeep. City by city in order, each
    /// city's queue before its Barracks', a queue works the item `pick_item` picks: pays for it
    /// if it's unpaid, and adds its city's work for the turn (`rates`, the city's and the
    /// Barracks'), up to what it needs. Items it can't pay for, or that its side's supply has no
    /// room for (`supply_room`), wait in place, unpaid.
    pub fn work_queues(&mut self, rates: &Vec[(i32, i32)]) {
        let mut supply: Vec[i64] = Vec.new();
        for k in 0..7 { supply.push(self.supply_room(TEAMS[k])); }
        for city in 0..rates.len() {
            let (city_rate, barracks_rate) = rates[city];
            for l in 0..2 {
                let lane = if l == 0 { Lane.City } else { Lane.Barracks };
                let rate = if l == 0 { city_rate } else { barracks_rate };
                let team = self.cities[city].team;
                let room = supply[team.index()];
                let pick = self.pick_item(city, lane, self.stock(team), room);
                if let Option.Some((index, price)) = pick {
                    if price.is_some() { supply[team.index()] = supply[team.index()] - (self.item_supply(city, lane, index) as i64); }
                    self.work_item(city, lane, index, price, rate);
                }
            }
        }
    }

    /// Pays `price` for item `index` of one of `city`'s queues, if it's due, and adds `work` to the
    /// item, up to what it needs.
    pub fn work_item(&mut self, city: i32, lane: Lane, index: i32, price: Option[Stock], work: i32) {
        let team = self.cities[city].team;
        if let Option.Some(p) = price { self.take_stock(team, p); }
        let (_, _, needed) = self.lane_item(city, lane, index);
        match lane {
            Lane.City => { self.cities[city].queue[index].work_on(work, needed); }
            Lane.Barracks => { self.cities[city].barracks_queue[index].work_on(work, needed); }
        }
        // Training that starts past the side's supply, counted from scratch here, apart from the
        // room `work_queues` keeps; the simulation checks there is none.
        if price.is_some() && self.item_supply(city, lane, index) > 0 {
            let (started, cap) = (self.supply_started(team), self.supply_cap(team));
            if started > cap {
                let id = self.cities[city].id;
                self.supply_overruns.push(text(fn() can {Out} {
                    team.show(); Out.put(" started an item in city "); show_i64((id + 1) as i64); Out.put(" past its supply: ");
                    show_i64(started as i64); Out.put("/"); show_i64(cap as i64);
                }));
            }
        }
    }

    /// What `team`'s stockpile will hold when this turn's economy reaches its queues, as things
    /// stand: this turn's income in and its citizens fed (a side that can't feed them all has no
    /// food left).
    pub fn expected_stock(&self, team: Team) -> Stock {
        let mut stock = self.stock(team).plus(self.side_income(team));
        let left = stock.food - self.upkeep(team);
        stock.food = if left > 0 { left } else { 0 };
        stock
    }

    /// Which item each of `team`'s queues will work this turn, as things stand: `work_queues`'
    /// choices played out on `expected_stock`, changing nothing.
    pub fn forecast(&self, team: Team) -> QueueForecast {
        let mut stock = self.expected_stock(team);
        let mut supply = self.supply_room(team);
        let mut lanes: Vec[LaneForecast] = Vec.new();
        for city in 0..self.cities.len() {
            if self.cities[city].team != team { continue; }
            for l in 0..2 {
                let lane = if l == 0 { Lane.City } else { Lane.Barracks };
                let pick = self.pick_item(city, lane, stock, supply);
                let worked = match pick { Option.Some((index, _)) => Option.Some(index), Option.None => Option.None };
                lanes.push(LaneForecast { city, lane, worked, stock, supply });
                if let Option.Some((index, Option.Some(price))) = pick {
                    stock = stock.minus(price);
                    supply = supply - (self.item_supply(city, lane, index) as i64);
                }
            }
        }
        QueueForecast { lanes, spare: stock }
    }

    /// The items of a queue that wait for the stockpile, each with what the stockpile is short of
    /// for it: the unpaid ones ahead of the item it works, or all of them when it can pay for
    /// none. A Settler that waits for citizens (`waits_for_citizens`) isn't one of them, and nor
    /// is an item that waits for supply (`supply_waiting_items`).
    pub fn waiting_items(&self, lane: LaneForecast) -> Vec[(i32, Stock)] {
        let supply = self.supply_waiting_items(lane);
        let ahead = self.unpaid_ahead(lane);
        let mut out: Vec[(i32, Stock)] = Vec.new();
        for k in 0..ahead.len() {
            let index = ahead[k];
            if lane.lane == Lane.City && self.waits_for_citizens(lane.city, index) { continue; }
            if supply.contains(index) { continue; }
            let price = self.item_price(lane.city, lane.lane, index);
            out.push((index, lane.stock.shortfall(price)));
        }
        out
    }

    /// The items of a queue that wait for supply: the unpaid ones ahead of the item it works (or
    /// all, if it works none) that its side's supply has no room to start (`supply_room`),
    /// whatever the stockpile holds.
    pub fn supply_waiting_items(&self, lane: LaneForecast) -> Vec[i32] {
        let ahead = self.unpaid_ahead(lane);
        let mut out: Vec[i32] = Vec.new();
        for k in 0..ahead.len() {
            if !self.supply_fits(lane.city, lane.lane, ahead[k], lane.supply) { out.push(ahead[k]); }
        }
        out
    }

    /// The unpaid items of a queue ahead of the one it works, or all of them when it works none.
    fn unpaid_ahead(&self, lane: LaneForecast) -> Vec[i32] {
        let end = match lane.worked { Option.Some(w) => w, Option.None => self.lane_len(lane.city, lane.lane) };
        let mut out: Vec[i32] = Vec.new();
        for index in 0..end {
            let (paid, _, _) = self.lane_item(lane.city, lane.lane, index);
            if !paid { out.push(index); }
        }
        out
    }

    /// What `city` waits for, if the first item of either of its queues waits for the stockpile
    /// (`waiting_items`): for each resource, the most either is short of it.
    pub fn city_waits_for(&self, forecast: &QueueForecast, city: i32) -> Option[Stock] {
        let mut result: Option[Stock] = Option.None;
        for l in 0..2 {
            let lane = if l == 0 { Lane.City } else { Lane.Barracks };
            let Option.Some(f) = forecast.lane(city, lane) else { continue; };
            let waiting = self.waiting_items(f);
            if waiting.is_empty() { continue; }
            let (index, short) = waiting[0];
            if index != 0 { continue; }
            result = match result {
                Option.None => Option.Some(short),
                Option.Some(a) => Option.Some(Stock {
                    food: if a.food > short.food { a.food } else { short.food },
                    wood: if a.wood > short.wood { a.wood } else { short.wood },
                    metal: if a.metal > short.metal { a.metal } else { short.metal },
                }),
            };
        }
        result
    }

    /// Debug panel: switches between fixed build times and production speeding builds
    /// (`work_rate`).
    pub fn toggle_production_speedup(&mut self) {
        if self.refuses_debug() { return; }
        self.production_speedup = !self.production_speedup;
        self.set_notice(if self.production_speedup { "PRODUCTION NOW SPEEDS BUILDS" } else { "BUILDS NOW TAKE THEIR FIXED TIME" });
    }

    /// Work a queue does this turn: `WORK_PER_TURN`, plus, with production speeding builds, a
    /// quarter turn per whole point of `production` (in quarters).
    pub fn work_rate(&self, production: i32) -> i32 {
        if self.production_speedup { WORK_PER_TURN + (if production > 0 { production } else { 0 }) / 4 } else { WORK_PER_TURN }
    }

    /// Turns until item `index` of one of `city`'s queues is done at this turn's rate, from the
    /// work it has.
    pub fn item_turns_left(&self, city: i32, lane: Lane, index: i32) -> i32 {
        let (_, progress, work) = self.lane_item(city, lane, index);
        let rate = match lane {
            Lane.City => self.work_rate(self.income(city).production()),
            Lane.Barracks => self.work_rate(self.barracks_income(city)),
        };
        let left = if work > progress { work - progress } else { 0 };
        (left + rate - 1) / rate
    }

    /// Every side's citizens eat from its stockpile. A side that can't feed them all has its
    /// stockpile's food emptied, and its largest city (the first, on ties) loses a citizen
    /// (`remove_citizen`), never going below one.
    pub fn feed_citizens(&mut self) can {Log} {
        for t in 0..7 {
            let team = TEAMS[t];
            let upkeep = self.upkeep(team);
            let stock = self.stock(team);
            if stock.food >= upkeep {
                self.set_stock(team, Stock { food: stock.food - upkeep, wood: stock.wood, metal: stock.metal });
                continue;
            }
            self.set_stock(team, Stock { food: 0, wood: stock.wood, metal: stock.metal });
            let mut largest: Option[i32] = Option.None;
            for i in 0..self.cities.len() {
                let c = &self.cities[i];
                if c.team != team || c.population <= 1 { continue; }
                let better = match largest { Option.None => true, Option.Some(b) => c.population > self.cities[b].population };
                if better { largest = Option.Some(i); }
            }
            if let Option.Some(city) = largest {
                if self.remove_citizen(city) {
                    let id = self.cities[city].id;
                    info(fn() can {Out} { team.show(); Out.put(" city "); show_i64((id + 1) as i64); Out.put(" starves"); });
                    if team == self.local_team {
                        self.notice = text(fn() can {Out} { Out.put("CITY "); show_i64((id + 1) as i64); Out.put(" STARVES - NOT ENOUGH FOOD FOR EVERY CITIZEN"); });
                    }
                }
            }
        }
    }

    /// The food all of `team`'s citizens eat a turn.
    pub fn upkeep(&self, team: Team) -> i32 {
        let mut total = 0;
        for i in 0..self.cities.len() { if self.cities[i].team == team { total = total + self.cities[i].population * FOOD_PER_CITIZEN; } }
        total
    }

    /// `team`'s income a turn from all its cities, before upkeep.
    pub fn side_income(&self, team: Team) -> Stock {
        let mut sum = no_stock();
        for i in 0..self.cities.len() { if self.cities[i].team == team { sum = sum.plus(self.income(i)); } }
        sum
    }
}
