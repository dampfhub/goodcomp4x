//! Citizens: the priority order, tile assignment (up to `MAX_MANAGERS` clusters of a manager and
//! its workers), losing a citizen, and the end-of-turn economy tick.

use std.collections.Set;
use std.fmt.Out;
use log.Log;
use game.GameState;
use game.text;
use game.city.Building;
use game.city.Cluster;
use game.city.FOOD_PER_CITIZEN;
use game.city.Good;
use game.city.PLACEABLE;
use game.city.Priorities;
use game.city.Routes;
use game.city.WORKERS_PER_MANAGER;
use game.city.cluster_tiles;
use game.city.delivered_share;
use game.city.Stock;
use game.hex.Hex;
use game.scenario.copy_vec;
use game.unit.Team;
use std.math.min;

/// Food a city's tiles bring in past its citizens' upkeep before it's fed and follows its
/// priority order (the food floor): one whole food.
const FOOD_FLOOR_MARGIN: i32 = 4;
/// The city center's own food, which counts toward the food floor (as does a Cannery's,
/// `unworked_food`).
const CENTER_FOOD: i32 = 8;

/// A tile a citizen might take, with its delivered food, wood and metal.
struct Candidate { hex: Hex, goods: (i32, i32, i32) }

/// Trims `clusters` to `capacity` citizens and `allowed` managers: the last cluster's last worker
/// goes first, and a manager only once its cluster has no workers left.
pub fn trim_clusters(clusters: &mut Vec[Cluster], capacity: i32, allowed: i32) {
    loop {
        let mut total = 0;
        for k in 0..clusters.len() { total = total + clusters[k].citizens(); }
        if total <= capacity && clusters.len() <= allowed { break; }
        if clusters.is_empty() { break; }
        let last = clusters.len() - 1;
        if !clusters[last].pop_worker() { let _gone = clusters.pop(); }
    }
}

impl GameState {
    /// The open city's priority order changes (a chip dragged, or clicked to put first): its
    /// citizens are reassigned by it.
    pub fn set_selected_city_priorities(&mut self, priorities: Priorities) {
        if self.is_resolving() || !priorities.is_order() { return; }
        if let Option.Some(city) = self.selected_city {
            self.cities[city].priorities = priorities;
            self.auto_assign_city(city);
            let order = priorities.text();
            self.notice = text(fn() can {Out} { Out.put("CITY PRIORITIES: "); Out.put(&order); });
        }
    }

    /// A priority chip clicked: its good goes first in the open city's order.
    pub fn prioritize_selected_city(&mut self, good: Good) {
        if let Option.Some(city) = self.selected_city {
            let priorities = self.cities[city].priorities.with_first(good);
            self.set_selected_city_priorities(priorities);
        }
    }

    /// A tile's food, wood and metal as delivered to `city`, along a route of `cost`.
    pub fn delivered_goods(&self, city: i32, hex: Hex, cost: i32) -> (i32, i32, i32) {
        let (food, wood, metal) = self.tile_goods(hex);
        let share = delivered_share(cost);
        (food * self.mill_food_share(city, hex, cost), wood * share, metal * share)
    }

    /// Whether `food` (the center's, its Cannery's and its worked tiles', delivered) feeds
    /// `city`: its citizens' upkeep and one more (the food floor).
    pub fn is_fed(&self, city: i32, food: i32) -> bool { food >= self.cities[city].population * FOOD_PER_CITIZEN + FOOD_FLOOR_MARGIN }

    /// The food `city` gets that none of its citizens work for, which counts toward the food
    /// floor as its income does: its center's, and what its Cannery collects from sites no
    /// citizen works (as they stand now).
    fn unworked_food(&self, city: i32) -> i32 { CENTER_FOOD + self.cannery_income(city) }

    /// The food `city`'s worked tiles deliver.
    fn worked_food(&self, city: i32, routes: &Routes) -> i32 {
        let worked = self.cities[city].worked_tiles();
        let mut total = 0;
        for k in 0..worked.len() {
            if let Option.Some(cost) = routes.costs.get(worked[k]) { let (food, _, _) = self.delivered_goods(city, worked[k], cost); total = total + food; }
        }
        total
    }

    /// Whether a city center or a placed building (any side's) stands on `hex`. No citizen works
    /// such a tile: a city center yields on its own, and a building covers the ground.
    pub fn closed_to_citizens(&self, hex: Hex) -> bool {
        for i in 0..self.cities.len() {
            if self.cities[i].pos == hex { return true; }
            for k in 0..14 { if self.cities[i].placed_site(PLACEABLE[k]) == Option.Some(hex) { return true; } }
        }
        false
    }

    /// Whether `city`'s citizens may take `hex` at all: no city center or building on it, no
    /// citizen of any city working it, and no other side's site.
    pub fn is_open(&self, city: i32, hex: Hex) -> bool {
        if self.closed_to_citizens(hex) { return false; }
        for i in 0..self.cities.len() { if self.cities[i].works(hex) { return false; } }
        self.own_or_no_site(city, hex)
    }

    /// Whether any site on `hex` belongs to city `city`'s team.
    fn own_or_no_site(&self, city: i32, hex: Hex) -> bool {
        match self.sites.get(hex) { Option.Some(s) => s.team == self.cities[city].team, Option.None => true }
    }

    /// The first of `city`'s clusters with room for a worker on `hex`: its manager beside it, and
    /// fewer than `WORKERS_PER_MANAGER` workers.
    pub fn cluster_with_room(&self, city: i32, hex: Hex) -> Option[i32] {
        let clusters = &self.cities[city].clusters;
        for k in 0..clusters.len() {
            if clusters[k].count < WORKERS_PER_MANAGER && clusters[k].manager.distance(hex) == 1 { return Option.Some(k); }
        }
        Option.None
    }

    /// Whether `hex` could take a new manager of `city`, as far as its other managers go: on
    /// land, and beside none of them (`except`, the cluster whose manager is moving, aside).
    pub fn clear_of_managers(&self, city: i32, hex: Hex, except: Option[i32]) -> bool {
        if self.grid.terrain(hex).is_water() { return false; }
        let clusters = &self.cities[city].clusters;
        for k in 0..clusters.len() {
            if except == Option.Some(k) { continue; }
            if clusters[k].manager.distance(hex) <= 1 { return false; }
        }
        true
    }

    /// Whether a citizen can be assigned to `hex`: it's open, and either a manager with room is
    /// beside it, or the city may start a cluster there (it has fewer managers than its
    /// population allows, and `hex` is land clear of its other managers). A click assigns by the
    /// same rules (`city_click`), each with its own notice.
    pub fn may_assign(&self, city: i32, hex: Hex) -> bool {
        let c = &self.cities[city];
        self.is_open(city, hex)
            && (self.cluster_with_room(city, hex).is_some() || (c.clusters.len() < c.managers_allowed() && self.clear_of_managers(city, hex, Option.None)))
    }

    /// Whether cluster `cluster`'s manager can move to `hex`: land in the city's reach that no
    /// building, other city or other of its clusters takes, beside none of its other managers.
    pub fn may_be_manager(&self, city: i32, cluster: i32, hex: Hex) -> bool {
        let c = &self.cities[city];
        if self.closed_to_citizens(hex) { return false; }
        for i in 0..self.cities.len() { if i != city && self.cities[i].works(hex) { return false; } }
        let other = match c.cluster_of(hex) { Option.Some(k) => k == cluster, Option.None => true };
        other && self.own_or_no_site(city, hex) && self.clear_of_managers(city, hex, Option.Some(cluster)) && self.routes(city).costs.has(hex)
    }

    /// Every tile the other clusters (all of them, but cluster `cluster` of city `city`) work.
    fn claimed_elsewhere(&self, city: i32, cluster: i32) -> Set[Hex] {
        let mut claims: Set[Hex] = Set.new();
        for i in 0..self.cities.len() {
            for k in 0..self.cities[i].clusters.len() {
                if i == city && k == cluster { continue; }
                let tiles = self.cities[i].clusters[k].tiles();
                for t in 0..tiles.len() { let _new = claims.insert(tiles[t]); }
            }
        }
        claims
    }

    /// Relocates cluster `cluster`'s manager and carries each of its workers' axial offsets with
    /// it; the other clusters stay. Workers whose matching tile is unavailable are filled by
    /// normal auto-assignment.
    pub fn move_manager(&mut self, city: i32, cluster: i32, new_manager: Hex) {
        let old = self.cities[city].clusters[cluster];
        let routes = self.routes(city);
        let claims = self.claimed_elsewhere(city, cluster);
        let mut relocated = Cluster.new(new_manager);
        let workers = old.workers();
        for k in 0..workers.len() {
            let worker = workers[k];
            let target = Hex.new(new_manager.q + worker.q - old.manager.q, new_manager.r + worker.r - old.manager.r);
            let legal = routes.costs.has(target) && !claims.contains(target) && !self.closed_to_citizens(target) && self.own_or_no_site(city, target);
            if legal && target != new_manager && !relocated.has_worker(target) { relocated.add_worker(target); }
        }
        self.cities[city].clusters[cluster] = relocated;
        self.cities[city].remembered = copy_vec(&self.cities[city].clusters);
        self.reconcile_citizens(city);
        self.set_notice("MANAGER MOVED - WORKERS FOLLOWED WHERE POSSIBLE");
    }

    /// Assigns the city's citizens afresh (`fill_citizens`).
    pub fn auto_assign_city(&mut self, city: i32) {
        self.cities[city].clusters.clear();
        let routes = self.routes(city);
        self.fill_citizens(city, &routes);
        self.cities[city].remembered = copy_vec(&self.cities[city].clusters);
    }

    /// The tiles `routes` reaches that `city`'s citizens may take, with their delivered goods.
    fn open_candidates(&self, city: i32, routes: &Routes) -> Vec[Candidate] {
        let mut tiles: Vec[Candidate] = Vec.new();
        for k in 0..routes.costs.len() {
            let Option.Some(hex) = routes.costs.key_at(k) else { continue; };
            let Option.Some(cost) = routes.costs.val_at(k) else { continue; };
            if self.is_open(city, hex) { tiles.push(Candidate { hex, goods: self.delivered_goods(city, hex, cost) }); }
        }
        tiles
    }

    /// Fills `city`'s open slots one citizen at a time, each on the open tile worth the most by
    /// its priority order (`Priorities.score`, food first until the city is fed; ties go by hex
    /// coordinates): a worker, beside a manager with room (the first such cluster takes it), or,
    /// once no manager has room or an open tile beside it, a new manager, on land clear of its
    /// other managers, while its population allows another.
    fn fill_citizens(&mut self, city: i32, routes: &Routes) {
        let mut tiles = self.open_candidates(city, routes);
        let mut tile_food = self.worked_food(city, routes);
        while self.cities[city].working() < self.cities[city].capacity() {
            // Anew each time: a tile taken may be one its Cannery collected.
            let food = self.unworked_food(city) + tile_food;
            let mut as_manager = false;
            let mut pick = self.best_tile(city, &tiles, food, false);
            if pick.is_none() && self.cities[city].clusters.len() < self.cities[city].managers_allowed() {
                pick = self.best_tile(city, &tiles, food, true);
                as_manager = true;
            }
            let Option.Some(at) = pick else { break; };
            let taken = tiles.remove(at);
            let (f, _, _) = taken.goods;
            if as_manager {
                self.cities[city].clusters.push(Cluster.new(taken.hex));
            } else if let Option.Some(k) = self.cluster_with_room(city, taken.hex) {
                self.cities[city].clusters[k].add_worker(taken.hex);
            }
            tile_food = tile_food + f;
        }
    }

    /// Of `tiles` that the role lets it take (a worker beside a manager with room, or with
    /// `as_manager` a manager on land clear of the others), the one `city`'s next citizen takes:
    /// the most by its priority order, food first while `food` doesn't feed it, ties by hex
    /// coordinates.
    fn best_tile(&self, city: i32, tiles: &Vec[Candidate], food: i32, as_manager: bool) -> Option[i32] {
        let priorities = self.cities[city].priorities;
        let fed = self.is_fed(city, food);
        let mut best: Option[i32] = Option.None;
        let mut best_score = 0;
        for i in 0..tiles.len() {
            let allowed = if as_manager { self.clear_of_managers(city, tiles[i].hex, Option.None) } else { self.cluster_with_room(city, tiles[i].hex).is_some() };
            if !allowed { continue; }
            let score = priorities.score(tiles[i].goods, fed);
            let better = match best {
                Option.None => true,
                Option.Some(b) => {
                    let (h, bh) = (tiles[i].hex, tiles[b].hex);
                    score > best_score || (score == best_score && (h.q < bh.q || (h.q == bh.q && h.r < bh.r)))
                }
            };
            if better { best = Option.Some(i); best_score = score; }
        }
        best
    }

    /// Works the city's clusters out again from what was last assigned (`City.remembered`), then
    /// fills what's left open (`fill_citizens`). A remembered tile the city can't keep (out of
    /// reach, or another city's, a city center or a building now) is skipped until it can; a
    /// cluster whose manager can't be kept is run meanwhile by the first of its workers that
    /// could manage, until the manager's tile is back. Clusters past what the population allows
    /// go, last first (`trim_clusters`).
    pub fn reconcile_citizens(&mut self, city: i32) {
        let routes = self.routes(city);
        let team = self.cities[city].team;
        let mut others: Set[Hex] = Set.new();
        for i in 0..self.cities.len() {
            if i == city { continue; }
            let tiles = self.cities[i].worked_tiles();
            for k in 0..tiles.len() { let _new = others.insert(tiles[k]); }
        }
        let mut clusters: Vec[Cluster] = Vec.new();
        let plans = copy_vec(&self.cities[city].remembered);
        for p in 0..plans.len() {
            let plan = plans[p];
            let taken = cluster_tiles(&clusters);
            let plan_tiles = plan.tiles();
            let mut manager: Option[Hex] = Option.None;
            for t in 0..plan_tiles.len() {
                let h = plan_tiles[t];
                if manager.is_some() { continue; }
                let mut clear = true;
                for k in 0..clusters.len() { if clusters[k].manager.distance(h) <= 1 { clear = false; } }
                if self.keeps_tile(city, team, &routes, &others, h) && !taken.contains(h) && !self.grid.terrain(h).is_water() && clear { manager = Option.Some(h); }
            }
            let Option.Some(m) = manager else { continue; };
            let mut cluster = Cluster.new(m);
            let workers = plan.workers();
            for k in 0..workers.len() {
                let worker = workers[k];
                if worker != m && self.keeps_tile(city, team, &routes, &others, worker) && !taken.contains(worker) && m.distance(worker) == 1 && cluster.count < WORKERS_PER_MANAGER {
                    cluster.add_worker(worker);
                }
            }
            clusters.push(cluster);
        }
        let capacity = self.cities[city].capacity();
        let allowed = self.cities[city].managers_allowed();
        trim_clusters(&mut clusters, capacity, allowed);
        self.cities[city].clusters = clusters;
        self.fill_citizens(city, &routes);
    }

    /// Whether `city` (of `team`) keeps a remembered tile: in reach, no other city's, no building
    /// on it and no other side's site.
    fn keeps_tile(&self, city: i32, team: Team, routes: &Routes, others: &Set[Hex], hex: Hex) -> bool {
        let own = match self.sites.get(hex) { Option.Some(s) => s.team == team, Option.None => true };
        routes.costs.has(hex) && !others.contains(hex) && !self.closed_to_citizens(hex) && own
    }

    /// `city` loses a citizen (it starves, `feed_citizens`, or a finished Settler takes one,
    /// `complete_builds`). The last cluster's last worker goes first, and a manager only once its
    /// cluster has no workers left (`trim_clusters`, on what it works and what it remembers
    /// alike). A city never goes below one citizen: answers whether it lost one.
    pub fn remove_citizen(&mut self, city: i32) -> bool {
        if self.cities[city].population <= 1 { return false; }
        self.cities[city].population = self.cities[city].population - 1;
        let capacity = self.cities[city].capacity();
        let allowed = self.cities[city].managers_allowed();
        trim_clusters(&mut self.cities[city].clusters, capacity, allowed);
        trim_clusters(&mut self.cities[city].remembered, capacity, allowed);
        true
    }

    /// A: the open city's citizens are assigned afresh.
    pub fn auto_assign_selected_city(&mut self) {
        if self.is_resolving() { return; }
        if let Option.Some(city) = self.selected_city {
            self.auto_assign_city(city);
            self.set_notice("CITIZENS AUTO ASSIGNED");
        }
    }

    /// The turn's economy (`economy.tua`): every city's goods go to its side's stockpile, the
    /// citizens eat from it, each queue pays for the item it starts and does a turn's work
    /// (`work_queues`), and finished builds complete.
    pub fn resolve_economy(&mut self) can {Log} {
        self.set_notice("PLANNING - C CITY - SPACE HOLD OR END TURN");
        let mut income: Vec[Stock] = Vec.new();
        let mut rates: Vec[(i32, i32)] = Vec.new();
        for i in 0..self.cities.len() { income.push(self.income(i)); }
        for i in 0..self.cities.len() { rates.push((self.work_rate(income[i].production()), self.work_rate(self.barracks_income(i)))); }
        for i in 0..self.cities.len() {
            let team = self.cities[i].team;
            self.add_stock(team, income[i]);
        }
        self.feed_citizens();
        // Each queue pays for what it starts and works it. A Barracks trains whatever its
        // managers do; with production speeding builds, each manager beside it adds its
        // cluster's work.
        self.work_queues(&rates);
        self.complete_builds();
        self.heal_at_hospitals();
        for i in 0..self.cities.len() { self.reconcile_citizens(i); }
    }

    /// Each hospital treats two nearby survivors once per turn, the most hurt first. Both health
    /// bars belong to the same unit, so a projected fighter benefits too.
    fn heal_at_hospitals(&mut self) {
        let mut treated: Vec[u32] = Vec.new();
        for c in 0..self.cities.len() {
            let Option.Some(site) = self.cities[c].placed_site(Building.FieldHospital) else { continue; };
            let team = self.cities[c].team;
            for _ in 0..2 {
                // The unit missing the most health across both bars, ties to the lower id.
                let mut best: Option[(i32, f32, u32)] = Option.None;
                for i in 0..self.units.len() {
                    let unit = &self.units[i];
                    let max = unit.max_hp();
                    if unit.team != team || unit.pos.distance(site) > 2 || treated.contains(unit.id) || (unit.hp >= max && unit.interior_hp >= max) { continue; }
                    let missing = 2.0 * max - unit.hp - unit.interior_hp;
                    let better = match best {
                        Option.None => true,
                        Option.Some((_, m, id)) => missing > m || (missing == m && unit.id < id),
                    };
                    if better { best = Option.Some((i, missing, unit.id)); }
                }
                let Option.Some((index, _, id)) = best else { break; };
                let max = self.units[index].max_hp();
                let unit = &mut self.units[index];
                unit.hp = if unit.hp + 20.0 < max { unit.hp + 20.0 } else { max };
                unit.interior_hp = if unit.interior_hp + 20.0 < max { unit.interior_hp + 20.0 } else { max };
                treated.push(id);
            }
        }
        self.sync_interior_health(&treated);
    }
}
