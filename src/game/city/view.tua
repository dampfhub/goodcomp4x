//! City and Barracks views: opening and leaving them, map clicks while one is open, and ending
//! planning (which waits on cities with nothing to build).

use std.fmt.Out;
use std.fmt.show_i64;
use std.fmt.show_u64;
use log.Log;
use game.GameState;
use game.text;
use game.city.CLUSTER_SIZE;
use game.city.Cluster;
use game.city.FOOD_PER_CITIZEN;
use game.city.MAX_MANAGERS;
use game.city.Stock;
use game.city.no_stock;
use game.scenario.copy_vec;
use game.hex.Hex;
use game.unit.Team;

impl GameState {
    /// Y or the Yields button: shows or hides tile yields around the open city.
    pub fn toggle_yields(&mut self) { self.show_yields = !self.show_yields; }

    /// The open city, if its tile yields are being shown.
    pub fn yields_city(&self) -> Option[i32] {
        if self.show_yields { self.selected_city } else { Option.None }
    }

    /// The city whose delivery shares (the percentages) the map shows: `yields_city`, or with
    /// yields off, the open city's while something is being placed for its workers and Alt is
    /// held.
    pub fn shares_city(&self) -> Option[i32] {
        match self.yields_city() {
            Option.Some(city) => Option.Some(city),
            Option.None => if self.placing_job.is_some() && self.show_details { self.selected_city } else { Option.None },
        }
    }

    /// Whether cluster `cluster` of `city`'s manager is the one picked up.
    pub fn is_moving_manager(&self, city: i32, cluster: i32) -> bool {
        match self.moving_manager { Option.Some((c, k)) => c == city && k == cluster, Option.None => false }
    }

    /// What `city` delivers a turn as the UI shows it: `income`, less the cluster of a manager
    /// picked up (its workers leave the map with it until it's placed). A carried manager is
    /// always put back before a turn resolves, so the economy itself never sees this.
    pub fn shown_income(&self, city: i32) -> Stock {
        let income = self.income(city);
        match self.moving_manager {
            Option.Some((i, cluster)) => if i == city { income.minus(self.cluster_income(city, cluster)) } else { income },
            Option.None => income,
        }
    }

    /// What `city` adds to its side's stockpile a turn, as the UI shows it: `shown_income`, with
    /// the food its citizens eat taken off.
    pub fn net_delivery(&self, city: i32) -> Stock {
        let income = self.shown_income(city);
        Stock { food: income.food - self.cities[city].population * FOOD_PER_CITIZEN, wood: income.wood, metal: income.metal }
    }

    /// `side_income` as the UI shows it (`shown_income` for each city).
    pub fn shown_side_income(&self, team: Team) -> Stock {
        let mut sum = no_stock();
        for i in 0..self.cities.len() { if self.cities[i].team == team { sum = sum.plus(self.shown_income(i)); } }
        sum
    }

    /// C: opens a city that needs something to build, or else the first of the player's cities.
    pub fn select_city(&mut self) {
        if self.is_resolving() { return; }
        let mut city: Option[i32] = Option.None;
        for i in 0..self.cities.len() {
            if city.is_none() && self.city_needs_build(i) { city = Option.Some(i); }
        }
        for i in 0..self.cities.len() {
            if city.is_none() && self.cities[i].team == self.local_team { city = Option.Some(i); }
        }
        if let Option.Some(i) = city { self.open_city(i); }
    }

    /// Opens city `i`'s view and glides the camera to it.
    pub fn open_city(&mut self, i: i32) {
        self.close_city_interior();
        if self.selected_city != Option.Some(i) {
            self.city_queue_scroll = 0;
            // Placing belongs to the open city.
            self.placing_job = Option.None;
            self.hovered_job = Option.None;
        }
        self.selected_city = Option.Some(i);
        self.selected_barracks = Option.None;
        self.selected = Option.None;
        self.group.clear();
        self.ui_click_mode = Option.None;
        self.camera.focus_on(self.cities[i].pos.to_world());
        if self.city_needs_build(i) {
            let id = self.cities[i].id;
            self.notice = text(fn() can {Out} { Out.put("CHOOSE WHAT CITY "); show_u64((id + 1) as u64); Out.put(" BUILDS - 0-9"); });
        } else {
            self.set_notice("CLICK TILES TO ASSIGN - A AUTO ASSIGN - ESC OR SPACE TO EXIT");
        }
    }

    /// One of the player's cities with nothing queued to build. The turn waits for these, as it
    /// does for units without orders. A player city with an empty queue holds up the turn: it can
    /// always gather (`Build.Gather`), even when its side can't pay for anything.
    pub fn city_needs_build(&self, i: i32) -> bool {
        let city = &self.cities[i];
        city.team == self.local_team && city.queue.is_empty()
    }

    pub fn leave_city_view(&mut self) {
        self.close_city_interior();
        self.selected_city = Option.None;
        self.selected_barracks = Option.None;
        self.moving_manager = Option.None;
        self.placing_job = Option.None;
        self.hovered_job = Option.None;
    }

    /// Escape and Space dismiss city or building management without issuing a unit order or
    /// opening the settings menu. While something is being placed for the city's workers, the
    /// first press only stops that and keeps the city open (`stop_placing`).
    pub fn exit_structure_menu(&mut self) -> bool {
        if self.interior_view.is_some() {
            self.close_city_interior();
            return true;
        }
        if self.selected_city.is_none() && self.selected_barracks.is_none() { return false; }
        if self.stop_placing() { return true; }
        self.leave_city_view();
        self.set_notice("PLANNING - C CITY - SPACE HOLD OR END TURN");
        true
    }

    /// The city tray's Cancel Placing button, and the first Escape while placing: stops placing
    /// what the open city was placing for its workers, with nothing placed or paid. Answers
    /// whether anything was being placed.
    pub fn stop_placing(&mut self) -> bool {
        let Option.Some(kind) = self.placing_job else { return false; };
        self.placing_job = Option.None;
        self.hovered_job = Option.None;
        self.notice = text(fn() can {Out} { Out.put("STOPPED PLACING "); Out.put(kind.name()); });
        true
    }

    /// Opens city `city`'s Barracks view and glides the camera to it.
    pub fn open_barracks(&mut self, city: i32) {
        self.close_city_interior();
        let Option.Some(barracks) = self.cities[city].barracks else { return; };
        if self.selected_barracks != Option.Some(city) { self.barracks_queue_scroll = 0; }
        self.selected_city = Option.None;
        self.placing_job = Option.None;
        self.hovered_job = Option.None;
        self.selected_barracks = Option.Some(city);
        self.selected = Option.None;
        self.group.clear();
        self.ui_click_mode = Option.None;
        self.camera.focus_on(barracks.to_world());
        self.set_notice("BARRACKS - QUEUE TROOPS OR CLICK CITY TO RETURN");
    }

    /// The Barracks view's City button: back to its city.
    pub fn open_selected_city_from_barracks(&mut self) {
        if let Option.Some(city) = self.selected_barracks { self.open_city(city); }
    }

    /// A map click the city views take. A structure menu owns every map click until its
    /// explicit exit: with nothing open, clicking one of the player's Barracks or cities opens it;
    /// with a city open, the click picks up or puts down a manager, or assigns or releases a
    /// citizen. Answers whether the click was theirs.
    pub fn city_click(&mut self, hex: Hex) -> bool {
        if self.interior_view.is_some() {
            self.interior_click(hex);
            return true;
        }
        if self.selected_barracks.is_some() {
            self.set_notice("BARRACKS MENU - PRESS ESC OR SPACE TO EXIT");
            return true;
        }
        let Option.Some(i) = self.selected_city else {
            for c in 0..self.cities.len() {
                if self.cities[c].barracks == Option.Some(hex) && self.cities[c].team == self.local_team {
                    self.open_barracks(c);
                    return true;
                }
            }
            for c in 0..self.cities.len() {
                if self.cities[c].pos == hex && self.cities[c].team == self.local_team {
                    self.open_city(c);
                    return true;
                }
            }
            return false;
        };
        if hex == self.cities[i].pos {
            self.open_city_interior(i);
            return true;
        }
        // City management owns map clicks, so citizens may be assigned onto a unit's tile. A tile
        // never seen can't be worked.
        if !self.is_explored(hex) {
            self.set_notice("UNEXPLORED - SCOUT IT FIRST");
            return true;
        }
        if let Option.Some((mc, cluster)) = self.moving_manager {
            if mc == i {
                if self.cities[i].clusters[cluster].manager == hex {
                    self.moving_manager = Option.None;
                    self.set_notice("MANAGER MOVE CANCELLED");
                } else if self.closed_to_citizens(hex) {
                    self.set_notice("A BUILDING STANDS THERE - NO CITIZEN CAN WORK IT");
                } else if self.may_be_manager(i, cluster, hex) {
                    self.moving_manager = Option.None;
                    self.move_manager(i, cluster, hex);
                } else {
                    self.set_notice("MANAGER NEEDS A REACHABLE, UNCLAIMED LAND TILE CLEAR OF THE OTHER MANAGERS");
                }
                return true;
            }
        }
        if let Option.Some(cluster) = self.cities[i].cluster_of(hex) {
            if self.cities[i].clusters[cluster].manager == hex {
                self.moving_manager = Option.Some((i, cluster));
                self.set_notice("MANAGER PICKED UP - CLICK A DESTINATION");
                return true;
            }
            self.cities[i].clusters[cluster].remove_worker(hex);
            for r in 0..self.cities[i].remembered.len() { self.cities[i].remembered[r].remove_worker(hex); }
            self.set_notice("CITIZEN UNASSIGNED");
        } else if self.closed_to_citizens(hex) {
            self.set_notice("A BUILDING STANDS THERE - NO CITIZEN CAN WORK IT");
        } else if !self.is_open(i, hex) {
            self.set_notice("CLICK A WORKED TILE TO MOVE OR RELEASE A CITIZEN; CLICK AN OPEN TILE BESIDE A MANAGER TO ASSIGN");
        } else if !self.routes(i).costs.has(hex) {
            self.set_notice("NO OPEN ROUTE WITHIN LOGISTICS BUDGET");
        } else if self.cities[i].working() >= self.cities[i].capacity() {
            self.set_notice("ALL CITIZENS BUSY - RELEASE A WORKED TILE FIRST");
        } else if let Option.Some(cluster) = self.cluster_with_room(i, hex) {
            self.cities[i].clusters[cluster].add_worker(hex);
            self.cities[i].remembered = copy_vec(&self.cities[i].clusters);
            self.set_notice("CITIZEN ASSIGNED");
        } else if self.cities[i].clusters.len() >= self.cities[i].managers_allowed() {
            let have = self.cities[i].clusters.len();
            self.notice = text(fn() can {Out} {
                if have >= MAX_MANAGERS {
                    Out.put("A CITY HAS AT MOST "); show_i64(MAX_MANAGERS as i64); Out.put(" MANAGERS - CLICK A TILE BESIDE ONE");
                } else {
                    Out.put("ANOTHER MANAGER AT "); show_i64((have * CLUSTER_SIZE + 1) as i64); Out.put(" CITIZENS - CLICK A TILE BESIDE A MANAGER WITH ROOM");
                }
            });
        } else if !self.clear_of_managers(i, hex, Option.None) {
            self.set_notice("A MANAGER WORKS LAND, NOT BESIDE ANOTHER MANAGER");
        } else {
            self.cities[i].clusters.push(Cluster.new(hex));
            self.cities[i].remembered = copy_vec(&self.cities[i].clusters);
            self.set_notice("MANAGER ASSIGNED - A NEW CLUSTER");
        }
        true
    }

    /// Space (once nothing needs orders) or the End Turn button: resolves the turn, unless a city
    /// needs something to build, in which case that city is opened instead. Units still waiting
    /// for orders hold.
    pub fn end_planning(&mut self) can {Log} {
        if self.is_resolving() { return; }
        for i in 0..self.units.len() {
            if self.is_player_controlled(i) && self.needs_orders(i) { self.units[i].holding = true; }
        }
        self.placing_job = Option.None;
        self.hovered_job = Option.None;
        for i in 0..self.cities.len() {
            if self.city_needs_build(i) {
                self.open_city(i);
                return;
            }
        }
        // A networked game resolves once every side's plan is in (`multiplayer.tua`).
        if self.is_networked() {
            self.submit_plan();
            return;
        }
        for i in 0..self.cities.len() {
            if !self.is_human(self.cities[i].team) { self.auto_assign_city(i); }
        }
        self.close_views_on_end_turn();
        self.set_notice("RESOLVING ORDERS");
        self.resolve_turn();
    }

    /// What ending the turn lets go of: the city and Barracks views close, a manager being moved or
    /// a queue row being dragged is let go, and so is the unit selection (`resolve_turn` drops it
    /// too, as indices shift). A city interior stays open (a Siege begins inside one).
    pub fn close_views_on_end_turn(&mut self) {
        self.selected_city = Option.None;
        self.selected_barracks = Option.None;
        self.moving_manager = Option.None;
        self.queue_drag = Option.None;
        self.selected = Option.None;
        self.group.clear();
    }
}
