//! Builds each frame's geometry from the game state.

use std.collections.Map;
use std.collections.Set;
use std.fmt.Out;
use std.fmt.show_i64;
use std.linalg.Vec2;
use std.linalg.vec2;
use std.linalg.vec2_from_angle;
use std.math.pi;
use std.math.tau;
use renderer.pipelines.MeshVertex;
use game.GameState;
use game.text;
use game.city.delivered_share;
use game.font.push_glyph;
use game.font.push_text;
use game.hex.HEX_SIZE;
use game.hex.Hex;
use game.mesh.Color;
use game.mesh.quad;
use game.mesh.polygon_outline;
use game.mesh.polyline;
use game.mesh.triangle;
use game.mesh.regular_polygon;
use game.mesh.segment;
use game.orders.ClickMode;
use game.terrain.Feature;
use game.ruins.RUIN_HOLD_TURNS;
use game.terrain.Terrain;
use game.terrain.Tile;
use game.hex.HexGrid;
use game.hex.Edge;
use game.fog.Fog;
use game.hex.edge_corners;
use game.turn.Phase;
use game.turn.step_rank;
use game.unit.Team;
use game.unit.Unit;
use game.unit.UnitStats;

const BORDER_COLOR: Color = [0.10, 0.10, 0.13, 1.0];
const PLAINS_COLOR: Color = [0.26, 0.24, 0.12, 1.0];
const GRASSLAND_COLOR: Color = [0.12, 0.20, 0.08, 1.0];
const DESERT_COLOR: Color = [0.45, 0.36, 0.17, 1.0];
const DUNE_COLOR: Color = [0.30, 0.22, 0.09, 1.0];
const TUNDRA_COLOR: Color = [0.20, 0.21, 0.19, 1.0];
const TUFT_COLOR: Color = [0.36, 0.38, 0.33, 1.0];
const SNOWFIELD_COLOR: Color = [0.55, 0.60, 0.66, 1.0];
const FOREST_COLOR: Color = [0.03, 0.10, 0.03, 1.0];
const MARSH_COLOR: Color = [0.09, 0.15, 0.11, 1.0];
const REED_COLOR: Color = [0.22, 0.30, 0.15, 1.0];
const JUNGLE_COLOR: Color = [0.02, 0.12, 0.05, 1.0];
const CANOPY_COLOR: Color = [0.01, 0.06, 0.02, 1.0];
const TREE_COLOR: Color = [0.015, 0.045, 0.015, 1.0];
const COAST_COLOR: Color = [0.06, 0.16, 0.30, 1.0];
const OCEAN_COLOR: Color = [0.02, 0.06, 0.16, 1.0];
const LAKE_COLOR: Color = [0.07, 0.19, 0.30, 1.0];
const WAVE_COLOR: Color = [0.16, 0.32, 0.52, 1.0];
const DEEP_WAVE_COLOR: Color = [0.05, 0.13, 0.28, 1.0];
const RIVER_COLOR: Color = [0.12, 0.34, 0.70, 1.0];
const RIVER_WIDTH: f32 = 0.16;
/// The widest window a view is drawn in, width over height.
const MAX_VIEW_ASPECT: f32 = 2.4;
const SPECIAL_RIM_COLOR: Color = [0.95, 0.66, 0.12, 1.0];
/// Over hexes seen before but out of sight now.
const REMEMBERED_TINT: Color = [0.0, 0.0, 0.0, 0.58];
/// Never-seen hexes, as the Fog setting's solid grey draws them.
const SOLID_FOG_COLOR: Color = [0.13, 0.135, 0.155, 1.0];
const RUIN_RIM_COLOR: Color = [0.62, 0.58, 0.50, 1.0];
const LANDMARK_RIM_WIDTH: f32 = 0.05;
/// Where the pips counting a ruin's hold start, from the hex's center, and their size.
const RUIN_PIPS: Vec2 = Vec2 { x: -0.06, y: -0.7 };
const RUIN_PIP_RADIUS: f32 = 0.05;
const RUIN_PIP_GAP: f32 = 0.13;
const MOUNTAIN_COLOR: Color = [0.13, 0.12, 0.12, 1.0];
const MOUNTAIN_PEAK_COLOR: Color = [0.44, 0.42, 0.42, 1.0];
const SNOW_COLOR: Color = [0.90, 0.92, 0.95, 1.0];
const SELECTED_COLOR: Color = [0.80, 0.78, 0.30, 1.0];
const CONTESTED_COLOR: Color = [0.55, 0.32, 0.10, 1.0];
const MOVE_RANGE_COLOR: Color = [0.24, 0.42, 0.26, 1.0];
const ATTACK_RANGE_COLOR: Color = [0.45, 0.22, 0.22, 1.0];
const ATTACK_RANGE_EMPTY_COLOR: Color = [0.36, 0.24, 0.20, 1.0];
const LABEL_COLOR: Color = [0.05, 0.05, 0.05, 1.0];
const HEALTH_BAR_BG_COLOR: Color = [0.08, 0.08, 0.08, 1.0];

/// Sizes below are for a unit drawn at full scale, alone in its hex.
const UNIT_ICON_RADIUS: f32 = HEX_SIZE * 0.42;
const LABEL_HEIGHT: f32 = UNIT_ICON_RADIUS * 0.9;
/// Icon growth while a unit is highlighted for having just acted.
const ACTED_SCALE: f32 = 1.35;

/// Rings drawn behind a unit's icon: gold while its ability is queued, steel while a siege
/// engine is deployed.
const ABILITY_RING_COLOR: Color = [0.95, 0.78, 0.25, 1.0];
const ABILITY_RING_RADIUS: f32 = UNIT_ICON_RADIUS * 1.32;
const DEPLOYED_RING_COLOR: Color = [0.62, 0.66, 0.72, 1.0];
const DEPLOYED_RING_RADIUS: f32 = UNIT_ICON_RADIUS * 1.18;
/// A white hex outline around a guarding unit, outside any status rings.
const GUARD_OUTLINE_COLOR: Color = [0.92, 0.94, 0.98, 1.0];
const GUARD_OUTLINE_RADIUS: f32 = UNIT_ICON_RADIUS * 1.5;
const GUARD_OUTLINE_WIDTH: f32 = 0.05;

/// The two units sharing a contested hex are drawn at this scale, stacked vertically with Blue
/// on top.
const CONTESTED_SCALE: f32 = 0.5;
const CONTESTED_OFFSET_Y: f32 = 0.38;

/// Turn-order badges beside each unit: move order on the left, attack order on the right.
const BADGE_OFFSET_X: f32 = 0.62;
const BADGE_RADIUS: f32 = 0.17;
const BADGE_DIGIT_HEIGHT: f32 = 0.2;
const BADGE_BG_COLOR: Color = [0.06, 0.06, 0.08, 0.9];
const MOVE_ORDER_COLOR: Color = [0.45, 0.70, 1.00, 1.0];
const ATTACK_ORDER_COLOR: Color = [1.00, 0.40, 0.35, 1.0];

const HEALTH_BAR_WIDTH: f32 = 0.9;
const HEALTH_BAR_HEIGHT: f32 = 0.14;
const HEALTH_BAR_OFFSET_Y: f32 = 0.78;

/// Outline around each tile the hovered or selected city works.
const WORKED_OUTLINE_RADIUS: f32 = HEX_SIZE * 0.84;
const WORKED_OUTLINE_WIDTH: f32 = 0.06;
const WORKED_OUTLINE_RIM_WIDTH: f32 = 0.10;
const WORKED_OUTLINE_RIM_COLOR: Color = [0.02, 0.05, 0.03, 1.0];

const ROAD_COLOR: Color = [0.65, 0.45, 0.24, 1.0];
const DELIVERY_TEXT_COLOR: Color = [0.65, 0.85, 0.65, 1.0];
const WORKED_ROUTED_COLOR: Color = [0.25, 1.0, 0.4, 1.0];
const WORKED_CUT_OFF_COLOR: Color = [1.0, 0.25, 0.2, 1.0];
const YIELD_BADGE_COLOR: Color = [0.035, 0.045, 0.045, 0.94];
const FOOD_COLOR: Color = [0.42, 0.96, 0.32, 1.0];
const PRODUCTION_COLOR: Color = [1.0, 0.69, 0.22, 1.0];

/// A queued move is drawn as a faded copy of the unit at its destination.
const GHOST_ALPHA: f32 = 0.4;
const GHOST_FAN_RADIUS: f32 = HEX_SIZE * 0.3;

/// A queued swap is drawn as a link between the two allies.
const SWAP_LINK_WIDTH: f32 = 0.1;
const SWAP_LINK_ALPHA: f32 = 0.8;

/// A queued attack is drawn as a curved arrow from the attacker (or its ghost, if it's
/// moving first) to the hex it's attacking.
const ATTACK_ARC_COLOR: Color = [1.00, 0.45, 0.30, 1.0];
const ATTACK_ARC_OUTLINE_COLOR: Color = [0.08, 0.03, 0.02, 1.0];
const ATTACK_ARC_WIDTH: f32 = 0.07;
const ATTACK_ARC_OUTLINE_WIDTH: f32 = 0.13;
/// How far the arc bows sideways, as a share of its length.
const ATTACK_ARC_BOW: f32 = 0.25;
/// The arc starts at the edge of the attacker's icon and stops short of the target's
/// center, so a unit drawn there doesn't hide the arrowhead.
const ATTACK_ARC_START: f32 = UNIT_ICON_RADIUS;
const ATTACK_ARC_STOP: f32 = HEX_SIZE * 0.55;
const ATTACK_ARC_SEGMENTS: i32 = 20;
const ATTACK_ARROW_LENGTH: f32 = 0.28;
const ATTACK_ARROW_WIDTH: f32 = 0.26;

/// What the selected unit can do this turn, computed once per frame.
struct Selection {
    pos: Hex,
    planned_pos: Hex,
    team: Team,
    stats: UnitStats,
    reachable: Set[Hex],
    /// Locked in a contested hex, so it can't attack anything else.
    locked: bool,
    /// Swap is armed, so adjacent allies are the hexes to highlight.
    swapping: bool,
}

impl GameState {
    /// The whole scene as a triangle list, back to front: hex grid, queued order markers, then
    /// units.
    pub fn build_vertices(&self) -> Vec[MeshVertex] {
        let mut out: Vec[MeshVertex] = Vec.new();
        let fog = self.fog();

        let selection = match self.selected {
            Option.Some(idx) => {
                let unit = &self.units[idx];
                let stats = unit.stats();
                // A green hex means clicking moves there, which isn't true while an attack or
                // swap is armed.
                let shows_moves = match self.ui_click_mode { Option.None | Option.Some(ClickMode.Move) => true, _ => false };
                Option.Some(Selection {
                    pos: unit.pos,
                    planned_pos: unit.planned_pos(),
                    team: unit.team,
                    stats,
                    reachable: if shows_moves { self.known_reachable_hexes(unit.pos, stats.move_range, unit.team, &fog) } else { Set.new() },
                    locked: self.rival_of(idx).is_some(),
                    swapping: self.ui_click_mode == Option.Some(ClickMode.Swap),
                })
            }
            Option.None => Option.None,
        };

        // Only what the camera may show: a big map has far more hexes than a view, and more
        // vertices than a frame draws.
        let (view_min, view_max) = self.view_rect();
        for h in self.grid.hexes() {
            let hex = *h;
            let center = hex.to_world();
            if center.x < view_min.x - 1.0 || center.y < view_min.y - 1.0 || center.x > view_max.x + 1.0 || center.y > view_max.y + 1.0 { continue; }
            // Never-seen hexes are fog, nothing of what's there.
            if !self.is_explored(hex) {
                regular_polygon(center, HEX_SIZE, 6, 0.0, SOLID_FOG_COLOR, &mut out);
                continue;
            }
            let fill = self.hex_fill(hex, &selection, &fog);
            regular_polygon(center, HEX_SIZE, 6, 0.0, BORDER_COLOR, &mut out);
            regular_polygon(center, HEX_SIZE * 0.92, 6, 0.0, fill, &mut out);
            push_tile_symbols(center, self.grid.tile(hex), &mut out);
            if self.grid.special(hex).is_some() {
                polygon_outline(center, HEX_SIZE * 0.92 - LANDMARK_RIM_WIDTH / 2.0, LANDMARK_RIM_WIDTH, 6, 0.0, SPECIAL_RIM_COLOR, &mut out);
            }
            self.push_ruin(hex, &mut out);
        }
        self.push_rivers(&mut out);

        self.push_city_map(&mut out);
        self.push_fog(&fog, view_min, view_max, &mut out);
        self.push_order_markers(&mut out);

        for idx in 0..self.units.len() {
            let unit = &self.units[idx];
            if !fog.shows(unit) { continue; }
            let (center, scale) = self.unit_layout(idx);
            let (icon_scale, color) = if self.recent_actors.contains(unit.id) {
                (scale * ACTED_SCALE, brighten(unit.team.color()))
            } else {
                (scale, unit.team.color())
            };
            push_status_rings(center, unit, scale, &mut out);
            push_unit_icon(center, unit, self.unit_letter(unit), icon_scale, color, &mut out);
            push_order_badges(center, unit, scale, &mut out);
            push_health_bar(center, unit.hp / unit.max_hp(), scale, &mut out);
        }

        self.push_tile_yields(&mut out);
        self.push_effects(&mut out);
        out
    }

    /// Ghosts at queued move destinations, links between allies queued to swap, and arrows
    /// for the player's queued attacks. Ghosts of units sharing a destination are fanned out so
    /// each order stays visible.
    fn push_order_markers(&self, out: &mut Vec[MeshVertex]) {
        let n = self.units.len();
        let mut swapping: Vec[bool] = Vec.new();
        for i in 0..n { swapping.push(self.swap_partner(i).is_some()); }

        // Where each moving unit's ghost is drawn, for its attack arc. Groups by target hex in
        // first-seen order, so the layout is stable across frames.
        let mut ghosts: Map[i64, Vec2] = Map.new();
        let mut move_targets: Vec[Hex] = Vec.new();
        for i in 0..n {
            if let Option.Some(hex) = self.units[i].planned_move {
                if !swapping[i] && !move_targets.contains(hex) { move_targets.push(hex); }
            }
        }
        for t in 0..move_targets.len() {
            let hex = move_targets[t];
            let total = self.count_moving_to(n, &swapping, hex);
            let mut k = 0;
            for i in 0..n {
                let unit = &self.units[i];
                if !swapping[i] && unit.planned_move == Option.Some(hex) {
                    let pos = fan_position(hex.to_world(), k, total, GHOST_FAN_RADIUS);
                    push_unit_icon(pos, unit, self.unit_letter(unit), 1.0, with_alpha(unit.team.color(), GHOST_ALPHA), out);
                    let _old = ghosts.insert(unit.id as i64, pos);
                    k = k + 1;
                }
            }
        }

        for idx in 0..n {
            if let Option.Some(partner) = self.swap_partner(idx) {
                if partner > idx {
                    let color = with_alpha(self.units[idx].team.color(), SWAP_LINK_ALPHA);
                    segment(self.units[idx].pos.to_world(), self.units[partner].pos.to_world(), SWAP_LINK_WIDTH, color, out);
                }
            }
        }

        // Only the player's own attacks: the AI's plans aren't theirs to see.
        for idx in 0..n {
            let unit = &self.units[idx];
            let Option.Some(target) = unit.planned_attack else { continue; };
            if !self.is_player_controlled(idx) { continue; }
            // Swapping units attack from their partner's hex.
            let from = match ghosts.get(unit.id as i64) {
                Option.Some(ghost) => ghost,
                Option.None => if unit.planned_move.is_some() { unit.planned_pos().to_world() } else { self.unit_layout(idx).0 },
            };
            push_attack_arc(from, target.to_world(), out);
        }
    }

    /// How many units have a plain (not swapping) move queued to `hex`.
    fn count_moving_to(&self, n: i32, swapping: &Vec[bool], hex: Hex) -> i32 {
        let mut total = 0;
        for i in 0..n {
            if !swapping[i] && self.units[i].planned_move == Option.Some(hex) { total = total + 1; }
        }
        total
    }

    /// Where to draw a unit and at what scale: full size in the middle of its hex, or half size
    /// and offset when it shares a contested hex.
    pub fn unit_layout(&self, idx: i32) -> (Vec2, f32) {
        let unit = &self.units[idx];
        let center = unit.pos.to_world();
        if self.rival_of(idx).is_none() { return (center, 1.0); }
        let offset_y = if unit.team == Team.Blue { CONTESTED_OFFSET_Y } else { -CONTESTED_OFFSET_Y };
        (center.add(vec2(0.0, offset_y)), CONTESTED_SCALE)
    }

    /// The terrain's color, unless the hex is selected, contested, or in the selected unit's
    /// move or attack range. Mountains are never highlighted since nothing can move to or stand
    /// on them.
    fn hex_fill(&self, hex: Hex, selection: &Option[Selection], fog: &Fog) -> Color {
        let tile = self.grid.tile(hex);
        let base = tile_color(tile);
        if !tile.terrain.is_passable() { return base; }
        let mut in_group = false;
        for m in 0..self.group.len() {
            if self.units[self.group[m]].pos == hex { in_group = true; }
        }
        if in_group { return SELECTED_COLOR; }
        let &Option.Some(sel) = selection else {
            return if self.is_contested(hex) { CONTESTED_COLOR } else { base };
        };
        if sel.pos == hex { return SELECTED_COLOR; }
        if self.is_contested(hex) { return CONTESTED_COLOR; }
        if sel.swapping {
            let swappable = sel.pos.distance(hex) == 1 && self.controlled_unit_at(hex).is_some();
            return if swappable { MOVE_RANGE_COLOR } else { base };
        }

        let in_attack_range = !sel.locked && sel.planned_pos.distance(hex) <= sel.stats.attack_range;
        let has_enemy = self.known_enemy_target_at(hex, sel.team, fog);
        if self.known_occupied(hex, fog) {
            return if has_enemy && in_attack_range { ATTACK_RANGE_COLOR } else { base };
        }
        if sel.reachable.contains(hex) {
            MOVE_RANGE_COLOR
        } else if in_attack_range {
            ATTACK_RANGE_EMPTY_COLOR
        } else {
            base
        }
    }
}

impl GameState {
    /// Roads, the open or hovered city's worked tiles and delivery shares, site letters and
    /// the cities themselves.
    fn push_city_map(&self, out: &mut Vec[MeshVertex]) {
        for r in 0..self.roads.len() {
            let Option.Some(h) = self.roads.key_at(r) else { continue; };
            regular_polygon(h.to_world(), 0.12, 8, 0.0, ROAD_COLOR, out);
            let around = h.neighbors();
            for k in 0..6 {
                let n = around[k];
                let ordered = h.q < n.q || (h.q == n.q && h.r < n.r);
                if ordered && self.is_road_hex(n) { segment(h.to_world(), n.to_world(), 0.09, ROAD_COLOR, out); }
            }
        }
        // Road segments reaching a city are drawn even though the city center itself is
        // represented by its larger city marker.
        for c in 0..self.cities.len() {
            let pos = self.cities[c].pos;
            let around = pos.neighbors();
            for k in 0..6 {
                if self.roads.contains(around[k]) { segment(pos.to_world(), around[k].to_world(), 0.09, ROAD_COLOR, out); }
            }
        }
        let shown = match self.hovered_city { Option.Some(i) => Option.Some(i), Option.None => self.selected_city };
        if let Option.Some(i) = shown {
            let routes = self.routes(i);
            if self.yields_city() == Option.Some(i) {
                for r in 0..routes.costs.len() {
                    let Option.Some(h) = routes.costs.key_at(r) else { continue; };
                    let Option.Some(cost) = routes.costs.val_at(r) else { continue; };
                    // Nothing shows in the fog.
                    if !self.is_explored(h) { continue; }
                    let label = text(fn() can {Out} { show_i64((delivered_share(cost) * 25) as i64); Out.put("%"); });
                    push_text(h.to_world().add(vec2(-0.3, 0.52)), 0.18, &label, DELIVERY_TEXT_COLOR, out);
                }
            }
            let worked = &self.cities[i].worked;
            for w in 0..worked.len() {
                let h = worked[w];
                let color = if routes.costs.has(h) { WORKED_ROUTED_COLOR } else { WORKED_CUT_OFF_COLOR };
                // A coloured ring on a slightly wider dark one, just inside the hex's fill so
                // it doesn't blur into the grid lines.
                let center = h.to_world();
                polygon_outline(center, WORKED_OUTLINE_RADIUS, WORKED_OUTLINE_RIM_WIDTH, 6, 0.0, WORKED_OUTLINE_RIM_COLOR, out);
                polygon_outline(center, WORKED_OUTLINE_RADIUS, WORKED_OUTLINE_WIDTH, 6, 0.0, color, out);
            }
        }
        for k in 0..self.sites.len() {
            let Option.Some(h) = self.sites.key_at(k) else { continue; };
            let Option.Some(site) = self.sites.val_at(k) else { continue; };
            push_glyph(h.to_world().add(vec2(-0.55, 0.3)), 0.28, site.kind.letter(), site.team.color(), out);
        }
        for c in 0..self.cities.len() {
            let pos = self.cities[c].pos.to_world();
            quad(pos.sub(vec2(0.48, 0.48)), pos.add(vec2(0.48, 0.48)), self.cities[c].team.color(), out);
            push_glyph(pos, 0.5, 'H', LABEL_COLOR, out);
        }
    }

    /// Yield badges around the open city while yields are shown, limited to its economic
    /// reach.
    fn push_tile_yields(&self, out: &mut Vec[MeshVertex]) {
        let Option.Some(city) = self.yields_city() else { return; };
        let fog = self.fog();
        let routes = self.routes(city);
        for h in self.grid.hexes() {
            let hex = *h;
            if !self.grid.is_passable(hex) { continue; }
            if !routes.costs.has(hex) && !self.cities[city].worked.contains(hex) { continue; }
            if !self.is_explored(hex) { continue; }
            let (food, production) = self.known_yield(hex, &fog);
            let center = hex.to_world().add(vec2(0.0, -0.49));
            quad(center.sub(vec2(0.52, 0.18)), center.add(vec2(0.52, 0.18)), YIELD_BADGE_COLOR, out);
            let badges = [(true, food, -0.37, FOOD_COLOR), (false, production, 0.14, PRODUCTION_COLOR)];
            for b in 0..2 {
                let (is_food, count, offset, color) = badges[b];
                let p = center.add(vec2(offset, 0.0));
                if is_food {
                    // Grain stalk with paired kernels.
                    segment(p.add(vec2(0.0, -0.12)), p.add(vec2(0.0, 0.12)), 0.025, color, out);
                    let kernels = [(-0.05, -0.04), (0.05, -0.04), (-0.05, 0.04), (0.05, 0.04)];
                    for k in 0..4 {
                        let (x, y) = kernels[k];
                        regular_polygon(p.add(vec2(x, y)), 0.045, 4, 0.0, color, out);
                    }
                } else {
                    // Hammer: broad head and narrow handle.
                    quad(p.add(vec2(-0.02, -0.12)), p.add(vec2(0.025, 0.06)), color, out);
                    quad(p.add(vec2(-0.09, 0.04)), p.add(vec2(0.09, 0.12)), color, out);
                }
                let digits = text(fn() can {Out} { show_i64(count as i64); });
                push_text(p.add(vec2(0.11, -0.105)), 0.21, &digits, color, out);
            }
        }
    }
}

impl GameState {
    /// Darkens remembered hexes (explored, out of sight now) in the view: drawn over the map
    /// and cities but under units and orders.
    fn push_fog(&self, fog: &Fog, view_min: Vec2, view_max: Vec2, out: &mut Vec[MeshVertex]) {
        if !self.fog_of_war { return; }
        for h in self.grid.hexes() {
            let hex = *h;
            let center = hex.to_world();
            if center.x < view_min.x - 1.0 || center.y < view_min.y - 1.0 || center.x > view_max.x + 1.0 || center.y > view_max.y + 1.0 { continue; }
            if self.is_explored(hex) && !fog.sees(hex) { regular_polygon(center, HEX_SIZE, 6, 0.0, REMEMBERED_TINT, out); }
        }
    }

    /// The world rectangle a view may show: as tall as the camera sees and as wide as the widest
    /// window it's drawn in (`MAX_VIEW_ASPECT`).
    fn view_rect(&self) -> (Vec2, Vec2) {
        let half = self.camera.half_height;
        let reach = vec2(half * MAX_VIEW_ASPECT, half);
        (self.camera.center.sub(reach), self.camera.center.add(reach))
    }

    /// Ruins on `hex`: a rim, and a pip for each turn their holder has held them, in its color.
    fn push_ruin(&self, hex: Hex, out: &mut Vec[MeshVertex]) {
        let Option.Some(i) = self.ruin_at(hex) else { return; };
        let center = hex.to_world();
        polygon_outline(center, HEX_SIZE * 0.92 - LANDMARK_RIM_WIDTH / 2.0, LANDMARK_RIM_WIDTH, 6, 0.0, RUIN_RIM_COLOR, out);
        let color = match self.ruins[i].holder { Option.Some(t) => t.color(), Option.None => BORDER_COLOR };
        for k in 0..RUIN_HOLD_TURNS {
            let pip = center.add(RUIN_PIPS).add(vec2(k as f32 * RUIN_PIP_GAP, 0.0));
            let fill = if k < self.ruins[i].held { color } else { BORDER_COLOR };
            regular_polygon(pip, RUIN_PIP_RADIUS + 0.012, 6, 0.0, BORDER_COLOR, out);
            regular_polygon(pip, RUIN_PIP_RADIUS, 6, 0.0, fill, out);
        }
    }
}

/// The ground's color, tinted green under forest or jungle.
fn tile_color(tile: Tile) -> Color {
    let ground = match tile.terrain {
        Terrain.Grassland => GRASSLAND_COLOR,
        Terrain.Plains => PLAINS_COLOR,
        Terrain.Desert => DESERT_COLOR,
        Terrain.Tundra => TUNDRA_COLOR,
        Terrain.Snow => SNOWFIELD_COLOR,
        Terrain.Marsh => MARSH_COLOR,
        Terrain.Mountains => MOUNTAIN_COLOR,
        Terrain.Coast => COAST_COLOR,
        Terrain.Ocean => OCEAN_COLOR,
        Terrain.Lake => LAKE_COLOR,
    };
    match tile.feature {
        Option.Some(Feature.Forest) => mix(ground, FOREST_COLOR, 0.5),
        Option.Some(Feature.Jungle) => mix(ground, JUNGLE_COLOR, 0.6),
        Option.None => ground,
    }
}

fn mix(a: Color, b: Color, t: f32) -> Color {
    [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t, a[3] + (b[3] - a[3]) * t]
}

/// A triangle rotated a quarter turn points straight up.
fn peak(center: Vec2, offset: Vec2, radius: f32, color: Color, out: &mut Vec[MeshVertex]) {
    regular_polygon(center.add(offset), radius, 3, pi() as f32 / 2.0, color, out);
}

/// Symbols drawn over the hex fill, so a tile stays recognizable under selection highlights.
/// They sit clear of the middle, where a unit's icon goes. Hills are two small peaks in a darker
/// shade of their ground along the bottom; forest (pines) and jungle (round canopies) go along
/// the bottom too, or along the top on hills. Bare ground gets its own marks along the bottom:
/// dunes for desert, grass tufts for tundra, reeds for marsh. Mountains get one large
/// snow-capped peak, water waves.
fn push_tile_symbols(center: Vec2, tile: Tile, out: &mut Vec[MeshVertex]) {
    if tile.hills {
        let shade = mix(tile_color(tile), [0.0, 0.0, 0.0, 1.0], 0.55);
        peak(center, vec2(-0.3, -0.5), 0.2, shade, out);
        peak(center, vec2(0.25, -0.47), 0.17, shade, out);
    }
    let row_y: f32 = if tile.hills { 1.0 } else { -1.0 };
    match tile.feature {
        Option.Some(Feature.Forest) => {
            let trees: [(f32, f32, f32); 3] = [(-0.36, 0.46, 0.15), (0.0, 0.6, 0.17), (0.36, 0.46, 0.15)];
            for i in 0..3 {
                let (x, y, r) = trees[i];
                peak(center, vec2(x, y * row_y), r, TREE_COLOR, out);
            }
            return;
        }
        Option.Some(Feature.Jungle) => {
            let trees: [(f32, f32, f32); 3] = [(-0.34, 0.48, 0.12), (0.0, 0.6, 0.14), (0.34, 0.48, 0.12)];
            for i in 0..3 {
                let (x, y, r) = trees[i];
                regular_polygon(center.add(vec2(x, y * row_y)), r, 10, 0.0, CANOPY_COLOR, out);
            }
            return;
        }
        Option.None => { if tile.hills { return; } }
    }
    match tile.terrain {
        Terrain.Grassland | Terrain.Plains | Terrain.Snow => {}
        Terrain.Marsh => {
            let spots: [(f32, f32); 3] = [(-0.34, -0.52), (0.0, -0.62), (0.34, -0.52)];
            let offsets: [f32; 3] = [-0.06, 0.0, 0.06];
            for i in 0..3 {
                let (x, y) = spots[i];
                let base = center.add(vec2(x, y));
                for k in 0..3 {
                    let dx = offsets[k];
                    segment(base.add(vec2(dx, 0.0)), base.add(vec2(dx, 0.13)), 0.02, REED_COLOR, out);
                }
            }
        }
        Terrain.Desert => {
            let spots: [(f32, f32); 3] = [(-0.32, -0.5), (0.08, -0.62), (0.34, -0.42)];
            for i in 0..3 {
                let (x, y) = spots[i];
                wave(center.add(vec2(x, y)), 0.2, DUNE_COLOR, out);
            }
        }
        Terrain.Tundra => {
            let spots: [(f32, f32); 3] = [(-0.34, -0.5), (0.0, -0.62), (0.34, -0.5)];
            let offsets: [f32; 3] = [-0.05, 0.0, 0.05];
            for i in 0..3 {
                let (x, y) = spots[i];
                let base = center.add(vec2(x, y));
                for k in 0..3 {
                    segment(base, base.add(vec2(offsets[k], 0.1)), 0.025, TUFT_COLOR, out);
                }
            }
        }
        Terrain.Coast | Terrain.Lake => {
            wave(center.add(vec2(-0.15, 0.15)), 0.4, WAVE_COLOR, out);
            wave(center.add(vec2(0.15, -0.2)), 0.4, WAVE_COLOR, out);
        }
        Terrain.Ocean => {
            wave(center.add(vec2(-0.15, 0.15)), 0.4, DEEP_WAVE_COLOR, out);
            wave(center.add(vec2(0.15, -0.2)), 0.4, DEEP_WAVE_COLOR, out);
        }
        Terrain.Mountains => {
            let (base, radius, cap_radius) = (vec2(0.0, -0.05), 0.55, 0.2);
            peak(center, base, radius, MOUNTAIN_PEAK_COLOR, out);
            // Same shape scaled down so it shares the big peak's apex.
            peak(center, base.add(vec2(0.0, radius - cap_radius)), cap_radius, SNOW_COLOR, out);
        }
    }
}

/// A small wave (or dune), `width` across, centered on `at`.
fn wave(at: Vec2, width: f32, color: Color, out: &mut Vec[MeshVertex]) {
    let (w, h) = (width / 4.0, width * 0.12);
    let mut points: Vec[Vec2] = Vec.new();
    points.push(at.add(vec2(-2.0 * w, 0.0)));
    points.push(at.add(vec2(-w, h)));
    points.push(at);
    points.push(at.add(vec2(w, h)));
    points.push(at.add(vec2(2.0 * w, 0.0)));
    polyline(&points, width * 0.1, color, out);
}

impl GameState {
    /// Rivers along explored hexes' edges, with a round joint at each end so consecutive edges
    /// meet cleanly.
    fn push_rivers(&self, out: &mut Vec[MeshVertex]) {
        for river in self.grid.rivers() {
            let e: Edge = *river;
            if !self.is_explored(e.a) && !self.is_explored(e.b) { continue; }
            let (start, end) = edge_corners(e.a, e.b);
            segment(start, end, RIVER_WIDTH, RIVER_COLOR, out);
            regular_polygon(start, RIVER_WIDTH / 2.0, 12, 0.0, RIVER_COLOR, out);
            regular_polygon(end, RIVER_WIDTH / 2.0, 12, 0.0, RIVER_COLOR, out);
        }
    }
}

/// Spreads `total` markers evenly around a small circle at `base`, or returns `base` itself
/// when there's only one.
fn fan_position(base: Vec2, index: i32, total: i32, radius: f32) -> Vec2 {
    if total <= 1 { return base; }
    base.add(vec2_from_angle(tau() as f32 * index as f32 / total as f32).scale(radius))
}

/// A queued attack's arrow from `from` toward `to`.
fn push_attack_arc(from: Vec2, to: Vec2, out: &mut Vec[MeshVertex]) {
    let points = attack_arc_points(from, to, 1.0);
    push_arrow(&points, ATTACK_ARC_COLOR, ATTACK_ARC_OUTLINE_COLOR, out);
}

/// Points along an attack's curve from `from` toward `to`: a quadratic curve bowing to the
/// left of the direction of travel (so opposing attacks between two hexes don't overlap),
/// from the edge of the attacker's icon to just short of the target. Only the first
/// `progress` (0 to 1) of it, for an arrow still in flight. Empty if the two are too close for
/// an arrow.
pub fn attack_arc_points(from: Vec2, to: Vec2, progress: f32) -> Vec[Vec2] {
    let mut points: Vec[Vec2] = Vec.new();
    let chord = to.sub(from);
    let length = chord.length();
    if length <= ATTACK_ARC_START + ATTACK_ARC_STOP || progress <= 0.0 { return points; }
    let control = from.add(to).scale(0.5).add(chord.perp().scale(ATTACK_ARC_BOW));
    let start = ATTACK_ARC_START / length;
    let end = start + (1.0 - ATTACK_ARC_STOP / length - start) * (if progress < 1.0 { progress } else { 1.0 });
    for i in 0..=ATTACK_ARC_SEGMENTS {
        let t = start + (end - start) * i as f32 / ATTACK_ARC_SEGMENTS as f32;
        points.push(from.lerp(control, t).lerp(control.lerp(to, t), t));
    }
    points
}

/// Draws an arrow along `points` over a darker outline, its head at the last point.
pub fn push_arrow(points: &Vec[Vec2], color: Color, outline: Color, out: &mut Vec[MeshVertex]) {
    let n = points.len();
    if n < 2 { return; }
    let (before, tip) = (points[n - 2], points[n - 1]);
    let d = tip.sub(before);
    let direction = if d.length() > 0.0 { d.normalize() } else { vec2(0.0, 0.0) };
    let passes = [(ATTACK_ARC_OUTLINE_WIDTH, outline), (ATTACK_ARC_WIDTH, color)];
    for k in 0..2 {
        let (width, c) = passes[k];
        polyline(points, width, c, out);
        // The outline pass draws its arrowhead a little bigger all round.
        let grow = (width - ATTACK_ARC_WIDTH) / 2.0;
        let base = tip.sub(direction.scale(grow));
        let side = direction.perp().scale(ATTACK_ARROW_WIDTH / 2.0 + grow);
        let point = tip.add(direction.scale(ATTACK_ARROW_LENGTH + grow));
        triangle(point, base.add(side), base.sub(side), c, out);
    }
}

/// A polygon whose side count encodes the unit type, with `letter` on top.
fn push_unit_icon(center: Vec2, unit: &Unit, letter: char, scale: f32, color: Color, out: &mut Vec[MeshVertex]) {
    // A quarter turn so odd-sided shapes (the melee triangle) point up.
    regular_polygon(center, UNIT_ICON_RADIUS * scale, unit.unit_type.icon_sides(), pi() as f32 / 2.0, color, out);
    push_glyph(center, LABEL_HEIGHT * scale, letter, with_alpha(LABEL_COLOR, color[3]), out);
}

/// Status rings behind the icon. They're filled discs, so only the rim shows once the icon is
/// drawn on top; the larger one goes first so both stay visible. A guarding unit also gets a
/// hex outline around everything.
fn push_status_rings(center: Vec2, unit: &Unit, scale: f32, out: &mut Vec[MeshVertex]) {
    if unit.guarding {
        polygon_outline(center, GUARD_OUTLINE_RADIUS * scale, GUARD_OUTLINE_WIDTH * scale, 6, 0.0, GUARD_OUTLINE_COLOR, out);
    }
    if unit.ability_queued {
        regular_polygon(center, ABILITY_RING_RADIUS * scale, 24, 0.0, ABILITY_RING_COLOR, out);
    }
    if unit.deployed {
        regular_polygon(center, DEPLOYED_RING_RADIUS * scale, 24, 0.0, DEPLOYED_RING_COLOR, out);
    }
}

/// Small numbered badges showing where the unit's type moves and attacks in the turn order.
fn push_order_badges(center: Vec2, unit: &Unit, scale: f32, out: &mut Vec[MeshVertex]) {
    let badges = [
        (-BADGE_OFFSET_X, Phase.Move, MOVE_ORDER_COLOR),
        (BADGE_OFFSET_X, Phase.Attack, ATTACK_ORDER_COLOR),
    ];
    for b in 0..2 {
        let (offset_x, phase, color) = badges[b];
        let pos = center.add(vec2(offset_x * scale, 0.0));
        let digit = (48 + step_rank(unit.unit_type, phase)) as u8 as char;
        regular_polygon(pos, BADGE_RADIUS * scale, 12, 0.0, BADGE_BG_COLOR, out);
        push_glyph(pos, BADGE_DIGIT_HEIGHT * scale, digit, color, out);
    }
}

fn push_health_bar(unit_center: Vec2, hp_fraction: f32, scale: f32, out: &mut Vec[MeshVertex]) {
    let hp = if hp_fraction < 0.0 { 0.0 } else if hp_fraction > 1.0 { 1.0 } else { hp_fraction };
    let size = vec2(HEALTH_BAR_WIDTH, HEALTH_BAR_HEIGHT).scale(scale);
    let min = unit_center.add(vec2(0.0, HEALTH_BAR_OFFSET_Y * scale)).sub(size.scale(0.5));
    quad(min, min.add(size), HEALTH_BAR_BG_COLOR, out);
    quad(min, min.add(vec2(size.x * hp, size.y)), [1.0 - hp, hp, 0.08, 1.0], out);
}

fn brighten(c: Color) -> Color {
    [bright(c[0]), bright(c[1]), bright(c[2]), c[3]]
}

fn bright(v: f32) -> f32 { if v + 0.35 < 1.0 { v + 0.35 } else { 1.0 } }

fn with_alpha(c: Color, a: f32) -> Color { [c[0], c[1], c[2], a] }
