const WORKED_ROUTED_COLOR: Color = [0.25, 1.0, 0.4, 1.0];
const WORKED_CUT_OFF_COLOR: Color = [1.0, 0.25, 0.2, 1.0];
const YIELD_BADGE_COLOR: Color = [0.035, 0.045, 0.045, 0.94];
const FOOD_COLOR: Color = [0.42, 0.96, 0.32, 1.0];
const PRODUCTION_COLOR: Color = [1.0, 0.69, 0.22, 1.0];

/// A queued move is drawn as a faded copy of the unit at its destination.
pub const GHOST_ALPHA: f32 = 0.4;
const GHOST_FAN_RADIUS: f32 = HEX_SIZE * 0.3;

/// A unit following a queue (Shift-click) shows its plan instead of a ghost, while selected or
/// hovered: a line along its moves, each turn's number on the hex it moves to (and on each
/// attack's arrow), all in pills rimmed in team color (orange for attacks). A small tag beside
/// the unit says a queue is there, with the number of turns it has left.
pub const QUEUE_LINE_WIDTH: f32 = 0.07;
pub const QUEUE_LINE_ALPHA: f32 = 0.7;
const QUEUE_DIGIT_HEIGHT: f32 = 0.2;
const QUEUE_BADGE_HALF_HEIGHT: f32 = 0.18;
const QUEUE_BADGE_PADDING: f32 = 0.09;
const QUEUE_BADGE_RIM: f32 = 0.04;
const QUEUE_TEXT_COLOR: Color = [0.95, 0.95, 0.95, 1.0];
const QUEUE_TAG_OFFSET: Vec2 = Vec2 { x: -0.44, y: -0.4 };
/// Where a plan's last number sits from its ghost: below it, clear of the pictogram.
const QUEUE_END_BADGE_OFFSET: Vec2 = Vec2 { x: 0.0, y: -0.36 };
/// The orange hex outline on a click waiting to be repeated to replace a queue.
const QUEUE_REPLACE_OUTLINE_RADIUS: f32 = 0.9;
const QUEUE_REPLACE_OUTLINE_WIDTH: f32 = 0.08;
const QUEUE_TAG_SCALE: f32 = 0.7;

/// Tile yields: below the unit spot, food, wood then metal as die-face pips on a dark
/// see-through pill.
pub const YIELD_ROW_OFFSET: Vec2 = Vec2 { x: 0.0, y: -0.56 };
/// Distance between neighboring pips, across and up.
const YIELD_PIP_PITCH: Vec2 = Vec2 { x: 0.11, y: 0.15 };
const YIELD_ICON_SCALE: f32 = 0.8;
/// How far a pip icon, at that scale, reaches from its center.
const YIELD_ICON_HALF: Vec2 = Vec2 { x: 0.05, y: 0.076 };
/// Space between the groups.
const YIELD_GROUP_GAP: f32 = 0.08;
/// The most a row reaches from its center each way: three full groups are shrunk to fit.
const YIELD_ROW_MAX_HALF_WIDTH: f32 = 0.46;
const YIELD_ROW_PADDING: Vec2 = Vec2 { x: 0.06, y: 0.035 };
const YIELD_PIP_CORNER: f32 = 0.1;
pub const YIELD_ROW_COLOR: Color = [0.005, 0.006, 0.007, 0.85];
/// Past six, a yield is one icon and its amount.
const YIELD_DIGIT_HEIGHT: f32 = 0.12;
const YIELD_DIGIT_COLOR: Color = [0.95, 0.95, 0.95, 1.0];
const YIELD_NUMBER_GAP: f32 = 0.03;

/// A queued swap is drawn as a link between the two allies.
const SWAP_LINK_WIDTH: f32 = 0.1;
const SWAP_LINK_ALPHA: f32 = 0.8;

/// A queued attack is drawn as a curved arrow from the attacker (or its ghost, if it's
/// moving first) to the hex it's attacking.
pub const ATTACK_ARC_COLOR: Color = [1.00, 0.45, 0.30, 1.0];
const ATTACK_ARC_OUTLINE_COLOR: Color = [0.08, 0.03, 0.02, 1.0];
const ATTACK_ARC_WIDTH: f32 = 0.07;
const ATTACK_ARC_OUTLINE_WIDTH: f32 = 0.13;
/// How far the arc bows sideways, as a share of its length.
const ATTACK_ARC_BOW: f32 = 0.25;
/// The arc starts at the edge of the attacker's icon and stops short of the target's
/// center, so a unit drawn there doesn't hide the arrowhead.
const ATTACK_ARC_START: f32 = UNIT_ICON_RADIUS;
const ATTACK_ARC_STOP: f32 = HEX_SIZE * 0.55;
const ATTACK_ARC_SEGMENTS: i32 = 20;
const ATTACK_ARROW_LENGTH: f32 = 0.28;
const ATTACK_ARROW_WIDTH: f32 = 0.26;

/// What the selected unit can do this turn, computed once per frame.
struct Selection {
    pos: Hex,
    planned_pos: Hex,
    team: Team,
    stats: UnitStats,
    reachable: Set[Hex],
    /// Locked in a contested hex, so it can't attack anything else.
    locked: bool,
    /// Swap is armed, so adjacent allies are the hexes to highlight.
    swapping: bool,
}

impl GameState {
    /// The whole scene as a triangle list, back to front: hex grid, queued order markers, then
    /// units.
    pub fn build_vertices(&self) -> Vec[MeshVertex] {
        if let Option.Some(city) = self.interior_view { return self.build_interior_vertices(city); }
        let mut out: Vec[MeshVertex] = Vec.new();
        let fog = self.fog();

        let selection = match self.selected {
            Option.Some(idx) => {
                let unit = &self.units[idx];
                let stats = unit.stats();
                // A green hex means clicking moves there, which isn't true while an attack or
                // swap is armed.
                let shows_moves = match self.ui_click_mode { Option.None | Option.Some(ClickMode.Move) => true, _ => false };
                Option.Some(Selection {
                    pos: unit.pos,
                    planned_pos: unit.planned_pos(),
                    team: unit.team,
                    stats,
                    reachable: if shows_moves { self.known_reachable_hexes(unit.pos, stats.move_range, unit.team, &fog) } else { Set.new() },
                    locked: self.rival_of(idx).is_some(),
                    swapping: self.ui_click_mode == Option.Some(ClickMode.Swap),
                })
            }
            Option.None => Option.None,
        };

        // Only what the camera may show: a big map has far more hexes than a view, and more
        // vertices than a frame draws.
        let (view_min, view_max) = self.view_rect();
        // The fog sits behind the map: a flat fill over every never-seen hex, and the drifting
        // cloud field on top of it unless the player chose solid fog. Known terrain painted
        // afterward hides it without clipping or rebuilding around sight.
        if self.fog_of_war {
            let cloud = self.settings.cloud_fog;
            let base = if cloud { CLOUD_BASE_COLOR } else { SOLID_FOG_COLOR };
            for h in self.grid.hexes() {
                let hex = *h;
                let center = hex.to_world();
                if center.x < view_min.x - 1.0 || center.y < view_min.y - 1.0 || center.x > view_max.x + 1.0 || center.y > view_max.y + 1.0 { continue; }
                if !self.is_explored(hex) { regular_polygon(center, HEX_SIZE, 6, 0.0, base, &mut out); }
            }
            if cloud { push_cloud_banks(&self.grid, self.cloud_time, view_min, view_max, &mut out); }
        }
        // Never-seen hexes aren't drawn at all: the fog shows there. Every border first, each
        // reaching across the whole gap: the fills drawn next cover what lies inside an explored
        // neighbor, leaving a full-width border facing never-seen hexes and the map's edge.
        for h in self.grid.hexes() {
            let hex = *h;
            let center = hex.to_world();
            if center.x < view_min.x - 1.0 || center.y < view_min.y - 1.0 || center.x > view_max.x + 1.0 || center.y > view_max.y + 1.0 { continue; }
            if self.is_explored(hex) { regular_polygon(center, OUTER_BORDER_RADIUS, 6, 0.0, BORDER_COLOR, &mut out); }
        }
        for h in self.grid.hexes() {
            let hex = *h;
            let center = hex.to_world();
            if center.x < view_min.x - 1.0 || center.y < view_min.y - 1.0 || center.x > view_max.x + 1.0 || center.y > view_max.y + 1.0 { continue; }
            if !self.is_explored(hex) { continue; }
            let fill = self.hex_fill(hex, &selection, &fog);
            regular_polygon(center, HEX_SIZE * HEX_FILL_SCALE, 6, 0.0, fill, &mut out);
            push_tile_symbols(center, self.grid.tile(hex), &mut out);
            // A resource in the top-right corner, an improvement (as the player knows it) in the
            // top-left, a special tile or ruins in the bottom-left.
            if let Option.Some(resource) = self.grid.resource(hex) { push_map_icon(center.add(RESOURCE_SPOT), MapIcon.resource(resource), 1.0, &mut out); }
            if let Option.Some(kind) = self.known_site_kind(hex, &fog) { push_map_icon(center.add(IMPROVEMENT_SPOT), MapIcon.improvement(kind), 1.0, &mut out); }
            if let Option.Some(special) = self.grid.special(hex) {
                polygon_outline(center, HEX_SIZE * 0.92 - LANDMARK_RIM_WIDTH / 2.0, LANDMARK_RIM_WIDTH, 6, 0.0, SPECIAL_RIM_COLOR, &mut out);
                push_map_icon(center.add(LANDMARK_SPOT), MapIcon.special(special), LANDMARK_SCALE, &mut out);
            }
            self.push_known_ruin(hex, &fog, &mut out);
            self.push_known_den(hex, &fog, &mut out);
        }
        self.push_rivers(&mut out);

        self.push_city_map(&mut out);
        self.push_structures(&fog, &mut out);
        self.push_fog(&fog, view_min, view_max, &mut out);
        self.push_worker_reach(&mut out);
        self.push_turn_dim(&mut out);
        self.push_order_markers(&fog, &mut out);

        for idx in 0..self.units.len() {
            let unit = &self.units[idx];
            if !fog.shows(unit) { continue; }
            let (center, scale) = self.drawn_unit_layout(idx);
            let (icon_scale, color) = if self.recent_actors.contains(unit.id) {
                (scale * ACTED_SCALE, brighten(unit.team.color()))
            } else {
                (scale, unit.team.color())
            };
            push_status_rings(center, unit, scale, &mut out);
            push_unit_icon(center, self.unit_look(unit), icon_scale, color, &mut out);
            if self.show_details { push_order_badges(center, unit, scale, &mut out); }
            push_health_bar(center, unit.hp / unit.max_hp(), scale, &mut out);
            if unit.plans_later_turns() && self.is_player_controlled(idx) {
                let tag = text(fn() can {Out} { show_i64(unit.plan_len() as i64); Out.put("T"); });
                let at = center.add(QUEUE_TAG_OFFSET.scale(scale));
                push_turn_badge(at, &tag, QUEUE_TAG_SCALE * scale, unit.team.color(), &mut out);
            }
        }

        if let Option.Some(preview) = self.attack_preview() { self.push_attack_preview(&preview, &mut out); }
        self.push_field_workers(&fog, &mut out);

        self.push_tile_yields(&mut out);
        self.push_effects(&mut out);
        out
    }

    /// Ghosts at queued move destinations, links between allies queued to swap, and arrows
    /// for the player's queued attacks. Ghosts of units sharing a destination are fanned out so
    /// each order stays visible. Units whose queue reaches past this turn show their numbered
    /// plan instead, and only while selected or hovered; a queue of this turn alone draws like
    /// plain orders.
    fn push_order_markers(&self, fog: &Fog, out: &mut Vec[MeshVertex]) {
        let n = self.units.len();
        // Units drawn with plain markers: not swapping, not planning later turns, and shown.
        // Another side's move shows only in sight at both ends: its units carry their moves
        // while a turn plays out.
        let mut swapping: Vec[bool] = Vec.new();
        for i in 0..n {
            let unit = &self.units[i];
            let unseen_move = match unit.planned_move { Option.Some(dest) => unit.team != fog.team() && !fog.sees(dest), Option.None => false };
            swapping.push(self.swap_partner(i).is_some() || unit.plans_later_turns() || !fog.shows(unit) || unseen_move);
        }

        // Where each moving unit's ghost is drawn, for its attack arc. Groups by target hex in
        // first-seen order, so the layout is stable across frames.
        let mut ghosts: Map[i64, Vec2] = Map.new();
        let mut move_targets: Vec[Hex] = Vec.new();
        for i in 0..n {
            if let Option.Some(hex) = self.units[i].planned_move {
                if !swapping[i] && !move_targets.contains(hex) { move_targets.push(hex); }
            }
        }
        for t in 0..move_targets.len() {
            let hex = move_targets[t];
            let total = self.count_moving_to(n, &swapping, hex);
            let mut k = 0;
            for i in 0..n {
                let unit = &self.units[i];
                if !swapping[i] && unit.planned_move == Option.Some(hex) {
                    let pos = fan_position(hex.to_world(), k, total, GHOST_FAN_RADIUS);
                    push_unit_icon(pos, self.unit_look(unit), 1.0, with_alpha(unit.team.color(), GHOST_ALPHA), out);
                    let _old = ghosts.insert(unit.id as i64, pos);
                    k = k + 1;
                }
            }
        }

        for idx in 0..n {
            if let Option.Some(partner) = self.swap_partner(idx) {
                if partner > idx && fog.shows(&self.units[idx]) && fog.shows(&self.units[partner]) {
                    let color = with_alpha(self.units[idx].team.color(), SWAP_LINK_ALPHA);
                    segment(self.units[idx].pos.to_world(), self.units[partner].pos.to_world(), SWAP_LINK_WIDTH, color, out);
                }
            }
        }

        // Only the player's own attacks: the AI's plans aren't theirs to see.
        for idx in 0..n {
            let unit = &self.units[idx];
            let Option.Some(target) = unit.planned_attack else { continue; };
            if !self.is_player_controlled(idx) || unit.plans_later_turns() { continue; }
            // Swapping units attack from their partner's hex.
            let from = match ghosts.get(unit.id as i64) {
                Option.Some(ghost) => ghost,
                Option.None => if unit.planned_move.is_some() { unit.planned_pos().to_world() } else { self.unit_layout(idx).0 },
            };
            push_attack_arc(from, target.to_world(), out);
        }

        let selection = self.selection();
        let hovered = match self.hovered_tile { Option.Some(hex) => self.controlled_unit_at(hex), Option.None => Option.None };
        let mut planning: Vec[i32] = Vec.new();
        for i in 0..n {
            if !(selection.contains(i) || hovered == Option.Some(i)) { continue; }
            if self.units[i].plans_later_turns() && self.is_player_controlled(i) { planning.push(i); }
        }
        self.push_queue_plans(&planning, out);
        // A click waiting to be repeated to replace the selection's queue.
        if let Option.Some(hex) = self.queue_replace_hex() {
            polygon_outline(hex.to_world(), HEX_SIZE * QUEUE_REPLACE_OUTLINE_RADIUS, QUEUE_REPLACE_OUTLINE_WIDTH, 6, 0.0, ATTACK_ARC_COLOR, out);
        }
    }

    /// The plans of units `which` following a queue, each unit's on its own: a line from the
    /// unit through each hex it moves to, numbered by turn (1 is this turn), ending in a faded
    /// ghost of the unit where its plan leaves it; its attacks are arrows from where it stands
    /// that turn, numbered at their middle. Where several units' plans stop on one hex, each
    /// unit's stop is fanned out around it (as ghosts are), so a number never belongs to two
    /// units. A hex or arrow one unit uses on several turns lists them ("2,4").
    fn push_queue_plans(&self, which: &Vec[i32], out: &mut Vec[MeshVertex]) {
        let plans = queue_plans(&self.units, which);
        for k in 0..plans.lines.len() {
            let line = plans.lines[k];
            segment(line.from, line.to, QUEUE_LINE_WIDTH, line.color, out);
        }
        for k in 0..plans.ghosts.len() {
            let ghost = plans.ghosts[k];
            let unit = &self.units[ghost.unit];
            push_unit_icon(ghost.at, self.unit_look(unit), 1.0, ghost.color, out);
        }
        for k in 0..plans.arrows.len() { push_arrow(&plans.arrows[k], ATTACK_ARC_COLOR, ATTACK_ARC_OUTLINE_COLOR, out); }
        for k in 0..plans.badges.len() {
            let badge = &plans.badges[k];
            push_turn_badge(badge.at, &badge.text, 1.0, badge.rim, out);
        }
    }

    /// How many units have a plain (not swapping) move queued to `hex`.
    fn count_moving_to(&self, n: i32, swapping: &Vec[bool], hex: Hex) -> i32 {
        let mut total = 0;
        for i in 0..n {
            if !swapping[i] && self.units[i].planned_move == Option.Some(hex) { total = total + 1; }
        }
        total
    }

    /// Where to draw a unit and at what scale: full size in the middle of its hex, or half size
    /// and offset when it shares a contested hex.
    pub fn unit_layout(&self, idx: i32) -> (Vec2, f32) {
        let unit = &self.units[idx];
        let center = unit.pos.to_world();
        if self.rival_of(idx).is_none() { return (center, 1.0); }
        let offset_y = if unit.team == Team.Blue { CONTESTED_OFFSET_Y } else { -CONTESTED_OFFSET_Y };
        (center.add(vec2(0.0, offset_y)), CONTESTED_SCALE)
    }

    /// The terrain's color, unless the hex is selected, contested, or in the selected unit's
    /// move or attack range. Mountains are never highlighted since nothing can move to or stand
    /// on them.
    fn hex_fill(&self, hex: Hex, selection: &Option[Selection], fog: &Fog) -> Color {
        let tile = self.grid.tile(hex);
        let base = tile_color(tile);
        if !tile.terrain.is_passable() { return base; }
        let mut in_group = false;
        for m in 0..self.group.len() {
            if self.units[self.group[m]].pos == hex { in_group = true; }
        }
        if in_group { return SELECTED_COLOR; }
        let &Option.Some(sel) = selection else {
            return if fog.sees(hex) && self.is_contested(hex) { CONTESTED_COLOR } else { base };
        };
        if sel.pos == hex { return SELECTED_COLOR; }
        // Only in sight: out of it, no unit is known to be anywhere.
        if fog.sees(hex) && self.is_contested(hex) { return CONTESTED_COLOR; }
        if sel.swapping {
            let swappable = sel.pos.distance(hex) == 1 && self.controlled_unit_at(hex).is_some();
            return if swappable { MOVE_RANGE_COLOR } else { base };
        }

        let in_attack_range = !sel.locked && sel.planned_pos.distance(hex) <= sel.stats.attack_range;
        let has_enemy = self.known_enemy_target_at(hex, sel.team, fog);
        if self.known_occupied(hex, fog) {
            return if has_enemy && in_attack_range { ATTACK_RANGE_COLOR } else { base };
        }
        if sel.reachable.contains(hex) {
            MOVE_RANGE_COLOR
        } else if in_attack_range {
            ATTACK_RANGE_EMPTY_COLOR
        } else {
            base
        }
    }
}

impl GameState {
    /// Roads, the open or hovered city's worked tiles and delivery shares, site letters and
    /// the cities themselves.
    fn push_city_map(&self, out: &mut Vec[MeshVertex]) {
        // Roads and cities as the player knows them: nothing in the fog.
        let fog = self.fog();
        for r in 0..self.roads.len() {
            let Option.Some(h) = self.roads.key_at(r) else { continue; };
            if !self.known_road(h, &fog) { continue; }
            regular_polygon(h.to_world(), 0.12, 8, 0.0, ROAD_COLOR, out);
            let around = h.neighbors();
            for k in 0..6 {
                let n = around[k];
                let ordered = h.q < n.q || (h.q == n.q && h.r < n.r);
                let known = self.known_road(n, &fog) || self.known_city_team(n, &fog).is_some();
                if ordered && self.is_road_hex(n) && known { segment(h.to_world(), n.to_world(), 0.09, ROAD_COLOR, out); }
            }
        }
        // Road segments reaching a city are drawn even though the city center itself is
        // represented by its larger city marker.
        for c in 0..self.cities.len() {
            let pos = self.cities[c].pos;
            if self.known_city_team(pos, &fog).is_none() { continue; }
            let around = pos.neighbors();
            for k in 0..6 {
                if self.roads.contains(around[k]) && self.known_road(around[k], &fog) { segment(pos.to_world(), around[k].to_world(), 0.09, ROAD_COLOR, out); }
            }
        }
        let shown = match self.hovered_city { Option.Some(i) => Option.Some(i), Option.None => self.selected_city };
        if let Option.Some(i) = shown {
            // Delivery labels show routes as the player knows them; the worked-tile rings below
            // show whether goods really arrive. Of another side's city, only the tiles it works
            // in sight show, and not whether their goods arrive: its routes aren't known.
            let own = self.cities[i].team == fog.team();
            let routes = self.known_routes(i, &fog);
            let real: Option[Routes] = if own { Option.Some(self.routes(i)) } else { Option.None };
            if self.yields_city() == Option.Some(i) {
                for r in 0..routes.costs.len() {
                    let Option.Some(h) = routes.costs.key_at(r) else { continue; };
                    let Option.Some(cost) = routes.costs.val_at(r) else { continue; };
                    // Nothing shows in the fog.
                    if !self.is_explored(h) { continue; }
                    let food_share = self.mill_food_share(i, h, cost);
                    let share = delivered_share(cost);
                    let label = text(fn() can {Out} {
                        if food_share == share {
                            show_i64((food_share * 25) as i64); Out.put("%");
                        } else {
                            Out.put("F"); show_i64((food_share * 25) as i64); Out.put(" P"); show_i64((share * 25) as i64);
                        }
                    });
                    push_text(h.to_world().add(vec2(-0.3, 0.52)), 0.18, &label, DELIVERY_TEXT_COLOR, out);
                }
            }
            // A manager picked up takes its cluster with it until it's placed: none show.
            let clusters = &self.cities[i].clusters;
            for k in 0..clusters.len() {
                if self.is_moving_manager(i, k) { continue; }
                let tiles = clusters[k].tiles();
                for w in 0..tiles.len() {
                    let h = tiles[w];
                    if !own && !fog.sees(h) { continue; }
                    let arrives = match &real { &Option.Some(r) => r.costs.has(h), &Option.None => true };
                    let color = if arrives { WORKED_ROUTED_COLOR } else { WORKED_CUT_OFF_COLOR };
                    // A coloured ring on a slightly wider dark one, just inside the hex's fill so
                    // it doesn't blur into the grid lines.
                    let center = h.to_world();
                    polygon_outline(center, WORKED_OUTLINE_RADIUS, WORKED_OUTLINE_RIM_WIDTH, 6, 0.0, WORKED_OUTLINE_RIM_COLOR, out);
                    polygon_outline(center, WORKED_OUTLINE_RADIUS, WORKED_OUTLINE_WIDTH, 6, 0.0, color, out);
                }
            }
        }
        for c in 0..self.cities.len() {
            let hex = self.cities[c].pos;
            let Option.Some(team) = self.known_city_team(hex, &fog) else { continue; };
            // In sight, as it is; out of sight, as last seen.
            let population = if fog.sees(hex) { self.cities[c].population } else {
                match self.memory.get(hex) {
                    Option.Some(seen) => match seen.city { Option.Some(city) => city.population, Option.None => self.cities[c].population },
                    Option.None => self.cities[c].population,
                }
            };
            push_city_marker(hex.to_world(), team, population, out);
        }
    }

    /// Alt: holding it shows extra map info (units' turn order, every tile's yields); releasing
    /// it hides it again.
    pub fn set_details(&mut self, held: bool) { self.show_details = held; }

    /// Whether the player knows of a city or placed building on `hex`, which shows no yields
    /// (`closed_to_citizens`): their own always, anyone's in sight, and a remembered city or
    /// barracks. City centers keep their chips: their own yield comes in on its own.
    fn known_building_at_off_center(&self, hex: Hex, fog: &Fog) -> bool {
        let mut center = false;
        for c in 0..self.cities.len() { if self.cities[c].pos == hex { center = true; } }
        if !center && !fog.sees(hex) {
            if let Option.Some(seen) = self.memory.get(hex) { if seen.city.is_some() { center = true; } }
        }
        !center && self.known_building_at(hex, fog)
    }

    fn known_building_at(&self, hex: Hex, fog: &Fog) -> bool {
        let mut own = false;
        for c in 0..self.cities.len() {
            if self.cities[c].team != self.local_team { continue; }
            if self.cities[c].pos == hex { own = true; }
            for b in 0..14 { if self.cities[c].placed_site(PLACEABLE[b]) == Option.Some(hex) { own = true; } }
        }
        if own || fog.sees(hex) { return self.closed_to_citizens(hex); }
        match self.memory.get(hex) { Option.Some(seen) => seen.city.is_some() || seen.barracks.is_some(), Option.None => false }
    }

    /// Yield chips below the unit spot: while Alt is held, on every explored tile that can be
    /// worked; otherwise, while the open city shows its yields, on the tiles within its
    /// economic reach.
    fn push_tile_yields(&self, out: &mut Vec[MeshVertex]) {
        let city = self.yields_city();
        if city.is_none() && !self.show_details { return; }
        let fog = self.fog();
        let (view_min, view_max) = self.view_rect();
        // The open city's routes, worked out once for every hex.
        let routes = match city { Option.Some(c) => Option.Some(self.known_routes(c, &fog)), Option.None => Option.None };
        for h in self.grid.hexes() {
            let hex = *h;
            let center = hex.to_world();
            if center.x < view_min.x - 1.0 || center.y < view_min.y - 1.0 || center.x > view_max.x + 1.0 || center.y > view_max.y + 1.0 { continue; }
            if !self.grid.terrain(hex).is_workable() || !self.is_explored(hex) { continue; }
            let in_reach = match city {
                Option.Some(c) => match &routes { &Option.Some(r) => r.costs.has(hex) || self.cities[c].works(hex), &Option.None => false },
                Option.None => false,
            };
            if !in_reach && !self.show_details { continue; }
            if self.known_building_at_off_center(hex, &fog) { continue; }
            let goods = self.known_yield(hex, &fog);
            push_yield_row(center.add(YIELD_ROW_OFFSET), goods, out);
        }
    }
}

/// One icon of a yield row, or one amount past six, at an offset from the row's center.
pub struct YieldIcon { icon: MapIcon, at: Vec2 }
pub struct YieldLabel { amount: i32, at: Vec2 }

/// A yield row's contents, as offsets from its center.
pub struct YieldRow {
    /// Icons in drawing order: within a group, higher ones first so lower ones overlap them.
    icons: Vec[YieldIcon],
    /// Amounts past six, beside their single icon.
    labels: Vec[YieldLabel],
    /// How far the pill reaches each way.
    half: Vec2,
    /// How much the row was shrunk to fit its hex (1 if it fit).
    scale: f32,
}

/// Where the pips for 1 to 6 go, in pip pitches, top row first: a die's faces, but 2 side by
/// side, 3 a triangle and 6 two rows of three. Empty past six.
fn pip_spots(amount: i32) -> Vec[Vec2] {
    let mut out: Vec[Vec2] = Vec.new();
    if amount == 1 { out.push(vec2(0.0, 0.0)); }
    if amount == 2 { out.push(vec2(-0.5, 0.0)); out.push(vec2(0.5, 0.0)); }
    if amount == 3 { out.push(vec2(0.0, 0.5)); out.push(vec2(-0.5, -0.5)); out.push(vec2(0.5, -0.5)); }
    if amount == 4 { out.push(vec2(-0.5, 0.5)); out.push(vec2(0.5, 0.5)); out.push(vec2(-0.5, -0.5)); out.push(vec2(0.5, -0.5)); }
    if amount == 5 { out.push(vec2(-1.0, 0.7)); out.push(vec2(1.0, 0.7)); out.push(vec2(0.0, 0.0)); out.push(vec2(-1.0, -0.7)); out.push(vec2(1.0, -0.7)); }
    if amount == 6 {
        out.push(vec2(-1.0, 0.5)); out.push(vec2(0.0, 0.5)); out.push(vec2(1.0, 0.5));
        out.push(vec2(-1.0, -0.5)); out.push(vec2(0.0, -0.5)); out.push(vec2(1.0, -0.5));
    }
    out
}

fn abs_f32(x: f32) -> f32 { if x < 0.0 { -x } else { x } }

/// One yield group (food, wood or metal) around its own center.
fn yield_group(icon: MapIcon, amount: i32) -> YieldRow {
    let spots = pip_spots(amount);
    if spots.is_empty() {
        // Past six: one icon, then the number.
        let digits = text(fn() can {Out} { show_i64(amount as i64); });
        let width = world_text_width(&digits, YIELD_DIGIT_HEIGHT);
        let half_x = YIELD_ICON_HALF.x + (YIELD_NUMBER_GAP + width) / 2.0;
        let mut icons: Vec[YieldIcon] = Vec.new();
        icons.push(YieldIcon { icon, at: vec2(YIELD_ICON_HALF.x - half_x, 0.0) });
        let mut labels: Vec[YieldLabel] = Vec.new();
        labels.push(YieldLabel { amount, at: vec2(half_x - width / 2.0, 0.0) });
        return YieldRow { icons, labels, half: vec2(half_x, YIELD_ICON_HALF.y), scale: 1.0 };
    }
    let mut icons: Vec[YieldIcon] = Vec.new();
    let mut reach = vec2(0.0, 0.0);
    for k in 0..spots.len() {
        let at = vec2(spots[k].x * YIELD_PIP_PITCH.x, spots[k].y * YIELD_PIP_PITCH.y);
        reach = reach.max(vec2(abs_f32(at.x), abs_f32(at.y)));
        icons.push(YieldIcon { icon, at });
    }
    YieldRow { icons, labels: Vec.new(), half: reach.add(YIELD_ICON_HALF), scale: 1.0 }
}

/// Lays out a tile's food, wood and metal groups side by side, centered.
pub fn yield_row(goods: (i32, i32, i32)) -> YieldRow {
    let (food, wood, metal) = goods;
    let mut groups: Vec[YieldRow] = Vec.new();
    if food > 0 { groups.push(yield_group(MapIcon.Food, food)); }
    if wood > 0 { groups.push(yield_group(MapIcon.Wood, wood)); }
    if metal > 0 { groups.push(yield_group(MapIcon.Metal, metal)); }
    let mut row = YieldRow { icons: Vec.new(), labels: Vec.new(), half: vec2(0.0, 0.0), scale: 1.0 };
    if groups.is_empty() { return row; }
    let mut width = YIELD_GROUP_GAP * (groups.len() - 1) as f32;
    for g in 0..groups.len() { width = width + 2.0 * groups[g].half.x; }
    let mut left = -width / 2.0;
    let mut tall = 0.0;
    for g in 0..groups.len() {
        let group = &groups[g];
        let shift = vec2(left + group.half.x, 0.0);
        for k in 0..group.icons.len() { row.icons.push(YieldIcon { icon: group.icons[k].icon, at: group.icons[k].at.add(shift) }); }
        for k in 0..group.labels.len() { row.labels.push(YieldLabel { amount: group.labels[k].amount, at: group.labels[k].at.add(shift) }); }
        if group.half.y > tall { tall = group.half.y; }
        left = left + 2.0 * group.half.x + YIELD_GROUP_GAP;
    }
    row.half = vec2(width / 2.0, tall).add(YIELD_ROW_PADDING);
    // Three full groups would reach past the hex: shrink the whole row.
    if row.half.x > YIELD_ROW_MAX_HALF_WIDTH {
        let shrink = YIELD_ROW_MAX_HALF_WIDTH / row.half.x;
        for k in 0..row.icons.len() { row.icons[k].at = row.icons[k].at.scale(shrink); }
        for k in 0..row.labels.len() { row.labels[k].at = row.labels[k].at.scale(shrink); }
        row.half = row.half.scale(shrink);
        row.scale = shrink;
    }
    row
}
/// A tile's yields on a dark pill: food, wood then metal, each laid out like the pips on a die,
/// or as one icon and a number past six. Nothing for a tile yielding nothing.
pub fn push_yield_row(center: Vec2, goods: (i32, i32, i32), out: &mut Vec[MeshVertex]) {
    let row = yield_row(goods);
    if row.icons.is_empty() { return; }
    polygon(&rounded_rect(center, row.half, YIELD_PIP_CORNER), YIELD_ROW_COLOR, out);
    for k in 0..row.icons.len() { push_map_icon(center.add(row.icons[k].at), row.icons[k].icon, YIELD_ICON_SCALE * row.scale, out); }
    for k in 0..row.labels.len() {
        let amount = row.labels[k].amount;
        let digits = text(fn() can {Out} { show_i64(amount as i64); });
        let height = YIELD_DIGIT_HEIGHT * row.scale;
        let width = world_text_width(&digits, height);
        let at = center.add(row.labels[k].at);
        push_text(at.sub(vec2(width / 2.0, height / 2.0)), height, &digits, YIELD_DIGIT_COLOR, out);
    }
}
/// The corners of a rectangle with rounded corners of `radius`, centered on `center` and
/// reaching `half` out each way.
fn rounded_rect(center: Vec2, half: Vec2, radius: f32) -> Vec[Vec2] {
    let steps = 4;
    let inner = half.sub(vec2(radius, radius));
    let signs = [vec2(1.0, 1.0), vec2(-1.0, 1.0), vec2(-1.0, -1.0), vec2(1.0, -1.0)];
    let mut out: Vec[Vec2] = Vec.new();
    for quarter in 0..4 {
        let corner = center.add(vec2(inner.x * signs[quarter].x, inner.y * signs[quarter].y));
        for step in 0..=steps {
            let angle = (quarter * steps + step) as f32 / (4 * steps) as f32 * tau() as f32;
            out.push(corner.add(vec2_from_angle(angle).scale(radius)));
        }
    }
    out
}

impl GameState {
    /// Darkens remembered hexes (explored, out of sight now) in the view: drawn over the map
    /// and cities but under units and orders.
    fn push_fog(&self, fog: &Fog, view_min: Vec2, view_max: Vec2, out: &mut Vec[MeshVertex]) {
        if !self.fog_of_war { return; }
        let mut remembered: Vec[Hex] = Vec.new();
        for h in self.grid.hexes() {
            let hex = *h;
            let center = hex.to_world();
            if center.x < view_min.x - 1.0 || center.y < view_min.y - 1.0 || center.x > view_max.x + 1.0 || center.y > view_max.y + 1.0 { continue; }
            if self.is_explored(hex) && !fog.sees(hex) { remembered.push(hex); }
        }
        for k in 0..remembered.len() {
            let hex = remembered[k];
            let center = hex.to_world();
            regular_polygon(center, HEX_SIZE, 6, 0.0, REMEMBERED_TINT, out);
            // Facing blank, the border reaches past the hex (see OUTER_BORDER_RADIUS); veil
            // that outer half too, so the band is one shade.
            let around = hex.neighbors();
            for n in 0..6 {
                let other = around[n];
                if self.grid.contains(other) && self.is_explored(other) { continue; }
                let (a, b) = edge_corners(hex, other);
                let grow = OUTER_BORDER_RADIUS / HEX_SIZE;
                let mut band: Vec[Vec2] = Vec.new();
                band.push(a);
                band.push(b);
                band.push(center.add(b.sub(center).scale(grow)));
                band.push(center.add(a.sub(center).scale(grow)));
                polygon(&band, REMEMBERED_TINT, out);
            }
        }
        // A light line where remembered hexes meet hexes in sight, wide enough to cover the
        // gap, and a river whole.
        for k in 0..remembered.len() {
            let hex = remembered[k];
            let around = hex.neighbors();
            for n in 0..6 {
                let other = around[n];
                if !self.grid.contains(other) || !fog.sees(other) { continue; }
                let (a, b) = edge_corners(hex, other);
                let width = if self.grid.has_river(hex, other) { FOG_RIVER_EDGE_WIDTH } else { FOG_EDGE_WIDTH };
                segment(a, b, width, FOG_EDGE_COLOR, out);
                // Round the joints where edges meet at a corner.
                regular_polygon(a, width / 2.0, 12, 0.0, FOG_EDGE_COLOR, out);
                regular_polygon(b, width / 2.0, 12, 0.0, FOG_EDGE_COLOR, out);
            }
        }
    }

    /// The world rectangle a view may show: as tall as the camera sees and as wide as the widest
    /// window it's drawn in (`MAX_VIEW_ASPECT`).
    pub fn view_rect(&self) -> (Vec2, Vec2) {
        let half = self.camera.half_height;
        let reach = vec2(half * MAX_VIEW_ASPECT, half);
        (self.camera.center.sub(reach), self.camera.center.add(reach))
    }

    /// Ruins on `hex` as the player knows them: in sight, with a pip for each turn their holder
    /// has held them, in its color; out of sight, as last seen, without.
    /// An animal den on `hex` as the player knows it (`animals.tua`): in sight, or out of sight
    /// as last seen. A dark rim and a paw print.
    fn push_known_den(&self, hex: Hex, fog: &Fog, out: &mut Vec[MeshVertex]) {
        let known = if fog.sees(hex) {
            self.den_at(hex).is_some()
        } else {
            match self.memory.get(hex) { Option.Some(seen) => seen.den.is_some(), Option.None => false }
        };
        if !known { return; }
        let center = hex.to_world();
        polygon_outline(center, HEX_SIZE * 0.92 - LANDMARK_RIM_WIDTH / 2.0, LANDMARK_RIM_WIDTH, 6, 0.0, DEN_RIM_COLOR, out);
        push_map_icon(center.add(LANDMARK_SPOT), MapIcon.Paw, LANDMARK_SCALE, out);
    }

    fn push_known_ruin(&self, hex: Hex, fog: &Fog, out: &mut Vec[MeshVertex]) {
        if !self.known_ruin(hex, fog) { return; }
        let center = hex.to_world();
        polygon_outline(center, HEX_SIZE * 0.92 - LANDMARK_RIM_WIDTH / 2.0, LANDMARK_RIM_WIDTH, 6, 0.0, RUIN_RIM_COLOR, out);
        push_map_icon(center.add(LANDMARK_SPOT), MapIcon.Ruins, LANDMARK_SCALE, out);
        if !fog.sees(hex) { return; }
        let Option.Some(i) = self.ruin_at(hex) else { return; };
        let color = match self.ruins[i].holder { Option.Some(t) => t.color(), Option.None => BORDER_COLOR };
        for k in 0..RUIN_HOLD_TURNS {
            let pip = center.add(RUIN_PIPS).add(vec2(k as f32 * RUIN_PIP_GAP, 0.0));
            let fill = if k < self.ruins[i].held { color } else { BORDER_COLOR };
            regular_polygon(pip, RUIN_PIP_RADIUS + 0.012, 6, 0.0, BORDER_COLOR, out);
            regular_polygon(pip, RUIN_PIP_RADIUS, 6, 0.0, fill, out);
        }
    }
}

/// The ground's color, tinted green under forest or jungle.
fn tile_color(tile: Tile) -> Color {
    let ground = match tile.terrain {
        Terrain.Grassland => GRASSLAND_COLOR,
        Terrain.Plains => PLAINS_COLOR,
        Terrain.Desert => DESERT_COLOR,
        Terrain.Tundra => TUNDRA_COLOR,
        Terrain.Snow => SNOWFIELD_COLOR,
        Terrain.Marsh => MARSH_COLOR,
        Terrain.Mountains => MOUNTAIN_COLOR,
        Terrain.Coast => COAST_COLOR,
        Terrain.Ocean => OCEAN_COLOR,
        Terrain.Lake => LAKE_COLOR,
    };
    match tile.feature {
        Option.Some(Feature.Forest) => mix(ground, FOREST_COLOR, 0.5),
        Option.Some(Feature.Jungle) => mix(ground, JUNGLE_COLOR, 0.6),
        Option.None => ground,
    }
}

fn mix(a: Color, b: Color, t: f32) -> Color {
    [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t, a[3] + (b[3] - a[3]) * t]
}

/// A triangle rotated a quarter turn points straight up.
fn peak(center: Vec2, offset: Vec2, radius: f32, color: Color, out: &mut Vec[MeshVertex]) {
    regular_polygon(center.add(offset), radius, 3, pi() as f32 / 2.0, color, out);
}

/// Symbols drawn over the hex fill, so a tile stays recognizable under selection highlights.
/// They sit clear of the middle, where a unit's icon goes. Hills are two small peaks in a darker
/// shade of their ground along the bottom; forest (pines) and jungle (round canopies) go along
/// the bottom too, or along the top on hills. Bare ground gets its own marks along the bottom:
/// dunes for desert, grass tufts for tundra, reeds for marsh. Mountains get one large
/// snow-capped peak, water waves.
fn push_tile_symbols(center: Vec2, tile: Tile, out: &mut Vec[MeshVertex]) {
    if tile.hills {
        let shade = mix(tile_color(tile), [0.0, 0.0, 0.0, 1.0], 0.55);
        peak(center, vec2(-0.3, -0.5), 0.2, shade, out);
        peak(center, vec2(0.25, -0.47), 0.17, shade, out);
    }
    let row_y: f32 = if tile.hills { 1.0 } else { -1.0 };
    match tile.feature {
        Option.Some(Feature.Forest) => {
            let trees: [(f32, f32, f32); 3] = [(-0.36, 0.46, 0.15), (0.0, 0.6, 0.17), (0.36, 0.46, 0.15)];
            for i in 0..3 {
                let (x, y, r) = trees[i];
                peak(center, vec2(x, y * row_y), r, TREE_COLOR, out);
            }
            return;
        }
        Option.Some(Feature.Jungle) => {
            let trees: [(f32, f32, f32); 3] = [(-0.34, 0.48, 0.12), (0.0, 0.6, 0.14), (0.34, 0.48, 0.12)];
            for i in 0..3 {
                let (x, y, r) = trees[i];
                regular_polygon(center.add(vec2(x, y * row_y)), r, 10, 0.0, CANOPY_COLOR, out);
            }
            return;
        }
        Option.None => { if tile.hills { return; } }
    }
    match tile.terrain {
        Terrain.Grassland | Terrain.Plains | Terrain.Snow => {}
        Terrain.Marsh => {
            let spots: [(f32, f32); 3] = [(-0.34, -0.52), (0.0, -0.62), (0.34, -0.52)];
            let offsets: [f32; 3] = [-0.06, 0.0, 0.06];
            for i in 0..3 {
                let (x, y) = spots[i];
                let base = center.add(vec2(x, y));
                for k in 0..3 {
                    let dx = offsets[k];
                    segment(base.add(vec2(dx, 0.0)), base.add(vec2(dx, 0.13)), 0.02, REED_COLOR, out);
                }
            }
        }
        Terrain.Desert => {
            let spots: [(f32, f32); 3] = [(-0.32, -0.5), (0.08, -0.62), (0.34, -0.42)];
            for i in 0..3 {
                let (x, y) = spots[i];
                wave(center.add(vec2(x, y)), 0.2, DUNE_COLOR, out);
            }
        }
        Terrain.Tundra => {
            let spots: [(f32, f32); 3] = [(-0.34, -0.5), (0.0, -0.62), (0.34, -0.5)];
            let offsets: [f32; 3] = [-0.05, 0.0, 0.05];
            for i in 0..3 {
                let (x, y) = spots[i];
                let base = center.add(vec2(x, y));
                for k in 0..3 {
                    segment(base, base.add(vec2(offsets[k], 0.1)), 0.025, TUFT_COLOR, out);
                }
            }
        }
        Terrain.Coast | Terrain.Lake => {
            wave(center.add(vec2(-0.15, 0.15)), 0.4, WAVE_COLOR, out);
            wave(center.add(vec2(0.15, -0.2)), 0.4, WAVE_COLOR, out);
        }
        Terrain.Ocean => {
            wave(center.add(vec2(-0.15, 0.15)), 0.4, DEEP_WAVE_COLOR, out);
            wave(center.add(vec2(0.15, -0.2)), 0.4, DEEP_WAVE_COLOR, out);
        }
        Terrain.Mountains => {
            let (base, radius, cap_radius) = (vec2(0.0, -0.05), 0.55, 0.2);
            peak(center, base, radius, MOUNTAIN_PEAK_COLOR, out);
            // Same shape scaled down so it shares the big peak's apex.
            peak(center, base.add(vec2(0.0, radius - cap_radius)), cap_radius, SNOW_COLOR, out);
        }
    }
}

/// A small wave (or dune), `width` across, centered on `at`.
fn wave(at: Vec2, width: f32, color: Color, out: &mut Vec[MeshVertex]) {
    let (w, h) = (width / 4.0, width * 0.12);
    let mut points: Vec[Vec2] = Vec.new();
    points.push(at.add(vec2(-2.0 * w, 0.0)));
    points.push(at.add(vec2(-w, h)));
    points.push(at);
    points.push(at.add(vec2(w, h)));
    points.push(at.add(vec2(2.0 * w, 0.0)));
    polyline(&points, width * 0.1, color, out);
}

impl GameState {
    /// Rivers along explored hexes' edges, with a round joint at each end so consecutive edges
    /// meet cleanly.
    fn push_rivers(&self, out: &mut Vec[MeshVertex]) {
        for river in self.grid.rivers() {
            let e: Edge = *river;
            if !self.is_explored(e.a) && !self.is_explored(e.b) { continue; }
            let (start, end) = edge_corners(e.a, e.b);
            segment(start, end, RIVER_WIDTH, RIVER_COLOR, out);
            regular_polygon(start, RIVER_WIDTH / 2.0, 12, 0.0, RIVER_COLOR, out);
            regular_polygon(end, RIVER_WIDTH / 2.0, 12, 0.0, RIVER_COLOR, out);
        }
    }
}

/// Spreads `total` markers evenly around a small circle at `base`, or returns `base` itself
/// when there's only one.
fn fan_position(base: Vec2, index: i32, total: i32, radius: f32) -> Vec2 {
    if total <= 1 { return base; }
    base.add(vec2_from_angle(tau() as f32 * index as f32 / total as f32).scale(radius))
}

/// A straight line of a unit's plan, from one stop to the next.
pub struct PlanLine { from: Vec2, to: Vec2, color: Color }

/// A faded copy of unit `unit` where its plan ends.
pub struct PlanGhost { at: Vec2, unit: i32, color: Color }

/// A pill with turn numbers on it, rimmed in `rim`.
pub struct Badge { at: Vec2, text: Str, rim: Color }

/// What `push_queue_plans` draws, worked out first: the plan lines, the ghosts where plans
/// end, the attack arrows, and the numbered badges (their text is the turn numbers, "2,4" for
/// one unit using a hex on two turns).
pub struct QueuePlans {
    lines: Vec[PlanLine],
    ghosts: Vec[PlanGhost],
    arrows: Vec[Vec[Vec2]],
    badges: Vec[Badge],
}

/// The units that stop on a hex, in the order they first do, to fan them apart.
struct Visitors { hex: Hex, units: Vec[i32] }

/// The turns a plan uses a hex (`at` = `to`) or an attack from `at` on `to`, in turn order.
struct Turns { at: Hex, to: Hex, turns: Vec[i32] }

/// Adds `turn` to the turns labeled at `(at, to)`, in first-seen order.
fn add_label(labels: &mut Vec[Turns], at: Hex, to: Hex, turn: i32) {
    for k in 0..labels.len() {
        if labels[k].at == at && labels[k].to == to {
            labels[k].turns.push(turn);
            return;
        }
    }
    let mut turns: Vec[i32] = Vec.new();
    turns.push(turn);
    labels.push(Turns { at, to, turns });
}

/// The turn numbers, without repeats, joined by commas.
fn label(turns: &Vec[i32]) -> Str {
    text(fn() can {Out} {
        for k in 0..turns.len() {
            if k > 0 && turns[k] == turns[k - 1] { continue; }
            if k > 0 { Out.put(","); }
            show_i64(turns[k] as i64);
        }
    })
}

/// Where unit `u` (of the planning units) stands on `hex` in its plan: fanned out among the
/// units that stop there.
fn spot(visitors: &Vec[Visitors], hex: Hex, u: i32) -> Vec2 {
    for k in 0..visitors.len() {
        if visitors[k].hex == hex {
            let list = &visitors[k].units;
            let mut slot = 0;
            for s in 0..list.len() { if list[s] == u { slot = s; } }
            return fan_position(hex.to_world(), slot, list.len(), GHOST_FAN_RADIUS);
        }
    }
    hex.to_world()
}

/// The plans of units `which` (indices into `units`), each unit's on its own.
pub fn queue_plans(units: &Vec[Unit], which: &Vec[i32]) -> QueuePlans {
    let mut visitors: Vec[Visitors] = Vec.new();
    for u in 0..which.len() {
        let unit = &units[which[u]];
        for turn in 0..unit.plan_len() {
            let to = unit.pos_after(turn + 1);
            if unit.pos_after(turn) == to { continue; }
            let mut found = false;
            for k in 0..visitors.len() {
                if visitors[k].hex == to {
                    found = true;
                    if !visitors[k].units.contains(u) { visitors[k].units.push(u); }
                }
            }
            if !found {
                let mut list: Vec[i32] = Vec.new();
                list.push(u);
                visitors.push(Visitors { hex: to, units: list });
            }
        }
    }

    let mut plans = QueuePlans { lines: Vec.new(), ghosts: Vec.new(), arrows: Vec.new(), badges: Vec.new() };
    for u in 0..which.len() {
        let unit = &units[which[u]];
        let color = unit.team.color();
        let line = with_alpha(color, QUEUE_LINE_ALPHA);
        let mut at = unit.pos.to_world();
        let mut stops: Vec[Turns] = Vec.new();
        let mut strikes: Vec[Turns] = Vec.new();
        for turn in 0..unit.plan_len() {
            let (from, to) = (unit.pos_after(turn), unit.pos_after(turn + 1));
            if from != to {
                let next = stand(&visitors, unit.pos, to, u);
                plans.lines.push(PlanLine { from: at, to: next, color: line });
                at = next;
                add_label(&mut stops, to, to, turn + 1);
            }
            if let Option.Some(target) = unit.attack_on_turn(turn) { add_label(&mut strikes, to, target, turn + 1); }
        }
        let end = unit.plan_end();
        if end != unit.pos {
            plans.ghosts.push(PlanGhost { at: stand(&visitors, unit.pos, end, u), unit: which[u], color: with_alpha(color, GHOST_ALPHA) });
        }
        for k in 0..strikes.len() {
            let points = attack_arc_points(stand(&visitors, unit.pos, strikes[k].at, u), strikes[k].to.to_world(), 1.0);
            let middle = if points.is_empty() { strikes[k].to.to_world() } else { points[points.len() / 2] };
            plans.badges.push(Badge { at: middle, text: label(&strikes[k].turns), rim: ATTACK_ARC_COLOR });
            plans.arrows.push(points);
        }
        for k in 0..stops.len() {
            let hex = stops[k].at;
            // The number at the end sits under the ghost, not on it.
            let offset = if hex == end { QUEUE_END_BADGE_OFFSET } else { vec2(0.0, 0.0) };
            plans.badges.push(Badge { at: stand(&visitors, unit.pos, hex, u).add(offset), text: label(&stops[k].turns), rim: color });
        }
    }
    plans
}

/// Where a unit standing on `pos` is drawn on `hex` of its plan: on its own hex as it stands,
/// elsewhere at its `spot`.
fn stand(visitors: &Vec[Visitors], pos: Hex, hex: Hex, u: i32) -> Vec2 {
    if hex == pos { pos.to_world() } else { spot(visitors, hex, u) }
}

/// A dark pill rimmed in `rim` with `label` on it, centered on `center`.
fn push_turn_badge(center: Vec2, label: &Str, scale: f32, rim: Color, out: &mut Vec[MeshVertex]) {
    let height = QUEUE_DIGIT_HEIGHT * scale;
    let radius = QUEUE_BADGE_HALF_HEIGHT * scale;
    let width = world_text_width(label, height);
    // How far the round ends' centers sit from the middle: none for a single digit, which makes
    // the pill a disc.
    let spread = width / 2.0 + QUEUE_BADGE_PADDING * scale - radius;
    let reach = if spread > 0.0 { spread } else { 0.0 };
    push_pill(center, reach, radius + QUEUE_BADGE_RIM * scale, rim, out);
    push_pill(center, reach, radius, BADGE_BG_COLOR, out);
    push_text(center.sub(vec2(width / 2.0, height / 2.0)), height, label, QUEUE_TEXT_COLOR, out);
}

/// A horizontal pill: discs of `radius` `reach` either side of `center`, joined by a band.
pub fn push_pill(center: Vec2, reach: f32, radius: f32, color: Color, out: &mut Vec[MeshVertex]) {
    regular_polygon(center.sub(vec2(reach, 0.0)), radius, 20, 0.0, color, out);
    regular_polygon(center.add(vec2(reach, 0.0)), radius, 20, 0.0, color, out);
    if reach > 0.0 {
        let half = vec2(reach, radius);
        quad(center.sub(half), center.add(half), color, out);
    }
}

/// A queued attack's arrow from `from` toward `to`.
fn push_attack_arc(from: Vec2, to: Vec2, out: &mut Vec[MeshVertex]) {
    let points = attack_arc_points(from, to, 1.0);
    push_arrow(&points, ATTACK_ARC_COLOR, ATTACK_ARC_OUTLINE_COLOR, out);
}

/// Points along an attack's curve from `from` toward `to`: a quadratic curve bowing to the
/// left of the direction of travel (so opposing attacks between two hexes don't overlap),
/// from the edge of the attacker's icon to just short of the target. Only the first
/// `progress` (0 to 1) of it, for an arrow still in flight. Empty if the two are too close for
/// an arrow.
pub fn attack_arc_points(from: Vec2, to: Vec2, progress: f32) -> Vec[Vec2] {
    let mut points: Vec[Vec2] = Vec.new();
    let chord = to.sub(from);
    let length = chord.length();
    if length <= ATTACK_ARC_START + ATTACK_ARC_STOP || progress <= 0.0 { return points; }
    let control = from.add(to).scale(0.5).add(chord.perp().scale(ATTACK_ARC_BOW));
    let start = ATTACK_ARC_START / length;
    let end = start + (1.0 - ATTACK_ARC_STOP / length - start) * (if progress < 1.0 { progress } else { 1.0 });
    for i in 0..=ATTACK_ARC_SEGMENTS {
        let t = start + (end - start) * i as f32 / ATTACK_ARC_SEGMENTS as f32;
        points.push(from.lerp(control, t).lerp(control.lerp(to, t), t));
    }
    points
}

/// Draws an arrow along `points` over a darker outline, its head at the last point.
pub fn push_arrow(points: &Vec[Vec2], color: Color, outline: Color, out: &mut Vec[MeshVertex]) {
    let n = points.len();
    if n < 2 { return; }
    let (before, tip) = (points[n - 2], points[n - 1]);
    let d = tip.sub(before);
    let direction = if d.length() > 0.0 { d.normalize() } else { vec2(0.0, 0.0) };
    let passes = [(ATTACK_ARC_OUTLINE_WIDTH, outline), (ATTACK_ARC_WIDTH, color)];
    for k in 0..2 {
        let (width, c) = passes[k];
        polyline(points, width, c, out);
        // The outline pass draws its arrowhead a little bigger all round.
        let grow = (width - ATTACK_ARC_WIDTH) / 2.0;
        let base = tip.sub(direction.scale(grow));
        let side = direction.perp().scale(ATTACK_ARROW_WIDTH / 2.0 + grow);
        let point = tip.add(direction.scale(ATTACK_ARROW_LENGTH + grow));
        triangle(point, base.add(side), base.sub(side), c, out);
    }
}

/// How a unit is drawn, beyond its type: its pictogram, and whether it's a civilian (a settler
/// or worker), drawn hollow.
pub struct UnitLook { icon: UnitIcon, civilian: bool }

impl GameState {
    pub fn unit_look(&self, unit: &Unit) -> UnitLook {
        if self.settlers.contains(unit.id) { return UnitLook { icon: UnitIcon.Flag, civilian: true }; }
        UnitLook { icon: UnitIcon.of(unit.unit_type), civilian: false }
    }
}

/// The unit's token in its team color with a dark outline, so it reads on any terrain, and its
/// pictogram on top. Military units stand on a disc; civilians on a hollow pointy-top hexagon
/// (a pale center inside a team-colored rim), unlike both the disc and the flat-top map hexes.
pub fn push_unit_icon(center: Vec2, look: UnitLook, scale: f32, color: Color, out: &mut Vec[MeshVertex]) {
    let (sides, rotation, size) = if look.civilian { (6, pi() as f32 / 2.0, CIVILIAN_TOKEN_SIZE) } else { (TOKEN_SIDES, 0.0, 1.0) };
    let radius = UNIT_ICON_RADIUS * scale * size;
    let alpha = color[3];
    regular_polygon(center, radius, sides, rotation, color, out);
    if look.civilian {
        let pale = with_alpha(mix(color, [1.0, 1.0, 1.0, 1.0], 0.7), alpha);
        regular_polygon(center, radius * 0.68, sides, rotation, pale, out);
    }
    polygon_outline(center, radius, ICON_OUTLINE_WIDTH * scale, sides, rotation, with_alpha(ICON_OUTLINE_COLOR, alpha), out);
    push_pictogram(center, radius, look.icon, with_alpha(LABEL_COLOR, alpha), out);
}

/// Status rings behind the icon. They're filled discs, so only the rim shows once the icon is
/// drawn on top; the larger one goes first so both stay visible. A guarding unit also gets a
/// hex outline around everything.
fn push_status_rings(center: Vec2, unit: &Unit, scale: f32, out: &mut Vec[MeshVertex]) {
    if unit.guarding {
        polygon_outline(center, GUARD_OUTLINE_RADIUS * scale, GUARD_OUTLINE_WIDTH * scale, 6, 0.0, GUARD_OUTLINE_COLOR, out);
    }
    if unit.alert { push_alert_reticle(center, scale, out); }
    if unit.ability_queued {
        regular_polygon(center, ABILITY_RING_RADIUS * scale, 24, 0.0, ABILITY_RING_COLOR, out);
    }
    if unit.deployed {
        regular_polygon(center, DEPLOYED_RING_RADIUS * scale, 24, 0.0, DEPLOYED_RING_COLOR, out);
    }
}

/// The reticle of a unit on alert (`Unit.alert`): a red ring with a tick on each diagonal,
/// unlike Guard's white hex.
fn push_alert_reticle(center: Vec2, scale: f32, out: &mut Vec[MeshVertex]) {
    polygon_outline(center, ALERT_RING_RADIUS * scale, ALERT_WIDTH * scale, 32, 0.0, ALERT_COLOR, out);
    let angles = [0.7853982, 2.3561945, 3.9269908, 5.497787];
    for k in 0..4 {
        let direction = vec2_from_angle(angles[k]);
        segment(center.add(direction.scale(ALERT_TICK_INNER * scale)), center.add(direction.scale(ALERT_TICK_OUTER * scale)), ALERT_WIDTH * 1.4 * scale, ALERT_COLOR, out);
    }
}

/// Small numbered badges showing where the unit's type moves and attacks in the turn order.
fn push_order_badges(center: Vec2, unit: &Unit, scale: f32, out: &mut Vec[MeshVertex]) {
    let badges = [
        (-BADGE_OFFSET_X, TurnPhase.Move, MOVE_ORDER_COLOR),
        (BADGE_OFFSET_X, TurnPhase.Attack, ATTACK_ORDER_COLOR),
    ];
    for b in 0..2 {
        let (offset_x, phase, color) = badges[b];
        let pos = center.add(vec2(offset_x * scale, 0.0));
        let digit = (48 + step_rank(unit.unit_type, phase)) as u8 as char;
        regular_polygon(pos, BADGE_RADIUS * scale, 12, 0.0, BADGE_BG_COLOR, out);
        push_glyph(pos, BADGE_DIGIT_HEIGHT * scale, digit, color, out);
    }
}

impl GameState {
    /// The attack preview's marks on the map's health bars: units' where they're drawn, and the
    /// Barracks' and coastal batteries'.
    fn push_attack_preview(&self, preview: &AttackPreview, out: &mut Vec[MeshVertex]) {
        let pulse = self.preview_pulse();
        for k in 0..preview.losses.len() {
            let loss = &preview.losses[k];
            match loss.hurt {
                Hurt.Unit(i) => {
                    let (at, scale) = self.unit_layout(i);
                    push_health_loss(at, loss, self.units[i].max_hp(), scale, pulse, out);
                }
                Hurt.Barracks(city) => {
                    if let Option.Some(hex) = self.cities[city].barracks {
                        push_health_loss(hex.to_world(), loss, BARRACKS_MAX_HP, BARRACKS_BAR_SCALE, pulse, out);
                    }
                }
                Hurt.Battery(city) => {
                    if let Option.Some(hex) = self.cities[city].placed_site(Building.CoastalBattery) {
                        push_health_loss(hex.to_world(), loss, COASTAL_BATTERY_MAX_HP, BATTERY_BAR_SCALE, pulse, out);
                    }
                }
            }
        }
    }

    /// The preview's pulse, 0 to 1, on the presentation clock (still in a screenshot, like the
    /// clouds).
    pub fn preview_pulse(&self) -> f32 {
        0.5 + 0.5 * (self.cloud_time * PREVIEW_PULSE_RATE * tau() as f32).sin()
    }
}

/// The color of the HP a preview shows lost, at `pulse` (0 to 1).
pub fn preview_loss_color(pulse: f32) -> Color { mix(PREVIEW_LOSS_DARK, PREVIEW_LOSS_BRIGHT, pulse) }

/// The rim color of a lethal preview, at `pulse`.
pub fn preview_lethal_color(pulse: f32) -> Color { with_alpha(PREVIEW_LETHAL_COLOR, 0.35 + 0.65 * pulse) }

/// `loss` marked on the health bar `push_health_bar` draws for `max_hp` at `unit_center`: the HP
/// it would lose as a pulsing segment, a flashing red rim if it's lethal, and the number over
/// the bar.
fn push_health_loss(unit_center: Vec2, loss: &Loss, max_hp: f32, scale: f32, pulse: f32, out: &mut Vec[MeshVertex]) {
    let size = vec2(HEALTH_BAR_WIDTH, HEALTH_BAR_HEIGHT).scale(scale);
    let min = unit_center.add(vec2(0.0, HEALTH_BAR_OFFSET_Y * scale)).sub(size.scale(0.5));
    let max = min.add(size);
    let lo = clamp_unit((loss.hp - loss.amount) / max_hp);
    let hi = clamp_unit(loss.hp / max_hp);
    quad(vec2(min.x + size.x * lo, min.y), vec2(min.x + size.x * hi, max.y), preview_loss_color(pulse), out);
    let lethal = loss.lethal();
    if lethal {
        let rim = PREVIEW_RIM * scale;
        let color = preview_lethal_color(pulse);
        let (outer_min, outer_max) = (min.sub(vec2(rim, rim)), max.add(vec2(rim, rim)));
        quad(outer_min, vec2(outer_max.x, min.y), color, out);
        quad(vec2(outer_min.x, max.y), outer_max, color, out);
        quad(vec2(outer_min.x, min.y), vec2(min.x, max.y), color, out);
        quad(vec2(max.x, min.y), vec2(outer_max.x, max.y), color, out);
    }
    let label = text(fn() can {Out} {
        Out.put("-"); show_i64(round_i(loss.amount) as i64);
        if lethal { Out.put(" LETHAL"); }
    });
    let color = if loss.target_side { PREVIEW_DEALT_COLOR } else { PREVIEW_RETALIATION_COLOR };
    // Legible however small the unit is drawn (a contested hex).
    let height = PREVIEW_LABEL_HEIGHT * (if scale > 0.75 { scale } else { 0.75 });
    let radius = height * 0.85;
    let at = vec2(unit_center.x, max.y + PREVIEW_RIM * scale + radius);
    let width = world_text_width(&label, height);
    let spread = width / 2.0 + radius * 0.4 - radius;
    push_pill(at, if spread > 0.0 { spread } else { 0.0 }, radius, BADGE_BG_COLOR, out);
    push_text(at.sub(vec2(width / 2.0, height / 2.0)), height, &label, color, out);
}

fn clamp_unit(x: f32) -> f32 { if x < 0.0 { 0.0 } else if x > 1.0 { 1.0 } else { x } }

/// `x` rounded to a whole number, a half to the even neighbour as Rust's `{:.0}` does.
fn round_i(x: f32) -> i32 {
    let floor = x.floor();
    let mut r = x.round();
    if x - floor == 0.5 && (r as i64) % 2 != 0 { r = r - 1.0; }
    r as i32
}

fn push_health_bar(unit_center: Vec2, hp_fraction: f32, scale: f32, out: &mut Vec[MeshVertex]) {
    let hp = if hp_fraction < 0.0 { 0.0 } else if hp_fraction > 1.0 { 1.0 } else { hp_fraction };
    let size = vec2(HEALTH_BAR_WIDTH, HEALTH_BAR_HEIGHT).scale(scale);
    let min = unit_center.add(vec2(0.0, HEALTH_BAR_OFFSET_Y * scale)).sub(size.scale(0.5));
    quad(min, min.add(size), HEALTH_BAR_BG_COLOR, out);
    quad(min, min.add(vec2(size.x * hp, size.y)), [1.0 - hp, hp, 0.08, 1.0], out);
}

fn brighten(c: Color) -> Color {
    [bright(c[0]), bright(c[1]), bright(c[2]), c[3]]
}

fn bright(v: f32) -> f32 { if v + 0.35 < 1.0 { v + 0.35 } else { 1.0 } }

fn with_alpha(c: Color, a: f32) -> Color { [c[0], c[1], c[2], a] }

impl GameState {
    /// Moves the fog's clouds on by `dt` seconds (`push_cloud_banks`). The app calls it every
    /// frame, except in screenshot mode.
    pub fn animate_clouds(&mut self, dt: f32) {
        // Wrapped long before f32 loses the precision a frame needs.
        let t = self.cloud_time + dt;
        self.cloud_time = t - (t / 100000.0).floor() * 100000.0;
    }
}

/// The low 32 bits of `x`, as `u32` arithmetic would keep them.
const LOW32: u64 = 4294967295;

/// Stable pseudo-random number in [0, 1] for one cell of the cloud lattice.
fn cloud_hash(x: i32, y: i32, salt: u64) -> f32 {
    let xb = (x as i64 & 4294967295) as u64;
    let yb = (y as i64 & 4294967295) as u64;
    let mut bits = ((xb * 0x9E3779B1) & LOW32) ^ ((yb * 0x85EBCA77) & LOW32) ^ (salt & LOW32);
    bits = bits ^ (bits >> 16);
    bits = (bits * 0x7FEB352D) & LOW32;
    bits = bits ^ (bits >> 15);
    ((bits as i64) as f64 / 4294967295.0) as f32
}

/// `(i + 1) * 0x9E3779B9` in 32 bits: puff `i`'s own salt.
fn puff_salt(i: i32) -> u64 { ((i as u64 + 1) * 0x9E3779B9) & LOW32 }

/// One cloud puff: a soft disc lit from above.
pub struct Puff {
    center: Vec2,
    radius: f32,
    /// Its opacity: less past the map's edge (`edge_fade`).
    alpha: f32,
}

/// A puff's place around its bank's center and its radius, in units of the bank's scale.
struct Place { at: Vec2, radius: f32 }

/// The shape of the cloud bank at lattice point (`x`, `y`). The bank grows from one puff: each
/// next one buds off a puff already placed, in any direction and overlapping it, so every bank
/// is its own irregular clump rather than a copy of one template.
fn bank_shape(x: i32, y: i32) -> Vec[Place] {
    let wanted = 4 + (cloud_hash(x, y, 0x3C6EF372) * (MAX_BANK_PUFFS - 3) as f32) as i32;
    let count = if wanted < MAX_BANK_PUFFS { wanted } else { MAX_BANK_PUFFS };
    let mut places: Vec[Place] = Vec.new();
    for i in 0..count {
        let salt = puff_salt(i);
        let radius = 0.2 + cloud_hash(x, y, salt ^ 0x68E31DA4) * 0.16;
        let mut at = vec2(0.0, 0.0);
        if i > 0 {
            let parent = (cloud_hash(x, y, salt ^ 0x1B873593) * i as f32) as i32 % i;
            let angle = cloud_hash(x, y, salt ^ 0x7E95761E) * tau() as f32;
            let reach = (places[parent].radius + radius) * (0.5 + cloud_hash(x, y, salt ^ 0x2F1D9A07) * 0.25);
            at = places[parent].at.add(vec2_from_angle(angle).scale(reach));
        }
        places.push(Place { at, radius });
    }
    // Centered on the bank, so a large bank doesn't lean off its place.
    let mut sum = vec2(0.0, 0.0);
    for i in 0..count { sum = sum.add(places[i].at); }
    let mean = sum.scale(1.0 / count as f32);
    for i in 0..count { places[i].at = places[i].at.sub(mean); }
    places
}

/// How much of a cloud puff centered at `point` shows: all of it over the map, fading out over
/// the hexes beyond its edge, so puffs drifting past the edge come and go smoothly.
pub fn edge_fade(grid: &HexGrid, point: Vec2) -> f32 {
    let hex = Hex.from_world(point);
    if grid.contains(hex) { return 1.0; }
    let mut nearest = 1.0e30;
    let around = hex.neighbors();
    for k in 0..6 {
        let n = around[k];
        if grid.contains(n) { nearest = min_f32(nearest, n.to_world().distance(point)); }
        let further = n.neighbors();
        for j in 0..6 {
            if grid.contains(further[j]) { nearest = min_f32(nearest, further[j].to_world().distance(point)); }
        }
    }
    let t = (nearest - 1.0) / 1.2;
    1.0 - (if t < 0.0 { 0.0 } else if t > 1.0 { 1.0 } else { t })
}

fn min_f32(a: f32, b: f32) -> f32 { if a < b { a } else { b } }
fn max_f32(a: f32, b: f32) -> f32 { if a > b { a } else { b } }

/// A shadow under a cloud bank and its opacity.
struct Shadow { center: Vec2, alpha: f32 }

/// Draws the unexplored map as banks of cumulus, those that reach into the world rectangle
/// `view_min`..`view_max`: one bank per point of a world-space lattice that drifts with
/// `CLOUD_WIND` as `time` (seconds) passes, each bank a soft shadow under an irregular clump of
/// puffs (`bank_shape`) that slowly billow. Every puff fades out at its edge and is lit from
/// above (`push_soft_disc`); higher puffs are drawn first, so the lit top of a lower billow
/// overlaps the shaded underside of the one behind it. A bank keeps its lattice point's hash as
/// it drifts, so the pattern moves whole. The work per puff is constant and cheap: no noise
/// sampling per vertex.
pub fn push_cloud_banks(grid: &HexGrid, time: f32, view_min: Vec2, view_max: Vec2, out: &mut Vec[MeshVertex]) {
    let mut any = false;
    let mut lo = vec2(0.0, 0.0);
    let mut hi = vec2(0.0, 0.0);
    for h in grid.hexes() {
        let p = (*h).to_world();
        if !any { lo = p; hi = p; any = true; } else { lo = lo.min(p); hi = hi.max(p); }
    }
    if !any { return; }
    // A bank reaches about two spacings from its lattice point.
    let reach = vec2(2.0 * CLOUD_SPACING, 2.0 * CLOUD_SPACING);
    let lo = lo.max(view_min.sub(reach));
    let hi = hi.min(view_max.add(reach));
    if lo.x > hi.x || lo.y > hi.y { return; }
    let drift = CLOUD_WIND.scale(time);
    let (lo, hi) = (lo.sub(drift), hi.sub(drift));
    let min_x = (lo.x / CLOUD_SPACING).floor() as i32 - 1;
    let max_x = (hi.x / CLOUD_SPACING).ceil() as i32 + 1;
    let min_y = (lo.y / CLOUD_SPACING).floor() as i32 - 1;
    let max_y = (hi.y / CLOUD_SPACING).ceil() as i32 + 1;
    let mut shadows: Vec[Shadow] = Vec.new();
    let mut puffs: Vec[Puff] = Vec.new();
    for y in min_y..=max_y {
        for x in min_x..=max_x {
            // Rows are offset by half a bank, and each bank wanders off its lattice point, so
            // the lattice doesn't show.
            let jitter = vec2(cloud_hash(x, y, 0xA341316C) - 0.5, cloud_hash(x, y, 0xC8013EA4) - 0.5).scale(0.7);
            let row_shift = if ((y % 2) + 2) % 2 == 1 { 0.5 } else { 0.0 };
            let bank = vec2(x as f32 + row_shift, y as f32).add(jitter).scale(CLOUD_SPACING).add(drift);
            let scale = CLOUD_SPACING * (0.8 + cloud_hash(x, y, 0xAD90777D) * 0.5);
            let shape = bank_shape(x, y);
            for i in 0..shape.len() {
                let salt = puff_salt(i);
                // Each puff billows at its own phase and pace.
                let pace = 0.75 + cloud_hash(x, y, salt ^ 0x2545F491) * 0.5;
                let phase = cloud_hash(x, y, salt ^ 0x5851F42D) * tau() as f32 + time * pace * tau() as f32 / CLOUD_BILLOW_PERIOD;
                let wander = vec2(phase.cos(), (phase * 0.8).sin()).scale(CLOUD_WANDER);
                let center = bank.add(shape[i].at.scale(scale)).add(wander);
                let alpha = edge_fade(grid, center);
                if alpha <= 0.0 { continue; }
                let radius = shape[i].radius * scale * 1.5 * (1.0 + CLOUD_BILLOW * (phase * 1.3).sin());
                puffs.push(Puff { center, radius, alpha });
            }
            let shadow = bank.add(vec2(0.04, -0.12).scale(scale));
            let alpha = edge_fade(grid, shadow);
            if alpha > 0.0 { shadows.push(Shadow { center: shadow, alpha }); }
        }
    }
    // Higher first.
    // `puffs.buf`: a `Vec` installs `ElementsMut` through its buffer until it has an installer of its own.
    handle { with elements_mut(&mut puffs.buf) { sort() }; } with Compare[Puff] {
        cmp(a, b) => { resume if a.center.y > b.center.y { Ordering.Less } else if a.center.y < b.center.y { Ordering.Greater } else { Ordering.Equal } }
    };
    for k in 0..shadows.len() {
        let color = with_alpha(CLOUD_SHADOW_COLOR, CLOUD_SHADOW_COLOR[3] * shadows[k].alpha);
        let r = 0.62 * CLOUD_SPACING;
        push_soft_disc(shadows[k].center, vec2(r, r), color, color, out);
    }
    for k in 0..puffs.len() {
        let puff = puffs[k];
        let light = with_alpha(CLOUD_LIGHT, CLOUD_LIGHT[3] * puff.alpha);
        let dark = with_alpha(CLOUD_DARK, CLOUD_DARK[3] * puff.alpha);
        push_soft_disc(puff.center, vec2(puff.radius, puff.radius), light, dark, out);
    }
}

/// The shade at `local` (-1 to 1 across the disc) between `dark` at the bottom and `light` at
/// the top; the light comes from above and a little to the left.
fn shade(local: Vec2, light: Color, dark: Color) -> Color {
    let raw = 0.5 + 0.5 * local.dot(vec2(-0.35, 0.94));
    let t = if raw < 0.0 { 0.0 } else if raw > 1.0 { 1.0 } else { raw };
    [dark[0] + (light[0] - dark[0]) * t, dark[1] + (light[1] - dark[1]) * t, dark[2] + (light[2] - dark[2]) * t, dark[3] + (light[3] - dark[3]) * t]
}

fn disc_vertex(center: Vec2, radii: Vec2, x: f32, y: f32, light: Color, dark: Color) -> MeshVertex {
    let local = vec2(x, y);
    let p = center.add(vec2(x * radii.x, y * radii.y));
    // A u of -2 or less marks a soft disc to the shader: (u + 3, v) is the point's place on it.
    MeshVertex { pos: [p.x, p.y, 0.0], color: shade(local, light, dark), uv: [x - 3.0, y] }
}

/// An ellipse with half-axes `radii`, solid in the middle and fading to transparent at its rim
/// (the shader's soft disc), shaded from `light` at the top to `dark` at the bottom.
fn push_soft_disc(center: Vec2, radii: Vec2, light: Color, dark: Color, out: &mut Vec[MeshVertex]) {
    let bl = disc_vertex(center, radii, -1.0, -1.0, light, dark);
    let br = disc_vertex(center, radii, 1.0, -1.0, light, dark);
    let tr = disc_vertex(center, radii, 1.0, 1.0, light, dark);
    let tl = disc_vertex(center, radii, -1.0, 1.0, light, dark);
    out.push(bl);
    out.push(br);
    out.push(tr);
    out.push(bl);
    out.push(tr);
    out.push(tl);
}

/// A city: a crenellated tower in its team's color with its population centered on its body.
fn push_city_marker(pos: Vec2, team: Team, population: i32, out: &mut Vec[MeshVertex]) {
    push_city_tower(pos, 1.0, team.color(), out);
    let digits = text(fn() can {Out} { show_i64(population as i64); });
    let height = 0.3;
    let width = world_text_width(&digits, height);
    // Centered in the tower's body, below the merlons.
    let middle = pos.add(vec2(0.0, -0.08));
    push_text(middle.sub(vec2(width / 2.0, height / 2.0)), height, &digits, LABEL_COLOR, out);
}

/// A city's crenellated tower in `color`, `scale` times its size on the map (0.84 wide, 0.8
/// tall), each part edged in dark.
pub fn push_city_tower(pos: Vec2, scale: f32, color: Color, out: &mut Vec[MeshVertex]) {
    let outline = with_alpha(ICON_OUTLINE_COLOR, color[3]);
    let grow = vec2(ICON_OUTLINE_WIDTH * scale, ICON_OUTLINE_WIDTH * scale);
    // The body, then three merlons along the top.
    let rects = [
        (vec2(-0.42, -0.4), vec2(0.42, 0.24)),
        (vec2(-0.42, 0.24), vec2(-0.24, 0.4)),
        (vec2(-0.09, 0.24), vec2(0.09, 0.4)),
        (vec2(0.24, 0.24), vec2(0.42, 0.4)),
    ];
    for k in 0..4 {
        let (lo, hi) = rects[k];
        quad(pos.add(lo.scale(scale)).sub(grow), pos.add(hi.scale(scale)).add(grow), outline, out);
    }
    for k in 0..4 {
        let (lo, hi) = rects[k];
        quad(pos.add(lo.scale(scale)), pos.add(hi.scale(scale)), color, out);
    }
}

impl GameState {
    /// The city interior is a separate world map, drawn with the normal hex and unit primitives
    /// rather than as buttons in a screen-space panel.
    pub fn build_interior_vertices(&self, index: i32) -> Vec[MeshVertex] {
        let mut out: Vec[MeshVertex] = Vec.new();
        let city = &self.cities[index];
        let interior = &city.interior;
        let selected = match self.interior_selected { Option.Some(source) => interior.index_of(source), Option.None => Option.None };
        for q in -2..=2 {
            for r in -2..=2 {
                let hex = Hex.new(q, r);
                if hex.distance(CENTER) > 2 { continue; }
                let at = hex.to_world();
                regular_polygon(at, OUTER_BORDER_RADIUS, 6, 0.0, BORDER_COLOR, &mut out);
                let fill: Color = if hex == CENTER {
                    if interior.core_hp > 0.0 { [0.30, 0.24, 0.14, 1.0] } else { [0.19, 0.10, 0.09, 1.0] }
                } else if hex.distance(CENTER) == 2 {
                    [0.21, 0.24, 0.27, 1.0]
                } else {
                    [0.26, 0.29, 0.31, 1.0]
                };
                regular_polygon(at, HEX_SIZE * HEX_FILL_SCALE, 6, 0.0, fill, &mut out);
                let Option.Some(k) = selected else { continue; };
                let fighter = interior.fighters[k];
                let occupied = interior.fighter_at(hex);
                let can_move = occupied.is_none() && (hex != CENTER || interior.core_hp <= 0.0) && fighter.move_reaches(hex);
                let enemy_there = match occupied { Option.Some(o) => interior.fighters[o].team != fighter.team, Option.None => false };
                let can_attack = (enemy_there || (hex == CENTER && city.team != fighter.team && interior.core_hp > 0.0)) && fighter.attack_reaches(hex);
                if can_move || can_attack {
                    polygon_outline(at, HEX_SIZE * 0.82, 0.065, 6, 0.0, if can_attack { ATTACK_RANGE_COLOR } else { MOVE_RANGE_COLOR }, &mut out);
                }
            }
        }

        let post = CENTER.to_world();
        let breached = interior.core_hp <= 0.0;
        regular_polygon(post, 0.56, 6, 0.0, ICON_OUTLINE_COLOR, &mut out);
        regular_polygon(post, 0.48, 6, 0.0, if breached { [0.22, 0.16, 0.14, 1.0] } else { city.team.color() }, &mut out);
        if breached {
            polygon_outline(post, 0.59, 0.07, 6, 0.0, SELECTED_COLOR, &mut out);
            push_centered(post.add(vec2(0.0, 0.13)), 0.16, "0 HP", SELECTED_COLOR, &mut out);
            let (height, word) = if city.team == self.local_team { (0.17, "DEFEND") } else { (0.23, "TAKE") };
            push_centered(post.add(vec2(0.0, -0.14)), height, word, SELECTED_COLOR, &mut out);
        } else {
            push_centered(post.add(vec2(0.0, -0.07)), 0.23, "POST", LABEL_COLOR, &mut out);
        }
        push_health_bar(post, interior.core_hp / CORE_HP, 1.1, &mut out);

        for k in 0..interior.fighters.len() {
            let fighter = interior.fighters[k];
            let at = fighter.pos.to_world();
            if self.interior_selected == Option.Some(fighter.source_id) { polygon_outline(at, 0.72, 0.09, 6, 0.0, SELECTED_COLOR, &mut out); }
            if let Option.Some(dest) = fighter.planned_move {
                push_unit_icon(dest.to_world(), UnitLook { icon: UnitIcon.of(fighter.unit_type), civilian: false }, 0.85, with_alpha(fighter.team.color(), GHOST_ALPHA), &mut out);
            }
            if let Option.Some(target) = fighter.planned_attack {
                push_attack_arc(fighter.planned_move.unwrap_or(fighter.pos).to_world(), target.to_world(), &mut out);
            }
        }
        for k in 0..interior.fighters.len() {
            let fighter = interior.fighters[k];
            let at = fighter.pos.to_world();
            push_unit_icon(at, UnitLook { icon: UnitIcon.of(fighter.unit_type), civilian: false }, 1.0, fighter.team.color(), &mut out);
            push_health_bar(at, fighter.health_fraction(), 1.0, &mut out);
        }
        out
    }
}

/// `t` centered on `center`, `cap_height` tall.
fn push_centered(center: Vec2, cap_height: f32, t: &str, color: Color, out: &mut Vec[MeshVertex]) {
    let width = world_text_width(t, cap_height);
    push_text(vec2(center.x - width / 2.0, center.y - cap_height / 2.0), cap_height, t, color, out);
}
