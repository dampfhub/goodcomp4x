//! The UI as clicked and hovered: tooltips, the unit and city buttons, the debug panel, the
//! tile tooltip's delay, and the labels the panels print. Each test drives the game through
//! `handle_click` and `update_hover` at the window positions of what it presses.

use std.linalg.Vec2;
use std.linalg.vec2;
use std.rand.Rand;
use std.str.Str;
use std.str.eq as str_eq;
use std.test.assert;
use std.test.Assert;
use log.Log;
use game.GameState;
use game.city.Build;
use game.city.Building;
use game.city.BuildUnit;
use game.hex.Hex;
use game.hex.edge;
use game.workers.JobKind;
use game.workers.JOB_KINDS;
use game.orders.ClickMode;
use game.scenario.Scenario;
use game.tests.find;
use game.tests.sandbox;
use game.settings.SETTINGS;
use game.settings.Setting;
use game.ui.ButtonState;
use game.ui.steps_in_classic;
use game.ui.TILE_TOOLTIP_DELAY;
use game.ui.Target;
use game.ui.UnitAction;
use game.ui.end_turn_label;
use game.ui.to_ui;
use game.ui.ui_projection;
use game.ui.wrap;
use game.unit.Team;
use game.unit.UnitType;

const SCREEN_W: f32 = 1600.0;
const SCREEN_H: f32 = 900.0;

fn screen() -> Vec2 { vec2(SCREEN_W, SCREEN_H) }

@test
fn hovering_a_button_shows_its_tooltip() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.city_scenario();
        game.select_city();
        let card = button_cursor(&game, Target.Build(BuildUnit.Siege));
        let plain = game.build_ui(screen(), Option.None).len();
        assert(game.build_ui(screen(), Option.Some(card)).len() > plain);
    });
}

@test
fn hovering_an_enemy_describes_it() {
    sandbox(fn() can {Log, Rand, Assert} {
        let game = GameState.new();
        let enemy = find(&game, Team.Red, UnitType.Melee);
        let empty = hex_cursor(&game, Hex.new(0, 1));
        let plain = game.build_ui(screen(), Option.Some(empty)).len();
        let hovered = game.build_ui(screen(), Option.Some(hex_cursor(&game, game.units[enemy].pos)));
        assert(hovered.len() > plain);
    });
}

@test
fn ui_projection_puts_the_origin_at_the_bottom_left() {
    let m = ui_projection(screen());
    // Vulkan clip space has Y = +1 at the bottom of the window.
    let origin = m.project_point3(vec2(0.0, 0.0).extend(0.0)).xy();
    assert(origin.approx_eq(vec2(0.0 - 1.0, 1.0), 0.00001));
    let corner = m.project_point3(screen().extend(0.0)).xy();
    assert(corner.approx_eq(vec2(1.0, 0.0 - 1.0), 0.00001));
}

/// Where to click, in window pixels, to press the button for `target`; the screen's centre,
/// which no button covers, when none is shown.
fn button_cursor(game: &GameState, target: Target) -> Vec2 {
    let layout = game.layout(screen());
    match layout.button_for(target) {
        Option.Some(i) => {
            let b = &layout.buttons[i];
            to_ui(b.min.add(b.max).scale(0.5), screen())
        }
        Option.None => screen().scale(0.5),
    }
}

/// Where `hex` is drawn, in window pixels.
fn hex_cursor(game: &GameState, hex: Hex) -> Vec2 {
    let camera = &game.camera;
    let offset = hex.to_world().sub(camera.center).scale(1.0 / camera.half_height);
    let ndc = vec2(offset.x * SCREEN_H / SCREEN_W, 0.0 - offset.y);
    vec2((ndc.x + 1.0) / 2.0 * SCREEN_W, (ndc.y + 1.0) / 2.0 * SCREEN_H)
}

@test
fn attack_button_arms_a_square_attack_for_the_next_click() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let melee = find(&game, Team.Blue, UnitType.Melee);
        assert(game.selected == Option.Some(melee));
        // An empty hex the melee could otherwise move to.
        let target = Hex.new(0 - 1, 0);

        let attack = Target.Unit(UnitAction.Attack);
        game.handle_click(button_cursor(&game, attack), screen(), ClickMode.Normal);
        assert(game.ui_click_mode == Option.Some(ClickMode.Attack));
        game.handle_click(hex_cursor(&game, target), screen(), ClickMode.Normal);
        assert(game.units[melee].planned_attack == Option.Some(target));
        assert(game.units[melee].planned_move == Option.None);
        // Armed for one click only.
        assert(game.ui_click_mode == Option.None);
    });
}

@test
fn pressing_an_armed_button_again_disarms_it() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let swap = Target.Unit(UnitAction.Swap);
        game.handle_click(button_cursor(&game, swap), screen(), ClickMode.Normal);
        assert(game.ui_click_mode == Option.Some(ClickMode.Swap));
        game.handle_click(button_cursor(&game, swap), screen(), ClickMode.Normal);
        assert(game.ui_click_mode == Option.None);
    });
}

@test
fn hold_button_holds_the_selected_unit() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let first = game.selected.unwrap_or(0 - 1);
        let hold = Target.Unit(UnitAction.Hold);
        game.handle_click(button_cursor(&game, hold), screen(), ClickMode.Normal);
        assert(game.units[first].holding);
        assert(game.selected != Option.Some(first));
    });
}

/// The state of the Load button, or `Ready` when it is not shown.
fn load_state(game: &GameState) -> ButtonState {
    let layout = game.layout(screen());
    match layout.button_for(Target.LoadState) {
        Option.Some(i) => layout.buttons[i].state,
        Option.None => ButtonState.Ready,
    }
}

@test
fn debug_panel_saves_loads_and_switches_scenarios() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let unit = game.selected.unwrap_or(0 - 1);
        let start = game.units[unit].pos;
        // Nothing saved yet.
        assert(match load_state(&game) { ButtonState.Disabled => true, _ => false });

        game.handle_click(button_cursor(&game, Target.SaveState), screen(), ClickMode.Normal);
        assert(match load_state(&game) { ButtonState.Ready => true, _ => false });
        game.units[unit].pos = Hex.new(0, 1);
        game.handle_click(button_cursor(&game, Target.LoadState), screen(), ClickMode.Normal);
        assert(game.units[unit].pos == start);

        let cities = Target.Scenario(Scenario.Cities);
        game.handle_click(button_cursor(&game, cities), screen(), ClickMode.Normal);
        assert(game.scenario == Scenario.Cities);
    });
}

@test
fn build_card_queues_its_unit() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.city_scenario();
        game.select_city();
        let ranged = Target.Build(BuildUnit.Ranged);
        game.handle_click(button_cursor(&game, ranged), screen(), ClickMode.Normal);
        let city = game.selected_city.unwrap_or(0 - 1);
        assert(game.cities[city].queue.len() == 1 && game.cities[city].queue[0] == Build.Unit(BuildUnit.Ranged));
    });
}

/// The city scenario with the player's city open and the camera settled on it.
fn city_view() -> GameState can {Log, Rand} {
    let mut game = GameState.city_scenario();
    game.select_city();
    game.update(10.0);
    game
}

@test
fn city_clicks_do_not_select_units_without_exiting_city_view() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = city_view();
        // One of the player's units drawn clear of the top bar and the tray.
        let mut unit = 0 - 1;
        for i in 0..game.units.len() {
            let cursor = hex_cursor(&game, game.units[i].pos);
            if unit < 0 && game.units[i].team == Team.Blue && cursor.y >= 100.0 && cursor.y < 500.0 && cursor.x >= 0.0 && cursor.x < SCREEN_W {
                unit = i;
            }
        }
        // A unit in view.
        assert(unit >= 0);
        game.handle_click(hex_cursor(&game, game.units[unit].pos), screen(), ClickMode.Normal);
        // City management owns map clicks until Escape or Space dismisses it.
        assert(game.selected_city.is_some());
        assert(game.selected.is_none());
    });
}

@test
fn clicking_the_open_city_enters_interior_and_escape_returns() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = city_view();
        let exterior = game.camera;
        let city = game.cities[game.selected_city.unwrap_or(0 - 1)].pos;
        game.handle_click(hex_cursor(&game, city), screen(), ClickMode.Normal);
        assert(game.interior_view == Option.Some(0));
        assert(game.selected_city.is_none());
        assert(game.exit_structure_menu());
        assert(game.interior_view.is_none());
        assert(game.selected_city == Option.Some(0));
        assert(game.camera.center.x == exterior.center.x && game.camera.center.y == exterior.center.y);
        assert(game.camera.half_height == exterior.half_height);
    });
}

@test
fn yields_show_only_for_the_open_city_and_toggle() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = city_view();
        let shown = game.build_vertices().len();
        game.handle_click(button_cursor(&game, Target.ToggleYields), screen(), ClickMode.Normal);
        assert(!game.show_yields);
        // Badges hidden.
        assert(game.build_vertices().len() < shown);
        game.toggle_yields();
        assert(game.build_vertices().len() == shown);

        // Hovering a city without opening it no longer shows its yields.
        let city = game.cities[game.selected_city.unwrap_or(0 - 1)].pos;
        game.leave_city_view();
        game.update_hover(Option.Some(hex_cursor(&game, city)), screen(), 0.0);
        assert(game.hovered_city.is_some());
        assert(game.yields_city() == Option.None);
        assert(game.build_vertices().len() < shown);
    });
}

@test
fn resting_on_a_tile_shows_its_tooltip_after_a_delay() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let cursor = hex_cursor(&game, Hex.new(0, 1));
        game.update_hover(Option.Some(cursor), screen(), 0.0);
        let before = game.build_ui(screen(), Option.Some(cursor)).len();
        game.update_hover(Option.Some(cursor), screen(), TILE_TOOLTIP_DELAY);
        assert(game.hovered_tile == Option.Some(Hex.new(0, 1)));
        assert(game.build_ui(screen(), Option.Some(cursor)).len() > before);

        // Moving to another hex starts the wait over.
        let elsewhere = hex_cursor(&game, Hex.new(1, 1));
        game.update_hover(Option.Some(elsewhere), screen(), 0.1);
        assert(game.hover_seconds == 0.0);
    });
}

@test
fn clicks_on_a_panel_do_not_reach_the_map() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let selected = game.selected;
        // The top bar's left end, away from any button.
        game.handle_click(vec2(4.0, 4.0), screen(), ClickMode.Normal);
        assert(game.selected == selected);
    });
}

fn label_is(label: Str, want: str) -> bool { str_eq(&label, want) }

@test
fn end_turn_button_names_what_is_waiting() {
    sandbox(fn() can {Log, Rand, Assert} {
        // Production first, then idle workers, then units: the turn's order.
        assert(label_is(end_turn_label(3, 1, 2), "CHOOSE PRODUCTION"));
        assert(label_is(end_turn_label(0, 2, 0), "2 CITIES NEED PRODUCTION"));
        assert(label_is(end_turn_label(3, 0, 1), "WORKER NEEDS A JOB"));
        assert(label_is(end_turn_label(3, 0, 2), "2 WORKERS NEED JOBS"));
        assert(label_is(end_turn_label(3, 0, 0), "3 UNITS NEED ORDERS"));
        assert(label_is(end_turn_label(1, 0, 0), "UNIT NEEDS ORDERS"));
        assert(label_is(end_turn_label(0, 0, 0), "END TURN"));

        let game = GameState.new();
        let layout = game.layout(screen());
        let shown = match layout.button_for(Target.EndTurn) {
            Option.Some(i) => {
                let label = &layout.buttons[i].label;
                str_eq(label, "4 UNITS NEED ORDERS")
            }
            Option.None => false,
        };
        assert(shown);
    });
}

@test
fn wrap_breaks_between_words() {
    let a = wrap("AB CD EF", 5);
    assert(a.len() == 2 && line_is(&a, 0, "AB CD") && line_is(&a, 1, "EF"));
    let b = wrap("ABCDEFG HI", 5);
    assert(b.len() == 2 && line_is(&b, 0, "ABCDEFG") && line_is(&b, 1, "HI"));
}

fn line_is(lines: &Vec[Str], i: i32, want: str) -> bool {
    let line = &lines[i];
    str_eq(line, want)
}

/// The value each of `setting`'s menu buttons sets, and its state, in order.
fn setting_buttons(game: &GameState, setting: Setting) -> Vec[(i32, ButtonState)] {
    let layout = game.layout(screen());
    let mut out: Vec[(i32, ButtonState)] = Vec.new();
    for i in 0..layout.buttons.len() {
        match layout.buttons[i].target {
            Target.SetSetting(s, value) => { if s == setting { out.push((value, layout.buttons[i].state)); } }
            _ => {}
        }
    }
    out
}

fn has_button(game: &GameState, target: Target) -> bool { game.layout(screen()).button_for(target).is_some() }

@test
fn the_settings_menu_opens_centered_over_the_panels_and_its_buttons_work() {
    sandbox(fn() can {Log, Rand, Assert} {
        let off = Target.SetSetting(Setting.TurnPlayback, 0);
        let on = Target.SetSetting(Setting.TurnPlayback, 1);
        // A unit selected, and a city with its queue open.
        let unit = GameState.new();
        let mut city = GameState.city_scenario();
        city.select_city();
        city.queue_selected_city_unit(BuildUnit.Melee);
        let mut games: Vec[GameState] = Vec.new();
        games.push(unit);
        games.push(city);
        while !games.is_empty() {
            let Option.Some(mut game) = games.pop() else { break; };
            assert(!has_button(&game, on));
            game.settings_open = true;
            let layout = game.layout(screen());
            // The menu is placed last, centered, and every setting's buttons, Close and Quit
            // take their own clicks there.
            let menu = layout.panels[layout.panels.len() - 1];
            let center = menu.min.add(menu.max).scale(0.5);
            assert(center.distance(screen().scale(0.5)) <= 1.5);
            for k in 0..5 { assert(setting_buttons(&game, SETTINGS[k]).len() >= 2); }
            let targets = [Target.CloseSettings, Target.Quit, on, off];
            for t in 0..4 {
                let Option.Some(i) = layout.button_for(targets[t]) else { assert(false); return; };
                let b = &layout.buttons[i];
                let middle = b.min.add(b.max).scale(0.5);
                let Option.Some(hit) = layout.button_at(middle) else { assert(false); return; };
                assert(layout.buttons[hit].target == targets[t]);
            }

            // Instant playback is on by default: ON is gold; OFF switches it off and turns
            // gold, and clicking it again changes nothing.
            assert(game.settings.instant_playback);
            let playback = setting_buttons(&game, Setting.TurnPlayback);
            assert(playback.len() == 2 && playback[0].1 == ButtonState.Ready && playback[1].1 == ButtonState.Queued);
            game.handle_click(button_cursor(&game, off), screen(), ClickMode.Normal);
            assert(!game.settings.instant_playback);
            let playback = setting_buttons(&game, Setting.TurnPlayback);
            assert(playback[0].1 == ButtonState.Queued && playback[1].1 == ButtonState.Ready);
            game.handle_click(button_cursor(&game, off), screen(), ClickMode.Normal);
            assert(!game.settings.instant_playback);
            game.handle_click(button_cursor(&game, on), screen(), ClickMode.Normal);
            assert(game.settings.instant_playback);

            game.handle_click(button_cursor(&game, Target.CloseSettings), screen(), ClickMode.Normal);
            assert(!game.settings_open);
            assert(!game.quit_requested());
        }
    });
}

@test
fn the_classic_settings_menu_has_a_button_per_choice_and_steps_the_rest() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        game.settings_open = true;
        for k in 0..5 {
            let setting = SETTINGS[k];
            let value = game.settings.get(setting);
            let (low, high) = setting.range();
            let buttons = setting_buttons(&game, setting);
            if steps_in_classic(setting) {
                // < and > set the values either side, faded at an end.
                assert(buttons.len() == 2);
                assert(buttons[0].0 == value - 1 && (buttons[0].1 == ButtonState.Disabled) == (value == low));
                assert(buttons[1].0 == value + 1 && (buttons[1].1 == ButtonState.Disabled) == (value == high));
            } else {
                // A button per value, the current one gold.
                assert(buttons.len() == high - low + 1);
                for b in 0..buttons.len() {
                    assert(buttons[b].0 == low + b);
                    assert((buttons[b].1 == ButtonState.Queued) == (low + b == value));
                }
            }
        }

        // The queue limit steps with < and >, and stops at the top.
        let limit = Setting.MaxQueuedTurns;
        let up = Target.SetSetting(limit, game.settings.get(limit) + 1);
        game.handle_click(button_cursor(&game, up), screen(), ClickMode.Normal);
        assert(game.settings.max_queued_turns == 7);
        game.set_setting(limit, 20);
        // Spent at the top.
        let at_top = setting_buttons(&game, limit);
        assert(at_top[1].0 == 21 && at_top[1].1 == ButtonState.Disabled);
        game.handle_click(button_cursor(&game, Target.SetSetting(limit, 21)), screen(), ClickMode.Normal);
        assert(game.settings.max_queued_turns == 20);

        // Fog picks its value by name.
        game.handle_click(button_cursor(&game, Target.SetSetting(Setting.FogStyle, 0)), screen(), ClickMode.Normal);
        assert(!game.settings.cloud_fog);
    });
}

@test
fn the_settings_menu_quit_button_asks_the_app_to_quit() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let _had = game.clear_selection();
        game.press_escape();
        assert(game.settings_open && !game.quit_requested());
        game.handle_click(button_cursor(&game, Target.Quit), screen(), ClickMode.Normal);
        assert(game.quit_requested());
    });
}

@test
fn clear_orders_and_disband_buttons_act_on_the_selection() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let Option.Some(first) = game.selected else { assert(false); return; };
        let id = game.units[first].id;
        // Nothing to clear yet.
        let clear = Target.Unit(UnitAction.ClearOrders);
        let layout = game.layout(screen());
        let Option.Some(b) = layout.button_for(clear) else { assert(false); return; };
        assert(layout.buttons[b].state == ButtonState.Disabled);
        game.hold_selected_unit();
        game.selected = Option.Some(first);
        assert(game.units[first].holding);
        game.handle_click(button_cursor(&game, clear), screen(), ClickMode.Normal);
        assert(!game.units[first].holding);

        // Disband asks first, then removes the unit.
        let count = game.units.len();
        let disband = Target.Unit(UnitAction.Disband);
        game.handle_click(button_cursor(&game, disband), screen(), ClickMode.Normal);
        assert(game.units.len() == count);
        game.handle_click(button_cursor(&game, disband), screen(), ClickMode.Normal);
        assert(game.units.len() == count - 1);
        for i in 0..game.units.len() { assert(game.units[i].id != id); }
    });
}

/// One frame as the app plays it (`on_frame`), with the cursor at `cursor`.
fn play_frame(game: &mut GameState, cursor: Vec2) can {Log, Rand} {
    game.update(0.016);
    game.animate_clouds(0.016);
    game.update_hover(Option.Some(cursor), screen(), 0.016);
    let _world = game.build_vertices();
    let _ui = game.build_ui(screen(), Option.Some(cursor));
}

@test
fn clicking_the_city_opens_it_and_frames_keep_coming() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.city_scenario();
        for _ in 0..3 { play_frame(&mut game, vec2(10.0, 10.0)); }
        let at = hex_cursor(&game, game.cities[0].pos);
        game.handle_click(at, screen(), ClickMode.Normal);
        assert(game.selected_city == Option.Some(0));
        // Long enough for the tile tooltip under the cursor to appear.
        for _ in 0..60 { play_frame(&mut game, at); }
        assert(game.selected_city == Option.Some(0));
    });
}

@test
fn every_city_tray_button_can_be_hovered_and_clicked() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.city_scenario();
        let at = hex_cursor(&game, game.cities[0].pos);
        game.handle_click(at, screen(), ClickMode.Normal);
        let buttons = game.layout(screen()).buttons.len();
        // The tray has more than the top bar's and debug panel's buttons.
        assert(buttons > 10);
        for b in 0..buttons {
            let mut fresh = GameState.city_scenario();
            fresh.handle_click(at, screen(), ClickMode.Normal);
            let layout = fresh.layout(screen());
            if b >= layout.buttons.len() { continue; }
            let button = &layout.buttons[b];
            let cursor = to_ui(button.min.add(button.max).scale(0.5), screen());
            for _ in 0..2 { play_frame(&mut fresh, cursor); }
            fresh.handle_click(cursor, screen(), ClickMode.Normal);
            for _ in 0..2 { play_frame(&mut fresh, cursor); }
        }
    });
}

/// Whether the card for `building` is shown in the open city's catalog, in `want`.
fn building_card_is(game: &GameState, building: Building, want: ButtonState) -> bool {
    let layout = game.layout(screen());
    for b in 0..layout.buttons.len() {
        if layout.buttons[b].target == Target.Building(building) {
            return match (layout.buttons[b].state, want) {
                (ButtonState.Ready, ButtonState.Ready) | (ButtonState.Queued, ButtonState.Queued) | (ButtonState.Disabled, ButtonState.Disabled) => true,
                _ => false,
            };
        }
    }
    false
}

/// Plays the turn out to the next planning phase.
fn play_turn_out(game: &mut GameState) can {Log, Rand, Assert} {
    game.end_planning();
    assert(game.is_resolving());
    while game.is_resolving() { game.update(10.0); }
}

fn queued(game: &GameState, city: i32, building: Building) -> bool { game.cities[city].queue.contains(Build.Building(building)) }

@test
fn harbor_reveals_naval_build_cards_in_the_shared_city_tray() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.naval_scenario();
        game.select_city();
        let ships = [BuildUnit.PatrolGalley, BuildUnit.LandingCraft, BuildUnit.BombardShip];
        for k in 0..3 {
            let card = button_cursor(&game, Target.Build(ships[k]));
            let layout = game.layout(screen());
            let Option.Some(i) = layout.button_at(to_ui(card, screen())) else { assert(false); return; };
            assert(layout.buttons[i].target == Target.Build(ships[k]));
        }
        game.handle_click(button_cursor(&game, Target.Build(BuildUnit.LandingCraft)), screen(), ClickMode.Normal);
        let city = game.selected_city.unwrap_or(0 - 1);
        assert(game.cities[city].queue.contains(Build.Unit(BuildUnit.LandingCraft)));
    });
}

@test
fn ending_the_turn_while_choosing_a_site_leaves_no_preview_on_the_map() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = city_view();
        game.units.clear();
        let city = game.selected_city.unwrap_or(0 - 1);
        // Something else to build, so the city isn't left empty-handed.
        game.queue_selected_city_worker();
        game.handle_click(button_cursor(&game, Target.Building(Building.Barracks)), screen(), ClickMode.Normal);
        assert(game.placing(city, Building.Barracks) && game.site_placement().is_some());
        play_turn_out(&mut game);
        assert(game.selected_city.is_none());
        assert(game.site_placement().is_none());
        assert(game.placing_building.is_none());
        // A Barracks with no site is taken back out of the queue.
        assert(!queued(&game, city, Building.Barracks));
    });
}

@test
fn a_building_finished_with_its_city_closed_picks_its_site_when_reopened() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = city_view();
        game.units.clear();
        let city = game.selected_city.unwrap_or(0 - 1);
        // A Barracks queued with no site and not being placed.
        game.cities[city].queue.push(Build.Building(Building.Barracks));
        assert(game.exit_structure_menu());
        game.cities[city].production = Building.Barracks.cost();
        play_turn_out(&mut game);
        // Paid for, the Barracks waits for a site.
        assert(game.cities[city].pending_building == Option.Some(Building.Barracks));
        // Finishing it during the turn starts no placement with no city open.
        assert(game.placing_building.is_none());
        assert(game.site_placement().is_none());

        // Opening the city resumes choosing the site, and the card isn't dead.
        game.open_city(city);
        game.update(10.0);
        assert(game.placing(city, Building.Barracks) && game.site_placement().is_some());
        assert(!building_card_is(&game, Building.Barracks, ButtonState.Disabled));
        let site = Hex.new(-2, 0);
        assert(game.site_available(city, Building.Barracks, site));
        let _ours = game.city_click(site);
        game.confirm_building(Building.Barracks);
        assert(game.cities[city].barracks == Option.Some(site));
    });
}

@test
fn escape_while_choosing_a_site_cancels_the_building() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = city_view();
        game.units.clear();
        let city = game.selected_city.unwrap_or(0 - 1);
        assert(building_card_is(&game, Building.Barracks, ButtonState.Ready));
        game.handle_click(button_cursor(&game, Target.Building(Building.Barracks)), screen(), ClickMode.Normal);
        assert(queued(&game, city, Building.Barracks));

        // The first Escape only cancels choosing the site, and the Barracks.
        assert(game.exit_structure_menu());
        // The city stays open.
        assert(game.selected_city == Option.Some(city));
        assert(game.site_placement().is_none());
        assert(!queued(&game, city, Building.Barracks));
        assert(building_card_is(&game, Building.Barracks, ButtonState.Ready));

        // End Turn mid-placement cancels it, and the city, left with nothing to build, asks
        // for something instead of ending the turn.
        game.handle_click(button_cursor(&game, Target.Building(Building.Barracks)), screen(), ClickMode.Normal);
        game.end_planning();
        assert(!game.is_resolving());
        assert(game.selected_city == Option.Some(city));
        assert(!queued(&game, city, Building.Barracks));

        // Closing the city mid-placement cancels it too.
        game.handle_click(button_cursor(&game, Target.Building(Building.Barracks)), screen(), ClickMode.Normal);
        game.leave_city_view();
        game.open_city(city);
        game.update(10.0);
        assert(!queued(&game, city, Building.Barracks));
        assert(game.site_placement().is_none());
        assert(building_card_is(&game, Building.Barracks, ButtonState.Ready));

        // With its site chosen, the card is spent until the Barracks is removed.
        game.handle_click(button_cursor(&game, Target.Building(Building.Barracks)), screen(), ClickMode.Normal);
        let _ours = game.city_click(Hex.new(-2, 0));
        // Nothing to cancel: Escape closes.
        assert(game.exit_structure_menu());
        assert(game.selected_city.is_none());
        // A Barracks with a site stays queued.
        assert(queued(&game, city, Building.Barracks));
        game.open_city(city);
        assert(building_card_is(&game, Building.Barracks, ButtonState.Disabled));
        let at = game.cities[city].queue.index_of(Build.Building(Building.Barracks));
        game.remove_selected_city_queue_item(at);
        assert(building_card_is(&game, Building.Barracks, ButtonState.Ready));
    });
}

@test
fn opening_another_view_drops_the_site_placement() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = city_view();
        game.units.clear();
        let city = game.selected_city.unwrap_or(0 - 1);
        game.cities[city].barracks = Option.Some(Hex.new(-2, 0));
        game.queue_selected_city_building(Building.Mill);
        assert(game.placing(city, Building.Mill) && game.site_placement().is_some());
        game.open_barracks(city);
        assert(game.site_placement().is_none());
        assert(game.placing_building.is_none());
        assert(!queued(&game, city, Building.Mill));
    });
}

/// The Cities scenario, explored, nothing selected, and an open, unoccupied land tile two from
/// Blue's city with no road or city on it, the smallest `(q, r)`.
fn empty_tile_near_blue_city() -> (GameState, Hex) can {Log} {
    let mut game = GameState.city_scenario();
    game.explore();
    let _had = game.clear_selection();
    let city = game.cities[0].pos;
    let mut best: Option[Hex] = Option.None;
    for hh in game.grid.hexes() {
        let h = *hh;
        if h.distance(city) != 2 || !game.grid.is_passable(h) || game.roads.contains(h) || game.count_at(h) > 0 || !game.is_explored(h) || game.city_at(h).is_some() { continue; }
        let better = match best { Option.None => true, Option.Some(b) => h.q < b.q || (h.q == b.q && h.r < b.r) };
        if better { best = Option.Some(h); }
    }
    (game, best.unwrap_or(city))
}

fn job_button_armed(game: &GameState, kind: JobKind) -> bool {
    let layout = game.layout(screen());
    match layout.button_for(Target.WorkerJob(kind)) { Option.Some(i) => layout.buttons[i].armed, Option.None => false }
}

@test
fn the_city_panel_opens_the_worker_menu_and_done_closes_it() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.city_scenario();
        game.select_city();
        game.handle_click(button_cursor(&game, Target.WorkerMode), screen(), ClickMode.Normal);
        assert(game.worker_mode);
        assert(game.selected_city.is_none());
        game.handle_click(button_cursor(&game, Target.WorkerMode), screen(), ClickMode.Normal);
        assert(!game.worker_mode);
    });
}

@test
fn the_worker_menu_places_a_picked_job_on_the_map() {
    sandbox(fn() can {Log, Rand, Assert} {
        let (mut game, hex) = empty_tile_near_blue_city();
        game.toggle_worker_mode();
        let layout = game.layout(screen());
        for k in 0..6 {
            let Option.Some(i) = layout.button_for(Target.WorkerJob(JOB_KINDS[k])) else { assert(false); return; };
            let button = &layout.buttons[i];
            // Every job's button sits inside its panel.
            let mut inside = false;
            for p in 0..layout.panels.len() {
                let r = layout.panels[p];
                if r.min.x <= button.min.x && r.min.y <= button.min.y && button.max.x <= r.max.x && button.max.y <= r.max.y { inside = true; }
            }
            assert(inside);
        }
        // With nothing picked, a map click places nothing.
        game.handle_map_click(hex_cursor(&game, hex), screen(), ClickMode.Normal);
        assert(game.cities[0].worker_jobs.is_empty());
        game.handle_click(button_cursor(&game, Target.WorkerJob(JobKind.Road)), screen(), ClickMode.Normal);
        assert(game.placing_job == Option.Some(JobKind.Road));
        // The button shows it's picked.
        assert(job_button_armed(&game, JobKind.Road));
        game.handle_map_click(hex_cursor(&game, hex), screen(), ClickMode.Normal);
        assert(game.cities[0].worker_jobs.len() == 1);
        assert(game.cities[0].worker_jobs[0].hex == hex && game.cities[0].worker_jobs[0].kind == JobKind.Road);
        // Still picked, for the next one.
        assert(job_button_armed(&game, JobKind.Road));
        // Picking it again puts it down.
        game.handle_click(button_cursor(&game, Target.WorkerJob(JobKind.Road)), screen(), ClickMode.Normal);
        assert(game.placing_job.is_none());
    });
}

@test
fn a_wall_is_placed_by_dragging_along_hex_edges() {
    sandbox(fn() can {Log, Rand, Assert} {
        let (mut game, hex) = empty_tile_near_blue_city();
        game.toggle_worker_mode();
        game.handle_click(button_cursor(&game, Target.WorkerJob(JobKind.Wall)), screen(), ClickMode.Normal);
        assert(game.placing_job == Option.Some(JobKind.Wall));
        assert(job_button_armed(&game, JobKind.Wall));

        // Drag across the midpoints of three of the hex's edges, as the mouse would pass over
        // them.
        let around = hex.neighbors();
        let mut sides: Vec[Hex] = Vec.new();
        for k in 0..6 { if sides.len() < 3 && game.grid.contains(around[k]) { sides.push(around[k]); } }
        for k in 0..sides.len() {
            let at = game.camera.world_to_screen(hex.to_world().add(sides[k].to_world()).scale(0.5), screen());
            assert(game.paint_job_at(at, screen(), false));
            // Passing the same edge again adds nothing.
            let _again = game.paint_job_at(at, screen(), false);
        }
        {
            let jobs = &game.cities[0].worker_jobs;
            assert(jobs.len() == 3);
            for k in 0..3 {
                assert(jobs[k].kind == JobKind.Wall);
                assert(edge(jobs[k].hex, jobs[k].across.unwrap_or(jobs[k].hex)) == edge(hex, sides[k]));
            }
        }

        // A press on the panel itself doesn't place anything through it.
        assert(!game.paint_job_at(button_cursor(&game, Target.WorkerJob(JobKind.Wall)), screen(), true));

        // Escape stops placing but leaves the worker menu open.
        game.press_escape();
        assert(game.placing_job.is_none());
        assert(game.worker_mode);
        let at = game.camera.world_to_screen(hex.to_world().add(sides[0].to_world()).scale(0.5), screen());
        assert(!game.paint_job_at(at, screen(), false));
    });
}

@test
fn a_plain_click_on_an_empty_tile_opens_nothing() {
    sandbox(fn() can {Log, Rand, Assert} {
        let (mut game, hex) = empty_tile_near_blue_city();
        game.handle_click(hex_cursor(&game, hex), screen(), ClickMode.Normal);
        assert(game.selected.is_none());
        // Workers take orders from the worker menu only.
        let layout = game.layout(screen());
        for b in 0..layout.buttons.len() {
            assert(match layout.buttons[b].target { Target.WorkerJob(_) => false, _ => true });
        }
    });
}

@test
fn city_interior_map_fits_and_its_tiles_issue_orders() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.siege_scenario();
        let layout = game.layout(screen());
        let tiles = [Hex.new(-2, 0), Hex.new(-1, 0), Hex.new(0, 0), Hex.new(2, 0)];
        for k in 0..4 {
            let cursor = hex_cursor(&game, tiles[k]);
            assert(cursor.x > 0.0 && cursor.x < SCREEN_W);
            assert(cursor.y > 0.0 && cursor.y < SCREEN_H);
            // No interior tile hidden by a panel.
            assert(!layout.covers(to_ui(cursor, screen())));
        }
        game.handle_click(hex_cursor(&game, Hex.new(-2, 0)), screen(), ClickMode.Normal);
        game.handle_click(hex_cursor(&game, Hex.new(-1, 0)), screen(), ClickMode.Normal);
        let Option.Some(k) = game.cities[1].interior.index_of(0) else { assert(false); return; };
        assert(game.cities[1].interior.fighters[k].planned_move == Option.Some(Hex.new(-1, 0)));
    });
}
