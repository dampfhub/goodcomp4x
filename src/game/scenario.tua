//! Testing aids: switching between the scenario pages (F1-F3; pressing the current one's key
//! again restarts it), and a savestate (F6 saves, F7 loads) holding a snapshot of the whole
//! game. The savestate survives switching pages, and loading it can be repeated to retry the
//! same situation.

use std.collections.Deque;
use std.core.Eq;
use std.collections.Key;
use std.collections.Map;
use std.collections.Set;
use std.fmt.Out;
use std.fmt.show_u64;
use std.mem.swap;
use std.str.Str;
use std.str.to_owned;
use log.Log;
use game.GameState;
use game.text;
use game.city.City;
use game.hex.HexGrid;
use game.turn.Phase;
use game.unit.UnitType;
use game.settings.Settings;
use game.ruins.Ruin;
use std.rand.Rand;
use std.rand.draw;

/// The test scenarios F1-F3 switch between.
pub enum Scenario {
    /// The original small combat map.
    Combat,
    /// Two cities with their economies set up.
    Cities,
    /// A settler each and no cities yet.
    Frontier,
    /// The player and 4-6 AI sides on a randomly generated map (`mapgen.tua`).
    World,
}

pub const SCENARIOS: [Scenario; 4] = [Scenario.Combat, Scenario.Cities, Scenario.Frontier, Scenario.World];

impl Eq for Scenario {
    fn eq(self, other: Scenario) -> bool { self.index() == other.index() }
}

impl Scenario {
    pub fn name(self) -> str {
        match self {
            Scenario.Combat => "COMBAT",
            Scenario.Cities => "CITIES",
            Scenario.Frontier => "FRONTIER",
            Scenario.World => "WORLD",
        }
    }

    /// Its place in `SCENARIOS`.
    pub fn index(self) -> i32 {
        match self { Scenario.Combat => 0, Scenario.Cities => 1, Scenario.Frontier => 2, Scenario.World => 3 }
    }

    /// The function key that switches to it.
    pub fn key(self) -> str {
        match self {
            Scenario.Combat => "F1",
            Scenario.Cities => "F2",
            Scenario.Frontier => "F3",
            Scenario.World => "F4",
        }
    }

    /// A fresh game of this scenario, drawing the world's map seed from `Rand` and building it
    /// as `settings` say (`Settings.world_ai`, `Settings.world_start_city`).
    pub fn start(self, settings: &Settings) -> GameState can {Log, Rand} {
        match self {
            Scenario.Combat => GameState.new(),
            Scenario.Cities => GameState.city_scenario(),
            Scenario.Frontier => GameState.frontier_scenario(),
            Scenario.World => GameState.world_scenario_with(draw().shr(32) as u32, settings),
        }
    }
}

impl GameState {
    /// F1-F3: starts `scenario` afresh (restarting it, if it's the current one), keeping the
    /// savestate and the player's settings (and whether their menu is open).
    pub fn switch_scenario(&mut self, scenario: Scenario) can {Log, Rand} {
        let mut next = scenario.start(&self.settings);
        swap(&mut next.savestate, &mut self.savestate);
        next.settings = self.settings.copy();
        next.settings_open = self.settings_open;
        next.fog_of_war = self.fog_of_war;
        *self = next;
    }

    /// F8: switches turn playback between one step at a time and all at once.
    pub fn toggle_instant_playback(&mut self) {
        self.settings.instant_playback = !self.settings.instant_playback;
        if self.settings.instant_playback {
            self.set_notice("TURNS NOW PLAY OUT ALL AT ONCE - F8 FOR STEP BY STEP");
        } else {
            self.set_notice("TURNS NOW PLAY OUT STEP BY STEP - F8 FOR ALL AT ONCE");
        }
    }

    /// F6: saves a snapshot of the whole game, replacing any earlier one.
    pub fn save_state(&mut self) {
        if self.is_resolving() {
            self.set_notice("CAN'T SAVE WHILE A TURN PLAYS OUT");
            return;
        }
        // Drop the old snapshot first so it isn't copied into the new one.
        self.savestate = Option.None;
        let snapshot = self.snapshot();
        self.savestate = Option.Some(box snapshot);
        self.notice = text(fn() can {Out} { Out.put("SAVED "); self.show_saved(); Out.put(" - F7 LOADS IT"); });
    }

    /// F7: restores the saved snapshot, keeping it to load again. The camera stays where it
    /// is, unless the snapshot is from another scenario.
    pub fn load_state(&mut self) {
        let Option.Some(mut restored) = self.saved_snapshot() else {
            self.set_notice("NOTHING SAVED YET - F6 SAVES");
            return;
        };
        let loaded = text(fn() can {Out} { Out.put("LOADED "); self.show_saved(); });
        if restored.scenario == self.scenario { restored.camera = self.camera; }
        restored.settings = self.settings.copy();
        restored.settings_open = self.settings_open;
        restored.fog_of_war = self.fog_of_war;
        restored.notice = loaded;
        // The snapshot is kept: it moves into the restored game.
        swap(&mut restored.savestate, &mut self.savestate);
        *self = restored;
    }

    /// A fresh copy of the saved snapshot, if there is one.
    fn saved_snapshot(&self) -> Option[GameState] {
        match &self.savestate {
            &Option.Some(saved) => Option.Some(saved.snapshot()),
            &Option.None => Option.None,
        }
    }

    /// What's saved, like `TURN 3 OF CITIES`; nothing when nothing is.
    pub fn show_saved(&self) can {Out} {
        if let &Option.Some(saved) = &self.savestate {
            Out.put("TURN ");
            show_u64((saved.turn + 1) as u64);
            Out.put(" OF ");
            Out.put(saved.scenario.name());
        }
    }

    /// A copy of the whole game without its savestate: what F6 keeps.
    pub fn snapshot(&self) -> GameState {
        let mut cities: Vec[City] = Vec.new();
        for i in 0..self.cities.len() {
            let c = &self.cities[i];
            cities.push(City { id: c.id, team: c.team, pos: c.pos, population: c.population, food: c.food, production: c.production, worked: copy_vec(&c.worked), queue: c.queue });
        }
        let mut pending_steps: Deque[(UnitType, Phase)] = Deque.new();
        for i in 0..self.pending_steps.len() {
            if let Option.Some(step) = self.pending_steps.at(i) { pending_steps.push_back(step); }
        }
        GameState {
            cities,
            sites: copy_map(&self.sites),
            roads: copy_set(&self.roads),
            selected_city: self.selected_city,
            hovered_city: self.hovered_city,
            show_yields: self.show_yields,
            show_details: self.show_details,
            ui_click_mode: self.ui_click_mode,
            inspected_tile: self.inspected_tile,
            hovered_tile: self.hovered_tile,
            hover_seconds: self.hover_seconds,
            notice: copy_str(&self.notice),
            grid: self.grid.snapshot(),
            units: copy_units(&self.units),
            selected: self.selected,
            group: copy_vec(&self.group),
            scenario: self.scenario,
            savestate: Option.None,
            effects: copy_vec(&self.effects),
            settings: self.settings.copy(),
            map_seed: self.map_seed,
            ruins: copy_vec(&self.ruins),
            fog_of_war: self.fog_of_war,
            memory: copy_map(&self.memory),
            cloud_time: self.cloud_time,
            queue_replace_armed: Option.None,
            disband_armed: Option.None,
            settings_open: self.settings_open,
            quit_requested: self.quit_requested,
            turn: self.turn,
            camera: self.camera,
            pending_steps,
            step_timer: self.step_timer,
            recent_actors: copy_vec(&self.recent_actors),
            highlight_timer: self.highlight_timer,
            settlers: self.settlers.snapshot(),
            workers: self.workers.snapshot(),
            player_controlled_units: self.player_controlled_units.snapshot(),
            next_unit_id: self.next_unit_id,
        }
    }
}

fn copy_units(units: &Vec[Unit]) -> Vec[Unit] {
    let mut out: Vec[Unit] = Vec.new();
    for i in 0..units.len() { out.push(units[i].snapshot()); }
    out
}

fn copy_vec[T](v: &Vec[T]) -> Vec[T] {
    let mut out: Vec[T] = Vec.new();
    for i in 0..v.len() { out.push(v[i]); }
    out
}

fn copy_set[K: Key](s: &Set[K]) -> Set[K] {
    let mut out: Set[K] = Set.new();
    for i in 0..s.len() {
        if let Option.Some(k) = s.key_at(i) { let _new = out.insert(k); }
    }
    out
}

fn copy_map[K: Key, V](m: &Map[K, V]) -> Map[K, V] {
    let mut out: Map[K, V] = Map.new();
    for i in 0..m.len() {
        if let (Option.Some(k), Option.Some(v)) = (m.key_at(i), m.val_at(i)) { let _old = out.insert(k, v); }
    }
    out
}

fn copy_str(s: &Str) -> Str { to_owned(s) }
