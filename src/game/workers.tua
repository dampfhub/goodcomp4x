//! Workers: each city keeps a pool of workers at home, safe and off the map, and a queue of
//! jobs: everything the city puts on the map, placed from its production list and paid from the
//! stockpile when placed. Roads, tile improvements, structures and the city's buildings with a
//! site are all built this way. In the last step of every turn, after every unit has moved and
//! attacked, cities send idle workers out.
//! Each walks to its job, works it for a few turns, then takes the city's next job or walks
//! home. A worker out on the map is exposed: an enemy unit moving onto its hex captures it for
//! the enemy's nearest city, and an attack on its hex kills it. A unit standing on the same hex
//! shields it from both.
//!
//! Structures: walls and gates stand on the edge between two hexes, walls stopping everyone
//! from crossing it and gates everyone but their owner. Outposts (the owner sees around them)
//! and forts (the owner's units in one defend better) stand on a tile.

use std.collections.Deque;
use std.collections.Map;
use std.core.Eq;
use std.fmt.Out;
use std.fmt.Show;
use std.fmt.show_u64;
use std.linalg.Vec2;
use std.str.Str;
use std.str.eq as str_eq;
use std.str.to_owned;
use log.Log;
use log.info;
use game.GameState;
use game.text;
use game.city.Building;
use game.city.PLACEABLE;
use game.city.Site;
use game.city.Stock;
use game.city.stock_icons;
use game.city.no_stock;
use game.city.amount;
use game.city.SiteKind;
use game.scenario.copy_vec;
use game.terrain.Terrain;
use std.collections.Set;
use game.hex.Hex;
use game.ai.near_a_den;
use game.hex.edge;
use game.unit.Team;
use game.unit.Unit;

/// Hexes a worker walks per turn.
pub const WORKER_MOVE: i32 = 1;
/// How far from one of its side's cities a worker will go to work, in hexes, unless a road runs
/// by the job (`in_worker_reach`).
pub const WORKER_REACH: i32 = 3;
/// How far an outpost lets its owner see, and a worker out on the map.
pub const OUTPOST_SIGHT: i32 = 2;
pub const WORKER_SIGHT: i32 = 1;
/// Defense multiplier for the owner's units standing in a fort. A placeholder until forts get
/// their real role.
pub const FORT_DEFENSE: f32 = 1.5;

pub enum JobKind {
    Road,
    Improve,
    Wall,
    Gate,
    Outpost,
    Fort,
    /// One of the city's buildings with a site (every `Building`).
    Build(Building),
}

/// Every job, in the order the worker menu lists them.
pub const JOB_KINDS: [JobKind; 6] = [JobKind.Road, JobKind.Improve, JobKind.Wall, JobKind.Gate, JobKind.Outpost, JobKind.Fort];

impl Eq for JobKind {
    fn eq(self, other: JobKind) -> bool {
        match (self, other) {
            (JobKind.Build(a), JobKind.Build(b)) => a == b,
            (JobKind.Build(_), _) | (_, JobKind.Build(_)) => false,
            _ => self.index() == other.index(),
        }
    }
}

impl JobKind {
    pub fn index(self) -> i32 {
        match self { JobKind.Road => 0, JobKind.Improve => 1, JobKind.Wall => 2, JobKind.Gate => 3, JobKind.Outpost => 4, JobKind.Fort => 5, JobKind.Build(b) => 6 + b.index() }
    }

    pub fn name(self) -> str {
        match self {
            JobKind.Road => "ROAD",
            JobKind.Improve => "IMPROVE",
            JobKind.Wall => "WALL",
            JobKind.Gate => "GATE",
            JobKind.Outpost => "OUTPOST",
            JobKind.Fort => "FORT",
            JobKind.Build(building) => building.name(),
        }
    }

    /// What placing it takes from the side's stockpile (`city/economy.tua`), given back if it's
    /// taken off the list or dropped before it's done.
    pub fn price(self) -> Stock {
        match self {
            JobKind.Road => Stock.whole(0, 2, 0),
            JobKind.Improve => Stock.whole(0, 4, 0),
            JobKind.Wall => Stock.whole(0, 3, 0),
            JobKind.Gate => Stock.whole(0, 3, 2),
            JobKind.Outpost => Stock.whole(0, 6, 0),
            JobKind.Fort => Stock.whole(0, 8, 4),
            JobKind.Build(building) => building.price(),
        }
    }

    /// Turns of work once the worker stands on the tile.
    pub fn turns(self) -> u32 {
        match self {
            JobKind.Road | JobKind.Wall => 2,
            JobKind.Improve | JobKind.Gate | JobKind.Outpost => 3,
            JobKind.Fort => 4,
            JobKind.Build(building) => building.turns() as u32,
        }
    }

    pub fn description(self) -> str {
        match self {
            JobKind.Road => "CHEAPER DELIVERY, AND WORKERS REACH ALONG IT.",
            JobKind.Improve => "MINE ON HILLS, LUMBER MILL IN FOREST, ELSE A FARM.",
            JobKind.Wall => "ON AN EDGE: NOBODY CROSSES.",
            JobKind.Gate => "ON AN EDGE: ONLY YOUR SIDE CROSSES.",
            JobKind.Outpost => "SEES 2 HEXES AROUND IT.",
            JobKind.Fort => "+50% DEFENSE FOR YOUR UNITS IN IT.",
            JobKind.Build(building) => building.description(),
        }
    }

    /// The structure the job builds, if any.
    pub fn structure(self) -> Option[StructureKind] {
        match self {
            JobKind.Road | JobKind.Improve | JobKind.Build(_) => Option.None,
            JobKind.Wall => Option.Some(StructureKind.Wall),
            JobKind.Gate => Option.Some(StructureKind.Gate),
            JobKind.Outpost => Option.Some(StructureKind.Outpost),
            JobKind.Fort => Option.Some(StructureKind.Fort),
        }
    }

    /// Whether the job goes on the edge between two hexes rather than on a tile.
    pub fn on_edge(self) -> bool { self == JobKind.Wall || self == JobKind.Gate }

    /// Whether the job builds one of the city's buildings.
    pub fn is_building(self) -> bool { match self { JobKind.Build(_) => true, _ => false } }
}

pub enum StructureKind { Wall, Gate, Outpost, Fort }

impl Eq for StructureKind {
    fn eq(self, other: StructureKind) -> bool {
        match (self, other) {
            (StructureKind.Wall, StructureKind.Wall) | (StructureKind.Gate, StructureKind.Gate) | (StructureKind.Outpost, StructureKind.Outpost) | (StructureKind.Fort, StructureKind.Fort) => true,
            _ => false,
        }
    }
}

pub struct Structure { kind: StructureKind, team: Team }

impl Structure {
    /// Whether a unit, worker or goods of `team` may cross the wall or gate.
    pub fn admits(&self, team: Team) -> bool {
        match self.kind {
            StructureKind.Wall => false,
            StructureKind.Gate => self.team == team,
            StructureKind.Outpost | StructureKind.Fort => true,
        }
    }
}

pub struct WorkerJob {
    /// Where the worker stands to do it.
    hex: Hex,
    kind: JobKind,
    /// For a wall or gate, the hex across the edge it goes on.
    across: Option[Hex],
    /// Turns of work already put into it. It stays with the job when its worker leaves (recalled,
    /// captured or killed), so whichever worker takes it next only does the rest.
    done: u32,
}

impl Eq for WorkerJob {
    fn eq(self, other: WorkerJob) -> bool { self.hex == other.hex && self.kind == other.kind && self.across == other.across && self.done == other.done }
}

impl WorkerJob {
    pub fn on_tile(hex: Hex, kind: JobKind) -> WorkerJob { WorkerJob { hex, kind, across: Option.None, done: 0 } }

    /// The same job with no work put into it: what it is and where, which tells two jobs apart.
    pub fn fresh(&self) -> WorkerJob { WorkerJob { hex: self.hex, kind: self.kind, across: self.across, done: 0 } }

    /// Whether two jobs would build on the same place: the same tile, or for walls and gates,
    /// the same edge.
    pub fn same_place(&self, other: WorkerJob) -> bool {
        match (self.across, other.across) {
            (Option.Some(a), Option.Some(b)) => edge(self.hex, a) == edge(other.hex, b),
            (Option.None, Option.None) => self.hex == other.hex && self.kind == other.kind,
            _ => false,
        }
    }
}

impl GameState {
    /// Whether a unit or worker may stand on `hex`: open ground.
    pub fn can_enter(&self, hex: Hex) -> bool { self.grid.is_passable(hex) }

    /// The wall or gate on the edge between adjacent `a` and `b`, if any.
    pub fn barrier(&self, a: Hex, b: Hex) -> Option[Structure] { self.barriers.get(edge(a, b)) }

    /// Whether `team` may cross the edge between adjacent `from` and `to`: no wall there, and no
    /// gate but its own.
    pub fn can_cross(&self, from: Hex, to: Hex, team: Team) -> bool {
        match self.barrier(from, to) { Option.Some(b) => b.admits(team), Option.None => true }
    }

    /// Whether a unit or worker of `team` can step from `from` onto the adjacent `to`. Enemy
    /// city centers are entered through the interior battle, not by walking onto the exterior
    /// marker.
    pub fn can_step(&self, from: Hex, to: Hex, team: Team) -> bool {
        self.can_enter(to) && !self.enemy_city_at(to, team) && self.can_cross(from, to, team)
    }

    /// Whether `unit` stands in a fort of its own side.
    pub fn in_fort(&self, unit: &Unit) -> bool {
        match self.structures.get(unit.pos) {
            Option.Some(s) => s.kind == StructureKind.Fort && s.team == unit.team,
            Option.None => false,
        }
    }

    /// Terrain and fort bonuses on `unit`'s defense.
    pub fn defense_multiplier(&self, unit: &Unit) -> f32 {
        let fort = if self.in_fort(unit) { FORT_DEFENSE } else { 1.0 };
        self.grid.tile(unit.pos).defense_multiplier() * fort
    }
}

/// The hex edge nearest `point` among `hex`'s six, as the neighbour across it.
pub fn nearest_edge(hex: Hex, point: Vec2) -> Hex {
    let around = hex.neighbors();
    let mut best = around[0];
    let mut best_distance = midpoint(hex, around[0]).distance(point);
    for k in 1..6 {
        let d = midpoint(hex, around[k]).distance(point);
        if d < best_distance {
            best = around[k];
            best_distance = d;
        }
    }
    best
}

fn midpoint(a: Hex, b: Hex) -> Vec2 { a.to_world().add(b.to_world()).scale(0.5) }

/// A worker out on the map.
pub struct FieldWorker {
    id: u32,
    team: Team,
    /// The city it belongs to and returns to.
    home: i32,
    /// The city center or connected Work Camp this assignment uses as a base.
    base: Hex,
    pos: Hex,
    /// What it's out to do; `None` while it walks home.
    job: Option[WorkerJob],
    /// Turns of work left, once it stands on the job's tile.
    work_left: Option[u32],
    /// Sent home by the player: it takes no job until it gets there, and there it's held
    /// (`City.held_workers`) until the player releases it.
    recalled: bool,
}

/// The improvement a worker builds on a tile: its yields and its kind.
pub struct Improvement { food: i32, production: i32, kind: SiteKind }

impl GameState {
    /// How many of city `city`'s workers are out on the map.
    pub fn workers_out(&self, city: i32) -> i32 {
        let mut n = 0;
        for w in 0..self.field_workers.len() { if self.field_workers[w].home == city { n = n + 1; } }
        n
    }

    /// `team`'s city nearest `hex`, ties going to the older city.
    pub fn nearest_city(&self, team: Team, hex: Hex) -> Option[i32] {
        let mut best: Option[i32] = Option.None;
        for i in 0..self.cities.len() {
            if self.cities[i].team != team { continue; }
            let closer = match best { Option.None => true, Option.Some(b) => self.cities[i].pos.distance(hex) < self.cities[b].pos.distance(hex) };
            if closer { best = Option.Some(i); }
        }
        best
    }

    /// The player's city whose workers build what's placed on the map: the open city. Everything a
    /// worker builds is placed from its city.
    pub fn job_city(&self) -> Option[i32] {
        match self.selected_city {
            Option.Some(city) => if self.cities[city].team == self.local_team { Option.Some(city) } else { Option.None },
            Option.None => Option.None,
        }
    }
    /// What `job` builds, as the player reads it: an improvement by its kind (FARM, MINE or
    /// LUMBER MILL), anything else by the job's name.
    pub fn job_name(&self, job: WorkerJob) -> str {
        if job.kind == JobKind.Improve {
            if let Option.Some(improvement) = self.improvement(job.hex) { return improvement.kind.name(); }
        }
        job.kind.name()
    }

    /// A job as the worker menu names it: what it builds, and the tile it's on, like
    /// "FARM · GRASSLAND" or "MINE · PLAINS HILLS".
    pub fn job_title(&self, job: WorkerJob) -> Str {
        let tile = self.grid.tile(job.hex).name();
        text(fn() can {Out} { Out.put(self.job_name(job)); Out.put(" \u{b7} "); Out.put(&tile); })
    }

    /// The improvement a worker would build at `hex`: a mine on hills, a lumber mill in forest
    /// or jungle, a farm elsewhere; nothing on snow.
    pub fn improvement(&self, hex: Hex) -> Option[Improvement] {
        let tile = self.grid.tile(hex);
        let (food, production) = tile.yields();
        if tile.terrain == Terrain.Snow {
            Option.None
        } else if tile.hills {
            Option.Some(Improvement { food, production: production + 2, kind: SiteKind.Mine })
        } else if tile.feature.is_some() {
            Option.Some(Improvement { food, production: production + 1, kind: SiteKind.LumberMill })
        } else {
            Option.Some(Improvement { food: food + 2, production, kind: SiteKind.Farm })
        }
    }

    /// Whether a placed building of any city stands on `hex`.
    fn building_at(&self, hex: Hex) -> bool {
        for c in 0..self.cities.len() {
            for b in 0..14 { if self.cities[c].placed_site(PLACEABLE[b]) == Option.Some(hex) { return true; } }
        }
        false
    }

    /// Why city `city`'s workers can't do `job`, or `None` if they can.
    pub fn job_problem(&self, city: i32, job: WorkerJob) -> Option[str] {
        let team = self.cities[city].team;
        let hex = job.hex;
        if !self.grid.contains(hex) || !self.grid.is_passable(hex) { return Option.Some("WORKERS CAN'T WORK THIS TERRAIN"); }
        if !self.in_worker_reach(team, hex) {
            return Option.Some("OUT OF REACH: WORKERS GO 3 TILES FROM A CITY OR WORK CAMP, OR NEXT TO A ROAD");
        }
        if let Option.Some(across) = job.across {
            return if hex.distance(across) != 1 || !self.grid.contains(across) {
                Option.Some("WALLS AND GATES GO BETWEEN TWO TILES ON THE MAP")
            } else if self.barriers.has(edge(hex, across)) {
                Option.Some("A WALL OR GATE STANDS HERE")
            } else {
                Option.None
            };
        }
        if self.city_at(hex).is_some() { return Option.Some("A CITY STANDS HERE"); }
        if let JobKind.Build(building) = job.kind {
            if self.cities[city].built.contains(building) { return Option.Some("THIS CITY HAS ONE ALREADY"); }
            if self.structures.has(hex) { return Option.Some("A STRUCTURE STANDS HERE"); }
            return self.ai_site_issue(city, building, hex);
        }
        let building = self.building_at(hex);
        match job.kind {
            JobKind.Road => if self.is_road_hex(hex) { Option.Some("THERE IS A ROAD HERE ALREADY") } else { Option.None },
            JobKind.Improve => {
                if building { return Option.Some("A BUILDING STANDS HERE"); }
                match self.sites.get(hex) {
                    Option.Some(site) => if site.team != team { Option.Some("THIS TILE BELONGS TO THE ENEMY") } else { Option.Some("THIS TILE IS IMPROVED ALREADY") },
                    Option.None => if self.improvement(hex).is_none() { Option.Some("NOTHING GROWS ON SNOW") } else { Option.None },
                }
            }
            _ => {
                if building { Option.Some("A BUILDING STANDS HERE") } else if self.structures.has(hex) { Option.Some("A STRUCTURE STANDS HERE") } else { Option.None }
            }
        }
    }

    /// Player-facing reach uses the last observed roads. Turn resolution continues to use
    /// `in_worker_reach` and the real board.
    pub fn known_worker_reach(&self, hex: Hex) -> bool {
        let fog = self.fog();
        let mut bases: Vec[Hex] = Vec.new();
        for i in 0..self.cities.len() {
            if self.cities[i].team != self.local_team { continue; }
            bases.push(self.cities[i].pos);
            if let Option.Some(camp) = self.cities[i].placed_site(Building.WorkCamp) {
                if self.known_routes(i, &fog).costs.has(camp) { bases.push(camp); }
            }
        }
        for b in 0..bases.len() { if bases[b].distance(hex) <= WORKER_REACH { return true; } }
        let ring = hex.neighbors();
        let mut around: Vec[Hex] = Vec.new();
        for k in 0..6 { around.push(ring[k]); }
        around.push(hex);
        for k in 0..around.len() {
            let h = around[k];
            let road = if fog.sees(h) { self.roads.contains(h) } else { match self.memory.get(h) { Option.Some(seen) => seen.road, Option.None => false } };
            if road { return true; }
        }
        false
    }

    /// Player-facing job check for city `home`: unseen mutable objects come from memory, never
    /// from the live enemy board.
    pub fn known_job_problem(&self, home: i32, job: WorkerJob) -> Option[str] {
        let hex = job.hex;
        let fog = self.fog();
        if !self.grid.contains(hex) || !self.grid.is_passable(hex) { return Option.Some("WORKERS CAN'T WORK THIS TERRAIN"); }
        if !self.known_worker_reach(hex) {
            return Option.Some("OUT OF REACH: WORKERS GO 3 TILES FROM A CITY OR WORK CAMP, OR NEXT TO A ROAD");
        }
        if let Option.Some(across) = job.across {
            return if hex.distance(across) != 1 || !self.grid.contains(across) {
                Option.Some("WALLS AND GATES GO BETWEEN TWO TILES ON THE MAP")
            } else if self.known_barrier(hex, across, &fog).is_some() {
                Option.Some("A WALL OR GATE STANDS HERE")
            } else {
                Option.None
            };
        }
        let visible = fog.sees(hex);
        let seen = self.memory.get(hex);
        let mut city = false;
        if visible {
            city = self.city_at(hex).is_some();
        } else {
            if let &Option.Some(s) = &seen { if s.city.is_some() { city = true; } }
            for c in 0..self.cities.len() { if self.cities[c].team == self.local_team && self.cities[c].pos == hex { city = true; } }
        }
        if city { return Option.Some("A CITY STANDS HERE"); }
        let mut building = false;
        for c in 0..self.cities.len() {
            if !(visible || self.cities[c].team == self.local_team) { continue; }
            for b in 0..14 { if self.cities[c].placed_site(PLACEABLE[b]) == Option.Some(hex) { building = true; } }
        }
        let road = if visible { self.roads.contains(hex) } else { match &seen { &Option.Some(s) => s.road, &Option.None => false } };
        let site: Option[Team] = if visible {
            match self.sites.get(hex) { Option.Some(s) => Option.Some(s.team), Option.None => Option.None }
        } else {
            match &seen { &Option.Some(s) => match s.site { Option.Some((_, team)) => Option.Some(team), Option.None => Option.None }, &Option.None => Option.None }
        };
        let structure = if visible { self.structures.has(hex) } else { match &seen { &Option.Some(s) => s.structure.is_some(), &Option.None => false } };
        if let JobKind.Build(placed) = job.kind {
            if self.cities[home].built.contains(placed) { return Option.Some("THIS CITY HAS ONE ALREADY"); }
            if building { return Option.Some("SITE IS ALREADY CLAIMED BY A CITY OR BUILDING"); }
            if structure { return Option.Some("A STRUCTURE STANDS HERE"); }
            // The site's own rules, but not a claim the player can't see: that one drops the job
            // (refunded) when a worker gets there.
            return match self.ai_site_issue(home, placed, hex) {
                Option.Some(issue) => if str_eq(issue, "SITE IS ALREADY CLAIMED BY A CITY OR BUILDING") { Option.None } else { Option.Some(issue) },
                Option.None => Option.None,
            };
        }
        match job.kind {
            JobKind.Road => if road { Option.Some("THERE IS A ROAD HERE ALREADY") } else { Option.None },
            JobKind.Improve => {
                if building { return Option.Some("A BUILDING STANDS HERE"); }
                match site {
                    Option.Some(owner) => if owner != self.local_team { Option.Some("THIS TILE BELONGS TO THE ENEMY") } else { Option.Some("THIS TILE IS IMPROVED ALREADY") },
                    Option.None => if self.improvement(hex).is_none() { Option.Some("NOTHING GROWS ON SNOW") } else { Option.None },
                }
            }
            _ => {
                if building { Option.Some("A BUILDING STANDS HERE") } else if structure { Option.Some("A STRUCTURE STANDS HERE") } else { Option.None }
            }
        }
    }
    /// Where `team`'s workers go out from: its cities, and each Work Camp connected to its city
    /// (workers start nearby jobs from one, `work_base_for`).
    pub fn worker_bases(&self, team: Team) -> Vec[Hex] {
        let mut bases: Vec[Hex] = Vec.new();
        for i in 0..self.cities.len() {
            if self.cities[i].team != team { continue; }
            bases.push(self.cities[i].pos);
            if let Option.Some(camp) = self.cities[i].placed_site(Building.WorkCamp) {
                if self.routes(i).costs.has(camp) { bases.push(camp); }
            }
        }
        bases
    }

    /// Whether `team`'s workers will work at `hex`: within `WORKER_REACH` of one of its cities
    /// or connected Work Camps (`worker_bases`), or on or next to a road, so roads carry the
    /// reach out as far as they go.
    pub fn in_worker_reach(&self, team: Team, hex: Hex) -> bool {
        let bases = self.worker_bases(team);
        self.in_reach_of(&bases, hex)
    }

    /// `in_worker_reach` with the bases worked out once, for checking many hexes (worker mode's
    /// lit tiles).
    pub fn in_reach_of(&self, bases: &Vec[Hex], hex: Hex) -> bool {
        for b in 0..bases.len() { if bases[b].distance(hex) <= WORKER_REACH { return true; } }
        if self.roads.contains(hex) { return true; }
        let around = hex.neighbors();
        for k in 0..6 { if self.roads.contains(around[k]) { return true; } }
        false
    }

    /// The city whose worker jobs a queue row or its X acts on: the open one.
    pub fn worker_list_city(&self) -> Option[i32] { self.selected_city }

    /// Whether city `city` has a worker, at home or out, to build what it places.
    pub fn has_workers(&self, city: i32) -> bool { self.cities[city].workers > 0 || self.workers_out(city) > 0 }

    /// Whether `building` is among city `city`'s worker jobs, waiting or under way.
    pub fn building_job_queued(&self, city: i32, building: Building) -> bool {
        let kind = JobKind.Build(building);
        for k in 0..self.cities[city].worker_jobs.len() { if self.cities[city].worker_jobs[k].kind == kind { return true; } }
        for w in 0..self.field_workers.len() {
            if self.field_workers[w].home != city { continue; }
            if let Option.Some(job) = self.field_workers[w].job { if job.kind == kind { return true; } }
        }
        false
    }

    /// Pays for `job` from city `city`'s side and adds it to the city's worker jobs, or answers
    /// what the side is short.
    pub fn try_queue_job(&mut self, city: i32, job: WorkerJob) -> Option[Stock] {
        let price = job.kind.price();
        let team = self.cities[city].team;
        if !self.stock(team).covers(price) { return Option.Some(self.stock(team).shortfall(price)); }
        self.take_stock(team, price);
        self.cities[city].worker_jobs.push(job);
        Option.None
    }

    /// Gives `team` back what `job` cost: a job taken off the list, or dropped before it was done.
    fn refund_job(&mut self, team: Team, job: WorkerJob) { self.add_stock(team, job.kind.price()); }

    /// Turns of work `job` takes once its worker stands on it: its kind's, halved for a building
    /// beside one of its side's Workshops.
    pub fn job_turns(&self, team: Team, job: WorkerJob) -> u32 {
        match job.kind {
            JobKind.Build(_) => if self.beside_workshop(team, job.hex) { (job.kind.turns() + 1) / 2 } else { job.kind.turns() },
            kind => kind.turns(),
        }
    }

    /// Turns of work `job` still takes once a worker stands on it: what's left of `job_turns` after
    /// the work already put in, and at least one.
    pub fn job_turns_left(&self, team: Team, job: WorkerJob) -> u32 {
        let total = self.job_turns(team, job);
        if total > job.done + 1 { total - job.done } else { 1 }
    }

    /// Why the open city `city` can't place `kind` anywhere right now: no worker to build it, a
    /// building it has or has placed already, or the price.
    pub fn job_kind_unavailable(&self, city: i32, kind: JobKind) -> Option[Str] {
        let c = &self.cities[city];
        if let JobKind.Build(building) = kind {
            if c.built.contains(building) {
                return Option.Some(text(fn() can {Out} { Out.put(building.name()); Out.put(" ALREADY EXISTS IN THIS CITY"); }));
            }
            if self.building_job_queued(city, building) {
                return Option.Some(text(fn() can {Out} { Out.put(building.name()); Out.put(" IS ALREADY PLACED FOR THIS CITY"); }));
            }
            if building.is_naval() && !self.city_is_coastal(city) {
                return Option.Some(to_owned("ONLY COASTAL CITIES CAN BUILD NAVAL BUILDINGS"));
            }
        }
        if !self.has_workers(city) { return Option.Some(to_owned("TRAIN A WORKER FIRST - WORKERS BUILD WHAT THE CITY PLACES")); }
        let stock = self.stock(c.team);
        if !stock.covers(kind.price()) {
            let short = stock_icons(stock.shortfall(kind.price()));
            return Option.Some(text(fn() can {Out} { Out.put(kind.name()); Out.put(" - SHORT OF "); Out.put(&short); }));
        }
        Option.None
    }
    /// Whether `team` already has a job queued or under way in `job`'s place.
    pub fn job_taken(&self, team: Team, job: WorkerJob) -> bool {
        for c in 0..self.cities.len() {
            if self.cities[c].team != team { continue; }
            let jobs = &self.cities[c].worker_jobs;
            for j in 0..jobs.len() { if jobs[j].same_place(job) { return true; } }
        }
        for w in 0..self.field_workers.len() {
            let worker = &self.field_workers[w];
            if worker.team != team { continue; }
            if let Option.Some(other) = worker.job { if other.same_place(job) { return true; } }
        }
        false
    }

    pub fn arm_worker_job(&mut self, kind: JobKind) {
        if self.is_resolving() { return; }
        let Option.Some(city) = self.job_city() else {
            self.set_notice("OPEN A CITY FIRST - ITS WORKERS BUILD WHAT IT PLACES");
            return;
        };
        if self.placing_job == Option.Some(kind) {
            self.placing_job = Option.None;
            self.hovered_job = Option.None;
            self.notice = text(fn() can {Out} { Out.put("STOPPED PLACING "); Out.put(kind.name()); });
            return;
        }
        if let Option.Some(reason) = self.job_kind_unavailable(city, kind) {
            self.notice = reason;
            return;
        }
        self.placing_job = Option.Some(kind);
        // Short, to fit the status bar; the city panel says how to place it.
        self.notice = text(fn() can {Out} { Out.put("PLACING "); Out.put(kind.name()); Out.put(" - RIGHT-CLICK OR ESC TO CANCEL"); });
    }
    /// With a job armed: where a map point would place it, as the tile the point is in and,
    /// for a wall or gate, the neighbour across the edge nearest the point.
    pub fn job_target_at(&self, point: Vec2) -> Option[(Hex, Option[Hex])] {
        let Option.Some(kind) = self.placing_job else { return Option.None; };
        let hex = Hex.from_world(point);
        if !self.grid.contains(hex) { return Option.None; }
        let across = if kind.on_edge() { Option.Some(nearest_edge(hex, point)) } else { Option.None };
        Option.Some((hex, across))
    }

    /// Places the armed job at `hex` (across the edge to `across`, for a wall or gate). Answers
    /// whether it was queued. A drag calls this for every tile or edge it passes, so a place
    /// that already has this job is skipped without a notice.
    pub fn place_job_at(&mut self, hex: Hex, across: Option[Hex]) -> bool {
        if self.is_resolving() { return false; }
        let Option.Some(kind) = self.placing_job else { return false; };
        if let Option.Some(other) = across { return self.queue_barrier_at(hex, other); }
        if self.job_taken(self.local_team, WorkerJob.on_tile(hex, kind)) { return false; }
        if let Option.Some(reason) = self.job_unavailable(hex, kind) {
            self.notice = reason;
            return false;
        }
        self.queue_worker_job_at(hex, kind);
        true
    }

    pub fn queue_barrier_at(&mut self, a: Hex, b: Hex) -> bool {
        let Option.Some(kind) = self.placing_job else { return false; };
        let Option.Some(city) = self.job_city() else { return false; };
        let pos = self.cities[city].pos;
        let (first, second) = if b.distance(pos) < a.distance(pos) { (b, a) } else { (a, b) };
        let hex = if self.grid.is_passable(first) && self.is_explored(first) {
            first
        } else if self.grid.is_passable(second) && self.is_explored(second) {
            second
        } else {
            self.notice = text(fn() can {Out} { Out.put("A "); Out.put(kind.name()); Out.put(" NEEDS OPEN, EXPLORED GROUND ON ONE SIDE"); });
            return false;
        };
        let across = if hex == a { b } else { a };
        let job = WorkerJob { hex, kind, across: Option.Some(across), done: 0 };
        if self.job_taken(self.local_team, job) { return false; }
        if let Option.Some(problem) = self.known_job_problem(city, job) {
            self.set_notice(problem);
            return false;
        }
        if let Option.Some(short) = self.try_queue_job(city, job) {
            let icons = stock_icons(short);
            self.notice = text(fn() can {Out} { Out.put(kind.name()); Out.put(" - SHORT OF "); Out.put(&icons); });
            return false;
        }
        let (id, waiting) = (self.cities[city].id, self.cities[city].worker_jobs.len());
        self.notice = text(fn() can {Out} {
            Out.put(kind.name()); Out.put(" QUEUED FOR CITY "); show_u64((id + 1) as u64); Out.put(" - "); show_u64(waiting as u64); Out.put(" JOBS WAITING - ESC TO STOP");
        });
        true
    }
    /// With a job armed, places it at the tile or hex edge under `cursor` (window pixels).
    /// Called on the press and for every cursor move while the button is held, so a drag places
    /// it on each tile or edge it passes. Answers whether the press belongs to placing: false
    /// over the UI (`check_ui`) or with nothing armed.
    pub fn paint_job_at(&mut self, cursor: Vec2, screen_size: Vec2, check_ui: bool) -> bool {
        if self.placing_job.is_none() || self.is_resolving() { return false; }
        if check_ui && self.ui_covers(cursor, screen_size) { return false; }
        let point = self.camera.screen_to_world(cursor, screen_size);
        if let Option.Some((hex, across)) = self.job_target_at(point) { let _queued = self.place_job_at(hex, across); }
        true
    }

    pub fn job_unavailable(&self, hex: Hex, kind: JobKind) -> Option[Str] {
        let job = WorkerJob.on_tile(hex, kind);
        let Option.Some(city) = self.job_city() else { return Option.Some(to_owned("OPEN A CITY FIRST - ITS WORKERS BUILD WHAT IT PLACES")); };
        if let Option.Some(reason) = self.job_kind_unavailable(city, kind) { return Option.Some(reason); }
        if kind.on_edge() { return Option.None; }
        if !self.is_explored(hex) { return Option.Some(to_owned("WORKERS CAN'T WORK AN UNEXPLORED TILE")); }
        if let Option.Some(problem) = self.known_job_problem(city, job) { return Option.Some(to_owned(problem)); }
        if self.job_taken(self.local_team, job) {
            return Option.Some(text(fn() can {Out} { Out.put(kind.name()); Out.put(" IS QUEUED HERE ALREADY"); }));
        }
        // A tile takes one job at a time.
        match self.tile_job_at(self.local_team, hex) {
            Option.Some(other) => Option.Some(text(fn() can {Out} { Out.put(other.name()); Out.put(" IS QUEUED HERE - ONE JOB AT A TIME"); })),
            Option.None => Option.None,
        }
    }
    /// The job `team` has queued or under way on tile `hex`, if any (walls and gates, on edges,
    /// aside). A tile takes one job at a time.
    pub fn tile_job_at(&self, team: Team, hex: Hex) -> Option[JobKind] {
        for c in 0..self.cities.len() {
            if self.cities[c].team != team { continue; }
            let jobs = &self.cities[c].worker_jobs;
            for j in 0..jobs.len() { if jobs[j].across.is_none() && jobs[j].hex == hex { return Option.Some(jobs[j].kind); } }
        }
        for w in 0..self.field_workers.len() {
            let worker = &self.field_workers[w];
            if worker.team != team { continue; }
            if let Option.Some(job) = worker.job {
                if job.across.is_none() && job.hex == hex { return Option.Some(job.kind); }
            }
        }
        Option.None
    }

    pub fn queue_worker_job_at(&mut self, hex: Hex, kind: JobKind) {
        if let Option.Some(reason) = self.job_unavailable(hex, kind) {
            self.notice = reason;
            return;
        }
        let Option.Some(city) = self.job_city() else { return; };
        if let Option.Some(short) = self.try_queue_job(city, WorkerJob.on_tile(hex, kind)) {
            let icons = stock_icons(short);
            self.notice = text(fn() can {Out} { Out.put(kind.name()); Out.put(" - SHORT OF "); Out.put(&icons); });
            return;
        }
        // A city has one of each building: placed, it's done placing.
        if let JobKind.Build(_) = kind {
            self.placing_job = Option.None;
            self.hovered_job = Option.None;
        }
        let (id, home) = (self.cities[city].id, self.cities[city].workers);
        self.notice = text(fn() can {Out} {
            Out.put(kind.name()); Out.put(" PLACED FOR CITY "); show_u64((id + 1) as u64); Out.put(" - "); show_u64(home as u64);
            Out.put(if home == 1 { " WORKER AT HOME" } else { " WORKERS AT HOME" });
        });
    }
    pub fn remove_worker_job(&mut self, index: i32) {
        if self.is_resolving() { return; }
        let Option.Some(city) = self.worker_list_city() else { return; };
        if index < 0 || index >= self.cities[city].worker_jobs.len() { return; }
        let job = self.cities[city].worker_jobs.remove(index);
        let team = self.cities[city].team;
        self.refund_job(team, job);
        self.notice = text(fn() can {Out} { Out.put("REMOVED "); Out.put(job.kind.name()); Out.put(" FROM THE WORKER JOBS - REFUNDED"); });
    }
    /// A worker's row in the worker menu: the camera goes to the worker.
    pub fn show_worker(&mut self, id: u32) {
        for w in 0..self.field_workers.len() {
            if self.field_workers[w].id == id && self.field_workers[w].team == self.local_team {
                let at = self.field_workers[w].pos.to_world();
                self.camera.focus_on(at);
                return;
            }
        }
    }

    /// A Recall button: sends one of the player's workers out on the map straight home, out of
    /// danger. Its job, with the work already put into it, goes back to the top of its city's
    /// list, and it takes no new one on the way. Home, it stays there, held, until released
    /// (`release_worker`).
    pub fn recall_worker(&mut self, id: u32) {
        if self.is_resolving() { return; }
        let mut found: Option[i32] = Option.None;
        for w in 0..self.field_workers.len() {
            if found.is_none() && self.field_workers[w].id == id && self.field_workers[w].team == self.local_team { found = Option.Some(w); }
        }
        let Option.Some(w) = found else { return; };
        let worker = self.field_workers[w];
        self.return_job(worker);
        let home = self.cities[worker.home].pos;
        let recalled = &mut self.field_workers[w];
        recalled.job = Option.None;
        recalled.work_left = Option.None;
        recalled.recalled = true;
        recalled.base = home;
        self.set_notice("WORKER RECALLED - IT HEADS HOME TO STAY; ITS JOB WAITS ON THE LIST");
    }

    /// Takes the first job in city `city`'s queue its workers can still do, dropping (and
    /// refunding) any that became impossible.
    fn take_job(&mut self, city: i32) -> Option[WorkerJob] {
        let team = self.cities[city].team;
        while !self.cities[city].worker_jobs.is_empty() {
            let job = self.cities[city].worker_jobs.remove(0);
            match self.job_problem(city, job) {
                Option.None => { return Option.Some(job); }
                Option.Some(problem) => {
                    self.refund_job(team, job);
                    if team == self.local_team {
                        self.notice = text(fn() can {Out} { Out.put(job.kind.name()); Out.put(" DROPPED, REFUNDED: "); Out.put(problem); });
                    }
                }
            }
        }
        Option.None
    }
    /// Where a worker starts `job` from: city `city`'s connected Work Camp within 3 hexes of
    /// it, else the city.
    fn work_base_for(&self, city: i32, job: WorkerJob) -> Hex {
        let center = self.cities[city].pos;
        let Option.Some(camp) = self.cities[city].placed_site(Building.WorkCamp) else { return center; };
        if camp.distance(job.hex) <= 3 && self.routes(city).costs.has(camp) { camp } else { center }
    }

    /// Where `worker` walks home to: the connected Work Camp it set out from, else its city.
    fn return_base_for(&self, worker: FieldWorker, home: i32) -> Hex {
        let center = self.cities[home].pos;
        let Option.Some(camp) = self.cities[home].placed_site(Building.WorkCamp) else { return center; };
        if worker.base == camp && self.routes(home).costs.has(camp) { camp } else { center }
    }

    pub fn resolve_workers(&mut self) -> Vec[u32] can {Log} {
        for w in 0..self.field_workers.len() {
            if self.field_workers[w].job.is_none() && !self.field_workers[w].recalled {
                let home = self.field_workers[w].home;
                if let Option.Some(job) = self.take_job(home) {
                    self.field_workers[w].base = self.work_base_for(home, job);
                    self.field_workers[w].job = Option.Some(job);
                }
            }
        }
        for city in 0..self.cities.len() {
            // Held workers stay home until released.
            while self.cities[city].workers > self.cities[city].held_workers {
                let Option.Some(job) = self.take_job(city) else { break; };
                let base = self.work_base_for(city, job);
                // An enemy standing where it would set out from (its city center, say, left there
                // as the city changed hands) would capture it at the door: the job waits.
                if self.enemy_of_team_at(base, self.cities[city].team).is_some() {
                    self.cities[city].worker_jobs.insert(0, job);
                    break;
                }
                self.cities[city].workers = self.cities[city].workers - 1;
                let id = self.take_unit_id();
                self.field_workers.push(FieldWorker { id, team: self.cities[city].team, home: city, base, pos: base, job: Option.Some(job), work_left: Option.None, recalled: false });
            }
        }
        let mut acted: Vec[u32] = Vec.new();
        let mut home: Vec[i32] = Vec.new();
        for w in 0..self.field_workers.len() {
            let (did_something, arrived_home) = self.advance_worker(w);
            if did_something { acted.push(self.field_workers[w].id); }
            if arrived_home { home.push(w); }
        }
        let mut k = home.len();
        while k > 0 {
            k = k - 1;
            let worker = self.field_workers.remove(home[k]);
            self.cities[worker.home].workers = self.cities[worker.home].workers + 1;
            // Recalled, it stays home until the player releases it.
            if worker.recalled { self.cities[worker.home].held_workers = self.cities[worker.home].held_workers + 1; }
        }
        acted
    }

    /// The Release button in a city's panel: one of the open city's held workers (recalled, and
    /// home) takes jobs again, going out in the Workers step at the end of this turn.
    pub fn release_worker(&mut self) {
        if self.is_resolving() { return; }
        let Option.Some(city) = self.worker_list_city() else { return; };
        if self.cities[city].team != self.local_team || self.cities[city].held_workers == 0 { return; }
        self.cities[city].held_workers = self.cities[city].held_workers - 1;
        if self.cities[city].worker_jobs.is_empty() {
            self.set_notice("WORKER RELEASED - IT TAKES THE NEXT JOB PLACED");
        } else {
            self.set_notice("WORKER RELEASED - IT TAKES THE NEXT JOB ON THE LIST");
        }
    }
    fn advance_worker(&mut self, w: i32) -> (bool, bool) can {Log} {
        let worker = self.field_workers[w];
        if let (Option.Some(job), Option.Some(left)) = (worker.job, worker.work_left) {
            if worker.pos == job.hex {
                let problem = match self.home_of(worker) {
                    Option.Some(home) => self.job_problem(home, job),
                    Option.None => Option.Some("ITS SIDE HAS NO CITY LEFT"),
                };
                if let Option.Some(problem) = problem {
                    self.refund_job(worker.team, job);
                    if worker.team == self.local_team {
                        self.notice = text(fn() can {Out} { Out.put(job.kind.name()); Out.put(" ABANDONED, REFUNDED: "); Out.put(problem); });
                    }
                    self.field_workers[w].job = Option.None;
                    self.field_workers[w].work_left = Option.None;
                    return (true, false);
                }
                if left > 1 {
                    self.field_workers[w].work_left = Option.Some(left - 1);
                    self.field_workers[w].job = Option.Some(WorkerJob { hex: job.hex, kind: job.kind, across: job.across, done: job.done + 1 });
                    return (true, false);
                }
                let Option.Some(home) = self.home_of(worker) else { return (false, false); };
                self.complete_job(home, job);
                let next = self.take_job(worker.home);
                if let Option.Some(next_job) = next { self.field_workers[w].base = self.work_base_for(worker.home, next_job); }
                self.field_workers[w].job = next;
                self.field_workers[w].work_left = Option.None;
                return (true, false);
            }
        }

        // Walking: to the job, or home.
        let Option.Some(home) = self.home_of(worker) else { return (false, false); };
        let target = match worker.job { Option.Some(job) => job.hex, Option.None => self.return_base_for(worker, home) };
        let Option.Some(path) = self.worker_path(worker.team, worker.pos, target) else {
            if let Option.Some(job) = worker.job {
                self.refund_job(worker.team, job);
                if worker.team == self.local_team {
                    let title = self.job_title(job);
                    self.notice = text(fn() can {Out} { Out.put("A WORKER CAN'T REACH ITS "); Out.put(&title); Out.put(" - IT'S COMING HOME, REFUNDED"); });
                }
                self.field_workers[w].job = Option.None;
                return (true, false);
            }
            return (false, false);
        };
        let step = if WORKER_MOVE < path.len() - 1 { WORKER_MOVE } else { path.len() - 1 };
        let pos = path[step];
        let moved = pos != worker.pos;
        self.field_workers[w].home = home;
        self.field_workers[w].pos = pos;
        if pos != target { return (moved, false); }
        match worker.job {
            Option.Some(job) => {
                self.field_workers[w].work_left = Option.Some(self.job_turns_left(worker.team, job));
                (true, false)
            }
            Option.None => (true, true),
        }
    }
    /// The city a worker heads back to: its own, or if that one was lost, its side's nearest.
    fn home_of(&self, worker: FieldWorker) -> Option[i32] {
        if self.cities[worker.home].team == worker.team { Option.Some(worker.home) } else { self.nearest_city(worker.team, worker.pos) }
    }

    /// The shortest walk for a worker of `team` from `from` to `to`, both ends included, around
    /// impassable terrain, walls, others' gates, enemy units and enemy cities. Ties break by hex
    /// coordinates.
    fn worker_path(&self, team: Team, from: Hex, to: Hex) -> Option[Vec[Hex]] {
        let mut came_from: Map[Hex, Hex] = Map.new();
        let _start = came_from.insert(from, from);
        let mut queue: Deque[Hex] = Deque.new();
        queue.push_back(from);
        while let Option.Some(hex) = queue.pop_front() {
            if hex == to {
                let mut reversed: Vec[Hex] = Vec.new();
                reversed.push(to);
                let mut at = to;
                while at != from {
                    at = came_from.get(at).unwrap_or(from);
                    reversed.push(at);
                }
                let mut path: Vec[Hex] = Vec.new();
                let mut k = reversed.len();
                while k > 0 {
                    k = k - 1;
                    path.push(reversed[k]);
                }
                return Option.Some(path);
            }
            let around = sorted_neighbors(hex);
            for k in 0..6 {
                let n = around[k];
                let open = self.can_step(hex, n, team) && self.enemy_of_team_at(n, team).is_none() && !self.enemy_city_at(n, team);
                if open && !came_from.has(n) {
                    let _new = came_from.insert(n, hex);
                    queue.push_back(n);
                }
            }
        }
        Option.None
    }

    /// City `city`'s workers finish `job`: a building, a road, an improvement or a structure.
    fn complete_job(&mut self, city: i32, job: WorkerJob) can {Log} {
        let team = self.cities[city].team;
        let hex = job.hex;
        match job.kind {
            JobKind.Build(building) => {
                self.cities[city].set_placed_site(building, hex);
                if building == Building.CoastalBattery { self.cities[city].coastal_battery_hp = 150.0; }
                self.cities[city].built.push(building);
            }
            JobKind.Road => { self.roads.insert(hex); }
            JobKind.Improve => {
                if let Option.Some(improvement) = self.improvement(hex) {
                    let _old = self.sites.insert(hex, Site { team, food: improvement.food, production: improvement.production, kind: improvement.kind });
                }
            }
            kind => {
                if let Option.Some(structure_kind) = kind.structure() {
                    let structure = Structure { kind: structure_kind, team };
                    match job.across {
                        Option.Some(across) => { let _old = self.barriers.insert(edge(hex, across), structure); }
                        Option.None => { let _old = self.structures.insert(hex, structure); }
                    }
                }
            }
        }
        info(fn() can {Out} { team.show(); Out.put(" workers finished a "); Out.put(job.kind.name()); Out.put(" at "); hex.show(); });
        if team == self.local_team {
            let title = self.job_title(job);
            self.notice = text(fn() can {Out} { Out.put("WORKERS FINISHED: "); Out.put(&title); });
        }
    }

    /// A worker taken off the map with a job in hand leaves that job at the front of its city's
    /// queue, for the next worker to try.
    fn return_job(&mut self, worker: FieldWorker) {
        let Option.Some(job) = worker.job else { return; };
        if self.cities[worker.home].team == worker.team { self.cities[worker.home].worker_jobs.insert(0, job); }
    }

    /// After a move step: every worker sharing a hex with an enemy unit is captured. It joins
    /// the captor's nearest city, or is lost if the captor has no city.
    pub fn capture_workers(&mut self) can {Log} {
        let mut w = 0;
        while w < self.field_workers.len() {
            let worker = self.field_workers[w];
            let Option.Some(captor) = self.enemy_of_team_at(worker.pos, worker.team) else {
                w = w + 1;
                continue;
            };
            // An animal captures nobody: the worker is killed.
            if self.units[captor].is_animal() {
                let mut ids: Vec[u32] = Vec.new();
                ids.push(worker.id);
                self.kill_workers(&ids);
                continue;
            }
            let captor_team = self.units[captor].team;
            let _gone = self.field_workers.remove(w);
            self.return_job(worker);
            {
                let unit = &self.units[captor];
                info(fn() can {Out} { unit.show(); Out.put(" captures a "); worker.team.show(); Out.put(" worker at "); worker.pos.show(); });
            }
            if let Option.Some(city) = self.nearest_city(captor_team, worker.pos) {
                self.cities[city].workers = self.cities[city].workers + 1;
            }
            if worker.team == self.local_team {
                self.set_notice("AN ENEMY CAPTURED ONE OF YOUR WORKERS");
            } else if captor_team == self.local_team {
                self.set_notice("WORKER CAPTURED - IT JOINS YOUR NEAREST CITY");
            }
        }
    }

    /// The workers of `team`'s foes on `hex`, by index.
    pub fn enemy_workers_at(&self, hex: Hex, team: Team) -> Vec[i32] {
        let mut out: Vec[i32] = Vec.new();
        for w in 0..self.field_workers.len() {
            if self.field_workers[w].pos == hex && self.field_workers[w].team != team { out.push(w); }
        }
        out
    }

    /// Kills the workers with these ids.
    pub fn kill_workers(&mut self, ids: &Vec[u32]) can {Log} {
        let mut w = 0;
        while w < self.field_workers.len() {
            let worker = self.field_workers[w];
            if !ids.contains(worker.id) {
                w = w + 1;
                continue;
            }
            let _gone = self.field_workers.remove(w);
            self.return_job(worker);
            info(fn() can {Out} { Out.put("a "); worker.team.show(); Out.put(" worker is killed at "); worker.pos.show(); });
            if worker.team == self.local_team { self.set_notice("ONE OF YOUR WORKERS WAS KILLED"); }
        }
    }

    /// The AI's workers: each city with idle workers and nothing queued improves the tiles it
    /// works, then puts roads on them, but none within a den's territory (`dens`, `animals.tua`),
    /// where an animal would attack it.
    pub fn plan_ai_workers(&mut self, team: Team, dens: &Set[Hex]) {
        for city in 0..self.cities.len() {
            let c = &self.cities[city];
            if c.team != team || c.workers == 0 || !c.worker_jobs.is_empty() { continue; }
            let stock = self.stock(team);
            let mut worked: Vec[Hex] = Vec.new();
            let all = c.worked_tiles();
            for i in 0..all.len() { if !near_a_den(dens, all[i]) { worked.push(all[i]); } }
            let kinds = [JobKind.Improve, JobKind.Road];
            let mut chosen: Option[WorkerJob] = Option.None;
            for k in 0..2 {
                for i in 0..worked.len() {
                    let job = WorkerJob.on_tile(worked[i], kinds[k]);
                    if chosen.is_none() && stock.covers(kinds[k].price()) && self.job_problem(city, job).is_none() && !self.job_taken(team, job) { chosen = Option.Some(job); }
                }
            }
            if let Option.Some(job) = chosen { let _short = self.try_queue_job(city, job); }
        }
    }
}

/// `hex`'s neighbours sorted by `(q, r)`, so a search visiting them in this order breaks ties
/// by hex coordinates.
fn sorted_neighbors(hex: Hex) -> [Hex; 6] {
    let mut around = hex.neighbors();
    for i in 1..6 {
        let mut j = i;
        while j > 0 && (around[j].q < around[j - 1].q || (around[j].q == around[j - 1].q && around[j].r < around[j - 1].r)) {
            let t = around[j];
            around[j] = around[j - 1];
            around[j - 1] = t;
            j = j - 1;
        }
    }
    around
}
