//! Whole-game simulation tests: every team planned by the AI, every turn resolved through the
//! same path the game uses, and the board's invariants checked after each turn. Every game is
//! seeded (damage rolls and the F4 world's map), so a failure names its scenario and seed and
//! replays exactly.

use std.collections.Set;
use std.rand.Rand;
use std.rand.seed;
use std.test.assert;
use std.test.Assert;
use log.Log;
use game.GameState;
use game.PLAYER_TEAM;
use game.ruins.RUIN_HOLD_TURNS;
use game.scenario.SCENARIOS;
use game.scenario.SCENARIO_COUNT;
use game.scenario.Scenario;
use game.hex.Hex;
use game.unit.TEAMS;
use game.unit.Team;

const TURNS: u32 = 40;
/// The seeds every run plays.
const SEEDS: [u64; 3] = [1, 2, 3];

/// Runs `body` with the combat log discarded and `Rand` drawing from `s`.
fn seeded(s: u64, body: affine fn() can {Log, Rand, Assert}) can {Assert} {
    let mut g = seed(s);
    handle {
        handle { body(); } with Rand { rand() => { resume g.next() } }
    } with Log {
        enabled(level) => { resume false }
        record(level, text) => { resume }
    }
}

/// A fresh game of `scenario`, playing every step at once.
fn start(scenario: Scenario) -> GameState can {Log, Rand} {
    let mut game = GameState.new();
    game.settings.instant_playback = true;
    game.switch_scenario(scenario);
    game
}

/// Plans every team with the AI and resolves one turn, all steps at once.
fn play_turn(game: &mut GameState) can {Log, Rand} {
    game.selected = Option.None;
    game.group.clear();
    game.plan_ai_turn(PLAYER_TEAM);
    // `resolve_turn` plans the AI teams itself.
    game.resolve_turn();
    game.update(0.0);
}

/// The board's invariants: ruins on land, unclaimed and counted by their holder; every unit
/// with its own id and some of its hit points, standing where it can; one unit to a hex but
/// for a contest of two enemies; a queue a chain of turns; cities populated and working no
/// more tiles than their people.
fn check_invariants(game: &GameState) can {Assert} {
    for r in 0..game.ruins.len() {
        let ruin = &game.ruins[r];
        assert(game.grid.is_passable(ruin.pos));
        // Held long enough, they'd have been claimed and gone.
        assert(ruin.held < RUIN_HOLD_TURNS);
        assert(ruin.holder.is_some() == (ruin.held > 0));
    }
    let mut ids: Set[i64] = Set.new();
    for i in 0..game.units.len() {
        let unit = &game.units[i];
        assert(ids.insert(unit.id as i64));
        assert(unit.hp > 0.0 && unit.hp <= unit.max_hp());
        if unit.is_naval() {
            assert(game.grid.contains(unit.pos) && game.grid.terrain(unit.pos).is_water());
        } else {
            assert(game.grid.is_passable(unit.pos));
        }
        assert(unit.cargo.len() <= 4);
        // A queue is a chain: each queued turn starts where the one before it ends.
        let mut from = unit.planned_pos();
        for t in 0..unit.queued.len() {
            assert(unit.queued[t].from == from);
            from = unit.queued[t].end_pos();
        }
        let mut here = 0;
        let mut enemies = false;
        for j in 0..game.units.len() {
            if game.units[j].pos == unit.pos {
                here = here + 1;
                if game.units[j].team != unit.team { enemies = true; }
            }
        }
        // One unit per hex, except a contest: exactly two enemies.
        assert(here == 1 || (here == 2 && enemies));
    }
    for c in 0..game.cities.len() {
        let city = &game.cities[c];
        assert(city.population >= 1);
        assert(city.worked.len() <= city.population);
    }
}

@test
fn ai_against_ai_keeps_the_board_consistent_in_every_scenario() {
    for s in 0..SCENARIO_COUNT {
        for k in 0..3 {
            seeded(SEEDS[k], fn() can {Log, Rand, Assert} {
                let scenario = SCENARIOS[s];
                let mut game = start(scenario);
                check_invariants(&game);
                let ruins_at_start = game.ruins.len();
                for turn in 1..=TURNS {
                    let ruins_before = game.ruins.len();
                    play_turn(&mut game);
                    // The turn finished resolving, and counted.
                    assert(!game.is_resolving());
                    assert(game.turn == turn);
                    // No ruins appeared.
                    assert(game.ruins.len() <= ruins_before);
                    check_invariants(&game);
                }
                // Anti-vacuity: the AI goes for the world's ruins, and claims some.
                if scenario == Scenario.World { assert(game.ruins.len() < ruins_at_start); }
            });
        }
    }
}

@test
fn a_crowded_world_of_settlers_keeps_the_board_consistent() {
    // The most sides there are, each starting with a settler to found its city: the other way
    // a world can start (`Settings.world_start_city`).
    for k in 0..3 {
        seeded(SEEDS[k], fn() can {Log, Rand, Assert} {
            let mut game = GameState.new();
            game.settings.instant_playback = true;
            game.settings.world_ai = 6;
            game.settings.world_start_city = false;
            game.switch_scenario(Scenario.World);
            assert(game.ai_teams().len() == 6);
            check_invariants(&game);
            for turn in 1..=TURNS {
                play_turn(&mut game);
                check_invariants(&game);
                if turn == 1 {
                    // Every side founded its city on its start.
                    for t in 0..7 {
                        let mut founded = false;
                        for c in 0..game.cities.len() { if game.cities[c].team == TEAMS[t] { founded = true; } }
                        assert(founded);
                    }
                }
            }
        });
    }
}

/// This turn's orders of a unit already following a queue, which the AI's planning replaces.
struct Kept { id: u32, planned_move: Option[Hex], planned_attack: Option[Hex] }

/// Like `play_turn`, but the player's units are ordered through Shift-click queues: each unit
/// without a queue gets one Shift-click's worth of moves toward the nearest enemy (every turn it
/// takes to get next to it, up to the default `Settings.max_queued_turns`) and then an attack on
/// its hex (queued only if in range from where the moves end), as a player would queue them.
/// The AI still runs the player's cities; units already following a queue keep their orders.
/// Answers how many units follow a queue once the turn is done.
fn play_queued_turn(game: &mut GameState) -> i32 can {Log, Rand} {
    game.selected = Option.None;
    game.group.clear();
    let mut kept: Vec[Kept] = Vec.new();
    for i in 0..game.units.len() {
        let unit = &game.units[i];
        if unit.has_queue() { kept.push(Kept { id: unit.id, planned_move: unit.planned_move, planned_attack: unit.planned_attack }); }
    }
    game.plan_ai_turn(PLAYER_TEAM);
    for idx in 0..game.units.len() {
        if game.units[idx].team != PLAYER_TEAM { continue; }
        let id = game.units[idx].id;
        let mut following = false;
        for k in 0..kept.len() {
            if kept[k].id == id {
                game.units[idx].planned_move = kept[k].planned_move;
                game.units[idx].planned_attack = kept[k].planned_attack;
                following = true;
            }
        }
        if following { continue; }
        game.units[idx].planned_move = Option.None;
        game.units[idx].planned_attack = Option.None;
        let pos = game.units[idx].pos;
        let mut target: Option[Hex] = Option.None;
        for j in 0..game.units.len() {
            if game.units[j].team == PLAYER_TEAM { continue; }
            let t = game.units[j].pos;
            let better = match target {
                Option.None => true,
                Option.Some(b) => t.distance(pos) < b.distance(pos) || (t.distance(pos) == b.distance(pos) && (t.q < b.q || (t.q == b.q && t.r < b.r))),
            };
            if better { target = Option.Some(t); }
        }
        let Option.Some(t) = target else { continue; };
        game.selected = Option.Some(idx);
        let _moved = game.queue_move(t);
        let _attacked = game.queue_attack(t);
    }
    game.selected = Option.None;
    game.resolve_turn();
    game.update(0.0);
    let mut followed = 0;
    for i in 0..game.units.len() { if game.units[i].following_queue { followed = followed + 1; } }
    followed
}

@test
fn queued_orders_against_the_ai_keep_the_board_consistent() {
    for s in 0..SCENARIO_COUNT {
        for k in 0..3 {
            seeded(SEEDS[k], fn() can {Log, Rand, Assert} {
                let mut game = start(SCENARIOS[s]);
                let mut followed = 0;
                for _turn in 1..=TURNS {
                    followed = followed + play_queued_turn(&mut game);
                    // The turn finished.
                    assert(!game.is_resolving());
                    check_invariants(&game);
                }
                // Anti-vacuity: queues were actually carried from turn to turn. Not across the
                // naval strait, which every unit crosses to the enemy within one turn.
                assert(followed > 0 || SCENARIOS[s] == Scenario.Naval);
            });
        }
    }
}

@test
fn ai_against_ai_combat_ends_with_fewer_units() {
    // Anti-vacuity: the combat scenario must actually fight, or the invariant test above would
    // pass on a game where nothing happens.
    for k in 0..3 {
        seeded(SEEDS[k], fn() can {Log, Rand, Assert} {
            let mut game = start(Scenario.Combat);
            let at_start = game.units.len();
            for _turn in 0..TURNS { play_turn(&mut game); }
            // Some unit died.
            assert(game.units.len() < at_start);
            // Only the combat scenario's two teams exist.
            for i in 0..game.units.len() { assert(game.units[i].team == Team.Red || game.units[i].team == PLAYER_TEAM); }
        });
    }
}

/// What a replay must reproduce: the map, every unit and every city, as numbers.
fn fingerprint(scenario: Scenario, turns: u32) -> Vec[f64] can {Log, Rand} {
    let mut game = start(scenario);
    for _turn in 0..turns { play_turn(&mut game); }
    let mut out: Vec[f64] = Vec.new();
    out.push(game.turn as f64);
    out.push(match game.map_seed { Option.Some(m) => m as f64, Option.None => -1.0 });
    for i in 0..game.units.len() {
        let unit = &game.units[i];
        out.push(unit.id as f64);
        out.push(unit.pos.q as f64);
        out.push(unit.pos.r as f64);
        out.push(unit.hp as f64);
    }
    for c in 0..game.cities.len() {
        out.push(game.cities[c].id as f64);
        out.push(game.cities[c].population as f64);
    }
    out
}

/// `fingerprint` with `Rand` drawing from `s`.
fn replayed(s: u64, scenario: Scenario, turns: u32) -> Vec[f64] can {Log} {
    let mut g = seed(s);
    handle { fingerprint(scenario, turns) } with Rand { rand() => { resume g.next() } }
}

/// Runs `body` with the combat log discarded.
fn quiet(body: affine fn() can {Log, Assert}) can {Assert} {
    handle { body(); } with Log {
        enabled(level) => { resume false }
        record(level, text) => { resume }
    }
}

fn same(a: &Vec[f64], b: &Vec[f64]) -> bool {
    if a.len() != b.len() { return false; }
    for i in 0..a.len() { if a[i] != b[i] { return false; } }
    true
}

@test
fn the_same_seed_replays_the_same_game() {
    quiet(fn() can {Log, Assert} {
        // One seed is enough to catch hidden nondeterminism (map iteration order deciding an
        // outcome, say).
        for s in 0..SCENARIO_COUNT {
            assert(same(&replayed(SEEDS[0], SCENARIOS[s], 20), &replayed(SEEDS[0], SCENARIOS[s], 20)));
        }
        // Anti-vacuity: the seed does drive the rolls. The armies meet on turn 2 and are gone
        // within a few more, so compare right after the first clash.
        assert(!same(&replayed(1, Scenario.Combat, 2), &replayed(2, Scenario.Combat, 2)));
    });
}
