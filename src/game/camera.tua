//! A top-down orthographic camera over the map.

use std.linalg.Mat4;
use std.linalg.Vec2;
use std.linalg.mat4_from_cols;
use std.linalg.vec4;
use std.linalg.vec2;
use std.math.Float;
use std.math.clamp;

const MIN_HALF_HEIGHT: f32 = 2.0;
const MAX_HALF_HEIGHT: f32 = 30.0;
/// How quickly the camera glides to a focus point; higher is snappier.
const GLIDE_RATE: f32 = 10.0;

/// World +Y is screen-up, and `half_height` is the zoom level: world units from the view's
/// center to its top edge.
pub struct Camera {
    center: Vec2,
    half_height: f32,
    /// Point the camera is gliding towards, if any.
    priv target: Option[Vec2],
}

impl Camera {
    pub fn new(center: Vec2, half_height: f32) -> Camera {
        Camera { center, half_height, target: Option.None }
    }

    /// Starts gliding the view to center on `point`.
    pub fn focus_on(&mut self, point: Vec2) { self.target = Option.Some(point); }

    /// Moves the view `dt` seconds further along any glide in progress.
    pub fn update(&mut self, dt: f32) {
        if let Option.Some(target) = self.target {
            self.center = self.center.lerp(target, 1.0 - (-GLIDE_RATE * dt).exp());
            if self.center.distance(target) < 0.01 {
                self.center = target;
                self.target = Option.None;
            }
        }
    }

    /// The view-projection matrix into Vulkan's clip space, whose +Y points down the screen:
    /// an orthographic projection of the visible rectangle with its Y axis flipped.
    pub fn view_proj(&self, screen_size: Vec2) -> Mat4 {
        let half_width = self.half_width(screen_size);
        let (l, r) = (self.center.x - half_width, self.center.x + half_width);
        let (b, t) = (self.center.y - self.half_height, self.center.y + self.half_height);
        mat4_from_cols(
            vec4(2.0 / (r - l), 0.0, 0.0, 0.0),
            vec4(0.0, -2.0 / (t - b), 0.0, 0.0),
            vec4(0.0, 0.0, -1.0, 0.0),
            vec4(-(r + l) / (r - l), (t + b) / (t - b), 0.0, 1.0),
        )
    }

    /// Inverse of `view_proj`: a pixel position (origin top-left) to a world point.
    pub fn screen_to_world(&self, cursor: Vec2, screen_size: Vec2) -> Vec2 {
        let ndc = cursor.div(screen_size).scale(2.0).sub(vec2(1.0, 1.0));
        vec2(
            self.center.x + ndc.x * self.half_width(screen_size),
            self.center.y - ndc.y * self.half_height,
        )
    }

    /// The reverse of `screen_to_world`: where a world point is drawn, in pixels with the
    /// origin at the top-left.
    pub fn world_to_screen(&self, point: Vec2, screen_size: Vec2) -> Vec2 {
        let offset = point.sub(self.center);
        let ndc = vec2(offset.x / self.half_width(screen_size), -offset.y / self.half_height);
        ndc.add(vec2(1.0, 1.0)).scale(0.5).mul(screen_size)
    }

    /// Positive `steps` zoom in; each step scales the view by 10%.
    pub fn zoom(&mut self, steps: f32) {
        let factor = (1.1 as f32).powf(-steps);
        self.half_height = clamp(self.half_height * factor, MIN_HALF_HEIGHT, MAX_HALF_HEIGHT);
    }

    /// Drags the view so the world point under the cursor follows the cursor.
    pub fn pan(&mut self, delta_px: Vec2, screen_size: Vec2) {
        self.target = Option.None;
        let world_per_pixel = 2.0 * self.half_height / screen_size.y;
        self.center = self.center.add(vec2(-delta_px.x, delta_px.y).scale(world_per_pixel));
    }

    fn half_width(&self, screen_size: Vec2) -> f32 { self.half_height * screen_size.x / screen_size.y }
}
