//! Shape helpers: every shape is appended to a triangle list as vertices.

use std.linalg.Vec2;
use std.linalg.vec2;
use std.linalg.vec2_from_angle;
use std.math.Float;
use std.math.pi;
use std.math.tau;
use renderer.pipelines.MeshVertex;

/// An RGBA colour, each channel `0.0..=1.0`.
pub type Color = [f32; 4];

/// Texture coordinates for untextured geometry: the shader treats any negative `u` as full
/// coverage instead of sampling the atlas.
pub const SOLID_UV: [f32; 2] = [-1.0, -1.0];

/// Appends a filled regular polygon, as a triangle fan around its center.
pub fn regular_polygon(center: Vec2, radius: f32, sides: u32, rotation: f32, color: Color, out: &mut Vec[MeshVertex]) {
    let step = tau() as f32 / sides as f32;
    let corner = fn(i: u32) -> Vec2 { center.add(vec2_from_angle(rotation + step * i as f32).scale(radius)) };
    for i in 0..sides {
        push_triangle(out, center, corner(i), corner(i + 1), color);
    }
}

/// Appends the outline of a regular polygon: a band `width` thick centered on the polygon of
/// `radius`, with mitered corners so the edges join cleanly.
pub fn polygon_outline(center: Vec2, radius: f32, width: f32, sides: u32, rotation: f32, color: Color, out: &mut Vec[MeshVertex]) {
    // Moving an edge `width / 2` along its normal moves the corners further, since they're
    // farther from the center than the edge's midpoint.
    let corner_offset = width / 2.0 / (pi() as f32 / sides as f32).cos();
    let corner = fn(i: u32, r: f32) -> Vec2 { center.add(vec2_from_angle(rotation + tau() as f32 * i as f32 / sides as f32).scale(r)) };
    let (outer, inner) = (radius + corner_offset, radius - corner_offset);
    for i in 0..sides {
        let (a, b) = (corner(i, outer), corner(i + 1, outer));
        let (c, d) = (corner(i, inner), corner(i + 1, inner));
        push_triangle(out, a, b, d, color);
        push_triangle(out, a, d, c, color);
    }
}

/// Appends an axis-aligned filled rectangle spanning `min`..`max`.
pub fn quad(min: Vec2, max: Vec2, color: Color, out: &mut Vec[MeshVertex]) {
    let bottom_right = vec2(max.x, min.y);
    let top_left = vec2(min.x, max.y);
    push_triangle(out, min, bottom_right, max, color);
    push_triangle(out, min, max, top_left, color);
}

/// Appends a straight line from `a` to `b`, `width` world units thick.
pub fn segment(a: Vec2, b: Vec2, width: f32, color: Color, out: &mut Vec[MeshVertex]) {
    let side = b.sub(a).perp().normalize().scale(width / 2.0);
    push_triangle(out, a.sub(side), b.sub(side), b.add(side), color);
    push_triangle(out, a.sub(side), b.add(side), a.add(side), color);
}

/// Appends a line through `points`, `width` world units thick, as one ribbon whose pieces
/// meet exactly at each bend: no gaps, and no overlaps to darken when the colour is
/// see-through.
pub fn polyline(points: &Vec[Vec2], width: f32, color: Color, out: &mut Vec[MeshVertex]) {
    let n = points.len();
    if n < 2 { return; }
    let mut sides: Vec[Vec2] = Vec.new();
    for i in 0..n {
        // At a bend, offset along the average of the two edges' normals, stretched so the
        // ribbon keeps its width through the corner.
        let before = if i > 0 { direction(points, i - 1) } else { direction(points, i) };
        let after = if i + 1 < n { direction(points, i) } else { before };
        let sum = before.add(after);
        let normal = if sum.length() > 0.0 { sum.normalize() } else { after }.perp();
        let dot = normal.dot(after.perp());
        let stretch = if dot > 0.5 { dot } else { 0.5 };
        sides.push(normal.scale(width / 2.0 / stretch));
    }
    for i in 0..n - 1 {
        let (a, b) = (points[i], points[i + 1]);
        let (side_a, side_b) = (sides[i], sides[i + 1]);
        push_triangle(out, a.sub(side_a), b.sub(side_b), b.add(side_b), color);
        push_triangle(out, a.sub(side_a), b.add(side_b), a.add(side_a), color);
    }
}

/// The unit direction from point `i` to point `i + 1`, or zero where they coincide.
fn direction(points: &Vec[Vec2], i: i32) -> Vec2 {
    let d = points[i + 1].sub(points[i]);
    if d.length() > 0.0 { d.normalize() } else { vec2(0.0, 0.0) }
}

/// Appends a filled triangle.
pub fn triangle(a: Vec2, b: Vec2, c: Vec2, color: Color, out: &mut Vec[MeshVertex]) { push_triangle(out, a, b, c, color); }

fn push_triangle(out: &mut Vec[MeshVertex], a: Vec2, b: Vec2, c: Vec2, color: Color) {
    out.push(MeshVertex { pos: [a.x, a.y, 0.0], color, uv: SOLID_UV });
    out.push(MeshVertex { pos: [b.x, b.y, 0.0], color, uv: SOLID_UV });
    out.push(MeshVertex { pos: [c.x, c.y, 0.0], color, uv: SOLID_UV });
}

/// `a` x `b`: twice the signed area of the triangle from the origin to them.
fn cross(a: Vec2, b: Vec2) -> f32 { a.x * b.y - a.y * b.x }

/// Appends a filled simple polygon, convex or not, with its corners in either winding order.
/// It's cut into triangles by clipping ears: repeatedly removing a corner that bulges outward
/// with no other corner inside it.
pub fn polygon(points: &Vec[Vec2], color: Color, out: &mut Vec[MeshVertex]) {
    let count = points.len();
    // Twice the signed area: which way the corners wind.
    let mut winding = 0.0;
    for i in 0..count { winding = winding + cross(points[i], points[(i + 1) % count]); }
    let mut left: Vec[i32] = Vec.new();
    for i in 0..count { left.push(i); }
    while left.len() >= 3 {
        let n = left.len();
        let mut ear = 0 - 1;
        for i in 0..n {
            if ear >= 0 { break; }
            let (a, b, c) = (points[left[(i + n - 1) % n]], points[left[i]], points[left[(i + 1) % n]]);
            if cross(b.sub(a), c.sub(b)) * winding <= 0.0 { continue; }
            let mut clear = true;
            for k in 0..n {
                let p = points[left[k]];
                let corner = (p.x == a.x && p.y == a.y) || (p.x == b.x && p.y == b.y) || (p.x == c.x && p.y == c.y);
                if !corner && inside_triangle(p, a, b, c) { clear = false; }
            }
            if clear { ear = i; }
        }
        // Only a degenerate outline (crossing itself, or all in a line) has no ear; stop with
        // what's been cut so far.
        if ear < 0 { break; }
        let (a, b, c) = (points[left[(ear + n - 1) % n]], points[left[ear]], points[left[(ear + 1) % n]]);
        push_triangle(out, a, b, c, color);
        let _gone = left.remove(ear);
    }
}

/// On or inside the triangle `a`, `b`, `c`, whichever way round it winds.
fn inside_triangle(p: Vec2, a: Vec2, b: Vec2, c: Vec2) -> bool {
    let s1 = cross(b.sub(a), p.sub(a));
    let s2 = cross(c.sub(b), p.sub(b));
    let s3 = cross(a.sub(c), p.sub(c));
    (s1 >= 0.0 && s2 >= 0.0 && s3 >= 0.0) || (s1 <= 0.0 && s2 <= 0.0 && s3 <= 0.0)
}
