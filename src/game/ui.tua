/// Gap between panels and the window's edges.
const MARGIN: f32 = 18.0;
/// Space between a panel's border and its contents.
const PADDING: f32 = 16.0;
/// Extra space between consecutive lines of text.
const LINE_GAP: f32 = 4.0;
/// Space between groups of rows in a panel, and between buttons.
const GAP: f32 = 10.0;
const BORDER: f32 = 2.0;
const ARMED_BORDER: f32 = 3.0;

const TOP_BAR_HEIGHT: f32 = 52.0;
const END_TURN_HEIGHT: f32 = 38.0;
const BUTTON_HEIGHT: f32 = 60.0;
const BUTTON_MIN_WIDTH: f32 = 120.0;
const BUTTON_PADDING: f32 = 16.0;
const GROWTH_BAR_HEIGHT: f32 = 10.0;
/// Tooltip descriptions wrap at this many characters.
const TOOLTIP_WRAP: i32 = 50;
const TOOLTIP_GAP: f32 = 8.0;
/// Seconds the cursor rests on a map hex before its tooltip appears.
pub const TILE_TOOLTIP_DELAY: f32 = 0.75;
/// Where the tile tooltip's top-left corner sits relative to the cursor.
const TILE_TOOLTIP_OFFSET_X: f32 = 20.0;
const TILE_TOOLTIP_OFFSET_Y: f32 = -20.0;

// The swapchain is sRGB, so these linear colours display much lighter than their values
// suggest.
const BORDER_COLOR: Color = [0.30, 0.32, 0.38, 1.0];
const ARMED_BORDER_COLOR: Color = [1.00, 0.92, 0.55, 1.0];
const PANEL_BG: Color = [0.012, 0.014, 0.02, 0.94];
const BUTTON_BG: Color = [0.03, 0.035, 0.05, 0.95];
const BUTTON_HOVER_BG: Color = [0.08, 0.09, 0.13, 0.95];
const QUEUED_BG: Color = [0.78, 0.64, 0.20, 0.95];
const QUEUED_HOVER_BG: Color = [0.90, 0.76, 0.30, 0.95];
const DISABLED_BG: Color = [0.02, 0.02, 0.025, 0.95];
const BAR_BG: Color = [0.01, 0.02, 0.02, 1.0];
const GROWTH_COLOR: Color = [0.30, 0.88, 0.35, 1.0];
const TEXT: Color = [0.95, 0.95, 0.95, 1.0];
const QUEUED_TEXT: Color = [0.08, 0.07, 0.04, 1.0];
const QUEUED_HINT_TEXT: Color = [0.25, 0.20, 0.08, 1.0];
const DISABLED_TEXT: Color = [0.18, 0.18, 0.20, 1.0];
const DIM_TEXT: Color = [0.55, 0.55, 0.60, 1.0];
const LABEL_TEXT: Color = [0.30, 0.32, 0.38, 1.0];
const NOTICE_TEXT: Color = [0.95, 0.85, 0.55, 1.0];
const GOLD_TEXT: Color = [0.95, 0.80, 0.35, 1.0];
const BOOSTED_TEXT: Color = [0.55, 0.92, 0.50, 1.0];
const REDUCED_TEXT: Color = [0.98, 0.52, 0.42, 1.0];
const SELECTION_BOX_FILL: Color = [0.30, 0.55, 0.95, 0.12];
const SELECTION_BOX_EDGE: Color = [0.55, 0.75, 1.00, 0.9];
const SELECTION_BOX_BORDER: f32 = 2.0;
/// Opacity the debug panel is drawn at, so it doesn't read as game UI.
const DEBUG_ALPHA: f32 = 0.55;

/// Maps UI pixels (origin bottom-left, Y up) to clip space.
pub fn ui_projection(screen_size: Vec2) -> Mat4 {
    mat4_from_cols(
        vec4(2.0 / screen_size.x, 0.0, 0.0, 0.0),
        vec4(0.0, -2.0 / screen_size.y, 0.0, 0.0),
        vec4(0.0, 0.0, 1.0, 0.0),
        vec4(-1.0, 1.0, 0.0, 1.0),
    )
}

/// While Alt-dragging: the selection rectangle between `a` and `b` (window pixels, origin
/// top-left), a translucent fill with a thin border.
pub fn selection_box(a: Vec2, b: Vec2, screen_size: Vec2, out: &mut Vec[MeshVertex]) {
    let (a, b) = (to_ui(a, screen_size), to_ui(b, screen_size));
    let (min, max) = (a.min(b).round(), a.max(b).round());
    quad(min, max, SELECTION_BOX_FILL, out);
    let edge = vec2(SELECTION_BOX_BORDER, SELECTION_BOX_BORDER);
    quad(min, vec2(max.x, min.y).add(edge), SELECTION_BOX_EDGE, out);
    quad(vec2(min.x, max.y).sub(edge), max, SELECTION_BOX_EDGE, out);
    quad(min, vec2(min.x, max.y).add(edge), SELECTION_BOX_EDGE, out);
    quad(vec2(max.x, min.y).sub(edge), max, SELECTION_BOX_EDGE, out);
}

/// Something a button does.
pub enum Target {
    Unit(UnitAction),
    Build(BuildUnit),
    ToggleYields,
    EndTurn,
    /// Debug panel: scenario pages, the savestate and playback pacing.
    Scenario(Scenario),
    SaveState,
    LoadState,
    TogglePlayback,
    /// Debug panel: finish the open city's or Barracks' current build, and toggle the fog of war.
    CompleteProduction,
    ToggleFog,
    /// A queue row clicked (not dragged), and the turn strip's chips: click, Shift-click, Ctrl-click.
    QueueItem(QueueKind, i32),
    RosterSelect(RosterKey),
    RosterAdd(RosterKey),
    RosterRemove(RosterKey),
    /// City tray: the open city's labor focus.
    Focus(LaborFocus),
    /// City tray: queue a worker, queue a building (or resume choosing its site), confirm a
    /// finished building, open the Barracks; a queue row's up arrow and X.
    BuildWorker,
    Building(Building),
    ConfirmBuilding(Building),
    OpenBarracks,
    QueueUp(i32),
    QueueRemove(i32),
    /// Worker menu: arm a job, open or close the menu, list a city, rest its idle workers, take
    /// a waiting job off the list, send a worker home, show a worker on the map.
    WorkerJob(JobKind),
    WorkerMode,
    WorkerCity(i32),
    SleepWorkers,
    WorkerJobRemove(i32),
    RecallWorker(u32),
    ShowWorker(u32),
    /// City interior: open or leave it, clear the selected fighter's orders.
    OpenInterior,
    InteriorClear,
    /// Barracks tray: train a troop, take a queued one out, back to the city.
    BarracksBuild(BuildUnit),
    BarracksQueueRemove(i32),
    OpenCity,
    /// Settings menu: set a setting to a value, close the menu, or quit the game.
    SetSetting(Setting, i32),
    CloseSettings,
    Quit,
}

impl Eq for Target {
    fn eq(self, other: Target) -> bool {
        match (self, other) {
            (Target.Unit(a), Target.Unit(b)) => a == b,
            (Target.Build(a), Target.Build(b)) => a == b,
            (Target.Scenario(a), Target.Scenario(b)) => a == b,
            (Target.QueueItem(a, x), Target.QueueItem(b, y)) => a == b && x == y,
            (Target.RosterSelect(a), Target.RosterSelect(b)) => a == b,
            (Target.RosterAdd(a), Target.RosterAdd(b)) => a == b,
            (Target.RosterRemove(a), Target.RosterRemove(b)) => a == b,
            (Target.ToggleYields, Target.ToggleYields) | (Target.EndTurn, Target.EndTurn) | (Target.SaveState, Target.SaveState)
                | (Target.LoadState, Target.LoadState) | (Target.TogglePlayback, Target.TogglePlayback)
                | (Target.CompleteProduction, Target.CompleteProduction) | (Target.ToggleFog, Target.ToggleFog) => true,
            (Target.SetSetting(a, x), Target.SetSetting(b, y)) => a == b && x == y,
            (Target.CloseSettings, Target.CloseSettings) | (Target.Quit, Target.Quit) => true,
            (Target.Focus(a), Target.Focus(b)) => a == b,
            (Target.BuildWorker, Target.BuildWorker) | (Target.OpenBarracks, Target.OpenBarracks) | (Target.OpenCity, Target.OpenCity) => true,
            (Target.Building(a), Target.Building(b)) => a == b,
            (Target.ConfirmBuilding(a), Target.ConfirmBuilding(b)) => a == b,
            (Target.QueueUp(a), Target.QueueUp(b)) => a == b,
            (Target.QueueRemove(a), Target.QueueRemove(b)) => a == b,
            (Target.BarracksQueueRemove(a), Target.BarracksQueueRemove(b)) => a == b,
            (Target.BarracksBuild(a), Target.BarracksBuild(b)) => a == b,
            (Target.WorkerJob(a), Target.WorkerJob(b)) => a == b,
            (Target.WorkerMode, Target.WorkerMode) | (Target.SleepWorkers, Target.SleepWorkers) => true,
            (Target.OpenInterior, Target.OpenInterior) | (Target.InteriorClear, Target.InteriorClear) => true,
            (Target.WorkerCity(a), Target.WorkerCity(b)) => a == b,
            (Target.WorkerJobRemove(a), Target.WorkerJobRemove(b)) => a == b,
            (Target.RecallWorker(a), Target.RecallWorker(b)) => a == b,
            (Target.ShowWorker(a), Target.ShowWorker(b)) => a == b,
            _ => false,
        }
    }
}

/// An order for the selected unit.
pub enum UnitAction { Move, Attack, Swap, Ability, Hold, Guard, Settle, ClearOrders, Disband }

/// Which production list a queue row belongs to.
pub enum QueueKind { City, Barracks, Workers }

impl QueueKind {
    /// What the row's X button does.
    pub fn remove_target(self, index: i32) -> Target {
        match self {
            QueueKind.City => Target.QueueRemove(index),
            QueueKind.Barracks => Target.BarracksQueueRemove(index),
            QueueKind.Workers => Target.WorkerJobRemove(index),
        }
    }
}

/// What a chip in the turn strip stands for.
pub enum RosterKey {
    /// A city with nothing to build, by its id.
    Production(u32),
    /// A city with idle workers, by its id.
    Workers(u32),
    /// The units of one kind that need orders: a unit type, and whether they're settlers (which
    /// use the melee body).
    Group(UnitType, bool),
    /// One unit, by its id, in an open group's row.
    Unit(u32),
}

impl Eq for RosterKey {
    fn eq(self, other: RosterKey) -> bool {
        match (self, other) {
            (RosterKey.Production(a), RosterKey.Production(b)) => a == b,
            (RosterKey.Workers(a), RosterKey.Workers(b)) => a == b,
            (RosterKey.Group(a, x), RosterKey.Group(b, y)) => a == b && x == y,
            (RosterKey.Unit(a), RosterKey.Unit(b)) => a == b,
            _ => false,
        }
    }
}

/// A turn strip chip's picture.
pub enum ChipIcon { City, Unit(UnitLook) }

/// One token of the turn strip.
pub struct RosterChip { key: RosterKey, icon: ChipIcon, color: Color, selected: bool, count: i32 }

/// A production queue row: its list and place in it, its text, whether it is the front item
/// (being built now) and whether it may not be moved.
pub struct QueueItemSpec { kind: QueueKind, index: i32, label: Str, active: bool, locked: bool }

/// A setting row in the settings menu: the setting at its current value.
pub struct SettingRow { setting: Setting, value: i32 }

pub enum ButtonState {
    Ready,
    /// Already queued (or, for End Turn, ready to go).
    Queued,
    /// Not possible right now.
    Disabled,
}

fn button_state(queued: bool, disabled: bool) -> ButtonState {
    if disabled { ButtonState.Disabled } else if queued { ButtonState.Queued } else { ButtonState.Ready }
}

/// A span of text in one colour; a line is several, drawn left to right.
pub struct Span { text: Str, color: Color }

pub struct Button {
    target: Target,
    label: Str,
    /// The keyboard shortcut or cost, shown under the label (or beside it on a single-line
    /// button).
    hint: Str,
    state: ButtonState,
    /// This button's action is what the next map click will do.
    armed: bool,
    /// Part of the debug panel, drawn see-through so it doesn't read as game UI.
    faded: bool,
    min: Vec2,
    max: Vec2,
}

impl Button {
    fn contains(&self, point: Vec2) -> bool { contains(self.min, self.max, point) }
}

/// A panel's rectangle, which swallows clicks.
pub struct Rect { min: Vec2, max: Vec2 }

/// Something drawn, in order: a panel, a line of text (an index into `UiLayout.texts`), or a bar.
pub enum Shape {
    Panel(Vec2, Vec2, bool),
    Text(i32),
    Bar(Vec2, Vec2, f32),
}

/// A line of text: where its first span starts, at what size, and its spans.
pub struct TextShape { origin: Vec2, size: TextSize, spans: Vec[Span] }

/// The UI for one frame. Panels also swallow clicks, so a click on the UI never falls through
/// to the map.
pub struct UiLayout {
    shapes: Vec[Shape],
    texts: Vec[TextShape],
    buttons: Vec[Button],
    panels: Vec[Rect],
    catalogs: Vec[CatalogRegion],
    /// Where the settings menu's shapes and buttons start, while it's open: drawn over
    /// everything else, and its buttons take clicks before any underneath.
    overlay: Option[HoverOverlay],
}

/// The first shape and the first button of the settings menu.
pub struct HoverOverlay { shapes: i32, buttons: i32 }

fn empty_layout() -> UiLayout { UiLayout { shapes: Vec.new(), texts: Vec.new(), buttons: Vec.new(), panels: Vec.new(), catalogs: Vec.new(), overlay: Option.None } }

impl UiLayout {
    pub fn button_at(&self, point: Vec2) -> Option[i32] {
        let first = match self.overlay { Option.Some(o) => o.buttons, Option.None => self.buttons.len() };
        for i in first..self.buttons.len() {
            if self.buttons[i].contains(point) { return Option.Some(i); }
        }
        for i in 0..first {
            if self.buttons[i].contains(point) { return Option.Some(i); }
        }
        Option.None
    }

    pub fn button_for(&self, target: Target) -> Option[i32] {
        for i in 0..self.buttons.len() {
            if self.buttons[i].target == target { return Option.Some(i); }
        }
        Option.None
    }

    pub fn covers(&self, point: Vec2) -> bool {
        for i in 0..self.panels.len() {
            if contains(self.panels[i].min, self.panels[i].max, point) { return true; }
        }
        false
    }

    fn panel(&mut self, min: Vec2, max: Vec2, faded: bool) {
        self.shapes.push(Shape.Panel(min, max, faded));
        self.panels.push(Rect { min, max });
    }

    /// Adds a line of text with its capital letters centered vertically on `left_middle.y`,
    /// starting at `left_middle.x`.
    fn text_row(&mut self, left_middle: Vec2, size: TextSize, spans: Vec[Span]) {
        let face = ui(size);
        let origin = vec2(left_middle.x, left_middle.y - face.cap_height / 2.0);
        self.shapes.push(Shape.Text(self.texts.len()));
        self.texts.push(TextShape { origin, size, spans });
    }

    fn draw_shapes(&self, out: &mut Vec[MeshVertex]) {
        for i in 0..self.shapes.len() {
            match self.shapes[i] {
                Shape.Panel(min, max, faded) => draw_box(min, max, fade(PANEL_BG, faded), BORDER, fade(BORDER_COLOR, faded), out),
                Shape.Text(t) => {
                    let line = &self.texts[t];
                    let face = ui(line.size);
                    let mut pen = line.origin.x;
                    for k in 0..line.spans.len() {
                        let s = &line.spans[k];
                        let t = &s.text;
                        face.push(vec2(pen, line.origin.y), t, s.color, out);
                        pen = pen + face.width(t);
                    }
                }
                Shape.Bar(min, max, fraction) => {
                    quad(min, max, BAR_BG, out);
                    let f = if fraction < 0.0 { 0.0 } else if fraction > 1.0 { 1.0 } else { fraction };
                    quad(min, vec2(min.x + (max.x - min.x) * f, max.y), GROWTH_COLOR, out);
                }
            }
        }
    }
}

impl GameState {
    /// The UI as a triangle list in UI pixels. `cursor` is in window pixels with the origin at
    /// the top-left.
    pub fn build_ui(&self, screen_size: Vec2, cursor: Option[Vec2]) -> Vec[MeshVertex] {
        let mut layout = self.layout(screen_size);
        let point = match cursor { Option.Some(c) => Option.Some(to_ui(c, screen_size)), Option.None => Option.None };
        let hovered = match point { Option.Some(p) => layout.button_at(p), Option.None => Option.None };

        // Describe a unit under the cursor, unless it's the selected one (already in the tray)
        // or the cursor is over the UI.
        let over_ui = match point { Option.Some(p) => layout.covers(p), Option.None => false };
        if let Option.Some(c) = cursor {
            if !over_ui {
                if let Option.Some(idx) = self.unit_at_screen(c, screen_size) {
                    if Option.Some(idx) != self.selected || self.selected_city.is_some() {
                        // Top-right, clear of the debug panel at the top-left.
                        let mut panel = panel_builder(false);
                        self.unit_info(idx, &mut panel);
                        let top_left = vec2(screen_size.x - MARGIN - panel.size().x, screen_size.y - TOP_BAR_HEIGHT - MARGIN);
                        panel.place_top_left(top_left, &mut layout);
                    }
                }
            }
        }

        let mut out: Vec[MeshVertex] = Vec.new();
        layout.draw_shapes(&mut out);
        for i in 0..layout.buttons.len() { draw_button(&layout.buttons[i], hovered == Option.Some(i), &mut out); }
        if let Option.Some(i) = hovered { self.draw_tooltip(&layout.buttons[i], &layout, screen_size, &mut out); }
        if let (Option.Some(p), Option.Some(hex)) = (point, self.hovered_tile) {
            if self.hover_seconds >= TILE_TOOLTIP_DELAY && !over_ui { self.draw_tile_tooltip(hex, p, screen_size, &mut out); }
        }
        out
    }

    /// Whether `cursor` (window pixels, origin top-left) is over a panel or button.
    /// The wheel over a city's building catalog scrolls the catalog, a card per step,
    /// instead of zooming the map. Answers whether the wheel was the catalog's.
    pub fn scroll_buildings_at(&mut self, cursor: Vec2, screen_size: Vec2, steps: f32) -> bool {
        if self.imgui_ui { return false; }
        let point = to_ui(cursor, screen_size);
        let layout = self.layout(screen_size);
        for k in 0..layout.catalogs.len() {
            let region = &layout.catalogs[k];
            if !contains(region.min, region.max, point) { continue; }
            let delta = steps.abs().ceil() as i32;
            let current = self.cities[region.city].building_scroll;
            let moved = if steps > 0.0 { current - delta } else { current + delta };
            self.cities[region.city].building_scroll = if moved < 0 { 0 } else if moved > region.max_offset { region.max_offset } else { moved };
            return true;
        }
        false
    }

    pub fn ui_covers(&self, cursor: Vec2, screen_size: Vec2) -> bool {
        if self.imgui_ui { return self.ui_captured; }
        let point = to_ui(cursor, screen_size);
        let layout = self.layout(screen_size);
        layout.button_at(point).is_some() || layout.covers(point)
    }

    /// Handles a click on the UI, returning whether it hit anything (in which case it shouldn't
    /// also count as a click on the map). `cursor` is in window pixels with the origin at the
    /// top-left.
    pub fn click_ui(&mut self, cursor: Vec2, screen_size: Vec2) -> bool can {Log, Rand} {
        if self.imgui_ui { return false; }
        let point = to_ui(cursor, screen_size);
        let layout = self.layout(screen_size);
        let Option.Some(i) = layout.button_at(point) else { return layout.covers(point); };
        let (target, state) = (layout.buttons[i].target, layout.buttons[i].state);
        if state == ButtonState.Disabled { return true; }
        self.activate_target(target);
        true
    }

    /// What pressing a button does: the same from a classic button and a library widget.
    pub fn activate_target(&mut self, target: Target) can {Log, Rand} {
        match target {
            Target.Unit(action) => match action {
                UnitAction.Move => self.choose_move_action(),
                UnitAction.Attack => self.choose_attack_action(),
                UnitAction.Swap => self.choose_swap_action(),
                UnitAction.Ability => self.toggle_selected_ability(),
                UnitAction.Hold => self.hold_selected_unit(),
                UnitAction.Guard => self.toggle_guard(),
                UnitAction.Settle => self.found_city_selected(),
                UnitAction.ClearOrders => self.handle_right_click(),
                UnitAction.Disband => self.disband_selected(),
            },
            Target.Build(build) => self.queue_selected_city_unit(build),
            Target.ToggleYields => self.toggle_yields(),
            Target.EndTurn => self.end_planning(),
            Target.Scenario(scenario) => self.switch_scenario(scenario),
            Target.SaveState => self.save_state(),
            Target.LoadState => self.load_state(),
            Target.TogglePlayback => self.toggle_instant_playback(),
            Target.SetSetting(setting, value) => self.set_setting(setting, value),
            Target.CloseSettings => self.close_settings(),
            Target.Focus(focus) => self.set_selected_city_focus(focus),
            Target.BuildWorker => self.queue_selected_city_worker(),
            Target.Building(building) => self.queue_selected_city_building(building),
            Target.ConfirmBuilding(building) => self.confirm_building(building),
            Target.OpenBarracks => { if let Option.Some(city) = self.selected_city { self.open_barracks(city); } }
            Target.QueueUp(index) => self.move_selected_city_queue_item(index, true),
            Target.QueueRemove(index) => self.remove_selected_city_queue_item(index),
            Target.BarracksBuild(build) => self.queue_selected_barracks_unit(build),
            Target.BarracksQueueRemove(index) => self.remove_selected_barracks_queue_item(index),
            Target.OpenCity => self.open_selected_city_from_barracks(),
            Target.OpenInterior => self.toggle_city_interior(),
            Target.InteriorClear => self.clear_selected_interior_orders(),
            Target.WorkerJob(kind) => self.arm_worker_job(kind),
            Target.WorkerMode => self.toggle_worker_mode(),
            Target.WorkerCity(city) => { self.worker_menu_city = Option.Some(city); }
            Target.SleepWorkers => self.sleep_workers(),
            Target.WorkerJobRemove(index) => self.remove_worker_job(index),
            Target.RecallWorker(id) => self.recall_worker(id),
            Target.ShowWorker(id) => self.show_worker(id),
            Target.Quit => self.request_quit(),
            Target.CompleteProduction => self.debug_complete_current_production(),
            Target.ToggleFog => self.toggle_fog(),
            Target.QueueItem(kind, index) => self.queue_item_clicked(kind, index),
            Target.RosterSelect(key) => self.roster_select(key),
            Target.RosterAdd(key) => self.roster_add(key),
            Target.RosterRemove(key) => self.roster_remove(key),
        }
    }

    /// Tracks which map hex the cursor is over (ignoring the UI) and how long it has rested
    /// there, for city hover outlines and the tile tooltip. `cursor` is in window pixels with
    /// the origin at the top-left.
    pub fn update_hover(&mut self, cursor: Option[Vec2], screen_size: Vec2, dt: f32) {
        let layout = if self.imgui_ui { empty_layout() } else { self.layout(screen_size) };
        let hex = match cursor {
            Option.Some(c) => if (self.imgui_ui && self.ui_captured) || layout.covers(to_ui(c, screen_size)) { Option.None } else { self.hex_at_screen(c, screen_size) },
            Option.None => Option.None,
        };
        if hex == self.hovered_tile {
            self.hover_seconds = self.hover_seconds + dt;
        } else {
            self.hovered_tile = hex;
            self.hover_seconds = 0.0;
        }
        self.hovered_city = match hex { Option.Some(h) => self.city_at(h), Option.None => Option.None };
        // With a job armed, the tile or hex edge under the cursor (over the map, not the UI),
        // for its highlight.
        self.hovered_job = match (hex, cursor) {
            (Option.Some(_), Option.Some(c)) => self.job_target_at(self.camera.screen_to_world(c, screen_size)),
            _ => Option.None,
        };
    }

    pub fn layout(&self, screen_size: Vec2) -> UiLayout {
        let mut layout = empty_layout();
        self.top_bar(screen_size, &mut layout);
        self.debug_panel(screen_size, &mut layout);

        let mut tray = panel_builder(false);
        let mut shown = true;
        if let Option.Some(city) = self.interior_view {
            self.interior_tray(city, &mut tray);
        } else if let Option.Some(city) = self.selected_city {
            self.city_tray(city, &mut tray);
        } else if let Option.Some(city) = self.selected_barracks {
            self.barracks_tray(city, &mut tray);
        } else if let Option.Some(idx) = self.selected {
            self.unit_info(idx, &mut tray);
            tray.gap(GAP);
            self.unit_buttons(idx, &mut tray);
        } else if !self.group.is_empty() {
            self.group_tray(&mut tray);
        } else if self.worker_mode {
            self.worker_menu(&mut tray);
        } else {
            shown = false;
        }
        if shown { tray.place_bottom_left(vec2(MARGIN, MARGIN), &mut layout); }
        self.place_settings(screen_size, &mut layout);
        layout
    }

    /// The settings menu, while it's open: centered on the screen and placed last, so it
    /// draws over the other panels and its buttons take clicks before theirs.
    fn place_settings(&self, screen_size: Vec2, layout: &mut UiLayout) {
        if !self.settings_open { return; }
        let panel = self.settings_panel();
        let size = panel.size();
        let top_left = vec2((screen_size.x - size.x) / 2.0, (screen_size.y + size.y) / 2.0);
        layout.overlay = Option.Some(HoverOverlay { shapes: layout.shapes.len(), buttons: layout.buttons.len() });
        panel.place_top_left(top_left, layout);
    }

    /// The settings under a heading per group (`Setting.group`), then Close and Quit. Each
    /// setting shows its name, and buttons that set it: one per value (the current one gold),
    /// or < and > with the value between the name and them for a slider or a longer list.
    fn settings_panel(&self) -> PanelBuilder {
        let mut panel = panel_builder(false);
        panel.text(TextSize.Title, "SETTINGS", TEXT);
        let mut group = "";
        for k in 0..5 {
            let setting = SETTINGS[k];
            let heading = setting.group();
            if !str_eq(&heading, &group) {
                group = heading;
                panel.gap(GAP);
                panel.text(TextSize.Small, group, LABEL_TEXT);
            }
            let value = self.settings.get(setting);
            let (low, high) = setting.range();
            panel.gap(GAP / 2.0);
            panel.begin_line();
            panel.span_owned(text(fn() can {Out} { Out.put(setting.name()); Out.put("  "); }), LABEL_TEXT);
            if steps_in_classic(setting) { panel.span_owned(setting.value_text(value), GOLD_TEXT); }
            panel.end_line(TextSize.Body);
            panel.begin_buttons();
            if steps_in_classic(setting) {
                panel.button(Target.SetSetting(setting, value - 1), "<", "", button_state(false, value <= low), false);
                panel.button(Target.SetSetting(setting, value + 1), ">", "", button_state(false, value >= high), false);
            } else {
                for to in low..=high {
                    let label = setting.value_text(to);
                    panel.button(Target.SetSetting(setting, to), &label, "", button_state(to == value, false), false);
                }
            }
            panel.end_buttons(true);
        }
        panel.gap(GAP);
        panel.begin_buttons();
        panel.button(Target.CloseSettings, "CLOSE", "ESC", ButtonState.Ready, false);
        panel.button(Target.Quit, "QUIT", "", ButtonState.Ready, false);
        panel.end_buttons(true);
        panel
    }

    /// Testing tools, top-left under the top bar and see-through so they don't read as game
    /// UI: the scenario pages (the current one gold; pressing it again restarts it), the
    /// savestate, finishing a build, the playback pacing and the fog.
    fn debug_panel(&self, size: Vec2, layout: &mut UiLayout) {
        self.debug_panel_content().place_top_left(vec2(MARGIN, size.y - TOP_BAR_HEIGHT - MARGIN), layout);
    }

    /// The debug panel's rows, shared by both presentations.
    pub fn debug_panel_content(&self) -> PanelBuilder {
        let mut panel = panel_builder(true);
        panel.text(TextSize.Small, "DEBUG", fade(LABEL_TEXT, true));
        panel.begin_buttons();
        for i in 0..4 {
            let scenario = SCENARIOS[i];
            panel.button(Target.Scenario(scenario), scenario.name(), scenario.key(), button_state(scenario == self.scenario, false), false);
        }
        panel.end_buttons(true);
        if let Option.Some(seed) = self.map_seed {
            panel.text_owned(TextSize.Small, text(fn() can {Out} { Out.put("MAP SEED "); show_u64(seed as u64); }), fade(DIM_TEXT, true));
        }
        panel.gap(GAP);
        panel.begin_buttons();
        for i in 4..SCENARIO_COUNT {
            let scenario = SCENARIOS[i];
            panel.button(Target.Scenario(scenario), scenario.name(), if scenario == Scenario.Naval { "" } else { scenario.key() }, button_state(scenario == self.scenario, false), false);
        }
        panel.button(Target.SaveState, "SAVE", "F6", button_state(false, self.is_resolving()), false);
        panel.button(Target.LoadState, "LOAD", "F7", button_state(false, self.savestate.is_none()), false);
        panel.end_buttons(true);
        let can_complete = if let Option.Some(city) = self.selected_barracks {
            !self.cities[city].barracks_queue.is_empty()
        } else if let Option.Some(city) = self.selected_city {
            !self.cities[city].queue.is_empty() && self.cities[city].pending_building.is_none()
        } else {
            false
        };
        panel.begin_buttons();
        panel.button(Target.CompleteProduction, "COMPLETE PRODUCTION", "F9", button_state(false, self.is_resolving() || !can_complete), false);
        panel.end_buttons(true);
        if self.savestate.is_some() {
            let saved = text(fn() can {Out} { Out.put("SAVED: "); self.show_saved(); });
            panel.text_owned(TextSize.Small, saved, fade(DIM_TEXT, true));
        }
        panel.gap(GAP);
        let playback = if self.settings.instant_playback { "PLAYBACK: ALL AT ONCE" } else { "PLAYBACK: STEP BY STEP" };
        panel.begin_buttons();
        panel.button(Target.TogglePlayback, playback, "F8", ButtonState.Ready, false);
        panel.end_buttons(true);
        panel.begin_buttons();
        panel.button(Target.ToggleFog, if self.fog_of_war { "FOG OF WAR: ON" } else { "FOG OF WAR: OFF" }, "F10", ButtonState.Ready, false);
        panel.end_buttons(true);
        panel
    }

    /// Turn number on the left, the latest notice in the middle, and on the right the End Turn
    /// button, which names whatever the turn is still waiting on (clicking it selects that).
    fn top_bar(&self, size: Vec2, layout: &mut UiLayout) {
        let min = vec2(0.0, size.y - TOP_BAR_HEIGHT);
        layout.panel(min, size, false);
        let middle = min.y + TOP_BAR_HEIGHT / 2.0;

        let (units, cities, workers) = self.pending();
        let turn = if self.is_resolving() { self.turn } else { self.turn + 1 };
        let turn_text = text(fn() can {Out} { Out.put("TURN "); show_u64(turn as u64); });
        let left_end = MARGIN + ui(TextSize.Title).width(&turn_text);
        let mut spans: Vec[Span] = Vec.new();
        spans.push(Span { text: turn_text, color: TEXT });
        layout.text_row(vec2(MARGIN, middle), TextSize.Title, spans);

        let label = if self.is_resolving() { to_owned("RESOLVING") } else { end_turn_label(units, cities, workers) };
        let hint = to_owned("SPACE");
        let width = single_line_button_width(&label, &hint);
        let button_min = vec2(size.x - MARGIN - width, middle - END_TURN_HEIGHT / 2.0);
        let state = if self.is_resolving() { ButtonState.Disabled } else { button_state(units == 0 && cities == 0 && workers == 0, false) };
        let end_turn = Button {
            target: Target.EndTurn,
            label,
            hint,
            state,
            armed: false,
            faded: false,
            min: button_min.round(),
            max: button_min.add(vec2(width, END_TURN_HEIGHT)).round(),
        };

        // The notice sits centered in the space left between the two.
        let shown = self.shown_notice();
        if !shown.is_empty() {
            let notice = &shown;
            let width = ui(TextSize.Body).width(notice);
            let (from, to) = (left_end + 2.0 * GAP, end_turn.min.x - 2.0 * GAP);
            let centered = (from + to - width) / 2.0;
            let left = if centered > from { centered } else { from };
            if left + width <= to {
                let mut notice: Vec[Span] = Vec.new();
                notice.push(Span { text: copy_str(&shown), color: NOTICE_TEXT });
                layout.text_row(vec2(left, middle), TextSize.Body, notice);
            }
        }
        layout.buttons.push(end_turn);
    }

    /// A unit's name, stats as they stand this turn, and anything notable about it. Stats
    /// boosted above their base value are green, reduced red.
    pub fn unit_info(&self, idx: i32, panel: &mut PanelBuilder) {
        let unit = &self.units[idx];
        let base = unit.unit_type.stats();
        let stats = unit.stats();
        let tile = self.grid.tile(unit.pos);
        let defense = stats.defense * tile.defense_multiplier();
        let role = self.unit_role(unit).name();

        let title = text(fn() can {Out} { Out.put(unit.team.name()); Out.put(" "); Out.put(role); });
        panel.text_owned(TextSize.Title, title, unit.team.color());

        let hp_color = if unit.hp < unit.max_hp() * 0.5 { REDUCED_TEXT } else { TEXT };
        panel.begin_line();
        panel.stat("HP", text(fn() can {Out} { show_rounded(unit.hp.ceil()); Out.put("/"); show_rounded(unit.max_hp()); }), hp_color);
        panel.stat("ATTACK", text(fn() can {Out} { show_rounded(stats.attack); }), compare(stats.attack, base.attack));
        panel.stat("DEFENSE", text(fn() can {Out} { show_rounded(defense); }), compare(defense, base.defense));
        panel.end_line(TextSize.Body);

        let (ability_name, _) = ability_text(unit);
        panel.begin_line();
        panel.stat("RANGE", text(fn() can {Out} { show_i64(stats.attack_range as i64); }), compare(stats.attack_range as f32, base.attack_range as f32));
        panel.stat("MOVE", text(fn() can {Out} { show_i64(stats.move_range as i64); }), compare(stats.move_range as f32, base.move_range as f32));
        if !self.settlers.contains(unit.id) {
            panel.span_owned(text(fn() can {Out} { Out.put("   "); Out.put(ability_name); Out.put(" "); }), LABEL_TEXT);
            if unit.ability_queued {
                panel.span("QUEUED", GOLD_TEXT);
            } else if unit.ability_cooldown > 0 {
                panel.span_owned(text(fn() can {Out} { Out.put("IN "); show_turns(unit.ability_cooldown); }), DIM_TEXT);
            } else {
                panel.span("READY", TEXT);
            }
        }
        panel.end_line(TextSize.Body);

        if tile.defense_multiplier() != 1.0 {
            let bonus = (tile.defense_multiplier() - 1.0) * 100.0;
            panel.text_owned(TextSize.Small, text(fn() can {Out} { Out.put("+"); show_rounded(bonus); Out.put("% DEFENSE FROM TERRAIN"); }), DIM_TEXT);
        }
        if unit.deployed { panel.text(TextSize.Small, "DEPLOYED: +1 RANGE, CANNOT MOVE", DIM_TEXT); }
        if self.rival_of(idx).is_some() { panel.text(TextSize.Small, "CONTESTED: FIGHTING FOR THIS HEX", DIM_TEXT); }
        if self.is_player_controlled(idx) {
            let names = [(unit.planned_move.is_some(), "MOVE"), (unit.planned_attack.is_some(), "ATTACK"), (unit.holding, "HOLD"), (unit.guarding, "GUARD")];
            let mut any = false;
            for k in 0..4 {
                let (on, _) = names[k];
                if on { any = true; }
            }
            if any {
                let orders = text(fn() can {Out} {
                    Out.put("ORDERS: ");
                    let mut first = true;
                    for k in 0..4 {
                        let (on, name) = names[k];
                        if on {
                            if !first { Out.put(", "); }
                            Out.put(name);
                            first = false;
                        }
                    }
                });
                panel.text_owned(TextSize.Small, orders, DIM_TEXT);
            }
        }
    }

    /// The selected unit's order buttons: what it can do depends on whether it's a fighter, a
    /// settler or a worker.
    pub fn unit_buttons(&self, idx: i32, panel: &mut PanelBuilder) {
        let unit = &self.units[idx];
        let can_move = unit.stats().move_range > 0;
        let locked = self.rival_of(idx).is_some();
        let swapping = self.swap_partner(idx).is_some();
        let settler = self.settlers.contains(unit.id);

        panel.begin_buttons();
        panel.button(Target.Unit(UnitAction.Move), "MOVE", "M", button_state(unit.planned_move.is_some() && !swapping, !can_move), self.armed(ClickMode.Move));
        panel.button(Target.Unit(UnitAction.Attack), "ATTACK", "X \u{b7} RMB", button_state(unit.planned_attack.is_some(), !unit.can_attack() || locked), self.armed(ClickMode.Attack));
        panel.button(Target.Unit(UnitAction.Swap), "SWAP", "CTRL", button_state(swapping, !can_move || locked), self.armed(ClickMode.Swap));
        if settler {
            panel.button(Target.Unit(UnitAction.Settle), "FOUND CITY", "F", ButtonState.Ready, false);
        } else {
            let (name, _) = ability_text(unit);
            let cooldown = unit.ability_cooldown;
            let label = if cooldown == 0 {
                to_owned(name)
            } else {
                text(fn() can {Out} { Out.put(name); Out.put(" ("); show_u64(cooldown as u64); Out.put(")"); })
            };
            panel.button(Target.Unit(UnitAction.Ability), &label, "Q", button_state(unit.ability_queued, cooldown > 0), false);
        }
        panel.end_buttons(false);
        // Standing orders on a row of their own, so the tray fits a small window.
        panel.gap(GAP);
        panel.begin_buttons();
        panel.button(Target.Unit(UnitAction.Hold), "HOLD", "SPACE", button_state(unit.holding, false), false);
        panel.button(Target.Unit(UnitAction.Guard), "GUARD", "G", button_state(unit.guarding, false), false);
        panel.button(Target.Unit(UnitAction.ClearOrders), "CLEAR ORDERS", "CTRL-RMB", button_state(false, !unit.has_orders()), false);
        let confirming = self.disband_armed == Option.Some(unit.id);
        panel.button(Target.Unit(UnitAction.Disband), if confirming { "CONFIRM?" } else { "DISBAND" }, "DEL", ButtonState.Ready, confirming);
        panel.end_buttons(false);
    }

    pub fn armed(&self, mode: ClickMode) -> bool { self.ui_click_mode == Option.Some(mode) }

    /// A group of selected units: how many of each, how to order them, and buttons for what
    /// every member can do at once.
    pub fn group_tray(&self, panel: &mut PanelBuilder) {
        // Each role and its count, in first-seen order.
        let mut kinds: Vec[str] = Vec.new();
        let mut counts: Vec[i32] = Vec.new();
        for m in 0..self.group.len() {
            let role = self.unit_role(&self.units[self.group[m]]).name();
            let mut found = false;
            for k in 0..kinds.len() {
                if str_eq(kinds[k], role) {
                    counts[k] = counts[k] + 1;
                    found = true;
                }
            }
            if !found {
                kinds.push(role);
                counts.push(1);
            }
        }
        let count = self.group.len();
        panel.text_owned(TextSize.Title, text(fn() can {Out} { show_i64(count as i64); Out.put(" UNITS SELECTED"); }), TEXT);
        panel.text_owned(TextSize.Body, group_summary(&kinds, &counts), DIM_TEXT);
        panel.text(TextSize.Small, "CLICK A HEX: EACH MOVES AS CLOSE TO IT AS IT CAN", LABEL_TEXT);
        panel.text(TextSize.Small, "RIGHT-CLICK A HEX: EVERY UNIT IN RANGE ATTACKS IT", LABEL_TEXT);
        panel.text(TextSize.Small, "SHIFT: QUEUE THE MOVE OR ATTACK FOR LATER TURNS FOR ALL", LABEL_TEXT);
        panel.text(TextSize.Small, "CLICK ONE UNIT TO SELECT JUST IT \u{b7} SHIFT-CLICK ADDS \u{b7} CTRL-CLICK REMOVES", LABEL_TEXT);
        panel.gap(GAP);

        let mut all_guarding = true;
        for m in 0..self.group.len() {
            if !self.units[self.group[m]].guarding { all_guarding = false; }
        }
        panel.begin_buttons();
        panel.button(Target.Unit(UnitAction.Move), "MOVE", "M", ButtonState.Ready, self.armed(ClickMode.Move));
        panel.button(Target.Unit(UnitAction.Attack), "ATTACK", "X \u{b7} RMB", ButtonState.Ready, self.armed(ClickMode.Attack));
        panel.button(Target.Unit(UnitAction.Hold), "HOLD", "SPACE", ButtonState.Ready, false);
        panel.button(Target.Unit(UnitAction.Guard), "GUARD", "G", button_state(all_guarding, false), false);
        let mut any_orders = false;
        for m in 0..self.group.len() { if self.units[self.group[m]].has_orders() { any_orders = true; } }
        panel.button(Target.Unit(UnitAction.ClearOrders), "CLEAR ORDERS", "CTRL-RMB", button_state(false, !any_orders), false);
        panel.end_buttons(false);
    }

    /// The open city: population, stores and income, growth, its queue, and a card for each
    /// unit, the worker and each building it can build.
    pub fn city_tray(&self, i: i32, panel: &mut PanelBuilder) { self.city_tray_rows(i, panel, true); }

    /// The open city's tray, with its queue rows or without (the queue panel shows those).
    pub fn city_tray_rows(&self, i: i32, panel: &mut PanelBuilder, with_queue: bool) {
        let city = &self.cities[i];
        let (food, production) = self.income(i);
        let net_food = food - city.population * 8;
        let (growth_percent, _, growth_label) = self.growth_status(i);
        let (id, population, team, working) = (city.id, city.population, city.team, city.worked.len());
        let (stored_food, stored_production) = (city.food, city.production);
        let slots = self.citizen_slots(i);

        panel.begin_line();
        panel.span_owned(text(fn() can {Out} { Out.put("CITY "); show_u64((id + 1) as u64); }), team.color());
        panel.span_owned(text(fn() can {Out} { Out.put("   POPULATION "); show_i64(population as i64); }), DIM_TEXT);
        panel.end_line(TextSize.Title);
        let net_color = if net_food > 0 { BOOSTED_TEXT } else if net_food < 0 { REDUCED_TEXT } else { TEXT };
        panel.begin_line();
        panel.stat("CITIZENS", text(fn() can {Out} { show_i64(working as i64); Out.put(" OF "); show_i64(slots as i64); Out.put(" WORKING"); }), TEXT);
        panel.end_line(TextSize.Body);
        panel.begin_line();
        panel.stat("FOOD", text(fn() can {Out} { show_quantity(stored_food); }), TEXT);
        panel.span_owned(text(fn() can {Out} { Out.put("   "); show_signed_quantity(net_food); Out.put(" PER TURN"); }), net_color);
        panel.end_line(TextSize.Body);
        panel.begin_line();
        panel.stat("PRODUCTION", text(fn() can {Out} { show_quantity(stored_production); }), TEXT);
        panel.span_owned(text(fn() can {Out} { Out.put("   "); show_signed_quantity(production); Out.put(" PER TURN"); }), DIM_TEXT);
        panel.end_line(TextSize.Body);
        if !city.queue.is_empty() {
            let build = city.queue[0];
            let cost = self.city_build_cost(i, build);
            let spent = if stored_production < cost { stored_production } else { cost };
            panel.text_owned(TextSize.Small, text(fn() can {Out} {
                Out.put(build.name()); Out.put(": "); show_quantity(spent); Out.put(" / "); show_quantity(cost); Out.put(" PRODUCTION");
            }), GOLD_TEXT);
            let fraction = stored_production as f32 / cost as f32;
            panel.bar(if fraction < 0.0 { 0.0 } else if fraction > 1.0 { 1.0 } else { fraction });
        }
        panel.begin_line();
        if city.queue.is_empty() {
            panel.stat("BUILDING", to_owned("NOTHING - CHOOSE BELOW"), DIM_TEXT);
        } else {
            let build = city.queue[0];
            let cost = self.city_build_cost(i, build);
            let spent = if stored_production < cost { stored_production } else { cost };
            panel.stat("BUILDING", text(fn() can {Out} {
                Out.put(build.name()); Out.put(" ("); show_quantity(spent); Out.put(" OF "); show_quantity(cost); Out.put(")");
            }), GOLD_TEXT);
        }
        panel.end_line(TextSize.Body);
        let focus = city.focus;
        panel.text(TextSize.Small, "LABOR FOCUS", LABEL_TEXT);
        panel.begin_buttons();
        for k in 0..3 { panel.button(Target.Focus(FOCUSES[k]), FOCUSES[k].name(), "AUTO", button_state(FOCUSES[k] == focus, false), false); }
        panel.end_buttons(true);

        panel.gap(GAP);
        panel.text_owned(TextSize.Small, growth_label, DIM_TEXT);
        panel.bar(growth_percent as f32 / 100.0);

        if with_queue && city.queue.len() > 0 {
            panel.gap(GAP);
            panel.text(TextSize.Small, "QUEUE", LABEL_TEXT);
            for q in 0..city.queue.len() {
                let build = city.queue[q];
                let label = text(fn() can {Out} { show_i64((q + 1) as i64); Out.put(". "); Out.put(build.name()); });
                panel.begin_buttons();
                panel.button(Target.QueueUp(q), &label, "UP", button_state(false, q == 0), false);
                panel.button(Target.QueueRemove(q), "X", "", ButtonState.Ready, false);
                panel.end_buttons(true);
            }
        }

        panel.gap(GAP);
        let ships = self.city_is_coastal(i) && city.placed_site(Building.Harbor).is_some();
        let front: Option[Build] = if city.queue.is_empty() { Option.None } else { Option.Some(city.queue[0]) };
        panel.begin_buttons();
        for b in 0..6 {
            let build = CITY_UNITS[b];
            if b >= 3 && !ships { continue; }
            let hint = text(fn() can {Out} { Out.put_char(build.shortcut()); Out.put(" \u{b7} "); show_quantity(build.cost()); Out.put(" PROD"); });
            panel.button(Target.Build(build), build.name(), &hint, button_state(front == Option.Some(Build.Unit(build)), false), false);
        }
        let worker_hint = text(fn() can {Out} { Out.put_char(WORKER_SHORTCUT); Out.put(" \u{b7} "); show_quantity(WORKER_COST); Out.put(" PROD"); });
        panel.button(Target.BuildWorker, "WORKER", &worker_hint, button_state(front == Option.Some(Build.Worker), false), false);
        panel.end_buttons(false);
        panel.gap(GAP);
        panel.begin_buttons();
        panel.button(Target.ToggleYields, "YIELDS", "Y", button_state(self.show_yields, false), false);
        panel.button(Target.OpenInterior, "CITY INTERIOR", "V", ButtonState.Ready, false);
        panel.button(Target.WorkerMode, "WORKER JOBS", "W", ButtonState.Ready, false);
        panel.end_buttons(false);
        panel.gap(GAP);
        panel.text(TextSize.Small, "CLICK MANAGER TO MOVE \u{b7} CLICK TILES TO ASSIGN \u{b7} ESC OR SPACE TO EXIT", LABEL_TEXT);

        panel.text(TextSize.Small, "BUILDINGS", LABEL_TEXT);
        let scroll = city.building_scroll;
        panel.begin_buttons();
        for b in 0..15 {
            let building = BUILDINGS[b];
            if city.built.contains(building) || (building.is_naval() && !self.city_is_coastal(i)) { continue; }
            let hint = text(fn() can {Out} {
                if building.shortcut() != ' ' { Out.put_char(building.shortcut()); Out.put(" | "); }
                show_quantity(building.cost()); Out.put(" PROD");
            });
            let needs_site = self.needs_site(i, building);
            let queued = front == Option.Some(Build.Building(building)) || needs_site || self.placing(i, building) && self.selected_city == Option.Some(i);
            let waiting = (city.pending_building == Option.Some(building) || city.queue.contains(Build.Building(building))) && !needs_site;
            panel.button(Target.Building(building), building.name(), &hint, button_state(queued, waiting), false);
        }
        panel.end_catalog(i, scroll);
        if let Option.Some(tile) = city.barracks {
            let active = !city.worked.is_empty() && city.worked[0] == tile;
            panel.gap(GAP);
            panel.text(TextSize.Small, if active { "BARRACKS: MANAGER ACTIVE" } else { "BARRACKS: MOVE MANAGER ONTO BARRACKS" }, if active { BOOSTED_TEXT } else { REDUCED_TEXT });
            panel.begin_buttons();
            panel.button(Target.OpenBarracks, "SEE BARRACKS", "CLICK", ButtonState.Ready, false);
            panel.end_buttons(false);
        }
        for b in 0..14 {
            let building = PLACEABLE[b];
            let Option.Some(site) = city.planned_sites.get(building) else {
                if self.needs_site(i, building) {
                    let how = if self.placing(i, building) { "CLICK AN OPEN TILE ON THE MAP" } else { "CLICK ITS CARD TO CHOOSE ONE" };
                    panel.text_owned(TextSize.Small, text(fn() can {Out} { Out.put(building.name()); Out.put(" NEEDS A SITE"); }), GOLD_TEXT);
                    panel.text(TextSize.Small, how, DIM_TEXT);
                }
                continue;
            };
            let ready = front == Option.Some(Build.Building(building)) && stored_production >= self.city_build_cost(i, Build.Building(building));
            let status = if ready { " READY: SITE (" } else { " PLANNED: SITE (" };
            panel.text_owned(TextSize.Small, text(fn() can {Out} {
                Out.put(building.name()); Out.put(status); show_i64(site.q as i64); Out.put(", "); show_i64(site.r as i64); Out.put(")");
            }), GOLD_TEXT);
            panel.text(TextSize.Small, "CLICK ITS MAP BADGE TO MOVE THE SITE", DIM_TEXT);
            if ready {
                let label = text(fn() can {Out} { Out.put("CONFIRM "); Out.put(building.name()); });
                panel.begin_buttons();
                panel.button(Target.ConfirmBuilding(building), &label, "CLICK", ButtonState.Ready, false);
                panel.end_buttons(false);
            }
        }
    }

    /// City `i`'s interior: the command post's health, the troops on the board, the selected
    /// one, and what to do next.
    pub fn interior_tray(&self, i: i32, panel: &mut PanelBuilder) {
        let city = &self.cities[i];
        let interior = &city.interior;
        let (id, team, core_hp) = (city.id, city.team, interior.core_hp);
        let breached = core_hp <= 0.0;
        panel.text_owned(TextSize.Title, text(fn() can {Out} { Out.put("CITY "); show_u64((id + 1) as u64); Out.put(" INTERIOR"); }), team.color());
        let post = if breached {
            text(fn() can {Out} { Out.put("POST BREACHED  0/"); show_rounded(CORE_HP); Out.put(" HP"); })
        } else {
            text(fn() can {Out} { Out.put("COMMAND POST  "); show_rounded(core_hp); Out.put("/"); show_rounded(CORE_HP); Out.put(" HP"); })
        };
        panel.text_owned(TextSize.Body, post, if breached { REDUCED_TEXT } else { GOLD_TEXT });
        panel.bar(core_hp / CORE_HP);
        if breached {
            panel.text(TextSize.Small, if team == PLAYER_TEAM { "KEEP RED OFF THE CENTER TO PREVENT CAPTURE" } else { "MOVE A BLUE TROOP ONTO THE POST TO CAPTURE" }, BOOSTED_TEXT);
        }
        let mut blue = 0;
        for k in 0..interior.fighters.len() { if interior.fighters[k].team == PLAYER_TEAM { blue = blue + 1; } }
        let red = interior.fighters.len() - blue;
        panel.text_owned(TextSize.Small, text(fn() can {Out} { Out.put("BLUE "); show_i64(blue as i64); Out.put(" / RED "); show_i64(red as i64); Out.put(" TROOPS"); }), DIM_TEXT);
        let selected = match self.interior_selected { Option.Some(source) => interior.index_of(source), Option.None => Option.None };
        match selected {
            Option.Some(k) => {
                let fighter = interior.fighters[k];
                panel.gap(GAP);
                panel.text_owned(TextSize.Body, text(fn() can {Out} { Out.put(Role.Troop(fighter.unit_type).name()); Out.put("  "); show_rounded(fighter.hp); Out.put(" HP"); }), BOOSTED_TEXT);
                panel.text(TextSize.Small, "GREEN: MOVE  RED: ATTACK", LABEL_TEXT);
            }
            Option.None => panel.text(TextSize.Small, "CLICK A BLUE TROOP ON THE MAP", LABEL_TEXT),
        }
        panel.gap(GAP);
        let next = if breached {
            if team == PLAYER_TEAM { "POST OPEN: DEFEND THE CENTER" } else { "POST OPEN: CLICK A BLUE TROOP, THEN THE CENTER" }
        } else {
            "BREACH POST, THEN OCCUPY CENTER"
        };
        panel.text(TextSize.Small, next, GOLD_TEXT);
        panel.begin_buttons();
        panel.button(Target.InteriorClear, "CLEAR ORDERS", "BACKSPACE", button_state(false, self.interior_selected.is_none()), false);
        panel.button(Target.OpenInterior, if team == PLAYER_TEAM { "RETURN TO CITY" } else { "LEAVE INTERIOR" }, "V / ESC", ButtonState.Ready, false);
        panel.end_buttons(true);
    }

    /// City `i`'s workers: how many are home and out, what those out are doing (a button showing
    /// each on the map, and Recall), and the jobs waiting for them (X removes one).
    fn city_workers(&self, i: i32, panel: &mut PanelBuilder) {
        let city = &self.cities[i];
        let (home, out) = (city.workers, self.workers_out(i));
        panel.text_owned(TextSize.Small, text(fn() can {Out} { Out.put("WORKERS: "); show_u64(home as u64); Out.put(" HOME, "); show_i64(out as i64); Out.put(" OUT"); }), LABEL_TEXT);
        for w in 0..self.field_workers.len() {
            let worker = self.field_workers[w];
            if worker.home != i { continue; }
            let doing = match (worker.job, worker.work_left) {
                (Option.Some(job), Option.Some(left)) => {
                    let title = self.job_title(job);
                    text(fn() can {Out} { Out.put(&title); Out.put(" \u{b7} "); show_u64(left as u64); Out.put("T"); })
                }
                (Option.Some(job), Option.None) => {
                    let title = self.job_title(job);
                    text(fn() can {Out} { Out.put("TO "); Out.put(&title); })
                }
                (Option.None, _) => to_owned(if worker.recalled { "RECALLED, WALKING HOME" } else { "WALKING HOME" }),
            };
            panel.begin_buttons();
            panel.button(Target.ShowWorker(worker.id), &doing, "", ButtonState.Ready, false);
            if !worker.recalled { panel.button(Target.RecallWorker(worker.id), "RECALL", "", ButtonState.Ready, false); }
            panel.end_buttons(true);
        }
        if city.worker_jobs.is_empty() { return; }
        panel.text(TextSize.Small, "WORKER JOBS", LABEL_TEXT);
        for j in 0..city.worker_jobs.len() {
            let job = city.worker_jobs[j];
            let title = self.job_title(job);
            let label = text(fn() can {Out} { Out.put(&title); Out.put(" \u{b7} "); show_u64(job.kind.turns() as u64); Out.put("T"); });
            panel.begin_buttons();
            panel.button(Target.WorkerJobRemove(j), &label, "X", ButtonState.Ready, false);
            panel.end_buttons(true);
        }
    }

    /// The worker menu (W): the only way to give workers orders. Its job buttons arm a job to
    /// place on the map; it lists a city's workers (with Recall) and waiting jobs (X removes
    /// one), with a button per city when there are several; Sleep rests that city's idle
    /// workers this turn, and Done closes it.
    pub fn worker_menu(&self, panel: &mut PanelBuilder) {
        panel.text(TextSize.Title, "WORKERS", TEXT);
        let how = match self.placing_job {
            Option.Some(kind) => {
                let place = if kind.on_edge() { "S: CLICK OR DRAG ALONG HEX EDGES \u{b7} ESC TO STOP" } else { "S: CLICK OR DRAG OVER LIT TILES \u{b7} ESC TO STOP" };
                text(fn() can {Out} { Out.put("PLACING "); Out.put(kind.name()); Out.put(place); })
            }
            Option.None => to_owned("PICK A JOB, THEN PLACE IT ON THE MAP."),
        };
        panel.text_owned(TextSize.Small, how, LABEL_TEXT);
        panel.text(TextSize.Small, "LIT: WHERE WORKERS REACH, 3 TILES FROM A CITY OR WORK CAMP, OR NEXT TO A ROAD", DIM_TEXT);
        for row in 0..2 {
            panel.begin_buttons();
            for k in 0..3 {
                let kind = JOB_KINDS[row * 3 + k];
                let key = match kind { JobKind.Road => "R \u{b7} ", JobKind.Improve => "I \u{b7} ", _ => "" };
                let hint = text(fn() can {Out} { Out.put(key); show_u64(kind.turns() as u64); Out.put("T"); });
                panel.button(Target.WorkerJob(kind), kind.name(), &hint, ButtonState.Ready, self.placing_job == Option.Some(kind));
            }
            panel.end_buttons(true);
        }
        let mut cities: Vec[i32] = Vec.new();
        for i in 0..self.cities.len() { if self.cities[i].team == PLAYER_TEAM { cities.push(i); } }
        if cities.len() > 1 {
            panel.gap(GAP);
            panel.begin_buttons();
            for k in 0..cities.len() {
                let i = cities[k];
                let (id, idle) = (self.cities[i].id, self.idle_workers(i));
                let label = text(fn() can {Out} { Out.put("CITY "); show_u64((id + 1) as u64); });
                let hint = if idle == 0 { to_owned("") } else { text(fn() can {Out} { show_u64(idle as u64); Out.put(" IDLE"); }) };
                panel.button(Target.WorkerCity(i), &label, &hint, button_state(self.worker_menu_city == Option.Some(i), false), false);
            }
            panel.end_buttons(true);
        }
        if let Option.Some(city) = self.worker_menu_city {
            panel.gap(GAP);
            self.city_workers(city, panel);
        }
        panel.gap(GAP);
        let idle = match self.worker_menu_city { Option.Some(i) => self.idle_workers(i), Option.None => 0 };
        panel.begin_buttons();
        panel.button(Target.SleepWorkers, "SLEEP", "SPACE", button_state(false, idle == 0), false);
        panel.button(Target.WorkerMode, "DONE", "W", ButtonState.Ready, false);
        panel.end_buttons(true);
    }

    /// The open Barracks: its health, its work group's production, what it's training, its
    /// queue, and a card for each troop.
    pub fn barracks_tray(&self, i: i32, panel: &mut PanelBuilder) { self.barracks_tray_rows(i, panel, true); }

    /// The open Barracks' tray, with its queue rows or without.
    pub fn barracks_tray_rows(&self, i: i32, panel: &mut PanelBuilder, with_queue: bool) {
        let city = &self.cities[i];
        let Option.Some(tile) = city.barracks else { return; };
        let active = !city.worked.is_empty() && city.worked[0] == tile;
        let barracks_production = if active { self.barracks_income(i) } else { 0 };
        let (id, team, hp) = (city.id, city.team, city.barracks_hp);
        panel.text_owned(TextSize.Title, text(fn() can {Out} { Out.put("CITY "); show_u64((id + 1) as u64); Out.put(" BARRACKS"); }), team.color());
        panel.begin_line();
        panel.stat("HP", text(fn() can {Out} { show_rounded(hp); Out.put("/"); show_rounded(BARRACKS_MAX_HP); }), GOLD_TEXT);
        panel.end_line(TextSize.Body);
        panel.text_owned(TextSize.Small, text(fn() can {Out} {
            Out.put(if active { "MANAGER ACTIVE" } else { "NEEDS MANAGER" }); Out.put(" \u{b7} "); show_signed_quantity(barracks_production); Out.put(" PROD/T");
        }), if active { BOOSTED_TEXT } else { REDUCED_TEXT });
        if !city.barracks_queue.is_empty() {
            let build = city.barracks_queue[0];
            let stored = city.barracks_production;
            let spent = if stored < build.cost() { stored } else { build.cost() };
            panel.text_owned(TextSize.Small, text(fn() can {Out} {
                Out.put("TRAINING "); Out.put(build.name()); Out.put(": "); show_quantity(spent); Out.put(" / "); show_quantity(build.cost()); Out.put(" PROD");
            }), GOLD_TEXT);
            let fraction = stored as f32 / build.cost() as f32;
            panel.bar(if fraction < 0.0 { 0.0 } else if fraction > 1.0 { 1.0 } else { fraction });
            for q in 0..(if with_queue { city.barracks_queue.len() } else { 0 }) {
                let queued = city.barracks_queue[q];
                let label = text(fn() can {Out} { show_i64((q + 1) as i64); Out.put(". "); Out.put(queued.name()); });
                panel.begin_buttons();
                panel.button(Target.BarracksQueueRemove(q), &label, "X", ButtonState.Ready, false);
                panel.end_buttons(true);
            }
        }
        panel.gap(GAP);
        let front: Option[BuildUnit] = if city.barracks_queue.is_empty() { Option.None } else { Option.Some(city.barracks_queue[0]) };
        panel.begin_buttons();
        for b in 0..5 {
            let build = BARRACKS_UNITS[b];
            let label = text(fn() can {Out} { Out.put("TRAIN "); Out.put(build.name()); });
            let hint = text(fn() can {Out} {
                match build.required_resource() {
                    Option.Some(resource) => { Out.put(resource.name()); Out.put(" \u{b7} "); show_quantity(build.cost()); }
                    Option.None => { show_quantity(build.cost()); Out.put(" PROD"); }
                }
            });
            panel.button(Target.BarracksBuild(build), &label, &hint, button_state(front == Option.Some(build), !self.barracks_can_train(i, build)), false);
        }
        panel.end_buttons(false);
        panel.begin_buttons();
        panel.button(Target.OpenCity, "OPEN CITY", "CLICK", ButtonState.Ready, false);
        panel.end_buttons(false);
    }

    /// Everything about a map hex: terrain, what it yields, and what's on it.
    pub fn tile_tooltip(&self, hex: Hex, panel: &mut PanelBuilder) {
        let tile = self.grid.tile(hex);
        let terrain = tile.terrain;
        let city = self.city_at(hex);
        match city {
            Option.Some(c) => {
                let (team, id) = (self.cities[c].team, self.cities[c].id);
                panel.text_owned(TextSize.Body, text(fn() can {Out} { Out.put(team.name()); Out.put(" CITY "); show_u64((id + 1) as u64); }), team.color());
            }
            Option.None => panel.text_owned(TextSize.Body, tile.name(), TEXT),
        }
        if !terrain.is_passable() {
            panel.text(TextSize.Small, "IMPASSABLE", DIM_TEXT);
            return;
        }
        let (food, production) = self.raw_yield(hex);
        panel.begin_line();
        panel.stat("FOOD", text(fn() can {Out} { show_i64(food as i64); }), BOOSTED_TEXT);
        panel.stat("PRODUCTION", text(fn() can {Out} { show_i64(production as i64); }), GOLD_TEXT);
        panel.end_line(TextSize.Small);

        if city.is_some() {
            panel.text_owned(TextSize.Small, text(fn() can {Out} { Out.put(terrain.name()); Out.put(" CITY CENTER"); }), DIM_TEXT);
        }
        if tile.defense_multiplier() != 1.0 {
            let bonus = (tile.defense_multiplier() - 1.0) * 100.0;
            panel.text_owned(TextSize.Small, text(fn() can {Out} { Out.put("+"); show_rounded(bonus); Out.put("% DEFENSE FOR UNITS HERE"); }), DIM_TEXT);
        }
        if let Option.Some(resource) = self.grid.resource(hex) {
            panel.text_owned(TextSize.Small, text(fn() can {Out} { Out.put(resource.name()); Out.put(" RESOURCE"); }), DIM_TEXT);
        }
        if let Option.Some(special) = self.grid.special(hex) {
            let (food, production) = special.bonus();
            panel.text_owned(TextSize.Small, text(fn() can {Out} {
                Out.put(special.name());
                Out.put(":");
                if food > 0 { Out.put(" +"); show_i64(food as i64); Out.put(" FOOD"); }
                if production > 0 { Out.put(" +"); show_i64(production as i64); Out.put(" PRODUCTION"); }
                Out.put(" WHEN WORKED");
            }), DIM_TEXT);
        }
        if let Option.Some(site) = self.sites.get(hex) {
            panel.text_owned(TextSize.Small, text(fn() can {Out} { Out.put(site.team.name()); Out.put(" "); Out.put(site.kind.name()); }), DIM_TEXT);
        }
        if self.roads.contains(hex) { panel.text(TextSize.Small, "DIRT ROAD: GOODS MOVE THROUGH MORE CHEAPLY", DIM_TEXT); }
        for c in 0..self.cities.len() {
            if self.cities[c].worked.contains(hex) {
                let id = self.cities[c].id;
                panel.text_owned(TextSize.Small, text(fn() can {Out} { Out.put("WORKED BY CITY "); show_u64((id + 1) as u64); }), DIM_TEXT);
                break;
            }
        }
        if let Option.Some(open) = self.selected_city {
            if self.cities[open].pos != hex {
                let id = self.cities[open].id;
                let fog = self.fog();
                let note = match self.known_routes(open, &fog).costs.get(hex) {
                    Option.Some(cost) => text(fn() can {Out} { show_i64((delivered_share(cost) * 25) as i64); Out.put("% REACHES CITY "); show_u64((id + 1) as u64); }),
                    Option.None => text(fn() can {Out} { Out.put("OUT OF CITY "); show_u64((id + 1) as u64); Out.put("'S REACH"); }),
                };
                panel.text_owned(TextSize.Small, note, DIM_TEXT);
            }
        }
        let mut here: Vec[i32] = Vec.new();
        for i in 0..self.units.len() {
            if self.units[i].pos == hex { here.push(i); }
        }
        if !here.is_empty() {
            let names = text(fn() can {Out} {
                for k in 0..here.len() {
                    let unit = &self.units[here[k]];
                    let role = self.unit_role(unit).name();
                    if k > 0 { Out.put(", "); }
                    Out.put(unit.team.name());
                    Out.put(" ");
                    Out.put(role);
                }
            });
            panel.text_owned(TextSize.Small, names, DIM_TEXT);
        }
        if self.is_contested(hex) { panel.text(TextSize.Small, "CONTESTED", DIM_TEXT); }
    }

    /// The tile tooltip, just below and right of the cursor (`point`, in UI pixels), kept inside
    /// the window.
    fn draw_tile_tooltip(&self, hex: Hex, point: Vec2, screen_size: Vec2, out: &mut Vec[MeshVertex]) {
        let mut panel = panel_builder(false);
        self.tile_tooltip(hex, &mut panel);
        let size = panel.size();
        let at = point.add(vec2(TILE_TOOLTIP_OFFSET_X, TILE_TOOLTIP_OFFSET_Y));
        let right_most = screen_size.x - MARGIN - size.x;
        let low_most = MARGIN + size.y;
        let top_left = vec2(if at.x < right_most { at.x } else { right_most }, if at.y > low_most { at.y } else { low_most });
        let mut layout = empty_layout();
        panel.place_top_left(top_left, &mut layout);
        layout.draw_shapes(out);
    }

    /// A panel explaining what `button` does, above it (or below, for the top bar), kept inside
    /// the window.
    fn draw_tooltip(&self, button: &Button, layout: &UiLayout, screen_size: Vec2, out: &mut Vec[MeshVertex]) {
        let mut panel = panel_builder(false);
        if !self.tooltip(button.target, &mut panel) { return; }
        let size = panel.size();
        let centered = (button.min.x + button.max.x - size.x) / 2.0;
        let right_most = screen_size.x - MARGIN - size.x;
        let hi = if right_most > MARGIN { right_most } else { MARGIN };
        let left = if centered < MARGIN { MARGIN } else if centered > hi { hi } else { centered };
        // Clear of the panel the button sits in, so the tooltip doesn't hide what the panel
        // says: below panels at the top of the window (the top bar, the debug panel), above
        // those at the bottom (the tray).
        let center = button.min.add(button.max).scale(0.5);
        let mut holder = Rect { min: button.min, max: button.max };
        for i in 0..layout.panels.len() {
            let r = layout.panels[i];
            if contains(r.min, r.max, center) {
                holder = r;
                break;
            }
        }
        let near_top = (holder.min.y + holder.max.y) / 2.0 > screen_size.y / 2.0;
        let bottom = if near_top { holder.min.y - TOOLTIP_GAP - 2.0 * BORDER - size.y } else { holder.max.y + TOOLTIP_GAP + 2.0 * BORDER };
        let mut tip = empty_layout();
        panel.place_bottom_left(vec2(left, bottom), &mut tip);
        tip.draw_shapes(out);
    }

    /// A tooltip's title (with the shortcut), description, and why the button is unavailable,
    /// if it is, into `panel`. Answers whether there is one.
    pub fn tooltip(&self, target: Target, panel: &mut PanelBuilder) -> bool {
        let mut title = to_owned("");
        let mut shortcut = to_owned("");
        let mut description = to_owned("");
        let mut unavailable: Option[Str] = Option.None;
        match target {
            Target.Unit(action) => {
                // A group's buttons are described for its first member.
                let idx = match self.selected {
                    Option.Some(i) => i,
                    Option.None => { if self.group.is_empty() { return false; } self.group[0] }
                };
                self.unit_action_text(action, idx, &mut title, &mut shortcut, &mut description, &mut unavailable);
            }
            Target.Build(build) => {
                title = to_owned(build.name());
                shortcut = text(fn() can {Out} { Out.put_char(build.shortcut()); });
                description = text(fn() can {Out} {
                    Out.put(build.description()); Out.put(". COSTS "); show_quantity(build.cost());
                    Out.put(" PRODUCTION; THE CITY SPENDS ITS STORED PRODUCTION AND PLACES THE UNIT NEXT TO ITSELF ONCE THERE'S ENOUGH.");
                });
            }
            Target.Building(building) => {
                title = to_owned(building.name());
                shortcut = if building.shortcut() == ' ' { to_owned("CITY BUILD MENU") } else { text(fn() can {Out} { Out.put_char(building.shortcut()); }) };
                description = text(fn() can {Out} { Out.put(building.description()); Out.put(" COSTS "); show_quantity(building.cost()); Out.put(" PRODUCTION. ONE PER CITY."); });
            }
            Target.BarracksBuild(build) => {
                title = text(fn() can {Out} { Out.put("TRAIN "); Out.put(build.name()); });
                shortcut = to_owned("BARRACKS");
                description = text(fn() can {Out} { Out.put(build.description()); Out.put(" COSTS "); show_quantity(build.cost()); Out.put(" PRODUCTION FROM THE ACTIVE MANAGER'S WORK GROUP."); });
            }
            Target.OpenBarracks => {
                title = to_owned("SEE BARRACKS");
                shortcut = to_owned("CLICK");
                description = to_owned("OPENS THE BARRACKS' OWN TRAINING AND QUEUE PANEL.");
            }
            Target.OpenCity => {
                title = to_owned("OPEN CITY");
                shortcut = to_owned("CLICK");
                description = to_owned("RETURNS TO THIS CITY'S LABOR AND MAIN PRODUCTION PANEL.");
            }
            Target.BuildWorker => {
                title = to_owned("WORKER");
                shortcut = text(fn() can {Out} { Out.put_char(WORKER_SHORTCUT); });
                description = text(fn() can {Out} { Out.put("JOINS THE CITY'S WORKERS, WHO GO OUT TO BUILD WHAT YOU ORDER FROM A TILE. "); show_quantity(WORKER_COST); Out.put(" PRODUCTION."); });
            }
            Target.ConfirmBuilding(building) => {
                title = text(fn() can {Out} { Out.put("CONFIRM "); Out.put(building.name()); });
                shortcut = to_owned("CLICK");
                description = to_owned("FINALIZES THE SELECTED BUILDING SITE.");
            }
            Target.QueueUp(_) | Target.QueueRemove(_) | Target.BarracksQueueRemove(_) | Target.QueueItem(_, _)
                | Target.RosterSelect(_) | Target.RosterAdd(_) | Target.RosterRemove(_) => { return false; }
            Target.OpenInterior => {
                title = to_owned("CITY INTERIOR");
                shortcut = to_owned("V");
                description = to_owned("ENTER THE CITY'S TACTICAL MAP. YOU CAN ALSO CLICK ITS CENTER HEX FROM CITY VIEW.");
            }
            Target.InteriorClear => {
                title = to_owned("CLEAR INTERIOR ORDERS");
                shortcut = to_owned("BACKSPACE");
                description = to_owned("DROPS THE SELECTED INTERIOR TROOP'S MOVE AND ATTACK.");
            }
            Target.WorkerJobRemove(_) => {
                title = to_owned("REMOVE");
                shortcut = to_owned("CLICK");
                description = to_owned("TAKES THIS JOB OFF THE CITY'S WORKER LIST.");
            }
            Target.ShowWorker(_) => {
                title = to_owned("WORKER");
                shortcut = to_owned("CLICK");
                description = to_owned("SHOW THIS WORKER ON THE MAP.");
            }
            Target.RecallWorker(_) => {
                title = to_owned("RECALL");
                shortcut = to_owned("CLICK");
                description = to_owned("THE WORKER HEADS STRAIGHT HOME, 1 TILE A TURN, WHERE IT'S SAFE. ITS JOB GOES BACK ON TOP OF THE CITY'S LIST.");
            }
            Target.WorkerJob(kind) => {
                title = to_owned(kind.name());
                shortcut = to_owned(match kind { JobKind.Road => "R", JobKind.Improve => "I", _ => "CLICK" });
                let turns = kind.turns();
                description = text(fn() can {Out} {
                    Out.put(kind.description()); Out.put(" "); show_u64(turns as u64); Out.put(if turns == 1 { " TURN" } else { " TURNS" }); Out.put(" OF WORK ONCE A WORKER GETS THERE.");
                });
            }
            Target.WorkerMode => {
                title = to_owned("WORKERS");
                shortcut = to_owned("W");
                description = to_owned("THE WORKER MENU: PICK A JOB, THEN PLACE IT ON THE MAP WHERE YOUR WORKERS REACH.");
            }
            Target.WorkerCity(city) => {
                let id = if city >= 0 && city < self.cities.len() { self.cities[city].id + 1 } else { 0 };
                title = text(fn() can {Out} { Out.put("CITY "); show_u64(id as u64); });
                description = to_owned("LIST THIS CITY'S WORKERS AND JOBS.");
            }
            Target.SleepWorkers => {
                title = to_owned("SLEEP");
                shortcut = to_owned("SPACE");
                description = to_owned("THIS CITY'S IDLE WORKERS REST THIS TURN, AND THE TURN MOVES ON.");
            }
            Target.Scenario(scenario) => {
                title = text(fn() can {Out} { Out.put(scenario.name()); Out.put(" SCENARIO"); });
                shortcut = to_owned(scenario.key());
                let what = match scenario {
                    Scenario.Combat => "THE ORIGINAL SMALL COMBAT MAP: FOUR UNITS A SIDE ACROSS A MOUNTAIN PASS.",
                    Scenario.Cities => "TWO CITIES WITH FARMS, MINES, ROADS AND ARMIES, TO TEST THE ECONOMY AND FIGHTING OVER IT.",
                    Scenario.Frontier => "A SETTLER AND A WARRIOR EACH AND NO CITIES YET. BOTH WARRIORS ARE YOURS TO MOVE.",
                    Scenario.World => "A NEW RANDOM MAP WITH THE PLAYER AND 4 TO 6 AI SIDES, EACH WITH A CITY AND A SCOUT, AND RUINS BETWEEN THEM.",
                    Scenario.Siege => "OPPOSING FIELD TROOPS ALREADY FIGHT INSIDE A CITY.",
                    Scenario.Naval => "A STRAIT BETWEEN TWO COASTAL CITIES, EACH SIDE WITH A TROOP ASHORE, A LANDING CRAFT, A PATROL GALLEY AND A BOMBARD SHIP.",
                };
                description = text(fn() can {Out} { Out.put(what); Out.put(" STARTS IT FRESH, OR RESTARTS IT IF IT'S THE CURRENT ONE; THE SAVESTATE IS KEPT."); });
            }
            Target.SaveState => {
                title = to_owned("SAVE");
                shortcut = to_owned("F6");
                description = to_owned("SAVES A SNAPSHOT OF THE WHOLE GAME (UNIT POSITIONS, HEALTH, ORDERS, CITIES, TURN) FOR TESTING, REPLACING ANY EARLIER ONE. IT'S KEPT ONLY UNTIL THE GAME CLOSES.");
                if self.is_resolving() { unavailable = Option.Some(to_owned("CAN'T SAVE WHILE A TURN PLAYS OUT")); }
            }
            Target.LoadState => {
                title = to_owned("LOAD");
                shortcut = to_owned("F7");
                description = if self.savestate.is_some() {
                    text(fn() can {Out} { Out.put("RESTORES THE SNAPSHOT ("); self.show_saved(); Out.put("). IT'S KEPT, SO YOU CAN LOAD IT AGAIN TO RETRY."); })
                } else {
                    to_owned("RESTORES THE SNAPSHOT SAVED WITH F6.")
                };
                if self.savestate.is_none() { unavailable = Option.Some(to_owned("NOTHING SAVED YET")); }
            }
            Target.SetSetting(setting, _) => {
                title = to_owned(setting.name());
                description = to_owned(setting.description());
            }
            Target.Focus(focus) => {
                title = text(fn() can {Out} { Out.put(focus.name()); Out.put(" FOCUS"); });
                description = to_owned(match focus {
                    LaborFocus.Food => "CITIZENS WORK THE TILES THAT FEED THE CITY MOST.",
                    LaborFocus.Production => "CITIZENS WORK THE TILES THAT BUILD FASTEST.",
                    LaborFocus.Balanced => "CITIZENS WORK FOR FOOD WHILE THE CITY IS SHORT OF IT, AND FOR PRODUCTION AFTER.",
                });
            }
            Target.CloseSettings => {
                title = to_owned("CLOSE");
                shortcut = to_owned("ESC");
                description = to_owned("CLOSES THE SETTINGS. THEY'RE KEPT FOR THE NEXT TIME THE GAME STARTS.");
            }
            Target.Quit => {
                title = to_owned("QUIT");
                description = to_owned("CLOSES THE GAME.");
            }
            Target.CompleteProduction => {
                title = to_owned("COMPLETE PRODUCTION");
                shortcut = to_owned("F9");
                description = to_owned("INSTANTLY FINISHES THE CURRENT CITY BUILD OR BARRACKS UNIT FOR TESTING.");
            }
            Target.ToggleFog => {
                title = to_owned("FOG OF WAR");
                shortcut = to_owned("F10");
            }
            Target.TogglePlayback => {
                title = to_owned("PLAYBACK");
                shortcut = to_owned("F8");
                description = to_owned("SWITCHES HOW A TURN PLAYS OUT: ONE STEP AT A TIME IN THE RESOLUTION ORDER, OR EVERY STEP AT ONCE. THE STEPS STILL RESOLVE IN THE SAME ORDER EITHER WAY, SO THE OUTCOME IS THE SAME; ONLY THE PACING CHANGES.");
            }
            Target.ToggleYields => {
                title = to_owned("YIELDS");
                shortcut = to_owned("Y");
                description = to_owned("SHOWS THE FOOD AND PRODUCTION OF EACH TILE WITHIN THIS CITY'S REACH, AND WHAT SHARE OF IT MAKES IT BACK TO THE CITY.");
            }
            Target.EndTurn => {
                title = to_owned("END TURN");
                shortcut = to_owned("SPACE");
                description = to_owned("RESOLVES EVERYONE'S ORDERS AND COLLECTS CITY INCOME. FIRST EVERY UNIT NEEDS ORDERS (SPACE HOLDS ONE AS IT IS, G GUARDS IT FOR GOOD) AND EVERY CITY NEEDS SOMETHING TO BUILD. CITIZENS CAN BE MOVED AT ANY TIME.");
                let (units, cities, workers) = self.pending();
                if units + cities + workers > 0 { unavailable = Option.Some(text(fn() can {Out} { show_pending(units, cities, workers); Out.put(": CLICKING SELECTS ONE"); })); }
            }
        }
        panel.begin_line();
        panel.span_owned(title, TEXT);
        panel.span_owned(spaced(&shortcut), LABEL_TEXT);
        panel.end_line(TextSize.Body);
        let lines = wrap(&description, TOOLTIP_WRAP);
        for i in 0..lines.len() {
            let line = &lines[i];
            panel.text(TextSize.Small, line, DIM_TEXT);
        }
        if let Option.Some(reason) = unavailable { panel.text_owned(TextSize.Small, reason, REDUCED_TEXT); }
        true
    }

    fn unit_action_text(&self, action: UnitAction, idx: i32, title: &mut Str, shortcut: &mut Str, description: &mut Str, unavailable: &mut Option[Str]) {
        let unit = &self.units[idx];
        let can_move = unit.stats().move_range > 0;
        let locked = self.rival_of(idx).is_some();
        match action {
            UnitAction.Move => {
                *title = to_owned("MOVE");
                *shortcut = to_owned("M OR CLICK");
                *description = to_owned("NEXT CLICK ON A GREEN HEX MOVES THERE. CLICK IT AGAIN TO CANCEL. SHIFT-CLICK QUEUES A MOVE FOR ONE MORE TURN.");
                if !can_move { *unavailable = Option.Some(to_owned("CANNOT MOVE THIS TURN")); }
            }
            UnitAction.Attack => {
                *title = to_owned("ATTACK");
                *shortcut = to_owned("X OR RIGHT-CLICK");
                *description = to_owned("NEXT CLICK ATTACKS A HEX IN RANGE, HITTING WHOEVER IS THERE WHEN IT LANDS. RANGE COUNTS FROM WHERE THE UNIT ENDS ITS MOVE. SHIFT-RIGHT-CLICK QUEUES AN ATTACK FOR A LATER TURN.");
                if locked {
                    *unavailable = Option.Some(to_owned("LOCKED IN A CONTESTED HEX"));
                } else if !unit.can_attack() {
                    *unavailable = Option.Some(to_owned("BUSY WITH ITS ABILITY THIS TURN"));
                }
            }
            UnitAction.Swap => {
                *title = to_owned("SWAP");
                *shortcut = to_owned("CTRL-CLICK");
                *description = to_owned("THE NEXT CLICK ON AN ADJACENT ALLY SWAPS PLACES WITH IT. BOTH UNITS MUST BE ABLE TO MOVE.");
                if locked {
                    *unavailable = Option.Some(to_owned("LOCKED IN A CONTESTED HEX"));
                } else if !can_move {
                    *unavailable = Option.Some(to_owned("CANNOT MOVE THIS TURN"));
                }
            }
            UnitAction.Ability => {
                let (name, what) = ability_text(unit);
                let cooldown = unit.ability().cooldown();
                *title = to_owned(name);
                *shortcut = to_owned("Q");
                *description = text(fn() can {Out} {
                    Out.put(what);
                    Out.put(".");
                    if cooldown > 0 { Out.put(" COOLDOWN: "); show_turns(cooldown); Out.put("."); }
                });
                let remaining = unit.ability_cooldown;
                if remaining > 0 { *unavailable = Option.Some(text(fn() can {Out} { Out.put("READY IN "); show_turns(remaining); })); }
            }
            UnitAction.Hold => {
                *title = to_owned("HOLD");
                *shortcut = to_owned("SPACE");
                *description = to_owned("KEEP ANY ORDERS ALREADY QUEUED AND SKIP THE REST OF THIS UNIT'S TURN. ONCE NOTHING NEEDS ORDERS, SPACE ENDS THE TURN. CTRL-RIGHT-CLICK CLEARS ITS ORDERS AND THE HOLD.");
            }
            UnitAction.Guard => {
                *title = to_owned("GUARD");
                *shortcut = to_owned("G");
                *description = to_owned("THE UNIT STAYS WHERE IT IS AND IS SKIPPED EVERY TURN, NOT JUST THIS ONE, UNTIL YOU GIVE IT AN ORDER OR PRESS G AGAIN.");
            }
            UnitAction.Settle => {
                *title = to_owned("FOUND CITY");
                *shortcut = to_owned("F");
                *description = to_owned("TURNS THIS SETTLER INTO A CITY ON ITS HEX. CITIES MUST BE SPACED APART.");
            }
            UnitAction.ClearOrders => {
                *title = to_owned("CLEAR ORDERS");
                *shortcut = to_owned("CTRL-RIGHT-CLICK");
                *description = to_owned("DROPS EVERY SELECTED UNIT'S ORDERS: MOVES, ATTACKS, QUEUED TURNS, HOLD AND GUARD.");
            }
            UnitAction.Disband => {
                *title = to_owned("DISBAND");
                *shortcut = to_owned("DEL");
                *description = to_owned("REMOVES THIS UNIT FOR GOOD. PRESS TWICE: THE FIRST PRESS ASKS TO CONFIRM.");
            }
        }
    }

    /// The unit drawn under `cursor` (window pixels, origin top-left). In a contested hex,
    /// whichever of the two is nearer the cursor.
    pub fn unit_at_screen(&self, cursor: Vec2, screen_size: Vec2) -> Option[i32] {
        let Option.Some(hex) = self.hex_at_screen(cursor, screen_size) else { return Option.None; };
        let point = self.camera.screen_to_world(cursor, screen_size);
        let mut best: Option[i32] = Option.None;
        let mut best_distance: f32 = 0.0;
        for i in 0..self.units.len() {
            if self.units[i].pos != hex { continue; }
            let d = self.unit_layout(i).0.distance(point);
            if best.is_none() || d < best_distance {
                best = Option.Some(i);
                best_distance = d;
            }
        }
        best
    }
}

/// A button before it's placed.
pub struct ButtonSpec { target: Target, label: Str, hint: Str, state: ButtonState, armed: bool }

/// What a panel row holds.
pub enum RowKind {
    /// Spans `from..to` of the builder's.
    Text,
    Gap,
    Bar,
    /// Buttons `from..to` of equal width, a label over a hint.
    Buttons,
    /// Buttons `from..to` of equal width, one line each, label then hint.
    CompactButtons,
    /// City `value`'s building catalog: buttons `from..to` stacked one per line, at most
    /// `BUILDING_LIST_VISIBLE` of them in view from `offset`.
    Catalog,
    /// A heading over the rows after it: span `from`.
    Heading,
    /// Setting row `from` of the builder's.
    Setting,
    /// Queue row `from` of the builder's.
    QueueItem,
    /// Chips `from..to` of the builder's, in one row.
    Roster,
}

/// Building cards in view at once in the city tray's catalog; the wheel scrolls the rest.
const BUILDING_LIST_VISIBLE: i32 = 2;
/// A catalog card's height and the space around it.
const CATALOG_ROW: f32 = 30.0;
const CATALOG_INSET: f32 = 4.0;

/// Where a city's building catalog lies on screen, for the wheel to scroll it.
pub struct CatalogRegion { city: i32, min: Vec2, max: Vec2, max_offset: i32 }

pub struct Row { kind: RowKind, size: TextSize, value: f32, from: i32, to: i32, offset: i32 }

/// Stacks rows top to bottom in a panel sized to fit them.
pub struct PanelBuilder {
    rows: Vec[Row],
    spans: Vec[Span],
    specs: Vec[ButtonSpec],
    settings: Vec[SettingRow],
    queue_items: Vec[QueueItemSpec],
    chips: Vec[RosterChip],
    /// Where the spans of the line in progress start.
    line_from: i32,
    /// Where the buttons of the row in progress start.
    buttons_from: i32,
    /// See-through, for the debug panel.
    faded: bool,
}

pub fn panel_builder(faded: bool) -> PanelBuilder {
    PanelBuilder { rows: Vec.new(), spans: Vec.new(), specs: Vec.new(), settings: Vec.new(), queue_items: Vec.new(), chips: Vec.new(), line_from: 0, buttons_from: 0, faded }
}

impl PanelBuilder {
    /// A line of one span.
    pub fn text(&mut self, size: TextSize, t: &str, color: Color) {
        self.begin_line();
        self.span(t, color);
        self.end_line(size);
    }

    pub fn text_owned(&mut self, size: TextSize, t: Str, color: Color) {
        self.begin_line();
        self.span_owned(t, color);
        self.end_line(size);
    }

    pub fn begin_line(&mut self) { self.line_from = self.spans.len(); }

    pub fn span(&mut self, t: &str, color: Color) { self.spans.push(Span { text: to_owned(t), color }); }

    pub fn span_owned(&mut self, t: Str, color: Color) { self.spans.push(Span { text: t, color }); }

    /// A "LABEL value" pair on the line in progress: the label dim, the value in its own
    /// colour, three spaces before every pair but the first.
    pub fn stat(&mut self, label: str, value: Str, color: Color) {
        let first = self.spans.len() == self.line_from;
        self.span_owned(text(fn() can {Out} { if !first { Out.put("   "); } Out.put(label); Out.put(" "); }), LABEL_TEXT);
        self.span_owned(value, color);
    }

    pub fn end_line(&mut self, size: TextSize) {
        let to = self.spans.len();
        self.rows.push(Row { kind: RowKind.Text, size, value: 0.0, from: self.line_from, to, offset: 0 });
    }

    pub fn gap(&mut self, height: f32) { self.rows.push(Row { kind: RowKind.Gap, size: TextSize.Small, value: height, from: 0, to: 0, offset: 0 }); }

    /// A progress bar across the panel, `fraction` full.
    pub fn bar(&mut self, fraction: f32) { self.rows.push(Row { kind: RowKind.Bar, size: TextSize.Small, value: fraction, from: 0, to: 0, offset: 0 }); }

    pub fn begin_buttons(&mut self) { self.buttons_from = self.specs.len(); }

    pub fn button(&mut self, target: Target, label: &str, hint: &str, state: ButtonState, armed: bool) {
        self.specs.push(ButtonSpec { target, label: to_owned(label), hint: to_owned(hint), state, armed });
    }

    /// Ends a row of equally wide buttons; `compact` ones are one line each.
    pub fn end_buttons(&mut self, compact: bool) {
        let kind = if compact { RowKind.CompactButtons } else { RowKind.Buttons };
        let to = self.specs.len();
        self.rows.push(Row { kind, size: TextSize.Small, value: 0.0, from: self.buttons_from, to, offset: 0 });
    }

    /// A heading over the rows that follow.
    pub fn heading(&mut self, t: &str) {
        let from = self.spans.len();
        self.spans.push(Span { text: to_owned(t), color: GOLD_TEXT });
        self.rows.push(Row { kind: RowKind.Heading, size: TextSize.Small, value: 0.0, from, to: from + 1, offset: 0 });
    }

    /// A player setting's label and control, showing `value`.
    pub fn setting(&mut self, setting: Setting, value: i32) {
        let from = self.settings.len();
        self.settings.push(SettingRow { setting, value });
        self.rows.push(Row { kind: RowKind.Setting, size: TextSize.Body, value: 0.0, from, to: from + 1, offset: 0 });
    }

    pub fn queue_item(&mut self, item: QueueItemSpec) {
        let from = self.queue_items.len();
        self.queue_items.push(item);
        self.rows.push(Row { kind: RowKind.QueueItem, size: TextSize.Small, value: 0.0, from, to: from + 1, offset: 0 });
    }

    /// A row of unit tokens, each clickable.
    pub fn roster(&mut self, chips: Vec[RosterChip]) {
        let from = self.chips.len();
        for k in 0..chips.len() { self.chips.push(chips[k]); }
        self.rows.push(Row { kind: RowKind.Roster, size: TextSize.Small, value: 0.0, from, to: self.chips.len(), offset: 0 });
    }

    /// Ends city `city`'s building catalog, scrolled to `offset`.
    pub fn end_catalog(&mut self, city: i32, offset: i32) {
        let to = self.specs.len();
        self.rows.push(Row { kind: RowKind.Catalog, size: TextSize.Small, value: city as f32, from: self.buttons_from, to, offset });
    }

    fn row_height(&self, row: Row) -> f32 {
        match row.kind {
            RowKind.Catalog => {
                let n = row.to - row.from;
                let visible = if n < 1 { 1 } else if n > BUILDING_LIST_VISIBLE { BUILDING_LIST_VISIBLE } else { n };
                visible as f32 * CATALOG_ROW + (visible + 1) as f32 * CATALOG_INSET
            }
            RowKind.Text => ui(row.size).line_height + LINE_GAP,
            RowKind.Gap => row.value,
            RowKind.Bar => GROWTH_BAR_HEIGHT,
            RowKind.Buttons => BUTTON_HEIGHT,
            RowKind.CompactButtons => END_TURN_HEIGHT,
            RowKind.Heading | RowKind.Setting | RowKind.QueueItem | RowKind.Roster => 0.0,
        }
    }

    fn row_width(&self, row: Row) -> f32 {
        match row.kind {
            RowKind.Text => {
                let face = ui(row.size);
                let mut w: f32 = 0.0;
                for i in row.from..row.to {
                    let t = &self.spans[i].text;
                    w = w + face.width(t);
                }
                w
            }
            RowKind.Gap | RowKind.Bar | RowKind.Heading | RowKind.Setting | RowKind.QueueItem | RowKind.Roster => 0.0,
            RowKind.Buttons | RowKind.CompactButtons => {
                let n = row.to - row.from;
                let width = self.button_width(row);
                n as f32 * width + (if n > 0 { n - 1 } else { 0 }) as f32 * GAP
            }
            RowKind.Catalog => {
                let mut widest: f32 = 320.0;
                for i in row.from..row.to {
                    let b = &self.specs[i];
                    let label_text = &b.label;
                    let hint_text = &b.hint;
                    let w = single_line_button_width(label_text, hint_text);
                    if w > widest { widest = w; }
                }
                widest
            }
        }
    }

    /// Width every button in a row shares: enough for the widest one.
    fn button_width(&self, row: Row) -> f32 {
        let compact = row.kind == RowKind.CompactButtons;
        let mut widest = if compact { 0.0 } else { BUTTON_MIN_WIDTH };
        for i in row.from..row.to {
            let b = &self.specs[i];
            let label_text = &b.label;
            let hint_text = &b.hint;
            let w = if compact {
                single_line_button_width(label_text, hint_text)
            } else {
                let label = ui(TextSize.Body).width(label_text);
                let hint = ui(TextSize.Small).width(hint_text);
                (if label > hint { label } else { hint }) + 2.0 * BUTTON_PADDING
            };
            if w > widest { widest = w; }
        }
        widest.ceil()
    }

    /// The panel's size, padding included.
    pub fn size(&self) -> Vec2 {
        let mut width: f32 = 0.0;
        let mut height: f32 = 0.0;
        for i in 0..self.rows.len() {
            let w = self.row_width(self.rows[i]);
            if w > width { width = w; }
            height = height + self.row_height(self.rows[i]);
        }
        vec2(width + 2.0 * PADDING, height + 2.0 * PADDING).round()
    }

    fn place_bottom_left(self, min: Vec2, layout: &mut UiLayout) {
        let top = min.y + self.size().y;
        self.place_top_left(vec2(min.x, top), layout);
    }

    fn place_top_left(self, top_left: Vec2, layout: &mut UiLayout) {
        let size = self.size();
        let min = vec2(top_left.x, top_left.y - size.y).round();
        let max = min.add(size);
        layout.panel(min, max, self.faded);

        let left = min.x + PADDING;
        let inner_width = size.x - 2.0 * PADDING;
        let mut top = max.y - PADDING;
        for r in 0..self.rows.len() {
            let row = self.rows[r];
            let height = self.row_height(row);
            match row.kind {
                RowKind.Text => {
                    // Center capital letters in the line, ignoring the gap.
                    let middle = top - (height - LINE_GAP) / 2.0;
                    let mut spans: Vec[Span] = Vec.new();
                    for i in row.from..row.to { spans.push(Span { text: copy_str(&self.spans[i].text), color: self.spans[i].color }); }
                    layout.text_row(vec2(left, middle), row.size, spans);
                }
                RowKind.Gap | RowKind.Heading | RowKind.Setting | RowKind.QueueItem | RowKind.Roster => {}
                RowKind.Catalog => self.place_catalog(row, left, inner_width, top, height, layout),
                RowKind.Bar => layout.shapes.push(Shape.Bar(vec2(left, top - height), vec2(left + inner_width, top), row.value)),
                RowKind.Buttons | RowKind.CompactButtons => {
                    let width = self.button_width(row);
                    for i in row.from..row.to {
                        let spec = &self.specs[i];
                        let bmin = vec2(left + (i - row.from) as f32 * (width + GAP), top - height);
                        layout.buttons.push(Button {
                            target: spec.target,
                            label: copy_str(&spec.label),
                            hint: copy_str(&spec.hint),
                            state: spec.state,
                            armed: spec.armed,
                            faded: self.faded,
                            min: bmin.round(),
                            max: bmin.add(vec2(width, height)).round(),
                        });
                    }
                }
            }
            top = top - height;
        }
    }

    /// Places a building catalog row in the region from `left` to `left + width` below `top`.
    fn place_catalog(&self, row: Row, left: f32, width: f32, top: f32, height: f32, layout: &mut UiLayout) {
        let total = row.to - row.from;
        let visible = if total < BUILDING_LIST_VISIBLE { total } else { BUILDING_LIST_VISIBLE };
        let region_min = vec2(left, top - height).round();
        let region_max = vec2(left + width, top).round();
        layout.shapes.push(Shape.Panel(region_min, region_max, self.faded));
        let max_offset = total - visible;
        let offset = if row.offset > max_offset { max_offset } else if row.offset < 0 { 0 } else { row.offset };
        let list_width = width - 2.0 * CATALOG_INSET;
        for k in 0..visible {
            let spec = &self.specs[row.from + offset + k];
            let y = region_max.y - CATALOG_INSET - k as f32 * (CATALOG_ROW + CATALOG_INSET);
            layout.buttons.push(Button {
                target: spec.target,
                label: copy_str(&spec.label),
                hint: copy_str(&spec.hint),
                state: spec.state,
                armed: spec.armed,
                faded: self.faded,
                min: vec2(left + CATALOG_INSET, y - CATALOG_ROW).round(),
                max: vec2(left + CATALOG_INSET + list_width, y).round(),
            });
        }
        layout.catalogs.push(CatalogRegion { city: row.value as i32, min: region_min, max: region_max, max_offset });
    }
}

fn copy_str(s: &Str) -> Str { to_owned(s) }

/// "3 MELEE, 1 RANGED": each role in a group and how many it has.
fn group_summary(kinds: &Vec[str], counts: &Vec[i32]) -> Str {
    text(fn() can {Out} {
        for k in 0..kinds.len() {
            if k > 0 { Out.put(", "); }
            show_i64(counts[k] as i64);
            Out.put(" ");
            Out.put(kinds[k]);
        }
    })
}

/// A tooltip's shortcut, set apart from the title before it.
fn spaced(shortcut: &Str) -> Str { text(fn() can {Out} { Out.put("   "); Out.put(shortcut); }) }

fn single_line_button_width(label: &str, hint: &str) -> f32 {
    (ui(TextSize.Body).width(label) + GAP + ui(TextSize.Small).width(hint) + 2.0 * BUTTON_PADDING).ceil()
}

fn contains(min: Vec2, max: Vec2, point: Vec2) -> bool {
    point.x >= min.x && point.y >= min.y && point.x <= max.x && point.y <= max.y
}

/// Window pixels (origin top-left, Y down) to UI pixels (origin bottom-left, Y up).
pub fn to_ui(cursor: Vec2, screen_size: Vec2) -> Vec2 { vec2(cursor.x, screen_size.y - cursor.y) }

fn draw_button(button: &Button, hovered: bool, out: &mut Vec[MeshVertex]) {
    let (bg, text_color, hint_color) = match (button.state, hovered) {
        (ButtonState.Ready, false) => (BUTTON_BG, TEXT, DIM_TEXT),
        (ButtonState.Ready, true) => (BUTTON_HOVER_BG, TEXT, DIM_TEXT),
        (ButtonState.Queued, false) => (QUEUED_BG, QUEUED_TEXT, QUEUED_HINT_TEXT),
        (ButtonState.Queued, true) => (QUEUED_HOVER_BG, QUEUED_TEXT, QUEUED_HINT_TEXT),
        (ButtonState.Disabled, _) => (DISABLED_BG, DISABLED_TEXT, DISABLED_TEXT),
    };
    let (border, border_color) = if button.armed { (ARMED_BORDER, ARMED_BORDER_COLOR) } else { (BORDER, BORDER_COLOR) };
    let faded = button.faded;
    let (bg, border_color, text_color, hint_color) = (fade(bg, faded), fade(border_color, faded), fade(text_color, faded), fade(hint_color, faded));
    draw_box(button.min, button.max, bg, border, border_color, out);

    let (label_face, hint_face) = (ui(TextSize.Body), ui(TextSize.Small));
    let label = &button.label;
    let hint = &button.hint;
    let center = button.min.add(button.max).scale(0.5);
    let height = button.max.y - button.min.y;
    if height < BUTTON_HEIGHT {
        // One line: the label, then the hint beside it.
        let width = label_face.width(label) + GAP + hint_face.width(hint);
        let left = center.x - width / 2.0;
        let baseline = center.y - label_face.cap_height / 2.0;
        label_face.push(vec2(left, baseline), label, text_color, out);
        let hint_left = left + label_face.width(label) + GAP;
        hint_face.push(vec2(hint_left, baseline), hint, hint_color, out);
    } else {
        // Two lines: the label, with the hint under it.
        let gap = LINE_GAP + 2.0;
        let block = label_face.cap_height + gap + hint_face.cap_height;
        let label_baseline = center.y + block / 2.0 - label_face.cap_height;
        let hint_baseline = center.y - block / 2.0;
        let label_left = center.x - label_face.width(label) / 2.0;
        let hint_left = center.x - hint_face.width(hint) / 2.0;
        label_face.push(vec2(label_left, label_baseline), label, text_color, out);
        hint_face.push(vec2(hint_left, hint_baseline), hint, hint_color, out);
    }
}

/// `color` made see-through for the debug panel, or unchanged.
fn fade(color: Color, faded: bool) -> Color {
    if faded { [color[0], color[1], color[2], color[3] * DEBUG_ALPHA] } else { color }
}

/// A filled box with a border drawn around the outside of `min`..`max`.
fn draw_box(min: Vec2, max: Vec2, bg: Color, border: f32, border_color: Color, out: &mut Vec[MeshVertex]) {
    let b = vec2(border, border);
    quad(min.sub(b), max.add(b), border_color, out);
    quad(min, max, bg, out);
}

/// Green if a stat is above its base value, red if below.
fn compare(value: f32, base: f32) -> Color {
    if value > base { BOOSTED_TEXT } else if value < base { REDUCED_TEXT } else { TEXT }
}

/// A city amount in quarter units, without decimals when it's whole.
fn show_quantity(quarters: i32) can {Out} {
    if quarters % 4 == 0 { show_i64((quarters / 4) as i64); } else { show_f64_fixed(quarters as f64 / 4.0, 2); }
}

fn show_signed_quantity(quarters: i32) can {Out} {
    if quarters >= 0 { Out.put("+"); }
    show_quantity(quarters);
}

/// The End Turn button's label: the next thing the turn is waiting on, in the turn's order
/// (production, then idle workers, then units), or "END TURN" once nothing is.
pub fn end_turn_label(units: i32, cities: i32, workers: i32) -> Str {
    if cities == 1 { return to_owned("CHOOSE PRODUCTION"); }
    if cities > 1 { return text(fn() can {Out} { show_i64(cities as i64); Out.put(" CITIES NEED PRODUCTION"); }); }
    if workers == 1 { return to_owned("WORKER NEEDS A JOB"); }
    if workers > 1 { return text(fn() can {Out} { show_i64(workers as i64); Out.put(" WORKERS NEED JOBS"); }); }
    if units == 0 { return to_owned("END TURN"); }
    if units == 1 { return to_owned("UNIT NEEDS ORDERS"); }
    text(fn() can {Out} { show_i64(units as i64); Out.put(" UNITS NEED ORDERS"); })
}

/// What the turn is waiting on, like "2 UNITS AND 1 CITY NEED ORDERS"; nothing once nothing is.
fn show_pending(units: i32, cities: i32, workers: i32) can {Out} {
    let mut first = true;
    let parts = [(units, " UNIT", " UNITS"), (cities, " CITY", " CITIES"), (workers, " WORKER", " WORKERS")];
    for k in 0..3 {
        let (count, one, many) = parts[k];
        if count == 0 { continue; }
        if !first { Out.put(" AND "); }
        show_i64(count as i64);
        Out.put(if count == 1 { one } else { many });
        first = false;
    }
    if units + cities + workers > 0 { Out.put(if units + cities + workers == 1 { " NEEDS ORDERS" } else { " NEED ORDERS" }); }
}

fn show_turns(turns: u32) can {Out} {
    show_u64(turns as u64);
    Out.put(if turns == 1 { " TURN" } else { " TURNS" });
}

/// Splits `t` into lines of at most `max_chars`, breaking between words.
pub fn wrap(t: &str, max_chars: i32) -> Vec[Str] {
    let mut lines: Vec[Str] = Vec.new();
    let mut line = to_owned("");
    for word in split_ascii_whitespace(t) {
        if !line.is_empty() && line.len() as i32 + 1 + str_len(*word) as i32 > max_chars {
            lines.push(replace(&mut line, to_owned("")));
        }
        if !line.is_empty() { push_char(&mut line, ' '); }
        push(&mut line, *word);
    }
    if !line.is_empty() { lines.push(line); }
    lines
}

/// The ability's name and a short description of what it does.
fn ability_text(unit: &Unit) -> (str, str) {
    match unit.ability() {
        Ability.ShieldWall => ("SHIELD WALL", "+50% DEFENSE THIS TURN, BUT CANNOT MOVE"),
        Ability.Volley => ("VOLLEY", "THE ATTACK ALSO HITS ENEMIES NEXT TO THE TARGET, BUT EVERY HIT DEALS 60%"),
        Ability.Charge => ("CHARGE", "+1 MOVE AND +50% ATTACK THIS TURN"),
        Ability.Deploy if unit.deployed => ("PACK UP", "SPEND A TURN PACKING UP TO MOVE AGAIN"),
        Ability.Deploy => ("DEPLOY", "SPEND A TURN SETTING UP, THEN +1 RANGE BUT CANNOT MOVE UNTIL PACKED UP"),
        Ability.Lookout => ("LOOKOUT", "NO MOVING THIS TURN, +2 SIGHT NEXT TURN"),
    }
}

/// Whether the settings menu steps `setting` with < and > rather than showing a button for
/// each value: a slider, or more choices than fit.
pub fn steps_in_classic(setting: Setting) -> bool {
    let (low, high) = setting.range();
    match setting.control() {
        Control.Toggle => false,
        Control.Slider => true,
        Control.Choice => high - low + 1 > MAX_BUTTONS,
    }
}
