//! Screen-space UI: the selected unit's ability button.
//!
//! UI geometry is laid out in pixels with the origin at the window's bottom-left and Y pointing
//! up, the same orientation as the world, so the shared shape and text helpers draw the same
//! way in both.

use std.fmt.show_u64;
use std.linalg.Mat4;
use std.linalg.Vec2;
use std.linalg.mat4_from_cols;
use std.linalg.vec4;
use std.linalg.vec2;
use std.math.Float;
use std.str.Str;
use std.str.digit_char;
use std.str.push;
use std.str.push_char;
use std.str.to_owned;
use log.Log;
use renderer.pipelines.MeshVertex;
use game.GameState;
use game.ability.Ability;
use game.font.push_text;
use game.font.text_width;
use game.mesh.Color;
use game.mesh.quad;
use game.unit.Unit;

const BUTTON_WIDTH: f32 = 600.0;
const BUTTON_HEIGHT: f32 = 52.0;
const BUTTON_BOTTOM: f32 = 28.0;
const BUTTON_BORDER: f32 = 2.0;
/// Text heights are multiples of the font's 7 rows so glyph cells land on whole pixels.
const LABEL_HEIGHT: f32 = 21.0;
const DESCRIPTION_HEIGHT: f32 = 14.0;
const DESCRIPTION_GAP: f32 = 12.0;

const BORDER_COLOR: Color = [0.55, 0.58, 0.66, 1.0];
const READY_BG: Color = [0.16, 0.18, 0.24, 0.95];
const QUEUED_BG: Color = [0.78, 0.64, 0.20, 0.95];
const COOLDOWN_BG: Color = [0.10, 0.10, 0.12, 0.95];
const READY_TEXT: Color = [0.95, 0.95, 0.95, 1.0];
const QUEUED_TEXT: Color = [0.08, 0.07, 0.04, 1.0];
const COOLDOWN_TEXT: Color = [0.50, 0.50, 0.54, 1.0];
const DESCRIPTION_TEXT: Color = [0.80, 0.80, 0.84, 1.0];

/// Maps UI pixels (origin bottom-left, Y up) to clip space.
pub fn ui_projection(screen_size: Vec2) -> Mat4 {
    mat4_from_cols(
        vec4(2.0 / screen_size.x, 0.0, 0.0, 0.0),
        vec4(0.0, -2.0 / screen_size.y, 0.0, 0.0),
        vec4(0.0, 0.0, 1.0, 0.0),
        vec4(-1.0, 1.0, 0.0, 1.0),
    )
}

impl GameState {
    /// The UI as a triangle list in UI pixels: the ability button for the selected unit, if any.
    pub fn build_ui(&self, screen_size: Vec2) -> Vec[MeshVertex] {
        let mut out: Vec[MeshVertex] = Vec.new();
        let Option.Some(idx) = self.selected else { return out; };
        let unit = self.units[idx];
        let (name, description) = ability_text(&unit);

        let mut label = to_owned(name);
        let (bg, text_color) = if unit.ability_queued {
            push(&mut label, " - ON");
            (QUEUED_BG, QUEUED_TEXT)
        } else if unit.ability_cooldown > 0 {
            push(&mut label, " - READY IN ");
            push_decimal(&mut label, unit.ability_cooldown);
            push(&mut label, if unit.ability_cooldown == 1 { " TURN" } else { " TURNS" });
            (COOLDOWN_BG, COOLDOWN_TEXT)
        } else {
            push(&mut label, " - Q");
            (READY_BG, READY_TEXT)
        };

        let (min, max) = button_rect(screen_size);
        let border = vec2(BUTTON_BORDER, BUTTON_BORDER);
        quad(min.sub(border), max.add(border), BORDER_COLOR, &mut out);
        quad(min, max, bg, &mut out);

        let label_y = (min.y + max.y - LABEL_HEIGHT) / 2.0;
        push_centered_text(screen_size.x, label_y, LABEL_HEIGHT, &label, text_color, &mut out);
        let description_y = max.y + BUTTON_BORDER + DESCRIPTION_GAP;
        push_centered_text(screen_size.x, description_y, DESCRIPTION_HEIGHT, description, DESCRIPTION_TEXT, &mut out);
        out
    }

    /// Handles a click on the UI, returning whether it hit anything (in which case it
    /// shouldn't also count as a click on the map). `cursor` is in window pixels with the
    /// origin at the top-left.
    pub fn click_ui(&mut self, cursor: Vec2, screen_size: Vec2) -> bool can {Log} {
        if self.selected.is_none() { return false; }
        let point = vec2(cursor.x, screen_size.y - cursor.y);
        let (min, max) = button_rect(screen_size);
        let hit = point.x >= min.x && point.y >= min.y && point.x <= max.x && point.y <= max.y;
        if hit { self.toggle_selected_ability(); }
        hit
    }
}

/// The ability button's bottom-left and top-right corners, centered along the bottom of the
/// window.
fn button_rect(screen_size: Vec2) -> (Vec2, Vec2) {
    let min = vec2(((screen_size.x - BUTTON_WIDTH) / 2.0).round(), BUTTON_BOTTOM);
    (min, min.add(vec2(BUTTON_WIDTH, BUTTON_HEIGHT)))
}

/// The ability's button label and a one-line description of what it does.
fn ability_text(unit: &Unit) -> (str, str) {
    match unit.ability() {
        Ability.ShieldWall => ("SHIELD WALL", "+50% DEFENSE THIS TURN - CANNOT MOVE"),
        Ability.Volley => ("VOLLEY", "ATTACK ALSO HITS ENEMIES NEXT TO THE TARGET - ALL HITS DEAL 60%"),
        Ability.Charge => ("CHARGE", "+1 MOVE AND +50% ATTACK THIS TURN"),
        Ability.Deploy if unit.deployed => ("PACK UP", "SPEND A TURN PACKING UP TO MOVE AGAIN"),
        Ability.Deploy => ("DEPLOY", "SPEND A TURN SETTING UP - THEN +1 RANGE BUT CANNOT MOVE"),
    }
}

/// Appends `n` in decimal.
fn push_decimal(s: &mut Str, n: u32) {
    if n >= 10 { push_decimal(s, n / 10); }
    push_char(s, digit_char((n % 10) as i64));
}

/// Draws a line of text centered horizontally in the window, snapped to whole pixels so glyph
/// cells stay crisp.
fn push_centered_text(screen_width: f32, bottom: f32, height: f32, text: &str, color: Color, out: &mut Vec[MeshVertex]) {
    let left = ((screen_width - text_width(text, height)) / 2.0).round();
    push_text(vec2(left, bottom.round()), height, text, color, out);
}
