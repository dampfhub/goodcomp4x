fn blue_count(g: &GameState) -> i32 {
    let mut n = 0;
    for i in 0..g.units.len() { if g.units[i].team == Team.Blue { n = n + 1; } }
    n
}

/// Plays one turn of city 0's economy and returns the production it earned and how many of its
/// (Blue) units came out of it. Newly finished units walk away at once, so the city always has
/// an open hex beside it unless the test blocks them.
fn economy_turn(g: &mut GameState, blockers: &Vec[u32]) -> (i32, i32) can {Log} {
    let income = g.income(0).1;
    let before = blue_count(&*g);
    g.resolve_economy();
    let finished = blue_count(&*g) - before;
    handle { g.units.retain(); } with Keep[Unit] { keep(u) => { resume u.team != Team.Blue || blockers.contains(u.id) } }
    (income, finished)
}

/// With production per turn below a unit's cost, a queue of units comes out at the rate
/// production allows. A finished unit that waits for an open hex doesn't bank the production
/// earned meanwhile, which would empty the rest of the queue one unit a turn.
@test
fn a_queue_of_units_completes_at_the_rate_production_allows() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.city_scenario();
        g.units.clear();
        g.roads.clear();
        g.cities[0].worked.clear();
        g.cities[0].worked.push(Hex.new(-3, 0));
        for _ in 0..6 { g.cities[0].queue.push(Build.Unit(BuildUnit.Melee)); }
        g.cities[0].production = 0;
        let cost = BuildUnit.Melee.cost();
        let none: Vec[u32] = Vec.new();

        // Open hexes: the first unit takes several turns, as its cost allows.
        let mut earned = 0;
        let mut turns = 0;
        loop {
            let (income, finished) = economy_turn(&mut g, &none);
            // The test needs production below a unit's cost.
            assert(income < cost);
            earned = earned + income;
            turns = turns + 1;
            if finished > 0 {
                assert(finished == 1);
                assert(earned >= cost);
                break;
            }
        }
        assert(turns > 1);
        // The leftover carries over.
        assert(g.cities[0].production == earned - cost);

        // Every open hex beside the city is taken: the next unit waits in the city.
        let mut blockers: Vec[u32] = Vec.new();
        let around = g.cities[0].pos.neighbors();
        let mut n = 0;
        for k in 0..6 {
            if !g.grid.is_passable(around[k]) { continue; }
            let id = 1000 + n as u32;
            g.units.push(Unit.new(id, around[k], Team.Blue, UnitType.Melee));
            blockers.push(id);
            n = n + 1;
        }
        let mut blocked_earnings = 0;
        while blocked_earnings < 5 * cost {
            let (income, finished) = economy_turn(&mut g, &blockers);
            blocked_earnings = blocked_earnings + income;
            // No hex is open.
            assert(finished == 0);
        }
        // The waiting unit is paid for, and nothing more is banked.
        assert(g.cities[0].production == cost);

        // A hex opens: the waiting unit comes out, and each after it takes its cost again.
        handle { g.units.retain(); } with Keep[Unit] { keep(u) => { resume u.team != Team.Blue } }
        let mut earned = 0;
        let mut finished = 0;
        for _ in 0..6 {
            let (income, done) = economy_turn(&mut g, &none);
            earned = earned + income;
            finished = finished + done;
            assert((finished - 1) * cost <= earned);
        }
        assert(finished >= 1);
    });
}

/// A city and a barracks beside it that finish units the same turn with only one hex open
/// between them don't both put a unit on it.
@test
fn a_city_and_its_barracks_never_finish_units_onto_one_hex() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.city_scenario();
        g.units.clear();
        let city = g.cities[0].pos;
        let barracks = Hex.new(-3, 0);
        assert(city.distance(barracks) == 1);
        g.cities[0].barracks = Option.Some(barracks);
        let city_ring = city.neighbors();
        let mut open = city;
        let mut found = false;
        for k in 0..6 {
            let h = city_ring[k];
            if !found && h.distance(barracks) == 1 && g.grid.is_passable(h) { open = h; found = true; }
        }
        assert(found);
        let barracks_ring = barracks.neighbors();
        let mut n = 0;
        for k in 0..12 {
            let h = if k < 6 { city_ring[k] } else { barracks_ring[k - 6] };
            if h != open && g.grid.is_passable(h) {
                if g.count_at(h) == 0 { g.units.push(Unit.new(1000 + n as u32, h, Team.Blue, UnitType.Melee)); }
                n = n + 1;
            }
        }
        g.cities[0].queue.push(Build.Unit(BuildUnit.Melee));
        g.cities[0].production = BuildUnit.Melee.cost();
        g.cities[0].barracks_queue.push(BuildUnit.Ranged);
        g.cities[0].barracks_production = BuildUnit.Ranged.cost();
        g.complete_builds();
        // One unit on the open hex.
        assert(g.count_at(open) == 1);
        // The barracks waits for a hex.
        assert(g.cities[0].barracks_queue.len() == 1 && g.cities[0].barracks_queue[0] == BuildUnit.Ranged);
    });
}

@test
fn coastal_construction_requires_the_city_center_to_touch_the_sea() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut inland = GameState.city_scenario();
        inland.selected_city = Option.Some(0);
        assert(!inland.city_is_coastal(0));
        let naval = [Building.Harbor, Building.CoastalBattery];
        for k in 0..2 {
            let building = naval[k];
            inland.queue_selected_city_building(building);
            assert(!inland.cities[0].queue.contains(Build.Building(building)));
            assert(!inland.site_available(0, building, Hex.new(-2, 1)));
        }
        inland.cities[0].set_placed_site(Building.Harbor, Hex.new(-2, 1));
        inland.queue_selected_city_unit(BuildUnit.PatrolGalley);
        assert(!inland.cities[0].queue.contains(Build.Unit(BuildUnit.PatrolGalley)));

        let mut coastal = GameState.naval_scenario();
        coastal.selected_city = Option.Some(0);
        assert(coastal.city_is_coastal(0));
        assert(coastal.cities[0].placed_site(Building.Harbor).is_some());
        coastal.queue_selected_city_unit(BuildUnit.LandingCraft);
        assert(coastal.cities[0].queue.contains(Build.Unit(BuildUnit.LandingCraft)));
    });
}

/// An open land tile (a valid Barracks site) where `building`'s site check names `reason`.
fn lacking_site(g: &GameState, building: Building, reason: str) -> Option[Hex] {
    let mut found: Option[Hex] = Option.None;
    for hh in g.grid.hexes() {
        let h = *hh;
        if found.is_some() || !g.site_available(0, Building.Barracks, h) { continue; }
        if let Option.Some(issue) = g.site_issue(0, building, h) {
            if eq_str(&issue, &reason) { found = Option.Some(h); }
        }
    }
    found
}

@test
fn rejected_building_sites_name_the_requirement_and_keep_placement_active() {
    sandbox(fn() can {Log, Rand, Assert} {
        let cases = [
            (Building.Stable, "NEEDS HORSES ON OR NEXT TO THE TILE"),
            (Building.Forge, "NEEDS IRON ON OR NEXT TO THE TILE"),
            (Building.CanoeHouse, "NEEDS A RIVERBANK TILE"),
            (Building.Smelter, "NEEDS HILLS OR IRON ON OR NEXT TO THE TILE"),
        ];
        for k in 0..4 {
            let (building, reason) = cases[k];
            let mut game = GameState.city_scenario();
            game.fog_of_war = false;
            game.selected_city = Option.Some(0);
            let Option.Some(site) = lacking_site(&game, building, reason) else { assert(false); return; };
            game.queue_selected_city_building(building);
            let _ours = game.city_click(site);
            let expected = text(fn() can {Out} { Out.put(building.name()); Out.put(" "); Out.put(reason); });
            let notice = &game.notice;
            let want = &expected;
            assert(eq_str(notice, want));
            assert(game.site_placement().is_some() && game.placing(0, building));
            assert(!game.cities[0].planned_sites.has(building));
        }
    });
}

@test
fn final_confirmation_explains_a_site_that_lost_its_required_feature() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.city_scenario();
        game.fog_of_war = false;
        game.selected_city = Option.Some(0);
        let Option.Some(site) = lacking_site(&game, Building.Stable, "NEEDS HORSES ON OR NEXT TO THE TILE") else { assert(false); return; };
        let _old = game.cities[0].planned_sites.insert(Building.Stable, site);
        game.confirm_building(Building.Stable);
        let notice = &game.notice;
        assert(eq_str(notice, "STABLE SITE INVALID: NEEDS HORSES ON OR NEXT TO THE TILE"));
    });
}

@test
fn a_tile_never_seen_cannot_be_picked_or_worked() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.city_scenario();
        g.explore();
        g.select_city();
        let Option.Some(city) = g.selected_city else { assert(false); return; };
        // An unexplored hex the city's routes reach.
        let routes = g.routes(city);
        let mut unseen = Hex.new(0, 0);
        let mut found = false;
        for k in 0..routes.costs.len() {
            let Option.Some(h) = routes.costs.key_at(k) else { continue; };
            if !found && !g.is_explored(h) { unseen = h; found = true; }
        }
        assert(found);
        let worked = g.cities[city].worked.len();
        let _ours = g.city_click(unseen);
        let notice = &g.notice;
        assert(eq_str(notice, "UNEXPLORED - SCOUT IT FIRST"));
        assert(g.cities[city].worked.len() == worked);
    });
}

@test
fn a_labor_focus_puts_citizens_on_food_or_production() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.city_scenario();
        g.select_city();
        let Option.Some(city) = g.selected_city else { assert(false); return; };
        g.cities[city].population = 3;
        g.set_selected_city_focus(LaborFocus.Food);
        let (food_first, production_low) = g.income(city);
        g.set_selected_city_focus(LaborFocus.Production);
        let (food_low, production_first) = g.income(city);
        // Each focus gets at least as much of its own yield as the other, and they differ.
        assert(food_first >= food_low && production_first >= production_low);
        assert(food_first != food_low || production_first != production_low);
        assert(g.cities[city].focus == LaborFocus.Production);
        assert(g.cities[city].worked.len() == 3);
    });
}
