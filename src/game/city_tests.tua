//! The economy as played: logistics routes, income, growth and starvation, founding a city
//! and spending production on a unit.

use std.test.assert;
use std.test.Assert;
use std.rand.Rand;
use log.Log;
use game.GameState;
use game.PLAYER_TEAM;
use game.city.Site;
use game.city.SiteKind;
use game.turn.Phase;
use game.city.BuildUnit;
use game.hex.Hex;
use game.tests.sandbox;
use game.unit.Team;
use game.unit.Unit;
use game.unit.UnitType;

@test
fn roads_improve_delivery_and_enemy_occupation_blocks_the_site() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.city_scenario();
        g.units.clear();
        g.roads.clear();
        let tile = Hex.new(-1, 0);
        assert(g.routes(0).costs.get(tile) == Option.Some(6));
        for q in -3..=-1 { g.roads.insert(Hex.new(q, 0)); }
        assert(g.routes(0).costs.get(tile) == Option.Some(3));
        g.units.push(Unit.new(100, tile, Team.Red, UnitType.Melee));
        assert(!g.routes(0).costs.has(tile));
    });
}

@test
fn economy_ticks_once_with_no_units_and_preserves_quarters() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.city_scenario();
        g.units.clear();
        g.cities[0].worked.clear();
        let tile = Hex.new(-1, 0);
        g.roads.clear();
        g.cities[0].worked.push(tile);
        assert(g.income(0).0 == 12 && g.income(0).1 == 6);
        // The turn waits until the city has something to build; siege costs more than one
        // turn's production, so none is spent.
        g.end_planning();
        assert(!g.is_resolving());
        g.cities[0].queue = Option.Some(BuildUnit.Siege);
        g.end_planning();
        g.update(1.0);
        assert(g.cities[0].production == 6);
        g.update(10.0);
        assert(g.cities[0].production == 6);
    });
}

@test
fn growth_starvation_and_assignments_obey_population() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.city_scenario();
        g.cities[0].food = 100;
        g.resolve_economy();
        assert(g.cities[0].population == 3);
        g.cities[0].food = -100;
        g.resolve_economy();
        // Starvation loses at most one citizen a turn.
        assert(g.cities[0].population == 2);
        g.auto_assign_city(0);
        assert(g.cities[0].worked.len() == 2);
        assert(!g.may_assign(1, g.cities[0].worked[0]));
    });
}

@test
fn frontier_settler_founds_city_and_city_spends_production_on_unit() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.frontier_scenario();
        g.found_city_selected();
        assert(g.cities.len() == 1);
        // The opposing settler remains.
        assert(g.settlers.len() == 1);
        g.queue_selected_city_unit(BuildUnit.Melee);
        g.cities[0].production = BuildUnit.Melee.cost();
        g.complete_builds();
        assert(g.cities[0].queue.is_none());
        let mut finished: Option[i32] = Option.None;
        for i in 0..g.units.len() {
            if finished.is_none() && g.units[i].team == Team.Blue { finished = Option.Some(i); }
        }
        let Option.Some(f) = finished else { assert(false); return; };
        assert(g.units[f].unit_type == UnitType.Melee);
        assert(g.units[f].pos.distance(g.cities[0].pos) == 1);
    });
}

/// How many of Blue's units there are.
fn blue_units(g: &GameState) -> i32 {
    let mut n = 0;
    for i in 0..g.units.len() { if g.units[i].team == Team.Blue { n = n + 1; } }
    n
}

@test
fn a_finished_unit_waiting_for_a_hex_banks_nothing_more() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.city_scenario();
        g.units.clear();
        assert(g.cities[0].team == Team.Blue);
        let cost = BuildUnit.Melee.cost();
        g.cities[0].queue = Option.Some(BuildUnit.Melee);
        g.cities[0].production = cost;
        // Every hex around the city taken.
        let around = g.cities[0].pos.neighbors();
        for k in 0..6 { g.units.push(Unit.new(200 + k as u32, around[k], Team.Blue, UnitType.Melee)); }
        let units = blue_units(&g);
        for _turn in 0..3 {
            g.resolve_economy();
            // The unit waits, and the city holds just its cost.
            assert(blue_units(&g) == units);
            assert(g.cities[0].production == cost);
        }
        // A hex opens: the unit comes out, and nothing is left over to pay for the next.
        let mut blocker = 0;
        for i in 0..g.units.len() { if g.units[i].id == 205 { blocker = i; } }
        let _gone = g.units.remove(blocker);
        g.resolve_economy();
        assert(blue_units(&g) == units);
        assert(g.cities[0].production < cost);
    });
}

/// A land tile with no road, city or unit that a worker can improve.
fn open_tile(g: &GameState) -> Hex {
    let mut found = Hex.new(0, 0);
    let mut any = false;
    for hh in g.grid.hexes() {
        let h = *hh;
        if any || !g.grid.is_passable(h) || g.roads.contains(h) || g.city_at(h).is_some() { continue; }
        let mut taken = false;
        for i in 0..g.units.len() { if g.units[i].pos == h { taken = true; } }
        if !taken { found = h; any = true; }
    }
    found
}

/// Selects the player's worker, moved to `at`.
fn select_worker_at(g: &mut GameState, at: Hex) {
    let mut worker = 0 - 1;
    for i in 0..g.units.len() { if worker < 0 && g.units[i].team == PLAYER_TEAM && g.workers.contains(g.units[i].id) { worker = i; } }
    g.units[worker].pos = at;
    g.selected = Option.Some(worker);
}

@test
fn worker_actions_wait_for_the_turn_to_finish_playing() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.city_scenario();
        let at = open_tile(&g);
        let _old = g.sites.remove(at);
        select_worker_at(&mut g, at);
        g.pending_steps.push_back((UnitType.Melee, Phase.Move));
        assert(g.is_resolving());
        g.build_worker_road_selected();
        g.improve_worker_tile_selected();
        assert(!g.roads.contains(at));
        assert(!g.sites.has(at));

        let _step = g.pending_steps.pop_front();
        g.build_worker_road_selected();
        g.improve_worker_tile_selected();
        assert(g.roads.contains(at));
        let Option.Some(site) = g.sites.get(at) else { assert(false); return; };
        assert(site.team == PLAYER_TEAM);
    });
}

@test
fn a_worker_cannot_improve_over_an_enemy_site() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.city_scenario();
        let at = open_tile(&g);
        select_worker_at(&mut g, at);
        let _old = g.sites.insert(at, Site { team: Team.Red, food: 3, production: 0, kind: SiteKind.Farm });
        g.improve_worker_tile_selected();
        let Option.Some(site) = g.sites.get(at) else { assert(false); return; };
        assert(site.team == Team.Red && site.food == 3);
    });
}

@test
fn a_tile_never_seen_cannot_be_picked_or_worked() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.city_scenario();
        g.explore();
        g.select_city();
        let Option.Some(city) = g.selected_city else { assert(false); return; };
        // An unexplored hex the city's routes reach.
        let routes = g.routes(city);
        let mut unseen = Hex.new(0, 0);
        let mut found = false;
        for k in 0..routes.costs.len() {
            let Option.Some(h) = routes.costs.key_at(k) else { continue; };
            if !found && !g.is_explored(h) { unseen = h; found = true; }
        }
        assert(found);
        let worked = g.cities[city].worked.len();
        let _ours = g.city_click(unseen);
        assert(g.inspected_tile.is_none());
        assert(g.cities[city].worked.len() == worked);
    });
}
