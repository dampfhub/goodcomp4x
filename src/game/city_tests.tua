        g.cities[0].barracks_production = BuildUnit.Ranged.cost();
        g.complete_builds();
        assert(g.cities[0].barracks_queue.len() == 1 && g.cities[0].barracks_queue[0] == BuildUnit.Melee);
        assert(has_unit(&g, Team.Blue, UnitType.Ranged));
    });
}

