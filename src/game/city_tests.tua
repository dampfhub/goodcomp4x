use game.workers.WorkerJob;

fn unit_by_id(g: &GameState, id: u32) -> i32 {
    for i in 0..g.units.len() { if g.units[i].id == id { return i; } }
    0 - 1
}

fn has_unit(g: &GameState, team: Team, kind: UnitType) -> bool {
    for i in 0..g.units.len() { if g.units[i].team == team && g.units[i].unit_type == kind { return true; } }
    false
}

/// A lone Blue city on plain ground at the origin of a radius-6 map where the six hexes around it
/// are `around` and every other is `base`: no units, roads, sites or other cities.
fn lone_city_on(around: &[Tile; 6], base: Tile) -> GameState can {Log} {
    let mut g = GameState.city_scenario();
    g.units.clear();
    g.roads.clear();
    g.sites = Map.new();
    let origin = Hex.new(0, 0);
    g.cities.clear();
    g.cities.push(City.new(0, Team.Blue, origin));
    let ring = origin.neighbors();
    let mut tiles: Map[Hex, Tile] = Map.new();
    for hh in HexGrid.new(6, &[(origin, Tile.of(Terrain.Plains))]).hexes() {
        let h = *hh;
        let mut tile = if h == origin { Tile.of(Terrain.Plains) } else { base };
        for k in 0..6 { if ring[k] == h { tile = around[k]; } }
        let _old = tiles.insert(h, tile);
    }
    g.grid = HexGrid.from_tiles(GridShape.Hexagon(6), tiles);
    g
}

fn plain() -> Tile { Tile.of(Terrain.Plains) }

fn all_around(tile: Tile) -> [Tile; 6] { [tile, tile, tile, tile, tile, tile] }

@test
fn roads_improve_delivery_and_enemy_occupation_blocks_the_site() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.city_scenario();
        g.units.clear();
        g.roads.clear();
        let tile = Hex.new(-1, 0);
        assert(g.routes(0).costs.get(tile) == Option.Some(6));
        for q in -3..=-1 { g.roads.insert(Hex.new(q, 0)); }
        assert(g.routes(0).costs.get(tile) == Option.Some(3));
        g.units.push(Unit.new(100, tile, Team.Red, UnitType.Melee));
        assert(!g.routes(0).costs.has(tile));
    });
}

/// A tile's share depends on the hexes its goods travel, never on the terrain: every tile beside
/// a city delivers 100%, forested hills, snow and marsh included.
@test
fn every_tile_beside_a_city_delivers_everything_whatever_its_terrain() {
    sandbox(fn() can {Log, Rand, Assert} {
        let rough = [
            Tile { terrain: Terrain.Plains, hills: true, feature: Option.Some(Feature.Forest) },
            Tile { terrain: Terrain.Grassland, hills: true, feature: Option.None },
            Tile { terrain: Terrain.Snow, hills: true, feature: Option.None },
            Tile { terrain: Terrain.Marsh, hills: false, feature: Option.Some(Feature.Jungle) },
            Tile { terrain: Terrain.Tundra, hills: false, feature: Option.Some(Feature.Forest) },
            Tile.of(Terrain.Desert),
        ];
        let g = lone_city_on(&rough, plain());
        let routes = g.routes(0);
        let around = Hex.new(0, 0).neighbors();
        for k in 0..6 {
            let cost = routes.costs.get(around[k]).unwrap_or(99);
            assert(delivered_share(cost) == 4);
        }
    });
}

/// Shares fall off by hexes travelled, 100/75/50/25% at one to four hexes, the same over rough
/// ground as over open ground; five hexes out is beyond reach.
@test
fn shares_fall_off_by_hexes_travelled_not_terrain() {
    sandbox(fn() can {Log, Rand, Assert} {
        let forested_hills = Tile { terrain: Terrain.Plains, hills: true, feature: Option.Some(Feature.Forest) };
        let grounds = [plain(), forested_hills, Tile.of(Terrain.Marsh)];
        for k in 0..3 {
            let g = lone_city_on(&all_around(grounds[k]), grounds[k]);
            let routes = g.routes(0);
            let want = [100, 75, 50, 25, 0 - 1];
            for q in 1..=5 {
                let share = match routes.costs.get(Hex.new(q, 0)) { Option.Some(cost) => delivered_share(cost) * 25, Option.None => 0 - 1 };
                assert(share == want[q - 1]);
            }
        }
    });
}

fn share_at(g: &GameState, q: i32) -> i32 {
    match g.routes(0).costs.get(Hex.new(q, 0)) { Option.Some(cost) => delivered_share(cost) * 25, Option.None => 0 - 1 }
}

/// A road step counts as half a hex, so a road extends a city's reach over any ground.
@test
fn a_road_step_counts_as_half_a_hex() {
    sandbox(fn() can {Log, Rand, Assert} {
        let snow = Tile { terrain: Terrain.Snow, hills: true, feature: Option.None };
        let mut g = lone_city_on(&all_around(snow), snow);
        for q in 1..=4 { g.roads.insert(Hex.new(q, 0)); }
        assert(share_at(&g, 2) == 100);
        assert(share_at(&g, 4) == 75);
        assert(share_at(&g, 5) == 50);
    });
}

@test
fn canoe_house_turns_its_connected_river_into_a_transport_corridor() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.city_scenario();
        g.units.clear();
        g.roads.clear();
        let bank = Hex.new(-3, 0);
        let middle = Hex.new(-2, 0);
        let destination = Hex.new(-1, 0);
        let mut rivers: Set[Edge] = Set.new();
        let _a = rivers.insert(edge(bank, middle));
        let _b = rivers.insert(edge(middle, destination));
        g.grid.set_rivers(rivers);
        let before = g.routes(0).costs.get(destination).unwrap_or(99);
        assert(g.site_available(0, Building.CanoeHouse, bank));
        g.cities[0].set_placed_site(Building.CanoeHouse, bank);
        assert(g.routes(0).costs.get(destination).unwrap_or(99) < before);
    });
}

@test
fn field_hospital_heals_two_nearby_survivors_in_both_layers() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.city_scenario();
        g.units.clear();
        let site = Hex.new(-3, 0);
        g.cities[0].set_placed_site(Building.FieldHospital, site);
        let hurt = [(10, Hex.new(-2, 0), 30.0), (11, Hex.new(-3, 1), 40.0), (12, Hex.new(-4, 1), 50.0)];
        for k in 0..3 {
            let (id, pos, hp) = hurt[k];
            let mut unit = Unit.new(id, pos, Team.Blue, UnitType.Melee);
            unit.hp = hp;
            unit.interior_hp = hp;
            g.units.push(unit);
        }
        g.resolve_economy();
        assert(g.units[unit_by_id(&g, 10)].hp == 50.0);
        assert(g.units[unit_by_id(&g, 11)].interior_hp == 60.0);
        assert(g.units[unit_by_id(&g, 12)].hp == 50.0);
    });
}

/// Places `building` for city 0's workers at `site`, as the player does: its card in the open
/// city, then a click on the tile. Answers whether it was placed.
fn place_building(g: &mut GameState, building: Building, site: Hex) -> bool can {Log} {
    g.selected_city = Option.Some(0);
    g.queue_selected_city_building(building);
    let before = g.cities[0].worker_jobs.len();
    g.place_job_at(site, Option.None);
    g.cities[0].worker_jobs.len() > before
}

/// Plays city 0's workers' part of turns until nothing it placed is left waiting or under way.
fn build_all(g: &mut GameState) can {Log, Assert} {
    for _ in 0..30 {
        let mut busy = !g.cities[0].worker_jobs.is_empty();
        for w in 0..g.field_workers.len() { if g.field_workers[w].home == 0 && g.field_workers[w].job.is_some() { busy = true; } }
        if !busy { return; }
        let _acted = g.resolve_workers();
    }
    assert(false);
}

@test
fn a_barracks_is_placed_for_a_worker_who_walks_out_and_builds_it() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.city_scenario();
        g.units.clear();
        g.explore();
        let site = Hex.new(-2, 0);
        let before = g.stock(Team.Blue);
        assert(place_building(&mut g, Building.Barracks, site));
        assert(g.cities[0].worker_jobs.len() == 1);
        assert(g.stock(Team.Blue) == before.minus(Building.Barracks.price()));
        assert(g.cities[0].queue.is_empty());
        build_all(&mut g);
        assert(g.cities[0].barracks == Option.Some(site));
    });
}

@test
fn a_placed_building_taken_off_the_list_is_refunded() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.city_scenario();
        g.explore();
        let before = g.stock(Team.Blue);
        assert(place_building(&mut g, Building.Barracks, Hex.new(-2, 0)));
        g.remove_worker_job(0);
        assert(g.cities[0].worker_jobs.is_empty());
        assert(g.stock(Team.Blue) == before);
        assert(place_building(&mut g, Building.Barracks, Hex.new(-2, 0)));
    });
}

@test
fn a_workshop_halves_an_adjacent_buildings_work() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.city_scenario();
        g.units.clear();
        let workshop = Hex.new(-2, 0);
        let barracks = Hex.new(-1, 0);
        g.cities[0].workshop = Option.Some(workshop);
        let beside = WorkerJob.on_tile(barracks, JobKind.Build(Building.Barracks));
        let far = WorkerJob.on_tile(Hex.new(-4, 2), JobKind.Build(Building.Barracks));
        assert(g.job_turns(Team.Blue, beside) < g.job_turns(Team.Blue, far));
    });
}

@test
fn debug_completion_only_finishes_the_selected_production_lane() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.city_scenario();
        g.units.clear();
        g.selected_city = Option.Some(0);
        g.cities[0].queue.push(Queued.new(Build.Gather));
        g.cities[1].queue.push(Queued.new(Build.Gather));
        g.cities[1].queue.push(Queued.new(Build.Gather));
        g.debug_complete_current_production();
        assert(g.cities[0].queue.is_empty());
        assert(g.cities[1].queue.len() == 2);
    });
}

@test
fn barracks_queue_is_independent_and_completes_in_order() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.city_scenario();
        g.fund(Team.Blue);
        g.units.clear();
        g.selected_city = Option.Some(0);
        let site = Hex.new(-1, 0);
        g.cities[0].barracks = Option.Some(site);
        g.queue_selected_barracks_unit(BuildUnit.Melee);
        g.queue_selected_barracks_unit(BuildUnit.Ranged);
        g.move_selected_barracks_queue_item(1, true);
        assert(g.cities[0].barracks_queue[0].build == BuildUnit.Ranged);
        g.cities[0].barracks_queue[0] = Queued.worked(BuildUnit.Ranged, BuildUnit.Ranged.work());
        g.complete_builds();
        assert(g.cities[0].barracks_queue.len() == 1 && g.cities[0].barracks_queue[0].build == BuildUnit.Melee);
        assert(has_unit(&g, Team.Blue, UnitType.Ranged));
    });
}

@test
fn an_enemy_on_the_deposit_takes_its_cap_away() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.city_scenario();
        g.units.clear();
        g.fund(Team.Blue);
        g.cities[0].barracks = Option.Some(Hex.new(-2, 0));
        let before = g.special_cap(Team.Blue, Resource.Horses);
        assert(before == UNITS_PER_DEPOSIT);
        g.units.push(Unit.new(900, Hex.new(-2, 0), Team.Red, UnitType.Melee));
        assert(g.special_cap(Team.Blue, Resource.Horses) == 0);
        g.units.clear();
        assert(g.special_cap(Team.Blue, Resource.Horses) == UNITS_PER_DEPOSIT);
    });
}

@test
fn reordering_city_and_barracks_queues_keeps_work_with_each_build() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.city_scenario();
        g.selected_city = Option.Some(0);
        g.cities[0].queue.push(Queued.worked(Build.Unit(BuildUnit.Melee), WORK_PER_TURN));
        g.cities[0].queue.push(Queued.new(Build.Unit(BuildUnit.Ranged)));
        g.move_selected_city_queue_head(false);
        assert(g.cities[0].queue[0].build == Build.Unit(BuildUnit.Ranged));
        assert(g.cities[0].queue[0].progress == 0);
        assert(g.cities[0].queue[1].progress == WORK_PER_TURN);
        g.move_selected_city_queue_item(1, true);
        assert(g.cities[0].queue[0].build == Build.Unit(BuildUnit.Melee));
        assert(g.cities[0].queue[0].progress == WORK_PER_TURN);
    });
}

@test
fn city_queue_completes_in_order_and_can_be_reordered_or_removed() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.city_scenario();
        g.fund(Team.Blue);
        g.units.clear();
        g.selected_city = Option.Some(0);
        g.queue_selected_city_unit(BuildUnit.Melee);
        g.queue_selected_city_unit(BuildUnit.Ranged);
        assert(g.cities[0].queue.len() == 2);
        g.move_selected_city_queue_item(1, true);
        assert(g.cities[0].queue[0].build == Build.Unit(BuildUnit.Ranged));
        g.remove_selected_city_queue_item(1);
        assert(g.cities[0].queue.len() == 1 && g.cities[0].queue[0].build == Build.Unit(BuildUnit.Ranged));
        g.cities[0].queue[0] = Queued.worked(Build.Unit(BuildUnit.Ranged), g.city_build_work(0, Build.Unit(BuildUnit.Ranged)));
        g.complete_builds();
        assert(g.cities[0].queue.is_empty());
        assert(has_unit(&g, Team.Blue, UnitType.Ranged));
    });
}
