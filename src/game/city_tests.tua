@test
fn debug_completion_only_finishes_the_selected_production_lane() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.city_scenario();
        g.units.clear();
        g.selected_city = Option.Some(0);
        g.queue_selected_city_building(Building.Mill);
        let _ours = g.city_click(Hex.new(-2, 0));
        g.cities[1].queue.push(Build.Building(Building.Granary));
        g.cities[1].production = Building.Granary.cost();
        g.debug_complete_current_production();
        assert(g.cities[0].pending_building == Option.Some(Building.Mill));
        assert(g.cities[1].queue.len() == 1 && build_is(&g.cities[1].queue, 0, Build.Building(Building.Granary)));
        assert(!g.cities[1].built.contains(Building.Granary));

        g.cities[0].barracks = Option.Some(Hex.new(-1, 0));
        g.selected_city = Option.None;
        g.selected_barracks = Option.Some(0);
        g.cities[0].barracks_queue.push(BuildUnit.Melee);
        g.debug_complete_current_production();
        assert(g.cities[0].barracks_queue.is_empty());
        assert(has_unit(&g, PLAYER_TEAM, UnitType.Melee));
        assert(g.cities[0].pending_building == Option.Some(Building.Mill));
    });
}

@test
fn barracks_queue_is_independent_and_completes_in_order() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.city_scenario();
        g.units.clear();
        g.selected_city = Option.Some(0);
        let site = Hex.new(-1, 0);
        g.cities[0].barracks = Option.Some(site);
