//! Citizens and clusters: the priority order and its food floor, where a new citizen goes, the
//! cluster rules (a manager for each seven citizens, up to four), and what clicks do.

use std.collections.Map;
use std.collections.Set;
use std.test.assert;
use std.test.Assert;
use std.rand.Rand;
use log.Log;
use game.GameState;
use game.city.Building;
use game.city.Cluster;
use game.city.FOOD_PER_CITIZEN;
use game.city.CLUSTER_SIZE;
use game.city.Good;
use game.city.MAX_CITY_POPULATION;
use game.city.Priorities;
use game.city.Site;
use game.city.SiteKind;
use game.city.WORKERS_PER_MANAGER;
use game.city.cluster_tiles;
use game.city.default_priorities;
use game.city.managers_for;
use game.city.one_cluster;
use game.hex.Hex;
use game.tests.sandbox;
use game.unit.Team;
use game.unit.Unit;
use game.unit.UnitType;
use std.str.eq as str_eq;
use std.str.contains;

fn notice_is(game: &GameState, want: str) -> bool {
    let n = &game.notice;
    str_eq(n, want)
}

fn notice_has(game: &GameState, want: &str) -> bool {
    let n = &game.notice;
    contains(n, want)
}

/// `g`'s city `city` at `population`, its citizens auto-assigned.
fn grown(g: &mut GameState, city: i32, population: i32) can {Log} {
    g.cities[city].population = population;
    g.auto_assign_city(city);
}

/// The food, wood and metal `city`'s center and worked tiles deliver.
fn worked_goods(g: &GameState, city: i32) -> (i32, i32, i32) {
    let routes = g.routes(city);
    let worked = g.cities[city].worked_tiles();
    let mut total = (8, 4, 0);
    for k in 0..worked.len() {
        let cost = routes.costs.get(worked[k]).unwrap_or(0);
        let (a, b, c) = g.delivered_goods(city, worked[k], cost);
        total = (total.0 + a, total.1 + b, total.2 + c);
    }
    total
}

fn same_goods(a: (i32, i32, i32), b: (i32, i32, i32)) -> bool { a.0 == b.0 && a.1 == b.1 && a.2 == b.2 }

fn same_cluster(a: &Cluster, b: &Cluster) -> bool {
    if a.manager != b.manager || a.count != b.count { return false; }
    let (wa, wb) = (a.workers(), b.workers());
    for k in 0..wa.len() { if wa[k] != wb[k] { return false; } }
    true
}

fn same_clusters(a: &Vec[Cluster], b: &Vec[Cluster]) -> bool {
    if a.len() != b.len() { return false; }
    for k in 0..a.len() { if !same_cluster(&a[k], &b[k]) { return false; } }
    true
}

fn copy_clusters(clusters: &Vec[Cluster]) -> Vec[Cluster] {
    let mut out: Vec[Cluster] = Vec.new();
    for k in 0..clusters.len() { out.push(clusters[k]); }
    out
}

/// The cluster rules hold for `city`: no more managers than its population allows, each on land
/// and beside none of the others, each worker beside its own manager, six at most, and no tile
/// twice.
fn assert_clusters_hold(g: &GameState, city: i32) can {Assert} {
    let c = &g.cities[city];
    assert(c.clusters.len() <= c.managers_allowed());
    assert(c.working() <= c.capacity());
    let mut seen: Set[Hex] = Set.new();
    for k in 0..c.clusters.len() {
        let cluster = c.clusters[k];
        assert(!g.grid.terrain(cluster.manager).is_water());
        for o in 0..k { assert(c.clusters[o].manager.distance(cluster.manager) > 1); }
        assert(cluster.count <= WORKERS_PER_MANAGER);
        let workers = cluster.workers();
        for w in 0..workers.len() { assert(workers[w].distance(cluster.manager) == 1); }
    }
    let worked = c.worked_tiles();
    for k in 0..worked.len() {
        assert(!seen.contains(worked[k]));
        seen.insert(worked[k]);
    }
}

@test
fn priority_scores_weigh_the_order_nine_three_one_with_food_first_until_fed() {
    sandbox(fn() can {Log, Rand, Assert} {
        let order = Priorities.of(Good.Metal, Good.Food, Good.Wood);
        assert(order.is_order());
        // Food 1, wood 2, metal 3: metal x9, food x3, wood x1.
        assert(order.score((1, 2, 3), true) == 3 * 9 + 3 + 2);
        // Unfed, food goes first and the others keep their order: food x9, metal x3, wood x1.
        assert(order.score((1, 2, 3), false) == 9 + 3 * 3 + 2);
        // The default is Food, Wood, Metal, fed or not.
        let default = default_priorities();
        assert(default.at(0) == Good.Food && default.at(1) == Good.Wood && default.at(2) == Good.Metal);
        assert(default.score((1, 2, 3), true) == default.score((1, 2, 3), false));
        // A tile of the first good beats one with some of everything else.
        assert(order.score((0, 0, 1), true) > order.score((2, 2, 0), true));
        // Reordering: to the front, and a drag either way.
        let front = order.with_first(Good.Wood);
        assert(front.at(0) == Good.Wood && front.at(1) == Good.Metal && front.at(2) == Good.Food);
        let a = order.moved(0, 2);
        assert(a.at(0) == Good.Food && a.at(1) == Good.Wood && a.at(2) == Good.Metal);
        let b = order.moved(2, 1);
        assert(b.at(0) == Good.Metal && b.at(1) == Good.Wood && b.at(2) == Good.Food);
        let same = order.moved(1, 1);
        assert(same.at(0) == Good.Metal && same.at(1) == Good.Food && same.at(2) == Good.Wood);
        // Out of range: unchanged.
        let out = order.moved(0, 5);
        assert(out.at(0) == Good.Metal && out.at(1) == Good.Food && out.at(2) == Good.Wood);
        assert(!Priorities.of(Good.Food, Good.Food, Good.Metal).is_order());
    });
}

@test
fn a_citys_priority_order_picks_its_tiles_and_the_food_floor_holds() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.city_scenario();
        g.units.clear();
        g.cities[0].population = CLUSTER_SIZE;
        let upkeep = CLUSTER_SIZE * FOOD_PER_CITIZEN;
        let orders = [
            Priorities.of(Good.Food, Good.Wood, Good.Metal),
            Priorities.of(Good.Food, Good.Metal, Good.Wood),
            Priorities.of(Good.Wood, Good.Food, Good.Metal),
            Priorities.of(Good.Wood, Good.Metal, Good.Food),
            Priorities.of(Good.Metal, Good.Food, Good.Wood),
            Priorities.of(Good.Metal, Good.Wood, Good.Food),
        ];
        let mut goods: Vec[(i32, i32, i32)] = Vec.new();
        for k in 0..6 {
            g.cities[0].priorities = orders[k];
            g.auto_assign_city(0);
            assert(g.cities[0].working() > 1);
            goods.push(worked_goods(&g, 0));
        }
        let mut most = (0, 0, 0);
        for k in 0..6 {
            if goods[k].0 > most.0 { most.0 = goods[k].0; }
            if goods[k].1 > most.1 { most.1 = goods[k].1; }
            if goods[k].2 > most.2 { most.2 = goods[k].2; }
        }
        // The city can feed itself.
        assert(most.0 >= upkeep + 4);
        for k in 0..6 {
            let (food, wood, metal) = goods[k];
            // Fed whatever the order: upkeep and one more.
            assert(food >= upkeep + 4);
            // Its first good: as much of it as any order gets.
            let first = orders[k].at(0);
            if first == Good.Food { assert(food == most.0); }
            else if first == Good.Wood { assert(wood == most.1); }
            else { assert(metal == most.2); }
        }
        // Setting the order from the city view reassigns by it.
        g.open_city(0);
        g.set_selected_city_priorities(orders[5]);
        assert(same_goods(worked_goods(&g, 0), goods[5]));
        g.prioritize_selected_city(Good.Wood);
        assert(g.cities[0].priorities.at(0) == Good.Wood && g.cities[0].priorities.at(1) == Good.Metal && g.cities[0].priorities.at(2) == Good.Food);
        assert(same_goods(worked_goods(&g, 0), goods[3]));
        assert(notice_is(&g, "CITY PRIORITIES: WOOD > METAL > FOOD"));
    });
}

/// Where a lone citizen of `city` 0's order goes, the city fed or not: the open land tile in
/// reach that scores best, ties by the smaller (q, r).
fn lone_pick(g: &GameState, fed: bool) -> Hex {
    let routes = g.routes(0);
    let mut best: Option[(Hex, i32)] = Option.None;
    for i in 0..routes.costs.len() {
        let Option.Some(h) = routes.costs.key_at(i) else { continue; };
        let Option.Some(cost) = routes.costs.val_at(i) else { continue; };
        if !g.is_open(0, h) || g.grid.terrain(h).is_water() { continue; }
        let score = g.cities[0].priorities.score(g.delivered_goods(0, h, cost), fed);
        let better = match best {
            Option.None => true,
            Option.Some((bh, bs)) => score > bs || (score == bs && (h.q < bh.q || (h.q == bh.q && h.r < bh.r))),
        };
        if better { best = Option.Some((h, score)); }
    }
    match best { Option.Some((h, _)) => h, Option.None => Hex.new(0, 0) }
}

@test
fn a_canneries_food_counts_toward_the_food_floor() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.city_scenario();
        g.units.clear();
        g.cities[0].population = 1;
        g.cities[0].priorities = default_priorities().with_first(Good.Wood);
        g.cities[0].clusters.clear();
        let (unfed, fed) = (lone_pick(&g, false), lone_pick(&g, true));
        // The food floor makes a difference.
        assert(unfed != fed);
        // The center alone doesn't feed one citizen: food first.
        g.auto_assign_city(0);
        let worked = g.cities[0].worked_tiles();
        assert(worked.len() == 1 && worked[0] == unfed);

        // A Cannery collecting from a farm feeds it, so it goes by its order.
        let (cannery, farm) = (Hex.new(0, 0), Hex.new(1, 0));
        let _old = g.sites.insert(farm, Site { team: Team.Blue, food: 16, production: 0, kind: SiteKind.Farm });
        g.cities[0].set_placed_site(Building.Cannery, cannery);
        assert(g.cannery_income(0) > 0);
        g.auto_assign_city(0);
        let worked = g.cities[0].worked_tiles();
        assert(worked.len() == 1 && worked[0] == fed);
    });
}

@test
fn no_citizen_works_a_city_center_or_a_building_tile() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.city_scenario();
        g.units.clear();
        g.explore();
        let center = g.cities[0].pos;
        // The manager beside both the city center and a Barracks.
        let ring = center.neighbors();
        let manager = ring[0];
        let mut barracks = ring[1];
        for k in 1..6 { if ring[k] != manager && ring[k].distance(manager) == 1 { barracks = ring[k]; } }
        g.cities[0].barracks = Option.Some(barracks);
        g.cities[0].population = MAX_CITY_POPULATION;
        let mut just: Vec[Hex] = Vec.new();
        just.push(manager);
        g.cities[0].clusters = one_cluster(&just);
        let mut remembered: Vec[Hex] = Vec.new();
        remembered.push(manager);
        remembered.push(center);
        remembered.push(barracks);
        g.cities[0].remembered = one_cluster(&remembered);
        g.reconcile_citizens(0);
        let worked = g.cities[0].worked_tiles();
        assert(worked[0] == manager);
        assert(!worked.contains(center));
        assert(!worked.contains(barracks));
        // The others found open tiles.
        assert(worked.len() > 1);
        // Nor by hand, nor as the manager.
        assert(!g.may_assign(0, center) && !g.may_assign(0, barracks));
        assert(!g.may_be_manager(0, 0, barracks));
        g.open_city(0);
        let _ours = g.city_click(barracks);
        assert(!g.cities[0].works(barracks));
        assert(notice_is(&g, "A BUILDING STANDS THERE - NO CITIZEN CAN WORK IT"));
        // A city center's yield comes in whoever works what.
        g.cities[0].clusters.clear();
        assert(g.income(0).food == 8);
    });
}

@test
fn a_city_has_a_manager_for_each_seven_citizens_or_part_up_to_four() {
    sandbox(fn() can {Log, Rand, Assert} {
        assert(MAX_CITY_POPULATION == 28);
        let pops = [1, 7, 8, 14, 15, 21, 22, 28, 40];
        let want = [1, 1, 2, 2, 3, 3, 4, 4, 4];
        for k in 0..9 { assert(managers_for(pops[k]) == want[k]); }
    });
}

@test
fn auto_assign_fills_a_cluster_then_starts_the_next_on_the_best_open_land() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.city_scenario();
        g.units.clear();
        let routes = g.routes(0);
        let pops = [7, 8, 15, 22, 28];
        for p in 0..5 {
            let population = pops[p];
            grown(&mut g, 0, population);
            assert(g.cities[0].clusters.len() == managers_for(population));
            // Remembered as assigned.
            assert(same_clusters(&g.cities[0].remembered, &g.cities[0].clusters));
            assert_clusters_hold(&g, 0);
            // A cluster is full, or has no open tile beside its manager, before the next
            // begins; and a citizen idles only when no cluster has room and no new manager may
            // start.
            let clusters = copy_clusters(&g.cities[0].clusters);
            for k in 0..clusters.len() {
                let around = clusters[k].manager.neighbors();
                let mut open = false;
                for n in 0..6 { if routes.costs.has(around[n]) && g.is_open(0, around[n]) { open = true; } }
                if k + 1 < clusters.len() { assert(clusters[k].count == WORKERS_PER_MANAGER || !open); }
                if g.cities[0].working() < population { assert(clusters[k].count == WORKERS_PER_MANAGER || !open); }
            }
        }
        // A new manager is the open land tile the order ranks best, clear of the others.
        grown(&mut g, 0, 7);
        let first = copy_clusters(&g.cities[0].clusters);
        g.cities[0].population = 8;
        g.reconcile_citizens(0);
        assert(same_cluster(&g.cities[0].clusters[0], &first[0]));
        let new = g.cities[0].clusters[1].manager;
        let routes = g.routes(0);
        let cost = routes.costs.get(new).unwrap_or(0);
        let food = worked_goods(&g, 0).0 - g.delivered_goods(0, new, cost).0;
        let fed = g.is_fed(0, food);
        let got = g.cities[0].priorities.score(g.delivered_goods(0, new, cost), fed);
        for i in 0..routes.costs.len() {
            let Option.Some(h) = routes.costs.key_at(i) else { continue; };
            let Option.Some(c) = routes.costs.val_at(i) else { continue; };
            if !((h == new || g.is_open(0, h)) && !g.grid.terrain(h).is_water() && first[0].manager.distance(h) > 1) { continue; }
            let score = g.cities[0].priorities.score(g.delivered_goods(0, h, c), fed);
            assert(score <= got);
        }
    });
}

@test
fn a_city_losing_citizens_loses_the_last_clusters_workers_then_its_manager() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.city_scenario();
        g.units.clear();
        // Three clusters, 7, 7 and 2 citizens: where doesn't matter here.
        let mut clusters: Vec[Cluster] = Vec.new();
        let counts = [7, 7, 2];
        let qs = [0 - 4, 0, 4];
        for k in 0..3 {
            let mut c = Cluster.new(Hex.new(qs[k], 0));
            let ring = Hex.new(qs[k], 0).neighbors();
            for w in 0..(counts[k] - 1) { c.add_worker(ring[w]); }
            clusters.push(c);
        }
        g.cities[0].population = 16;
        g.cities[0].clusters = clusters;
        g.cities[0].remembered = copy_clusters(&g.cities[0].clusters);
        let last_worker = g.cities[0].clusters[2].workers()[0];
        assert(g.remove_citizen(0));
        // The last cluster's worker goes.
        assert(sizes_are(&g, [7, 7, 1]));
        assert(!g.cities[0].works(last_worker));
        assert(g.remove_citizen(0));
        // Then its manager.
        assert(g.cities[0].clusters.len() == 2 && sizes_are(&g, [7, 7, 0]));
        assert(g.remove_citizen(0));
        // Then the next cluster's workers.
        assert(sizes_are(&g, [7, 6, 0]));
        assert(g.cities[0].population == 13);
        assert(same_clusters(&g.cities[0].remembered, &g.cities[0].clusters));
        // An idle citizen goes before any that works.
        let _popped = g.cities[0].clusters[1].pop_worker();
        g.cities[0].remembered = copy_clusters(&g.cities[0].clusters);
        assert(g.remove_citizen(0));
        assert(sizes_are(&g, [7, 5, 0]));
        // Starving uses the same rule, and never goes below one citizen.
        let stock = g.stock(Team.Blue);
        g.set_stock(Team.Blue, game.city.Stock { food: 0, wood: stock.wood, metal: stock.metal });
        g.feed_citizens();
        assert(g.cities[0].population == 11);
        assert(sizes_are(&g, [7, 4, 0]));
        grown(&mut g, 0, 1);
        assert(!g.remove_citizen(0));
        assert(g.cities[0].clusters.len() == 1 && g.cities[0].clusters[0].citizens() == 1);
    });
}

/// Whether the citizens of the clusters are `want`, the first `clusters.len()` of them (a
/// zero past the last cluster is a cluster that is gone).
fn sizes_are(g: &GameState, want: [i32; 3]) -> bool {
    let c = &g.cities[0];
    for k in 0..3 {
        if k < c.clusters.len() {
            if c.clusters[k].citizens() != want[k] { return false; }
        } else if want[k] != 0 {
            return false;
        }
    }
    true
}

@test
fn a_blocked_manager_is_stood_in_for_until_its_tile_clears() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.city_scenario();
        g.units.clear();
        grown(&mut g, 0, 10);
        let first = g.cities[0].clusters[0];
        // An enemy on the first manager's tile cuts it off: its first worker that can manage
        // stands in, and the cluster rules still hold.
        g.units.push(Unit.new(777, first.manager, Team.Red, UnitType.Melee));
        g.reconcile_citizens(0);
        assert(!g.cities[0].works(first.manager));
        assert_clusters_hold(&g, 0);
        g.units.clear();
        g.reconcile_citizens(0);
        // Back as it was.
        assert(same_cluster(&g.cities[0].clusters[0], &first));
        assert_clusters_hold(&g, 0);
    });
}

@test
fn moving_a_manager_takes_its_own_cluster_and_leaves_the_others() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.city_scenario();
        g.units.clear();
        g.fog_of_war = false;
        grown(&mut g, 0, 12);
        let before = copy_clusters(&g.cities[0].clusters);
        assert(before.len() == 2);
        let old = before[1].manager;
        // Not beside the other manager, or onto another cluster's tile.
        assert(!g.may_be_manager(0, 1, before[0].workers()[0]));
        assert(!g.may_be_manager(0, 1, before[0].manager));
        // Somewhere it may go: land in reach, clear of the first manager and its cluster.
        let routes = g.routes(0);
        let mut to: Option[Hex] = Option.None;
        let mut to_dist = 99;
        for i in 0..routes.costs.len() {
            let Option.Some(h) = routes.costs.key_at(i) else { continue; };
            if !g.may_be_manager(0, 1, h) || before[1].holds(h) { continue; }
            // One of its workers' offsets lands on an open tile.
            let workers = before[1].workers();
            let mut lands = false;
            for w in 0..workers.len() {
                let t = Hex.new(workers[w].q + h.q - old.q, workers[w].r + h.r - old.r);
                if routes.costs.has(t) && g.is_open(0, t) { lands = true; }
            }
            if !lands { continue; }
            let d = h.distance(old);
            let better = match to { Option.None => true, Option.Some(b) => d < to_dist || (d == to_dist && (h.q < b.q || (h.q == b.q && h.r < b.r))) };
            if better { to = Option.Some(h); to_dist = d; }
        }
        let Option.Some(dest) = to else { assert(false); return; };
        g.open_city(0);
        let _ours = g.city_click(old);
        assert(g.is_moving_manager(0, 1));
        let _ours = g.city_click(dest);
        assert(g.moving_manager.is_none());
        // The first cluster stays put.
        assert(same_cluster(&g.cities[0].clusters[0], &before[0]));
        assert(g.cities[0].clusters[1].manager == dest);
        // Its workers kept their offsets where they could.
        let after = g.cities[0].clusters[1].workers();
        let workers = before[1].workers();
        let mut kept = 0;
        for w in 0..workers.len() {
            let shifted = Hex.new(workers[w].q + dest.q - old.q, workers[w].r + dest.r - old.r);
            if after.contains(shifted) { kept = kept + 1; }
        }
        assert(kept > 0);
        assert_clusters_hold(&g, 0);
    });
}

@test
fn clicks_add_a_worker_beside_a_manager_or_start_a_cluster_when_allowed() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.city_scenario();
        g.units.clear();
        g.fog_of_war = false;
        grown(&mut g, 0, 9);
        g.open_city(0);
        // Free a slot: release a worker of the first cluster.
        let released = g.cities[0].clusters[0].workers()[0];
        let _ours = g.city_click(released);
        assert(notice_is(&g, "CITIZEN UNASSIGNED"));
        assert(g.cities[0].working() == 8);
        assert(!cluster_tiles(&g.cities[0].remembered).contains(released));
        // A tile beside no manager, with the managers the city may have: refused.
        let far = away_from_managers(&g, false);
        let _ours = g.city_click(far);
        assert(notice_has(&g, "ANOTHER MANAGER AT 15 CITIZENS"));
        assert(!g.cities[0].works(far));
        // Back beside its manager, it's a worker again.
        let _ours = g.city_click(released);
        assert(notice_is(&g, "CITIZEN ASSIGNED"));
        assert(g.cities[0].cluster_of(released) == Option.Some(0));
        // With a third manager allowed and a slot free, a click on open land clear of the
        // managers starts one.
        g.cities[0].population = 15;
        let clusters = g.cities[0].clusters.len();
        assert(clusters == 2);
        let land_far = away_from_managers(&g, true);
        let _ours = g.city_click(land_far);
        assert(notice_is(&g, "MANAGER ASSIGNED - A NEW CLUSTER"));
        assert(g.cities[0].clusters.len() == clusters + 1);
        assert(g.cities[0].clusters[clusters].manager == land_far);
        assert(same_clusters(&g.cities[0].remembered, &g.cities[0].clusters));
        assert_clusters_hold(&g, 0);
    });
}

/// The smallest open tile in reach more than two hexes from every manager (land only if `land`).
fn away_from_managers(g: &GameState, land: bool) -> Hex {
    let routes = g.routes(0);
    let mut best: Option[Hex] = Option.None;
    for i in 0..routes.costs.len() {
        let Option.Some(h) = routes.costs.key_at(i) else { continue; };
        if !g.is_open(0, h) || (land && g.grid.terrain(h).is_water()) { continue; }
        let mut clear = true;
        for k in 0..g.cities[0].clusters.len() { if g.cities[0].clusters[k].manager.distance(h) <= 2 { clear = false; } }
        if !clear { continue; }
        let better = match best { Option.None => true, Option.Some(b) => h.q < b.q || (h.q == b.q && h.r < b.r) };
        if better { best = Option.Some(h); }
    }
    best.unwrap_or(Hex.new(0, 0))
}
