//! The player's settings, their text between sessions, and Escape.

use std.str.Str;
use std.str.eq as str_eq;
use std.str.lines;
use std.str.len;
use std.str.byte_at;
use std.test.assert;
use std.test.Assert;
use std.rand.Rand;
use log.Log;
use game.GameState;
use game.PLAYER_TEAM;
use game.scenario.Scenario;
use game.settings.Control;
use game.settings.SETTINGS;
use game.settings.Setting;
use game.settings.Settings;
use game.settings.default_settings;
use game.settings.settings_from_text;
use game.tests.sandbox;

fn named(s: Str, want: str) -> bool { str_eq(&s, want) }

@test
fn every_setting_starts_in_range_and_changes_within_it() {
    let mut settings = default_settings();
    for i in 0..6 {
        let setting = SETTINGS[i];
        let (lo, hi) = setting.range();
        let v = settings.get(setting);
        assert(v >= lo && v <= hi);
        // Every value in the range can be set and read back.
        for value in lo..=hi {
            let _c = settings.change(setting, value);
            assert(settings.get(setting) == value);
            let shown = setting.value_text(value);
            let view = &shown;
            assert(len(view) > 0);
        }
        // Past either end, it stops at that end.
        assert(!settings.change(setting, hi + 1));
        assert(settings.get(setting) == hi);
        assert(settings.change(setting, lo - 1));
        assert(settings.get(setting) == lo);
        assert(!settings.change(setting, -2147483648));
    }
}

@test
fn every_setting_has_a_control_that_fits_its_range() {
    for i in 0..6 {
        let setting = SETTINGS[i];
        let (lo, hi) = setting.range();
        match setting.control() {
            Control.Toggle => assert(lo == 0 && hi == 1),
            Control.Slider => assert(hi - lo >= 2),
            Control.Choice => {
                // Each choice reads differently.
                for a in lo..=hi {
                    for b in a + 1..=hi {
                        let (ta, tb) = (setting.value_text(a), setting.value_text(b));
                        assert(!str_eq(&ta, &tb));
                    }
                }
            }
        }
        assert(len(setting.group()) > 0);
    }
    // A group's settings are listed together, so each heading shows once.
    for i in 0..6 {
        for j in i + 2..5 {
            if str_eq(SETTINGS[i].group(), SETTINGS[j].group()) {
                for k in i + 1..j { assert(str_eq(SETTINGS[k].group(), SETTINGS[i].group())); }
            }
        }
    }
}

@test
fn settings_save_as_text_and_read_back() {
    let mut settings = default_settings();
    for i in 0..6 {
        // Every setting away from its default, one step.
        let setting = SETTINGS[i];
        let value = settings.get(setting);
        if !settings.change(setting, value + 1) { let _c = settings.change(setting, value - 1); }
    }
    assert(settings != default_settings());
    let t = settings.to_text();
    let mut count = 0;
    for _line in lines(&t) { count = count + 1; }
    assert(count == 6);
    assert(settings_from_text(&t) == settings);

    // Unknown keys, bad values, comments and out-of-range values are skipped; what's missing
    // keeps its default.
    let loaded = settings_from_text("# saved\nqueue_limit 9\nfog maybe\nworld_ai 99\nsomething 3\n");
    assert(loaded.max_queued_turns == 9);
    assert(loaded.cloud_fog == default_settings().cloud_fog);
    assert(loaded.world_ai == default_settings().world_ai);
    assert(settings_from_text("") == default_settings());
}

@test
fn every_setting_has_its_own_key() {
    for i in 0..6 {
        for j in i + 1..6 { assert(!str_eq(SETTINGS[i].key(), SETTINGS[j].key())); }
        let key = SETTINGS[i].key();
        for b in 0..len(key) {
            let c = byte_at(key, b);
            assert(c != Option.Some(32) && c != Option.Some(9));
        }
    }
}

@test
fn turn_playback_is_the_instant_playback_switch() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        // On by default.
        assert(game.settings.instant_playback);
        game.set_setting(Setting.TurnPlayback, 0);
        assert(!game.settings.instant_playback);
        {
            let notice = &game.notice;
            assert(str_eq(notice, "INSTANT PLAYBACK: OFF"));
        }
        game.toggle_instant_playback();
        // F8 agrees.
        assert(game.settings.get(Setting.TurnPlayback) == 1);
    });
}

@test
fn settings_survive_scenario_switches_and_loads() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.city_scenario();
        game.set_setting(Setting.TurnPlayback, 0);
        game.save_state();
        game.set_setting(Setting.TurnPlayback, 1);
        game.set_setting(Setting.TurnPlayback, 0);
        let changed = game.settings.copy();
        assert(changed != default_settings());
        game.switch_scenario(Scenario.Combat);
        assert(game.settings == changed);
        game.set_setting(Setting.TurnPlayback, 1);
        let current = game.settings.copy();
        game.load_state();
        // A load keeps the current settings.
        assert(game.settings == current);
    });
}

@test
fn escape_closes_whatever_is_open_before_opening_the_menu() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.city_scenario();
        game.leave_city_view();
        let _c = game.clear_selection();
        game.select_city();
        assert(game.selected_city.is_some());

        // The city view closes first, then the selection.
        game.press_escape();
        assert(game.selected_city.is_none());
        assert(!game.settings_open);
        game.selected = Option.Some(0);
        game.press_escape();
        assert(game.selected.is_none());
        assert(!game.settings_open);

        // With nothing left, Escape opens the menu, and the next press closes it again.
        game.press_escape();
        assert(game.settings_open);
        game.press_escape();
        assert(!game.settings_open);
    });
}

@test
fn escape_closes_the_open_menu_before_anything_else() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let _c = game.clear_selection();
        game.press_escape();
        assert(game.settings_open);
        let mut unit: Option[i32] = Option.None;
        for i in 0..game.units.len() { if unit.is_none() && game.units[i].team == PLAYER_TEAM { unit = Option.Some(i); } }
        game.selected = unit;
        game.press_escape();
        // The menu closed first, and the selection stays.
        assert(!game.settings_open);
        assert(game.selected == unit);
        game.press_escape();
        assert(game.selected.is_none());
    });
}

@test
fn a_scenario_switch_or_load_keeps_the_menu_as_it_was() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let _c = game.clear_selection();
        game.save_state();
        game.switch_scenario(Scenario.Cities);
        assert(!game.settings_open);
        let _d = game.clear_selection();
        game.press_escape();
        game.switch_scenario(Scenario.Combat);
        // Still open after a switch, and after a load of a closed-menu save.
        assert(game.settings_open);
        game.load_state();
        assert(game.settings_open);
    });
}
