//! Order queues: Shift-click plans over several turns, and the plan plays out turn by turn.

use std.collections.Map;
use std.collections.Set;
use std.linalg.Vec2;
use std.linalg.vec2;
use std.str.Str;
use std.str.eq as str_eq;
use std.str.find;
use std.test.assert;
use std.test.Assert;
use std.rand.Rand;
use log.Log;
use game.GameState;
use game.draw.ATTACK_ARC_COLOR;
use game.draw.GHOST_ALPHA;
use game.draw.QUEUE_LINE_ALPHA;
use game.draw.queue_plans;
use game.hex.HEX_SIZE;
use game.hex.Hex;
use game.hex.HexGrid;
use game.terrain.Terrain;
use game.terrain.Tile;
use game.orders.SHIPS_NOTICE;
use game.hex.edge;
use game.workers.Structure;
use game.workers.StructureKind;
use game.mesh.Color;
use renderer.pipelines.MeshVertex;
use game.orders.ClickMode;
use game.settings.Setting;
use game.tests.sandbox;
use game.unit.Team;
use game.unit.TurnOrder;
use game.unit.Unit;
use game.unit.UnitType;

fn screen() -> Vec2 { vec2(1600.0, 900.0) }

/// An open radius-6 map with no fog, no AI units and one Blue unit of each `types` in a row
/// from (-4, 0), for queuing without interference.
fn open_field(types: &[UnitType]) -> GameState can {Log} {
    let mut game = GameState.city_scenario();
    game.fog_of_war = false;
    game.units.clear();
    game.cities.clear();
    game.selected = Option.None;
    game.group.clear();
    for n in 0..types.len() {
        game.units.push(Unit.new(100 + n as u32, Hex.new(-4, n), Team.Blue, types[n]));
    }
    game
}

/// Ends planning and plays the whole turn out at once.
fn play_turn(game: &mut GameState) can {Log, Rand, Assert} {
    game.settings.instant_playback = true;
    game.end_planning();
    game.update(0.0);
    assert(!game.is_resolving());
}

fn cursor(game: &GameState, hex: Hex) -> Vec2 { game.camera.world_to_screen(hex.to_world(), screen()) }

/// Whether the top bar's latest notice is `want`.
fn notice_is(game: &GameState, want: str) -> bool {
    let notice: &Str = &game.notice;
    str_eq(notice, want)
}

fn notice_has(game: &GameState, part: str) -> bool {
    let notice: &Str = &game.notice;
    find(notice, part).is_some()
}

fn shown_has(game: &GameState, part: str) -> bool {
    let shown = game.shown_notice();
    let s: &Str = &shown;
    find(s, part).is_some()
}

fn shown_is(game: &GameState, want: str) -> bool {
    let shown = game.shown_notice();
    let s: &Str = &shown;
    str_eq(s, want)
}

fn select(game: &mut GameState, units: &[i32]) {
    let mut members: Vec[i32] = Vec.new();
    for k in 0..units.len() { members.push(units[k]); }
    game.set_selection(members);
}

/// Unit `idx`'s move on each turn of its plan (`None` for a wait).
fn moves(game: &GameState, idx: i32) -> Vec[Option[Hex]] {
    let unit = &game.units[idx];
    let mut out: Vec[Option[Hex]] = Vec.new();
    out.push(unit.planned_move);
    for t in 0..unit.queued.len() { out.push(unit.queued[t].move_to); }
    out
}

fn all_move(plan: &Vec[Option[Hex]], from: i32) -> bool {
    for t in from..plan.len() { if plan[t].is_none() { return false; } }
    true
}

@test
fn shift_clicks_build_a_queue_the_unit_follows_turn_by_turn() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = open_field(&[UnitType.Melee]);
        g.selected = Option.Some(0);
        let path = [Hex.new(-3, 0), Hex.new(-2, 0), Hex.new(-1, 0)];
        for k in 0..3 { g.handle_map_click(cursor(&g, path[k]), screen(), ClickMode.QueueMove); }
        assert(g.units[0].planned_move == Option.Some(path[0]));
        assert(g.units[0].queued.len() == 2);
        assert(g.units[0].plan_end() == path[2]);
        // Queuing never moves selection on.
        assert(g.selected == Option.Some(0));

        for k in 0..3 {
            play_turn(&mut g);
            assert(g.units[0].pos == path[k]);
        }
        // The queue is used up, and then the unit wants orders again.
        assert(!g.units[0].has_queue());
        assert(g.needs_orders(0));
    });
}

@test
fn one_far_shift_click_queues_every_turn_it_takes_to_get_there() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = open_field(&[UnitType.Melee]);
        g.selected = Option.Some(0);
        // Six hexes: as many turns as a queue holds by default.
        let far = Hex.new(2, 0);
        assert(g.queue_move(far));
        assert(notice_is(&g, "QUEUED FOR THE NEXT \u{E003}6"));
        assert(g.units[0].plan_len() == g.units[0].pos.distance(far));
        assert(g.units[0].plan_end() == far);
        // Already there.
        assert(!g.queue_move(far));
        for _t in 0..6 { play_turn(&mut g); }
        assert(g.units[0].pos == far);
    });
}

@test
fn a_hex_past_the_limit_is_queued_as_far_as_the_limit_goes() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = open_field(&[UnitType.Melee]);
        assert(g.settings.max_queued_turns == 6);
        g.selected = Option.Some(0);
        // Eight hexes away: six turns of it, and then the queue is full.
        let far = Hex.new(4, 0);
        assert(g.queue_move(far));
        assert(g.units[0].plan_len() == 6);
        assert(g.units[0].plan_end() == Hex.new(2, 0));
        assert(all_move(&moves(&g, 0), 0));
        assert(notice_is(&g, "QUEUED UP TO THE \u{E003}6 LIMIT"));
        assert(!g.queue_move(far));
        assert(g.units[0].plan_len() == 6);
        assert(notice_is(&g, "QUEUE FULL - \u{E003}6 LIMIT"));
        // An attack still fits into the last turn, but a second one would need a turn of its
        // own.
        g.units.push(Unit.new(99, Hex.new(3, 0), Team.Red, UnitType.Melee));
        assert(g.queue_attack(Hex.new(3, 0)));
        assert(g.units[0].plan_len() == 6);
        assert(!g.queue_attack(Hex.new(3, 0)));
        assert(g.units[0].plan_len() == 6);
        assert(notice_is(&g, "QUEUE FULL - \u{E003}6 LIMIT"));

        // Each turn played frees a turn of the queue.
        let _gone = g.units.pop();
        play_turn(&mut g);
        assert(g.units[0].plan_len() == 5);
        g.selected = Option.Some(0);
        assert(g.queue_move(far));
        assert(g.units[0].plan_len() == 6);
        assert(g.units[0].plan_end() == Hex.new(3, 0));
    });
}

@test
fn several_shift_clicks_never_queue_past_the_limit() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = open_field(&[UnitType.Melee]);
        g.selected = Option.Some(0);
        // Short hops, one after another, stop at six turns in all.
        for hop in 0..8 {
            let queued = g.queue_move(Hex.new(hop - 3, 0));
            assert(queued == (hop < 6));
            assert(g.units[0].plan_len() <= 6);
        }
        assert(g.units[0].plan_len() == 6);
        assert(g.units[0].plan_end() == Hex.new(2, 0));
    });
}

@test
fn the_limit_is_the_queue_limit_setting() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = open_field(&[UnitType.Melee]);
        g.set_setting(Setting.MaxQueuedTurns, 3);
        assert(g.settings.max_queued_turns == 3);
        assert(notice_is(&g, "QUEUE LIMIT: 3 TURNS"));
        g.selected = Option.Some(0);
        let far = Hex.new(4, 0);
        assert(g.queue_move(far));
        assert(g.units[0].plan_len() == 3);
        assert(notice_is(&g, "QUEUED UP TO THE \u{E003}3 LIMIT"));

        // A higher limit lets the next click go the rest of the way; past the top of its range
        // it stops there.
        g.set_setting(Setting.MaxQueuedTurns, 25);
        assert(g.settings.max_queued_turns == 20);
        assert(g.queue_move(far));
        assert(g.units[0].plan_len() == 8);
        assert(g.units[0].plan_end() == far);
        assert(!notice_has(&g, "LIMIT"));

        // At the lowest, only this turn.
        let mut g = open_field(&[UnitType.Melee]);
        g.set_setting(Setting.MaxQueuedTurns, 1);
        assert(g.settings.max_queued_turns == 1);
        g.selected = Option.Some(0);
        assert(g.queue_move(far));
        assert(g.units[0].plan_len() == 1);
        assert(!g.queue_move(far));
        assert(g.units[0].plan_len() == 1);
    });
}

@test
fn no_group_member_queues_past_the_limit() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = open_field(&[UnitType.Melee, UnitType.Ranged]);
        g.settings.max_queued_turns = 5;
        // The melee has three turns of its own queued.
        g.selected = Option.Some(0);
        assert(g.queue_move(Hex.new(-1, 0)));
        assert(g.units[0].plan_len() == 3);
        let queued = moves(&g, 0);

        // Both are sent farther than five turns take them.
        select(&mut g, &[0, 1]);
        let far = Hex.new(5, 0);
        assert(g.queue_move(far));
        assert(notice_is(&g, "QUEUED UP TO THE \u{E003}5 LIMIT"));
        // The melee keeps its three turns and adds two; the ranged unit, starting now, moves
        // all five.
        for i in 0..2 { assert(g.units[i].plan_len() == 5); }
        let melee = moves(&g, 0);
        for t in 0..3 { assert(melee[t] == queued[t]); }
        assert(all_move(&melee, 3));
        assert(all_move(&moves(&g, 1), 0));

        // Both queues are full.
        assert(!g.queue_move(far));
        assert(notice_is(&g, "QUEUE FULL - \u{E003}5 LIMIT"));
    });
}

@test
fn a_queue_toward_an_enemy_in_sight_stops_next_to_it() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = open_field(&[UnitType.Melee]);
        let enemy = Hex.new(-1, 0);
        g.units.push(Unit.new(200, enemy, Team.Red, UnitType.Melee));
        g.selected = Option.Some(0);
        assert(g.queue_move(enemy));
        assert(g.units[0].plan_len() == 2);
        // Already next to it.
        assert(!g.queue_move(enemy));
        assert(g.units[0].plan_end().distance(enemy) == 1);
        assert(g.queue_attack(enemy));
        let last = g.units[0].queued.len() - 1;
        assert(g.units[0].queued[last].attack == Option.Some(enemy));
    });
}

@test
fn a_queued_attack_joins_the_move_of_its_turn_or_starts_a_new_one() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = open_field(&[UnitType.Ranged]);
        g.selected = Option.Some(0);
        assert(g.queue_move(Hex.new(-3, 0)));
        // In range of (-3, 0): fills this turn's attack.
        let target = Hex.new(-1, 0);
        assert(g.queue_attack(target));
        assert(g.units[0].planned_attack == Option.Some(target));
        assert(g.units[0].queued.is_empty());
        // Again: this turn already attacks, so next turn attacks from there.
        assert(g.queue_attack(target));
        let next = g.units[0].queued[0];
        assert(next.attack == Option.Some(target));
        assert(next.move_to.is_none());
        assert(next.from == Hex.new(-3, 0));
        // Out of range of where the plan ends: nothing.
        assert(!g.queue_attack(Hex.new(3, 0)));
        assert(g.units[0].plan_len() == 2);
    });
}

@test
fn right_click_attacks_and_left_click_only_moves() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = open_field(&[UnitType.Melee]);
        g.units.push(Unit.new(200, Hex.new(-3, 0), Team.Red, UnitType.Melee));
        g.selected = Option.Some(0);
        let enemy = Hex.new(-3, 0);
        g.handle_map_click(cursor(&g, enemy), screen(), ClickMode.Normal);
        // A left click doesn't attack.
        assert(g.units[0].planned_attack.is_none());
        assert(g.units[0].planned_move.is_none());
        assert(notice_is(&g, "RIGHT-CLICK TO ATTACK"));
        g.handle_context_click(cursor(&g, enemy), screen(), false, false);
        assert(g.units[0].planned_attack == Option.Some(enemy));
        // Right-clicking an empty hex in range attacks it too.
        g.handle_context_click(cursor(&g, Hex.new(-4, 1)), screen(), false, false);
        assert(g.units[0].planned_attack == Option.Some(Hex.new(-4, 1)));
        g.handle_map_click(cursor(&g, Hex.new(-5, 0)), screen(), ClickMode.Normal);
        assert(g.units[0].planned_move == Option.Some(Hex.new(-5, 0)));
    });
}

@test
fn shift_right_click_queues_an_attack() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = open_field(&[UnitType.Melee]);
        g.selected = Option.Some(0);
        g.handle_context_click(cursor(&g, Hex.new(-3, 0)), screen(), false, true);
        assert(g.units[0].planned_attack == Option.Some(Hex.new(-3, 0)));
        assert(g.units[0].following_queue);
        g.handle_context_click(cursor(&g, Hex.new(-3, 0)), screen(), false, true);
        assert(g.units[0].queued.len() == 1);
    });
}

@test
fn a_queued_unit_does_not_hold_up_the_turn() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = open_field(&[UnitType.Melee, UnitType.Ranged]);
        g.selected = Option.Some(0);
        assert(g.queue_move(Hex.new(-3, 0)));
        assert(g.queue_move(Hex.new(-2, 0)));
        // No attack queued, but it follows its queue.
        assert(!g.needs_orders(0));
        g.selected = Option.Some(1);
        g.hold_selected_unit();
        let (units, cities) = g.pending();
        assert(units == 0 && cities == 0);

        // Next turn it follows the queue's second turn and still doesn't wait for orders,
        // while the unit that held does, and the turn starts on it.
        play_turn(&mut g);
        assert(g.units[0].planned_move == Option.Some(Hex.new(-2, 0)));
        assert(!g.needs_orders(0));
        assert(g.needs_orders(1));
        assert(g.selected == Option.Some(1));
    });
}

@test
fn a_stray_click_never_replaces_a_queue() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = open_field(&[UnitType.Melee, UnitType.Melee]);
        select(&mut g, &[0, 1]);
        assert(g.queue_move(Hex.new(0, 0)));
        let plans = [g.units[0].plan_len(), g.units[1].plan_len()];
        assert(plans[0] > 1);

        // A click on one hex, then another: both only warn, and the marked hex follows the
        // latest.
        let (a, b) = (Hex.new(-5, 1), Hex.new(-5, 0));
        g.handle_map_click(cursor(&g, a), screen(), ClickMode.Normal);
        assert(g.queue_replace_hex() == Option.Some(a));
        assert(shown_is(&g, "CLICK AGAIN TO REPLACE THEIR QUEUES"));
        g.handle_map_click(cursor(&g, b), screen(), ClickMode.Normal);
        assert(g.queue_replace_hex() == Option.Some(b));
        // A right-click on the marked hex is a different order: still a warning, and nothing
        // replaced yet.
        g.handle_context_click(cursor(&g, b), screen(), false, false);
        assert(g.units[0].plan_len() == plans[0] && g.units[1].plan_len() == plans[1]);
        for i in 0..g.units.len() { assert(g.units[i].planned_attack.is_none()); }

        // Letting go of the group forgets the pending click, and the warning goes away.
        select(&mut g, &[0]);
        assert(g.queue_replace_hex().is_none());
        assert(!shown_has(&g, "CLICK AGAIN"));

        // The same click twice replaces the queue.
        g.handle_map_click(cursor(&g, b), screen(), ClickMode.Normal);
        assert(g.units[0].has_queue());
        assert(shown_is(&g, "CLICK AGAIN TO REPLACE ITS QUEUE"));
        g.handle_map_click(cursor(&g, b), screen(), ClickMode.Normal);
        assert(!g.units[0].has_queue());
        assert(g.units[0].planned_move == Option.Some(b));
        assert(g.queue_replace_hex().is_none());
        assert(!shown_has(&g, "CLICK AGAIN"));
    });
}

/// The orders `any_other_order_cancels_the_queue` tries.
enum Order { ClickMove, RightClickAttack, Guard, Ability, CtrlRightClick, Swap }

/// Gives `order` to the selected unit; answers whether it is a map click, which needs the same
/// click twice (the first only warns). The buttons and keys act at once.
fn give(g: &mut GameState, order: Order) -> bool can {Log, Rand} {
    match order {
        Order.ClickMove => { let at = cursor(&*g, Hex.new(-5, 0)); g.handle_map_click(at, screen(), ClickMode.Normal); true }
        Order.RightClickAttack => { let at = cursor(&*g, Hex.new(-3, 1)); g.handle_context_click(at, screen(), false, false); true }
        Order.Guard => { g.toggle_guard(); false }
        Order.Ability => { g.toggle_selected_ability(); false }
        Order.CtrlRightClick => { g.handle_right_click(); false }
        Order.Swap => { let at = cursor(&*g, Hex.new(-4, 1)); g.handle_map_click(at, screen(), ClickMode.Swap); true }
    }
}

@test
fn any_other_order_cancels_the_queue() {
    sandbox(fn() can {Log, Rand, Assert} {
        let orders = [Order.ClickMove, Order.RightClickAttack, Order.Guard, Order.Ability, Order.CtrlRightClick, Order.Swap];
        for k in 0..6 {
            let mut g = open_field(&[UnitType.Melee, UnitType.Melee]);
            g.selected = Option.Some(0);
            assert(g.queue_move(Hex.new(-3, 0)));
            assert(g.queue_move(Hex.new(-2, 0)));
            if give(&mut g, orders[k]) {
                // One click only warns.
                assert(g.units[0].has_queue());
                let _click = give(&mut g, orders[k]);
            }
            assert(!g.units[0].has_queue());
        }

        // Holding isn't an order: the queue stays.
        let mut g = open_field(&[UnitType.Melee]);
        g.selected = Option.Some(0);
        assert(g.queue_move(Hex.new(-3, 0)));
        assert(g.queue_move(Hex.new(-2, 0)));
        g.hold_selected_unit();
        assert(g.units[0].queued.len() == 1);
    });
}

@test
fn a_group_queues_the_same_number_of_turns_for_every_member() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = open_field(&[UnitType.Melee, UnitType.Cavalry, UnitType.Siege]);
        // Far enough that the whole way fits in one click.
        g.settings.max_queued_turns = 20;
        // One member already has two turns of its own queued.
        g.selected = Option.Some(1);
        assert(g.queue_move(Hex.new(-2, 1)));
        assert(g.queue_move(Hex.new(0, 1)));
        select(&mut g, &[0, 1, 2]);
        let far = Hex.new(4, 0);
        assert(g.queue_move(far));
        let len = g.units[0].plan_len();
        for i in 0..3 { assert(g.units[i].plan_len() == len); }
        // The others set off at once rather than waiting for the cavalry's two turns, and the
        // group went as far as it could in one click.
        assert(g.units[0].planned_move.is_some());
        assert(g.units[2].planned_move.is_some());
        assert(len > 5);
        // Nobody can get any closer.
        assert(!g.queue_move(far));
        let mut arrived = false;
        for i in 0..3 {
            if g.units[i].plan_end() == far { arrived = true; }
            assert(g.units[i].plan_end().distance(far) <= 2);
        }
        assert(arrived);

        // An attack only some can make is still a turn for all of them.
        let end = g.units[2].plan_end();
        let target = Hex.new(end.q + 2, end.r);
        assert(g.grid.is_passable(target));
        // Out of melee reach.
        assert(g.units[0].plan_end().distance(target) > 1);
        assert(g.queue_attack(target));
        let len = g.units[0].plan_len();
        for i in 0..3 { assert(g.units[i].plan_len() == len); }

        // No two members plan to end any turn on the same hex.
        for turn in 1..=len {
            let mut ends: Set[Hex] = Set.new();
            for i in 0..3 { let _new = ends.insert(g.units[i].pos_after(turn)); }
            assert(ends.len() == 3);
        }
    });
}

@test
fn a_unit_added_to_a_queued_group_starts_moving_this_turn() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = open_field(&[UnitType.Melee, UnitType.Ranged]);
        // The melee has three turns of its own queued.
        g.selected = Option.Some(0);
        assert(g.queue_move(Hex.new(-1, 0)));
        let queued = [g.units[0].pos_after(1), g.units[0].pos_after(2), g.units[0].pos_after(3)];
        assert(g.units[0].plan_len() == 3);

        // The ranged unit joins, and the group is sent farther on.
        select(&mut g, &[0, 1]);
        assert(g.queue_move(Hex.new(4, 1)));
        // The new member moves on turn 1, not after the others' queues.
        assert(g.units[1].planned_move.is_some());
        // What the melee had queued is untouched.
        for t in 0..3 { assert(g.units[0].pos_after(t + 1) == queued[t]); }
        assert(g.units[0].plan_len() == g.units[1].plan_len());
        // No two members plan to end any turn on the same hex.
        for turn in 1..=g.units[0].plan_len() { assert(g.units[0].pos_after(turn) != g.units[1].pos_after(turn)); }
    });
}

@test
fn a_group_marches_its_queue_in_step() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = open_field(&[UnitType.Melee, UnitType.Melee, UnitType.Ranged]);
        select(&mut g, &[0, 1, 2]);
        let far = Hex.new(3, 1);
        assert(g.queue_move(far));
        let planned = [g.units[0].plan_end(), g.units[1].plan_end(), g.units[2].plan_end()];
        let turns = g.units[0].plan_len();
        for _t in 0..turns { play_turn(&mut g); }
        // Every member followed its queue.
        for i in 0..3 { assert(g.units[i].pos == planned[i]); }
    });
}

@test
fn an_enemy_seen_on_the_way_stops_the_queue() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = open_field(&[UnitType.Melee]);
        g.selected = Option.Some(0);
        assert(g.queue_move(Hex.new(-3, 0)));
        assert(g.queue_move(Hex.new(-2, 0)));
        // A Red unit the AI leaves alone, standing on next turn's destination.
        g.units.push(Unit.new(200, Hex.new(-2, 0), Team.Red, UnitType.Melee));
        let _new = g.player_controlled_units.insert(200);
        play_turn(&mut g);
        assert(g.units[0].pos == Hex.new(-3, 0));
        assert(!g.units[0].has_queue());
        assert(notice_has(&g, "ENEMY"));
    });
}

@test
fn a_unit_that_misses_its_step_drops_the_rest() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = open_field(&[UnitType.Melee]);
        g.selected = Option.Some(0);
        assert(g.queue_move(Hex.new(-3, 0)));
        assert(g.queue_move(Hex.new(-2, 0)));
        // Someone stands on this turn's destination, so the move bounces.
        g.units.push(Unit.new(200, Hex.new(-3, 0), Team.Red, UnitType.Melee));
        g.fog_of_war = false;
        play_turn(&mut g);
        assert(g.units[0].pos == Hex.new(-4, 0));
        assert(!g.units[0].has_queue());
    });
}

@test
fn a_queue_survives_a_savestate() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = open_field(&[UnitType.Melee]);
        g.selected = Option.Some(0);
        assert(g.queue_move(Hex.new(-3, 0)));
        assert(g.queue_move(Hex.new(-2, 0)));
        g.save_state();
        g.units[0].clear_orders();
        g.load_state();
        assert(g.units[0].queued.len() == 1);
        assert(g.units[0].following_queue);
    });
}

@test
fn a_deploying_siege_plans_its_queue_as_deployed() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = open_field(&[UnitType.Siege]);
        g.selected = Option.Some(0);
        g.toggle_selected_ability();
        assert(g.units[0].ability_queued);
        // Setting up is all it can do this turn, so selection moved on.
        g.selected = Option.Some(0);
        // Deployed next turn: it can't move, but reaches three hexes.
        assert(!g.queue_move(Hex.new(-2, 0)));
        let target = Hex.new(-1, 0);
        assert(g.queue_attack(target));
        // No attack while deploying.
        assert(g.units[0].planned_attack.is_none());
        assert(g.units[0].queued[0].attack == Option.Some(target));
        // Queuing keeps the ability.
        assert(g.units[0].ability_queued);
    });
}

// Drawing a plan.

fn faded(c: Color, a: f32) -> Color { [c[0], c[1], c[2], a] }

fn count_color(vertices: &Vec[MeshVertex], color: Color) -> i32 {
    let mut n = 0;
    for k in 0..vertices.len() {
        let c = vertices[k].color;
        if c[0] == color[0] && c[1] == color[1] && c[2] == color[2] && c[3] == color[3] { n = n + 1; }
    }
    n
}

/// The combat map without fog and nothing hovered, its Blue melee selected.
fn melee_selected() -> GameState can {Log} {
    let mut game = GameState.new();
    game.fog_of_war = false;
    game.hovered_tile = Option.None;
    for i in 0..game.units.len() {
        if game.units[i].team == Team.Blue && game.units[i].unit_type == UnitType.Melee { game.selected = Option.Some(i); }
    }
    game
}

@test
fn a_queue_shows_numbered_turns_only_while_selected_or_hovered() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = melee_selected();
        let Option.Some(melee) = game.selected else { assert(false); return; };
        let start = game.units[melee].pos;
        let first = start.neighbors()[0];
        let second = first.neighbors()[0];
        assert(game.queue_move(first) && game.queue_move(second));
        let line = faded(Team.Blue.color(), QUEUE_LINE_ALPHA);
        let ghost = faded(Team.Blue.color(), GHOST_ALPHA);

        // The path shows, with a ghost where the plan ends.
        let selected = count_color(&game.build_vertices(), line);
        assert(selected > 0);
        assert(count_color(&game.build_vertices(), ghost) > 0);

        // Hidden once let go of.
        game.selected = Option.None;
        assert(count_color(&game.build_vertices(), line) == 0);
        assert(count_color(&game.build_vertices(), ghost) == 0);

        game.hovered_tile = Option.Some(start);
        assert(count_color(&game.build_vertices(), line) == selected);
    });
}

@test
fn two_units_passing_one_hex_get_their_own_numbers() {
    sandbox(fn() can {Log, Rand, Assert} {
        let (shared, a_first, b_last) = (Hex.new(0, 0), Hex.new(-1, 0), Hex.new(1, 0));
        // A reaches the shared hex on turn 2, B on turn 1 and moves on.
        let mut units: Vec[Unit] = Vec.new();
        units.push(Unit.new(1, Hex.new(-2, 0), Team.Blue, UnitType.Melee));
        units[0].planned_move = Option.Some(a_first);
        units[0].following_queue = true;
        units[0].queued.push(TurnOrder { from: a_first, move_to: Option.Some(shared), attack: Option.None });
        units.push(Unit.new(2, Hex.new(0, 2), Team.Blue, UnitType.Cavalry));
        units[1].planned_move = Option.Some(shared);
        units[1].following_queue = true;
        units[1].queued.push(TurnOrder { from: shared, move_to: Option.Some(b_last), attack: Option.None });
        let mut which: Vec[i32] = Vec.new();
        which.push(0);
        which.push(1);
        let plans = queue_plans(&units, &which);

        // No number shared by two units.
        let mut near: Vec[Vec2] = Vec.new();
        for k in 0..plans.badges.len() {
            let badge = &plans.badges[k];
            let t: &Str = &badge.text;
            assert(!str_eq(t, "1,2"));
            if badge.at.distance(shared.to_world()) < HEX_SIZE * 0.8 { near.push(badge.at); }
        }
        // Two numbers near the shared hex, fanned apart.
        assert(near.len() == 2);
        assert(near[0].distance(near[1]) > 0.0);
        // Each plan ends in its own ghost.
        assert(plans.ghosts.len() == 2);
        assert(plans.ghosts[0].at.distance(plans.ghosts[1].at) > 0.0);
    });
}

@test
fn a_queue_of_this_turn_alone_draws_a_plain_ghost_and_arrow() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = melee_selected();
        let Option.Some(melee) = game.selected else { assert(false); return; };
        let first = game.units[melee].pos.neighbors()[0];
        let target = first.neighbors()[0];
        let line = faded(Team.Blue.color(), QUEUE_LINE_ALPHA);
        let ghost = faded(Team.Blue.color(), GHOST_ALPHA);
        let before = count_color(&game.build_vertices(), ATTACK_ARC_COLOR);

        // Shift-clicks that only fill this turn: a move, then an attack from there. Nothing
        // past this turn, so a ghost (not a numbered 1), no plan line, and the attack's plain
        // arrow.
        assert(game.queue_move(first) && game.queue_attack(target));
        assert(game.units[melee].queued.is_empty());
        assert(count_color(&game.build_vertices(), ghost) > 0);
        assert(count_color(&game.build_vertices(), line) == 0);
        assert(count_color(&game.build_vertices(), ATTACK_ARC_COLOR) > before);

        // A second turn switches to the numbered plan.
        let around = first.neighbors();
        let mut next = first;
        for k in 0..6 {
            let h = around[k];
            if next == first && game.grid.is_passable(h) && !game.is_occupied(h) { next = h; }
        }
        assert(next != first);
        assert(game.queue_move(next));
        assert(count_color(&game.build_vertices(), line) > 0);
        // The ghost moves to the plan's end.
        assert(count_color(&game.build_vertices(), ghost) > 0);
    });
}

@test
fn a_far_shift_click_walks_around_a_wall() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = open_field(&[UnitType.Melee]);
        // A wall from (-2, -1) to (-2, 2) along their east edges, so the straight way east is
        // shut and the unit has to go round.
        for r in -1..=2 {
            let across = [Hex.new(-1, r), Hex.new(-1, r - 1)];
            for k in 0..2 { let _w = g.barriers.insert(edge(Hex.new(-2, r), across[k]), Structure { kind: StructureKind.Wall, team: Team.Red }); }
        }
        g.selected = Option.Some(0);
        let far = Hex.new(0, 0);
        assert(g.queue_move(far));
        assert(g.units[0].plan_end() == far);
        // The detour takes longer than the straight line.
        assert(g.units[0].plan_len() > g.units[0].pos.distance(far));
        for turn in 0..g.units[0].plan_len() {
            let (from, to) = (g.units[0].pos_after(turn), g.units[0].pos_after(turn + 1));
            assert(g.can_step(from, to, Team.Blue));
        }
        let turns = g.units[0].plan_len();
        for _ in 0..turns { play_turn(&mut g); }
        assert(g.units[0].pos == far);
    });
}

/// The hexes unit `idx`'s plan moves onto, turn by turn.
fn stops(game: &GameState, idx: i32) -> Vec[Hex] {
    let unit = &game.units[idx];
    let mut out: Vec[Hex] = Vec.new();
    for t in 0..unit.plan_len() { if let Option.Some(h) = unit.move_on_turn(t) { out.push(h); } }
    out
}

fn hex_in(hexes: &Vec[Hex], hex: Hex) -> bool {
    for k in 0..hexes.len() { if hexes[k] == hex { return true; } }
    false
}

fn same_stops(a: &Vec[Hex], b: &Vec[Hex]) -> bool {
    if a.len() != b.len() { return false; }
    for k in 0..a.len() { if a[k] != b[k] { return false; } }
    true
}

fn same_notice(a: &GameState, b: &GameState) -> bool {
    let x: &Str = &a.notice;
    let y: &Str = &b.notice;
    str_eq(x, y)
}

/// The attack of the last queued turn of `unit`'s plan, if it has one.
fn last_attack(unit: &Unit) -> Option[Hex] {
    if unit.queued.is_empty() { return Option.None; }
    unit.queued[unit.queued.len() - 1].attack
}

@test
fn a_queue_goes_around_an_ally_in_its_way() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = open_field(&[UnitType.Melee]);
        g.selected = Option.Some(0);
        assert(g.queue_move(Hex.new(-3, 0)));
        assert(g.queue_move(Hex.new(-2, 0)));
        assert(g.queue_move(Hex.new(-1, 0)));
        // An ally arrives on next turn's destination and stays there: the waypoint under it is
        // as near as the unit gets, and it goes on around it.
        g.units.push(Unit.new(200, Hex.new(-2, 0), Team.Blue, UnitType.Melee));
        play_turn(&mut g);
        assert(g.units[0].pos == Hex.new(-3, 0));
        assert(g.units[0].has_queue());
        assert(g.units[0].plan_end() == Hex.new(-1, 0));
        assert(!hex_in(&stops(&g, 0), Hex.new(-2, 0)));
        assert(g.units[0].waypoints.len() == 1 && g.units[0].waypoints[0] == Hex.new(-1, 0));
    });
}

@test
fn a_steered_unit_turned_back_goes_on_from_where_it_stands() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = open_field(&[UnitType.Melee]);
        g.selected = Option.Some(0);
        let target = Hex.new(0, 0);
        assert(g.queue_move(target));
        // An ally with no orders stops on this turn's destination: the move is turned back, and
        // the queue goes on around it from where the unit stands.
        let dest = g.units[0].planned_move.unwrap_or(target);
        g.units.push(Unit.new(300, dest, Team.Blue, UnitType.Melee));
        g.units[1].holding = true;
        play_turn(&mut g);
        assert(g.units[0].pos == Hex.new(-4, 0));
        assert(g.units[0].has_queue());
        assert(g.units[0].plan_end() == target);
        assert(!hex_in(&stops(&g, 0), dest));
    });
}

@test
fn a_column_keeps_moving_behind_its_leader() {
    sandbox(fn() can {Log, Rand, Assert} {
        // Two in a line, the second right behind the first: planned again each turn, the second
        // follows into the hex the first leaves rather than waiting behind it.
        let mut g = open_field(&[UnitType.Melee, UnitType.Melee]);
        g.units[0].pos = Hex.new(-3, 0);
        g.units[1].pos = Hex.new(-4, 0);
        select(&mut g, &[0, 1]);
        assert(g.queue_move(Hex.new(1, 0)));
        for _ in 0..3 {
            let before = g.units[1].pos;
            play_turn(&mut g);
            assert(g.units[1].pos != before);
            assert(g.units[1].has_queue());
        }
    });
}

@test
fn a_blocked_queue_kept_as_built_is_dropped_and_the_unit_wants_orders() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = open_field(&[UnitType.Melee]);
        g.selected = Option.Some(0);
        assert(g.queue_move(Hex.new(-3, 0)));
        assert(g.queue_move(Hex.new(-2, 0)));
        // An attack in the plan keeps it as it was built.
        assert(g.queue_attack(Hex.new(-1, 0)));
        // An ally arrives on next turn's destination and stays there.
        g.units.push(Unit.new(200, Hex.new(-2, 0), Team.Blue, UnitType.Melee));
        play_turn(&mut g);
        assert(g.units[0].pos == Hex.new(-3, 0));
        assert(!g.units[0].has_queue());
        assert(g.units[0].planned_move.is_none());
        assert(g.needs_orders(0));
        assert(notice_has(&g, "STOPPED"));
    });
}

/// Shift-clicks each of `hexes` on the map, as the player would.
fn shift_click(game: &mut GameState, hexes: &[Hex]) can {Log, Rand} {
    for k in 0..hexes.len() {
        let at = cursor(&*game, hexes[k]);
        game.handle_map_click(at, screen(), ClickMode.QueueMove);
    }
}

fn moves_are(game: &GameState, idx: i32, want: &[Option[Hex]]) -> bool {
    let plan = moves(game, idx);
    if plan.len() != want.len() { return false; }
    for k in 0..want.len() { if plan[k] != want[k] { return false; } }
    true
}

@test
fn shift_clicking_a_queued_stop_takes_it_and_every_later_move_off() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = open_field(&[UnitType.Melee]);
        g.selected = Option.Some(0);
        let path = [Hex.new(-3, 0), Hex.new(-2, 0), Hex.new(-1, 0), Hex.new(0, 0)];
        shift_click(&mut g, &path);
        assert(moves_are(&g, 0, &[Option.Some(path[0]), Option.Some(path[1]), Option.Some(path[2]), Option.Some(path[3])]));

        // A stop in the middle: the move there and everything after go.
        shift_click(&mut g, &[path[1]]);
        assert(moves_are(&g, 0, &[Option.Some(path[0])]));
        assert(notice_is(&g, "TOOK THE MOVE OFF TURN 2 AND ALL AFTER IT"));
        // What's left is still its queue.
        assert(g.units[0].following_queue);
        assert(!g.needs_orders(0));
        // Selection stays.
        assert(g.selected == Option.Some(0));

        // Not a stop any more, so the same hex queues again, and so does a hex beside the stops.
        shift_click(&mut g, &[path[1], Hex.new(-2, 1)]);
        assert(moves_are(&g, 0, &[Option.Some(path[0]), Option.Some(path[1]), Option.Some(Hex.new(-2, 1))]));

        // The last stop: only it goes.
        shift_click(&mut g, &[Hex.new(-2, 1)]);
        assert(moves_are(&g, 0, &[Option.Some(path[0]), Option.Some(path[1])]));
        assert(notice_is(&g, "TOOK THE MOVE OFF TURN 3"));

        // This turn's: nothing is left, and the unit wants orders again.
        shift_click(&mut g, &[path[0]]);
        assert(!g.units[0].has_orders());
        assert(g.needs_orders(0));

        // The ghost of a plain move goes the same way.
        let at = cursor(&g, path[0]);
        g.handle_map_click(at, screen(), ClickMode.Normal);
        assert(g.units[0].planned_move == Option.Some(path[0]));
        g.selected = Option.Some(0);
        shift_click(&mut g, &[path[0]]);
        assert(g.units[0].planned_move.is_none());
    });
}

@test
fn a_hex_stopped_on_twice_loses_its_latest_move_first() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = open_field(&[UnitType.Melee]);
        g.selected = Option.Some(0);
        let (a, b) = (Hex.new(-3, 0), Hex.new(-2, 0));
        assert(g.queue_move(a) && g.queue_move(b) && g.queue_move(a));
        assert(moves_are(&g, 0, &[Option.Some(a), Option.Some(b), Option.Some(a)]));
        assert(g.unqueue_move(a));
        assert(moves_are(&g, 0, &[Option.Some(a), Option.Some(b)]));
        assert(g.unqueue_move(a));
        assert(!g.units[0].has_queue());
        // Nothing heads there now.
        assert(!g.unqueue_move(a));
    });
}

@test
fn a_turns_attack_stays_if_still_in_range_without_its_move() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = open_field(&[UnitType.Ranged]);
        g.selected = Option.Some(0);
        let (a, b) = (Hex.new(-3, 0), Hex.new(-2, 0));
        assert(g.queue_move(a) && g.queue_move(b));
        // Two hexes from `a`, one from `b`: in range either way.
        let near = Hex.new(-1, 0);
        assert(g.queue_attack(near));
        assert(g.unqueue_move(b));
        assert(g.units[0].queued.len() == 1);
        assert(g.units[0].queued[0].from == a && g.units[0].queued[0].move_to.is_none() && g.units[0].queued[0].attack == Option.Some(near));

        // Out of range from `a`: the turn goes with its move.
        assert(g.queue_move(b));
        let far = Hex.new(0, 0);
        assert(g.queue_attack(far));
        assert(g.unqueue_move(b));
        assert(moves_are(&g, 0, &[Option.Some(a), Option.None]));
        // Earlier turns stay.
        assert(g.units[0].attack_on_turn(1) == Option.Some(near));
    });
}

@test
fn landing_craft_cannot_queue_an_attack() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = open_field(&[UnitType.LandingCraft]);
        g.selected = Option.Some(0);
        assert(!g.queue_attack(Hex.new(-3, 0)));
        assert(g.units[0].planned_attack.is_none());
        assert(g.units[0].queued.is_empty());
    });
}

/// `open_field` with the fog of war on and nothing seen yet but what the units see now.
fn fogged_field(types: &[UnitType]) -> GameState can {Log} {
    let mut game = open_field(types);
    game.fog_of_war = true;
    game.memory = Map.new();
    game.explore();
    game
}

/// A flat radius-7 map with, if `walled`, a wall of mountains down the middle (q = 0) but for a
/// gap at its south end; one Blue cavalry at `start`, selected, with the fog on and nothing seen
/// but what it sees.
fn field_in_fog(start: Hex, walled: bool) -> GameState can {Log} {
    let mut game = open_field(&[UnitType.Cavalry]);
    let mut tiles: Vec[(Hex, Tile)] = Vec.new();
    if walled { for r in -7..=5 { tiles.push((Hex.new(0, r), Tile.of(Terrain.Mountains))); } }
    game.grid = HexGrid.new(7, &tiles);
    game.units[0].pos = start;
    game.fog_of_war = true;
    game.memory = Map.new();
    game.explore();
    game.selected = Option.Some(0);
    game
}

@test
fn a_queued_attack_can_target_a_hex_in_the_fog() {
    sandbox(fn() can {Log, Rand, Assert} {
        // Queued moves end at (-2, 0); the melee attacks next door from there.
        let target = Hex.new(-1, 0);
        let mut seen = open_field(&[UnitType.Melee]);
        seen.selected = Option.Some(0);
        assert(seen.queue_move(Hex.new(-2, 0)));
        assert(seen.queue_attack(target));
        assert(last_attack(&seen.units[0]) == Option.Some(target));

        // Never seen: the same plan, and it's carried out.
        let mut unseen = fogged_field(&[UnitType.Melee]);
        assert(!unseen.fog().sees(target) && !unseen.is_explored(target));
        unseen.selected = Option.Some(0);
        assert(unseen.queue_move(Hex.new(-2, 0)));
        assert(unseen.queue_attack(target));
        assert(last_attack(&unseen.units[0]) == Option.Some(target));
        assert(unseen.units[0].queued.len() == seen.units[0].queued.len());
        assert(same_notice(&unseen, &seen));

        // Only in range of where the queue ends, as for a seen hex.
        let mut far = fogged_field(&[UnitType.Melee]);
        far.selected = Option.Some(0);
        assert(far.queue_move(Hex.new(-2, 0)));
        assert(!far.queue_attack(Hex.new(0, 0)));
        assert(notice_is(&far, "OUT OF RANGE THERE"));
    });
}

@test
fn a_queued_attack_on_water_says_who_can_attack_ships() {
    sandbox(fn() can {Log, Rand, Assert} {
        let lake = Hex.new(-3, 0);
        for k in 0..2 {
            let kind = if k == 0 { UnitType.Melee } else { UnitType.Ranged };
            let mut g = open_field(&[kind]);
            let mut tiles: Vec[(Hex, Tile)] = Vec.new();
            tiles.push((lake, Tile.of(Terrain.Lake)));
            g.grid = HexGrid.new(6, &tiles);
            g.selected = Option.Some(0);
            assert(g.queue_attack(lake) == (k == 1));
            if k == 0 { assert(notice_is(&g, SHIPS_NOTICE)); }
        }
    });
}

@test
fn a_queued_path_through_open_fog_keeps_to_the_straight_line() {
    sandbox(fn() can {Log, Rand, Assert} {
        let start = Hex.new(-5, 2);
        let target = Hex.new(5, 0 - 3);
        let mut game = field_in_fog(start, false);
        game.settings.max_queued_turns = 12;
        assert(game.queue_move(target));
        assert(game.units[0].plan_len() == (start.distance(target) + 1) / 2);
        // Every stop is within a hex of the line from start to target, not one direction first
        // and then the other.
        let a = start.to_world();
        let b = target.to_world();
        let step = a.sub(start.neighbors()[0].to_world()).length();
        let stops = stops(&game, 0);
        for k in 0..stops.len() {
            let p = stops[k].to_world();
            let d = b.sub(a);
            let cross = d.x * (p.y - a.y) - d.y * (p.x - a.x);
            let off = (if cross < 0.0 { 0.0 - cross } else { cross }) / d.length();
            assert(off <= step);
        }
    });
}

@test
fn a_queued_path_into_the_fog_goes_by_what_the_player_has_seen() {
    sandbox(fn() can {Log, Rand, Assert} {
        let start = Hex.new(-5, 0);
        let target = Hex.new(5, 0);
        let mut game = field_in_fog(start, true);
        assert(!game.is_explored(Hex.new(0, 0)));
        // The wall no one has seen doesn't count: straight through it, 10 hexes at 2 a turn.
        assert(game.queue_move(target));
        assert(game.units[0].plan_len() == 5);
    });
}

@test
fn a_queue_takes_the_shortest_known_way_again_each_turn() {
    sandbox(fn() can {Log, Rand, Assert} {
        let start = Hex.new(-5, 0);
        let target = Hex.new(5, 0);
        let mut game = field_in_fog(start, true);
        game.settings.max_queued_turns = 12;
        assert(game.queue_move(target));
        let through_the_fog = stops(&game, 0);
        // The fog lifts from the wall (a scout walks by, say): the queue is planned again around
        // it, still to the same hex.
        for r in -7..=5 {
            let h = Hex.new(0, r);
            let sighting = game.sighting(h);
            let _old = game.memory.insert(h, sighting);
        }
        game.replan_queues();
        let around = stops(&game, 0);
        assert(!same_stops(&around, &through_the_fog));
        for k in 0..around.len() { assert(game.grid.is_passable(around[k])); }
        assert(game.units[0].plan_end() == target);
        // The way round is longer.
        assert(game.units[0].plan_len() > 5);
        assert(game.units[0].waypoints.len() == 1 && game.units[0].waypoints[0] == target);
    });
}

@test
fn a_queue_keeps_going_where_it_was_sent_past_the_turn_limit() {
    sandbox(fn() can {Log, Rand, Assert} {
        let start = Hex.new(-5, 0);
        let target = Hex.new(5, 0);
        let mut game = field_in_fog(start, false);
        game.settings.max_queued_turns = 2;
        assert(game.queue_move(target));
        // Cut short at the limit.
        assert(game.units[0].plan_len() == 2);
        // Each turn it's planned again from where it stands, so it gets there in the 5 turns it
        // takes, and is then done.
        for _ in 0..5 { play_turn(&mut game); }
        assert(game.units[0].pos == target);
        assert(!game.units[0].has_queue());
        assert(game.units[0].waypoints.is_empty());
        assert(game.needs_orders(0));
    });
}

@test
fn waypoints_are_visited_in_order_and_dropped_once_reached() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = field_in_fog(Hex.new(-5, 0), false);
        let first = Hex.new(-3, 0 - 2);
        let second = Hex.new(2, 0);
        assert(game.queue_move(first));
        assert(game.queue_move(second));
        assert(game.units[0].waypoints.len() == 2);
        assert(game.units[0].waypoints[0] == first && game.units[0].waypoints[1] == second);
        play_turn(&mut game);
        assert(game.units[0].pos == first);
        assert(game.units[0].waypoints.len() == 1 && game.units[0].waypoints[0] == second);
        assert(game.units[0].plan_end() == second);
    });
}

@test
fn a_plan_with_a_queued_attack_is_kept_as_built() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = field_in_fog(Hex.new(-5, 0), false);
        assert(game.queue_move(Hex.new(-2, 0)));
        assert(game.queue_attack(Hex.new(-1, 0)));
        assert(game.units[0].waypoints.is_empty());
        let plan = stops(&game, 0);
        game.replan_queues();
        assert(same_stops(&stops(&game, 0), &plan));
    });
}
