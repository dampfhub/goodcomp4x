//! Map icons: small pictures of strategic resources and tile improvements, drawn straight on
//! the tile in the hex's top corners, of special tiles and ruins in its bottom-left corner, and
//! of food and production in the yield rows.
//! Each shape is edged in dark so it reads on any terrain. Shapes are laid out in the
//! coordinates of the mockups they were designed in: a hex of radius 100 with Y pointing down,
//! centered on the icon's spot.

use std.fmt.Out;
use std.str.chars;
use std.linalg.Vec2;
use std.linalg.vec2;
use std.linalg.vec2_from_angle;
use std.math.Float;
use std.math.pi;
use std.math.tau;
use renderer.pipelines.MeshVertex;
use game.city.SiteKind;
use game.hex.HEX_SIZE;
use game.mesh.Color;
use game.mesh.outline;
use game.mesh.polygon;
use game.mesh.polyline;
use game.mesh.regular_polygon;
use game.terrain.Resource;
use game.terrain.Special;
use game.text;

/// Hex radius the shapes are laid out on.
const DESIGN_HEX_RADIUS: f32 = 100.0;
/// Sides of the polygons that stand in for circles and ellipses.
const ROUND_SIDES: i32 = 16;

/// Where icons sit, from the hex's center: a resource in the top-right corner, an improvement
/// in the top-left.
pub const RESOURCE_SPOT: Vec2 = Vec2 { x: 0.5, y: 0.40 };
pub const IMPROVEMENT_SPOT: Vec2 = Vec2 { x: -0.5, y: 0.42 };
/// Where a special tile's or ruins' icon sits: the bottom-left corner, drawn `LANDMARK_SCALE`
/// times the usual size so it can be spotted from afar.
pub const LANDMARK_SPOT: Vec2 = Vec2 { x: -0.36, y: -0.5 };
pub const LANDMARK_SCALE: f32 = 1.3;

/// The edge around every shape, the same near-black as unit outlines.
const OUTLINE: Color = [0.03, 0.03, 0.04, 1.0];
// The mockups' colors, converted from sRGB to linear.
const HORSE: Color = [0.32, 0.12, 0.032, 1.0];
const MANE: Color = [0.042, 0.018, 0.006, 1.0];
const STEEL: Color = [0.26, 0.28, 0.31, 1.0];
const STEEL_LIT: Color = [0.55, 0.58, 0.63, 1.0];
const STEEL_SHADE: Color = [0.14, 0.155, 0.18, 1.0];
const WHEAT: Color = [0.87, 0.58, 0.08, 1.0];
const ORE: Color = [0.10, 0.084, 0.08, 1.0];
const CART: Color = [0.155, 0.068, 0.018, 1.0];
const WHEEL: Color = [0.023, 0.023, 0.027, 1.0];
const FRESH_WOOD: Color = [0.58, 0.28, 0.098, 1.0];
const WEATHERED_WOOD: Color = [0.43, 0.195, 0.055, 1.0];
const BARK: Color = [0.254, 0.102, 0.032, 1.0];
const GROWTH_RING: Color = [0.195, 0.08, 0.021, 1.0];
const STONE: Color = [0.42, 0.40, 0.36, 1.0];
const STONE_LIT: Color = [0.68, 0.65, 0.58, 1.0];
const STONE_SHADE: Color = [0.20, 0.19, 0.17, 1.0];
const LEAVES: Color = [0.06, 0.30, 0.05, 1.0];
const FUR: Color = [0.30, 0.17, 0.08, 1.0];
const FRUIT: Color = [0.80, 0.08, 0.04, 1.0];
/// Metal on yield chips and in text: brighter than the Iron deposit's ingot so it reads small.
const METAL: Color = [0.42, 0.46, 0.52, 1.0];
const CLOCK_FACE: Color = [0.80, 0.80, 0.74, 1.0];

/// Characters that stand for an icon in UI text: every text renderer (the classic font and the
/// library UI's) draws the icon in their place, the same pictures as the map's yield chips.
pub const FOOD_ICON: char = '\u{E000}';
pub const WOOD_ICON: char = '\u{E001}';
pub const METAL_ICON: char = '\u{E002}';
pub const TIME_ICON: char = '\u{E003}';

/// The icon `ch` stands for in UI text, if it's one of the icon characters.
pub fn inline_icon(ch: char) -> Option[MapIcon] {
    if ch == FOOD_ICON { Option.Some(MapIcon.Food) }
    else if ch == WOOD_ICON { Option.Some(MapIcon.Wood) }
    else if ch == METAL_ICON { Option.Some(MapIcon.Metal) }
    else if ch == TIME_ICON { Option.Some(MapIcon.Clock) }
    else { Option.None }
}

/// The letter that stands in for an icon character where no text renderer draws the icon.
pub fn icon_letter(ch: char) -> char {
    if ch == FOOD_ICON { 'F' } else if ch == WOOD_ICON { 'W' } else if ch == METAL_ICON { 'M' } else if ch == TIME_ICON { 'T' } else { ch }
}

/// `t` with its icon characters written as letters.
pub fn plain_icons(t: &str) -> Str {
    text(fn() can {Out} { for ch in chars(t) { Out.put_char(icon_letter(*ch)); } })
}

/// Whether `ch` stands for an icon in UI text.
pub fn is_inline_icon(ch: char) -> bool { inline_icon(ch).is_some() }

/// Draws the icon `ch` stands for in UI space (pixels, Y up), `height` pixels tall, centered on
/// `center`. `dim` darkens it to sit in disabled text.
pub fn push_inline_icon(center: Vec2, height: f32, ch: char, dim: bool, out: &mut Vec[MeshVertex]) {
    let Option.Some(icon) = inline_icon(ch) else { return; };
    let start = out.len();
    // The chip icons are laid out about 20 design units tall.
    push_map_icon(center, icon, height * 5.0 / HEX_SIZE, out);
    if dim {
        for k in start..out.len() {
            out[k].color[0] = out[k].color[0] * 0.3;
            out[k].color[1] = out[k].color[1] * 0.3;
            out[k].color[2] = out[k].color[2] * 0.3;
        }
    }
}

pub enum MapIcon {
    /// Horses: a horse's head, facing right.
    HorseHead,
    /// Iron: an ingot, seen from above and to the left.
    Ingot,
    /// Farm: a single stalk of wheat.
    Wheat,
    /// Mine: a cart heaped with ore.
    OreCart,
    /// Pasture: a fence, two posts and two rails.
    Fence,
    /// Lumber mill: three stacked logs.
    Logs,
    /// Food, on a yield chip and in text: a small wheat stalk.
    Food,
    /// Wood, on a yield chip and in text: a leaning log.
    Wood,
    /// Metal, on a yield chip and in text: a small ingot.
    Metal,
    /// Turns, in text: a clock face.
    Clock,
    /// Ruins: two broken columns on a slab.
    Ruins,
    /// Orchard: a fruit tree.
    FruitTree,
    /// Quarry: three cut stone blocks.
    StoneBlocks,
    /// An animal den: a paw print.
    Paw,
}

impl MapIcon {
    pub fn resource(resource: Resource) -> MapIcon {
        match resource { Resource.Horses => MapIcon.HorseHead, Resource.Iron => MapIcon.Ingot }
    }

    pub fn special(special: Special) -> MapIcon {
        match special { Special.Orchard => MapIcon.FruitTree, Special.Quarry => MapIcon.StoneBlocks }
    }

    pub fn improvement(kind: SiteKind) -> MapIcon {
        match kind { SiteKind.Farm => MapIcon.Wheat, SiteKind.Mine => MapIcon.OreCart, SiteKind.Pasture => MapIcon.Fence, SiteKind.LumberMill => MapIcon.Logs }
    }
}

/// Every map icon, and where it's drawn: `(icon, spot, scale)`.
pub const MAP_ICONS: [MapIcon; 10] = [
    MapIcon.HorseHead, MapIcon.Ingot, MapIcon.Wheat, MapIcon.OreCart, MapIcon.Fence, MapIcon.Logs,
    MapIcon.Ruins, MapIcon.FruitTree, MapIcon.StoneBlocks, MapIcon.Paw,
];

/// Draws `icon` centered on `center`, `scale` times its usual size.
pub fn push_map_icon(center: Vec2, icon: MapIcon, scale: f32, out: &mut Vec[MeshVertex]) {
    let pen = MapPen { center, scale: scale * HEX_SIZE / DESIGN_HEX_RADIUS };
    match icon {
        MapIcon.HorseHead => {
            pen.shape(&points(&[vec2(-9.0, 15.0), vec2(-7.0, 1.0), vec2(-3.0, -9.0), vec2(0.0, -16.0), vec2(3.0, -10.0), vec2(13.0, -3.0), vec2(15.0, 3.0), vec2(10.0, 6.0), vec2(2.0, 2.0), vec2(4.0, 15.0)]), HORSE, 3.0, out);
            pen.shape(&ellipse(vec2(4.0, -5.0), 1.5, 1.5, 0.0), OUTLINE, 0.0, out);
            pen.line(&points(&[vec2(-3.0, -9.0), vec2(-9.0, -1.0), vec2(-10.0, 8.0)]), 3.0, MANE, out);
        }
        MapIcon.Ingot => {
            pen.shape(&points(&[vec2(-15.0, 9.0), vec2(-10.0, -3.0), vec2(10.0, -3.0), vec2(15.0, 9.0)]), STEEL, 3.0, out);
            pen.shape(&points(&[vec2(-10.0, -3.0), vec2(-6.0, -10.0), vec2(14.0, -10.0), vec2(10.0, -3.0)]), STEEL_LIT, 3.0, out);
            pen.shape(&points(&[vec2(10.0, -3.0), vec2(14.0, -10.0), vec2(18.0, 2.0), vec2(15.0, 9.0)]), STEEL_SHADE, 3.0, out);
        }
        MapIcon.Wheat => {
            let stem = points(&[vec2(0.0, 14.0), vec2(0.0, -8.0)]);
            pen.line(&stem, 5.5, OUTLINE, out);
            pen.line(&stem, 2.5, WHEAT, out);
            // Pairs of kernels up the head, leaning outward, and one on top.
            let rows = [1.0, -6.0, -13.0];
            for r in 0..3 {
                pen.shape(&ellipse(vec2(-3.5, rows[r]), 3.2, 5.0, -30.0), WHEAT, 2.5, out);
                pen.shape(&ellipse(vec2(3.5, rows[r]), 3.2, 5.0, 30.0), WHEAT, 2.5, out);
            }
            pen.shape(&ellipse(vec2(0.0, -18.0), 3.2, 5.0, 0.0), WHEAT, 2.5, out);
        }
        MapIcon.OreCart => {
            pen.shape(&points(&[vec2(-8.0, -4.0), vec2(-3.0, -12.0), vec2(3.0, -10.0), vec2(7.0, -14.0), vec2(11.0, -5.0)]), ORE, 3.0, out);
            pen.shape(&points(&[vec2(-14.0, -5.0), vec2(14.0, -5.0), vec2(10.0, 8.0), vec2(-10.0, 8.0)]), CART, 3.0, out);
            pen.shape(&ellipse(vec2(-6.0, 11.0), 3.5, 3.5, 0.0), WHEEL, 3.0, out);
            pen.shape(&ellipse(vec2(6.0, 11.0), 3.5, 3.5, 0.0), WHEEL, 3.0, out);
        }
        MapIcon.Fence => {
            let left_post = points(&[vec2(-10.0, 13.0), vec2(-10.0, -12.0)]);
            let right_post = points(&[vec2(10.0, 13.0), vec2(10.0, -12.0)]);
            let top_rail = points(&[vec2(-15.0, -6.0), vec2(15.0, -6.0)]);
            let low_rail = points(&[vec2(-15.0, 4.0), vec2(15.0, 4.0)]);
            pen.line(&left_post, 7.0, OUTLINE, out);
            pen.line(&right_post, 7.0, OUTLINE, out);
            pen.line(&top_rail, 7.0, OUTLINE, out);
            pen.line(&low_rail, 7.0, OUTLINE, out);
            pen.line(&top_rail, 3.5, WEATHERED_WOOD, out);
            pen.line(&low_rail, 3.5, WEATHERED_WOOD, out);
            pen.line(&left_post, 4.0, FRESH_WOOD, out);
            pen.line(&right_post, 4.0, FRESH_WOOD, out);
        }
        MapIcon.Logs => {
            // Back to front: the top log, then the two it rests on. Each runs off to the right
            // from its cut end.
            let ends = [vec2(-8.0, -5.0), vec2(-12.0, 6.0), vec2(-4.0, 6.0)];
            for k in 0..3 {
                let (x, y) = (ends[k].x, ends[k].y);
                let mut side: Vec[Vec2] = Vec.new();
                side.push(vec2(x, y - 5.5));
                for i in 0..=8 {
                    let angle = (-90.0 + 180.0 * i as f32 / 8.0) * pi() as f32 / 180.0;
                    side.push(vec2(x + 12.0 + 2.5 * angle.cos(), y + 5.5 * angle.sin()));
                }
                side.push(vec2(x, y + 5.5));
                pen.shape(&side, BARK, 3.0, out);
                pen.shape(&ellipse(vec2(x, y), 3.0, 5.5, 0.0), FRESH_WOOD, 2.5, out);
                pen.ring(&ellipse(vec2(x, y), 1.2, 2.2, 0.0), 1.2, GROWTH_RING, out);
            }
        }
        // The small resource icons are flat, one color each, thinly edged, so they read at text
        // size.
        MapIcon.Food => {
            // A wheat ear with no edge: a thin stem and well-spaced kernels, so the gaps between
            // them survive at text size.
            pen.line(&points(&[vec2(0.0, 9.5), vec2(0.0, -1.0)]), 1.0, WHEAT, out);
            let rows = [-0.5, -6.0];
            for r in 0..2 {
                pen.shape(&ellipse(vec2(-3.3, rows[r]), 1.6, 2.4, -25.0), WHEAT, 0.0, out);
                pen.shape(&ellipse(vec2(3.3, rows[r]), 1.6, 2.4, 25.0), WHEAT, 0.0, out);
            }
            pen.shape(&ellipse(vec2(0.0, -9.0), 1.6, 2.4, 0.0), WHEAT, 0.0, out);
        }
        MapIcon.Wood => {
            // A plain log, leaning right.
            let log = points(&[vec2(-3.5, 6.0), vec2(3.5, -6.0)]);
            pen.line(&log, 6.2, OUTLINE, out);
            pen.line(&log, 4.0, FRESH_WOOD, out);
        }
        MapIcon.Metal => {
            pen.shape(&points(&[vec2(-8.5, 4.5), vec2(-6.0, -3.5), vec2(6.0, -3.5), vec2(8.5, 4.5)]), METAL, 1.2, out);
        }
        MapIcon.Clock => {
            // An open ring with two hands, all in one color.
            pen.ring(&ellipse(vec2(0.0, 0.0), 7.5, 7.5, 0.0), 1.0, CLOCK_FACE, out);
            pen.line(&points(&[vec2(0.0, 0.0), vec2(0.0, -4.5)]), 1.0, CLOCK_FACE, out);
            pen.line(&points(&[vec2(0.0, 0.0), vec2(3.5, 0.0)]), 1.0, CLOCK_FACE, out);
        }
        MapIcon.Ruins => {
            pen.shape(&points(&[vec2(-16.0, 8.0), vec2(16.0, 8.0), vec2(16.0, 13.0), vec2(-16.0, 13.0)]), STONE_SHADE, 2.5, out);
            // A whole column with its capital, and a broken one.
            pen.shape(&points(&[vec2(-12.0, -9.0), vec2(-5.0, -9.0), vec2(-5.0, 8.0), vec2(-12.0, 8.0)]), STONE, 2.5, out);
            pen.shape(&points(&[vec2(-14.0, -13.0), vec2(-3.0, -13.0), vec2(-3.0, -9.0), vec2(-14.0, -9.0)]), STONE_LIT, 2.5, out);
            pen.shape(&points(&[vec2(4.0, -2.0), vec2(7.0, 1.0), vec2(9.0, -4.0), vec2(11.0, -1.0), vec2(11.0, 8.0), vec2(4.0, 8.0)]), STONE, 2.5, out);
        }
        MapIcon.FruitTree => {
            pen.shape(&points(&[vec2(-2.0, 2.0), vec2(2.0, 2.0), vec2(3.0, 13.0), vec2(-3.0, 13.0)]), BARK, 2.5, out);
            pen.shape(&ellipse(vec2(0.0, -5.0), 13.0, 10.0, 0.0), LEAVES, 2.5, out);
            let fruit = [vec2(-6.0, -6.0), vec2(5.0, -8.0), vec2(1.0, -1.0), vec2(7.0, -1.0)];
            for k in 0..4 { pen.shape(&ellipse(fruit[k], 2.4, 2.4, 0.0), FRUIT, 1.2, out); }
        }
        MapIcon.StoneBlocks => {
            let corners = [vec2(-14.0, 2.0), vec2(1.0, 2.0), vec2(-6.5, -9.0)];
            for k in 0..3 {
                let (x, y) = (corners[k].x, corners[k].y);
                pen.shape(&points(&[vec2(x, y), vec2(x + 13.0, y), vec2(x + 13.0, y + 10.0), vec2(x, y + 10.0)]), STONE, 2.5, out);
                pen.shape(&points(&[vec2(x, y), vec2(x + 13.0, y), vec2(x + 13.0, y + 3.0), vec2(x, y + 3.0)]), STONE_LIT, 0.0, out);
            }
        }
        MapIcon.Paw => {
            pen.shape(&ellipse(vec2(0.0, 5.0), 8.5, 7.0, 0.0), FUR, 2.5, out);
            let toes = [vec2(-10.0, -4.0), vec2(-4.0, -10.0), vec2(4.0, -10.0), vec2(10.0, -4.0)];
            for k in 0..4 { pen.shape(&ellipse(toes[k], 3.4, 3.8, 0.0), FUR, 2.0, out); }
        }
    }
}

/// `list` as a `Vec`.
fn points(list: &[Vec2]) -> Vec[Vec2] {
    let mut out: Vec[Vec2] = Vec.new();
    for i in 0..list.len() { out.push(list[i]); }
    out
}

/// Points around an ellipse centered on `center`, turned by `degrees` (clockwise on screen, as
/// SVG's `rotate` with Y down).
fn ellipse(center: Vec2, rx: f32, ry: f32, degrees: f32) -> Vec[Vec2] {
    let turn = vec2_from_angle(degrees * pi() as f32 / 180.0);
    let mut out: Vec[Vec2] = Vec.new();
    for i in 0..ROUND_SIDES {
        let angle = tau() as f32 * i as f32 / ROUND_SIDES as f32;
        let (x, y) = (rx * angle.cos(), ry * angle.sin());
        out.push(vec2(center.x + x * turn.x - y * turn.y, center.y + x * turn.y + y * turn.x));
    }
    out
}

/// Draws shapes given in design coordinates, scaled onto the map.
struct MapPen {
    center: Vec2,
    /// World units per design unit.
    scale: f32,
}

impl MapPen {
    fn at(&self, p: Vec2) -> Vec2 { self.center.add(vec2(p.x, -p.y).scale(self.scale)) }

    fn world(&self, design: &Vec[Vec2]) -> Vec[Vec2] {
        let mut out: Vec[Vec2] = Vec.new();
        for i in 0..design.len() { out.push(self.at(design[i])); }
        out
    }

    /// A filled outline, edged in dark `edge` wide (half of it outside).
    fn shape(&self, design: &Vec[Vec2], fill: Color, edge: f32, out: &mut Vec[MeshVertex]) {
        let corners = self.world(design);
        if edge > 0.0 { outline(&corners, edge * self.scale, OUTLINE, out); }
        polygon(&corners, fill, out);
    }

    /// Just the outline through `design`, `width` wide.
    fn ring(&self, design: &Vec[Vec2], width: f32, color: Color, out: &mut Vec[MeshVertex]) {
        let corners = self.world(design);
        outline(&corners, width * self.scale, color, out);
    }

    /// A line through `design` with rounded ends.
    fn line(&self, design: &Vec[Vec2], width: f32, color: Color, out: &mut Vec[MeshVertex]) {
        let corners = self.world(design);
        polyline(&corners, width * self.scale, color, out);
        let n = corners.len();
        if n > 0 {
            let radius = width / 2.0 * self.scale;
            regular_polygon(corners[0], radius, ROUND_SIDES as u32, 0.0, color, out);
            regular_polygon(corners[n - 1], radius, ROUND_SIDES as u32, 0.0, color, out);
        }
    }
}
