//! Turn resolution: queued orders play out step by step, in an order set by each unit type's
//! role. All units in a step act simultaneously.

use std.collections.Map;
use std.core.Eq;
use std.core.Keep;
use std.fmt.Show;
use std.fmt.show_f64_fixed;
use std.fmt.show_u64;
use std.rand.Rand;
use log.Log;
use log.info;
use game.GameState;
use game.animals.Hunt;
use game.Step;
use game.reachable_by;
use game.city.BARRACKS_DEFENSE;
use game.city.Building;
use game.AI_TEAM;
use game.ability.Ability;
use game.ability.VOLLEY_DAMAGE;
use game.combat.retaliates;
use game.combat.shore_scale;
use game.combat.damage as blow_damage;
use game.combat.damage_against;
use game.combat.show_hp;
use game.combat.show_note;
use game.effects.Effect;
use game.effects.Outcome;
use game.hex.Hex;
use game.unit.Unit;
use game.unit.UnitType;

/// Seconds between steps while a turn plays out, and how long the units that just acted stay
/// highlighted. Staggering steps makes the order legible.
const STEP_INTERVAL: f32 = 0.6;
const HIGHLIGHT_DURATION: f32 = 0.4;
/// A Coastal Battery's shot at a ship, and its defense against attacks.
const BATTERY_ATTACK: f32 = 28.0;
const BATTERY_DEFENSE: f32 = 18.0;

pub enum Phase { Move, Attack }

impl Show for Phase {
    fn show(&self) can {Out} {
        match *self { Phase.Move => Out.put("Move"), Phase.Attack => Out.put("Attack") }
    }
}

/// When each unit type moves and attacks within a turn:
/// - Scouts move first, slipping away before anyone else acts, and poke in alongside the ranged
///   volley.
/// - Cavalry moves before anyone attacks, so it can't be caught mid-charge.
/// - Ranged fires before melee closes in, then repositions (shoot, then move).
/// - Melee moves and fights in the middle, screening for ranged and siege.
/// - Animals (`animals.tua`) act beside their like: wolves after cavalry, bears after melee.
/// - Siege is slow: it moves and fires last, and may die before it acts.
pub const RESOLUTION_ORDER: [(UnitType, Phase); 22] = [
    (UnitType.Scout, Phase.Move),
    (UnitType.Cavalry, Phase.Move),
    (UnitType.Wolf, Phase.Move),
    (UnitType.Melee, Phase.Move),
    (UnitType.Bear, Phase.Move),
    (UnitType.Ranged, Phase.Attack),
    (UnitType.Scout, Phase.Attack),
    (UnitType.Cavalry, Phase.Attack),
    (UnitType.Wolf, Phase.Attack),
    (UnitType.Melee, Phase.Attack),
    (UnitType.Bear, Phase.Attack),
    (UnitType.Ranged, Phase.Move),
    (UnitType.Siege, Phase.Move),
    (UnitType.Siege, Phase.Attack),
    (UnitType.Armored, Phase.Move),
    (UnitType.Armored, Phase.Attack),
    (UnitType.PatrolGalley, Phase.Move),
    (UnitType.LandingCraft, Phase.Move),
    (UnitType.BombardShip, Phase.Move),
    (UnitType.PatrolGalley, Phase.Attack),
    (UnitType.LandingCraft, Phase.Attack),
    (UnitType.BombardShip, Phase.Attack),
];

/// Whether `unit_type`'s move step comes before its attack step, so it attacks from where its
/// move takes it (ranged shoot, then move).
pub fn moves_before_attacking(unit_type: UnitType) -> bool {
    let mut move_at = 99;
    let mut attack_at = 99;
    for i in 0..22 {
        let (t, p) = RESOLUTION_ORDER[i];
        if t != unit_type { continue; }
        if p == Phase.Move { move_at = i; } else { attack_at = i; }
    }
    move_at < attack_at
}

/// One step of a turn: a unit type's moves or attacks, or, after all of those, the workers'
/// (`workers.tua`). Workers go last so they're exposed: they walk and work only once every unit
/// has acted.
pub enum TurnStep { Units(UnitType, Phase), Workers }

impl Eq for TurnStep {
    fn eq(self, other: TurnStep) -> bool {
        match (self, other) {
            (TurnStep.Units(a, p), TurnStep.Units(b, q)) => a == b && p == q,
            (TurnStep.Workers, TurnStep.Workers) => true,
            _ => false,
        }
    }
}

/// Where `unit_type` falls (1 = first) among all the steps of `phase`. Every unit type has a
/// move and an attack step, which a test checks, so the `0` after the loop is never reached.
pub fn step_rank(unit_type: UnitType, phase: Phase) -> u32 {
    let mut rank = 0;
    for i in 0..22 {
        let (t, p) = RESOLUTION_ORDER[i];
        if p == phase {
            rank = rank + 1;
            if t == unit_type { return rank; }
        }
    }
    0
}

/// One attacker striking one defender within an attack step.
struct Engagement {
    attacker: i32,
    defender: i32,
    /// Multiplier on the damage dealt, below 1 for volley hits.
    damage_scale: f32,
}

impl GameState {
    pub fn is_resolving(&self) -> bool { !self.pending_steps.is_empty() }

    /// Plans the AI's turn, then queues every step for `update` to play out. Called after the
    /// player explicitly ends planning.
    pub fn resolve_turn(&mut self) can {Log} {
        if self.is_resolving() { return; }
        self.turn = self.turn + 1;
        let turn = self.turn;
        info(fn() can {Out} { Out.put("=== resolving turn "); show_u64(turn as u64); Out.put(" ==="); });
        // Indices shift as units die, so nothing stays selected. Nothing armed while planning
        // outlives the turn: an armed map action, a Disband waiting to be confirmed, a click
        // waiting to replace a queue.
        self.selected = Option.None;
        self.group.clear();
        self.ui_click_mode = Option.None;
        self.disband_armed = Option.None;
        self.queue_replace_armed = Option.None;

        let teams = self.ai_teams();
        for t in 0..teams.len() { self.plan_ai_turn(teams[t]); }
        self.end_broken_alerts();
        for i in 0..22 {
            let (unit_type, phase) = RESOLUTION_ORDER[i];
            self.pending_steps.push_back(TurnStep.Units(unit_type, phase));
        }
        self.pending_steps.push_back(TurnStep.Workers);

        // Pause before the first step so the last order placed can be seen.
        self.step_timer = STEP_INTERVAL;
    }

    /// Where unit `idx`, on alert, fires in its attack step: at an enemy unit within its attack
    /// range as the step starts, on the real board (the same on every machine, whatever each
    /// player sees). So it hits whatever ended an earlier move step in range, this turn or
    /// before. Only units, never a city, barracks, battery or worker, and only ones it may
    /// attack (`attack_target_legal`: a ship only by a troop that can hit ships). The nearest,
    /// then the weakest (fewest HP), then the lowest (q, r, id). None if it isn't on alert, has
    /// an attack planned, can't attack this step (locked in a contested hex, setting up) or has
    /// nobody in range.
    pub fn alert_target(&self, idx: i32) -> Option[Hex] {
        let unit = &self.units[idx];
        if !unit.alert || unit.planned_attack.is_some() || !self.can_go_on_alert(idx) { return Option.None; }
        let range = unit.stats().attack_range;
        let mut best: Option[i32] = Option.None;
        for k in 0..self.units.len() {
            let other = &self.units[k];
            if other.team == unit.team || unit.pos.distance(other.pos) > range { continue; }
            if !self.attack_target_legal(idx, other.pos, false) { continue; }
            let better = match best {
                Option.None => true,
                Option.Some(b) => {
                    let held = &self.units[b];
                    let (da, db) = (unit.pos.distance(other.pos), unit.pos.distance(held.pos));
                    if da != db { da < db }
                    else if other.hp != held.hp { other.hp < held.hp }
                    else if other.pos.q != held.pos.q { other.pos.q < held.pos.q }
                    else if other.pos.r != held.pos.r { other.pos.r < held.pos.r }
                    else { other.id < held.id }
                }
            };
            if better { best = Option.Some(k); }
        }
        match best { Option.Some(k) => Option.Some(self.units[k].pos), Option.None => Option.None }
    }

    /// As the turn starts to resolve, ends the alert of any unit with another order this turn
    /// (an alert unit stays put; the AI, playing a side a player left, gives orders without
    /// knowing of alerts) or that can no longer keep it (a siege packing up).
    fn end_broken_alerts(&mut self) {
        for i in 0..self.units.len() {
            if self.units[i].alert && (self.units[i].has_turn_orders() || !self.can_go_on_alert(i)) { self.units[i].alert = false; }
        }
    }

    /// Advances turn playback by `dt` seconds, playing the next step once `STEP_INTERVAL` has
    /// passed. Steps where nobody acts are skipped.
    pub fn update(&mut self, dt: f32) can {Log, Rand} {
        self.explore();
        self.camera.update(dt);
        self.age_effects(dt);
        self.highlight_timer = self.highlight_timer - dt;
        if self.highlight_timer <= 0.0 { self.recent_actors.clear(); }

        if !self.is_resolving() { return; }
        self.step_timer = self.step_timer - dt;
        // With instant playback (a debug setting) every step resolves at once, still in
        // order, so the outcome is the same.
        if self.step_timer > 0.0 && !self.settings.instant_playback { return; }

        if self.settings.instant_playback { self.recent_actors.clear(); }
        while let Option.Some(step) = self.pending_steps.pop_front() {
            let actors = match step {
                TurnStep.Units(unit_type, phase) => self.resolve_step(unit_type, phase),
                TurnStep.Workers => self.resolve_workers(),
            };
            if !actors.is_empty() {
                self.highlight_timer = HIGHLIGHT_DURATION;
                if self.settings.instant_playback {
                    for a in 0..actors.len() { self.recent_actors.push(actors[a]); }
                    continue;
                }
                self.recent_actors = actors;
                self.step_timer = STEP_INTERVAL;
                break;
            }
        }

        if !self.is_resolving() {
            self.resolve_coastal_batteries();
            self.resolve_transport();
            self.resolve_city_interiors();
            // Before the economy, so a city reward is spent (or capped) like the turn's own
            // income.
            self.resolve_ruins();
            // Dens are cleared and their animals come back (`animals.tua`).
            self.resolve_dens();
            self.resolve_economy();
            for i in 0..self.units.len() {
                if self.units[i].ability_queued && self.units[i].ability() == Ability.Deploy {
                    let unit = &self.units[i];
                    let state = if unit.deployed { "packed up" } else { "set up" };
                    info(fn() can {Out} { unit.show(); Out.put(" has "); Out.put(state); });
                }
                self.units[i].end_turn();
            }
            self.advance_queues();
            let turn = self.turn;
            info(fn() can {Out} { Out.put("=== turn "); show_u64(turn as u64); Out.put(" resolved ==="); });
            // Planning begins: the player's queues go on from what they now know.
            self.replan_queues();
            self.select_next_needing_attention(Option.None);
        }
    }

    /// After the steps: each standing Coastal Battery fires at the nearest hostile ship within 2
    /// tiles, the lowest id among equals.
    pub fn resolve_coastal_batteries(&mut self) can {Rand, Log} {
        let mut hits: Vec[f32] = Vec.new();
        for _ in 0..self.units.len() { hits.push(0.0); }
        let mut shots: Vec[Effect] = Vec.new();
        for c in 0..self.cities.len() {
            let city = &self.cities[c];
            let Option.Some(site) = city.placed_site(Building.CoastalBattery) else { continue; };
            if city.coastal_battery_hp <= 0.0 { continue; }
            let team = city.team;
            let mut target: Option[i32] = Option.None;
            for i in 0..self.units.len() {
                let unit = &self.units[i];
                if unit.team == team || !unit.is_naval() || site.distance(unit.pos) > 2 { continue; }
                let better = match target {
                    Option.None => true,
                    Option.Some(t) => {
                        let (d, td) = (site.distance(unit.pos), site.distance(self.units[t].pos));
                        d < td || (d == td && unit.id < self.units[t].id)
                    }
                };
                if better { target = Option.Some(i); }
            }
            let Option.Some(t) = target else { continue; };
            let hit = damage_against(BATTERY_ATTACK, self.units[t].stats().defense);
            hits[t] = hits[t] + hit;
            {
                let id = self.cities[c].id;
                let target = &self.units[t];
                info(fn() can {Out} { Out.put("city "); show_u64((id + 1) as u64); Out.put("'s coastal battery hits "); target.show(); Out.put(" for "); show_f64_fixed(hit as f64, 0); });
            }
            shots.push(Effect.Shot(site.to_world(), self.units[t].pos.to_world(), Outcome.Hit));
        }
        for s in 0..shots.len() { self.play(shots[s]); }
        for i in 0..self.units.len() {
            if hits[i] > 0.0 {
                let at = self.unit_layout(i).0;
                let fatal = self.units[i].hp <= hits[i];
                self.play(Effect.Damage(at, hits[i], fatal));
            }
        }
        for i in 0..self.units.len() {
            if hits[i] > 0.0 {
                let hp = self.units[i].hp - hits[i];
                self.units[i].hp = if hp > 0.0 { hp } else { 0.0 };
                let unit = &self.units[i];
                info(fn() can {Out} { Out.put("  "); unit.show(); Out.put(": "); show_hp(unit); });
            }
        }
        handle { self.units.retain(); } with Keep[Unit] { keep(u) => { resume u.is_alive() } }
        self.discard_interior_copies_of_dead_units();
    }

    /// After combat: each landing craft told to unload puts its first passenger on the open
    /// shore hex it was given, then each troop told to board a friendly landing craft beside
    /// it, with room for it (four at most), goes aboard. A ship sunk this turn is gone, so
    /// nobody boards or leaves it.
    pub fn resolve_transport(&mut self) {
        // Troops leaving their craft, in the order they land.
        let mut landed: Vec[Unit] = Vec.new();
        for s in 0..self.units.len() {
            let Option.Some(dest) = self.units[s].planned_unload else { continue; };
            self.units[s].planned_unload = Option.None;
            let ship = &self.units[s];
            let fits = ship.unit_type == UnitType.LandingCraft
                && ship.pos.distance(dest) == 1
                && self.grid.is_passable(dest)
                && !self.is_occupied(dest)
                && self.city_at(dest).is_none();
            if !fits || self.units[s].cargo.is_empty() { continue; }
            let mut passenger = self.units[s].cargo.remove(0);
            passenger.pos = dest;
            passenger.clear_orders();
            landed.push(passenger);
        }
        push_in_order(&mut landed, &mut self.units);
        // Last first, so boarding (which takes the troop out of the list) leaves the indices
        // still to visit where they were.
        let mut i = self.units.len();
        while i > 0 {
            i = i - 1;
            let Option.Some(ship_id) = self.units[i].planned_board else { continue; };
            self.units[i].planned_board = Option.None;
            let Option.Some(ship) = self.index_of_unit(ship_id) else { continue; };
            let fits = self.units[ship].unit_type == UnitType.LandingCraft
                && self.units[ship].team == self.units[i].team
                && self.units[ship].pos.distance(self.units[i].pos) == 1
                && self.units[ship].cargo.len() < 4;
            if !fits { continue; }
            let mut boarding: Vec[Unit] = Vec.new();
            let mut passenger = self.units.remove(i);
            passenger.clear_orders();
            boarding.push(passenger);
            let Option.Some(ship) = self.index_of_unit(ship_id) else { continue; };
            push_in_order(&mut boarding, &mut self.units[ship].cargo);
        }
    }

    /// Where the unit with `id` is in the list.
    fn index_of_unit(&self, id: u32) -> Option[i32] {
        for i in 0..self.units.len() { if self.units[i].id == id { return Option.Some(i); } }
        Option.None
    }

    /// Resolves one step, returning the ids of the units that acted in it.
    pub fn resolve_step(&mut self, unit_type: UnitType, phase: Phase) -> Vec[u32] can {Log, Rand} {
        // Animals decide as their step begins, on the board as it is then.
        if unit_type.is_animal() {
            match phase {
                Phase.Move => self.plan_animal_moves(unit_type),
                Phase.Attack => self.plan_animal_attacks(unit_type),
            }
        }
        let mut actors: Vec[i32] = Vec.new();
        for i in 0..self.units.len() {
            if self.units[i].unit_type != unit_type { continue; }
            let acts = match phase {
                Phase.Move => self.units[i].planned_move.is_some(),
                // Units in a contested hex fight whether or not they have orders, and units on
                // alert fire at an enemy in range.
                Phase.Attack => self.units[i].planned_attack.is_some() || self.rival_of(i).is_some() || self.alert_target(i).is_some(),
            };
            if acts { actors.push(i); }
        }
        // A swap partner moves together with its ally, even if its own type moves later.
        if phase == Phase.Move {
            let movers = actors.len();
            for m in 0..movers {
                if let Option.Some(partner) = self.swap_partner(actors[m]) {
                    if !actors.contains(partner) { actors.push(partner); }
                }
            }
        }
        let mut ids: Vec[u32] = Vec.new();
        if actors.is_empty() { return ids; }

        info(fn() can {Out} { Out.put("-- "); unit_type.show(); Out.put(" "); phase.show(); Out.put(" --"); });
        for a in 0..actors.len() { ids.push(self.units[actors[a]].id); }
        match phase {
            Phase.Move => self.resolve_moves(&actors),
            Phase.Attack => self.resolve_attacks(&actors),
        }
        ids
    }

    /// Moves `movers` simultaneously:
    /// - Two enemies heading for the same hex both take it, contesting it. Any other pile-up
    ///   on one hex bounces everyone involved.
    /// - Enemies can't swap places by moving through each other; allies can.
    /// - A unit can move into a hex whose occupants are all leaving this step, so chains and
    ///   rotations work, but not one where anyone stays put.
    fn resolve_moves(&mut self, movers: &Vec[i32]) can {Log} {
        let n = movers.len();
        let mut dests: Vec[Hex] = Vec.new();
        let mut moving: Vec[bool] = Vec.new();
        for m in 0..n {
            let unit = &self.units[movers[m]];
            let dest = unit.planned_move.unwrap_or(unit.pos);
            dests.push(dest);
            // A wall, or someone else's gate, turns a move back if no way around it is left
            // within the unit's move, e.g. one planned before the player saw the wall.
            let open = self.move_still_open(movers[m], dest);
            if !open {
                info(fn() can {Out} { unit.show(); Out.put(" move blocked: a wall stands in the way to "); dest.show(); });
            }
            moving.push(open);
        }

        // Every destination with the movers claiming it, in first-claim order.
        let mut contests: Vec[(i32, i32, Hex)] = Vec.new();
        let mut seen: Vec[Hex] = Vec.new();
        for m in 0..n {
            let dest = dests[m];
            if seen.contains(dest) { continue; }
            seen.push(dest);
            let mut claimants: Vec[i32] = Vec.new();
            for k in m..n {
                if dests[k] == dest { claimants.push(k); }
            }
            if claimants.len() == 1 { continue; }
            let (a, b) = (claimants[0], if claimants.len() > 1 { claimants[1] } else { claimants[0] });
            if claimants.len() == 2 && self.units[movers[a]].team != self.units[movers[b]].team {
                contests.push((a, b, dest));
            } else {
                let units = &self.units;
                info(fn() can {Out} {
                    for c in 0..claimants.len() {
                        if c > 0 { Out.put(" and "); }
                        units[movers[claimants[c]]].show();
                    }
                    Out.put(" collide at ");
                    dest.show();
                    Out.put("; none of them moves");
                });
                for c in 0..claimants.len() { moving[claimants[c]] = false; }
            }
        }

        let mut swaps: Vec[(i32, i32)] = Vec.new();
        for a in 0..n {
            for b in a + 1..n {
                let unit_a = &self.units[movers[a]];
                let unit_b = &self.units[movers[b]];
                if dests[a] != unit_b.pos || dests[b] != unit_a.pos { continue; }
                if unit_a.team == unit_b.team {
                    swaps.push((a, b));
                } else {
                    info(fn() can {Out} { unit_a.show(); Out.put(" and "); unit_b.show(); Out.put(" can't move through each other"); });
                    moving[a] = false;
                    moving[b] = false;
                }
            }
        }

        // A move is blocked if anyone in the destination hex isn't moving away. Each block
        // can strand another mover, so repeat until nothing changes.
        loop {
            let mut changed = false;
            for m in 0..n {
                if !moving[m] { continue; }
                if let Option.Some(occupant) = self.staying_occupant(dests[m], movers, &moving) {
                    let who = &self.units[movers[m]];
                    let holder = &self.units[occupant];
                    info(fn() can {Out} { who.show(); Out.put(" move blocked: "); holder.show(); Out.put(" holds the hex"); });
                    moving[m] = false;
                    changed = true;
                }
            }
            if !changed { break; }
        }

        for s in 0..swaps.len() {
            let (a, b) = swaps[s];
            if moving[a] && moving[b] {
                let ua = &self.units[movers[a]];
                let ub = &self.units[movers[b]];
                info(fn() can {Out} { ua.show(); Out.put(" and "); ub.show(); Out.put(" swap places"); });
            }
        }
        for m in 0..n {
            if moving[m] && self.rival_of(movers[m]).is_some() {
                let unit = &self.units[movers[m]];
                info(fn() can {Out} { unit.show(); Out.put(" withdraws from the contested hex at "); unit.pos.show(); });
            }
        }
        for c in 0..contests.len() {
            let (a, b, dest) = contests[c];
            if moving[a] && moving[b] {
                let ua = &self.units[movers[a]];
                let ub = &self.units[movers[b]];
                info(fn() can {Out} { ua.show(); Out.put(" and "); ub.show(); Out.put(" clash at "); dest.show(); Out.put("; the hex is contested"); });
            }
        }

        // Every mover's order is spent, whether or not it got through.
        for m in 0..n {
            let i = movers[m];
            if moving[m] { self.units[i].pos = dests[m]; }
            self.units[i].planned_move = Option.None;
        }
        // Stepping onto an enemy worker captures it.
        self.capture_workers();
    }

    /// Whether unit `i` can still reach `dest` this step, walls, others' gates and ground (or
    /// water, for a ship) allowing, or by rail.
    fn move_still_open(&self, i: i32, dest: Hex) -> bool {
        let unit = &self.units[i];
        let range = if unit.stats().move_range > 1 { unit.stats().move_range } else { 1 };
        let naval = unit.is_naval();
        let team = unit.team;
        let reach = handle { reachable_by(unit.pos, range) } with Step {
            open(from, to) => { resume if naval { self.grid.contains(to) && self.grid.terrain(to).is_water() } else { self.can_step(from, to, team) } }
        };
        reach.contains(dest) || self.rail_transfer_available(unit.pos, dest, team)
    }

    /// A unit in `hex` that is not one of `movers` moving away this step.
    fn staying_occupant(&self, hex: Hex, movers: &Vec[i32], moving: &Vec[bool]) -> Option[i32] {
        for i in 0..self.units.len() {
            if self.units[i].pos != hex { continue; }
            let mut leaving = false;
            for m in 0..movers.len() {
                if movers[m] == i && moving[m] { leaving = true; }
            }
            if !leaving { return Option.Some(i); }
        }
        Option.None
    }

    /// Resolves `attackers` simultaneously: every attack sees the board as it was at the start
    /// of the step and damage lands at the end, so a unit killed this step still gets its own
    /// attack off. An attack hits whichever enemy occupies the target hex now, not necessarily
    /// the one there at planning time. A unit in a contested hex fights its rival instead.
    pub fn resolve_attacks(&mut self, attackers: &Vec[i32]) can {Log, Rand} {
        let mut engagements: Vec[Engagement] = Vec.new();
        // Workers the step kills, by id.
        let mut killed_workers: Vec[u32] = Vec.new();
        // Attacks on a Barracks or a Coastal Battery: (attacker, city, damage scale).
        let mut barracks_hits: Vec[(i32, i32, f32)] = Vec.new();
        let mut battery_hits: Vec[(i32, i32, f32)] = Vec.new();
        // Each attack's animation, played once the step's damage is known.
        let mut shots: Vec[Effect] = Vec.new();
        for k in 0..attackers.len() {
            let a = attackers[k];
            let attacker = &self.units[a];
            let from = self.unit_layout(a).0;
            if let Option.Some(rival) = self.rival_of(a) {
                if attacker.planned_attack.is_some() {
                    info(fn() can {Out} { attacker.show(); Out.put(" is locked in its contested hex and can't attack elsewhere"); });
                }
                engagements.push(Engagement { attacker: a, defender: rival, damage_scale: 1.0 });
                shots.push(Effect.Shot(from, self.unit_layout(rival).0, Outcome.Hit));
                continue;
            }

            let target = match attacker.planned_attack {
                Option.Some(target) => target,
                Option.None => {
                    let Option.Some(target) = self.alert_target(a) else { continue; };
                    info(fn() can {Out} { attacker.show(); Out.put(" is on alert and fires at "); target.show(); });
                    target
                }
            };
            let to = target.to_world();
            if self.empty_city_target(target, attacker.team) {
                shots.push(Effect.Shot(from, to, Outcome.Miss));
                continue;
            }
            if !self.attack_target_legal(a, target, false) { continue; }
            if attacker.pos.distance(target) > attacker.stats().attack_range {
                info(fn() can {Out} { attacker.show(); Out.put("'s attack canceled: target out of range after moves"); });
                shots.push(Effect.Shot(from, to, Outcome.OutOfRange));
                continue;
            }

            let volley = attacker.ability_queued && attacker.ability() == Ability.Volley;
            let scale = if volley { VOLLEY_DAMAGE } else { 1.0 };
            let mut hit_any = false;
            if let Option.Some(d) = self.enemy_of_team_at(target, attacker.team) {
                engagements.push(Engagement { attacker: a, defender: d, damage_scale: scale });
                hit_any = true;
            }
            if volley {
                let around = target.neighbors();
                for h in 0..6 {
                    if let Option.Some(d) = self.enemy_of_team_at(around[h], attacker.team) {
                        engagements.push(Engagement { attacker: a, defender: d, damage_scale: scale });
                        hit_any = true;
                    }
                }
            }
            // A structure is hit only when no enemy unit is.
            if !hit_any {
                if let Option.Some(city) = self.enemy_barracks_at(target, attacker.team) {
                    barracks_hits.push((a, city, scale));
                    hit_any = true;
                } else if let Option.Some(city) = self.enemy_coastal_battery_at(target, attacker.team) {
                    battery_hits.push((a, city, scale));
                    hit_any = true;
                }
            }
            // With nothing else to hit, the attack kills any enemy workers out on its hexes. A unit
            // on a worker's hex shields it.
            if !hit_any {
                let mut hexes: Vec[Hex] = Vec.new();
                hexes.push(target);
                if volley {
                    let around = target.neighbors();
                    for h in 0..6 { hexes.push(around[h]); }
                }
                for h in 0..hexes.len() {
                    let hit = self.enemy_workers_at(hexes[h], attacker.team);
                    for w in 0..hit.len() {
                        killed_workers.push(self.field_workers[hit[w]].id);
                        hit_any = true;
                    }
                }
            }
            if !hit_any {
                info(fn() can {Out} { attacker.show(); Out.put(" attacks "); target.show(); Out.put(" but hits nothing"); });
            }
            shots.push(Effect.Shot(from, to, if hit_any { Outcome.Hit } else { Outcome.Miss }));
        }

        let mut damage: Vec[f32] = Vec.new();
        for _ in 0..self.units.len() { damage.push(0.0); }
        // Blows that hit animals, by who struck them. The side that dealt the most of one that
        // dies gets its bounty (`animals.tua`).
        let mut hunts: Vec[Hunt] = Vec.new();
        for e in 0..engagements.len() {
            let engagement = engagements[e];
            let (a, d) = (engagement.attacker, engagement.defender);
            // Two units attacking each other in the same step is a single exchange of blows,
            // not two attacks that each draw retaliation.
            let mut reverse: Option[f32] = Option.None;
            for r in 0..engagements.len() {
                if engagements[r].attacker == d && engagements[r].defender == a {
                    reverse = Option.Some(engagements[r].damage_scale);
                }
            }
            if reverse.is_some() && d < a { continue; }
            let attacker = &self.units[a];
            let defender = &self.units[d];
            let hit = shore_scale(attacker, defender) * engagement.damage_scale * blow_damage(attacker, defender, self.defense_multiplier(defender));
            damage[d] = damage[d] + hit;
            if defender.is_animal() && attacker.team.is_side() { hunts.push(Hunt { animal: d, team: attacker.team, dealt: hit }); }
            let verb = if engagement.damage_scale < 1.0 { "volleys" } else { "hits" };

            let retaliation_scale = match reverse {
                Option.Some(scale) => Option.Some(scale),
                Option.None if retaliates(attacker, defender, hit) => Option.Some(1.0),
                Option.None => Option.None,
            };
            let grid = &self.grid;
            let (attacker_fort, defender_fort) = (self.in_fort(attacker), self.in_fort(defender));
            if let Option.Some(back_scale) = retaliation_scale {
                // Across the waterline only in an exchange of blows, where the shore scales the
                // blow back as it would its own attack.
                let back = back_scale * shore_scale(defender, attacker) * blow_damage(defender, attacker, self.defense_multiplier(attacker));
                damage[a] = damage[a] + back;
                if attacker.is_animal() && defender.team.is_side() { hunts.push(Hunt { animal: a, team: defender.team, dealt: back }); }
                let verb = if reverse.is_some() { "trades blows with" } else { verb };
                info(fn() can {Out} {
                    attacker.show(); show_note(attacker, grid, attacker_fort); Out.put(" "); Out.put(verb); Out.put(" ");
                    defender.show(); show_note(defender, grid, defender_fort); Out.put(" for "); show_f64_fixed(hit as f64, 0);
                    Out.put(", taking "); show_f64_fixed(back as f64, 0); Out.put(" back");
                });
            } else {
                info(fn() can {Out} {
                    attacker.show(); show_note(attacker, grid, attacker_fort); Out.put(" "); Out.put(verb); Out.put(" ");
                    defender.show(); show_note(defender, grid, defender_fort); Out.put(" for "); show_f64_fixed(hit as f64, 0);
                });
            }
        }

        let mut barracks_damage: Vec[f32] = Vec.new();
        let mut battery_damage: Vec[f32] = Vec.new();
        for _ in 0..self.cities.len() {
            barracks_damage.push(0.0);
            battery_damage.push(0.0);
        }
        for h in 0..barracks_hits.len() {
            let (attacker, city, scale) = barracks_hits[h];
            let attack = self.units[attacker].stats().attack;
            barracks_damage[city] = barracks_damage[city] + scale * damage_against(attack, BARRACKS_DEFENSE);
        }
        for h in 0..battery_hits.len() {
            let (attacker, city, scale) = battery_hits[h];
            let attack = self.units[attacker].stats().attack;
            let hit = scale * damage_against(attack, BATTERY_DEFENSE);
            battery_damage[city] = battery_damage[city] + hit;
            let unit = &self.units[attacker];
            let id = self.cities[city].id;
            info(fn() can {Out} { unit.show(); Out.put(" hits city "); show_u64((id + 1) as u64); Out.put("'s coastal battery for "); show_f64_fixed(hit as f64, 0); });
        }

        for s in 0..shots.len() { self.play(shots[s]); }
        for w in 0..self.field_workers.len() {
            if killed_workers.contains(self.field_workers[w].id) {
                let at = self.field_workers[w].pos.to_world();
                self.play(Effect.Damage(at, 1.0, true));
            }
        }
        self.kill_workers(&killed_workers);
        for c in 0..self.cities.len() {
            let taken = barracks_damage[c];
            if taken <= 0.0 { continue; }
            let Option.Some(at) = self.cities[c].barracks else { continue; };
            let fatal = self.cities[c].barracks_hp <= taken;
            self.play(Effect.Damage(at.to_world(), taken, fatal));
            let city = &mut self.cities[c];
            let hp = city.barracks_hp - taken;
            city.barracks_hp = if hp > 0.0 { hp } else { 0.0 };
            if city.barracks_hp == 0.0 {
                city.barracks = Option.None;
                city.barracks_queue.clear();
                // Gone from the map, so the city may build another.
                handle { city.built.retain(); } with Keep[Building] { keep(b) => { resume *b != Building.Barracks } }
                if self.selected_barracks == Option.Some(c) { self.selected_barracks = Option.None; }
            }
        }
        for c in 0..self.cities.len() {
            let taken = battery_damage[c];
            if taken <= 0.0 { continue; }
            if let Option.Some(site) = self.cities[c].placed_site(Building.CoastalBattery) {
                let fatal = self.cities[c].coastal_battery_hp <= taken;
                self.play(Effect.Damage(site.to_world(), taken, fatal));
            }
            let city = &mut self.cities[c];
            let hp = city.coastal_battery_hp - taken;
            city.coastal_battery_hp = if hp > 0.0 { hp } else { 0.0 };
            {
                let id = city.id;
                let left = city.coastal_battery_hp;
                info(fn() can {Out} {
                    Out.put("  city "); show_u64((id + 1) as u64); Out.put("'s coastal battery: ");
                    if left > 0.0 { show_f64_fixed(left as f64, 0); Out.put(" hp"); } else { Out.put("destroyed"); }
                });
            }
            if city.coastal_battery_hp == 0.0 {
                let _gone = city.extra_buildings.remove(Building.CoastalBattery);
                handle { city.built.retain(); } with Keep[Building] { keep(b) => { resume *b != Building.CoastalBattery } }
            }
        }
        for i in 0..self.units.len() {
            if damage[i] > 0.0 {
                let at = self.unit_layout(i).0;
                let fatal = self.units[i].hp <= damage[i];
                self.play(Effect.Damage(at, damage[i], fatal));
            }
        }
        for i in 0..self.units.len() {
            if damage[i] > 0.0 {
                let hp = self.units[i].hp - damage[i];
                self.units[i].hp = if hp > 0.0 { hp } else { 0.0 };
                let unit = &self.units[i];
                info(fn() can {Out} { Out.put("  "); unit.show(); Out.put(": "); show_hp(unit); });
            }
        }
        // The attacks have happened, so their planned arrows give way to the animations.
        for k in 0..attackers.len() { self.units[attackers[k]].planned_attack = Option.None; }
        self.reward_hunts(&hunts);
        handle { self.units.retain(); } with Keep[Unit] { keep(u) => { resume u.is_alive() } }
        self.discard_interior_copies_of_dead_units();
    }
}

/// Moves every unit of `from` onto the end of `to`, first first.
fn push_in_order(from: &mut Vec[Unit], to: &mut Vec[Unit]) {
    let mut reversed: Vec[Unit] = Vec.new();
    while let Option.Some(u) = from.pop() { reversed.push(u); }
    while let Option.Some(u) = reversed.pop() { to.push(u); }
}
