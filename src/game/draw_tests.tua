use game.unit.Unit;
use game.fog_tests.remembered_route_hex;
use game.tests.sandbox;
use game.unit.Team;
use game.unit.UnitType;

fn count_color(vertices: &Vec[MeshVertex], color: Color) -> i32 {
    let mut n = 0;
    for k in 0..vertices.len() {
        let c = vertices[k].color;
        if c[0] == color[0] && c[1] == color[1] && c[2] == color[2] && c[3] == color[3] { n = n + 1; }
    }
    n
}

@test
fn turn_order_numbers_show_only_while_alt_is_held() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.world_scenario(3);
        game.explore();
        assert(count_color(&game.build_vertices(), MOVE_ORDER_COLOR) == 0);
        game.set_details(true);
        assert(count_color(&game.build_vertices(), MOVE_ORDER_COLOR) > 0);
        game.set_details(false);
        assert(count_color(&game.build_vertices(), MOVE_ORDER_COLOR) == 0);
    });
}

/// How many yield rows `game` draws, each pill being the same outline whatever its width.
fn rows(game: &GameState) -> i32 {
    let mut one: Vec[MeshVertex] = Vec.new();
    push_yield_row(vec2(0.0, 0.0), (2, 1, 0), &mut one);
    count_color(&game.build_vertices(), YIELD_ROW_COLOR) / count_color(&one, YIELD_ROW_COLOR)
}

@test
fn alt_shows_yields_on_every_explored_tile_outside_the_city_view() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.city_scenario();
        game.explore();
        // The whole map in view.
        game.camera.zoom(-1000.0);
        let mut city = 0;
        for c in 0..game.cities.len() { if game.cities[c].team == PLAYER_TEAM { city = c; } }
        // No yields without the city view or Alt.
        game.selected_city = Option.None;
        assert(rows(&game) == 0);
        // The open city shows its tiles' yields.
        game.selected_city = Option.Some(city);
        let in_reach = rows(&game);
        assert(in_reach > 0);
        game.selected_city = Option.None;
        game.set_details(true);
        let fog = game.fog();
        let mut yielding = 0;
        for h in game.grid.hexes() {
            let hex = *h;
            if !game.grid.terrain(hex).is_workable() || !game.is_explored(hex) { continue; }
            let (food, wood, metal) = game.known_yield(hex, &fog);
            if food != 0 || wood != 0 || metal != 0 { yielding = yielding + 1; }
        }
        assert(yielding > in_reach);
        // A row on every tile that yields.
        assert(rows(&game) == yielding);
    });
}

/// How many distinct heights the icons of `yield_row((amount, 0, 0))` sit at.
fn pip_rows(amount: i32) -> i32 {
    let row = yield_row((amount, 0, 0));
    let mut n = 0;
    for k in 0..row.icons.len() {
        if k == 0 || row.icons[k].at.y != row.icons[k - 1].at.y { n = n + 1; }
    }
    n
}

fn abs(x: f32) -> f32 { if x < 0.0 { -x } else { x } }

@test
fn yields_up_to_six_are_die_pips_and_more_are_a_number() {
    for amount in 1..=6 {
        let row = yield_row((amount, 0, 0));
        // No number needed.
        assert(row.labels.is_empty());
        assert(row.icons.len() == amount);
    }
    // 2 side by side.
    assert(pip_rows(2) == 1);
    // 3: one on top, centered over two.
    let three = yield_row((3, 0, 0));
    assert(pip_rows(3) == 2);
    assert(abs(three.icons[0].at.x) < 0.00001 && three.icons[0].at.y > three.icons[1].at.y);
    // 4: a square.
    let four = yield_row((4, 0, 0));
    assert(pip_rows(4) == 2);
    assert(abs(four.icons[0].at.x + four.icons[1].at.x) < 0.00001);
    // 5: a square with one in the middle.
    let five = yield_row((5, 0, 0));
    let mut middle = false;
    for k in 0..5 { if five.icons[k].at.length() < 0.00001 { middle = true; } }
    assert(middle);
    // 6: two rows of three.
    let six = yield_row((6, 0, 0));
    assert(pip_rows(6) == 2);
    let mut top = 0;
    for k in 0..6 { if six.icons[k].at.y > 0.0 { top = top + 1; } }
    assert(top == 3);

    // Past six, one icon and the number after it.
    let seven = yield_row((7, 0, 0));
    assert(seven.icons.len() == 1);
    assert(seven.labels[0].amount == 7);
    assert(seven.labels[0].at.x > seven.icons[0].at.x);
    assert(yield_row((0, 0, 0)).icons.is_empty());
}

@test
fn a_yield_row_puts_food_left_of_wood_and_metal_and_stays_inside_the_hex() {
    let cases = [(2, 1, 0), (6, 6, 0), (12, 5, 1), (3, 0, 0), (0, 4, 2), (6, 6, 6), (12, 12, 12)];
    for c in 0..7 {
        let row = yield_row(cases[c]);
        let mut rightmost_food = -1000.0;
        let mut leftmost_production = 1000.0;
        for k in 0..row.icons.len() {
            let x = row.icons[k].at.x;
            if row.icons[k].icon == MapIcon.Food { if x > rightmost_food { rightmost_food = x; } } else if x < leftmost_production { leftmost_production = x; }
        }
        assert(rightmost_food < leftmost_production);
        // The pill's corners stay inside the hex's fill.
        let corner = vec2(abs(YIELD_ROW_OFFSET.x - row.half.x), abs(YIELD_ROW_OFFSET.y - row.half.y));
        let root3: f32 = 1.7320508;
        assert(root3 * corner.x + corner.y <= HEX_SIZE * 0.92 * root3);
    }
}

@test
fn a_city_and_its_roads_in_the_fog_are_not_drawn() {
    sandbox(fn() can {Log, Rand, Assert} {
        // The Red city starts far out of Blue's sight.
        let mut game = GameState.city_scenario();
        game.explore();
        game.camera.zoom(-1000.0);
        let mut red = 0 - 1;
        for c in 0..game.cities.len() { if game.cities[c].team == Team.Red { red = c; } }
        assert(red >= 0 && !game.is_explored(game.cities[red].pos));
        assert(count_color(&game.build_vertices(), Team.Red.color()) == 0);
        // With the fog lifted, there it is.
        game.toggle_fog();
        assert(count_color(&game.build_vertices(), Team.Red.color()) > 0);
    });
}

@test
fn a_light_line_marks_where_remembered_hexes_meet_hexes_in_sight() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.world_scenario(3);
        game.explore();
        // Everything explored is in sight, so there is no edge yet.
        assert(count_color(&game.build_vertices(), FOG_EDGE_COLOR) == 0);
        // Every Blue unit steps far away and back out of the city's sight lines: what they saw
        // stays explored beside what the city still sees.
        let mut scout = 0 - 1;
        for i in 0..game.units.len() { if game.units[i].team == Team.Blue && game.units[i].unit_type == UnitType.Scout { scout = i; } }
        assert(scout >= 0);
        let start = game.units[scout].pos;
        game.units[scout].pos = Hex.new(start.q + 4, start.r);
        game.explore();
        game.units[scout].pos = start;
        game.explore();
        assert(count_color(&game.build_vertices(), FOG_EDGE_COLOR) > 0);
        // With the fog lifted, nothing is remembered.
        game.toggle_fog();
        assert(count_color(&game.build_vertices(), FOG_EDGE_COLOR) == 0);
    });
}

@test
fn placing_something_tints_the_tiles_in_reach() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.city_scenario();
        game.explore();
        assert(count_color(&game.build_vertices(), WORKER_REACH_TINT) == 0);
        game.open_city(0);
        game.arm_worker_job(JobKind.Road);
        let tinted = count_color(&game.build_vertices(), WORKER_REACH_TINT);
        let mut reachable = 0;
        for hh in game.grid.hexes() {
            let h = *hh;
            if game.is_explored(h) && game.grid.is_passable(h) && game.known_worker_reach(h) { reachable = reachable + 1; }
        }
        assert(reachable > 0);
        // The same fill on each reachable tile.
        assert(tinted % reachable == 0);
        assert(tinted > 0);
    });
}

@test
fn queued_walls_are_drawn_with_round_ends() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.city_scenario();
        let around = game.cities[0].pos.neighbors();
        game.cities[0].worker_jobs.push(WorkerJob { hex: around[0], kind: JobKind.Wall, across: Option.Some(around[1]), done: 0 });
        // A segment is two triangles; each round end is twelve more.
        assert(count_color(&game.build_vertices(), PLANNED_EDGE_COLOR) == 6 + 2 * 12 * 3);
    });
}

@test
fn work_under_way_is_ringed_and_counts_its_turns_left() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.city_scenario();
        game.explore();
        game.open_city(0);
        let city = game.cities[0].pos;
        // Two hexes out: a turn walking, then at work.
        let mut target: Option[Hex] = Option.None;
        for hh in game.grid.hexes() {
            let h = *hh;
            if target.is_none() && h.distance(city) == 2 && game.job_unavailable(h, JobKind.Improve).is_none() { target = Option.Some(h); }
        }
        let Option.Some(hex) = target else { assert(false); return; };
        game.placing_job = Option.Some(JobKind.Improve);
        assert(game.place_job_at(hex, Option.None));
        game.placing_job = Option.None;
        // Only queued, not under way.
        assert(count_color(&game.build_vertices(), JOB_UNDER_WAY_COLOR) == 0);
        // Out and walking there: its name in solid gold.
        let _acted = game.resolve_workers();
        let walking = count_color(&game.build_vertices(), JOB_UNDER_WAY_COLOR);
        assert(walking > 0);
        assert(game.field_workers[0].pos != hex);
        // At work: "IMPROVE 3T", more glyphs than "IMPROVE".
        let _acted = game.resolve_workers();
        assert(game.field_workers[0].work_left == Option.Some(3));
        assert(count_color(&game.build_vertices(), JOB_UNDER_WAY_COLOR) > walking);
    });
}

@test
fn breached_post_gains_a_distinct_world_marker() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.siege_scenario();
        let intact = count_color(&game.build_vertices(), SELECTED_COLOR);
        game.cities[1].interior.core_hp = 0.0;
        let breached = count_color(&game.build_vertices(), SELECTED_COLOR);
        // A breached post needs a visible gold ring.
        assert(breached > intact);
    });
}

@test
fn delivery_labels_show_only_on_explored_tiles() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.city_scenario();
        game.explore();
        game.select_city();
        let Option.Some(city) = game.selected_city else { assert(false); return; };
        let seen = count_color(&game.build_vertices(), DELIVERY_TEXT_COLOR);
        // Labels on the explored tiles.
        assert(seen > 0);
        // Forget an explored tile the known routes reach: its label goes.
        let fog = game.fog();
        let routes = game.known_routes(city, &fog);
        let mut forgotten: Option[Hex] = Option.None;
        for k in 0..routes.costs.len() {
            let Option.Some(h) = routes.costs.key_at(k) else { continue; };
            if forgotten.is_none() && h != game.cities[city].pos && game.is_explored(h) { forgotten = Option.Some(h); }
        }
        let Option.Some(h) = forgotten else { assert(false); return; };
        let _gone = game.memory.remove(h);
        assert(!game.is_explored(h));
        assert(count_color(&game.build_vertices(), DELIVERY_TEXT_COLOR) < seen);
    });
}

@test
fn a_site_preview_follows_the_cursor_only_in_its_open_city() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.city_scenario();
        game.units.clear();
        game.selected = Option.None;
        game.explore();
        let city = 0;
        assert(game.cities[city].team == PLAYER_TEAM);
        let mut site: Option[Hex] = Option.None;
        for hh in game.grid.hexes() { if site.is_none() && game.site_available(city, Building.Barracks, *hh) { site = Option.Some(*hh); } }
        let Option.Some(site) = site else { assert(false); return; };
        game.selected_city = Option.Some(city);
        // The open city draws its yields too, so compare against the open city without placing.
        let plain = game.build_vertices().len();
        game.placing_job = Option.Some(JobKind.Build(Building.Barracks));
        game.hovered_job = Option.Some((site, Option.None));
        // Placing: the tile under the cursor is ringed, and the reach lit.
        let with_preview = game.build_vertices().len();
        game.placing_job = Option.None;
        game.hovered_job = Option.None;
        assert(with_preview > plain);
    });
}

@test
fn only_hovering_the_manager_draws_a_line_and_it_follows_the_route_home() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.city_scenario();
        let city = 0;
        game.selected_city = Option.Some(city);
        let fog = game.fog();
        let routes = game.known_routes(city, &fog);
        // A manager at least two legs from the city, so the route bends through other hexes.
        let mut manager: Option[Hex] = Option.None;
        for k in 0..routes.costs.len() {
            let Option.Some(h) = routes.costs.key_at(k) else { continue; };
            if game.grid.terrain(h).is_water() || game.cities[city].works(h) || routes.path_from(h).len() < 3 { continue; }
            let better = match manager { Option.None => true, Option.Some(b) => h.q < b.q || (h.q == b.q && h.r < b.r) };
            if better { manager = Option.Some(h); }
        }
        let Option.Some(manager) = manager else { assert(false); return; };
        game.cities[city].clusters[0].manager = manager;
        // The manager has workers.
        assert(game.cities[city].clusters[0].count > 0);
        let path = routes.path_from(manager);
        assert(path[0] == manager && path[path.len() - 1] == game.cities[city].pos);
        for k in 1..path.len() {
            assert(path[k - 1].distance(path[k]) == 1);
            assert(routes.costs.get(path[k]).unwrap_or(99) < routes.costs.get(path[k - 1]).unwrap_or(0));
        }
        // Not hovering: no route line; hovering another worked tile: none either.
        game.hovered_tile = Option.None;
        assert(count_color(&game.build_vertices(), MANAGER_ROUTE_COLOR) == 0);
        game.hovered_tile = Option.Some(game.cities[city].clusters[0].slots[0]);
        assert(count_color(&game.build_vertices(), MANAGER_ROUTE_COLOR) == 0);
        // Hovering the manager: seven dashes along each leg of its route.
        game.hovered_tile = Option.Some(manager);
        assert(count_color(&game.build_vertices(), MANAGER_ROUTE_COLOR) == (path.len() - 1) * 7 * 6);
        // Carrying the manager to a new tile hides the line.
        game.moving_manager = Option.Some((city, 0));
        assert(count_color(&game.build_vertices(), MANAGER_ROUTE_COLOR) == 0);
    });
}

@test
fn barracks_delivery_labels_do_not_react_to_unseen_units() {
    sandbox(fn() can {Log, Rand, Assert} {
        let (mut game, city, far) = remembered_route_hex();
        // A barracks two hexes from the remembered hex: it sees only 1.
        let fog = game.fog();
        let mut site: Option[Hex] = Option.None;
        for hh in game.grid.hexes() {
            let h = *hh;
            if site.is_some() || h.distance(far) != 2 || !game.site_available(city, Building.Barracks, h) { continue; }
            if !fog.sees(far) && game.routes_from(PLAYER_TEAM, h).costs.has(far) { site = Option.Some(h); }
        }
        let Option.Some(site) = site else { assert(false); return; };
        game.cities[city].barracks = Option.Some(site);
        game.selected_city = Option.None;
        game.selected_barracks = Option.Some(city);
        assert(!game.fog().sees(far));
        let before = count_color(&game.build_vertices(), BARRACKS_SHARE_COLOR);
        assert(before > 0);
        game.units.push(Unit.new(51, far, Team.Red, UnitType.Melee));
        assert(count_color(&game.build_vertices(), BARRACKS_SHARE_COLOR) == before);
    });
}
