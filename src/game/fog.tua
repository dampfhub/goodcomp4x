//! Fog of war for the player's side, in three layers:
//! - in sight: hexes the player's units and cities see now, and the tiles the player's cities
//!   work, shown as they are;
//! - remembered: hexes seen before but out of sight now, shown under a dark tint as they were
//!   when last seen (`Sighting`): cities, improvements and roads. Units move, so they aren't
//!   remembered: out of sight, none is known to be anywhere;
//! - unexplored: never seen, covered by fog.
//!
//! Every side sees and remembers by the same rules, in one of two memories: the player's
//! (`fog()`, `GameState.memory`, brought up to date every frame by `explore`, which F10 turns
//! off), and each side's own (`side_fog`, `GameState.side_memory`), which is game state, brought
//! up to date only as the AI plans that side's turn, and untouched by F10 or by which side this
//! machine plays. The AI plans on its side's memory and nothing else, so it plays under the same
//! fog as the player. A `Fog` says which memory it recalls from, so every `known_*` query
//! answers for either.

use std.collections.Map;
use std.collections.Set;
use std.fmt.Out;
use std.math.max;
use std.math.min;
use game.GameState;
use game.Step;
use game.reachable_by;
use game.text;
use game.city.RouteBoard;
use game.city.Routes;
use game.city.SiteKind;
use game.city.Building;
use game.city.BARRACKS_MAX_HP;
use game.city.cluster_tiles;
use game.workers.Structure;
use game.workers.StructureKind;
use game.workers.OUTPOST_SIGHT;
use game.workers.WORKER_SIGHT;
use game.workers.FieldWorker;
use game.hex.Hex;
use game.terrain.Terrain;
use game.unit.Team;
use game.unit.Unit;
use game.unit.UnitType;

/// How far a city sees.
pub const CITY_SIGHT: i32 = 3;
/// How far a Barracks sees, and a Watchpost (one more from hills).
const BARRACKS_SIGHT: i32 = 1;
const WATCHPOST_SIGHT: i32 = 4;
/// Extra sight for a unit standing on hills.
const HILLS_SIGHT: i32 = 1;
/// Extra sight for a scout after a turn on lookout.
pub const LOOKOUT_SIGHT: i32 = 2;
/// How far a line of sight is shifted to settle which side of an edge it passes (see
/// `Hex.line_between`).
const SIGHT_NUDGE: f32 = 0.0001;

/// What one side can see now, and where it recalls what it saw before.
pub struct Fog {
    /// Hexes in sight, or `None` with the fog turned off.
    visible: Option[Set[Hex]],
    /// Whose sight it is: the side whose own units always show.
    team: Team,
    /// Which memory holds the hexes out of sight.
    recall: Recall,
}

/// Where a `Fog` recalls hexes out of sight from.
pub enum Recall {
    /// The player's memory at this machine (`GameState.memory`).
    Player,
    /// The side's own memory in the game state (`GameState.side_memory`).
    Side,
}

impl Fog {
    /// Whether `hex` is in sight (always, with the fog off).
    pub fn sees(&self, hex: Hex) -> bool {
        match &self.visible { &Option.Some(v) => v.contains(hex), &Option.None => true }
    }

    /// Whether to show `unit`: the local side's own always, others in sight.
    pub fn shows(&self, unit: &Unit) -> bool { unit.team == self.team || self.sees(unit.pos) }

    /// Whether to show a worker out on the map, by the same rule.
    pub fn shows_worker(&self, worker: &FieldWorker) -> bool { worker.team == self.team || self.sees(worker.pos) }

    /// Whose sight it is.
    pub fn team(&self) -> Team { self.team }
}

/// A city or Barracks as the player last saw it.
pub struct SeenBuilding {
    team: Team,
    /// The city's number, from 0.
    id: u32,
    /// Share of full health, 0 to 1.
    health: f32,
    /// For a city: its population.
    population: i32,
}

/// A hex as the player last saw it. Only what can change is kept; the ground itself never does.
/// Units aren't kept: a sighting of one says nothing about where it is now.
pub struct Sighting {
    city: Option[SeenBuilding],
    barracks: Option[SeenBuilding],
    /// An improvement's kind and owner.
    site: Option[(SiteKind, Team)],
    road: bool,
    /// An outpost or fort.
    structure: Option[Structure],
    /// Walls and gates on the hex's edges, by neighbour direction (`Hex.neighbors` order).
    barriers: [Option[Structure]; 6],
    /// The tile's food, wood and metal, with any improvement or city.
    yields: (i32, i32, i32),
    /// Unclaimed ruins (`ruins.tua`).
    ruin: bool,
    /// An animal den not yet cleared (`animals.tua`), by the animal it keeps.
    den: Option[UnitType],
    /// The turn it was seen on (`GameState.turn`): how stale it is.
    turn: u32,
}

impl GameState {
    /// `empty_city_target` as the player knows the board: a city center in sight may be refused
    /// as empty, but one out of sight may have someone standing in it, so it's never refused and
    /// whether an order is accepted gives nothing away. If it's empty when the attack comes, the
    /// attack misses.
    pub fn known_empty_city_target(&self, hex: Hex, team: Team, fog: &Fog) -> bool {
        fog.sees(hex) && self.empty_city_target(hex, team)
    }

    /// What the player sees this frame, recalling from the player's memory.
    pub fn fog(&self) -> Fog {
        if self.fog_of_war {
            Fog { visible: Option.Some(self.visible_hexes()), team: self.local_team, recall: Recall.Player }
        } else {
            Fog { visible: Option.None, team: self.local_team, recall: Recall.Player }
        }
    }

    /// What `team` sees now, recalling from its own memory, which this first brings up to date
    /// with everything in sight. It depends on nothing but the game (not on F10, nor on the side
    /// this machine plays). The AI plans each side's turn on it.
    pub fn side_fog(&mut self, team: Team) -> Fog {
        let visible = self.side_sight(team);
        let side = team.index();
        for h in visible.each() {
            let sighting = self.sighting(*h);
            let _old = self.side_memory[side].insert(*h, sighting);
        }
        Fog { visible: Option.Some(visible), team, recall: Recall.Side }
    }

    /// Whether the player has ever seen `hex` (always, with the fog off).
    pub fn is_explored(&self, hex: Hex) -> bool { !self.fog_of_war || self.memory.has(hex) }

    /// How `hex` looked when `fog`'s side last saw it, if it ever did.
    pub fn recalled(&self, hex: Hex, fog: &Fog) -> Option[Sighting] {
        match fog.recall {
            Recall.Player => self.memory.get(hex),
            Recall.Side => self.side_memory[fog.team.index()].get(hex),
        }
    }

    /// How many hexes `fog`'s side remembers.
    pub fn recalled_len(&self, fog: &Fog) -> i32 {
        match fog.recall {
            Recall.Player => self.memory.len(),
            Recall.Side => self.side_memory[fog.team.index()].len(),
        }
    }

    /// The `i`th hex `fog`'s side remembers and how it looked, in no order that counts.
    pub fn recalled_at(&self, i: i32, fog: &Fog) -> Option[(Hex, Sighting)] {
        let (key, seen) = match fog.recall {
            Recall.Player => (self.memory.key_at(i), self.memory.val_at(i)),
            Recall.Side => (self.side_memory[fog.team.index()].key_at(i), self.side_memory[fog.team.index()].val_at(i)),
        };
        match (key, seen) { (Option.Some(k), Option.Some(v)) => Option.Some((k, v)), _ => Option.None }
    }

    /// `is_explored` for `fog`'s side: whether it has seen `hex` (always, with the fog off). Its
    /// memory holds what is in sight too, as seen when it was last brought up to date
    /// (`explore`, `side_fog`).
    pub fn explored_by(&self, hex: Hex, fog: &Fog) -> bool { fog.visible.is_none() || self.recalled(hex, fog).is_some() }

    /// How far `unit` sees: its type's sight, more from hills or after a turn on lookout.
    pub fn sight(&self, unit: &Unit) -> i32 {
        let lookout = if unit.lookout { LOOKOUT_SIGHT } else { 0 };
        self.sight_at(unit.unit_type, unit.pos) + lookout
    }

    /// How far a unit of `unit_type` standing on `hex` sees, lookout aside.
    pub fn sight_at(&self, unit_type: UnitType, hex: Hex) -> i32 {
        let hills = if self.grid.tile(hex).hills { HILLS_SIGHT } else { 0 };
        unit_type.sight() + hills
    }

    /// Whether `from` can see `to`: no mountain stands on the line between them. A mountain
    /// itself can be seen, just not past. Where the line runs along the edge between two hexes,
    /// either side being clear will do.
    pub fn in_line_of_sight(&self, from: Hex, to: Hex) -> bool {
        self.clear_line(from, to, SIGHT_NUDGE) || self.clear_line(from, to, -SIGHT_NUDGE)
    }

    fn clear_line(&self, from: Hex, to: Hex, nudge: f32) -> bool {
        let mut clear = true;
        for h in from.line_between(to, nudge) {
            if self.grid.terrain(*h) == Terrain.Mountains { clear = false; }
        }
        clear
    }

    /// Every hex within `range` of `from` that it can see, into `seen`.
    fn look(&self, from: Hex, range: i32, seen: &mut Set[Hex]) {
        for dq in -range..=range {
            for dr in max(-range, -dq - range)..=min(range, -dq + range) {
                let hex = Hex.new(from.q + dq, from.r + dr);
                if self.grid.contains(hex) && self.in_line_of_sight(from, hex) { let _new = seen.insert(hex); }
            }
        }
    }

    /// Every hex the player's side sees now (`sight_of`), with what the units the player
    /// commands of another side (the Frontier sandbox's) see.
    pub fn visible_hexes(&self) -> Set[Hex] { self.sight_of(self.local_team, false) }

    /// Every hex `team` sees now (`sight_of`), from its own units.
    fn side_sight(&self, team: Team) -> Set[Hex] { self.sight_of(team, true) }

    /// Every hex seen now by the units the player commands (`own_only` false) or by `team`'s
    /// (`own_only` true), and by `team`'s cities, Barracks, Watchposts, outposts and workers, and
    /// every tile a city of `team` works, whatever the range or mountains: an enemy standing on
    /// one of a side's tiles is always seen. That includes a tile the city was working until a
    /// cut route took its citizen off it (`remembered_worked`), so an enemy that ends a turn on a
    /// worked tile doesn't vanish when the city reassigns the citizen.
    fn sight_of(&self, team: Team, own_only: bool) -> Set[Hex] {
        let mut seen: Set[Hex] = Set.new();
        for idx in 0..self.units.len() {
            let looks = if own_only { self.units[idx].team == team } else { self.is_player_controlled(idx) };
            if looks {
                let unit = &self.units[idx];
                self.look(unit.pos, self.sight(unit), &mut seen);
            }
        }
        for c in 0..self.cities.len() {
            let city = &self.cities[c];
            if city.team != team { continue; }
            self.look(city.pos, CITY_SIGHT, &mut seen);
            if let Option.Some(barracks) = city.barracks { self.look(barracks, BARRACKS_SIGHT, &mut seen); }
            if let Option.Some(post) = city.placed_site(Building.Watchpost) {
                let hills = if self.grid.tile(post).hills { 1 } else { 0 };
                self.look(post, WATCHPOST_SIGHT + hills, &mut seen);
            }
        }
        for w in 0..self.field_workers.len() {
            if self.field_workers[w].team == team { self.look(self.field_workers[w].pos, WORKER_SIGHT, &mut seen); }
        }
        for k in 0..self.structures.len() {
            let (Option.Some(hex), Option.Some(structure)) = (self.structures.key_at(k), self.structures.val_at(k)) else { continue; };
            if structure.team == team && structure.kind == StructureKind.Outpost { self.look(hex, OUTPOST_SIGHT, &mut seen); }
        }
        for c in 0..self.cities.len() {
            let city = &self.cities[c];
            if city.team != team { continue; }
            let worked = city.worked_tiles();
            for w in 0..worked.len() { let _new = seen.insert(worked[w]); }
            let remembered = cluster_tiles(&city.remembered);
            for w in 0..remembered.len() { let _new = seen.insert(remembered[w]); }
        }
        seen
    }

    /// `hex` as it is right now, for a memory.
    fn sighting(&self, hex: Hex) -> Sighting {
        let mut city: Option[SeenBuilding] = Option.None;
        let mut barracks: Option[SeenBuilding] = Option.None;
        for c in 0..self.cities.len() {
            let x = &self.cities[c];
            if city.is_none() && x.pos == hex {
                city = Option.Some(SeenBuilding { team: x.team, id: x.id, health: 1.0, population: x.population });
            }
            if barracks.is_none() && x.barracks == Option.Some(hex) {
                barracks = Option.Some(SeenBuilding { team: x.team, id: x.id, health: x.barracks_hp / BARRACKS_MAX_HP, population: 0 });
            }
        }
        let site = match self.sites.get(hex) { Option.Some(s) => Option.Some((s.kind, s.team)), Option.None => Option.None };
        let around = hex.neighbors();
        let barriers = [self.barrier(hex, around[0]), self.barrier(hex, around[1]), self.barrier(hex, around[2]), self.barrier(hex, around[3]), self.barrier(hex, around[4]), self.barrier(hex, around[5])];
        Sighting {
            city,
            barracks,
            site,
            road: self.roads.contains(hex),
            structure: self.structures.get(hex),
            barriers,
            yields: self.raw_yield(hex),
            ruin: self.ruin_at(hex).is_some(),
            den: match self.den_at(hex) { Option.Some(d) => Option.Some(self.dens[d].kind), Option.None => Option.None },
            turn: self.turn,
        }
    }

    // What the player knows: a hex in sight as it is, one out of sight as last seen. Planning and
    // drawing for the player go through these, so nothing out of sight gives away what's really
    // there. The AI uses the real board.

    /// Whether the player knows of a unit on `hex`: only in sight, since units aren't
    /// remembered.
    pub fn known_occupied(&self, hex: Hex, fog: &Fog) -> bool { fog.sees(hex) && self.is_occupied(hex) }

    /// Whether the player knows of something on `hex` that `team` can attack: an enemy unit in
    /// sight, or an enemy Barracks in sight or remembered.
    pub fn known_enemy_target_at(&self, hex: Hex, team: Team, fog: &Fog) -> bool {
        if fog.sees(hex) { return self.has_enemy_target_at(hex, team); }
        match self.recalled(hex, fog) {
            Option.Some(seen) => match seen.barracks { Option.Some(b) => b.team != team, Option.None => false },
            Option.None => false,
        }
    }

    /// A tile's food and production as the player knows them.
    pub fn known_yield(&self, hex: Hex, fog: &Fog) -> (i32, i32, i32) {
        if !fog.sees(hex) {
            if let Option.Some(seen) = self.recalled(hex, fog) { return seen.yields; }
        }
        self.raw_yield(hex)
    }

    /// The improvement on `hex` as the player knows it: in sight, as it is; out of sight, as
    /// last seen.
    pub fn known_site_kind(&self, hex: Hex, fog: &Fog) -> Option[SiteKind] {
        if fog.sees(hex) {
            return match self.sites.get(hex) { Option.Some(site) => Option.Some(site.kind), Option.None => Option.None };
        }
        match self.recalled(hex, fog) {
            Option.Some(seen) => match seen.site { Option.Some((kind, _)) => Option.Some(kind), Option.None => Option.None },
            Option.None => Option.None,
        }
    }

    /// City `city`'s delivery routes as the player knows the board: what the yield badges,
    /// tooltips and city panel show. Income still follows the real routes (`routes`).
    pub fn known_routes(&self, city: i32, fog: &Fog) -> Routes {
        self.known_routes_from(self.cities[city].team, self.cities[city].pos, fog)
    }

    /// `routes_from` as the player knows the board.
    pub fn known_routes_from(&self, team: Team, origin: Hex, fog: &Fog) -> Routes {
        let river_banks = self.navigable_river_banks(team);
        handle { self.routes_from_by(origin) } with RouteBoard {
            blocked(hex) => {
                // Out of sight, the memory (none for a hex never seen); in sight, the board.
                resume if fog.sees(hex) {
                    self.enemy_of_team_at(hex, team).is_some() || self.enemy_city_at(hex, team)
                } else {
                    match self.recalled(hex, fog) {
                        Option.Some(seen) => match seen.city { Option.Some(c) => c.team != team, Option.None => false },
                        Option.None => false,
                    }
                }
            }
            crosses(from, to) => { resume self.known_can_cross(from, to, team, fog) }
            road(from, to) => {
                let river = river_banks.contains(from) && river_banks.contains(to);
                resume river || if fog.sees(to) {
                    self.is_road_hex(to)
                } else {
                    match self.recalled(to, fog) { Option.Some(seen) => seen.road || seen.city.is_some(), Option.None => false }
                }
            }
        }
    }

    /// The wall or gate the player knows of on the edge between adjacent `a` and `b`: the real
    /// one when either side is in sight, else as last seen.
    pub fn known_barrier(&self, a: Hex, b: Hex, fog: &Fog) -> Option[Structure] {
        if fog.sees(a) || fog.sees(b) { return self.barrier(a, b); }
        match self.remembered_barrier(a, b, fog) { Option.Some(s) => Option.Some(s), Option.None => self.remembered_barrier(b, a, fog) }
    }

    /// The wall or gate the memory of `from` holds on its edge toward `across`.
    fn remembered_barrier(&self, from: Hex, across: Hex, fog: &Fog) -> Option[Structure] {
        let Option.Some(seen) = self.recalled(from, fog) else { return Option.None; };
        let around = from.neighbors();
        for k in 0..6 { if around[k] == across { return seen.barriers[k]; } }
        Option.None
    }

    /// Whether the player knows of nothing stopping `team` crossing from `from` to the adjacent
    /// `to`.
    pub fn known_can_cross(&self, from: Hex, to: Hex, team: Team, fog: &Fog) -> bool {
        match self.known_barrier(from, to, fog) { Option.Some(b) => b.admits(team), Option.None => true }
    }

    /// Whether the player knows of a road on `hex`: in sight, or as last seen.
    pub fn known_road(&self, hex: Hex, fog: &Fog) -> bool {
        if fog.sees(hex) { return self.roads.contains(hex); }
        match self.recalled(hex, fog) { Option.Some(seen) => seen.road, Option.None => false }
    }

    /// The side of the city the player knows on `hex`, if any: in sight, or as last seen.
    pub fn known_city_team(&self, hex: Hex, fog: &Fog) -> Option[Team] {
        if fog.sees(hex) {
            for c in 0..self.cities.len() { if self.cities[c].pos == hex { return Option.Some(self.cities[c].team); } }
            return Option.None;
        }
        match self.recalled(hex, fog) {
            Option.Some(seen) => match seen.city { Option.Some(c) => Option.Some(c.team), Option.None => Option.None },
            Option.None => Option.None,
        }
    }

    /// Whether the player knows of unclaimed ruins on `hex`: in sight, or as last seen.
    pub fn known_ruin(&self, hex: Hex, fog: &Fog) -> bool {
        if fog.sees(hex) { return self.ruin_at(hex).is_some(); }
        match self.recalled(hex, fog) { Option.Some(seen) => seen.ruin, Option.None => false }
    }

    /// Whether the player knows of a city of another side on `hex`: in sight, or as last seen.
    pub fn known_enemy_city_at(&self, hex: Hex, team: Team, fog: &Fog) -> bool {
        if fog.sees(hex) {
            for c in 0..self.cities.len() { if self.cities[c].pos == hex && self.cities[c].team != team { return true; } }
            return false;
        }
        match self.recalled(hex, fog) {
            Option.Some(seen) => match seen.city { Option.Some(c) => c.team != team, Option.None => false },
            Option.None => false,
        }
    }

    /// The hexes a player-controlled land unit of `team` at `start` can plan to reach, going
    /// around the units the player knows of.
    pub fn known_reachable_hexes(&self, start: Hex, move_range: i32, team: Team, fog: &Fog) -> Set[Hex] {
        self.known_reachable_for_domain(start, move_range, team, fog, false)
    }

    /// `known_reachable_hexes` over water for a ship (`naval`), over land otherwise, around the
    /// walls and gates the player knows of; a land unit by one of its side's cities may also
    /// take the rail to a connected Railhead.
    pub fn known_reachable_for_domain(&self, start: Hex, move_range: i32, team: Team, fog: &Fog, naval: bool) -> Set[Hex] {
        self.known_reachable_past(start, move_range, team, fog, naval, false)
    }

    /// `known_reachable_for_domain`, with the units that close a hex: any unit the player sees
    /// there, or, with `enemies_only`, only enemies in sight (an ally may be moving off, so a
    /// column following its leader doesn't stop behind it every turn).
    pub fn known_reachable_past(&self, start: Hex, move_range: i32, team: Team, fog: &Fog, naval: bool, enemies_only: bool) -> Set[Hex] {
        let mut reachable = handle { reachable_by(start, move_range) } with Step {
            open(from, to) => {
                resume self.known_step(from, to, team, fog, naval) && !self.known_closed(to, team, fog, enemies_only)
            }
        };
        if move_range > 0 && !naval {
            for c in 0..self.cities.len() {
                if self.cities[c].team != team { continue; }
                let Option.Some(dest) = self.cities[c].placed_site(Building.Railhead) else { continue; };
                if !self.known_closed(dest, team, fog, enemies_only) && self.known_rail_transfer_available(start, dest, team, fog) { let _new = reachable.insert(dest); }
            }
        }
        reachable
    }

    /// Whether a unit the player sees on `hex` closes it (`known_reachable_past`).
    fn known_closed(&self, hex: Hex, team: Team, fog: &Fog, enemies_only: bool) -> bool {
        if enemies_only { fog.sees(hex) && self.enemy_of_team_at(hex, team).is_some() } else { self.known_occupied(hex, fog) }
    }

    /// Whether the player knows of nothing on `hex` that stops a unit entering it: on the map,
    /// and never seen (the player can't know what's there), or seen to be land a unit can walk
    /// (for a ship, water). Terrain never changes, so a hex seen once is known for good.
    pub fn known_passable(&self, hex: Hex, naval: bool, fog: &Fog) -> bool {
        if !self.grid.contains(hex) { return false; }
        if !self.explored_by(hex, fog) { return true; }
        if naval { self.grid.terrain(hex).is_water() } else { self.can_enter(hex) }
    }

    /// `can_step` as the player knows the board: whether a unit of `team` (a ship, if `naval`)
    /// may step from `from` onto the adjacent `to`, going by the terrain, enemy city centers,
    /// walls and gates the player knows of. Units aside, as they'll have moved by the time
    /// anyone gets there.
    pub fn known_step(&self, from: Hex, to: Hex, team: Team, fog: &Fog, naval: bool) -> bool {
        self.known_passable(to, naval, fog) && !self.known_enemy_city_at(to, team, fog) && self.known_can_cross(from, to, team, fog)
    }

    /// Records everything in sight as the player's latest memory of it. Called every frame.
    pub fn explore(&mut self) {
        if !self.fog_of_war { return; }
        let seen = self.visible_hexes();
        for h in seen.each() {
            let sighting = self.sighting(*h);
            let _old = self.memory.insert(*h, sighting);
        }
    }

    /// F10: turns the fog of war on or off.
    pub fn toggle_fog(&mut self) {
        self.fog_of_war = !self.fog_of_war;
        self.explore();
        self.notice = if self.fog_of_war {
            text(fn() can {Out} { Out.put("FOG OF WAR ON - F10 TO LIFT IT"); })
        } else {
            text(fn() can {Out} { Out.put("FOG OF WAR OFF - F10 TO BRING IT BACK"); })
        };
    }
}
