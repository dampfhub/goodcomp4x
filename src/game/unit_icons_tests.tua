//! Unit pictograms.

use std.linalg.vec2;
use std.test.assert;
use std.test.Assert;
use renderer.pipelines.MeshVertex;
use game.unit_icons.ICONS;
use game.unit_icons.push_pictogram;

@test
fn every_pictogram_stays_inside_its_token() {
    let (center, radius) = (vec2(3.0, -2.0), 0.5);
    for k in 0..13 {
        let mut out: Vec[MeshVertex] = Vec.new();
        push_pictogram(center, radius, ICONS[k], [0.0, 0.0, 0.0, 0.0], &mut out);
        // Something is drawn, inside the token and clear of its outline.
        assert(!out.is_empty());
        for v in 0..out.len() {
            let p = vec2(out[v].pos[0], out[v].pos[1]);
            assert(p.distance(center) < radius * 0.85);
        }
    }
}
