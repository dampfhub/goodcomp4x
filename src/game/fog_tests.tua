/// A world from `seed` with the player alone on it, with a settler (first) and a scout: the AI
/// sides' units and cities are taken away.
pub fn solo_world(seed: u32) -> GameState can {Log} {
    let mut settings = default_settings();
    settings.world_start_city = false;
    let mut game = GameState.world_scenario_with(seed, &settings);
    handle { game.units.retain(); } with Keep[Unit] { keep(u) => { resume u.team == PLAYER_TEAM } }
    game.selected = Option.Some(0);
    game
}

/// Where unit `id` is in the list.
fn index_of(game: &GameState, id: u32) -> i32 {
    for i in 0..game.units.len() { if game.units[i].id == id { return i; } }
    0 - 1
}

@test
fn units_see_around_them_and_explored_hexes_stay_explored() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = solo_world(3);
        game.explore();
        let mut scout = 0 - 1;
        for i in 0..game.units.len() { if game.units[i].team == Team.Blue && game.units[i].unit_type == UnitType.Scout { scout = i; } }
        let start = game.units[scout].pos;
        let sight = game.sight(&game.units[scout]);
        // Scouts see farther.
        assert(sight >= 3);
        let fog = game.fog();
        assert(fog.sees(start) && game.is_explored(start));
        // Some hex as far as it sees is in sight (a mountain may hide the one straight east).
        let mut far_seen = false;
        for hh in game.grid.hexes() {
            let h = *hh;
            if h.distance(start) == sight && fog.sees(h) { far_seen = true; }
        }
        assert(far_seen);
        let mut distant = start;
        let mut found = false;
        for hh in game.grid.hexes() {
            let h = *hh;
            if found { continue; }
            let mut away = true;
            for i in 0..game.units.len() { if game.units[i].team == Team.Blue && game.units[i].pos.distance(h) <= 8 { away = false; } }
            if away { distant = h; found = true; }
        }
        assert(found);
        assert(!fog.sees(distant) && !game.is_explored(distant));

        // Every Blue unit leaves; what they saw stays explored but unseen.
        for i in 0..game.units.len() { if game.units[i].team == Team.Blue { game.units[i].pos = distant; } }
        game.explore();
        assert(game.is_explored(start));
        assert(!game.fog().sees(start));

        game.toggle_fog();
        assert(game.fog().sees(start) && game.is_explored(Hex.new(0, 0)));
    });
}

/// A lone Blue cavalry at the origin with Charge queued (move 3, sight 3) and a mountain at
/// (1, 0) hiding (2, 0), which is still three steps away around the mountain.
fn behind_the_mountain() -> GameState can {Log, Assert} {
    let mut game = GameState.frontier_scenario();
    game.grid = HexGrid.new(6, &[(Hex.new(1, 0), MOUNTAINS)]);
    game.units.clear();
    game.cities.clear();
    game.roads.clear();
    game.memory = Map.new();
    game.units.push(Unit.new(1, Hex.new(0, 0), Team.Blue, UnitType.Cavalry));
    game.units[0].ability_queued = true;
    let hidden = Hex.new(2, 0);
    game.explore();
    check_behind_the_mountain(&game, hidden);
    game
}

fn check_behind_the_mountain(game: &GameState, hidden: Hex) can {Assert} {
    assert(game.fog_of_war && !game.fog().sees(hidden));
    assert(game.units[0].stats().move_range == 3);
}

const HIDDEN: Hex = Hex { q: 2, r: 0 };

/// Walks unit `idx` next to `hex` to look at it, then back out of sight.
fn glance_at(game: &mut GameState, idx: i32, hex: Hex) can {Assert} {
    let home = game.units[idx].pos;
    game.units[idx].pos = Hex.new(hex.q, hex.r - 1);
    game.explore();
    game.units[idx].pos = home;
    game.explore();
    assert(!game.fog().sees(hex) && game.is_explored(hex));
}

@test
fn a_group_click_on_an_unseen_enemy_moves_there() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = behind_the_mountain();
        game.units.push(Unit.new(2, Hex.new(-1, 0), Team.Blue, UnitType.Melee));
        game.units.push(Unit.new(3, HIDDEN, Team.Red, UnitType.Melee));
        assert(!game.fog().sees(HIDDEN));
        game.group.push(0);
        game.group.push(1);
        game.group_order(HIDDEN, ClickMode.Normal);
        assert(game.units[0].planned_move == Option.Some(HIDDEN));
        for i in 0..game.units.len() { assert(game.units[i].planned_attack.is_none()); }
    });
}

@test
fn a_move_toward_an_unseen_enemy_survives_an_order_check() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = behind_the_mountain();
        game.units.push(Unit.new(2, HIDDEN, Team.Red, UnitType.Melee));
        game.queue_order_at(0, HIDDEN);
        game.drop_orders_now_impossible(0);
        assert(game.units[0].planned_move == Option.Some(HIDDEN));
    });
}

@test
fn unseen_units_do_not_shape_the_move_range() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = behind_the_mountain();
        let start = game.units[0].pos;
        game.units.push(Unit.new(2, HIDDEN, Team.Red, UnitType.Melee));
        let fog = game.fog();
        assert(game.known_reachable_hexes(start, 3, Team.Blue, &fog).contains(HIDDEN));
        assert(!game.known_occupied(HIDDEN, &fog));

        // Having seen it there doesn't change that once it's out of sight.
        glance_at(&mut game, 0, HIDDEN);
        let fog = game.fog();
        assert(game.known_reachable_hexes(start, 3, Team.Blue, &fog).contains(HIDDEN));
    });
}

@test
fn clicking_an_unseen_enemys_hex_plans_a_move_not_an_attack() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = behind_the_mountain();
        game.units.push(Unit.new(2, HIDDEN, Team.Red, UnitType.Melee));
        game.try_queue_move(0, HIDDEN);
        assert(game.units[0].planned_move == Option.Some(HIDDEN));
        assert(game.units[0].planned_attack.is_none());
    });
}

@test
fn an_enemy_seen_then_seen_elsewhere_leaves_no_ghost() {
    sandbox(fn() can {Log, Rand, Assert} {
        // Red is seen at `HIDDEN`, then walks into sight next to Blue.
        let mut game = behind_the_mountain();
        game.units.push(Unit.new(2, HIDDEN, Team.Red, UnitType.Melee));
        glance_at(&mut game, 0, HIDDEN);
        let red = game.units.len() - 1;
        game.units[red].pos = Hex.new(0, 1);
        game.explore();
        let fog = game.fog();
        assert(fog.sees(Hex.new(0, 1)) && !fog.sees(HIDDEN));
        assert(!game.known_occupied(HIDDEN, &fog));
        assert(!game.known_enemy_target_at(HIDDEN, Team.Blue, &fog));
    });
}

@test
fn an_enemy_out_of_sight_is_not_a_target_even_if_seen_there() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = behind_the_mountain();
        game.units.push(Unit.new(2, HIDDEN, Team.Red, UnitType.Melee));
        glance_at(&mut game, 0, HIDDEN);
        let fog = game.fog();
        assert(!game.known_enemy_target_at(HIDDEN, Team.Blue, &fog));
    });
}

@test
fn yields_out_of_sight_are_as_last_seen() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = behind_the_mountain();
        glance_at(&mut game, 0, HIDDEN);
        let Option.Some(memory) = game.memory.get(HIDDEN) else { assert(false); return; };
        let (seen_food, seen_wood, seen_metal) = memory.yields;
        // Red farms the hex while nobody's looking.
        let _old = game.sites.insert(HIDDEN, Site { team: Team.Red, food: 9, production: 9, kind: SiteKind.Farm });
        let fog = game.fog();
        let (raw_food, raw_wood, raw_metal) = game.raw_yield(HIDDEN);
        assert(raw_food != seen_food || raw_wood != seen_wood || raw_metal != seen_metal);
        let (known_food, known_wood, known_metal) = game.known_yield(HIDDEN, &fog);
        assert(known_food == seen_food && known_wood == seen_wood && known_metal == seen_metal);
        let near = Hex.new(0, 1);
        let (a, b, c) = game.known_yield(near, &fog);
        let (d, e, f) = game.raw_yield(near);
        assert(a == d && b == e && c == f);
    });
}

@test
fn the_fog_notice_names_its_key() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.world_scenario(3);
        game.toggle_fog();
        {
            let first = &game.notice;
            assert(find(first, "F10").is_some());
        }
        game.toggle_fog();
        let second = &game.notice;
        assert(find(second, "F10").is_some());
    });
}

/// World 3 with the player alone, and a Red scout added far from Blue's units.
fn world_with_a_distant_red_scout() -> GameState can {Log, Assert} {
    let mut game = solo_world(3);
    let mut far = Hex.new(0, 0);
    let mut found = false;
    for hh in game.grid.hexes() {
        let h = *hh;
        if found || !game.grid.is_passable(h) { continue; }
        let mut away = true;
        for i in 0..game.units.len() { if game.units[i].pos.distance(h) <= 10 { away = false; } }
        if away { far = h; found = true; }
    }
    check_found(found);
    game.units.push(Unit.new(100, far, Team.Red, UnitType.Scout));
    game
}

fn check_found(found: bool) can {Assert} { assert(found); }

@test
fn enemies_out_of_sight_are_hidden() {
    sandbox(fn() can {Log, Rand, Assert} {
        let game = world_with_a_distant_red_scout();
        let fog = game.fog();
        let red = index_of(&game, 100);
        // Red is far out of sight.
        assert(!fog.shows(&game.units[red]));
        let mut blue_shown = false;
        for i in 0..game.units.len() { if game.units[i].team == Team.Blue && fog.shows(&game.units[i]) { blue_shown = true; } }
        assert(blue_shown);
    });
}

@test
fn units_are_forgotten_once_out_of_sight() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = world_with_a_distant_red_scout();
        let red = index_of(&game, 100);
        let settler = game.units[0].pos;
        let around = settler.neighbors();
        let mut near = settler;
        let mut found = false;
        for k in 0..6 { if !found && game.grid.is_passable(around[k]) && !game.is_occupied(around[k]) { near = around[k]; found = true; } }
        assert(found);
        // The Red scout wanders into sight next to Blue's settler.
        let red_start = game.units[red].pos;
        game.units[red].pos = near;
        game.explore();
        assert(game.known_occupied(near, &game.fog()));

        // Every Blue unit leaves, with the scout still standing there.
        for i in 0..game.units.len() { if game.units[i].team == Team.Blue { game.units[i].pos = red_start; } }
        game.explore();
        let fog = game.fog();
        assert(!fog.sees(near) && game.is_explored(near));
        assert(!game.known_occupied(near, &fog));
    });
}

@test
fn mountains_block_sight_beyond_them() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        game.units.clear();
        game.grid = HexGrid.new(4, &[(Hex.new(1, 0), MOUNTAINS)]);
        game.units.push(Unit.new(0, Hex.new(0, 0), Team.Blue, UnitType.Scout));
        let fog = game.fog();
        // The mountain itself shows.
        assert(fog.sees(Hex.new(1, 0)));
        assert(!fog.sees(Hex.new(2, 0)) && !fog.sees(Hex.new(3, 0)));
        // A line along the mountain's edge still passes on its clear side.
        assert(fog.sees(Hex.new(2, -1)));
        // Other directions are open.
        assert(fog.sees(Hex.new(-3, 0)));
    });
}

/// The whole world, as a view rectangle.
fn whole_world() -> (Vec2, Vec2) { (vec2(-1.0e6, -1.0e6), vec2(1.0e6, 1.0e6)) }

fn clouds(grid: &HexGrid, time: f32) -> Vec[MeshVertex] {
    let (lo, hi) = whole_world();
    let mut vertices: Vec[MeshVertex] = Vec.new();
    push_cloud_banks(grid, time, lo, hi, &mut vertices);
    vertices
}

@test
fn the_clouds_drift_and_billow_but_stay_over_the_map() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.world_scenario(3);
        let mut first = true;
        let mut lo = vec2(0.0, 0.0);
        let mut hi = vec2(0.0, 0.0);
        for h in game.grid.hexes() {
            let p = (*h).to_world();
            if first { lo = p; hi = p; first = false; } else { lo = lo.min(p); hi = hi.max(p); }
        }
        let reach = vec2(2.5 * CLOUD_SPACING, 2.5 * CLOUD_SPACING);
        let (lo, hi) = (lo.sub(reach), hi.add(reach));
        let still = clouds(&game.grid, 0.0);
        // The same time, the same clouds.
        assert(still.len() > 0 && still.len() == clouds(&game.grid, 0.0).len());
        let times = [0.5, 60.0, 600.0, 5000.0];
        for t in 0..4 {
            let later = clouds(&game.grid, times[t]);
            assert(later.len() < 120000);
            // The clouds move.
            let mut moved = false;
            let n = if later.len() < still.len() { later.len() } else { still.len() };
            for k in 0..n { if later[k].pos[0] != still[k].pos[0] || later[k].pos[1] != still[k].pos[1] { moved = true; } }
            assert(moved);
            // Whatever has drifted past the map's edge fades out: nothing is drawn more than a
            // bank's width beyond it.
            for k in 0..later.len() {
                let (x, y) = (later[k].pos[0], later[k].pos[1]);
                assert(x >= lo.x && y >= lo.y && x <= hi.x && y <= hi.y);
            }
        }
        game.animate_clouds(2.0);
        game.animate_clouds(3.0);
        assert(game.cloud_time == 5.0);
    });
}

@test
fn a_puff_fades_out_past_the_map_edge() {
    sandbox(fn() can {Log, Rand, Assert} {
        let game = GameState.world_scenario(3);
        let mut inside = vec2(0.0, 0.0);
        let mut found = false;
        for h in game.grid.hexes() { if !found { inside = (*h).to_world(); found = true; } }
        assert(edge_fade(&game.grid, inside) == 1.0);
        assert(edge_fade(&game.grid, vec2(1.0e4, 0.0)) == 0.0);
    });
}

@test
fn the_widest_view_of_a_world_fits_the_vertex_buffer() {
    sandbox(fn() can {Log, Rand, Assert} {
        // Fresh, under clouds, and with the fog lifted, every hex drawn.
        let mut game = GameState.world_scenario(7);
        game.explore();
        game.camera.zoom(-1000.0);
        // More than the renderer's buffer holds is cut off.
        assert(game.build_vertices().len() as u32 <= MAX_VERTICES);
        game.toggle_fog();
        assert(game.build_vertices().len() as u32 <= MAX_VERTICES);
    });
}

/// The cities scenario with no units, the player's city open, and one of its route hexes out
/// of the city's sight but explored (a scout looked and left). Answers the game, the city and
/// that hex.
pub fn remembered_route_hex() -> (GameState, i32, Hex) can {Log, Assert} {
    let mut game = GameState.city_scenario();
    game.units.clear();
    game.selected = Option.None;
    let mut city = 0;
    for c in 0..game.cities.len() { if game.cities[c].team == PLAYER_TEAM { city = c; } }
    game.selected_city = Option.Some(city);
    let fog = game.fog();
    let routes = game.routes(city);
    let mut far = Hex.new(0, 0);
    let mut found = false;
    for k in 0..routes.costs.len() {
        let Option.Some(h) = routes.costs.key_at(k) else { continue; };
        if fog.sees(h) || !game.grid.terrain(h).is_workable() { continue; }
        if !found || h.q < far.q || (h.q == far.q && h.r < far.r) { far = h; found = true; }
    }
    check_found(found);
    game.units.push(Unit.new(50, far, PLAYER_TEAM, UnitType.Scout));
    game.explore();
    game.units.clear();
    check_found(!game.fog().sees(far) && game.is_explored(far));
    (game, city, far)
}

@test
fn unseen_enemies_do_not_cut_the_routes_the_player_is_shown() {
    sandbox(fn() can {Log, Rand, Assert} {
        let (mut game, city, far) = remembered_route_hex();
        game.units.push(Unit.new(51, far, Team.Red, UnitType.Melee));
        // Goods really are cut, but the player is shown the route as last seen.
        assert(!game.routes(city).costs.has(far));
        let fog = game.fog();
        assert(game.known_routes(city, &fog).costs.has(far));
    });
}

@test
fn yield_badges_do_not_react_to_what_happens_out_of_sight() {
    sandbox(fn() can {Log, Rand, Assert} {
        let (mut game, city, far) = remembered_route_hex();
        assert(game.show_yields && game.yields_city() == Option.Some(city));
        let before = game.build_vertices().len();
        game.units.push(Unit.new(51, far, Team.Red, UnitType.Melee));
        assert(game.build_vertices().len() == before);
        let _old = game.sites.insert(far, Site { team: Team.Red, food: 9, production: 9, kind: SiteKind.Farm });
        assert(game.build_vertices().len() == before);
    });
}

fn count_color(vertices: &Vec[MeshVertex], color: Color) -> i32 {
    let mut n = 0;
    for k in 0..vertices.len() {
        let c = vertices[k].color;
        if c[0] == color[0] && c[1] == color[1] && c[2] == color[2] && c[3] == color[3] { n = n + 1; }
    }
    n
}

/// Whether two vertex lists draw exactly the same, vertex for vertex.
fn same_scene(a: &Vec[MeshVertex], b: &Vec[MeshVertex]) -> bool {
    if a.len() != b.len() { return false; }
    for k in 0..a.len() {
        let (x, y) = (a[k], b[k]);
        for c in 0..4 { if x.color[c] != y.color[c] { return false; } }
        for p in 0..3 { if x.pos[p] != y.pos[p] { return false; } }
    }
    true
}

@test
fn an_unseen_unit_leaves_its_hex_in_the_green_move_range() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = behind_the_mountain();
        glance_at(&mut game, 0, HIDDEN);
        game.selected = Option.Some(0);
        let empty = count_color(&game.build_vertices(), MOVE_RANGE_COLOR);
        assert(empty > 0);
        game.units.push(Unit.new(2, HIDDEN, Team.Red, UnitType.Melee));
        assert(count_color(&game.build_vertices(), MOVE_RANGE_COLOR) == empty);
    });
}

/// The scene a ranged unit (range 2) behind the mountain draws once it has looked at the hidden
/// hex, with an enemy seen there or not: in range but out of sight.
fn drawn(enemy_seen: bool) -> Vec[MeshVertex] can {Log, Assert} {
    let mut game = behind_the_mountain();
    game.units[0].unit_type = UnitType.Ranged;
    game.units[0].ability_queued = false;
    if enemy_seen { game.units.push(Unit.new(2, HIDDEN, Team.Red, UnitType.Melee)); }
    glance_at(&mut game, 0, HIDDEN);
    game.selected = Option.Some(0);
    game.build_vertices()
}

@test
fn an_enemy_seen_before_leaves_no_trace_once_out_of_sight() {
    sandbox(fn() can {Log, Rand, Assert} {
        // Neither a ghost of the enemy seen there nor a target highlight shows.
        assert(same_scene(&drawn(true), &drawn(false)));
    });
}

/// Blue's city alone at the origin on marsh, working (5, 0) behind a mountain at (3, 0) and
/// out of the city's sight, reached by a road around the mountain.
fn worked_tile_behind_the_mountain() -> (GameState, i32, Hex) can {Log, Assert} {
    let mut game = GameState.city_scenario();
    game.units.clear();
    game.sites = Map.new();
    game.memory = Map.new();
    game.player_controlled_units = IdSet.new();
    game.selected = Option.None;
    game.selected_city = Option.None;
    handle { game.cities.retain(); } with Keep[City] { keep(c) => { resume c.team == PLAYER_TEAM } }
    let origin = Hex.new(0, 0);
    let mountain = Hex.new(3, 0);
    let road = [Hex.new(1, 0), Hex.new(2, 0), Hex.new(3, -1), Hex.new(4, -1), Hex.new(4, 0), Hex.new(5, 0)];
    let mut tiles: Map[Hex, Tile] = Map.new();
    for hh in HexGrid.new(7, &[(origin, Tile.of(Terrain.Plains))]).hexes() {
        let h = *hh;
        let mut on_road = false;
        for k in 0..6 { if road[k] == h { on_road = true; } }
        let tile = if h == mountain { MOUNTAINS } else if h == origin || on_road { Tile.of(Terrain.Plains) } else { Tile.of(Terrain.Marsh) };
        let _old = tiles.insert(h, tile);
    }
    game.grid = HexGrid.from_tiles(GridShape.Hexagon(7), tiles);
    game.roads.clear();
    for k in 0..6 { game.roads.insert(road[k]); }
    let worked = Hex.new(5, 0);
    game.cities[0].pos = origin;
    game.cities[0].population = 1;
    let mut tiles: Vec[Hex] = Vec.new();
    tiles.push(worked);
    game.cities[0].clusters = one_cluster(&tiles);
    game.cities[0].remembered = one_cluster(&tiles);
    check_found(game.routes(0).costs.get(worked) == Option.Some(6));
    (game, 0, worked)
}

@test
fn a_worked_tile_is_in_sight_past_range_and_mountains() {
    sandbox(fn() can {Log, Rand, Assert} {
        let (mut game, city, worked) = worked_tile_behind_the_mountain();
        let pos = game.cities[city].pos;
        assert(pos.distance(worked) > CITY_SIGHT && !game.in_line_of_sight(pos, worked));
        game.explore();
        let fog = game.fog();
        assert(fog.sees(worked) && game.is_explored(worked));
        // Only the tile itself, not around it.
        assert(!fog.sees(Hex.new(4, 0)));

        // A Red unit steps onto it: the player sees it there.
        game.units.push(Unit.new(51, worked, Team.Red, UnitType.Melee));
        assert(game.fog().shows(&game.units[0]));
        assert(game.known_occupied(worked, &game.fog()));

        // The turn ends, and the cut-off citizen moves elsewhere; the enemy stays in sight on
        // the tile it took.
        game.resolve_economy();
        assert(!game.cities[city].works(worked));
        let fog = game.fog();
        assert(fog.sees(worked) && fog.shows(&game.units[0]));

        // Once the player assigns citizens elsewhere, which forgets that tile, it's out of
        // sight again.
        game.cities[city].remembered = copy_vec(&game.cities[city].clusters);
        assert(!game.fog().shows(&game.units[0]));
    });
}

@test
fn an_unseen_enemy_on_a_route_hex_still_cuts_goods() {
    sandbox(fn() can {Log, Rand, Assert} {
        // Accepted: an enemy on a route hex that isn't a worked tile stays hidden, but the
        // city's real income, rings and route notice (all from `routes`) show the goods it
        // cuts off.
        let (mut game, city, worked) = worked_tile_behind_the_mountain();
        let full = game.income(city);
        let blocker = Hex.new(4, -1);
        game.units.push(Unit.new(51, blocker, Team.Red, UnitType.Melee));
        game.explore();
        let fog = game.fog();
        assert(fog.sees(worked) && !fog.sees(blocker));
        assert(!fog.shows(&game.units[0]));
        // The goods detour south of the mountain, through the marsh at (2, 1) and (3, 1): two
        // hexes off the road, so a quarter arrives.
        let routes = game.routes(city);
        assert(routes.costs.get(worked) == Option.Some(8));
        assert(routes.toward_origin.get(worked) == Option.Some(Hex.new(4, 0)));
        assert(routes.toward_origin.get(Hex.new(4, 0)) == Option.Some(Hex.new(3, 1)));
        assert(routes.toward_origin.get(Hex.new(3, 1)) == Option.Some(Hex.new(2, 1)));
        let now = game.income(city);
        assert(now.food + now.production() < full.food + full.production());
    });
}

/// The scene with a fight over the hidden hex or not.
fn fight_scene(fight: bool) -> Vec[MeshVertex] can {Log, Assert} {
    let mut game = behind_the_mountain();
    glance_at(&mut game, 0, HIDDEN);
    if fight {
        game.units.push(Unit.new(2, HIDDEN, Team.Red, UnitType.Melee));
        game.units.push(Unit.new(3, HIDDEN, Team.Green, UnitType.Melee));
        check_found(game.is_contested(HIDDEN));
    }
    game.build_vertices()
}

@test
fn a_fight_out_of_sight_leaves_its_hex_uncolored() {
    sandbox(fn() can {Log, Rand, Assert} {
        assert(same_scene(&fight_scene(true), &fight_scene(false)));
        // In sight, the fight shows.
        let mut game = behind_the_mountain();
        let near = Hex.new(0, 1);
        game.units.push(Unit.new(2, near, Team.Red, UnitType.Melee));
        game.units[0].pos = near;
        game.selected = Option.None;
        game.explore();
        assert(count_color(&game.build_vertices(), CONTESTED_COLOR) > 0);
    });
}

/// The hex next to `hidden` with the lowest coordinates that is in sight (`seen`) or not, and
/// passable.
fn next_to_hidden(game: &GameState, seen: bool) -> Hex can {Assert} {
    let fog = game.fog();
    let around = HIDDEN.neighbors();
    let mut best = HIDDEN;
    let mut found = false;
    for k in 0..6 {
        let h = around[k];
        if fog.sees(h) != seen || !game.grid.terrain(h).is_passable() { continue; }
        if !found || h.q < best.q || (h.q == best.q && h.r < best.r) { best = h; found = true; }
    }
    check_found(found);
    best
}

/// Three Red units, one in sight beside the hidden hex, one on it and one unseen beside it.
fn red_beside_the_hidden_hex() -> GameState can {Log, Assert} {
    let mut game = behind_the_mountain();
    glance_at(&mut game, 0, HIDDEN);
    let near = next_to_hidden(&game, true);
    let unseen = next_to_hidden(&game, false);
    game.units.push(Unit.new(2, near, Team.Red, UnitType.Melee));
    game.units.push(Unit.new(3, HIDDEN, Team.Red, UnitType.Melee));
    game.units.push(Unit.new(4, unseen, Team.Red, UnitType.Melee));
    game
}

@test
fn another_sides_moves_show_only_in_sight_at_both_ends() {
    sandbox(fn() can {Log, Rand, Assert} {
        // A Red unit in sight next to the hex behind the mountain, and two Red units out of
        // sight: what they plan out of sight draws nothing.
        let quiet = red_beside_the_hidden_hex().build_vertices();

        // Into the hidden hex, and two unseen units swapping places.
        let mut moving = red_beside_the_hidden_hex();
        let unseen = moving.units[3].pos;
        moving.units[1].planned_move = Option.Some(HIDDEN);
        moving.units[2].planned_move = Option.Some(unseen);
        moving.units[3].planned_move = Option.Some(HIDDEN);
        assert(moving.swap_partner(2).is_some());
        assert(same_scene(&moving.build_vertices(), &quiet));

        // A move in sight at both ends still shows its ghost.
        let mut moving = red_beside_the_hidden_hex();
        let near = moving.units[1].pos;
        let toward = Hex.new(0, 1);
        moving.units[1].planned_move = Option.Some(toward);
        assert(moving.fog().sees(toward) && moving.fog().sees(near));
        assert(!same_scene(&moving.build_vertices(), &quiet));
    });
}

/// The city of `worked_tile_behind_the_mountain`, now Red's and working `worked`, seen by two
/// Blue scouts: one west of its center, one by the tile it works east of the mountain. With
/// `cut`, Green out of their sight stands on both hexes that start the road home, so no goods
/// arrive. Answers whether `worked` is in sight and the scene with the city hovered.
fn hovered_red_city(worked: Hex, cut: bool) -> (bool, Vec[MeshVertex]) can {Log, Assert} {
    let (mut game, city, _tile) = worked_tile_behind_the_mountain();
    game.cities[city].team = Team.Red;
    let mut tiles: Vec[Hex] = Vec.new();
    tiles.push(worked);
    game.cities[city].clusters = one_cluster(&tiles);
    game.cities[city].remembered = one_cluster(&tiles);
    game.units.push(Unit.new(50, Hex.new(-3, 0), Team.Blue, UnitType.Scout));
    game.units.push(Unit.new(51, Hex.new(6, 1), Team.Blue, UnitType.Scout));
    let first = Hex.new(1, 0);
    let second = Hex.new(1, -1);
    if cut {
        game.units.push(Unit.new(52, first, Team.Green, UnitType.Melee));
        game.units.push(Unit.new(53, second, Team.Green, UnitType.Melee));
    }
    game.explore();
    let fog = game.fog();
    check_found(fog.sees(game.cities[city].pos));
    check_found(!fog.sees(first) && !fog.sees(second));
    let arrives = game.routes(city).costs.has(worked);
    check_found(arrives != cut || !fog.sees(worked));
    game.hovered_city = Option.Some(city);
    game.hovered_tile = Option.Some(game.cities[city].pos);
    (fog.sees(worked), game.build_vertices())
}

@test
fn a_hovered_enemy_city_rings_only_its_tiles_in_sight_and_not_their_routes() {
    sandbox(fn() can {Log, Rand, Assert} {
        let (seen, in_sight) = hovered_red_city(Hex.new(5, 0), false);
        assert(seen);
        let (_s, cut_off) = hovered_red_city(Hex.new(5, 0), true);
        assert(same_scene(&cut_off, &in_sight));

        let (seen, out_of_sight) = hovered_red_city(Hex.new(0, 5), false);
        assert(!seen && !same_scene(&out_of_sight, &in_sight));
        let (_s, elsewhere) = hovered_red_city(Hex.new(0, -5), false);
        assert(same_scene(&elsewhere, &out_of_sight));
        let (_s, cut_unseen) = hovered_red_city(Hex.new(0, 5), true);
        assert(same_scene(&cut_unseen, &out_of_sight));
    });
}

/// A worker of `team` at `job`'s tile: at work on it, or just arrived.
fn worker_at(team: Team, job: WorkerJob, working: bool) -> FieldWorker {
    FieldWorker { id: 77, team, home: 0, base: job.hex, pos: job.hex, job: Option.Some(job), work_left: if working { Option.Some(2) } else { Option.None }, recalled: false }
}

/// The jobs of other sides the memory keeps of `hex`, and the first one's side.
fn remembered_jobs(game: &GameState, hex: Hex) -> (i32, Option[Team]) {
    let Option.Some(seen) = game.memory.get(hex) else { return (0 - 1, Option.None); };
    let mut n = 0;
    let mut team: Option[Team] = Option.None;
    for k in 0..3 {
        if let Option.Some(job) = seen.construction[k] {
            if n == 0 { team = Option.Some(job.team); }
            n = n + 1;
        }
    }
    (n, team)
}

@test
fn the_memory_keeps_other_sides_construction_but_not_their_plans() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = behind_the_mountain();
        let job = WorkerJob.on_tile(HIDDEN, JobKind.Build(Building.Barracks));
        // Just arrived, not yet at work: nothing on the ground.
        game.field_workers.push(worker_at(Team.Red, job, false));
        glance_at(&mut game, 0, HIDDEN);
        let (n, _) = remembered_jobs(&game, HIDDEN);
        assert(n == 0);
        // At work: remembered with its side, and nothing else.
        game.field_workers.clear();
        game.field_workers.push(worker_at(Team.Red, job, true));
        glance_at(&mut game, 0, HIDDEN);
        let (n, team) = remembered_jobs(&game, HIDDEN);
        assert(n == 1 && team == Option.Some(Team.Red));
        // Finished out of sight: still as last seen.
        game.field_workers.clear();
        game.explore();
        let (n, _) = remembered_jobs(&game, HIDDEN);
        assert(n == 1);
        // The player's own jobs are drawn from the board, not remembered (and a worker of theirs
        // sees its tile).
        game.field_workers.push(worker_at(PLAYER_TEAM, job, true));
        game.explore();
        assert(game.fog().sees(HIDDEN));
        let (n, _) = remembered_jobs(&game, HIDDEN);
        assert(n == 0);
    });
}

/// Vertices of `color` for a job's ring (or edge) and its name: what another side's construction
/// adds.
fn construction_vertices(job: WorkerJob, name: str, color: Color) -> i32 {
    let mut out: Vec[MeshVertex] = Vec.new();
    push_seen_job(job, name, color, &mut out);
    count_color(&out, color)
}

@test
fn another_sides_construction_in_sight_shows_in_its_color_named_without_turns() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = behind_the_mountain();
        game.camera.center = vec2(0.0, 0.0);
        let near = Hex.new(0, 1);
        assert(game.fog().sees(near));
        let red = Team.Red.color();

        // Red's worker just arrived shows only itself; at work, its Barracks going up too: a
        // red ring named BARRACKS, no turns left.
        let barracks = WorkerJob.on_tile(near, JobKind.Build(Building.Barracks));
        game.field_workers.push(worker_at(Team.Red, barracks, false));
        let idle = count_color(&game.build_vertices(), red);
        game.field_workers.clear();
        game.field_workers.push(worker_at(Team.Red, barracks, true));
        assert(count_color(&game.build_vertices(), red) - idle == construction_vertices(barracks, "BARRACKS", red));
        assert(count_color(&game.build_vertices(), JOB_UNDER_WAY_COLOR) == 0);

        // A wall on one of the tile's edges: the edge, named.
        let wall = WorkerJob { hex: near, kind: JobKind.Wall, across: Option.Some(Hex.new(1, 1)), done: 0 };
        game.field_workers.clear();
        game.field_workers.push(worker_at(Team.Red, wall, false));
        let idle = count_color(&game.build_vertices(), red);
        game.field_workers.clear();
        game.field_workers.push(worker_at(Team.Red, wall, true));
        assert(count_color(&game.build_vertices(), red) - idle == construction_vertices(wall, "WALL", red));

        // The player's own job is drawn as before, in bright gold with its turns left, and not
        // in team color.
        let blue = game.local_team.color();
        game.field_workers.clear();
        game.field_workers.push(worker_at(game.local_team, barracks, false));
        let idle = count_color(&game.build_vertices(), blue);
        game.field_workers.clear();
        game.field_workers.push(worker_at(game.local_team, barracks, true));
        assert(count_color(&game.build_vertices(), blue) == idle);
        assert(count_color(&game.build_vertices(), JOB_UNDER_WAY_COLOR) > 0);
    });
}

@test
fn another_sides_construction_out_of_sight_shows_only_as_last_seen() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = behind_the_mountain();
        game.camera.center = vec2(0.0, 0.0);
        let red = Team.Red.color();
        let job = WorkerJob.on_tile(HIDDEN, JobKind.Fort);

        // Never seen: nothing of it shows.
        let before = game.build_vertices();
        game.field_workers.push(worker_at(Team.Red, job, true));
        game.explore();
        assert(same_scene(&game.build_vertices(), &before));

        // Seen at work, then out of sight: it stays as last seen, even once the worker has gone.
        glance_at(&mut game, 0, HIDDEN);
        let shown = construction_vertices(job, "FORT", red);
        assert(count_color(&game.build_vertices(), red) == shown);
        game.field_workers.clear();
        game.explore();
        assert(count_color(&game.build_vertices(), red) == shown);

        // Seen again with nobody at work there: gone.
        glance_at(&mut game, 0, HIDDEN);
        assert(count_color(&game.build_vertices(), red) == 0);
    });
}
