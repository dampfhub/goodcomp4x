//! Teams, unit types and their base stats, and a unit's state within a turn.

use std.collections.Set;
use std.fmt.Show;
use std.fmt.show_u64;
use game.ability.Ability;
use game.ability.SHIELD_WALL_DEFENSE;
use game.ability.CHARGE_ATTACK;
use game.ability.CHARGE_EXTRA_MOVE;
use game.ability.DEPLOYED_EXTRA_RANGE;
use game.hex.Hex;
use game.terrain.Resource;
use std.core.Eq;
use game.mesh.Color;

/// A side. Blue is the player (`PLAYER_TEAM`); every other team is played by the AI, and every
/// team is at war with every other.
pub enum Team { Blue, Red, Green, Gold, Purple, Teal, Orange }

/// Every team, the player's first: the order AI teams plan their turns in and take the world's
/// starts in.
pub const TEAMS: [Team; 7] = [Team.Blue, Team.Red, Team.Green, Team.Gold, Team.Purple, Team.Teal, Team.Orange];

impl Team {
    /// The team's name as the UI prints it.
    pub fn name(self) -> str {
        match self {
            Team.Blue => "BLUE",
            Team.Red => "RED",
            Team.Green => "GREEN",
            Team.Gold => "GOLD",
            Team.Purple => "PURPLE",
            Team.Teal => "TEAL",
            Team.Orange => "ORANGE",
        }
    }

    pub fn color(self) -> Color {
        match self {
            Team.Blue => [0.30, 0.55, 0.95, 1.0],
            Team.Red => [0.92, 0.32, 0.28, 1.0],
            Team.Green => [0.30, 0.78, 0.30, 1.0],
            Team.Gold => [0.95, 0.76, 0.20, 1.0],
            Team.Purple => [0.66, 0.40, 0.92, 1.0],
            Team.Teal => [0.22, 0.80, 0.78, 1.0],
            Team.Orange => [0.97, 0.52, 0.16, 1.0],
        }
    }

    /// The team's place in `TEAMS`.
    pub fn index(self) -> i32 {
        match self {
            Team.Blue => 0,
            Team.Red => 1,
            Team.Green => 2,
            Team.Gold => 3,
            Team.Purple => 4,
            Team.Teal => 5,
            Team.Orange => 6,
        }
    }
}

impl Eq for Team {
    fn eq(self, other: Team) -> bool { self.index() == other.index() }
}

/// `Blue`: the variant's name, as the combat log names a team.
impl Show for Team {
    fn show(&self) can {Out} {
        match *self {
            Team.Blue => Out.put("Blue"),
            Team.Red => Out.put("Red"),
            Team.Green => Out.put("Green"),
            Team.Gold => Out.put("Gold"),
            Team.Purple => Out.put("Purple"),
            Team.Teal => Out.put("Teal"),
            Team.Orange => Out.put("Orange"),
        }
    }
}

pub enum UnitType {
    Melee,
    Ranged,
    Cavalry,
    Siege,
    /// Fast and far-sighted, but hardly a fighter: for exploring.
    Scout,
    Armored,
    PatrolGalley,
    LandingCraft,
    BombardShip,
}

pub struct UnitStats {
    max_hp: f32,
    attack: f32,
    defense: f32,
    move_range: i32,
    attack_range: i32,
}

/// A Forge's (iron) or Stable's (horses) upgrade to the stats of a troop it trained.
pub fn apply_training_upgrade(stats: &mut UnitStats, upgrade: Option[Resource]) {
    match upgrade {
        Option.Some(Resource.Iron) => {
            stats.max_hp = stats.max_hp * 1.2;
            stats.defense = stats.defense * 1.15;
        }
        Option.Some(Resource.Horses) => { stats.move_range = stats.move_range + 1; }
        Option.None => {}
    }
}

impl UnitType {
    pub fn is_naval(self) -> bool {
        match self { UnitType.PatrolGalley | UnitType.LandingCraft | UnitType.BombardShip => true, _ => false }
    }

    /// Melee is the balanced baseline; ranged trades toughness for reach, cavalry trades
    /// defense for mobility, and siege hits hardest but folds once anything reaches it. Scouts
    /// give up fighting for speed and sight.
    pub fn stats(self) -> UnitStats {
        let (max_hp, attack, defense, move_range, attack_range) = match self {
            UnitType.Melee => (100.0, 22.0, 20.0, 1, 1),
            UnitType.Ranged => (75.0, 24.0, 10.0, 1, 2),
            UnitType.Cavalry => (100.0, 24.0, 14.0, 2, 1),
            UnitType.Siege => (65.0, 32.0, 6.0, 1, 2),
            UnitType.Scout => (60.0, 8.0, 10.0, 3, 1),
            UnitType.Armored => (140.0, 30.0, 28.0, 1, 1),
            UnitType.PatrolGalley => (115.0, 23.0, 17.0, 3, 1),
            UnitType.LandingCraft => (125.0, 8.0, 15.0, 2, 1),
            UnitType.BombardShip => (105.0, 30.0, 12.0, 2, 3),
        };
        UnitStats { max_hp, attack, defense, move_range, attack_range }
    }

    /// How many hexes around it the unit sees through the fog of war.
    pub fn sight(self) -> i32 {
        match self { UnitType.Scout | UnitType.Cavalry | UnitType.PatrolGalley => 3, _ => 2 }
    }
}

/// `Melee`: the variant's name, as the combat log names a unit type.
impl Show for UnitType {
    fn show(&self) can {Out} {
        match *self {
            UnitType.Melee => Out.put("Melee"),
            UnitType.Ranged => Out.put("Ranged"),
            UnitType.Cavalry => Out.put("Cavalry"),
            UnitType.Siege => Out.put("Siege"),
            UnitType.Scout => Out.put("Scout"),
            UnitType.Armored => Out.put("Armored"),
            UnitType.PatrolGalley => Out.put("PatrolGalley"),
            UnitType.LandingCraft => Out.put("LandingCraft"),
            UnitType.BombardShip => Out.put("BombardShip"),
        }
    }
}

/// One later turn in a unit's order queue (Shift-click, `order_queue.tua`).
pub struct TurnOrder {
    /// Where the unit should stand when this turn starts. If it isn't there (its earlier move
    /// was blocked, say), the rest of the queue is dropped.
    from: Hex,
    move_to: Option[Hex],
    attack: Option[Hex],
}

impl Eq for TurnOrder {
    fn eq(self, other: TurnOrder) -> bool {
        self.from == other.from && self.move_to == other.move_to && self.attack == other.attack
    }
}

impl TurnOrder {
    /// Where the unit stands once this turn's move is done.
    pub fn end_pos(&self) -> Hex { self.move_to.unwrap_or(self.from) }
}

/// A set of unit ids. The standard library keys a set by `i64`, so each `u32` id is widened on
/// the way in.
pub struct IdSet { ids: Set[i64] }

impl IdSet {
    pub fn new() -> IdSet { IdSet { ids: Set.new() } }
    pub fn insert(&mut self, id: u32) -> bool { self.ids.insert(id as i64) }
    pub fn remove(&mut self, id: u32) -> bool { self.ids.remove(id as i64) }
    pub fn contains(&self, id: u32) -> bool { self.ids.contains(id as i64) }
    pub fn len(&self) -> i32 { self.ids.len() }

    /// A copy of the set, for a savestate.
    pub fn snapshot(&self) -> IdSet {
        let mut out = IdSet.new();
        for i in 0..self.ids.len() {
            if let Option.Some(k) = self.ids.key_at(i) { let _new = out.ids.insert(k); }
        }
        out
    }
}

pub struct Unit {
    id: u32,
    pos: Hex,
    team: Team,
    unit_type: UnitType,
    hp: f32,
    /// Independent tactical health inside cities. Either health bar reaching zero kills the
    /// same logical unit in both layers.
    interior_hp: f32,
    /// A Forge or Stable upgrade earned when this troop was trained.
    training_upgrade: Option[Resource],
    /// Orders queued for this turn. The attack targets a hex rather than a unit: whichever
    /// enemy stands there when it resolves gets hit.
    planned_move: Option[Hex],
    planned_attack: Option[Hex],
    /// Whether the unit's ability is queued for this turn.
    ability_queued: bool,
    /// Turns left before the ability can be used again.
    ability_cooldown: u32,
    /// Siege only: set up, with extra range but unable to move.
    deployed: bool,
    /// The player chose to hold this unit, leaving any move or attack it hasn't queued unused
    /// this turn.
    holding: bool,
    /// Like `holding`, but lasting across turns: the unit stays put and is skipped in the
    /// turn order until it's given an order or unguarded.
    guarding: bool,
    /// Scout only: spent last turn on lookout, so it sees farther until the end of this one.
    lookout: bool,
    /// Orders for the turns after this one, in turn order: each turn's end moves the first of
    /// them into `planned_move` and `planned_attack`.
    queued: Vec[TurnOrder],
    /// This turn's orders came from a queue the player built with Shift, so the unit doesn't
    /// hold up ending the turn.
    following_queue: bool,
    /// Land units carried by a landing craft. Cargo is lost if it sinks.
    cargo: Vec[Unit],
    /// Boarding and landing resolve with the rest of the turn.
    planned_board: Option[u32],
    planned_unload: Option[Hex],
}

impl Unit {
    pub fn new(id: u32, pos: Hex, team: Team, unit_type: UnitType) -> Unit {
        Unit {
            id,
            pos,
            team,
            unit_type,
            hp: unit_type.stats().max_hp,
            interior_hp: unit_type.stats().max_hp,
            training_upgrade: Option.None,
            planned_move: Option.None,
            planned_attack: Option.None,
            ability_queued: false,
            ability_cooldown: 0,
            deployed: false,
            holding: false,
            guarding: false,
            lookout: false,
            queued: Vec.new(),
            following_queue: false,
            cargo: Vec.new(),
            planned_board: Option.None,
            planned_unload: Option.None,
        }
    }

    pub fn is_naval(&self) -> bool { self.unit_type.is_naval() }

    /// A copy of the unit, its queue and its cargo included, for a savestate.
    pub fn snapshot(&self) -> Unit {
        let mut queued: Vec[TurnOrder] = Vec.new();
        for i in 0..self.queued.len() { queued.push(self.queued[i]); }
        let mut cargo: Vec[Unit] = Vec.new();
        for i in 0..self.cargo.len() { cargo.push(self.cargo[i].snapshot()); }
        Unit {
            id: self.id,
            pos: self.pos,
            team: self.team,
            unit_type: self.unit_type,
            hp: self.hp,
            interior_hp: self.interior_hp,
            training_upgrade: self.training_upgrade,
            planned_move: self.planned_move,
            planned_attack: self.planned_attack,
            ability_queued: self.ability_queued,
            ability_cooldown: self.ability_cooldown,
            deployed: self.deployed,
            holding: self.holding,
            guarding: self.guarding,
            lookout: self.lookout,
            queued,
            following_queue: self.following_queue,
            cargo,
            planned_board: self.planned_board,
            planned_unload: self.planned_unload,
        }
    }

    pub fn ability(&self) -> Ability { Ability.of(self.unit_type) }

    /// The unit's stats with its training upgrade, queued ability and siege deployment
    /// applied.
    pub fn stats(&self) -> UnitStats {
        let mut stats = self.unit_type.stats();
        apply_training_upgrade(&mut stats, self.training_upgrade);
        if self.ability_queued {
            match self.ability() {
                Ability.ShieldWall => {
                    stats.defense = stats.defense * SHIELD_WALL_DEFENSE;
                    stats.move_range = 0;
                }
                Ability.Charge => {
                    stats.attack = stats.attack * CHARGE_ATTACK;
                    stats.move_range = stats.move_range + CHARGE_EXTRA_MOVE;
                }
                // Busy setting up or packing up.
                Ability.Deploy => { stats.move_range = 0; }
                // Standing still, watching.
                Ability.Lookout => { stats.move_range = 0; }
                Ability.Volley => {}
            }
        }
        if self.deployed {
            stats.move_range = 0;
            stats.attack_range = stats.attack_range + DEPLOYED_EXTRA_RANGE;
        }
        stats
    }

    /// Siege spends the turn it sets up or packs up unable to attack.
    pub fn can_attack(&self) -> bool {
        self.unit_type != UnitType.LandingCraft && !(self.ability_queued && self.ability() == Ability.Deploy)
    }

    /// Where the unit will be once its queued move (if any) resolves.
    pub fn planned_pos(&self) -> Hex { self.planned_move.unwrap_or(self.pos) }

    /// Drops the queued attack if the unit can no longer make it, e.g. after the move that
    /// brought it into range was changed.
    pub fn drop_unreachable_attack(&mut self) {
        if let Option.Some(target) = self.planned_attack {
            if !self.can_attack() || self.planned_pos().distance(target) > self.stats().attack_range {
                self.planned_attack = Option.None;
            }
        }
    }

    /// The unit's stats in the turns after this one, for planning its queue: no ability
    /// queued, and deployed if it sets up this turn (or packed up if it packs up).
    pub fn later_stats(&self) -> UnitStats {
        let mut stats = self.unit_type.stats();
        apply_training_upgrade(&mut stats, self.training_upgrade);
        let deploying = self.ability_queued && self.ability() == Ability.Deploy;
        if self.deployed != deploying {
            stats.move_range = 0;
            stats.attack_range = stats.attack_range + DEPLOYED_EXTRA_RANGE;
        }
        stats
    }

    /// Whether the unit is following a queue of orders built with Shift.
    pub fn has_queue(&self) -> bool { self.following_queue || !self.queued.is_empty() }

    /// Whether the unit has anything Clear Orders would drop: a move, an attack, a queue, a
    /// hold or a guard.
    pub fn has_orders(&self) -> bool {
        self.has_queue() || self.planned_move.is_some() || self.planned_attack.is_some() || self.holding || self.guarding
    }

    /// Whether the unit's plan reaches past this turn, so the map shows it as numbered turns. A
    /// plan of this turn alone draws like ordinary orders: a ghost and an attack arrow.
    pub fn plans_later_turns(&self) -> bool { !self.queued.is_empty() }

    /// How many turns the unit has orders for: none, this turn, or this turn and its queue. A
    /// queued turn may be spent waiting.
    pub fn plan_len(&self) -> i32 {
        if self.has_queue() {
            1 + self.queued.len()
        } else if self.planned_move.is_some() || self.planned_attack.is_some() {
            1
        } else {
            0
        }
    }

    /// Where the unit will stand after the first `turns` turns of its plan (where it stands
    /// now for 0; where its plan ends past its last turn).
    pub fn pos_after(&self, turns: i32) -> Hex {
        if turns == 0 { return self.pos; }
        if turns == 1 { return self.planned_pos(); }
        let n = self.queued.len();
        if n == 0 { return self.planned_pos(); }
        let at = if turns - 2 < n { turns - 2 } else { n - 1 };
        self.queued[at].end_pos()
    }

    /// The attack planned for turn `turn` of the unit's plan (0 is this turn).
    pub fn attack_on_turn(&self, turn: i32) -> Option[Hex] {
        if turn == 0 { return self.planned_attack; }
        if turn - 1 < self.queued.len() { self.queued[turn - 1].attack } else { Option.None }
    }

    /// Where the unit's plan leaves it.
    pub fn plan_end(&self) -> Hex {
        if self.queued.is_empty() { self.planned_pos() } else { self.queued[self.queued.len() - 1].end_pos() }
    }

    /// Drops the turns queued after this one; this turn's orders stay.
    pub fn cancel_queue(&mut self) {
        self.queued.clear();
        self.following_queue = false;
    }

    /// Clears this turn's orders and a hold, but not the turns queued after it.
    fn clear_this_turn(&mut self) {
        self.planned_move = Option.None;
        self.planned_attack = Option.None;
        self.planned_board = Option.None;
        self.planned_unload = Option.None;
        self.ability_queued = false;
        self.holding = false;
        self.following_queue = false;
    }

    /// Clears every order: this turn's, the queue, and a hold.
    pub fn clear_orders(&mut self) {
        self.clear_this_turn();
        self.cancel_queue();
    }

    /// End-of-turn bookkeeping: puts a used ability on cooldown (or ticks the cooldown down),
    /// completes a siege setup or pack-up, starts or ends a scout's lookout, and clears this
    /// turn's orders. The queue stays, for `advance_queues` to take the next turn from.
    pub fn end_turn(&mut self) {
        self.lookout = self.ability_queued && self.ability() == Ability.Lookout;
        if self.ability_queued {
            self.ability_cooldown = self.ability().cooldown();
            if self.ability() == Ability.Deploy {
                self.deployed = !self.deployed;
            }
        } else if self.ability_cooldown > 0 {
            self.ability_cooldown = self.ability_cooldown - 1;
        }
        self.clear_this_turn();
    }

    pub fn max_hp(&self) -> f32 { self.stats().max_hp }

    pub fn is_alive(&self) -> bool { self.hp > 0.0 }
}

/// `Blue Cavalry #2`: the team, the type and the id, as the combat log names a unit.
impl Show for Unit {
    fn show(&self) can {Out} {
        self.team.show();
        Out.put(" ");
        self.unit_type.show();
        Out.put(" #");
        show_u64(self.id as u64);
    }
}
