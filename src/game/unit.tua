//! Teams, unit types and their base stats, and a unit's state within a turn.

use std.collections.Set;
use std.fmt.Show;
use std.fmt.show_u64;
use game.ability.Ability;
use game.ability.SHIELD_WALL_DEFENSE;
use game.ability.CHARGE_ATTACK;
use game.ability.CHARGE_EXTRA_MOVE;
use game.ability.DEPLOYED_EXTRA_RANGE;
use game.hex.Hex;
use game.mesh.Color;

pub enum Team { Blue, Red }

impl Team {
    /// The team's name as the UI prints it.
    pub fn name(self) -> str {
        match self { Team.Blue => "BLUE", Team.Red => "RED" }
    }

    pub fn color(self) -> Color {
        match self {
            Team.Blue => [0.30, 0.55, 0.95, 1.0],
            Team.Red => [0.92, 0.32, 0.28, 1.0],
        }
    }
}

impl Show for Team {
    fn show(&self) can {Out} {
        match *self { Team.Blue => Out.put("Blue"), Team.Red => Out.put("Red") }
    }
}

pub enum UnitType { Melee, Ranged, Cavalry, Siege }

pub struct UnitStats {
    max_hp: f32,
    attack: f32,
    defense: f32,
    move_range: i32,
    attack_range: i32,
}

impl UnitType {
    /// Melee is the balanced baseline; ranged trades toughness for reach, cavalry trades
    /// defense for mobility, and siege hits hardest but folds once anything reaches it.
    pub fn stats(self) -> UnitStats {
        match self {
            UnitType.Melee => UnitStats { max_hp: 100.0, attack: 22.0, defense: 20.0, move_range: 1, attack_range: 1 },
            UnitType.Ranged => UnitStats { max_hp: 75.0, attack: 24.0, defense: 10.0, move_range: 1, attack_range: 2 },
            UnitType.Cavalry => UnitStats { max_hp: 100.0, attack: 24.0, defense: 14.0, move_range: 2, attack_range: 1 },
            UnitType.Siege => UnitStats { max_hp: 65.0, attack: 32.0, defense: 6.0, move_range: 1, attack_range: 2 },
        }
    }

    /// Side count of the placeholder icon polygon.
    pub fn icon_sides(self) -> u32 {
        match self {
            UnitType.Melee => 3,
            UnitType.Ranged => 4,
            UnitType.Cavalry => 5,
            UnitType.Siege => 8,
        }
    }

    pub fn letter(self) -> char {
        match self {
            UnitType.Melee => 'M',
            UnitType.Ranged => 'R',
            UnitType.Cavalry => 'C',
            UnitType.Siege => 'S',
        }
    }
}

impl Show for UnitType {
    fn show(&self) can {Out} {
        match *self {
            UnitType.Melee => Out.put("Melee"),
            UnitType.Ranged => Out.put("Ranged"),
            UnitType.Cavalry => Out.put("Cavalry"),
            UnitType.Siege => Out.put("Siege"),
        }
    }
}

/// A set of unit ids. The standard library keys a set by `i64`, so each `u32` id is widened on
/// the way in.
pub struct IdSet { ids: Set[i64] }

impl IdSet {
    pub fn new() -> IdSet { IdSet { ids: Set.new() } }
    pub fn insert(&mut self, id: u32) -> bool { self.ids.insert(id as i64) }
    pub fn remove(&mut self, id: u32) -> bool { self.ids.remove(id as i64) }
    pub fn contains(&self, id: u32) -> bool { self.ids.contains(id as i64) }
    pub fn len(&self) -> i32 { self.ids.len() }

    /// A copy of the set, for a savestate.
    pub fn snapshot(&self) -> IdSet {
        let mut out = IdSet.new();
        for i in 0..self.ids.len() {
            if let Option.Some(k) = self.ids.key_at(i) { let _new = out.ids.insert(k); }
        }
        out
    }
}

pub struct Unit {
    id: u32,
    pos: Hex,
    team: Team,
    unit_type: UnitType,
    hp: f32,
    /// Orders queued for this turn. The attack targets a hex rather than a unit: whichever
    /// enemy stands there when it resolves gets hit.
    planned_move: Option[Hex],
    planned_attack: Option[Hex],
    /// Whether the unit's ability is queued for this turn.
    ability_queued: bool,
    /// Turns left before the ability can be used again.
    ability_cooldown: u32,
    /// Siege only: set up, with extra range but unable to move.
    deployed: bool,
    /// The player chose to hold this unit, leaving any move or attack it hasn't queued unused
    /// this turn.
    holding: bool,
    /// Like `holding`, but lasting across turns: the unit stays put and is skipped in the
    /// turn order until it's given an order or unguarded.
    guarding: bool,
}

impl Unit {
    pub fn new(id: u32, pos: Hex, team: Team, unit_type: UnitType) -> Unit {
        Unit {
            id,
            pos,
            team,
            unit_type,
            hp: unit_type.stats().max_hp,
            planned_move: Option.None,
            planned_attack: Option.None,
            ability_queued: false,
            ability_cooldown: 0,
            deployed: false,
            holding: false,
            guarding: false,
        }
    }

    pub fn ability(&self) -> Ability { Ability.of(self.unit_type) }

    /// The unit's stats with its queued ability and siege deployment applied.
    pub fn stats(&self) -> UnitStats {
        let mut stats = self.unit_type.stats();
        if self.ability_queued {
            match self.ability() {
                Ability.ShieldWall => {
                    stats.defense = stats.defense * SHIELD_WALL_DEFENSE;
                    stats.move_range = 0;
                }
                Ability.Charge => {
                    stats.attack = stats.attack * CHARGE_ATTACK;
                    stats.move_range = stats.move_range + CHARGE_EXTRA_MOVE;
                }
                // Busy setting up or packing up.
                Ability.Deploy => { stats.move_range = 0; }
                Ability.Volley => {}
            }
        }
        if self.deployed {
            stats.move_range = 0;
            stats.attack_range = stats.attack_range + DEPLOYED_EXTRA_RANGE;
        }
        stats
    }

    /// Siege spends the turn it sets up or packs up unable to attack.
    pub fn can_attack(&self) -> bool { !(self.ability_queued && self.ability() == Ability.Deploy) }

    /// Where the unit will be once its queued move (if any) resolves.
    pub fn planned_pos(&self) -> Hex { self.planned_move.unwrap_or(self.pos) }

    /// Drops the queued attack if the unit can no longer make it, e.g. after the move that
    /// brought it into range was changed.
    pub fn drop_unreachable_attack(&mut self) {
        if let Option.Some(target) = self.planned_attack {
            if !self.can_attack() || self.planned_pos().distance(target) > self.stats().attack_range {
                self.planned_attack = Option.None;
            }
        }
    }

    pub fn clear_orders(&mut self) {
        self.planned_move = Option.None;
        self.planned_attack = Option.None;
        self.ability_queued = false;
        self.holding = false;
    }

    /// End-of-turn bookkeeping: puts a used ability on cooldown (or ticks the cooldown down),
    /// completes a siege setup or pack-up, and clears orders.
    pub fn end_turn(&mut self) {
        if self.ability_queued {
            self.ability_cooldown = self.ability().cooldown();
            if self.ability() == Ability.Deploy {
                self.deployed = !self.deployed;
            }
        } else if self.ability_cooldown > 0 {
            self.ability_cooldown = self.ability_cooldown - 1;
        }
        self.clear_orders();
    }

    pub fn max_hp(&self) -> f32 { self.unit_type.stats().max_hp }

    pub fn is_alive(&self) -> bool { self.hp > 0.0 }
}

/// `Blue Cavalry #2`: the team, the type and the id, as the combat log names a unit.
impl Show for Unit {
    fn show(&self) can {Out} {
        self.team.show();
        Out.put(" ");
        self.unit_type.show();
        Out.put(" #");
        show_u64(self.id as u64);
    }
}
