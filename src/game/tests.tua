//! The rules as played: pathing, contested hexes, swaps, simultaneous resolution, the four
//! abilities, selection and the turn loop. Each test starts from `GameState.new()`'s layout.

use std.linalg.Vec2;
use std.core.Keep;
use std.core.Option;
use std.linalg.vec2;
use std.rand.Rand;
use std.rand.seed;
use std.test.assert;
use std.test.assert_fail;
use std.test.Assert;
use log.Log;
use renderer.pipelines.MeshVertex;
use game.GameState;
use game.GRID_RADIUS;
use game.city.Build;
use game.city.Queued;
use game.city.Building;
use game.city.BuildUnit;
use game.combat.damage;
use game.effects.Effect;
use game.effects.Outcome;
use game.hex.Hex;
use game.hex.HexGrid;
use game.terrain.HILLS;
use game.terrain.Terrain;
use game.terrain.Tile;
use game.turn.Phase;
use game.turn.step_rank;
use game.unit.Team;
use game.unit.Unit;
use game.unit.UnitType;

/// Runs `body` with the combat log discarded and a fixed random stream. Every rule a test
/// checks holds whatever the damage rolls, so the seed only makes a failure reproducible.
pub fn sandbox[E](body: affine fn() can {Log, Rand, ..E}) can {..E} {
    let mut g = seed(7);
    handle {
        handle { body(); } with Rand { rand() => { resume g.next() } }
    } with Log {
        enabled(level) => { resume false }
        record(level, text) => { resume }
    }
}

/// The starting layout has exactly one unit of each type per team; -1, which no subscript
/// accepts, when there is none.
pub fn find(game: &GameState, team: Team, unit_type: UnitType) -> i32 {
    let mut i = 0;
    while i < game.units.len() {
        if game.units[i].team == team && game.units[i].unit_type == unit_type { return i; }
        i = i + 1;
    }
    0 - 1
}

/// The index of the unit with `id`, if it is still alive.
fn index_of_id(game: &GameState, id: u32) -> Option[i32] {
    let mut i = 0;
    while i < game.units.len() {
        if game.units[i].id == id { return Option.Some(i); }
        i = i + 1;
    }
    Option.None
}

@test
fn units_cannot_move_through_an_occupied_hex() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let cavalry = find(&game, Team.Blue, UnitType.Cavalry);
        let blocker = find(&game, Team.Red, UnitType.Melee);
        // (2, 0) is 2 steps away, but the only 2-step path runs through (1, 0).
        game.units[cavalry].pos = Hex.new(0, 0);
        game.units[blocker].pos = Hex.new(1, 0);
        game.try_queue_move(cavalry, Hex.new(2, 0));
        assert(game.units[cavalry].planned_move == Option.None);
    });
}

@test
fn units_can_path_around_a_single_blocker() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let cavalry = find(&game, Team.Blue, UnitType.Cavalry);
        let blocker = find(&game, Team.Red, UnitType.Melee);
        // (1, 1) is reachable through either (1, 0) or (0, 1).
        game.units[cavalry].pos = Hex.new(0, 0);
        game.units[blocker].pos = Hex.new(1, 0);
        game.try_queue_move(cavalry, Hex.new(1, 1));
        assert(game.units[cavalry].planned_move == Option.Some(Hex.new(1, 1)));
    });
}

@test
fn cancelling_a_move_clears_an_attack_it_enabled() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let melee = find(&game, Team.Blue, UnitType.Melee);
        let enemy = find(&game, Team.Red, UnitType.Melee);
        // Melee attacks at range 1, so it only reaches (2, 0) after moving to (1, 0).
        game.units[melee].pos = Hex.new(0, 0);
        game.units[enemy].pos = Hex.new(2, 0);
        game.try_queue_move(melee, Hex.new(1, 0));
        game.try_queue_attack(melee, Hex.new(2, 0));
        assert(game.units[melee].planned_attack == Option.Some(Hex.new(2, 0)));
        game.try_queue_move(melee, Hex.new(1, 0));
        assert(game.units[melee].planned_move == Option.None);
        assert(game.units[melee].planned_attack == Option.None);
    });
}

@test
fn siege_can_queue_and_land_a_max_range_attack() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let siege = find(&game, Team.Blue, UnitType.Siege);
        let enemy = find(&game, Team.Red, UnitType.Melee);
        game.units[siege].pos = Hex.new(0, 0);
        game.units[enemy].pos = Hex.new(2, 0);
        assert(UnitType.Siege.stats().attack_range == 2);
        game.try_queue_attack(siege, Hex.new(2, 0));
        assert(game.units[siege].planned_attack == Option.Some(Hex.new(2, 0)));
        let enemy_id = game.units[enemy].id;
        let hp_before = game.units[enemy].hp;
        game.resolve_step(UnitType.Siege, Phase.Attack);
        // The defender either took damage or died and was removed.
        let hp_after = match index_of_id(&game, enemy_id) { Option.Some(i) => game.units[i].hp, Option.None => 0.0 };
        assert(hp_after < hp_before);
    });
}

@test
fn multiple_units_can_target_the_same_hex() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let melee = find(&game, Team.Blue, UnitType.Melee);
        let ranged = find(&game, Team.Blue, UnitType.Ranged);
        game.units[melee].pos = Hex.new(1, 0);
        game.units[ranged].pos = Hex.new(1, -1);
        let target = Hex.new(2, 0);
        game.try_queue_attack(melee, target);
        game.try_queue_attack(ranged, target);
        assert(game.units[melee].planned_attack == Option.Some(target));
        assert(game.units[ranged].planned_attack == Option.Some(target));
    });
}

@test
fn mountains_block_movement_and_pathing() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let cavalry = find(&game, Team.Blue, UnitType.Cavalry);
        let siege = find(&game, Team.Blue, UnitType.Siege);
        game.units[siege].pos = Hex.new(-3, 0);
        // From (-1, -2), both 2-step paths to (1, -3) cross the mountains at (0, -3) and
        // (0, -2), and the mountain itself can't be entered.
        game.units[cavalry].pos = Hex.new(-1, -2);
        assert(game.grid.terrain(Hex.new(0, -2)) == Terrain.Mountains);
        // Pathing goes by what the player knows: the mountains in sight.
        game.explore();
        game.try_queue_move(cavalry, Hex.new(0, -2));
        assert(game.units[cavalry].planned_move == Option.None);
        game.try_queue_move(cavalry, Hex.new(1, -3));
        assert(game.units[cavalry].planned_move == Option.None);
    });
}

/// What a siege unit at the origin deals to a melee defender at `pos`: there is no random spread,
/// so the same fight always deals the same damage.
fn damage_taken_at(grid: &HexGrid, pos: Hex) -> f32 {
    let siege = Unit.new(0, Hex.new(0, 0), Team.Blue, UnitType.Siege);
    let defender = Unit.new(1, pos, Team.Red, UnitType.Melee);
    damage(&siege, &defender, grid.tile(pos).defense_multiplier())
}

@test
fn hills_reduce_damage_taken() {
    let hill = Hex.new(1, 0);
    let plain = Hex.new(-1, 0);
    let grid = HexGrid.new(GRID_RADIUS, &[(hill, HILLS)]);
    assert(damage_taken_at(&grid, hill) < damage_taken_at(&grid, plain));
}

/// Places the two cavalry units and gives them moves, for a same-step test; answers the blue
/// one's index and the red one's.
fn cavalry_moves(game: &mut GameState, blue_from: Hex, blue_to: Hex, red_from: Hex, red_to: Hex) -> (i32, i32) {
    let blue = find(&*game, Team.Blue, UnitType.Cavalry);
    let red = find(&*game, Team.Red, UnitType.Cavalry);
    game.units[blue].pos = blue_from;
    game.units[blue].planned_move = Option.Some(blue_to);
    game.units[red].pos = red_from;
    game.units[red].planned_move = Option.Some(red_to);
    (blue, red)
}

@test
fn enemies_moving_onto_the_same_hex_contest_it_and_fight() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let center = Hex.new(0, 0);
        let (blue, red) = cavalry_moves(&mut game, Hex.new(-1, 0), center, Hex.new(1, 0), center);
        game.resolve_step(UnitType.Cavalry, Phase.Move);
        assert(game.units[blue].pos == center);
        assert(game.units[red].pos == center);
        assert(game.is_contested(center));
        // Locked in: it can't be ordered to attack elsewhere...
        game.try_queue_attack(blue, Hex.new(-1, 1));
        assert(game.units[blue].planned_attack == Option.None);
        // ...but fights its rival in its attack step without any orders.
        game.resolve_step(UnitType.Cavalry, Phase.Attack);
        let mut i = 0;
        while i < game.units.len() {
            let u = &game.units[i];
            assert(u.unit_type != UnitType.Cavalry || u.hp < u.max_hp());
            i = i + 1;
        }
    });
}

@test
fn a_unit_can_withdraw_from_a_contested_hex() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let center = Hex.new(0, 0);
        let (blue, red) = cavalry_moves(&mut game, Hex.new(-1, 0), center, Hex.new(1, 0), center);
        game.resolve_step(UnitType.Cavalry, Phase.Move);
        game.try_queue_move(blue, Hex.new(-1, 0));
        game.resolve_step(UnitType.Cavalry, Phase.Move);
        assert(game.units[blue].pos == Hex.new(-1, 0));
        assert(game.units[red].pos == center);
        assert(!game.is_contested(center));
    });
}

@test
fn allies_swap_places_when_the_first_of_them_moves() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        // Adjacent in the starting layout; melee moves well before ranged.
        let melee = find(&game, Team.Blue, UnitType.Melee);
        let ranged = find(&game, Team.Blue, UnitType.Ranged);
        let melee_start = game.units[melee].pos;
        let ranged_start = game.units[ranged].pos;
        // Queuing the same swap twice cancels it; a third time requeues it.
        game.try_queue_swap(melee, ranged);
        game.try_queue_swap(melee, ranged);
        assert(game.swap_partner(melee) == Option.None);
        game.try_queue_swap(melee, ranged);
        assert(game.swap_partner(melee) == Option.Some(ranged));
        game.resolve_step(UnitType.Melee, Phase.Move);
        assert(game.units[melee].pos == ranged_start);
        assert(game.units[ranged].pos == melee_start);
        assert(game.resolve_step(UnitType.Ranged, Phase.Move).is_empty());
    });
}

@test
fn allies_cannot_head_for_the_same_hex() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let melee = find(&game, Team.Blue, UnitType.Melee);
        let cavalry = find(&game, Team.Blue, UnitType.Cavalry);
        let dest = Hex.new(-1, 0);
        game.try_queue_move(melee, dest);
        game.try_queue_move(cavalry, dest);
        assert(game.units[melee].planned_move == Option.Some(dest));
        assert(game.units[cavalry].planned_move == Option.None);
    });
}

@test
fn a_unit_can_move_into_a_hex_vacated_in_the_same_step() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        // Blue has the lower id, so under one-at-a-time resolution it would have been
        // blocked by Red, which hadn't moved yet.
        let (blue, red) = cavalry_moves(&mut game, Hex.new(-1, 0), Hex.new(0, 0), Hex.new(0, 0), Hex.new(1, -1));
        assert(game.units[blue].id < game.units[red].id);
        game.resolve_step(UnitType.Cavalry, Phase.Move);
        assert(game.units[blue].pos == Hex.new(0, 0));
        assert(game.units[red].pos == Hex.new(1, -1));
    });
}

@test
fn enemies_cannot_swap_places() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let (blue, red) = cavalry_moves(&mut game, Hex.new(-1, 0), Hex.new(0, 0), Hex.new(0, 0), Hex.new(-1, 0));
        game.resolve_step(UnitType.Cavalry, Phase.Move);
        assert(game.units[blue].pos == Hex.new(-1, 0));
        assert(game.units[red].pos == Hex.new(0, 0));
    });
}

@test
fn simultaneous_attacks_all_land_before_anyone_is_removed() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let blue = find(&game, Team.Blue, UnitType.Melee);
        let red = find(&game, Team.Red, UnitType.Melee);
        game.units[blue].pos = Hex.new(-1, 0);
        game.units[blue].planned_attack = Option.Some(Hex.new(0, 0));
        game.units[blue].hp = 1.0;
        game.units[red].pos = Hex.new(0, 0);
        game.units[red].planned_attack = Option.Some(Hex.new(-1, 0));
        game.units[red].hp = 1.0;
        // Either blow alone is lethal; both units still get theirs in.
        game.resolve_step(UnitType.Melee, Phase.Attack);
        let mut i = 0;
        while i < game.units.len() {
            assert(game.units[i].unit_type != UnitType.Melee);
            i = i + 1;
        }
    });
}

@test
fn order_badges_follow_the_resolution_order() {
    assert(step_rank(UnitType.Scout, Phase.Move) == 1);
    assert(step_rank(UnitType.Cavalry, Phase.Move) == 2);
    assert(step_rank(UnitType.Siege, Phase.Move) == 7);
    assert(step_rank(UnitType.Ranged, Phase.Attack) == 1);
    assert(step_rank(UnitType.Scout, Phase.Attack) == 2);
    assert(step_rank(UnitType.Siege, Phase.Attack) == 7);
    assert(step_rank(UnitType.Wolf, Phase.Move) == 3);
    assert(step_rank(UnitType.Bear, Phase.Attack) == 6);
}

/// Every unit type has a rank in both phases, so a badge never reads 0.
@test
fn every_step_has_a_rank() {
    for p in 0..2 {
        let phase = if p == 0 { Phase.Move } else { Phase.Attack };
        assert(step_rank(UnitType.Melee, phase) > 0);
        assert(step_rank(UnitType.Ranged, phase) > 0);
        assert(step_rank(UnitType.Cavalry, phase) > 0);
        assert(step_rank(UnitType.Siege, phase) > 0);
        assert(step_rank(UnitType.Scout, phase) > 0);
        assert(step_rank(UnitType.Armored, phase) > 0);
        assert(step_rank(UnitType.PatrolGalley, phase) > 0);
        assert(step_rank(UnitType.LandingCraft, phase) > 0);
        assert(step_rank(UnitType.BombardShip, phase) > 0);
    }
}

/// Selects `idx` and toggles its ability, as the button would.
fn toggle_ability(game: &mut GameState, idx: i32) can {Log} {
    game.selected = Option.Some(idx);
    game.toggle_selected_ability();
}

@test
fn shield_wall_raises_defense_and_cancels_movement() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let melee = find(&game, Team.Blue, UnitType.Melee);
        game.try_queue_move(melee, Hex.new(-1, 0));
        toggle_ability(&mut game, melee);
        assert(game.units[melee].planned_move == Option.None);
        assert(game.units[melee].stats().defense == UnitType.Melee.stats().defense * 1.5);
        game.try_queue_move(melee, Hex.new(-1, 0));
        assert(game.units[melee].planned_move == Option.None);
    });
}

@test
fn charge_extends_movement_until_it_is_turned_off() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let cavalry = find(&game, Team.Blue, UnitType.Cavalry);
        // 3 steps away through the pass: out of reach without the charge bonus.
        let far = Hex.new(1, -1);
        toggle_ability(&mut game, cavalry);
        game.try_queue_move(cavalry, far);
        assert(game.units[cavalry].planned_move == Option.Some(far));
        toggle_ability(&mut game, cavalry);
        assert(game.units[cavalry].planned_move == Option.None);
    });
}

@test
fn volley_also_hits_enemies_next_to_the_target() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let ranged = find(&game, Team.Blue, UnitType.Ranged);
        let target = find(&game, Team.Red, UnitType.Melee);
        let neighbor = find(&game, Team.Red, UnitType.Cavalry);
        game.units[ranged].pos = Hex.new(-1, 0);
        game.units[target].pos = Hex.new(1, 0);
        game.units[neighbor].pos = Hex.new(1, 1);
        let ids = [game.units[target].id, game.units[neighbor].id];
        toggle_ability(&mut game, ranged);
        game.try_queue_attack(ranged, Hex.new(1, 0));
        game.resolve_step(UnitType.Ranged, Phase.Attack);
        for k in 0..2 {
            // A unit the volley killed is gone, which is hit enough.
            if let Option.Some(i) = index_of_id(&game, ids[k]) {
                assert(game.units[i].hp < game.units[i].max_hp());
            }
        }
    });
}

@test
fn siege_spends_a_turn_deploying_then_gains_range() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let siege = find(&game, Team.Blue, UnitType.Siege);
        toggle_ability(&mut game, siege);
        assert(!game.units[siege].can_attack());
        game.units[siege].end_turn();
        let unit = &game.units[siege];
        assert(unit.deployed && unit.can_attack());
        assert(unit.stats().attack_range == UnitType.Siege.stats().attack_range + 1);
        assert(unit.stats().move_range == 0);
    });
}

@test
fn abilities_go_on_cooldown_after_use() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let ranged = find(&game, Team.Blue, UnitType.Ranged);
        toggle_ability(&mut game, ranged);
        game.units[ranged].end_turn();
        assert(game.units[ranged].ability_cooldown == 2);
        // It can't be queued while cooling down.
        toggle_ability(&mut game, ranged);
        assert(!game.units[ranged].ability_queued);
        game.units[ranged].end_turn();
        game.units[ranged].end_turn();
        toggle_ability(&mut game, ranged);
        assert(game.units[ranged].ability_queued);
    });
}

@test
fn moving_and_attacking_selects_the_next_unit() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let melee = find(&game, Team.Blue, UnitType.Melee);
        let ranged = find(&game, Team.Blue, UnitType.Ranged);
        // The first unit starts selected.
        assert(game.selected == Option.Some(melee));
        // With no enemy nearby it stays selected after moving, so it can still attack a
        // square...
        game.try_queue_move(melee, Hex.new(-1, 0));
        game.advance_selection_if_done();
        assert(game.selected == Option.Some(melee));
        // ...and moves on once it does.
        game.try_queue_attack(melee, Hex.new(0, 0));
        game.advance_selection_if_done();
        assert(game.selected == Option.Some(ranged));
    });
}

@test
fn skipping_selects_the_next_unit_and_focuses_the_camera() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let ranged = find(&game, Team.Blue, UnitType.Ranged);
        game.select_next_unit();
        assert(game.selected == Option.Some(ranged));
        game.update(10.0);
        let want = game.units[ranged].pos.to_world();
        assert(game.camera.center.x == want.x && game.camera.center.y == want.y);
    });
}

@test
fn holding_keeps_orders_and_moves_on() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let melee = find(&game, Team.Blue, UnitType.Melee);
        let ranged = find(&game, Team.Blue, UnitType.Ranged);
        game.try_queue_move(melee, Hex.new(-1, 0));
        game.hold_selected_unit();
        assert(game.selected == Option.Some(ranged));
        assert(game.units[melee].planned_move == Option.Some(Hex.new(-1, 0)));
        assert(!game.is_resolving());
    });
}

/// A neighbour of `hex` a unit could move to.
pub fn open_neighbor(game: &GameState, hex: Hex) -> Option[Hex] {
    let around = hex.neighbors();
    for k in 0..6 {
        let h = around[k];
        if game.grid.is_passable(h) && !game.is_occupied(h) { return Option.Some(h); }
    }
    Option.None
}

/// Whether `queue` holds an item of `build`, paid or not.
pub fn queued_has(queue: &Vec[Queued[Build]], build: Build) -> bool {
    for k in 0..queue.len() { if queue[k].build == build { return true; } }
    false
}

/// Whether the item at `index` of `queue` is `build`.
pub fn queued_is(queue: &Vec[Queued[Build]], index: i32, build: Build) -> bool {
    index < queue.len() && queue[index].build == build
}

/// Whether no unit needs orders and no city needs a build.
/// `pending() == (0, 0)` has no `Eq` to call: a tuple has no `impl Eq`.
pub fn nothing_pending(game: &GameState) -> bool {
    let (units, cities) = game.pending();
    units == 0 && cities == 0
}

fn blue_count(game: &GameState) -> i32 {
    let mut n = 0;
    for i in 0..game.units.len() {
        if game.units[i].team == Team.Blue { n = n + 1; }
    }
    n
}

@test
fn turn_waits_for_explicit_end_after_every_unit_has_acted() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        for _ in 1..blue_count(&game) { game.hold_selected_unit(); }
        // One unit is still to act.
        assert(!game.is_resolving());
        // The last unit finishes by queuing orders rather than holding.
        let Option.Some(last) = game.selected else { assert_fail("the last unit is selected"); return; };
        let from = game.units[last].pos;
        let Option.Some(to) = open_neighbor(&game, from) else { assert_fail("the last unit has room to move"); return; };
        game.try_queue_move(last, to);
        game.try_queue_attack(last, from);
        game.advance_selection_if_done();
        assert(!game.is_resolving());
        game.end_planning();
        assert(game.is_resolving());
        // Playing the turn out starts the next one with the first unit selected.
        while game.is_resolving() { game.update(1.0); }
        for i in 0..game.units.len() { assert(!game.units[i].holding); }
        assert(game.selected.is_some());
    });
}

@test
fn space_holds_each_unit_then_ends_the_turn() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        for _ in 0..blue_count(&game) { game.hold_or_end_turn(); }
        // Holding the last unit doesn't end the turn.
        assert(!game.is_resolving());
        assert(nothing_pending(&game));
        game.hold_or_end_turn();
        assert(game.is_resolving());
    });
}

@test
fn guarding_lasts_across_turns_until_an_order() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let melee = find(&game, Team.Blue, UnitType.Melee);
        assert(game.selected == Option.Some(melee));
        game.toggle_guard();
        // Guarding moves on.
        assert(game.selected != Option.Some(melee));

        while !nothing_pending(&game) { game.hold_or_end_turn(); }
        game.hold_or_end_turn();
        while game.is_resolving() { game.update(1.0); }
        let melee = find(&game, Team.Blue, UnitType.Melee);
        // Still guarding next turn.
        assert(game.units[melee].guarding);
        assert(!game.needs_orders(melee));

        // Giving it an order wakes it.
        game.selected = Option.Some(melee);
        let Option.Some(open) = open_neighbor(&game, game.units[melee].pos) else { assert_fail("the melee unit has room to move"); return; };
        game.try_queue_move(melee, open);
        assert(!game.units[melee].guarding);
    });
}

@test
fn turn_waits_for_city_builds_but_not_citizens() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.city_scenario();
        handle { game.units.retain(); } with Keep[Unit] { keep(u) => { resume u.team != Team.Blue } }
        game.selected = Option.None;
        // A city with nothing to build; its worker idle at home doesn't hold the turn up.
        let (units, cities) = game.pending();
        assert(units == 0 && cities == 1);

        // Space opens the city that needs a build instead of ending the turn.
        game.hold_or_end_turn();
        assert(!game.is_resolving());
        assert(game.selected_city == Option.Some(0));

        game.queue_selected_city_unit(BuildUnit.Melee);
        let (units, cities) = game.pending();
        assert(units == 0 && cities == 0);
        // Space closes the city, and then ends the turn.
        game.hold_or_end_turn();
        game.hold_or_end_turn();
        assert(game.is_resolving());
    });
}

@test
fn a_queued_attack_draws_an_arc() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let ranged = find(&game, Team.Blue, UnitType.Ranged);
        let before = game.build_vertices().len();
        game.try_queue_attack(ranged, Hex.new(0, 1));
        assert(game.units[ranged].planned_attack.is_some());
        assert(game.build_vertices().len() > before);

        // The AI's attacks aren't drawn.
        let with_ours = game.build_vertices().len();
        let enemy = find(&game, Team.Red, UnitType.Ranged);
        game.units[enemy].planned_attack = Option.Some(Hex.new(0, 1));
        assert(game.build_vertices().len() == with_ours);
    });
}

@test
fn a_resolved_attack_animates_and_clears_its_arrow() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        let ranged = find(&game, Team.Blue, UnitType.Ranged);
        // An empty hex: the shot plays out as a miss.
        game.try_queue_attack(ranged, Hex.new(0, 1));
        game.resolve_step(UnitType.Ranged, Phase.Attack);
        assert(game.units[ranged].planned_attack == Option.None);
        assert(game.effects.len() == 1);
        let missed = match game.effects[0].animation { Effect.Shot(_, _, Outcome.Miss) => true, _ => false };
        assert(missed);
    });
}

@test
fn effects_play_out_and_are_dropped() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut game = GameState.new();
        game.play(Effect.Damage(vec2(0.0, 0.0), 20.0, false));
        let mut quiet: Vec[MeshVertex] = Vec.new();
        game.push_effects(&mut quiet);
        // The number shows once the shot lands, 0.3 seconds in.
        game.age_effects(0.4);
        let mut shown: Vec[MeshVertex] = Vec.new();
        game.push_effects(&mut shown);
        assert(shown.len() > quiet.len());
        game.age_effects(10.0);
        assert(game.effects.is_empty());
    });
}

/// A landing craft at `ship` and Blue melee troops at `troops`, each told to board it.
fn board(game: &mut GameState, ship: u32, troops: &[(u32, Hex)]) {
    for k in 0..troops.len() {
        let (id, pos) = troops[k];
        let mut troop = Unit.new(id, pos, Team.Blue, UnitType.Melee);
        troop.planned_board = Option.Some(ship);
        game.units.push(troop);
    }
}

@test
fn landing_craft_carries_four_troops_and_lands_one_on_open_shore() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.new();
        // Water west of the origin, land beyond it.
        g.grid = HexGrid.new(4, &[(Hex.new(-1, 0), Tile.of(Terrain.Coast)), (Hex.new(-1, 2), Tile.of(Terrain.Coast))]);
        g.units.clear();
        let ship = 90;
        g.units.push(Unit.new(ship, Hex.new(-1, 0), Team.Blue, UnitType.LandingCraft));
        board(&mut g, ship, &[(91, Hex.new(-2, 0)), (92, Hex.new(-2, 1))]);
        g.resolve_transport();
        assert(g.units[0].cargo.len() == 2);
        g.units[0].pos = Hex.new(-1, 2);
        board(&mut g, ship, &[(93, Hex.new(-2, 2)), (94, Hex.new(-2, 3))]);
        g.resolve_transport();
        assert(g.units.len() == 1);
        assert(g.units[0].cargo.len() == 4);
        // Full: a fifth stays ashore.
        g.units[0].pos = Hex.new(-1, 0);
        board(&mut g, ship, &[(95, Hex.new(-2, 0))]);
        g.resolve_transport();
        assert(g.units[0].cargo.len() == 4);
        assert(g.units.len() == 2);
        // The first aboard lands first.
        g.units[0].planned_unload = Option.Some(Hex.new(-2, 1));
        g.resolve_transport();
        assert(g.units[0].cargo.len() == 3);
        assert(g.units[2].id == 92);
        assert(g.units[2].pos == Hex.new(-2, 1));
    });
}

@test
fn harbor_produces_a_ship_on_water_and_it_cannot_walk_ashore() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.naval_scenario();
        g.cities[0].queue[0].progress = BuildUnit.PatrolGalley.work();
        let before = g.units.len();
        g.complete_builds();
        assert(g.units.len() == before + 1);
        // The ship plans on what the player knows: the coast in sight.
        g.explore();
        let ship = g.units.len() - 1;
        assert(g.units[ship].unit_type == UnitType.PatrolGalley);
        assert(g.grid.terrain(g.units[ship].pos).is_water());
        let fog = g.fog();
        let reachable = g.known_reachable_for_domain(g.units[ship].pos, 3, Team.Blue, &fog, true);
        assert(!reachable.is_empty());
        let mut all_water = true;
        for h in reachable.each() { if !g.grid.terrain(*h).is_water() { all_water = false; } }
        assert(all_water);
        assert(g.cities[0].queue.is_empty());
    });
}

@test
fn coastal_battery_hits_ships_and_can_be_destroyed() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.naval_scenario();
        g.units.clear();
        g.units.push(Unit.new(300, Hex.new(-1, 0), Team.Red, UnitType.PatrolGalley));
        let initial = g.units[0].hp;
        g.resolve_coastal_batteries();
        assert(g.units[0].hp < initial);
        g.units.clear();
        let Option.Some(site) = g.cities[1].placed_site(Building.CoastalBattery) else { assert(false); return; };
        let mut ship = Unit.new(301, Hex.new(1, 0), Team.Blue, UnitType.BombardShip);
        ship.planned_attack = Option.Some(site);
        g.units.push(ship);
        g.cities[1].coastal_battery_hp = 1.0;
        let _acted = g.resolve_step(UnitType.BombardShip, Phase.Attack);
        assert(g.cities[1].placed_site(Building.CoastalBattery).is_none());
    });
}

/// The damage numbers playing: how many, and whether the last one is fatal.
fn damage_numbers(g: &GameState) -> (i32, bool, Vec2) {
    let mut n = 0;
    let mut fatal = false;
    let mut at = vec2(0.0, 0.0);
    for k in 0..g.effects.len() {
        if let Effect.Damage(where_, _, was_fatal) = g.effects[k].animation {
            n = n + 1;
            fatal = was_fatal;
            at = where_;
        }
    }
    (n, fatal, at)
}

/// A battery's hits on ships, and hits on a battery, play a damage number as an attack's target
/// does, KILLED (fatal) when it sinks or is destroyed.
@test
fn coastal_battery_hits_show_damage_numbers_both_ways() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut g = GameState.naval_scenario();
        g.fog_of_war = false;
        g.units.clear();
        g.effects.clear();
        let ship_at = Hex.new(-1, 0);
        g.units.push(Unit.new(300, ship_at, Team.Red, UnitType.PatrolGalley));
        g.resolve_coastal_batteries();
        let (n, fatal, at) = damage_numbers(&g);
        assert(n == 1 && !fatal && at.x == ship_at.to_world().x && at.y == ship_at.to_world().y);

        // A ship with less left than the hit shows KILLED.
        g.effects.clear();
        g.units.clear();
        let mut weak = Unit.new(302, ship_at, Team.Red, UnitType.PatrolGalley);
        weak.hp = 1.0;
        g.units.push(weak);
        g.resolve_coastal_batteries();
        assert(g.units.is_empty());
        let (n, fatal, _) = damage_numbers(&g);
        assert(n == 1 && fatal);

        // A hit on a battery shows at its site; the last one is fatal.
        g.effects.clear();
        let Option.Some(site) = g.cities[1].placed_site(Building.CoastalBattery) else { assert(false); return; };
        let mut ship = Unit.new(301, Hex.new(1, 0), Team.Blue, UnitType.BombardShip);
        ship.planned_attack = Option.Some(site);
        g.units.push(ship);
        let _acted = g.resolve_step(UnitType.BombardShip, Phase.Attack);
        let (n, fatal, at) = damage_numbers(&g);
        assert(n == 1 && !fatal && at.x == site.to_world().x);
        g.effects.clear();
        g.cities[1].coastal_battery_hp = 1.0;
        g.units[0].planned_attack = Option.Some(site);
        let _acted = g.resolve_step(UnitType.BombardShip, Phase.Attack);
        let (n, fatal, _) = damage_numbers(&g);
        assert(n == 1 && fatal);
    });
}
