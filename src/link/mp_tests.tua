//! Multiplayer's rules across the whole path (game, plan wire, lockstep, hub and peers): taking
//! a turn back, looking around while the others' plans are awaited, seats that fill and empty,
//! desyncs and refusals. Every message crosses as the bytes the sequencer really sends
//! (`table.tua`).

use std.rand.Rand;
use std.rand.seed;
use std.str.Str;
use std.str.to_owned;
use game.settings.default_settings;
use std.str.contains;
use std.str.eq as str_eq;
use std.test.assert;
use std.test.assert_eq;
use std.test.Assert;
use log.Log;
use game.GameState;
use game.city.Build;
use game.city.Building;
use game.plan.TeamPlan;
use game.plan.plan_bytes;
use game.city.BuildUnit;
use game.city.Priorities;
use game.city.Good;
use game.city.Stock;
use game.hex.Hex;
use game.city.interior.in_bounds;
use game.hex.HexGrid;
use game.terrain.Tile;
use game.unit.IdSet;
use game.unit.Unit;
use game.unit.UnitType;
use std.collections.Map;
use game.workers.JobKind;
use game.multiplayer.HOST_SEAT;
use game.orders.ClickMode;
use game.tests.sandbox;
use game.unit.Team;
use link.table.Lobby;
use link.table.lobby;
use link.table.table;
use std.linalg.Vec2;
use std.linalg.vec2;

const GUEST_SEAT: Team = Team.Red;

fn play_out(game: &mut GameState) can {Log, Rand} {
    while game.is_playing_out() { game.update(1.0); }
}

fn city_of(game: &GameState, team: Team) -> i32 {
    for i in 0..game.cities.len() { if game.cities[i].team == team { return i; } }
    0 - 1
}

fn unit_of(game: &GameState, team: Team) -> i32 {
    for i in 0..game.units.len() { if game.units[i].team == team { return i; } }
    0 - 1
}

/// Ends `game`'s turn with \`build\` queued in its first city (a gather when it is \`None\`).
fn end_turn_building(game: &mut GameState, build: Option[BuildUnit]) can {Log} {
    let city = city_of(&*game, game.local_team);
    game.open_city(city);
    match build {
        Option.Some(unit) => { game.queue_selected_city_unit(unit); }
        Option.None => { game.queue_selected_city_gather(); }
    }
    game.end_planning();
}

/// How many of \`unit\` \`team\`'s cities have queued.
fn units_queued(game: &GameState, team: Team, unit: BuildUnit) -> i32 {
    let mut n = 0;
    for c in 0..game.cities.len() {
        if game.cities[c].team != team { continue; }
        for k in 0..game.cities[c].queue.len() {
            if game.cities[c].queue[k].build == Build.Unit(unit) { n = n + 1; }
        }
    }
    n
}

fn notice_is(g: &GameState, want: &str) -> bool { let n = &g.notice; str_eq(n, want) }

/// The seat \`team\` has a plan in for this turn at the host.
fn host_has_plan(t: &Lobby, team: Team) -> bool { t.host.has_plan_from(team) }

@test
fn a_guest_takes_back_its_turn_and_its_new_orders_play_out_everywhere() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut t = lobby(2, 2, 4242);
        // Red ends its turn, gathering.
        end_turn_building(&mut t.games[0], Option.None);
        t.exchange();
        // It takes the turn back: the host lets go of its plan and waits.
        t.games[0].take_back_turn();
        assert(!t.games[0].waiting_for_peers() && !t.games[0].is_resolving());
        t.exchange();
        // Its player queues a Melee too and ends the turn again.
        end_turn_building(&mut t.games[0], Option.Some(BuildUnit.Melee));
        t.exchange();
        // Green and the host end theirs, and the turn plays out with Red's new orders on every
        // machine.
        t.games[1].submit_plan();
        t.host.submit_plan();
        t.exchange();
        play_out(&mut t.host);
        play_out(&mut t.games[0]);
        play_out(&mut t.games[1]);
        t.exchange();
        assert(t.host.turn == 1 && t.games[0].turn == 1 && t.games[1].turn == 1);
        assert(t.games[0].checksum() == t.host.checksum() && t.games[1].checksum() == t.host.checksum());
        assert(units_queued(&t.host, Team.Red, BuildUnit.Melee) == 1);
        assert(units_queued(&t.games[1], Team.Red, BuildUnit.Melee) == 1);
        assert(t.host.lockstep.desync.is_none());
    });
}

@test
fn the_host_takes_back_its_own_turn() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut t = table(1);
        end_turn_building(&mut t.host, Option.None);
        t.host.take_back_turn();
        assert(!t.host.waiting_for_peers());
        // The guest's plan alone doesn't resolve the turn now.
        end_turn_building(&mut t.games[0], Option.None);
        t.exchange();
        assert(!t.host.is_playing_out());
        end_turn_building(&mut t.host, Option.Some(BuildUnit.Melee));
        t.exchange();
        play_out(&mut t.host);
        play_out(&mut t.games[0]);
        t.exchange();
        assert(t.host.turn == 1);
        assert(t.host.checksum() == t.games[0].checksum());
        assert(units_queued(&t.games[0], HOST_SEAT, BuildUnit.Melee) == 1);
    });
}

@test
fn end_turn_closes_the_city_and_barracks_views_as_in_a_local_game() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut t = table(1);
        let team = GUEST_SEAT;
        let city = city_of(&t.games[0], team);
        let city_pos = t.games[0].cities[city].pos;
        // A Barracks by its city, on no tile a citizen works, on both machines.
        let around = city_pos.neighbors();
        let mut barracks = city_pos;
        for k in 0..6 {
            if barracks == city_pos && t.games[0].grid.is_passable(around[k]) && !t.games[0].is_occupied(around[k]) && !t.games[0].cities[city].works(around[k]) { barracks = around[k]; }
        }
        t.games[0].cities[city].barracks = Option.Some(barracks);
        // The city view.
        end_turn_building(&mut t.games[0], Option.None);
        assert(t.games[0].waiting_for_peers());
        assert(t.games[0].selected_city.is_none());
        // Taken back, the Barracks view.
        t.games[0].take_back_turn();
        t.games[0].open_barracks(city);
        assert(t.games[0].selected_barracks == Option.Some(city));
        t.games[0].end_planning();
        assert(t.games[0].waiting_for_peers());
        assert(t.games[0].selected_barracks.is_none());
        // Taken back, a unit selected.
        t.games[0].take_back_turn();
        let unit = unit_of(&t.games[0], team);
        let mut one: Vec[i32] = Vec.new();
        one.push(unit);
        t.games[0].set_selection(one);
        t.games[0].end_planning();
        assert(t.games[0].waiting_for_peers());
        assert(t.games[0].selection().is_empty());
        // Waiting, the player may look again, and the turn plays out alike.
        let plan = t.games[0].team_plan(team);
        t.games[0].open_city(city);
        assert(t.games[0].selected_city == Option.Some(city));
        let looked = t.games[0].team_plan(team);
        assert(plans_equal(&plan, &looked));
        t.exchange();
        t.host.submit_plan();
        t.exchange();
        play_out(&mut t.host);
        play_out(&mut t.games[0]);
        t.exchange();
        assert(t.host.turn == t.games[0].turn);
        assert(t.host.checksum() == t.games[0].checksum());
        assert(t.host.lockstep.desync.is_none());
    });
}

fn bytes_of(p: &TeamPlan) -> Vec[u8] {
    match plan_bytes(p) { Option.Some(b) => b, Option.None => Vec.new() }
}

fn plans_equal(a: &TeamPlan, b: &TeamPlan) -> bool {
    let p = bytes_of(a);
    let q = bytes_of(b);
    if p.len() != q.len() { return false; }
    for i in 0..p.len() { if p[i] != q[i] { return false; } }
    true
}

fn checked(r: Result[(), Str]) -> bool { match r { Result.Ok(u) => true, Result.Err(w) => false } }

fn applied(r: Result[bool, Str]) -> bool { match r { Result.Ok(b) => true, Result.Err(w) => false } }

/// Red ends its turn, takes it back and ends it again with a Melee queued, all before the host
/// has heard of the first: the host's own plan makes it close the turn with the first, and the
/// later messages come too late to change it and are not hostile. Red plays out what the host
/// closed and says so.
@test
fn a_take_back_after_the_host_resolved_changes_nothing() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut t = table(1);
        end_turn_building(&mut t.host, Option.None);
        end_turn_building(&mut t.games[0], Option.None);
        // Both plans are in before anything is delivered: the guest's messages are still on the
        // way when it takes the turn back and sends another.
        t.games[0].take_back_turn();
        end_turn_building(&mut t.games[0], Option.Some(BuildUnit.Melee));
        t.exchange();
        assert(t.host.is_playing_out() && t.games[0].is_playing_out());
        // Red is told its later orders came too late.
        assert(notice_is(&t.games[0], "TOO LATE TO CHANGE - THE TURN PLAYS OUT AS SENT"));
        play_out(&mut t.host);
        play_out(&mut t.games[0]);
        t.exchange();
        assert(t.host.turn == 1 && t.games[0].turn == 1);
        assert(t.host.checksum() == t.games[0].checksum());
        assert(t.host.lockstep.desync.is_none());
        // Both machines played the plan the host closed the turn with: no Melee.
        assert(units_queued(&t.host, GUEST_SEAT, BuildUnit.Melee) == 0);
        assert(units_queued(&t.games[0], GUEST_SEAT, BuildUnit.Melee) == 0);
        // Nothing of the later plan reaches the next turn: the host is still waiting for Red.
        assert(!t.host.is_resolving() || t.host.turn == 1);
    });
}

/// A bundle that lacks this side's own orders, or holds another's that this side never sent, is
/// refused whole: nothing changes and the host is no longer trusted.
@test
fn a_guest_refuses_a_turn_with_orders_it_never_sent() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut t = table(1);
        end_turn_building(&mut t.games[0], Option.None);
        let sent = t.games[0].team_plan(GUEST_SEAT);
        let own = t.host.team_plan(HOST_SEAT);
        // Its orders changed on the way, though they'd pass the checks.
        let mut changed = t.games[0].team_plan(GUEST_SEAT);
        changed.units[0].holding = !changed.units[0].holding;
        assert(checked(t.host.check_plan(&changed)));
        let before = t.games[0].checksum();
        let mut plans: Vec[Vec[u8]] = Vec.new();
        plans.push(bytes_of(&own));
        plans.push(bytes_of(&changed));
        t.games[0].receive_bundle(0, plans);
        let refused = t.games[0].apply_waiting_bundle();
        let why = match refused { Result.Err(w) => w, Result.Ok(b) => to_owned("") };
        assert(contains(&why, "NEVER SENT"));
        assert(t.games[0].checksum() == before);
        assert(t.games[0].waiting_for_peers());
        // Its own go through.
        let mut good: Vec[Vec[u8]] = Vec.new();
        good.push(bytes_of(&own));
        good.push(bytes_of(&sent));
        t.games[0].receive_bundle(0, good);
        assert(applied(t.games[0].apply_waiting_bundle()));
        assert(t.games[0].is_playing_out());
    });
}

@test
fn a_disbanded_unit_is_gone_on_both_machines() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut t = table(1);
        let unit = unit_of(&t.games[0], GUEST_SEAT);
        let id = t.games[0].units[unit].id;
        t.games[0].selected = Option.Some(unit);
        t.games[0].disband_selected();
        let again = unit_index(&t.games[0], id);
        t.games[0].selected = Option.Some(again);
        t.games[0].disband_selected();
        assert(unit_index(&t.games[0], id) < 0);
        t.games[0].submit_plan();
        t.host.submit_plan();
        t.exchange();
        play_out(&mut t.host);
        play_out(&mut t.games[0]);
        t.exchange();
        assert(unit_index(&t.host, id) < 0);
        assert(t.host.checksum() == t.games[0].checksum());
    });
}

fn unit_index(game: &GameState, id: u32) -> i32 {
    for i in 0..game.units.len() { if game.units[i].id == id { return i; } }
    0 - 1
}

@test
fn a_mismatched_checksum_is_reported_as_a_desync() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut t = table(1);
        t.games[0].submit_plan();
        t.host.submit_plan();
        t.exchange();
        play_out(&mut t.host);
        // The guest's game drifts before it resolves.
        t.games[0].stockpiles[GUEST_SEAT.index()] = Stock.whole(1, 2, 3);
        play_out(&mut t.games[0]);
        t.exchange();
        assert(t.host.lockstep.desync == Option.Some(0));
        assert(notice_is(&t.host, "DESYNC WITH RED AFTER TURN 1"));
    });
}

fn play_turn(t: &mut Lobby) can {Log, Rand} {
    t.host.submit_plan();
    for i in 0..t.games.len() { t.games[i].submit_plan(); }
    t.exchange();
    play_out(&mut t.host);
    for i in 0..t.games.len() { play_out(&mut t.games[i]); }
    t.exchange();
}

@test
fn three_players_share_a_world_with_the_ai_on_the_rest() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut t = lobby(2, 4, 4242);
        assert(t.games[0].local_team == Team.Red && t.games[1].local_team == Team.Green);
        assert(t.host.humans.len() == 3);
        assert(!t.host.ai_teams().is_empty());
        assert(t.host.ai_teams().len() == t.games[0].ai_teams().len());
        // A fourth is turned away: the seats are full.
        assert(t.connect() == 0 - 1);
        assert(t.games[0].checksum() == t.host.checksum() && t.games[1].checksum() == t.host.checksum());
        for _ in 0..3 {
            play_turn(&mut t);
            assert(t.games[0].checksum() == t.host.checksum());
            assert(t.games[1].checksum() == t.host.checksum());
        }
        assert(t.host.turn == 3);
        assert(t.host.lockstep.desync.is_none());
        // Nobody joins a game under way.
        assert(t.host.has_started());
    });
}

/// With a seat open the first turn does not resolve: the host's End Turn says how many are to
/// come. A guest who leaves before the start frees their seat, and the seats still take a person.
@test
fn the_host_waits_for_every_seat_before_the_first_turn() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut t = lobby(1, 3, 4242);
        // Green's seat is open.
        assert(t.host.humans.len() == 2);
        let mut settings = default_settings();
        settings.world_ai = 3;
        let mut host3 = GameState.host_game(3, &settings, 99, to_owned("K7M2QX"));
        let seat = host3.seat_next_guest();
        assert(seat == Option.Some(Team.Red));
        assert(host3.open_seats().len() == 1 && host3.open_seats()[0] == Team.Green);
        host3.submit_plan();
        assert(!host3.waiting_for_peers());
        let label = host3.resolving_label();
        assert(contains(&label, "JOIN CODE K7M2QX - 1 TO COME"));
        // A guest who leaves before the start frees their seat.
        host3.seat_left(Team.Red);
        assert(host3.open_seats().len() == 2);
        assert(host3.humans.len() == 3);
    });
}

/// Green's player goes while Red and the host wait on the turn: the sequencer closes it without
/// Green, on both machines left, and the AI plays Green from then on.
@test
fn a_guest_who_leaves_mid_game_hands_their_side_to_the_ai() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut t = lobby(2, 4, 4242);
        play_turn(&mut t);
        // Green's player goes; Red is waiting on the turn.
        t.games[0].submit_plan();
        t.host.submit_plan();
        t.exchange();
        assert(t.host.waiting_for_peers());
        t.drop_guest(1);
        t.exchange();
        play_out(&mut t.host);
        play_out(&mut t.games[0]);
        t.exchange();
        assert(t.host.turn == 2 && t.games[0].turn == 2);
        assert(!t.host.is_human(Team.Green) && !t.games[0].is_human(Team.Green));
        assert(t.host.ai_teams().contains(Team.Green));
        assert(t.host.checksum() == t.games[0].checksum());
        // And the next turn too.
        t.host.submit_plan();
        t.games[0].submit_plan();
        t.exchange();
        play_out(&mut t.host);
        play_out(&mut t.games[0]);
        t.exchange();
        assert(t.host.checksum() == t.games[0].checksum());
        assert(t.host.lockstep.desync.is_none());
    });
}

/// A bundle a machine refuses whole, saying why, without changing its game: one without the host's
/// plan, one for a side no person plays, one with two plans for a side, one without its own.
@test
fn a_guest_refuses_a_bundle_that_does_not_add_up() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut t = lobby(2, 4, 4242);
        end_turn_building(&mut t.games[0], Option.None);
        let own = t.games[0].team_plan(GUEST_SEAT);
        let blue = t.host.team_plan(HOST_SEAT);
        let green = t.games[1].team_plan(Team.Green);
        let before = t.games[0].checksum();
        // Without the host's plan.
        assert(!bundle_of(&mut t.games[0], &own, &green));
        // A plan for a side that has no person: an AI side.
        let mut ai = t.host.team_plan(HOST_SEAT);
        ai.team = t.host.ai_teams()[0];
        let bytes_ai = bytes_of(&ai);
        let mut plans: Vec[Vec[u8]] = Vec.new();
        plans.push(bytes_of(&blue));
        plans.push(bytes_of(&own));
        plans.push(bytes_ai);
        t.games[0].receive_bundle(0, plans);
        assert(!applied(t.games[0].apply_waiting_bundle()));
        // Two plans for one side.
        let mut plans: Vec[Vec[u8]] = Vec.new();
        plans.push(bytes_of(&blue));
        plans.push(bytes_of(&own));
        plans.push(bytes_of(&own));
        t.games[0].receive_bundle(0, plans);
        assert(!applied(t.games[0].apply_waiting_bundle()));
        // Without its own.
        let mut plans: Vec[Vec[u8]] = Vec.new();
        plans.push(bytes_of(&blue));
        plans.push(bytes_of(&green));
        t.games[0].receive_bundle(0, plans);
        assert(!applied(t.games[0].apply_waiting_bundle()));
        assert(t.games[0].checksum() == before);
        assert(t.games[0].waiting_for_peers());
    });
}

/// \`a\` and \`b\` (with the host's own plan first) as one bundle for turn 0; whether \`game\` took it.
fn bundle_of(game: &mut GameState, a: &TeamPlan, b: &TeamPlan) -> bool can {Log, Rand} {
    let mut plans: Vec[Vec[u8]] = Vec.new();
    plans.push(bytes_of(a));
    plans.push(bytes_of(b));
    game.receive_bundle(0, plans);
    applied(game.apply_waiting_bundle())
}

/// However the two players interleave ending turns, taking them back and the messages arriving,
/// every honest message is taken and every machine plays the same turn.
@test
fn no_order_of_ending_and_taking_back_turns_confuses_the_sequencer() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut t = table(1);
        let mut rng = seed(11);
        for trial in 0..14 {
            let turn = t.host.turn;
            let events = 4 + (rng.next() % 12) as i32;
            for _ in 0..events {
                let e = (rng.next() % 6) as i32;
                if e == 0 && !t.games[0].is_resolving() {
                    let unit = unit_of(&t.games[0], GUEST_SEAT);
                    let around = t.games[0].units[unit].pos.neighbors();
                    t.games[0].units[unit].planned_move = Option.Some(around[(rng.next() % 6) as i32]);
                    t.games[0].submit_plan();
                } else if e == 1 { t.games[0].take_back_turn(); }
                else if e == 2 && !t.host.is_resolving() { t.host.submit_plan(); }
                else if e == 3 { t.host.take_back_turn(); }
                else if e == 4 { t.exchange(); }
                else if e == 5 && t.host.is_playing_out() { play_out(&mut t.host); }
            }
            // Whatever is left arrives, and whoever has not ended the turn does, until it played out.
            for _ in 0..8 {
                if t.host.turn == turn + 1 && t.games[0].turn == turn + 1 && !t.host.is_playing_out() && !t.games[0].is_playing_out() { break; }
                if !t.games[0].is_resolving() && t.games[0].turn == turn { t.games[0].submit_plan(); }
                if !t.host.is_resolving() && t.host.turn == turn { t.host.submit_plan(); }
                t.exchange();
                play_out(&mut t.host);
                play_out(&mut t.games[0]);
                t.exchange();
            }
            assert(t.host.turn == turn + 1 && t.games[0].turn == turn + 1);
            assert(t.host.checksum() == t.games[0].checksum());
            assert(t.host.lockstep.desync.is_none() && t.games[0].lockstep.desync.is_none());
            assert(t.is_alive(0));
            assert(t.peer_rejected(0) == 0 && t.hub.last_reject == 0);
            let _n = trial;
        }
    });
}

const SCREEN: Vec2 = Vec2 { x: 1600.0, y: 900.0 };

/// A left click on \`hex\` on the map, as the window passes it on.
fn click(game: &mut GameState, hex: Hex, mode: ClickMode) can {Log, Rand} {
    let cursor = game.camera.world_to_screen(hex.to_world(), SCREEN);
    game.handle_map_click(cursor, SCREEN, mode);
}

/// A free hex beside \`around\` that no city or Barracks stands on.
fn open_beside(game: &GameState, around: Hex) -> Hex {
    let ring = around.neighbors();
    for k in 0..6 {
        let h = ring[k];
        let mut free = game.grid.is_passable(h) && !game.is_occupied(h);
        for c in 0..game.cities.len() { if game.cities[c].pos == h || game.cities[c].barracks == Option.Some(h) { free = false; } }
        if free { return h; }
    }
    around
}

/// Waiting for the others, a player looks around, selecting units and cities and opening views,
/// and changes nothing: the plan they sent stands, the game's state is the same, and the button
/// says it waits.
@test
fn waiting_for_the_others_a_player_looks_around_but_changes_nothing() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut t = table(1);
        let team = GUEST_SEAT;
        let city = city_of(&t.games[0], team);
        let city_pos = t.games[0].cities[city].pos;
        // A Barracks by its city (not on a tile a citizen works), on both machines.
        let around = city_pos.neighbors();
        let mut barracks = city_pos;
        for k in 0..6 {
            if barracks == city_pos && t.games[0].grid.is_passable(around[k]) && !t.games[0].is_occupied(around[k]) && !t.games[0].cities[city].works(around[k]) { barracks = around[k]; }
        }
        t.games[0].cities[city].barracks = Option.Some(barracks);
        t.host.cities[city].barracks = Option.Some(barracks);
        t.games[0].begin_lockstep_turn();
        t.host.begin_lockstep_turn();
        t.games[0].update(0.0);
        // The guest plans: a unit's move and a build, then ends its turn.
        let mut unit = 0 - 1;
        for i in 0..t.games[0].units.len() {
            let u = &t.games[0].units[i];
            if unit < 0 && u.team == team && u.pos != city_pos && u.pos != barracks { unit = i; }
        }
        assert(unit >= 0);
        let pos = t.games[0].units[unit].pos;
        let away = open_beside(&t.games[0], pos);
        t.games[0].units[unit].planned_move = Option.Some(away);
        t.games[0].open_city(city);
        t.games[0].queue_selected_city_unit(BuildUnit.Melee);
        t.games[0].end_planning();
        assert(t.games[0].waiting_for_peers());
        let plan = t.games[0].team_plan(team);
        let checksum = t.games[0].checksum();
        assert(t.games[0].selected_city.is_none());
        // A unit, selected by clicking it; a click elsewhere only lets go.
        click(&mut t.games[0], pos, ClickMode.Normal);
        assert(t.games[0].selected == Option.Some(unit));
        click(&mut t.games[0], away, ClickMode.Normal);
        assert(t.games[0].selected.is_none());
        assert(unchanged(&t.games[0], team, &plan, checksum));
        click(&mut t.games[0], pos, ClickMode.Normal);
        // Every order for it is refused.
        t.games[0].choose_move_action();
        assert(t.games[0].ui_click_mode.is_none());
        click(&mut t.games[0], away, ClickMode.Move);
        t.games[0].selected = Option.Some(unit);
        t.games[0].toggle_selected_ability();
        t.games[0].hold_selected_unit();
        t.games[0].toggle_guard();
        t.games[0].toggle_alert();
        t.games[0].disband_selected();
        t.games[0].disband_selected();
        t.games[0].found_city_selected();
        t.games[0].handle_right_click();
        t.games[0].hold_or_end_turn();
        assert(unchanged(&t.games[0], team, &plan, checksum));
        // Tab picks a unit; a click on the city opens it.
        t.games[0].set_selection(Vec.new());
        t.games[0].select_next_unit();
        assert(t.games[0].selected.is_some());
        // Its city opens (C), and nothing in it changes.
        t.games[0].select_city();
        assert(t.games[0].selected_city == Option.Some(city));
        t.games[0].queue_selected_city_unit(BuildUnit.Ranged);
        t.games[0].queue_selected_city_gather();
        t.games[0].queue_selected_city_growth();
        t.games[0].queue_selected_city_worker();
        t.games[0].queue_selected_city_scout();
        t.games[0].queue_selected_city_settler();
        t.games[0].queue_selected_city_building(Building.Mill);
        t.games[0].move_selected_city_queue_item(0, false);
        t.games[0].remove_selected_city_queue_item(0);
        t.games[0].clear_selected_city_queue();
        t.games[0].auto_assign_selected_city();
        t.games[0].prioritize_selected_city(Good.Metal);
        t.games[0].set_selected_city_priorities(Priorities.of(Good.Wood, Good.Food, Good.Metal));
        t.games[0].arm_worker_job(JobKind.Road);
        assert(t.games[0].placing_job.is_none());
        t.games[0].release_worker();
        // Clicks on its tiles don't move citizens.
        let worked = cluster_hexes(&t.games[0], city);
        for k in 0..worked.len() {
            click(&mut t.games[0], worked[k], ClickMode.Normal);
            t.games[0].open_city(city);
        }
        assert(unchanged(&t.games[0], team, &plan, checksum));
        assert(t.games[0].selected_city == Option.Some(city));
        // The Barracks, by clicking it.
        t.games[0].press_escape();
        click(&mut t.games[0], barracks, ClickMode.Normal);
        assert(t.games[0].selected_barracks == Option.Some(city));
        t.games[0].queue_selected_barracks_unit(BuildUnit.Melee);
        t.games[0].clear_selected_barracks_queue();
        assert(unchanged(&t.games[0], team, &plan, checksum));
        // The plan as sent reaches the host, and both machines play the same turn.
        t.games[0].open_city(city);
        t.exchange();
        t.host.submit_plan();
        t.exchange();
        assert(t.games[0].selected_city.is_none() || t.games[0].is_playing_out());
        play_out(&mut t.host);
        play_out(&mut t.games[0]);
        t.exchange();
        assert(t.host.turn == 1);
        assert(t.host.checksum() == t.games[0].checksum());
        assert(units_queued(&t.games[0], team, BuildUnit.Melee) == 1);
    });
}

fn cluster_hexes(game: &GameState, city: i32) -> Vec[Hex] {
    let mut out: Vec[Hex] = Vec.new();
    for k in 0..game.cities[city].clusters.len() {
        let t = game.cities[city].clusters[k].tiles();
        for i in 0..t.len() { out.push(t[i]); }
    }
    out
}

/// The plan, the game and the waiting are as they were.
fn unchanged(game: &GameState, team: Team, plan: &TeamPlan, checksum: u64) -> bool {
    plans_equal(&game.team_plan(team), plan) && game.checksum() == checksum && game.waiting_for_peers()
}

/// The AI plays every seat, as a player could: every plan must pass the checks (no plan of a
/// player is dropped), and every machine must play the same game. Players look inside their cities
/// too, which must change nothing.
@test
fn plans_the_ai_makes_for_a_player_pass_the_checks() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut t = lobby(2, 4, 4242);
        for turn in 0..10 {
            // The AI plans each machine's own side; a worker already out on the map keeps the job
            // it had (planning may only recall it, `check_plan`).
            ai_plans(&mut t.host);
            for i in 0..t.games.len() { ai_plans(&mut t.games[i]); }
            play_turn(&mut t);
            assert(t.host.turn == turn + 1);
            assert(t.games[0].checksum() == t.host.checksum());
            assert(t.games[1].checksum() == t.host.checksum());
            assert(t.is_alive(0) && t.is_alive(1));
            assert(t.host.lockstep.desync.is_none());
        }
    });
}

/// \`game\`'s side planned by the AI, after its player has looked inside every city.
fn ai_plans(game: &mut GameState) can {Log, Rand} {
    let team = game.local_team;
    for c in 0..game.cities.len() {
        if game.cities[c].team == team {
            game.open_city_interior(c);
            game.close_city_interior();
        }
    }
    game.plan_ai_turn(team);
    let started = match &game.lockstep.turn_start { &Option.Some(s) => s.snapshot(), &Option.None => return };
    for w in 0..game.field_workers.len() {
        if game.field_workers[w].team != team { continue; }
        for b in 0..started.field_workers.len() {
            if started.field_workers[b].id == game.field_workers[w].id {
                game.field_workers[w].job = started.field_workers[b].job;
                game.field_workers[w].work_left = started.field_workers[b].work_left;
                game.field_workers[w].base = started.field_workers[b].base;
                game.field_workers[w].recalled = started.field_workers[b].recalled;
            }
        }
    }
}

/// Two lanes across open ground make progress an invariant of this fixture: a queue of moves
/// through the fog is planned again each turn, on both machines, toward where it was sent.
@test
fn queues_planned_again_each_turn_keep_both_machines_in_step() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut t = table(1);
        // An open map with one Melee troop a side, on both machines, from the turn's start.
        for k in 0..2 {
            let game = if k == 0 { &mut t.host } else { &mut t.games[0] };
            let no_tiles: [(Hex, Tile); 0] = [];
            game.grid = HexGrid.new(12, &no_tiles);
            game.units.clear();
            game.cities.clear();
            game.dens.clear();
            game.ruins.clear();
            game.settlers = IdSet.new();
            game.units.push(Unit.new(0, Hex.new(0 - 6, 0 - 3), HOST_SEAT, UnitType.Melee));
            game.units.push(Unit.new(1, Hex.new(0 - 6, 3), GUEST_SEAT, UnitType.Melee));
            game.memory = Map.new();
            for s in 0..game.side_memory.len() { game.side_memory[s] = Map.new(); }
            game.begin_lockstep_turn();
        }
        let mut goals: Vec[(u32, Hex, Hex)] = Vec.new();
        for k in 0..2 {
            let game = if k == 0 { &mut t.host } else { &mut t.games[0] };
            let mut unit = 0;
            for i in 0..game.units.len() { if game.units[i].team == game.local_team { unit = i; } }
            let from = game.units[unit].pos;
            let target = Hex.new(0, from.r);
            assert(from.distance(target) == 6);
            assert(!game.is_explored(target));
            game.selected = Option.Some(unit);
            assert(game.queue_move(target));
            assert(game.units[unit].waypoints.len() == 1);
            goals.push((game.units[unit].id, from, target));
        }
        for _ in 0..4 {
            t.games[0].submit_plan();
            t.exchange();
            t.host.submit_plan();
            t.exchange();
            play_out(&mut t.host);
            play_out(&mut t.games[0]);
            t.exchange();
            assert(t.host.checksum() == t.games[0].checksum());
            assert(t.host.lockstep.desync.is_none());
            assert(t.games[0].lockstep.dropped.is_none());
        }
        // Both queues went on toward where they were sent, on both machines.
        for g in 0..goals.len() {
            let (id, from, target) = goals[g];
            for k in 0..2 {
                let game = if k == 0 { &t.host } else { &t.games[0] };
                let mut nearer = false;
                for i in 0..game.units.len() { if game.units[i].id == id && game.units[i].pos.distance(target) < from.distance(target) { nearer = true; } }
                assert(nearer);
            }
        }
    });
}

/// A Red troop beside a city stands in its interior from the turn's start, on every machine;
/// Red looks inside and orders it to an open tile, and the plan that carries the order is sound:
/// every machine plays the same turn.
@test
fn looking_inside_a_city_and_ordering_a_troop_there_is_a_sound_plan() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut t = lobby(2, 4, 4242);
        let mut city = 0 - 1;
        let mut fighter: u32 = 0;
        for c in 0..t.games[0].cities.len() {
            for i in 0..t.games[0].units.len() {
                let u = &t.games[0].units[i];
                if city < 0 && u.team == Team.Red && u.pos.distance(t.games[0].cities[c].pos) == 1 && !u.is_naval() && !t.games[0].settlers.contains(u.id) {
                    city = c;
                    fighter = u.id;
                }
            }
        }
        assert(city >= 0);
        for k in 0..3 {
            let game = if k == 0 { &t.host } else if k == 1 { &t.games[0] } else { &t.games[1] };
            assert(game.cities[city].interior.index_of(fighter).is_some());
        }
        // Looking inside changes nothing.
        let before = t.host.checksum();
        t.host.open_city_interior(city);
        t.host.close_city_interior();
        assert(t.host.checksum() == before);
        // Red looks inside and orders its troop to an open tile.
        t.games[0].open_city_interior(city);
        let at = t.games[0].cities[city].interior.fighters[t.games[0].cities[city].interior.index_of(fighter).unwrap_or(0)].pos;
        t.games[0].interior_click(at);
        let mut open = at;
        for q in -2..3 { for r in -2..3 {
            let h = Hex.new(q, r);
            if open == at && in_bounds(h) && h != Hex.new(0, 0) && t.games[0].cities[city].interior.fighter_at(h).is_none() && at.distance(h) == 1 { open = h; }
        } }
        assert(open != at);
        t.games[0].interior_click(open);
        t.games[0].close_city_interior();
        let plan = t.games[0].team_plan(Team.Red);
        let mut ordered = false;
        for i in 0..plan.fighters.len() { if plan.fighters[i].planned_move == Option.Some(open) { ordered = true; } }
        assert(ordered);
        // Every machine plays the same turn.
        play_turn(&mut t);
        assert(t.games[0].checksum() == t.host.checksum() && t.games[1].checksum() == t.host.checksum());
        assert(t.host.turn == 1);
        // The order was carried out on every machine: the troop stands where it was sent.
        for k in 0..3 {
            let game = if k == 0 { &t.host } else if k == 1 { &t.games[0] } else { &t.games[1] };
            let mut u = 0 - 1;
            for i in 0..game.units.len() { if game.units[i].id == fighter { u = i; } }
            assert(u < 0 || game.cities[city].interior.index_of(fighter).is_none() || game.cities[city].interior.fighters[game.cities[city].interior.index_of(fighter).unwrap_or(0)].pos == open);
        }
    });
}

/// Red's first plan is at the host, then Red takes the turn back and sends another while the host
/// ends its turn: the host closes the turn with Red's first plan before Red's messages reach it,
/// and Red's take-back and resend, which it sent before it knew, must not spend the next turn's
/// place: the turn after plays out with both players' plans.
@test
fn a_take_back_the_host_answered_first_leaves_the_next_turn_free() {
    sandbox(fn() can {Log, Rand, Assert} {
        let mut t = table(1);
        end_turn_building(&mut t.games[0], Option.None);
        t.exchange();
        t.games[0].take_back_turn();
        end_turn_building(&mut t.games[0], Option.Some(BuildUnit.Melee));
        end_turn_building(&mut t.host, Option.None);
        t.exchange();
        play_out(&mut t.host);
        play_out(&mut t.games[0]);
        t.exchange();
        assert(t.host.turn == 1 && t.games[0].turn == 1);
        assert(t.is_alive(0) && t.peer_rejected(0) == 0 && t.hub.last_reject == 0);
        // The next turn takes both plans.
        end_turn_building(&mut t.games[0], Option.Some(BuildUnit.Ranged));
        end_turn_building(&mut t.host, Option.None);
        t.exchange();
        play_out(&mut t.host);
        play_out(&mut t.games[0]);
        t.exchange();
        assert(t.host.turn == 2 && t.games[0].turn == 2);
        assert(t.host.checksum() == t.games[0].checksum());
        assert(units_queued(&t.host, GUEST_SEAT, BuildUnit.Ranged) == 1);
        assert(t.host.lockstep.desync.is_none());
    });
}
